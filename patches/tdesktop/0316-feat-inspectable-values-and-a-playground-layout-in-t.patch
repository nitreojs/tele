 	}
 }
 
+function valueSpan(className, text) {
+	return span('v ' + className, text);
+}
+
+function quoteString(text) {
+	return '\'' + text.replace(/\\/g, '\\\\').replace(/'/g, '\\\'').replace(/\n/g, '\\n').replace(/\r/g, '\\r')
+		.replace(/\t/g, '\\t') + '\'';
+}
+
+function isCompound(node) {
+	const kind = node[0];
+	return kind === 'o' || kind === 'a' || kind === 'm' || kind === 'e';
+}
+
+function scalarNode(node, quote, short) {
+	switch (node[0]) {
+	case 's': {
+		const full = String(node[1]);
+		const cut = short && full.length > kPreviewString;
+		const text = cut ? full.slice(0, kPreviewString) + '\u2026' : full;
+		const value = valueSpan(quote ? 'v-string' : 'v-text', quote ? quoteString(text) : text);
+		if (short || !(node[2] > 0)) {
+			return value;
+		}
+		const wrap = span('v-wrap');
+		wrap.appendChild(value);
+		wrap.appendChild(valueSpan('v-more', ' \u2026 ' + node[2] + ' more chars'));
+		return wrap;
+	}
+	case 'n': return valueSpan('v-number', String(node[1]));
+	case 'b': return valueSpan('v-number', node[1] + 'n');
+	case 't': return valueSpan('v-bool', node[1] ? 'true' : 'false');
+	case 'l': return valueSpan('v-null', 'null');
+	case 'u': return valueSpan('v-null', 'undefined');
+	case 'y': return valueSpan('v-symbol', String(node[1]));
+	case 'f': {
+		const wrap = span('v v-fn');
+		if (node[2]) {
+			wrap.appendChild(span('v-fn-mark', 'class '));
+			wrap.appendChild(document.createTextNode(String(node[1] || '(anonymous)')));
+		} else {
+			wrap.appendChild(span('v-fn-mark', '\u0192 '));
+			wrap.appendChild(document.createTextNode(String(node[1] || '') + '()'));
+		}
+		return wrap;
+	}
+	case 'x': {
+		const wrap = span('v');
+		wrap.appendChild(span('v-class', 'Uint8Array(' + node[1] + ')'));
+		if (!short) {
+			wrap.appendChild(document.createTextNode(' '));
+			wrap.appendChild(valueSpan('v-number', String(node[2] || '')));
+		}
+		return wrap;
+	}
+	case 'd': return valueSpan('v-date', String(node[1]));
+	case 'r': return valueSpan('v-regexp', String(node[1]));
+	case 'p': return valueSpan('v-class', 'Promise {\u2026}');
+	case 'c': return valueSpan('v-dim', '[Circular]');
+	case '\u2026': return valueSpan('v-dim', '\u2026');
+	case '!': return valueSpan('v-error', '[Exception: ' + node[1] + ']');
+	case 'e': return valueSpan('v-error', String(node[1]));
+	}
+	return valueSpan('v-dim', JSON.stringify(node));
+}
+
+function labelSpan(label) {
+	return span(/^[a-z]/.test(label) ? 'v-label' : 'v-class', label);
+}
+
+function shortNode(node) {
+	switch (node[0]) {
+	case 'o': {
+		const wrap = span('v');
+		if (node[1] !== 'Object') {
+			wrap.appendChild(labelSpan(node[1]));
+			wrap.appendChild(document.createTextNode(' '));
+		}
