+	display: inline;
+}
+.v-head {
+	cursor: pointer;
+}
+.v-tree.leaf > .v-head {
+	cursor: inherit;
+}
+.v-row > .v-tree:not(.leaf) > .v-head,
+.crow-body > .v-tree:not(.leaf) > .v-head {
+	display: block;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+.v-toggle {
+	display: inline-block;
+	width: 1.5ch;
+	color: var(--dim);
+	user-select: none;
 }
-.rout-result .rout-prompt {
+.v-tree.leaf > .v-head > .v-toggle {
+	display: none;
+}
+.v-row > .v-tree.leaf > .v-head > .v-toggle {
+	display: inline-block;
+}
+.v-head:hover > .v-toggle {
+	color: var(--text);
+}
+.v-tree.open > .v-head .v-preview {
+	opacity: .75;
+}
+.v-children {
+	display: block;
+	padding-left: 2ch;
+}
+.v-row {
+	display: block;
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+}
+.v-row.v-more {
+	padding-left: 1.5ch;
+}
+.v-stack {
+	display: block;
+	padding-left: 1.5ch;
+	white-space: pre-wrap;
+	color: var(--attention);
+}
+.v-text {
+	white-space: pre-wrap;
+}
+.v-string {
+	color: var(--syntax-type);
+}
+.v-number {
+	color: var(--syntax-key);
+}
+.v-bool {
+	color: var(--syntax-bool);
+}
+.v-null,
+.v-punct,
+.v-more {
 	color: var(--dim);
 }
-.rout-result.pending .rout-text {
+.v-dim {
 	color: var(--dim);
+	font-style: italic;
+}
+.v-key {
+	color: color-mix(in srgb, var(--syntax-bool) 70%, var(--text));
+}
+.v-label {
+	color: var(--accent);
+	font-weight: 600;
+}
+.v-fn {
+	font-style: italic;
+}
+.v-fn-mark {
+	color: var(--syntax-bool);
 }
-.rout-result.fail .rout-prompt,
-.rout-result.fail .rout-text {
+.v-error {
 	color: var(--attention);
 }
+.v-symbol,
+.v-regexp {
+	color: var(--syntax-number);
+}
+.v-date {
+	color: var(--syntax-invisible);
+}
