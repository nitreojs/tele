index 0000000000000000000000000000000000000000..638dedd73826a222807ed9d33047f935d92ae8dd
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_rich_quote.cpp
@@ -0,0 +1,269 @@
+#include "tele/tele_rich_quote.h"
+
+#include "data/data_premium_limits.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_context_menu.h"
+#include "history/view/history_view_element.h"
+#include "history/view/history_view_list_widget.h"
+#include "iv/editor/iv_editor_clipboard.h"
+#include "iv/editor/iv_editor_page_blocks.h"
+#include "iv/editor/iv_editor_session.h"
+#include "iv/editor/iv_editor_window.h"
+#include "main/main_session.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/delayed_activation.h"
+#include "ui/text/text_entity.h"
+#include "ui/toast/toast.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/popup_menu.h"
+
+#include <QtCore/QMimeData>
+#include <QtWidgets/QApplication>
+
+namespace Tele {
+namespace {
+
+using Block = Iv::RichPage::Block;
+
+struct Pending {
+	FullMsgId itemId;
+	Iv::RichPageBlocksSlice slice;
+};
+
+[[nodiscard]] std::optional<Pending> &PendingQuote() {
+	static auto result = std::optional<Pending>();
+	return result;
+}
+
+void DropUneditable(std::vector<Block> &blocks, bool &dropped) {
+	for (auto &block : blocks) {
+		DropUneditable(block.blocks, dropped);
+		for (auto &item : block.listItems) {
+			DropUneditable(item.blocks, dropped);
+		}
+	}
+	const auto from = ranges::remove_if(blocks, [](const Block &block) {
+		return !Iv::Editor::CanEditBlock(block);
+	});
+	if (from != end(blocks)) {
+		dropped = true;
+		blocks.erase(from, end(blocks));
+	}
+}
+
+void Truncate(TextWithEntities &text, int limit) {
+	if (text.text.size() <= limit) {
+		return;
+	}
+	auto length = limit - 1;
+	if (text.text.at(length - 1).isHighSurrogate()) {
+		--length;
+	}
+	text.text = text.text.left(length) + QChar(0x2026);
+	auto &entities = text.entities;
+	for (auto i = entities.begin(); i != entities.end();) {
+		const auto from = i->offset();
+		const auto till = from + i->length();
+		const auto atomic = (i->type() == EntityType::CustomEmoji)
+			|| (i->type() == EntityType::MentionName)
+			|| (i->type() == EntityType::CustomUrl);
+		if (from >= length || (till > length && atomic)) {
+			i = entities.erase(i);
+			continue;
+		} else if (till > length) {
+			i->shrinkFromRight(till - length);
+		}
+		++i;
+	}
+}
+
+void WrapInQuotes(TextWithEntities &text) {
+	auto quotes = EntitiesInText();
+	const auto add = [&](int from, int till) {
+		while (from < till && text.text.at(from) == QChar('\n')) {
+			++from;
+		}
+		while (till > from && text.text.at(till - 1) == QChar('\n')) {
+			--till;
+		}
+		if (from < till) {
+			quotes.push_back(
+				EntityInText(EntityType::Blockquote, from, till - from));
+		}
+	};
+	auto from = 0;
+	for (const auto &entity : text.entities) {
+		if (entity.type() == EntityType::Pre) {
+			add(from, entity.offset());
+			from = std::max(from, entity.offset() + entity.length());
+		}
+	}
+	add(from, int(text.text.size()));
+	quotes.append(std::move(text.entities));
+	std::stable_sort(
+		quotes.begin(),
+		quotes.end(),
+		[](const EntityInText &a, const EntityInText &b) {
+			return a.offset() < b.offset();
+		});
+	text.entities = std::move(quotes);
+}
+
+void OpenFocused(
+		const Fn<void(std::shared_ptr<QMimeData>)> &open,
+		std::shared_ptr<QMimeData> data) {
+	const auto popup = QApplication::activePopupWidget();
+	if (const auto menu = dynamic_cast<Ui::PopupMenu*>(popup)) {
+		menu->hideMenu(true);
+	}
+	Ui::PreventDelayedActivation();
+	const auto editors = [] {
+		auto result = std::vector<QPointer<QWidget>>();
+		for (const auto widget : QApplication::topLevelWidgets()) {
+			if (dynamic_cast<Iv::Editor::Window*>(widget)) {
+				result.push_back(widget);
+			}
+		}
+		return result;
+	};
+	const auto before = editors();
+	open(std::move(data));
+	for (const auto &window : editors()) {
+		if (ranges::contains(before, window)) {
+			continue;
+		}
+		crl::on_main(window.data(), [=] {
+			if (window && window->isVisible()) {
+				window->raise();
+				window->activateWindow();
+			}
+		});
+	}
+}
+
+void InsertPlain(
+		not_null<History*> history,
+		const Iv::RichPageBlocksSlice &slice,
+		not_null<Ui::InputField*> field) {
+	const auto session = &history->session();
+	auto page = Iv::RichPage();
+	page.blocks = slice.blocks;
+	page.rtl = slice.rtl;
+	auto quoted = Iv::FlattenRichPageToSimpleText(page);
+	const auto customEmoji = session->premium()
+		|| Data::AllowEmojiWithoutPremium(history->peer);
+	quoted.entities.erase(ranges::remove_if(quoted.entities, [&](
+			const EntityInText &entity) {
+		const auto type = entity.type();
+		return (type == EntityType::Blockquote)
+			|| (!customEmoji && type == EntityType::CustomEmoji);
+	}), quoted.entities.end());
+	const auto own = field->getTextWithTags();
+	const auto limit = Data::PremiumLimits(session).messageLengthCurrent();
+	const auto available = limit
+		- (own.text.isEmpty() ? 0 : int(own.text.size()) + 1);
+	if (available < 2 || quoted.empty()) {
+		return;
+	}
+	Truncate(quoted, available);
+	WrapInQuotes(quoted);
+	auto result = TextWithTags{
+		quoted.text,
+		TextUtilities::ConvertEntitiesToTextTags(quoted.entities),
+	};
+	result.text.append(QChar('\n'));
+	const auto cursor = int(result.text.size());
+	for (auto tag : own.tags) {
+		tag.offset += cursor;
+		result.tags.push_back(std::move(tag));
+	}
+	result.text.append(own.text);
+	field->setTextWithTags(result, Ui::InputField::HistoryAction::NewEntry);
+	field->setCursorPosition(cursor);
+	field->ensureCursorVisible();
+	field->setFocus();
+}
+
+} // namespace
+
+Iv::RichPageBlocksSlice RichQuoteBlocks(
+		const HistoryView::SelectedQuote &quote,
+		HistoryView::Element *view,
+		const HistoryView::MessageSelection &selection) {
+	if (!RichQuote() || quote || !view || !selection.isRichPage()) {
+		return {};
+	}
+	return view->selectedRichBlocks(selection);
+}
+
+Iv::RichPageBlocksSlice RichQuoteBlocks(
+		not_null<HistoryView::ListWidget*> list,
+		const HistoryView::ContextMenuRequest &request) {
+	const auto view = request.view;
+	if (!view || request.item != view->data()) {
+		return {};
+	}
+	return RichQuoteBlocks(
+		request.quote,
+		view,
+		list->getSelectedTextSelection(view->data()));
+}
+
+void RequestRichQuote(FullMsgId itemId, Iv::RichPageBlocksSlice slice) {
+	if (slice.empty()) {
+		return;
+	}
+	PendingQuote() = Pending{ itemId, std::move(slice) };
+	crl::on_main([] {
+		PendingQuote() = std::nullopt;
+	});
+}
+
+void ApplyRichQuote(
+		not_null<History*> history,
+		const FullReplyTo &replyTo,
+		bool editing,
+		RichQuoteCompose compose) {
+	auto &pending = PendingQuote();
+	if (!pending
+		|| pending->itemId != replyTo.messageId
+		|| !replyTo.quote.empty()) {
+		return;
+	}
+	auto slice = std::move(pending->slice);
+	pending = std::nullopt;
+	if (editing) {
+		return;
+	}
+	const auto session = &history->session();
+	if (Iv::Editor::CanAuthorRichMessages(session)) {
+		auto blocks = slice.blocks;
+		auto dropped = false;
+		DropUneditable(blocks, dropped);
+		if (!blocks.empty()) {
+			auto quote = Block();
+			quote.kind = Iv::RichPage::BlockKind::Quote;
+			quote.blocks = std::move(blocks);
+			auto data = Iv::Editor::ClipboardBlockData();
+			data.blocks.push_back(std::move(quote));
+			data.blocks.push_back(Iv::Editor::MakeParagraphBlock());
+			auto mime = Iv::Editor::MimeDataFromClipboardData(
+				Iv::Editor::ClipboardData(std::move(data)));
+			if (dropped) {
+				Ui::Toast::Show(
+					compose.field->window(),
+					Lower(u"Some blocks can't be quoted and were left out"_q));
+			}
+			OpenFocused(
+				compose.rich,
+				std::shared_ptr<QMimeData>(mime.release()));
+			return;
+		}
+	}
+	InsertPlain(history, slice, compose.field);
+}
+
+} // namespace Tele
