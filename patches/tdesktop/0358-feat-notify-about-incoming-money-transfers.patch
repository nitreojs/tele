+#include "tele/tele_money_incoming.h"
+
+#include "apiwrap.h"
+#include "base/timer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "data/data_channel.h"
+#include "history/history_item_helpers.h"
+#include "main/main_app_config.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/serialize_common.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_notices.h"
+#include "tele/tele_options.h"
+#include "ui/new_badges.h"
+#include "ui/rp_widget.h"
+#include "wallet/wallet_session.h"
+#include "styles/style_settings.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QSaveFile>
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+// The server pushes updateWalletState when the balance changes; this only
+// covers a push that never came.
+constexpr auto kPollInterval = 10 * 60 * crl::time(1000);
+constexpr auto kPageLimit = 20;
+constexpr auto kMaxSeen = 200;
+constexpr auto kMagic = quint32(0x7E1E4D49);
+constexpr auto kVersion = qint32(1);
+
+class Tracker final {
+public:
+	explicit Tracker(not_null<Main::Session*> session);
+	~Tracker();
+
+	[[nodiscard]] rpl::producer<int> unseenValue() const;
+	void markSeen();
+
+private:
+	[[nodiscard]] bool active() const;
+	[[nodiscard]] QString path() const;
+	void refreshActive();
+	void poll();
+	void check();
+	void apply(const MTPwallet_Transactions &result);
+	void remember(const QString &id);
+	void read();
+	void write();
+
+	const not_null<Main::Session*> _session;
+	base::Timer _timer;
+	rpl::variable<int> _unseen = 0;
+	std::deque<QString> _order;
+	base::flat_set<QString> _seen;
+	bool _baseline = false;
+	int64 _balance = -1;
+	mtpRequestId _requestId = 0;
+	rpl::lifetime _lifetime;
+
+};
+
+[[nodiscard]] base::flat_map<
+	not_null<Main::Session*>,
+	std::unique_ptr<Tracker>> &Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Tracker>>();
+	return result;
+}
+
+[[nodiscard]] Tracker *Find(not_null<Main::Session*> session) {
+	const auto i = Registry().find(session);
+	return (i != end(Registry())) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] QString FromText(
+		not_null<Main::Session*> session,
+		const MTPWalletTransactionPeer &peer) {
+	const auto shortAddress = [](const QString &address) {
+		return (address.size() > 12)
+			? (address.left(4) + QString::fromUtf8("\xe2\x80\xa6")
+				+ address.right(4))
+			: address;
+	};
+	return peer.match([&](const MTPDwalletTransactionPeerUser &data) {
+		const auto user = session->data().userLoaded(data.vuser_id());
+		return user ? user->name() : shortAddress(qs(data.vaddress()));
+	}, [&](const MTPDwalletTransactionPeerChannel &data) {
+		const auto channel = session->data().channelLoaded(
+			data.vchannel_id());
+		return channel ? channel->name() : shortAddress(qs(data.vaddress()));
+	}, [&](const MTPDwalletTransactionPeerAddress &data) {
+		const auto domain = data.vdomain();
+		return domain ? qs(*domain) : shortAddress(qs(data.vaddress()));
+	}, [&](const MTPDwalletTransactionPeerOnramp &data) {
+		return qs(data.vprovider_name());
+	}, [](const auto &) {
+		return QString();
+	});
+}
+
+Tracker::Tracker(not_null<Main::Session*> session)
+: _session(session)
+, _timer([=] { poll(); }) {
+	read();
+	rpl::merge(
+		MoneyIncomingChanges(),
+		_session->appConfig().value() | rpl::to_empty
+	) | rpl::on_next([=] {
+		refreshActive();
+	}, _lifetime);
+	_session->wallet().balanceNanoValue(
+	) | rpl::on_next([=](int64 balance) {
+		const auto grew = (_balance >= 0) && (balance > _balance);
+		_balance = balance;
+		if (grew && active()) {
+			check();
+		}
+	}, _lifetime);
+	refreshActive();
+}
+
+Tracker::~Tracker() {
+	write();
+	if (_requestId) {
+		_session->api().request(base::take(_requestId)).cancel();
+	}
+}
+
+bool Tracker::active() const {
+	return (IncomingTransfersNotify() || IncomingTransfersBadge())
+		&& _session->appConfig().walletAvailable();
+}
+
+void Tracker::refreshActive() {
+	if (!active()) {
+		_timer.cancel();
+		if (!IncomingTransfersBadge() && _unseen.current()) {
+			_unseen = 0;
+			write();
+		}
+		return;
+	}
+	if (!_timer.isActive()) {
+		_timer.callEach(kPollInterval);
+	}
+	if (!_baseline) {
+		check();
+	}
+}
+
+void Tracker::poll() {
+	// While Money is open it polls the history itself.
+	if (active() && !_session->wallet().panel()) {
+		check();
+	}
+}
+
+void Tracker::check() {
+	if (_requestId) {
+		return;
+	}
+	using Flag = MTPwallet_GetTransactions::Flag;
+	_requestId = _session->api().request(MTPwallet_GetTransactions(
+		MTP_flags(Flag::f_inbound),
+		MTP_string(),
+		MTP_int(kPageLimit)
+	)).done([=](const MTPwallet_Transactions &result) {
+		_requestId = 0;
+		apply(result);
+	}).fail([=] {
+		_requestId = 0;
+	}).send();
+}
+
+void Tracker::apply(const MTPwallet_Transactions &result) {
+	const auto &data = result.data();
+	_session->data().processUsers(data.vusers());
+	_session->data().processChats(data.vchats());
+	const auto &list = data.vtransactions().v;
+	const auto first = !_baseline;
+	_baseline = true;
+	auto added = 0;
+	// The page is newest first: announce the oldest new one first.
+	for (auto i = list.size(); i != 0;) {
+		const auto &item = list[--i].data();
+		const auto id = qs(item.vid());
+		if (_seen.contains(id)) {
+			continue;
+		}
+		remember(id);
+		if (first
+			|| !item.is_incoming()
+			|| item.is_failed()
+			|| item.is_key_change()
+			|| item.is_suspected_spam()
+			|| item.vnft()
+			|| item.vamount().v <= 0) {
+			continue;
+		}
+		++added;
+		if (IncomingTransfersNotify()) {
+			const auto from = FromText(_session, item.vpeer());
+			Notify(_session, {
+				.kind = NoticeKind::Money,
+				.tone = NoticeTone::Success,
+				.date = item.vdate().v,
+				.title = u"+"_q + PrepareGramAmountText(item.vamount().v),
+				.text = { from.isEmpty()
+					? Lower(u"Incoming transfer"_q)
+					: Lower(u"From %1"_q).arg(from) },
+			});
+		}
+	}
+	if (added && IncomingTransfersBadge()) {
+		_unseen = _unseen.current() + added;
+	}
+	write();
+}
+
+void Tracker::remember(const QString &id) {
+	_seen.emplace(id);
+	_order.push_back(id);
+	while (_order.size() > kMaxSeen) {
+		_seen.remove(_order.front());
+		_order.pop_front();
+	}
+}
+
+rpl::producer<int> Tracker::unseenValue() const {
+	return _unseen.value();
+}
+
+void Tracker::markSeen() {
+	if (_unseen.current()) {
+		_unseen = 0;
+		write();
+	}
+}
+
+QString Tracker::path() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + u"/tele_money_incoming"_q;
+}
+
+void Tracker::read() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	auto file = QFile(path());
+	if (!key || !file.open(QIODevice::ReadOnly)) {
+		return;
+	}
+	auto stream = QDataStream(&file);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto magic = quint32();
+	auto version = qint32();
+	auto encrypted = QByteArray();
+	stream >> magic >> version >> encrypted;
+	auto data = EncryptedDescriptor();
+	if (stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| !DecryptLocal(data, encrypted, key)) {
+		return;
+	}
+	auto unseen = qint32();
+	auto count = qint32();
+	data.stream >> unseen >> count;
+	if (data.stream.status() != QDataStream::Ok
+		|| unseen < 0
+		|| count < 0
+		|| count > kMaxSeen) {
+		return;
+	}
+	for (auto i = 0; i != count; ++i) {
+		auto id = QString();
+		data.stream >> id;
+		if (data.stream.status() != QDataStream::Ok) {
+			return;
+		}
+		remember(id);
+	}
+	_baseline = true;
+	_unseen = unseen;
+}
+
+void Tracker::write() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !_baseline) {
+		return;
+	}
+	auto size = int(sizeof(qint32) * 2);
+	for (const auto &id : _order) {
+		size += Serialize::stringSize(id);
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream << qint32(_unseen.current()) << qint32(_order.size());
+	for (const auto &id : _order) {
+		data.stream << id;
+	}
+	const auto path = this->path();
+	QDir().mkpath(QFileInfo(path).absolutePath());
+	auto file = QSaveFile(path);
+	if (!file.open(QIODevice::WriteOnly)) {
+		return;
+	}
+	auto stream = QDataStream(&file);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << kMagic << kVersion << PrepareEncrypted(data, key);
+	if (stream.status() == QDataStream::Ok) {
+		file.commit();
+	}
+}
+
+} // namespace
+
+void SetupMoneyIncoming(not_null<Main::Session*> session) {
+	Registry().emplace(session, std::make_unique<Tracker>(session));
+	session->lifetime().add([=] {
+		Registry().remove(session);
+	});
+}
+
+void MoneyIncomingSeen(not_null<Main::Session*> session) {
+	if (const auto tracker = Find(session)) {
+		tracker->markSeen();
+	}
+}
+
+void AddMoneyIncomingBadge(
+		not_null<Ui::RpWidget*> button,
+		not_null<Main::Session*> session,
+		rpl::producer<QString> text,
+		const style::SettingsButton &st) {
+	const auto tracker = Find(session);
+	if (!tracker) {
+		return;
+	}
+	auto count = tracker->unseenValue();
+	const auto badge = Ui::NewBadge::CreateNewBadge(
+		button,
+		rpl::duplicate(count) | rpl::map([](int value) {
+			return u"+"_q + QString::number(value);
+		}));
+	rpl::combine(
+		std::move(text),
+		std::move(count),
+		button->widthValue(),
+		badge->widthValue()
+	) | rpl::on_next([=, &st](
+			const QString &text,
+			int count,
+			int width,
+			int) {
+		const auto left = st.padding.left()
+			+ st.style.font->width(text)
+			+ st.style.font->spacew;
+		const auto available = width - left - st.padding.right();
+		badge->setVisible(count > 0 && available >= badge->width());
+		if (!badge->isHidden()) {
+			const auto top = st.padding.top()
+				+ st.style.font->ascent
+				- st::settingsPremiumNewBadge.style.font->ascent
+				- st::settingsPremiumNewBadgePadding.top();
+			badge->moveToLeft(left, top, width);
+		}
+	}, badge->lifetime());
+}
+
+} // namespace Tele
