+void SetChatsGhostOverride(
+		not_null<Main::Session*> session,
+		GhostOverride mode,
+		const std::vector<not_null<PeerData*>> &peers) {
+	const auto test = session->isTestMode();
+	auto overrides = Get().overrides;
+	for (auto i = begin(overrides); i != end(overrides);) {
+		if ((((i->first & kTestBit) != 0) == test) && (i->second == mode)) {
+			i = overrides.erase(i);
+		} else {
+			++i;
+		}
+	}
+	if (mode != GhostOverride::Default) {
+		for (const auto &peer : peers) {
+			if (!peer->isSelf()) {
+				overrides[PeerKey(peer)] = mode;
+			}
+		}
+	}
+	if (overrides != Get().overrides) {
+		SetGhostChats(Serialize(overrides));
+	}
+}
+
 std::vector<GhostChat> GhostChats(not_null<Main::Session*> session) {
 	const auto test = session->isTestMode();
 	auto result = std::vector<GhostChat>();
@@ -569,17 +594,34 @@ std::vector<GhostChat> GhostChats(not_null<Main::Session*> session) {
 	return result;
 }
 
+std::vector<not_null<PeerData*>> GhostChatPeers(
+		not_null<Main::Session*> session,
+		GhostOverride mode) {
+	auto result = std::vector<not_null<PeerData*>>();
+	for (const auto &chat : GhostChats(session)) {
+		if (chat.mode == mode) {
+			result.push_back(session->data().peer(chat.id));
+		}
+	}
+	return result;
+}
+
 rpl::producer<> GhostChatsChanges() {
 	return Get().changes.events();
 }
 
