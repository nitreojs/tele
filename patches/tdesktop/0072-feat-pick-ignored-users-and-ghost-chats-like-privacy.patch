-auto IgnorePeerController::createRow(not_null<History*> history)
+auto PickPeersController::createRow(not_null<History*> history)
 -> std::unique_ptr<Row> {
 	const auto peer = history->peer;
-	if (!peer->isUser()
-		|| peer->isServiceUser()
-		|| peer->isSelf()
+	if (peer->isSelf()
 		|| peer->isRepliesChat()
 		|| peer->isVerifyCodes()
-		|| ::Tele::IsIgnored(peer)) {
+		|| !_filter(peer)) {
 		return nullptr;
 	}
-	return std::make_unique<Row>(history);
+	auto result = std::make_unique<Row>(history);
+	if (const auto chat = peer->asChat()) {
+		if (chat->count > 0) {
+			result->setCustomStatus(tr::lng_chat_status_members(
+				tr::now,
+				lt_count_decimal,
+				chat->count));
+		}
+	} else if (const auto channel = peer->asChannel()) {
+		if (channel->membersCountKnown() && channel->membersCount() > 0) {
+			result->setCustomStatus(channel->isBroadcast()
+				? tr::lng_chat_status_subscribers(
+					tr::now,
+					lt_count_decimal,
+					channel->membersCount())
+				: tr::lng_chat_status_members(
+					tr::now,
+					lt_count_decimal,
+					channel->membersCount()));
+		}
+	}
+	return result;
 }
 
