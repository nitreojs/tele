+void SetIgnoredUsers(
+		not_null<Main::Session*> session,
+		const std::vector<not_null<PeerData*>> &peers) {
+	const auto test = session->isTestMode();
+	auto keys = Get().keys;
+	for (auto i = begin(keys); i != end(keys);) {
+		if (((*i & kTestBit) != 0) == test) {
+			i = keys.erase(i);
+		} else {
+			++i;
+		}
+	}
+	for (const auto &peer : peers) {
+		if (Ignorable(peer)) {
+			keys.emplace(PeerKey(peer));
+		}
+	}
+	if (keys != Get().keys) {
+		SetIgnoredList(Serialize(keys));
+	}
+}
