From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Mon, 28 Sep 2026 03:39:09 +0300
Subject: [PATCH] feat: turn @username into a t.me link in the link box

---
 Telegram/SourceFiles/chat_helpers/message_field.cpp | 2 +-
 Telegram/SourceFiles/tele/tele_link_rewrites.cpp    | 9 +++++++++
 Telegram/SourceFiles/tele/tele_link_rewrites.h      | 2 ++
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/chat_helpers/message_field.cpp b/Telegram/SourceFiles/chat_helpers/message_field.cpp
index de09887000c8e44f6555ea5c0926bf3d2a5e4d3c..0547c9a1da1dcad930c8ccb1c1b421dc7bb3633e 100644
--- a/Telegram/SourceFiles/chat_helpers/message_field.cpp
+++ b/Telegram/SourceFiles/chat_helpers/message_field.cpp
@@ -221,7 +221,7 @@ void EditLinkBox(
 
 	const auto submit = [=] {
 		const auto linkText = text->getTextWithTags();
-		const auto linkUrl = validate(url->getLastText());
+		const auto linkUrl = validate(Tele::UsernameToLink(url->getLastText()));
 		if (linkText.text.isEmpty()) {
 			text->showError();
 			return;
diff --git a/Telegram/SourceFiles/tele/tele_link_rewrites.cpp b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
index 3df2649d6bd68dad6083cafefe6792041900c7d8..4ce9d64dddefb1c54ae2ece8c9a636fdcb904c1e 100644
--- a/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
+++ b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
@@ -639,4 +639,13 @@ Ui::InputField::MimeDataHook WithLinkRewrites(
 	};
 }
 
+QString UsernameToLink(const QString &url) {
+	static const auto kUsername = QRegularExpression(
+		u"^@([a-zA-Z][a-zA-Z0-9_]{3,31})$"_q);
+	const auto match = kUsername.match(url.trimmed());
+	return match.hasMatch()
+		? (u"https://t.me/"_q + match.captured(1))
+		: url;
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_link_rewrites.h b/Telegram/SourceFiles/tele/tele_link_rewrites.h
index 904df32f783f685a170bd0a1039baa4f2610344f..c86e322711e2cfa14a0927f5c2312dc697034f94 100644
--- a/Telegram/SourceFiles/tele/tele_link_rewrites.h
+++ b/Telegram/SourceFiles/tele/tele_link_rewrites.h
@@ -44,4 +44,6 @@ void SetLinkRewriteRules(const std::vector<LinkRewriteRule> &rules);
 	not_null<Ui::InputField*> field,
 	Ui::InputField::MimeDataHook hook);
 
+[[nodiscard]] QString UsernameToLink(const QString &url);
+
 } // namespace Tele
