From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Mon, 5 Oct 2026 10:40:55 +0300
Subject: [PATCH] fix: the menu editor hides support-only items

---
 .../SourceFiles/tele/tele_menu_editor.cpp     | 34 +++++++++++++++++--
 .../SourceFiles/tele/tele_menu_registry.cpp   |  4 +--
 .../SourceFiles/tele/tele_menu_registry.h     |  1 +
 3 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_menu_editor.cpp b/Telegram/SourceFiles/tele/tele_menu_editor.cpp
index eeb94eb1914ff40c424415af3bc31666c515b9f3..e5589bfbec9ffbcbeeed96c6cb006c56c1c6a860 100644
--- a/Telegram/SourceFiles/tele/tele_menu_editor.cpp
+++ b/Telegram/SourceFiles/tele/tele_menu_editor.cpp
@@ -4,6 +4,8 @@
 #include "base/event_filter.h"
 #include "base/timer.h"
 #include "core/application.h"
+#include "main/main_account.h"
+#include "main/main_session.h"
 #include "core/shortcuts.h"
 #include "lang/lang_keys.h"
 #include "tele/tele_lowercase.h"
@@ -193,6 +195,31 @@ void CollectSubmenus(
 	return (resolved.width >= st::expandedMenuSeparator.width);
 }
 
+[[nodiscard]] bool SupportAccount() {
+	const auto &account = Core::App().activeAccount();
+	return account.sessionExists() && account.session().supportMode();
+}
+
+[[nodiscard]] bool Listed(const MenuItemInfo &item) {
+	return !(item.flags & MenuItemFlag::SupportOnly) || SupportAccount();
+}
+
+[[nodiscard]] MenuLayout WithListed(MenuKind kind, MenuLayout layout) {
+	for (auto i = layout.begin(); i != layout.end();) {
+		if (i->type == MenuEntry::Type::Submenu) {
+			i->entries = WithListed(kind, std::move(i->entries));
+		} else if (i->type == MenuEntry::Type::Item) {
+			const auto item = LookupMenuItem(kind, i->key);
+			if (item && !Listed(*item)) {
+				i = layout.erase(i);
+				continue;
+			}
+		}
+		++i;
+	}
+	return layout;
+}
+
 [[nodiscard]] bool FeatureOn(const MenuItemInfo &item) {
 	if (!item.gate) {
 		return true;
@@ -1487,6 +1514,9 @@ Preview::Widths Preview::NaturalWidths(not_null<State*> state) {
 		nullptr,
 		popup.menu);
 	for (const auto &item : LookupMenu(state->kind).items) {
+		if (!Listed(item)) {
+			continue;
+		}
 		const auto icon = MenuItemIcon(item);
 		const auto action = menu->addAction(
 			MenuItemLabel(item),
@@ -1939,7 +1969,7 @@ void MenuEditorBox(
 	const auto &info = LookupMenu(kind);
 	const auto state = box->lifetime().make_state<State>(State{
 		.kind = kind,
-		.layout = CurrentMenuLayout(kind),
+		.layout = WithListed(kind, CurrentMenuLayout(kind)),
 		.context = PreselectContext(info, context),
 	});
 	const auto skip = st::boxRowPadding.left();
@@ -2042,7 +2072,7 @@ void MenuEditorBox(
 	}, content->lifetime());
 
 	const auto apply = [=](MenuLayout layout) {
-		state->layout = std::move(layout);
+		state->layout = WithListed(kind, std::move(layout));
 		list->refresh();
 		preview->refresh();
 	};
diff --git a/Telegram/SourceFiles/tele/tele_menu_registry.cpp b/Telegram/SourceFiles/tele/tele_menu_registry.cpp
index 0546e8f09097c544596c92c1181e8e084bd66bd8..f6352da939eed47c5b4e8669d782ee8d3c566743 100644
--- a/Telegram/SourceFiles/tele/tele_menu_registry.cpp
+++ b/Telegram/SourceFiles/tele/tele_menu_registry.cpp
@@ -858,7 +858,7 @@ constexpr auto kFieldText = uint32(1 << 0);
 		}, .contexts = kChannel },
 		{ .key = u"support_info"_q, .phrases = {
 			P([](int) { return u"Edit support info"_q; }, st::menuIconEdit),
-		}, .contexts = kPrivate },
+		}, .contexts = kPrivate, .flags = MenuItemFlag::SupportOnly },
 		{ .key = u"boost"_q, .phrases = {
 			P([](int) { return tr::lng_boost_group_button(tr::now); },
 				st::menuIconBoosts),
@@ -1119,7 +1119,7 @@ constexpr auto kFieldText = uint32(1 << 0);
 		}, .contexts = kUsers | kChats },
 		{ .key = u"support_info"_q, .phrases = {
 			P([](int) { return u"Edit support info"_q; }, st::menuIconEdit),
-		}, .contexts = kPrivate },
+		}, .contexts = kPrivate, .flags = MenuItemFlag::SupportOnly },
 		{ .key = u"add_contact"_q, .phrases = {
 			P([](int) { return tr::lng_info_add_as_contact(tr::now); },
 				st::menuIconInvite),
diff --git a/Telegram/SourceFiles/tele/tele_menu_registry.h b/Telegram/SourceFiles/tele/tele_menu_registry.h
index 5e7ec81b2c187cae2b1fae12b42e3561f4330b89..2ca1242ba7065cbbe964e4ce98ac1bc56195ba5e 100644
--- a/Telegram/SourceFiles/tele/tele_menu_registry.h
+++ b/Telegram/SourceFiles/tele/tele_menu_registry.h
@@ -24,6 +24,7 @@ enum class MenuItemFlag : uchar {
 	Strip = (1 << 2),
 	Submenu = (1 << 3),
 	TopLevel = (1 << 4),
+	SupportOnly = (1 << 5),
 };
 inline constexpr bool is_flag_type(MenuItemFlag) { return true; }
 using MenuItemFlags = base::flags<MenuItemFlag>;
