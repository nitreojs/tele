--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_wallet_address.cpp
@@ -0,0 +1,80 @@
+#include "tele/tele_wallet_address.h"
+
+#include "ui/text/text_utilities.h"
+#include "ui/widgets/labels.h"
+#include "styles/style_basic.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kGroup = 4;
+constexpr auto kGroupsPerLine = 4;
+
+} // namespace
+
+TextWithEntities WalletAddressText(const QString &address) {
+	auto result = TextWithEntities();
+	auto line = TextWithEntities();
+	const auto flush = [&] {
+		if (line.text.isEmpty()) {
+			return;
+		} else if (!result.text.isEmpty()) {
+			result.append(QChar('\n'));
+		}
+		result.append(Ui::Text::Wrapped(
+			base::take(line),
+			EntityType::Code));
+	};
+	auto index = 0;
+	for (auto offset = 0; offset < address.size(); offset += kGroup) {
+		const auto row = index / kGroupsPerLine;
+		const auto column = index % kGroupsPerLine;
+		++index;
+		if (!column) {
+			flush();
+		} else {
+			line.append(QChar(' '));
+		}
+		const auto group = address.mid(offset, kGroup);
+		if ((row + column) % 2) {
+			line.append(Ui::Text::Colorized(group, 1));
+		} else {
+			line.append(group);
+		}
+	}
+	flush();
+	return result;
+}
+
+TextWithEntities WalletAddressLines(const QStringList &lines) {
+	auto result = TextWithEntities();
+	for (auto row = 0; row != int(lines.size()); ++row) {
+		if (row) {
+			result.append(QChar('\n'));
+		}
+		const auto groups = lines[row].split(QChar(' '));
+		for (auto column = 0; column != int(groups.size()); ++column) {
+			if (column) {
+				result.append(QChar(' '));
+			}
+			if ((row + column) % 2) {
+				result.append(Ui::Text::Colorized(groups[column], 1));
+			} else {
+				result.append(groups[column]);
+			}
+		}
+	}
+	return result;
+}
+
+void SetupWalletAddressColors(not_null<Ui::FlatLabel*> label) {
+	const auto colors = label->lifetime().make_state<
+		std::array<Ui::Text::SpecialColor, 1>>();
+	(*colors)[0] = {
+		.pen = &st::windowSubTextFg->p,
+		.penSelected = &st::windowSubTextFg->p,
+	};
+	label->setColors(*colors);
+}
+
+} // namespace Tele
