 }
 
 [[nodiscard]] TextWithEntities DetailsAddressValue(const QStringList &lines) {
-	auto result = tr::marked(lines.join(QChar('\n')));
+	auto result = Tele::WalletAddressLines(lines);
 	if (result.empty()) {
 		return result;
 	}
