+		_overflow ? &st::dialogsMenuToggle.icon : &st::menuIconDelete,
+		_overflow ? &st::dialogsMenuToggle.iconOver : &st::menuIconDelete);
+	_delete->setAccessibleName(_overflow
+		? Lower(u"More actions"_q)
+		: tr::lng_profile_clear_and_exit(tr::now));
 	_clear->moveToLeft(skip.x(), skip.y());
 	auto right = width() - skip.x();
 	for (const auto &button : ranges::views::reverse(_actions)) {
@@ -526,6 +571,53 @@ void Bar::addToFolder(FilterId id) {
