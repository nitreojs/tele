 void Bar::updateControlsGeometry() {
 	const auto skip = st::dialogsFilterPadding;
+	auto required = _clear->width() + 2 * skip.x();
+	for (const auto &button : _actions) {
+		if (!button->isHidden()) {
+			required += button->width();
