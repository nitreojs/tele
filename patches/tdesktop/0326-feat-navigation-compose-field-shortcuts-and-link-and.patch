+bool InterceptLink(const QString &url, const QVariant &context) {
+	if (ReopeningLinks > 0) {
+		return false;
+	}
+	auto session = (Main::Session*)nullptr;
+	if (const auto window = context.value<ClickHandlerContext>().sessionWindow.get()) {
+		session = &window->session();
+	} else if (const auto active = Core::App().activeWindow()) {
+		if (const auto controller = active->sessionController()) {
+			session = &controller->session();
+		}
+	}
+	const auto host = session ? Host::Find(session) : nullptr;
+	if (!host || !host->interceptsLinks()) {
+		return false;
+	}
+	host->interceptLink(url, context);
+	return true;
+}
+
+bool InterceptNotification(const Data::ItemNotification &notification) {
+	if (ReschedulingNotifications > 0) {
+		return false;
+	}
+	const auto item = notification.item;
+	const auto host = Host::Find(&item->history()->session());
+	if (!host || !host->interceptsNotifications()) {
+		return false;
+	}
+	const auto sender = notification.reactionOrVoteSender;
+	host->interceptNotification({
+		.peer = item->history()->peer->id,
+		.msg = item->id,
+		.from = sender ? sender->id : PeerId(),
+		.kind = int(notification.type),
+	});
+	return true;
+}
+
 bool CapturesMessages(not_null<Main::Session*> session) {
 	const auto host = Host::Find(session);
 	return host && host->running();
