+void Instance::interceptLink(
+		QString url,
+		Fn<void(std::optional<QString>)> done) {
+	if (!_engine) {
+		done(url);
+		return;
+	}
+	runGate(
+		Kind::Link,
+		"__teleRunLinks",
+		NewString(_engine->ctx(), url),
+		u"interceptLink"_q,
+		url,
+		std::move(done));
+}
