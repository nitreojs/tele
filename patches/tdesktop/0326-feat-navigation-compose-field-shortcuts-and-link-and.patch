+bool Host::interceptsLinks() const {
+	return ranges::any_of(_entries, [](const Entry &entry) {
+		return entry.instance && entry.instance->interceptsLinks();
+	});
+}
+
+void Host::interceptLink(QString url, QVariant context) {
+	auto scripts = std::vector<QString>();
+	for (const auto &entry : _entries) {
+		if (entry.instance && entry.instance->interceptsLinks()) {
+			scripts.push_back(entry.file.id);
+		}
+	}
+	runLinks(std::move(url), std::move(context), std::move(scripts), 0);
+}
+
+void Host::runLinks(
+		QString url,
+		QVariant context,
+		std::vector<QString> scripts,
+		int index) {
+	if (index >= int(scripts.size())) {
+		++ReopeningLinks;
+		UrlClickHandler::Open(url, context);
+		--ReopeningLinks;
+		return;
+	}
+	const auto instance = instanceOf(scripts[index]);
+	if (!instance || !instance->interceptsLinks()) {
+		runLinks(std::move(url), std::move(context), std::move(scripts), index + 1);
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	instance->interceptLink(url, [=](std::optional<QString> result) {
+		crl::on_main(weak, [=] {
+			if (result) {
+				runLinks(*result, context, scripts, index + 1);
+			}
+		});
+	});
+}
+
+bool Host::interceptsNotifications() const {
+	return ranges::any_of(_entries, [](const Entry &entry) {
+		return entry.instance && entry.instance->interceptsNotifications();
+	});
+}
+
+void Host::interceptNotification(NotificationData data) {
+	auto scripts = std::vector<QString>();
+	for (const auto &entry : _entries) {
+		if (entry.instance && entry.instance->interceptsNotifications()) {
+			scripts.push_back(entry.file.id);
+		}
+	}
+	runNotifications(data, std::move(scripts), 0);
+}
+
+void Host::runNotifications(
+		NotificationData data,
+		std::vector<QString> scripts,
+		int index) {
+	if (index >= int(scripts.size())) {
+		auto &owner = _session->data();
+		const auto item = owner.message(data.peer, data.msg);
+		if (!item) {
+			return;
+		}
+		const auto sender = peerIsUser(data.from)
+			? owner.userLoaded(peerToUser(data.from))
+			: nullptr;
+		++ReschedulingNotifications;
+		Core::App().notifications().schedule({
+			.item = item,
+			.reactionOrVoteSender = sender,
+			.type = Data::ItemNotificationType(data.kind),
+		});
+		--ReschedulingNotifications;
+		return;
+	}
+	const auto instance = instanceOf(scripts[index]);
+	if (!instance || !instance->interceptsNotifications()) {
+		runNotifications(data, std::move(scripts), index + 1);
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	instance->interceptNotification(data, [=](bool show) {
+		crl::on_main(weak, [=] {
+			if (show) {
+				runNotifications(data, scripts, index + 1);
+			}
+		});
+	});
+}
