+JSValue Instance::NativeApp(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = instance->_session;
+	const auto window = session->tryResolveWindow();
+	const auto given = [&](int index) {
+		return argc > index
+			&& !JS_IsNull(argv[index])
+			&& !JS_IsUndefined(argv[index]);
+	};
+	const auto peerAt = [&](int index) -> PeerData* {
+		const auto id = given(index)
+			? PeerFromValue(ctx, argv[index], session->user()->id)
+			: std::nullopt;
+		return id ? session->data().peerLoaded(*id) : nullptr;
+	};
+	const auto activePeer = [&]() -> PeerData* {
+		return window ? window->activeChatCurrent().peer() : nullptr;
+	};
+	const auto later = [&](Fn<void(not_null<Window::SessionController*>)> fn) {
+		if (!window) {
+			return ThrowTeleError(
+				ctx,
+				"unsupported",
+				u"this account has no window"_q);
+		}
+		const auto weak = base::make_weak(window);
+		crl::on_main(weak, [=] {
+			if (const auto strong = weak.get()) {
+				fn(strong);
+			}
+		});
+		return JS_UNDEFINED;
+	};
+	const auto enroll = [&](Kind kind, JSValueConst fn) {
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = kind,
+			.fn = JS_DupValue(ctx, fn),
+		});
+		return id;
+	};
+	switch (magic) {
+	case 0:
+	case 1: {
+		const auto peer = peerAt(0);
+		if (!peer) {
+			return JS_ThrowTypeError(ctx, "this peer isn't in tele's cache");
+		}
+		auto msg = std::int64_t();
+		if (magic == 0 && given(1) && JS_ToInt64(ctx, &msg, argv[1])) {
+			return JS_EXCEPTION;
+		}
+		const auto peerId = peer->id;
+		return later([=](not_null<Window::SessionController*> window) {
+			if (magic == 0) {
+				window->showPeerHistory(
+					peerId,
+					Window::SectionShow::Way::ClearStack,
+					msg ? MsgId(msg) : ShowAtUnreadMsgId);
+			} else {
+				window->showPeerInfo(peerId);
+			}
+		});
+	}
+	case 2: {
+		using Factory = Settings::Type (*)();
+		static const auto sections = std::array<
+			std::pair<std::string_view, Factory>,
+			13>{ {
+			{ "main", Settings::MainId },
+			{ "chat", Settings::ChatId },
+			{ "notifications", Settings::NotificationsId },
+			{ "privacy", Settings::PrivacySecurityId },
+			{ "advanced", Settings::AdvancedId },
+			{ "folders", Settings::FoldersId },
+			{ "calls", Settings::CallsId },
+			{ "information", Settings::InformationId },
+			{ "premium", Settings::PremiumId },
+			{ "sessions", Settings::SessionsId },
+			{ "blocked", Settings::BlockedPeersId },
+			{ "shortcuts", Settings::ShortcutsId },
+			{ "tele", Settings::TeleNewSectionId },
+		} };
+		const auto name = given(0) ? ToStd(ctx, argv[0]) : std::string("main");
+		const auto i = ranges::find(sections, name, [](const auto &pair) {
+			return pair.first;
+		});
+		if (i == end(sections)) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.openSettings: %s isn't a settings section",
+				name.c_str());
+		}
+		const auto factory = i->second;
+		return later([=](not_null<Window::SessionController*> window) {
+			window->showSettings(factory());
+		});
+	}
+	case 3:
+		return later([](not_null<Window::SessionController*> window) {
+			window->showBackFromStack();
+		});
+	case 4: {
+		auto result = JS_NewObject(ctx);
+		const auto peer = activePeer();
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"chatId",
+			peer ? JS_NewBigInt64(ctx, MarkedId(peer->id)) : JS_NULL);
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"windowActive",
+			JS_NewBool(ctx, window && window->widget()->isActive()));
+		return result;
+	}
+	case 5:
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.ui.onChatOpened(function)");
+		} else {
+			const auto id = enroll(Kind::ChatOpened, argv[0]);
+			instance->watchChats();
+			return instance->disposer(id);
+		}
+	case 6:
+	case 7:
+	case 8: {
+		const auto reading = (magic == 6);
+		const auto what = reading
+			? "tg.compose.get"
+			: (magic == 7)
+			? "tg.compose.set"
+			: "tg.compose.insert";
+		const auto capability = reading
+			? Capability::AccountRead
+			: Capability::AccountWrite;
+		if (!instance->_permissions.allows(capability, "draft")) {
+			return ThrowNotGranted(
+				ctx,
+				QString::fromLatin1(what),
+				GrantText(capability, "draft"));
+		}
+		const auto index = reading ? 0 : 1;
+		const auto peer = given(index) ? peerAt(index) : activePeer();
+		const auto found = peer
+			? FindComposeField(not_null(peer))
+			: std::optional<ComposeField>();
+		if (!found) {
+			return reading ? JS_NULL : JS_FALSE;
+		}
+		const auto field = found->field;
+		if (reading) {
+			const auto value = field->getTextWithTags();
+			const auto entities = Api::EntitiesToMTP(
+				session,
+				TextUtilities::ConvertTextTagsToEntities(value.tags),
+				Api::ConvertOption::SkipLocal);
+			auto buffer = mtpBuffer();
+			entities.write(buffer);
+			auto decoded = DecodeTl(
+				ctx,
+				Bytes(buffer),
+				"Vector<MessageEntity>");
+			auto text = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, text, "text", NewString(ctx, value.text));
+			JS_SetPropertyStr(
+				ctx,
+				text,
+				"entities",
+				decoded.error.empty() ? decoded.value : JS_NewArray(ctx));
+			auto result = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				result,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(found->peer->id)));
+			JS_SetPropertyStr(ctx, result, "text", text);
+			return result;
+		}
+		auto text = (argc > 0)
+			? instance->textFromValue(argv[0], QString::fromLatin1(what))
+			: std::optional<TextWithTags>();
+		if (!text) {
+			return JS_ThrowTypeError(
+				ctx,
+				"%s needs a string or { text, entities }",
+				what);
+		}
+		if (magic == 7) {
+			field->setTextWithTags(*text);
+			field->setCursorPosition(int(text->text.size()));
+		} else {
+			const auto position = field->textCursor().position();
+			auto result = field->getTextWithTagsPart(0, position);
+			AppendTextWithTags(result, *text);
+			const auto cursor = int(result.text.size());
+			AppendTextWithTags(result, field->getTextWithTagsPart(position));
+			field->setTextWithTags(result);
+			field->setCursorPosition(cursor);
+		}
+		return JS_TRUE;
+	}
+	case 9:
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.compose.onInput(function)");
+		} else if (!instance->_permissions.allows(
+				Capability::AccountRead,
+				"draft")) {
+			return ThrowNotGranted(
+				ctx,
+				u"tg.compose.onInput"_q,
+				GrantText(Capability::AccountRead, "draft"));
+		} else {
+			const auto id = enroll(Kind::ComposeInput, argv[0]);
+			instance->watchCompose();
+			return instance->disposer(id);
+		}
+	case 10: {
+		if (argc < 2 || !JS_IsString(argv[0]) || !JS_IsFunction(ctx, argv[1])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.registerShortcut(keys, function)");
+		}
+		const auto keys = FromStd(ToStd(ctx, argv[0]));
+		const auto sequence = QKeySequence::fromString(
+			keys,
+			QKeySequence::PortableText);
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+		const auto first = sequence.isEmpty()
+			? 0
+			: sequence[0].toCombined();
+#else // Qt >= 6.0.0
+		const auto first = sequence.isEmpty() ? 0 : sequence[0];
+#endif // Qt < 6.0.0
+		if (sequence.isEmpty() || first == Qt::Key_unknown) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.registerShortcut: '%s' isn't a key sequence like "
+				"'Ctrl+Shift+K'",
+				keys.toUtf8().constData());
+		}
+		const auto id = enroll(Kind::Shortcut, argv[1]);
+		instance->_registrations[id].key = sequence.toString(
+			QKeySequence::PortableText);
+		instance->attachShortcut(id);
+		return instance->disposer(id);
+	}
+	case 11:
+	case 12: {
+		const auto link = (magic == 11);
+		const auto what = link
+			? "tg.interceptLink"
+			: "tg.interceptNotification";
+		const auto capability = link
+			? Capability::InterceptLink
+			: Capability::InterceptNotification;
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "%s(function)", what);
+		} else if (!instance->_permissions.any(capability)) {
+			return ThrowNotGranted(
+				ctx,
+				QString::fromLatin1(what),
+				GrantText(capability, {}));
+		}
+		const auto id = enroll(
+			link ? Kind::Link : Kind::Notification,
+			argv[0]);
+		return instance->disposer(id);
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+void Instance::callRegistered(
+		Kind kind,
+		JSValue payload,
+		const QString &where) {
+	if (!_engine) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto fns = std::vector<JSValue>();
+	for (const auto &[key, registration] : _registrations) {
+		if (registration.kind == kind) {
+			fns.push_back(JS_DupValue(ctx, registration.fn));
+		}
+	}
+	for (const auto fn : fns) {
+		if (!_engine) {
+			break;
+		}
+		JSValueConst args[] = { payload };
+		JS_FreeValue(ctx, invoke(fn, args, kListenerBudget, where));
+	}
+	if (_engine) {
+		release(fns);
+		JS_FreeValue(ctx, payload);
+		_engine->drain();
+	}
+}
