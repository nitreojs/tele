+JSValue Instance::GateSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	const auto i = instance->_gateRuns.find(key);
+	if (i == end(instance->_gateRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto where = i->second.where;
+	const auto fallback = i->second.fallback;
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(where, instance->_engine->describe(value));
+		instance->finishGate(key, fallback);
+		return JS_UNDEFINED;
+	}
+	auto verdict = JS_GetPropertyStr(ctx, value, "verdict");
+	auto url = JS_GetPropertyStr(ctx, value, "url");
+	const auto drop = (ToStd(ctx, verdict) == "drop");
+	const auto result = JS_IsString(url)
+		? FromStd(ToStd(ctx, url))
+		: fallback;
+	JS_FreeValue(ctx, verdict);
+	JS_FreeValue(ctx, url);
+	instance->finishGate(
+		key,
+		drop ? std::optional<QString>() : std::optional<QString>(result));
+	return JS_UNDEFINED;
+}
