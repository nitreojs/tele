+
+void Instance::interceptNotification(
+		NotificationData data,
+		Fn<void(bool)> done) {
+	if (!_engine) {
+		done(true);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	static const auto kinds = std::array<const char*, 3>{
+		"message",
+		"reaction",
+		"pollVote",
+	};
+	auto payload = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		payload,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(data.peer)));
+	JS_SetPropertyStr(
+		ctx,
+		payload,
+		"kind",
+		JS_NewString(
+			ctx,
+			kinds[std::clamp(data.kind, 0, int(kinds.size()) - 1)]));
+	JS_SetPropertyStr(
+		ctx,
+		payload,
+		"fromId",
+		data.from ? JS_NewBigInt64(ctx, MarkedId(data.from)) : JS_NULL);
+	auto message = JS_NULL;
+	if (_permissions.allows(Capability::AccountRead, "messages")) {
+		if (const auto bytes = CachedMessage(_session, data.peer, data.msg)) {
+			auto decoded = DecodeTl(ctx, *bytes, "Message", filter());
+			if (decoded.error.empty()) {
+				message = decoded.value;
+			}
+		}
+	}
+	JS_SetPropertyStr(ctx, payload, "message", message);
+	runGate(
+		Kind::Notification,
+		"__teleRunNotifications",
+		payload,
+		u"interceptNotification"_q,
+		u"show"_q,
+		[=](std::optional<QString> result) { done(result.has_value()); });
+}
+
+void Instance::runGate(
+		Kind kind,
+		const char *runner,
+		JSValue payload,
+		QString where,
+		QString fallback,
+		Fn<void(std::optional<QString>)> done) {
+	const auto ctx = _engine->ctx();
+	auto handlers = JS_NewArray(ctx);
+	auto count = std::uint32_t();
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == kind) {
+			JS_SetPropertyUint32(
+				ctx,
+				handlers,
+				count++,
+				JS_DupValue(ctx, registration.fn));
+		}
+	}
+	const auto key = ++_gateRunKey;
+	_gateRuns.emplace(key, GateRun{
+		.done = std::move(done),
+		.where = where,
+		.fallback = fallback,
+	});
+	auto global = JS_GetGlobalObject(ctx);
+	auto fn = JS_GetPropertyStr(ctx, global, runner);
+	JS_FreeValue(ctx, global);
+	auto report = JS_NewCFunctionMagic(
+		ctx,
+		UpdateFault,
+		"fault",
+		2,
+		JS_CFUNC_generic_magic,
+		0);
+	JSValueConst args[] = { payload, handlers, report };
+	auto promise = invoke(fn, args, kListenerBudget, where);
+	for (const auto value : { fn, report, handlers, payload }) {
+		JS_FreeValue(ctx, value);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishGate(key, fallback);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, GateSettled, key));
+	_engine->drain();
+	if (!_gateRuns.contains(key)) {
+		return;
+	}
+	base::call_delayed(kMiddlewareBudget, this, [=] {
+		if (_gateRuns.contains(key)) {
+			fault(where, u"took longer than 10 s"_q);
+			finishGate(key, fallback);
+		}
+	});
+}
+
+void Instance::finishGate(int key, std::optional<QString> result) {
+	const auto i = _gateRuns.find(key);
+	if (i == end(_gateRuns)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	_gateRuns.erase(i);
+	done(std::move(result));
+}
