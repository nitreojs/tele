+void Instance::watchChats() {
+	if (_watchingChats || !_engine) {
+		return;
+	}
+	const auto window = _session->tryResolveWindow();
+	if (!window) {
+		base::call_delayed(1000, this, [=] {
+			watchChats();
+		});
+		return;
+	}
+	_watchingChats = true;
+	window->activeChatValue(
+	) | rpl::skip(1) | rpl::on_next([=](Dialogs::Key key) {
+		const auto peer = key.peer();
+		const auto peerId = peer ? peer->id : PeerId();
+		crl::on_main(this, [=] {
+			if (!_engine) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			const auto loaded = peerId
+				? _session->data().peerLoaded(peerId)
+				: nullptr;
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				payload,
+				"chatId",
+				loaded ? JS_NewBigInt64(ctx, MarkedId(peerId)) : JS_NULL);
+			JS_SetPropertyStr(
+				ctx,
+				payload,
+				"chat",
+				loaded ? peerInfo(loaded) : JS_NULL);
+			callRegistered(Kind::ChatOpened, payload, u"onChatOpened"_q);
+		});
+	}, _chatsLifetime);
+}
+
+void Instance::watchCompose() {
+	if (_watchingCompose) {
+		return;
+	}
+	_watchingCompose = true;
+	ComposeChanges(
+	) | rpl::filter([=](const ComposeField &field) {
+		return (&field.peer->session() == _session.get());
+	}) | rpl::on_next([=](const ComposeField &field) {
+		const auto peerId = field.peer->id;
+		const auto text = field.field->getLastText();
+		crl::on_main(this, [=] {
+			if (!_engine) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				payload,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(peerId)));
+			JS_SetPropertyStr(ctx, payload, "text", NewString(ctx, text));
+			callRegistered(Kind::ComposeInput, payload, u"compose.onInput"_q);
+		});
+	}, _composeLifetime);
+}
+
+void Instance::attachShortcut(int id) {
+	const auto i = _registrations.find(id);
+	if (i == end(_registrations) || !_engine) {
+		return;
+	}
+	const auto window = _session->tryResolveWindow();
+	if (!window) {
+		base::call_delayed(1000, this, [=] {
+			attachShortcut(id);
+		});
+		return;
+	}
+	auto shortcut = base::make_unique_q<QShortcut>(
+		QKeySequence::fromString(i->second.key, QKeySequence::PortableText),
+		window->widget().get());
+	shortcut->setContext(Qt::WindowShortcut);
+	const auto keys = i->second.key;
+	QObject::connect(shortcut.get(), &QShortcut::activated, [=] {
+		crl::on_main(this, [=] {
+			const auto j = _registrations.find(id);
+			if (!_engine || j == end(_registrations)) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			auto fn = JS_DupValue(ctx, j->second.fn);
+			JS_FreeValue(
+				ctx,
+				invoke(fn, {}, kListenerBudget, u"shortcut "_q + keys));
+			JS_FreeValue(ctx, fn);
+			if (_engine) {
+				_engine->drain();
+			}
+		});
+	});
+	_shortcuts[id] = std::move(shortcut);
+}
