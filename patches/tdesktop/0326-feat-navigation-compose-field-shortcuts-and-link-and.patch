--- /dev/null
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_compose.cpp
@@ -0,0 +1,70 @@
+#include "tele/scripting/tele_script_compose.h"
+
+#include "ui/widgets/fields/input_field.h"
+
+#include <QtCore/QPointer>
+
+namespace Tele::Scripting {
+namespace {
+
+struct Tracked {
+	QPointer<Ui::InputField> field;
+	Fn<PeerData*()> peer;
+};
+
+[[nodiscard]] std::vector<Tracked> &Fields() {
+	static auto result = std::vector<Tracked>();
+	return result;
+}
+
+[[nodiscard]] rpl::event_stream<ComposeField> &Changes() {
+	static auto result = rpl::event_stream<ComposeField>();
+	return result;
+}
+
+void Prune() {
+	auto &fields = Fields();
+	fields.erase(ranges::remove_if(fields, [](const Tracked &tracked) {
+		return !tracked.field;
+	}), end(fields));
+}
+
+} // namespace
+
+void TrackComposeField(
+		not_null<Ui::InputField*> field,
+		Fn<PeerData*()> peer) {
+	Prune();
+	Fields().push_back({ .field = field.get(), .peer = peer });
+	const auto weak = QPointer<Ui::InputField>(field.get());
+	field->changes() | rpl::on_next([=] {
+		const auto strong = weak.data();
+		const auto current = strong ? peer() : nullptr;
+		if (strong && current) {
+			Changes().fire({ .field = strong, .peer = current });
+		}
+	}, field->lifetime());
+}
+
+std::optional<ComposeField> FindComposeField(not_null<PeerData*> peer) {
+	Prune();
+	auto result = std::optional<ComposeField>();
+	for (const auto &tracked : Fields()) {
+		if (tracked.peer() != peer.get()) {
+			continue;
+		}
+		const auto field = not_null(tracked.field.data());
+		if (field->hasFocus()) {
+			return ComposeField{ .field = field, .peer = peer };
+		} else if (!result || (field->isVisible() && !result->field->isVisible())) {
+			result = ComposeField{ .field = field, .peer = peer };
+		}
+	}
+	return result;
+}
+
+rpl::producer<ComposeField> ComposeChanges() {
+	return Changes().events();
+}
+
+} // namespace Tele::Scripting
