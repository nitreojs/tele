diff --git a/Telegram/SourceFiles/tele/tele_failed_sends.cpp b/Telegram/SourceFiles/tele/tele_failed_sends.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ccc4b55163a916dc60f9f8ba5e5d8f7e3709d536
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_failed_sends.cpp
@@ -0,0 +1,193 @@
+#include "tele/tele_failed_sends.h"
+
+#include "api/api_common.h"
+#include "api/api_sending.h"
+#include "apiwrap.h"
+#include "data/data_document.h"
+#include "data/data_drafts.h"
+#include "data/data_media_types.h"
+#include "data/data_photo.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "tele/tele_lowercase.h"
+#include "ui/painter.h"
+#include "ui/widgets/menu/menu_action.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+enum class Kind : uchar {
+	None,
+	Text,
+	Document,
+	Photo,
+};
+
+[[nodiscard]] bool RemotePhoto(not_null<PhotoData*> photo) {
+	const auto input = photo->mtpInput();
+	return (input.type() == mtpc_inputPhoto)
+		&& (input.c_inputPhoto().vaccess_hash().v != 0);
+}
+
+[[nodiscard]] Kind RetryKind(not_null<HistoryItem*> item) {
+	if (!item->hasFailed()
+		|| item->isScheduled()
+		|| item->isBusinessShortcut()
+		|| item->isWelcomeTemplate()
+		|| item->isEphemeral()
+		|| item->starsPaid()
+		|| item->groupId()
+		|| item->viaBot()
+		|| item->richPage()
+		|| item->Get<HistoryMessageForwarded>()) {
+		return Kind::None;
+	}
+	const auto media = item->media();
+	if (!media || media->webpage()) {
+		return item->originalText().empty() ? Kind::None : Kind::Text;
+	} else if (media->ttlSeconds()) {
+		return Kind::None;
+	} else if (dynamic_cast<Data::MediaFile*>(media)) {
+		const auto document = media->document();
+		return (document && document->hasRemoteLocation())
+			? Kind::Document
+			: Kind::None;
+	} else if (dynamic_cast<Data::MediaPhoto*>(media)) {
+		const auto photo = media->photo();
+		return (photo && RemotePhoto(photo)) ? Kind::Photo : Kind::None;
+	}
+	return Kind::None;
+}
+
+void Retry(not_null<HistoryItem*> item) {
+	const auto kind = RetryKind(item);
+	if (kind == Kind::None) {
+		return;
+	}
+	const auto history = item->history();
+	const auto media = item->media();
+	auto action = Api::SendAction(history);
+	action.replyTo = item->replyTo();
+	action.clearDraft = false;
+	action.options.silent = item->isSilent();
+	action.options.effectId = item->effectId();
+	action.options.invertCaption = item->invertMedia();
+	action.options.mediaSpoiler = media && media->hasSpoiler();
+	const auto from = item->from();
+	if (from != history->peer && !from->isSelf()) {
+		action.options.sendAs = from;
+	}
+	auto message = Api::MessageToSend(action);
+	const auto &text = item->originalText();
+	message.textWithTags = TextWithTags{
+		text.text,
+		TextUtilities::ConvertEntitiesToTextTags(text.entities),
+	};
+	if (kind == Kind::Text) {
+		message.webPage = Data::WebPageDraft::FromItem(item);
+		history->session().api().sendMessage(std::move(message));
+	} else if (kind == Kind::Document) {
+		Api::SendExistingDocument(std::move(message), media->document());
+	} else {
+		Api::SendExistingPhoto(std::move(message), media->photo());
+	}
+	item->destroy();
+}
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> Retryable(
+		not_null<History*> history) {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (const auto &item : history->clientSideMessages()) {
+		if (RetryKind(item) != Kind::None) {
+			result.push_back(item);
+		}
+	}
+	ranges::sort(result, [](
+			not_null<HistoryItem*> a,
+			not_null<HistoryItem*> b) {
+		return (a->date() != b->date())
+			? (a->date() < b->date())
+			: (a->id < b->id);
+	});
+	return result;
+}
+
+void InsertAction(
+		not_null<Ui::PopupMenu*> menu,
+		int position,
+		const QString &text,
+		Fn<void()> callback) {
+	const auto icon = &st::menuIconRestore;
+	const auto raw = menu->menu();
+	menu->insertAction(position, base::make_unique_q<Ui::Menu::Action>(
+		raw,
+		menu->st().menu,
+		Ui::Menu::CreateAction(raw, text, std::move(callback)),
+		icon,
+		icon));
+}
+
+} // namespace
+
+void PaintFailedIcon(
+		QPainter &p,
+		const style::icon &clock,
+		QPoint position,
+		QPoint offset,
+		int outerWidth) {
+	const auto size = std::max(clock.width(), clock.height())
+		+ style::ConvertScale(4);
+	auto left = position.x()
+		+ style::ConvertScale(offset.x())
+		+ (clock.width() - size) / 2;
+	const auto top = position.y()
+		+ style::ConvertScale(offset.y())
+		+ (clock.height() - size) / 2;
+	if (style::RightToLeft()) {
+		left = outerWidth - left - size;
+	}
+	p.save();
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::boxTextFgError);
+	p.drawEllipse(QRectF(left, top, size, size));
+	auto pen = QPen(st::windowFgActive->c);
+	pen.setWidthF(size / 7.);
+	pen.setCapStyle(Qt::RoundCap);
+	p.setPen(pen);
+	const auto x = left + size / 2.;
+	const auto y = top + size / 2.;
+	p.drawLine(QPointF(x, y - size * 0.26), QPointF(x, y + size * 0.06));
+	p.drawPoint(QPointF(x, y + size * 0.25));
+	p.restore();
+}
+
+void AddRetryFailedActions(
+		not_null<Ui::PopupMenu*> menu,
+		HistoryItem *item) {
+	if (!item || RetryKind(item) == Kind::None) {
+		return;
+	}
+	const auto history = item->history();
+	const auto itemId = item->fullId();
+	InsertAction(menu, 0, Lower(tr::lng_bot_download_retry(tr::now)), [=] {
+		if (const auto item = history->owner().message(itemId)) {
+			Retry(item);
+		}
+	});
+	if (Retryable(history).size() > 1) {
+		InsertAction(menu, 1, Lower(u"Retry all failed in this chat"_q), [=] {
+			for (const auto &item : Retryable(history)) {
+				Retry(item);
+			}
+		});
+	}
+}
+
+} // namespace Tele
