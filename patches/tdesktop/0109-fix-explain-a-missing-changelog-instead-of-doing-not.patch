 	QNetworkAccessManager _manager;
 	base::flat_set<Key> _started;
 	base::flat_set<not_null<Main::Account*>> _existing;
 	base::flat_set<Key> _pending;
 	std::vector<base::weak_ptr<Main::Session>> _waiting;
+	std::vector<Opening> _opening;
 	std::optional<Notes> _notes;
 	bool _fetching = false;
 	bool _failed = false;
@@ -99,6 +126,44 @@ QPointer<Changelog> Instance;
 		+ u"/tele-changelog.json"_q;
 }
 
+[[nodiscard]] QString MissingText(Missing missing) {
+	switch (missing) {
+	case Missing::Unpublished:
+		return u"There are no release notes for this tele version."_q;
+	case Missing::Offline:
+		return u"There are no release notes for this tele version: "
+			"updates are off for this launch."_q;
+	case Missing::Local:
+		return u"There are no release notes for this tele version: "
+			"it's a local build."_q;
+	case Missing::Failed:
+		return u"Couldn't load the release notes for this tele version, "
+			"try again later."_q;
+	}
+	Unexpected("Missing in Tele::MissingText.");
+}
+
+void MissingBox(not_null<Ui::GenericBox*> box, Missing missing) {
+	box->setTitle(rpl::single(Lower(u"What's new"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(MissingText(missing)),
+		st::boxLabel));
+	box->addButton(tr::lng_box_ok(), [=] {
+		box->closeBox();
+	});
+	box->addButton(rpl::single(Lower(u"Full changelog"_q)), [=] {
+		box->closeBox();
+		UrlClickHandler::Open(QString::fromLatin1(kReleasesUrl));
+	});
+}
+
+void ShowMissing(
+		not_null<Window::SessionController*> controller,
+		Missing missing) {
+	controller->show(Box(MissingBox, missing));
+}
+
 [[nodiscard]] QString Category(const QJsonValue &value) {
 	const auto result = value.toString().trimmed();
 	return (result.size() > kMaxTitleLength) ? QString() : result;
@@ -167,12 +232,13 @@ QPointer<Changelog> Instance;
 	return { Lower(notes.title + u" is here"_q) };
 }
 
-void AddFullLink(ChangelogMessage &message, const Notes &notes) {
-	if (notes.url.isEmpty()) {
-		return;
+void AddButtons(ChangelogMessage &message, const Notes &notes) {
+	if (!notes.url.isEmpty()) {
+		message.buttons.push_back({
+			.text = Lower(u"Full changelog"_q),
+			.url = notes.url,
+		});
 	}
-	message.buttonText = Lower(u"Full changelog"_q);
-	message.buttonUrl = notes.url;
 }
 
 [[nodiscard]] TextWithEntities EntryText(const Entry &entry) {
@@ -278,7 +344,7 @@ void AppendMessages(
 		result = PlainNotes(notes);
 	}
 	if (!result.empty()) {
-		AddFullLink(result.back(), notes);
+		AddButtons(result.back(), notes);
 	}
 	return result;
 }
@@ -415,7 +481,7 @@ void Changelog::request(not_null<Main::Session*> session) {
 
 void Changelog::fetch() {
 	if (UpdatesOffForLaunch()) {
-		fail(u"off for this launch"_q);
+		fail(u"off for this launch"_q, Missing::Offline);
 		return;
 	}
 	_fetching = true;
@@ -439,11 +505,17 @@ void Changelog::fetch() {
 		const auto code = reply->attribute(
 			QNetworkRequest::HttpStatusCodeAttribute).toInt();
 		if (*tooLarge) {
-			fail(u"response is too large"_q);
+			fail(u"response is too large"_q, Missing::Failed);
+		} else if (code == 404) {
+			fail(u"not published"_q, Missing::Unpublished);
 		} else if (reply->error() != QNetworkReply::NoError) {
-			fail(u"network error: %1"_q.arg(reply->errorString()));
+			fail(
+				u"network error: %1"_q.arg(reply->errorString()),
+				Missing::Failed);
 		} else if (code != 200) {
-			fail(u"unexpected http status %1"_q.arg(code));
+			fail(
+				u"unexpected http status %1"_q.arg(code),
+				Missing::Failed);
 		} else {
 			fetched(reply->readAll());
 		}
@@ -454,18 +526,59 @@ void Changelog::fetched(const QByteArray &data) {
 	_fetching = false;
 	auto notes = Parse(data);
 	if (!notes) {
-		fail(u"malformed changelog"_q);
+		fail(u"malformed changelog"_q, Missing::Unpublished);
 		return;
 	}
 	_notes = std::move(notes);
 	flush();
+	for (const auto &opening : base::take(_opening)) {
+		if (const auto controller = opening.controller.get()) {
+			show(controller, opening.params);
+		}
+	}
 }
 
-void Changelog::fail(const QString &error) {
+void Changelog::fail(const QString &error, Missing missing) {
 	LOG(("Tele Changelog Error: %1").arg(error));
 	_fetching = false;
 	_failed = true;
 	_waiting.clear();
+	for (const auto &opening : base::take(_opening)) {
+		if (const auto controller = opening.controller.get()) {
+			ShowMissing(controller, missing);
+		}
+	}
+}
+
+void Changelog::open(
+		not_null<Window::SessionController*> controller,
+		const Window::SectionShow &params) {
+	if (_notes) {
+		show(controller, params);
+		return;
+	} else if (UpdatesOffForLaunch()) {
+		ShowMissing(controller, Missing::Offline);
+		return;
+	}
+	_opening.push_back({ base::make_weak(controller), params });
+	if (!_fetching) {
+		fetch();
+	}
+}
+
+void Changelog::show(
+		not_null<Window::SessionController*> controller,
+		const Window::SectionShow &params) {
+	const auto session = &controller->session();
+	if (!HasChangelog(session)) {
+		PostChangelog(session, Messages(session, *_notes));
+		Store(SessionKey(session));
+	}
+	if (HasChangelog(session)) {
+		ShowChangelogHistory(controller, params);
+	} else {
+		ShowMissing(controller, Missing::Unpublished);
+	}
 }
 
 void Changelog::flush() {
@@ -481,7 +594,9 @@ void Changelog::post(not_null<Main::Session*> session) {
 	const auto key = SessionKey(session);
 	const auto messages = Messages(session, *_notes);
 	const auto add = [=] {
-		PostChangelog(session, messages);
+		if (!HasChangelog(session)) {
+			PostChangelog(session, messages);
+		}
 		Store(key);
 	};
 	if (data->chatsListLoaded()) {
@@ -503,4 +618,14 @@ void StartChangelog() {
 	Instance = new Changelog();
 }
 
+void OpenChangelog(
+		not_null<Window::SessionController*> controller,
+		const Window::SectionShow &params) {
+	if (const auto instance = Instance.data()) {
+		instance->open(controller, params);
+	} else {
+		ShowMissing(controller, Missing::Local);
+	}
+}
+
 } // namespace Tele
