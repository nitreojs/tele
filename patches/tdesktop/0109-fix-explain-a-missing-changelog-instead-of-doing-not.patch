 class Changelog final : public QObject {
 public:
 	Changelog();
 
+	void open(
+		not_null<Window::SessionController*> controller,
+		const Window::SectionShow &params);
+
 private:
 	void start();
 	void activated(not_null<Main::Session*> session);
 	void request(not_null<Main::Session*> session);
 	void fetch();
 	void fetched(const QByteArray &data);
-	void fail(const QString &error);
+	void fail(const QString &error, Missing missing);
 	void flush();
 	void post(not_null<Main::Session*> session);
+	void show(
