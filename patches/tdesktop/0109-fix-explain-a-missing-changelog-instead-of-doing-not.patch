-[[nodiscard]] HistoryMessageMarkupData UrlButton(
+[[nodiscard]] HistoryMessageMarkupData UrlButtons(
 		const ChangelogMessage &message) {
 	auto result = HistoryMessageMarkupData();
-	if (message.buttonUrl.isEmpty()) {
+	if (message.buttons.empty()) {
 		return result;
 	}
 	using Button = HistoryMessageMarkupButton;
-	result.rows.push_back({ Button(
-		Button::Type::Url,
-		message.buttonText,
-		Button::Visual(),
-		message.buttonUrl.toUtf8()) });
+	auto row = std::vector<Button>();
+	row.reserve(message.buttons.size());
+	for (const auto &button : message.buttons) {
+		row.push_back(Button(
+			Button::Type::Url,
+			button.text,
+			Button::Visual(),
+			button.url.toUtf8()));
+	}
+	result.rows.push_back(std::move(row));
 	result.flags = ReplyMarkupFlag::Inline;
 	return result;
 }
 
+bool HasChangelog(not_null<Main::Session*> session) {
+	const auto history = session->data().historyLoaded(ChangelogPeerId());
+	return history && !history->clientSideMessages().empty();
