+void Instance::callOne(
+		int id,
+		bool second,
+		JSValue payload,
+		const QString &where) {
+	const auto i = _registrations.find(id);
+	if (!_engine || i == end(_registrations)) {
+		if (_engine) {
+			JS_FreeValue(_engine->ctx(), payload);
+		}
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto fn = JS_DupValue(ctx, second ? i->second.visible : i->second.fn);
+	JSValueConst args[] = { payload };
+	JS_FreeValue(ctx, invoke(fn, args, kListenerBudget, where));
+	if (_engine) {
+		JS_FreeValue(ctx, fn);
+		JS_FreeValue(ctx, payload);
+		_engine->drain();
+	}
+}
+
+std::vector<Instance::ProfileRowSpec> Instance::profileRows() const {
+	auto result = std::vector<ProfileRowSpec>();
+	if (!_started) {
+		return result;
+	}
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::ProfileRow) {
+			result.push_back({
+				.id = id,
+				.label = registration.text,
+				.clickable = JS_IsFunction(
+					_engine->ctx(),
+					registration.visible),
+			});
+		}
+	}
+	return result;
+}
+
+void Instance::profileRowValue(
+		int id,
+		not_null<PeerData*> peer,
+		Fn<void(std::optional<QString>)> done) {
+	if (!_engine || !_registrations.contains(id)) {
+		done(std::nullopt);
+		return;
+	}
+	runGate(
+		Kind::ProfileRow,
+		"__teleRunProfileRow",
+		peerInfo(peer),
+		u"profile row"_q,
+		QString(),
+		std::move(done),
+		id);
+}
+
+void Instance::profileRowClick(int id, not_null<PeerData*> peer) {
+	if (!_engine) {
