+void AddProfileRows(
+		not_null<PeerData*> peer,
+		Fn<void(
+			QString label,
+			rpl::producer<TextWithEntities> value,
+			Fn<void()> click)> add) {
+	const auto host = Host::Find(&peer->session());
+	if (!host) {
+		return;
+	}
+	for (const auto &script : host->scriptsWithProfileRows()) {
+		const auto instance = host->instanceFor(script);
+		if (!instance) {
+			continue;
+		}
+		const auto weak = base::make_weak(instance);
+		for (const auto &row : instance->profileRows()) {
+			const auto id = row.id;
+			const auto clickable = row.clickable;
+			auto value = rpl::producer<TextWithEntities>([=](
+					auto consumer) {
+				if (const auto strong = weak.get()) {
+					strong->profileRowValue(id, peer, [=](
+							std::optional<QString> text) {
+						consumer.put_next(!text
+							? TextWithEntities()
+							: clickable
+							? Ui::Text::Link(*text, u"internal:script-row"_q)
+							: TextWithEntities{ *text });
+					});
+				}
+				return rpl::lifetime();
+			});
+			auto click = row.clickable
+				? Fn<void()>([=] {
+					if (const auto strong = weak.get()) {
+						strong->profileRowClick(id, peer);
+					}
+				})
+				: Fn<void()>();
+			add(row.label, std::move(value), std::move(click));
+		}
+	}
+}
