diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_buttons.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_buttons.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e9a964b31ab7ecebd4fe40ff012ac3e6c2412dbc
--- /dev/null
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_buttons.cpp
@@ -0,0 +1,316 @@
+#include "tele/scripting/tele_script_buttons.h"
+
+#include "data/data_peer.h"
+#include "main/main_session.h"
+#include "ui/effects/ripple_animation.h"
+#include "ui/painter.h"
+#include "ui/text/text.h"
+#include "ui/ui_utility.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/tooltip.h"
+#include "styles/style_chat_helpers.h"
+#include "styles/style_info.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtCore/QPointer>
+#include <QtGui/QCursor>
+
+namespace Tele::Scripting {
+namespace {
+
+class ScriptButton final
+	: public Ui::RippleButton
+	, public Ui::AbstractTooltipShower {
+public:
+	ScriptButton(
+		QWidget *parent,
+		const style::IconButton &st,
+		QString key);
+
+	void setContent(const QString &icon, const QString &tooltip);
+	[[nodiscard]] const QString &key() const;
+
+	QString tooltipText() const override;
+	QPoint tooltipPos() const override;
+	bool tooltipWindowActive() const override;
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+	void onStateChanged(State was, StateChangeSource source) override;
+	QImage prepareRippleMask() const override;
+	QPoint prepareRippleStartPosition() const override;
+
+	const style::IconButton &_st;
+	const QString _key;
+	Ui::Text::String _icon;
+	QString _iconSource;
+	QString _tooltip;
+
+};
+
+struct Registered {
+	not_null<Main::Session*> session;
+	ScriptButtonSpec spec;
+};
+
+struct Attached {
+	QPointer<QWidget> parent;
+	ButtonPlace place = ButtonPlace::Header;
+	Fn<void()> relayout;
+	std::vector<base::unique_qptr<ScriptButton>> buttons;
+};
+
+[[nodiscard]] std::vector<Registered> &Buttons() {
+	static auto result = std::vector<Registered>();
+	return result;
+}
+
+[[nodiscard]] std::vector<std::unique_ptr<Attached>> &Parents() {
+	static auto result = std::vector<std::unique_ptr<Attached>>();
+	return result;
+}
+
+[[nodiscard]] Attached *FindAttached(not_null<QWidget*> parent) {
+	auto &parents = Parents();
+	parents.erase(ranges::remove_if(parents, [](const auto &attached) {
+		return !attached->parent;
+	}), end(parents));
+	for (const auto &attached : parents) {
+		if (attached->parent.data() == parent.get()) {
+			return attached.get();
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] const style::IconButton &StyleFor(ButtonPlace place) {
+	return (place == ButtonPlace::Header)
+		? st::topBarSearch
+		: st::historyAttach;
+}
+
+[[nodiscard]] std::vector<const Registered*> ButtonsFor(
+		ButtonPlace place,
+		PeerData *peer) {
+	auto result = std::vector<const Registered*>();
+	if (!peer) {
+		return result;
+	}
+	for (const auto &registered : Buttons()) {
+		if (registered.spec.place == place
+			&& registered.session.get() == &peer->session()
+			&& ChatMatches(registered.spec.chats, not_null(peer))) {
+			result.push_back(&registered);
+		}
+	}
+	return result;
+}
+
+void RelayoutAll() {
+	auto callbacks = std::vector<Fn<void()>>();
+	for (const auto &attached : Parents()) {
+		if (attached->parent && attached->relayout) {
+			callbacks.push_back(attached->relayout);
+		}
+	}
+	for (const auto &callback : callbacks) {
+		callback();
+	}
+}
+
+ScriptButton::ScriptButton(
+	QWidget *parent,
+	const style::IconButton &st,
+	QString key)
+: RippleButton(parent, st.ripple)
+, _st(st)
+, _key(std::move(key)) {
+	resize(_st.width, _st.height);
+	setCursor(style::cur_pointer);
+}
+
+void ScriptButton::setContent(const QString &icon, const QString &tooltip) {
+	if (_iconSource != icon) {
+		_iconSource = icon;
+		_icon.setText(st::semiboldTextStyle, icon);
+		update();
+	}
+	_tooltip = tooltip;
+	setAccessibleName(tooltip.isEmpty() ? icon : tooltip);
+}
+
+const QString &ScriptButton::key() const {
+	return _key;
+}
+
+QString ScriptButton::tooltipText() const {
+	return _tooltip;
+}
+
+QPoint ScriptButton::tooltipPos() const {
+	return QCursor::pos();
+}
+
+bool ScriptButton::tooltipWindowActive() const {
+	return Ui::AppInFocus() && Ui::InFocusChain(window());
+}
+
+void ScriptButton::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	paintRipple(p, _st.rippleAreaPosition);
+	p.setPen(isOver() ? st::menuIconFgOver : st::menuIconFg);
+	const auto available = width() - 2 * st::normalFont->spacew;
+	const auto textWidth = std::min(_icon.maxWidth(), available);
+	_icon.drawElided(
+		p,
+		(width() - textWidth) / 2,
+		(height() - _icon.minHeight()) / 2,
+		textWidth);
+}
+
+void ScriptButton::onStateChanged(State was, StateChangeSource source) {
+	RippleButton::onStateChanged(was, source);
+	if (isOver() && !_tooltip.isEmpty()) {
+		Ui::Tooltip::Show(1000, this);
+	} else if (!isOver()) {
+		Ui::Tooltip::Hide();
+	}
+	update();
+}
+
+QImage ScriptButton::prepareRippleMask() const {
+	return Ui::RippleAnimation::EllipseMask(
+		QSize(_st.rippleAreaSize, _st.rippleAreaSize));
+}
+
+QPoint ScriptButton::prepareRippleStartPosition() const {
+	return mapFromGlobal(QCursor::pos()) - _st.rippleAreaPosition;
+}
+
+} // namespace
+
+bool ChatMatches(
+		const std::vector<std::string> &chats,
+		not_null<PeerData*> peer) {
+	const auto kind = peer->isUser()
+		? "private"
+		: peer->isBroadcast()
+		? "channels"
+		: "groups";
+	return chats.empty()
+		|| ranges::contains(chats, std::string("all"))
+		|| ranges::contains(chats, std::string(kind));
+}
+
+void RegisterScriptButton(
+		not_null<Main::Session*> session,
+		ScriptButtonSpec spec) {
+	auto &buttons = Buttons();
+	const auto i = ranges::find_if(buttons, [&](const Registered &r) {
+		return r.spec.owner == spec.owner && r.spec.id == spec.id;
+	});
+	if (i != end(buttons)) {
+		i->spec = std::move(spec);
+	} else {
+		buttons.push_back({ .session = session, .spec = std::move(spec) });
+	}
+	RelayoutAll();
+}
+
+void UnregisterScriptButton(const void *owner, const QString &id) {
+	auto &buttons = Buttons();
+	const auto was = buttons.size();
+	buttons.erase(ranges::remove_if(buttons, [&](const Registered &r) {
+		return r.spec.owner == owner && r.spec.id == id;
+	}), end(buttons));
+	if (buttons.size() != was) {
+		RelayoutAll();
+	}
+}
+
+void UnregisterScriptButtons(const void *owner) {
+	auto &buttons = Buttons();
+	const auto was = buttons.size();
+	buttons.erase(ranges::remove_if(buttons, [&](const Registered &r) {
+		return r.spec.owner == owner;
+	}), end(buttons));
+	if (buttons.size() != was) {
+		RelayoutAll();
+	}
+}
+
+void AttachButtons(
+		not_null<QWidget*> parent,
+		ButtonPlace place,
+		Fn<void()> relayout) {
+	if (const auto attached = FindAttached(parent)) {
+		attached->place = place;
+		attached->relayout = std::move(relayout);
+		return;
+	}
+	auto attached = std::make_unique<Attached>();
+	attached->parent = parent.get();
+	attached->place = place;
+	attached->relayout = std::move(relayout);
+	Parents().push_back(std::move(attached));
+}
+
+int ButtonsWidth(not_null<QWidget*> parent, PeerData *peer) {
+	const auto attached = FindAttached(parent);
+	if (!attached) {
+		return 0;
+	}
+	const auto count = int(ButtonsFor(attached->place, peer).size());
+	return count * StyleFor(attached->place).width;
+}
+
+int LayoutButtons(
+		not_null<QWidget*> parent,
+		PeerData *peer,
+		int right,
+		int top,
+		bool shown) {
+	const auto attached = FindAttached(parent);
+	if (!attached) {
+		return 0;
+	}
+	const auto list = shown
+		? ButtonsFor(attached->place, peer)
+		: std::vector<const Registered*>();
+	const auto &st = StyleFor(attached->place);
+	auto kept = std::vector<base::unique_qptr<ScriptButton>>();
+	auto taken = 0;
+	for (const auto registered : list) {
+		const auto &spec = registered->spec;
+		const auto key = QString::number(quintptr(spec.owner), 16)
+			+ ':'
+			+ spec.id;
+		auto &buttons = attached->buttons;
+		auto i = ranges::find_if(buttons, [&](const auto &button) {
+			return button && button->key() == key;
+		});
+		auto button = (i != end(buttons))
+			? std::move(*i)
+			: base::make_unique_q<ScriptButton>(parent.get(), st, key);
+		if (i != end(buttons)) {
+			buttons.erase(i);
+		}
+		button->setContent(spec.icon, spec.tooltip);
+		const auto click = spec.click;
+		const auto weak = QPointer<QWidget>(parent.get());
+		const auto peerPointer = not_null(peer);
+		button->setClickedCallback([=] {
+			if (weak && click) {
+				click(peerPointer);
+			}
+		});
+		button->moveToRight(right + taken, top);
+		button->show();
+		taken += button->width();
+		kept.push_back(std::move(button));
+	}
+	attached->buttons = std::move(kept);
+	return taken;
+}
+
+} // namespace Tele::Scripting
