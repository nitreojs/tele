+#include "ui/layers/show.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/vertical_layout.h"
+#include "window/window_session_controller.h"
+#include "styles/style_layers.h"
+#include "styles/style_settings.h"
+
+namespace Tele::Scripting {
+namespace {
+
+struct PendingPage {
+	QString title;
+	ScriptPageView view;
+};
+
+struct EntriesGroup {
+	const void *owner = nullptr;
+	std::vector<ScriptSettingsEntry> entries;
+};
+
+[[nodiscard]] std::optional<PendingPage> &Pending() {
+	static auto result = std::optional<PendingPage>();
+	return result;
+}
+
+[[nodiscard]] std::vector<EntriesGroup> &Groups() {
+	static auto result = std::vector<EntriesGroup>();
+	return result;
+}
+
+[[nodiscard]] rpl::event_stream<> &GroupsChanges() {
+	static auto result = rpl::event_stream<>();
+	return result;
+}
+
+[[nodiscard]] QString EntryLabel(const ScriptSettingsEntry &entry) {
+	return entry.emoji.isEmpty()
+		? entry.title
+		: (entry.emoji + ' ' + entry.title);
+}
+
+void FillEntries(
+		not_null<Ui::VerticalLayout*> container,
+		not_null<Window::SessionController*> controller) {
+	container->clear();
+	auto any = false;
+	for (const auto &group : Groups()) {
+		for (const auto &entry : group.entries) {
+			if (!std::exchange(any, true)) {
+				Ui::AddSkip(container);
+				Ui::AddDivider(container);
+				Ui::AddSkip(container);
+			}
+			const auto open = entry.open;
+			::Settings::AddButtonWithIcon(
+				container,
+				rpl::single(EntryLabel(entry)),
+				st::settingsButtonNoIcon
+			)->setClickedCallback([=] {
+				if (const auto callback = open) {
+					callback(controller);
+				}
+			});
+		}
+	}
+	container->resizeToWidth(container->width());
+}
+
+class ScriptSection final
+	: public ::Settings::Section<ScriptSection> {
+public:
+	ScriptSection(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller);
+
+	[[nodiscard]] rpl::producer<QString> title() override;
+	[[nodiscard]] rpl::producer<> sectionShowBack() override;
+
+private:
+	void close();
+
+	const not_null<Ui::VerticalLayout*> _content;
+	QString _title;
+	rpl::event_stream<> _showBack;
+	bool _closing = false;
+
+};
+
+ScriptSection::ScriptSection(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: ::Settings::Section<ScriptSection>(parent, controller)
+, _content(Ui::CreateChild<Ui::VerticalLayout>(this)) {
+	Ui::ResizeFitChild(this, _content);
+	auto pending = base::take(Pending());
+	if (!pending) {
+		_title = Lower(u"Script"_q);
+		_content->add(
+			object_ptr<Ui::FlatLabel>(
+				_content,
+				Lower(u"This page is no longer available."_q),
+				st::boxDividerLabel),
+			st::boxRowPadding + QMargins(
+				0,
+				st::boxRowPadding.left(),
+				0,
+				st::boxRowPadding.left()),
+			style::al_top);
+		return;
+	}
+	_title = !pending->title.isEmpty()
+		? pending->title
+		: !pending->view.title.isEmpty()
+		? pending->view.title
+		: pending->view.script;
+	Ui::AddSkip(_content);
+	FillScriptPage(
+		_content,
+		controller->uiShow(),
+		std::move(pending->view),
+		crl::guard(this, [=] { close(); }));
+	Ui::AddSkip(_content);
+}
+
+rpl::producer<QString> ScriptSection::title() {
+	return rpl::single(_title);
+}
+
+rpl::producer<> ScriptSection::sectionShowBack() {
+	return _showBack.events();
+}
+
+void ScriptSection::close() {
+	if (_closing) {
+		return;
+	}
+	_closing = true;
+	crl::on_main(this, [=] {
+		_showBack.fire({});
+	});
+}
+
+} // namespace
+
+void ShowScriptSection(
+		not_null<Window::SessionController*> controller,
+		QString title,
+		ScriptPageView view) {
+	Pending() = PendingPage{
+		.title = std::move(title),
+		.view = std::move(view),
+	};
+	controller->showSettings(ScriptSection::Id());
+	Pending() = std::nullopt;
+}
+
+void SetScriptSettingsEntries(
+		const void *owner,
+		std::vector<ScriptSettingsEntry> entries) {
+	auto &groups = Groups();
+	const auto i = ranges::find(groups, owner, &EntriesGroup::owner);
+	if (entries.empty()) {
+		if (i == end(groups)) {
+			return;
+		}
+		groups.erase(i);
+	} else if (i != end(groups)) {
+		i->entries = std::move(entries);
+	} else {
+		groups.push_back({
+			.owner = owner,
+			.entries = std::move(entries),
+		});
+	}
+	GroupsChanges().fire({});
+}
+
+} // namespace Tele::Scripting
+
+namespace Settings {
+
+void AddScriptSettingsButtons(Builder::SectionBuilder &builder) {
+	builder.add([](const Builder::WidgetContext &ctx) {
+		auto result = object_ptr<Ui::VerticalLayout>(ctx.container);
+		const auto container = result.data();
+		const auto controller = ctx.controller;
+		rpl::single(
+			rpl::empty
+		) | rpl::then(
+			Tele::Scripting::GroupsChanges().events()
+		) | rpl::on_next([=] {
+			Tele::Scripting::FillEntries(container, controller);
+		}, container->lifetime());
+		return Builder::SectionBuilder::WidgetToAdd{
+			.widget = std::move(result),
+		};
+	}, nullptr);
+}
+
+} // namespace Settings
