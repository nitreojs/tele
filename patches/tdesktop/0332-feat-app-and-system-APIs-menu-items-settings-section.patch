+[[nodiscard]] QString CallStateName(Calls::Call::State state) {
+	using State = Calls::Call::State;
+	switch (state) {
+	case State::Starting: return u"starting"_q;
+	case State::WaitingInit: return u"waitingInit"_q;
+	case State::WaitingInitAck: return u"waitingInitAck"_q;
+	case State::Established: return u"established"_q;
+	case State::FailedHangingUp: return u"failedHangingUp"_q;
+	case State::Failed: return u"failed"_q;
+	case State::HangingUp: return u"hangingUp"_q;
+	case State::MigrationHangingUp: return u"migrationHangingUp"_q;
+	case State::Ended: return u"ended"_q;
+	case State::EndedByOtherDevice: return u"endedByOtherDevice"_q;
+	case State::ExchangingKeys: return u"exchangingKeys"_q;
+	case State::Waiting: return u"waiting"_q;
+	case State::Requesting: return u"requesting"_q;
+	case State::WaitingIncoming: return u"waitingIncoming"_q;
+	case State::Ringing: return u"ringing"_q;
+	case State::Busy: return u"busy"_q;
+	case State::WaitingUserConfirmation: return u"waitingUserConfirmation"_q;
+	}
+	return u"unknown"_q;
+}
+
+[[nodiscard]] bool Playing(const Media::Player::TrackState &state) {
+	return !Media::Player::IsPausedOrPausing(state.state)
+		&& !Media::Player::IsStoppedOrStopping(state.state);
+}
