+		}
+		JS_FreePropertyEnum(ctx, properties, count);
+		if (!bad.isEmpty()) {
+			const auto text = bad.toStdString();
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.app.theme.setColors: %s isn't '#rrggbb' or '#rrggbbaa'",
+				text.c_str());
+		}
+		const auto id = NextRegistrationId();
+		auto owner = std::make_unique<char>();
+		const auto unknown = SetScriptColors(owner.get(), colors);
+		if (!unknown.isEmpty()) {
+			RemoveScriptColors(owner.get());
+			const auto text = unknown.toStdString();
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.app.theme.setColors: %s isn't a palette color",
+				text.c_str());
+		}
+		instance->_colorOwners.emplace(id, std::move(owner));
+		instance->_registrations.emplace(id, Registration{
+			.kind = Kind::Colors,
+		});
+		return instance->disposer(id);
+	}
+	case 4: {
+		auto result = enroll(Kind::Theme);
+		instance->watchTheme();
+		return result;
+	}
+	case 5:
+		SetScriptWindowTitle(instance, string(0));
+		return JS_UNDEFINED;
+	case 6: {
+		auto value = int32_t();
+		const auto set = (argc > 0)
+			&& JS_IsNumber(argv[0])
+			&& JS_ToInt32(ctx, &value, argv[0]) >= 0;
+		SetScriptBadge(
+			instance,
+			set ? std::make_optional(int(std::max(value, 0))) : std::nullopt);
+		return JS_UNDEFINED;
+	}
