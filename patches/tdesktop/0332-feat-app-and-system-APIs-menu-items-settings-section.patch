+std::vector<QRect> Message::scriptQuickRects(QRect g, int count) const {
+	auto result = std::vector<QRect>();
+	result.reserve(count);
+	const auto size = st::historyFastShareSize;
+	const auto skip = st::historyFastShareBottom;
+	const auto rightSize = rightActionSize();
+	const auto columnWidth = rightSize
+		? std::max(size, rightSize->width())
+		: size;
+	const auto bubbleBottom = g.top() + g.height();
+	const auto rightTop = rightSize
+		? (bubbleBottom
+			- std::clamp((g.height() - rightSize->height()) / 2, 0, skip)
+			- rightSize->height())
+		: bubbleBottom;
+	const auto usualBottom = bubbleBottom
+		- std::clamp((g.height() - size) / 2, 0, skip);
+	const auto toRight = !hasRightLayout();
+	for (auto column = _summarize ? 1 : 0
+		; int(result.size()) < count
+		; ++column) {
+		const auto aboveRight = !column && rightSize.has_value();
+		const auto bottom = aboveRight ? (rightTop - skip) : usualBottom;
+		const auto fits = (bottom - g.top() + skip) / (size + skip);
+		const auto rows = std::min(
+			count - int(result.size()),
+			std::max(fits, aboveRight ? 0 : 1));
+		const auto distance = st::historyFastShareLeft + (column
+			? (columnWidth + skip + (column - 1) * (size + skip))
+			: ((columnWidth - size) / 2));
+		const auto x = toRight
+			? (g.left() + g.width() + distance)
+			: (g.left() - distance - size);
+		for (auto row = 0; row != rows; ++row) {
+			const auto below = rows - row;
+			result.push_back(QRect(
+				x,
+				bottom - below * size - (below - 1) * skip,
+				size,
+				size));
+		}
+	}
+	return result;
+}
+
+ClickHandlerPtr Message::scriptQuickLink(QPoint point, QRect g) const {
+	const auto actions = VisibleScriptQuickActions(this);
+	if (actions.empty()) {
+		return nullptr;
+	}
+	const auto count = int(actions.size());
+	const auto rects = scriptQuickRects(g, count);
+	for (auto i = 0; i != count; ++i) {
+		if (!rects[i].contains(point)) {
+			continue;
+		}
+		ensureScriptQuick();
+		auto &links = _scriptQuick->links;
+		if (int(links.size()) <= i) {
+			links.resize(i + 1);
+		}
+		auto &link = links[i];
+		if (!link || link->key() != actions[i].key) {
+			link = std::make_shared<ScriptQuickLink>(
+				base::make_weak(&history()->session()),
+				data()->fullId(),
+				actions[i].key,
+				i);
+		}
+		link->setTooltip(actions[i].tooltip);
+		return link;
+	}
+	return nullptr;
+}
+
+void Message::paintScriptQuick(
+		Painter &p,
+		const PaintContext &context,
+		QRect g) const {
+	if (!isUnderCursor()) {
+		return;
+	}
+	ensureScriptQuick();
+	const auto actions = VisibleScriptQuickActions(this);
+	if (actions.empty()) {
+		return;
+	}
+	const auto count = int(actions.size());
+	const auto rects = scriptQuickRects(g, count);
+	const auto &links = _scriptQuick->links;
+	const auto st = context.st;
+	for (auto i = 0; i != count; ++i) {
+		const auto &action = actions[i];
+		const auto &rect = rects[i];
+		const auto active = (i < int(links.size()))
+			&& links[i]
+			&& (links[i]->key() == action.key)
+			&& ClickHandler::showAsActive(links[i]);
+		p.setPen(Qt::NoPen);
+		p.setBrush(active ? st->msgServiceBgSelected() : st->msgServiceBg());
+		{
+			PainterHighQualityEnabler hq(p);
+			p.drawEllipse(rect);
+		}
+		if (action.emoji.isEmpty()) {
+			continue;
+		}
+		if (const auto emoji = Ui::Emoji::Find(action.emoji)) {
+			const auto &pixmap = Ui::Emoji::SinglePixmap(
+				emoji,
+				Ui::Emoji::GetSizeNormal());
+			const auto size = pixmap.size() / pixmap.devicePixelRatio();
+			p.drawPixmap(
+				rect.x() + (rect.width() - size.width()) / 2,
+				rect.y() + (rect.height() - size.height()) / 2,
+				pixmap);
+		} else {
+			p.setFont(st::semiboldFont);
+			p.setPen(st->msgServiceFg());
+			p.drawText(rect, Qt::AlignCenter, action.emoji);
+		}
+	}
+}
+
 } // namespace HistoryView
