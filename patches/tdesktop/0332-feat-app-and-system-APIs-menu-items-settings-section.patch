+JSValue Instance::playerValue(JSContext *ctx) {
+	const auto player = Media::Player::instance();
+	const auto type = player->getActiveType();
+	const auto id = player->current(type);
+	const auto document = id.audio();
+	if (!document) {
+		return JS_NULL;
+	}
+	const auto state = player->getState(type);
+	const auto song = document->song();
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"type",
+		NewString(ctx, (type == AudioMsgId::Type::Voice)
+			? u"voice"_q
+			: (type == AudioMsgId::Type::Video)
+			? u"video"_q
+			: u"song"_q));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"title",
+		NewString(ctx, (song && !song->title.isEmpty())
+			? song->title
+			: document->filename()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"performer",
+		NewString(ctx, song ? song->performer : QString()));
+	const auto frequency = std::max(state.frequency, 1);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"duration",
+		JS_NewInt64(ctx, state.length * 1000 / frequency));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"position",
+		JS_NewInt64(ctx, state.position * 1000 / frequency));
+	JS_SetPropertyStr(ctx, result, "playing", JS_NewBool(ctx, Playing(state)));
+	const auto context = id.contextId();
+	if (context.peer) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"chatId",
+			JS_NewBigInt64(ctx, MarkedId(context.peer)));
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"messageId",
+			JS_NewInt64(ctx, context.msg.bare));
+	}
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"documentId",
+		JS_NewBigInt64(ctx, int64(document->id)));
+	return result;
+}
+
+JSValue Instance::callValue(JSContext *ctx) {
+	const auto call = Core::App().calls().currentCall();
+	if (!call || &call->user()->session() != _session.get()) {
+		return JS_NULL;
+	}
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "user", peerInfo(call->user()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"incoming",
+		JS_NewBool(ctx, call->type() == Calls::Call::Type::Incoming));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"state",
+		NewString(ctx, CallStateName(call->state())));
+	JS_SetPropertyStr(ctx, result, "muted", JS_NewBool(ctx, call->muted()));
+	return result;
+}
