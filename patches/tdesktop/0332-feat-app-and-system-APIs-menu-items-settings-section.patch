@@ -0,0 +1,67 @@
+#include "tele/scripting/tele_script_quick.h"
+
+namespace Tele::Scripting {
+namespace {
+
+struct Entry {
+	const void *owner = nullptr;
+	std::vector<QuickAction> actions;
+};
+
+[[nodiscard]] std::vector<Entry> &Entries() {
+	static auto result = std::vector<Entry>();
+	return result;
+}
+
+[[nodiscard]] rpl::event_stream<> &Changes() {
+	static auto result = rpl::event_stream<>();
+	return result;
+}
+
+} // namespace
+
+void SetScriptQuickActions(
+		const void *owner,
+		std::vector<QuickAction> actions) {
+	auto &entries = Entries();
+	const auto i = ranges::find(entries, owner, &Entry::owner);
+	if (actions.empty()) {
+		if (i == end(entries)) {
+			return;
+		}
+		entries.erase(i);
+	} else if (i != end(entries)) {
+		i->actions = std::move(actions);
+	} else {
+		entries.push_back({ .owner = owner, .actions = std::move(actions) });
+	}
+	Changes().fire({});
+}
+
+std::vector<QuickAction> ScriptQuickActions(not_null<HistoryItem*> item) {
+	const auto &entries = Entries();
+	if (entries.empty()) {
+		return {};
+	}
+	auto candidates = std::vector<QuickAction>();
+	for (const auto &entry : entries) {
+		candidates.insert(
+			end(candidates),
+			begin(entry.actions),
+			end(entry.actions));
+	}
+	auto result = std::vector<QuickAction>();
+	result.reserve(candidates.size());
+	for (auto &action : candidates) {
+		if (!action.visible || action.visible(item)) {
+			result.push_back(std::move(action));
+		}
+	}
+	return result;
+}
+
+rpl::producer<> ScriptQuickActionsChanges() {
+	return Changes().events();
+}
+
+} // namespace Tele::Scripting
