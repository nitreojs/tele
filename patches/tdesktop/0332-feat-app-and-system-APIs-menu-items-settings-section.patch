+
+void Host::interceptDrop(
+		DropData data,
+		std::shared_ptr<QMimeData> copy,
+		Fn<void(not_null<const QMimeData*>)> replay) {
+	auto scripts = std::make_shared<std::vector<QString>>();
+	for (const auto &entry : _entries) {
+		if (entry.instance && entry.instance->interceptsDrops()) {
+			scripts->push_back(entry.file.id);
+		}
+	}
+	const auto weak = base::make_weak(this);
+	const auto step = std::make_shared<Fn<void(int)>>();
+	*step = [=](int index) {
+		if (index >= int(scripts->size())) {
+			++ReplayingDrops;
+			replay(copy.get());
+			--ReplayingDrops;
+			return;
+		}
+		const auto instance = instanceOf((*scripts)[index]);
+		if (!instance || !instance->interceptsDrops()) {
+			(*step)(index + 1);
+			return;
+		}
+		instance->interceptDrop(data, [=](bool accept) {
+			crl::on_main(weak, [=] {
+				if (accept) {
+					(*step)(index + 1);
+				}
+			});
+		});
+	};
+	(*step)(0);
+}
