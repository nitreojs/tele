+		if (const auto window = Core::App().activePrimaryWindow()) {
+			QApplication::alert(window->widget(), 0);
+		}
+		return JS_UNDEFINED;
+	case 8:
+		return instance->playerValue(ctx);
+	case 9: {
+		const auto action = string(0).value_or(QString());
+		const auto player = Media::Player::instance();
+		const auto type = player->getActiveType();
+		if (action == u"play"_q) {
+			player->play(type);
+		} else if (action == u"pause"_q) {
+			player->pause(type);
+		} else if (action == u"toggle"_q) {
+			player->playPause(type);
