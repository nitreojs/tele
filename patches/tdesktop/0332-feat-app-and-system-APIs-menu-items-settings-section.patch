@@ -0,0 +1,137 @@
+#include "tele/scripting/tele_script_menus.h"
+#include "tele/scripting/tele_script_menus_ui.h"
+
+#include "core/application.h"
+#include "platform/platform_tray.h"
+#include "settings/settings_common.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/shadow.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_window.h"
+#include "styles/style_window_main_menu.h"
+
+namespace Tele::Scripting {
+namespace {
+
+struct OwnerItems {
+	const void *owner = nullptr;
+	std::vector<AppMenuItem> items;
+};
+
+struct Registry {
+	std::vector<OwnerItems> owners;
+	rpl::event_stream<> changes;
+};
+
+[[nodiscard]] Registry &MainMenuRegistry() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] Registry &TrayRegistry() {
+	static auto result = Registry();
+	return result;
+}
+
+void SetItems(
+		Registry &registry,
+		const void *owner,
+		std::vector<AppMenuItem> items) {
+	auto &owners = registry.owners;
+	const auto i = ranges::find(owners, owner, &OwnerItems::owner);
+	if (items.empty()) {
+		if (i == end(owners)) {
+			return;
+		}
+		owners.erase(i);
+	} else if (i != end(owners)) {
+		i->items = std::move(items);
+	} else {
+		owners.push_back({ .owner = owner, .items = std::move(items) });
+	}
+	registry.changes.fire({});
+}
+
+[[nodiscard]] std::vector<AppMenuItem> CollectItems(
+		const Registry &registry) {
+	auto result = std::vector<AppMenuItem>();
+	for (const auto &entry : registry.owners) {
+		result.insert(end(result), begin(entry.items), end(entry.items));
+	}
+	return result;
+}
+
+[[nodiscard]] QString ItemText(const AppMenuItem &item) {
+	return item.emoji.isEmpty()
+		? item.text
+		: (item.emoji + QChar(' ') + item.text);
+}
+
+} // namespace
+
+void SetScriptMainMenuItems(
+		const void *owner,
+		std::vector<AppMenuItem> items) {
+	SetItems(MainMenuRegistry(), owner, std::move(items));
+}
+
+void SetScriptTrayMenuItems(
+		const void *owner,
+		std::vector<AppMenuItem> items) {
+	SetItems(TrayRegistry(), owner, std::move(items));
+}
+
+void AddScriptMainMenuItems(
+		not_null<Ui::VerticalLayout*> menu,
+		Fn<void()> close) {
+	const auto wrap = menu->add(object_ptr<Ui::VerticalLayout>(menu));
+	const auto fill = [=] {
+		wrap->clear();
+		const auto items = CollectItems(MainMenuRegistry());
+		if (items.empty()) {
+			return;
+		}
+		wrap->add(
+			object_ptr<Ui::PlainShadow>(wrap),
+			{ 0, st::mainMenuSkip, 0, st::mainMenuSkip });
+		for (const auto &item : items) {
+			const auto callback = item.callback;
+			Settings::AddButtonWithIcon(
+				wrap,
+				rpl::single(ItemText(item)),
+				st::mainMenuButton
+			)->setClickedCallback([=] {
+				const auto hide = close;
+				const auto copy = callback;
+				hide();
+				if (copy) {
+					crl::on_main([=] { copy(); });
+				}
+			});
+		}
+		wrap->resizeToWidth(menu->width());
+	};
+	fill();
+	MainMenuRegistry().changes.events(
+	) | rpl::on_next(fill, wrap->lifetime());
+}
+
+rpl::producer<> ScriptTrayMenuChanges() {
+	return TrayRegistry().changes.events();
+}
+
+void FillScriptTrayMenu(Platform::Tray &tray) {
+	if (Core::App().passcodeLocked()) {
+		return;
+	}
+	for (const auto &item : CollectItems(TrayRegistry())) {
+		const auto callback = item.callback;
+		tray.addAction(rpl::single(ItemText(item)), [=] {
+			if (callback) {
+				callback();
+			}
+		});
+	}
+}
+
+} // namespace Tele::Scripting
