+void Instance::syncSurfaces() {
+	const auto weak = base::make_weak(this);
+	auto main = std::vector<AppMenuItem>();
+	auto tray = std::vector<AppMenuItem>();
+	auto entries = std::vector<ScriptSettingsEntry>();
+	auto quick = std::vector<QuickAction>();
+	const auto session = _session;
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::MenuItem) {
+			auto item = AppMenuItem{
+				.key = QString::number(id),
+				.text = registration.text,
+				.emoji = registration.extra,
+				.callback = [=] {
+					if (const auto strong = weak.get()) {
+						strong->clickRegistration(id, nullptr, u"menu item"_q);
+					}
+				},
+			};
+			((registration.key == u"tray"_q) ? tray : main).push_back(
+				std::move(item));
+		} else if (registration.kind == Kind::SettingsEntry) {
+			const auto page = registration.menu;
+			entries.push_back({
+				.key = QString::number(id),
+				.title = registration.text,
+				.emoji = registration.extra,
+				.open = [=](not_null<Window::SessionController*> window) {
+					const auto strong = weak.get();
+					auto view = strong
+						? strong->pageView(page)
+						: std::optional<ScriptPageView>();
+					if (view) {
+						const auto title = view->title;
+						ShowScriptSection(window, title, std::move(*view));
+						strong->clickRegistration(
+							id,
+							nullptr,
+							u"settings entry"_q);
+					}
+				},
+			});
+		} else if (registration.kind == Kind::QuickAction) {
+			const auto chats = registration.key;
+			quick.push_back({
+				.key = QString::number(id),
+				.emoji = registration.extra,
+				.tooltip = registration.text,
+				.visible = [=](not_null<HistoryItem*> item) {
+					const auto peer = item->history()->peer;
+					if (&peer->session() != session.get()) {
+						return false;
+					}
+					return chats.isEmpty()
+						|| (chats == u"all"_q)
+						|| (chats == u"private"_q && peer->isUser())
+						|| (chats == u"groups"_q
+							&& (peer->isChat() || peer->isMegagroup()))
+						|| (chats == u"channels"_q && peer->isBroadcast());
+				},
+				.callback = [=](FullMsgId message) {
+					if (const auto strong = weak.get()) {
+						strong->clickRegistration(id, [=](JSContext *ctx) {
+							auto result = JS_NewObject(ctx);
+							JS_SetPropertyStr(
+								ctx,
+								result,
+								"chatId",
+								JS_NewBigInt64(ctx, MarkedId(message.peer)));
+							JS_SetPropertyStr(
+								ctx,
+								result,
+								"messageId",
+								JS_NewInt64(ctx, message.msg.bare));
+							return result;
+						}, u"quick action"_q);
+					}
+				},
+			});
+		}
+	}
+	SetScriptMainMenuItems(this, std::move(main));
+	SetScriptTrayMenuItems(this, std::move(tray));
+	SetScriptSettingsEntries(this, std::move(entries));
+	SetScriptQuickActions(this, std::move(quick));
+}
