+class ScriptQuickLink final : public ClickHandler {
+public:
+	ScriptQuickLink(
+		base::weak_ptr<Main::Session> session,
+		FullMsgId itemId,
+		QString key,
+		int index)
+	: _session(std::move(session))
+	, _itemId(itemId)
+	, _key(std::move(key))
+	, _index(index) {
+	}
+
+	[[nodiscard]] const QString &key() const {
+		return _key;
+	}
+	void setTooltip(QString tooltip) {
+		_tooltip = std::move(tooltip);
+	}
+	QString tooltip() const override {
+		return _tooltip;
+	}
+	void onClick(ClickContext context) const override {
+		if (context.button != Qt::LeftButton) {
+			return;
+		}
+		const auto session = _session.get();
+		const auto item = session
+			? session->data().message(_itemId)
+			: nullptr;
+		if (!item) {
+			return;
+		}
+		const auto actions = Tele::Scripting::ScriptQuickActions(item);
+		const auto exact = (_index < int(actions.size()))
+			&& (actions[_index].key == _key);
+		const auto i = exact
+			? (begin(actions) + _index)
+			: ranges::find(
+				actions,
+				_key,
+				&Tele::Scripting::QuickAction::key);
+		if (i != end(actions) && i->callback) {
+			i->callback(_itemId);
+		}
+	}
+
+private:
+	const base::weak_ptr<Main::Session> _session;
+	const FullMsgId _itemId;
+	const QString _key;
+	const int _index = 0;
+	QString _tooltip;
+
+};
+
+[[nodiscard]] auto VisibleScriptQuickActions(not_null<const Element*> view)
+-> std::vector<Tele::Scripting::QuickAction> {
+	const auto item = view->data();
+	if (!view->isUnderCursor()
+		|| !view->drawBubble()
+		|| item->isSponsored()
+		|| (view->context() == Context::MediaEditor)
+		|| (view->delegate()->elementInSelectionMode(view).progress > 0)) {
+		return {};
+	}
+	return Tele::Scripting::ScriptQuickActions(item);
+}
+
 } // namespace
 
