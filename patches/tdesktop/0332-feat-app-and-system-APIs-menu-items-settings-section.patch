+bool InterceptDrop(
+		not_null<PeerData*> peer,
+		not_null<const QMimeData*> data,
+		Fn<void(not_null<const QMimeData*>)> replay) {
+	if (ReplayingDrops > 0 || Secret::IsSecretPeer(peer)) {
+		return false;
+	}
+	const auto host = Host::Find(&peer->session());
+	if (!host || !host->interceptsDrops()) {
+		return false;
+	}
+	auto copy = std::make_shared<QMimeData>();
+	for (const auto &format : data->formats()) {
+		copy->setData(format, data->data(format));
+	}
+	if (data->hasUrls()) {
+		copy->setUrls(data->urls());
+	}
+	if (data->hasImage()) {
+		copy->setImageData(data->imageData());
+	}
+	if (data->hasText()) {
+		copy->setText(data->text());
+	}
+	auto info = DropData{
+		.peer = peer->id,
+		.text = data->hasText() ? data->text() : QString(),
+		.image = data->hasImage(),
+	};
+	for (const auto &url : data->urls()) {
+		if (url.isLocalFile()) {
+			const auto path = url.toLocalFile();
+			info.files.push_back({
+				.name = QFileInfo(path).fileName(),
+				.path = path,
+				.size = QFileInfo(path).size(),
+			});
+		} else {
+			info.urls.push_back(url.toString());
+		}
+	}
+	host->interceptDrop(std::move(info), std::move(copy), std::move(replay));
+	return true;
+}
