@@ -0,0 +1,252 @@
+#include "tele/scripting/tele_script_app.h"
+
+#include "ui/style/style_core.h"
+#include "ui/style/style_core_palette.h"
+#include "styles/palette.h"
+
+namespace Tele::Scripting {
+namespace {
+
+template <typename Value>
+struct Overrides {
+	std::vector<std::pair<const void*, Value>> list;
+	rpl::event_stream<> changes;
+
+	[[nodiscard]] std::optional<Value> current() const {
+		return list.empty()
+			? std::nullopt
+			: std::make_optional(list.back().second);
+	}
+	void set(const void *owner, std::optional<Value> value) {
+		const auto was = current();
+		const auto i = ranges::find(list, owner, [](const auto &pair) {
+			return pair.first;
+		});
+		if (i != end(list)) {
+			list.erase(i);
+		}
+		if (value) {
+			list.emplace_back(owner, std::move(*value));
+		}
+		if (current() != was) {
+			changes.fire({});
+		}
+	}
+};
+
+[[nodiscard]] Overrides<QString> &Titles() {
+	static auto result = Overrides<QString>();
+	return result;
+}
+
+[[nodiscard]] Overrides<int> &Badges() {
+	static auto result = Overrides<int>();
+	return result;
+}
+
+struct Colors {
+	std::vector<std::pair<const void*, base::flat_map<int, QColor>>> owners;
+	base::flat_map<int, QColor> originals;
+	base::flat_map<int, QColor> applied;
+	base::flat_map<int, QByteArray> names;
+	rpl::lifetime lifetime;
+	bool applying = false;
+	bool watching = false;
+};
+
+[[nodiscard]] Colors &ColorState() {
+	static auto result = Colors();
+	return result;
+}
+
+[[nodiscard]] QColor Current(int index) {
+	return style::main_palette::get()->colorAtIndex(index)->c;
+}
+
+void SetIndex(const QByteArray &name, const QColor &color) {
+	style::main_palette::setColor(
+		QLatin1String(name),
+		uchar(color.red()),
+		uchar(color.green()),
+		uchar(color.blue()),
+		uchar(color.alpha()));
+}
+
+void Apply();
+
+void Watch() {
+	auto &state = ColorState();
+	if (state.watching) {
+		return;
+	}
+	state.watching = true;
+	style::PaletteChanged(
+	) | rpl::on_next([] {
+		auto &state = ColorState();
+		if (state.applying) {
+			return;
+		}
+		auto changed = false;
+		for (const auto &[index, color] : state.applied) {
+			if (Current(index) != color) {
+				state.originals[index] = Current(index);
+				changed = true;
+			}
+		}
+		if (changed) {
+			crl::on_main([] { Apply(); });
+		}
+	}, state.lifetime);
+}
+
+void Apply() {
+	auto &state = ColorState();
+	auto wanted = base::flat_map<int, QColor>();
+	for (const auto &[owner, colors] : state.owners) {
+		for (const auto &[index, color] : colors) {
+			wanted[index] = color;
+		}
+	}
+	state.applying = true;
+	for (auto i = begin(state.applied); i != end(state.applied);) {
+		if (!wanted.contains(i->first)) {
+			const auto original = state.originals.find(i->first);
+			if (original != end(state.originals)) {
+				SetIndex(state.names[i->first], original->second);
+				state.originals.erase(original);
+			}
+			i = state.applied.erase(i);
+		} else {
+			++i;
+		}
+	}
+	for (const auto &[index, color] : wanted) {
+		if (!state.originals.contains(index)) {
+			state.originals.emplace(index, Current(index));
+		}
+		SetIndex(state.names[index], color);
+		state.applied[index] = color;
+	}
+	style::NotifyPaletteChanged();
+	state.applying = false;
+}
+
+} // namespace
+
+std::optional<QString> ScriptWindowTitle() {
+	return Titles().current();
+}
+
+rpl::producer<> ScriptWindowTitleChanges() {
+	return Titles().changes.events();
+}
+
+void SetScriptWindowTitle(const void *owner, std::optional<QString> title) {
+	Titles().set(owner, std::move(title));
+}
+
+std::optional<int> ScriptBadge() {
+	return Badges().current();
+}
+
+rpl::producer<> ScriptBadgeChanges() {
+	return Badges().changes.events();
+}
+
+void SetScriptBadge(const void *owner, std::optional<int> badge) {
+	Badges().set(owner, badge);
+}
+
+QString ScriptColorText(const QColor &color) {
+	return u"#%1%2%3%4"_q
+		.arg(color.red(), 2, 16, QChar('0'))
+		.arg(color.green(), 2, 16, QChar('0'))
+		.arg(color.blue(), 2, 16, QChar('0'))
+		.arg(color.alpha(), 2, 16, QChar('0'));
+}
+
+std::optional<QColor> ParseScriptColor(const QString &text) {
+	auto hex = text.trimmed();
+	if (!hex.startsWith('#')) {
+		return std::nullopt;
+	}
+	hex = hex.mid(1);
+	if (hex.size() == 3 || hex.size() == 4) {
+		auto doubled = QString();
+		for (const auto ch : hex) {
+			doubled += ch;
+			doubled += ch;
+		}
+		hex = doubled;
+	}
+	if (hex.size() != 6 && hex.size() != 8) {
+		return std::nullopt;
+	}
+	auto ok = false;
+	const auto value = hex.toUInt(&ok, 16);
+	if (!ok) {
+		return std::nullopt;
+	}
+	return (hex.size() == 6)
+		? QColor((value >> 16) & 0xFF, (value >> 8) & 0xFF, value & 0xFF)
+		: QColor(
+			(value >> 24) & 0xFF,
+			(value >> 16) & 0xFF,
+			(value >> 8) & 0xFF,
+			value & 0xFF);
+}
+
+std::optional<QColor> PaletteColor(const QString &name) {
+	const auto latin = name.toLatin1();
+	const auto index = style::internal::GetPaletteIndex(QLatin1String(latin));
+	return (index >= 0) ? std::make_optional(Current(index)) : std::nullopt;
+}
+
+QString SetScriptColors(
+		const void *owner,
+		const std::vector<std::pair<QString, QColor>> &colors) {
+	auto indices = base::flat_map<int, QColor>();
+	for (const auto &[name, color] : colors) {
+		const auto latin = name.toLatin1();
+		const auto index = style::internal::GetPaletteIndex(
+			QLatin1String(latin));
+		if (index < 0) {
+			return name;
+		}
+		indices[index] = color;
+		ColorState().names[index] = latin;
+	}
+	auto &state = ColorState();
+	const auto i = ranges::find(state.owners, owner, [](const auto &pair) {
+		return pair.first;
+	});
+	if (i != end(state.owners)) {
+		for (const auto &[index, color] : indices) {
+			i->second[index] = color;
+		}
+	} else {
+		state.owners.emplace_back(owner, std::move(indices));
+	}
+	Watch();
+	Apply();
+	return QString();
+}
+
+void RemoveScriptColors(const void *owner) {
+	auto &state = ColorState();
+	const auto i = ranges::find(state.owners, owner, [](const auto &pair) {
+		return pair.first;
+	});
+	if (i != end(state.owners)) {
+		state.owners.erase(i);
+		Apply();
+	}
+}
+
+void RemoveScriptAppOverrides(const void *owner) {
+	SetScriptWindowTitle(owner, std::nullopt);
+	SetScriptBadge(owner, std::nullopt);
+	RemoveScriptColors(owner);
+}
+
+} // namespace Tele::Scripting
