+void Message::ensureScriptQuick() const {
+	if (_scriptQuick) {
+		return;
+	}
+	_scriptQuick = std::make_unique<ScriptQuick>();
+	Tele::Scripting::ScriptQuickActionsChanges(
+	) | rpl::on_next([=] {
+		if (isUnderCursor()) {
+			repaint();
+		}
+	}, _scriptQuick->lifetime);
+}
