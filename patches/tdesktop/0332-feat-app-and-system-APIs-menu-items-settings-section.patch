+void Instance::watchTheme() {
+	if (_watchingTheme) {
+		return;
+	}
+	_watchingTheme = true;
+	rpl::merge(
+		Window::Theme::IsNightModeValue() | rpl::skip(1) | rpl::to_empty,
+		style::PaletteChanged()
+	) | rpl::on_next([=] {
+		crl::on_main(this, [=] {
+			if (!_engine) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				payload,
+				"dark",
+				JS_NewBool(ctx, Window::Theme::IsNightMode()));
+			callRegistered(Kind::Theme, payload, u"app.theme.onChange"_q);
+		});
+	}, _systemLifetime);
+}
+
+void Instance::watchPlayer() {
+	if (_watchingPlayer) {
+		return;
+	}
+	_watchingPlayer = true;
+	const auto player = Media::Player::instance();
+	const auto key = [=] {
+		const auto type = player->getActiveType();
+		const auto id = player->current(type);
+		return id.audio()
+			? (QString::number(id.audio()->id)
+				+ (Playing(player->getState(type)) ? u"+"_q : u"-"_q))
+			: QString();
+	};
+	_lastPlayer = key();
+	rpl::merge(
+		player->trackChanged() | rpl::to_empty,
+		player->updatedNotifier() | rpl::to_empty
+	) | rpl::on_next([=] {
+		const auto now = key();
+		if (now == _lastPlayer || !_engine) {
+			return;
+		}
+		_lastPlayer = now;
+		crl::on_main(this, [=] {
+			if (_engine) {
+				callRegistered(
+					Kind::Player,
+					playerValue(_engine->ctx()),
+					u"app.player.onChange"_q);
+			}
+		});
+	}, _systemLifetime);
+}
+
+void Instance::watchCalls() {
+	if (_watchingCalls) {
+		return;
+	}
+	_watchingCalls = true;
+	const auto key = [=] {
+		const auto call = Core::App().calls().currentCall();
+		return (!call || &call->user()->session() != _session.get())
+			? QString()
+			: (QString::number(call->user()->id.value)
+				+ CallStateName(call->state())
+				+ (call->muted() ? u"+"_q : u"-"_q));
+	};
+	_lastCall = key();
+	Core::App().calls().currentCallValue(
+	) | rpl::map([](Calls::Call *call) -> rpl::producer<> {
+		return call
+			? rpl::merge(
+				call->stateValue() | rpl::to_empty,
+				call->mutedValue() | rpl::to_empty)
+			: rpl::single(rpl::empty);
+	}) | rpl::flatten_latest(
+	) | rpl::on_next([=] {
+		const auto now = key();
+		if (now == _lastCall || !_engine) {
+			return;
+		}
+		_lastCall = now;
+		crl::on_main(this, [=] {
+			if (_engine) {
+				callRegistered(
+					Kind::CallState,
+					callValue(_engine->ctx()),
+					u"calls.onChange"_q);
+			}
+		});
+	}, _systemLifetime);
+}
