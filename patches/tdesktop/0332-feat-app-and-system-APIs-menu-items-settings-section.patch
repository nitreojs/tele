+JSValue Instance::NativeSystem(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	static const auto names = std::array<const char*, 30>{
+		"tg.app.theme.get",
+		"tg.app.theme.setDark",
+		"tg.app.theme.color",
+		"tg.app.theme.setColors",
+		"tg.app.theme.onChange",
+		"tg.app.window.setTitle",
+		"tg.app.window.setBadge",
+		"tg.app.window.flash",
+		"tg.app.player.current",
+		"tg.app.player",
+		"tg.app.player.onChange",
+		"tg.calls.current",
+		"tg.calls",
+		"tg.calls.start",
+		"tg.calls.onChange",
+		"tg.accounts.list",
+		"tg.accounts.switchTo",
+		"tg.unsafe.exec",
+		"tg.interceptDrop",
+		"tg.tele.ignored.list",
+		"tg.tele.ignored.set",
+		"tg.tele.ghost.get",
+		"tg.tele.ghost.set",
+		"tg.tele.ghost.list",
+		"tg.tele.localNames.list",
+		"tg.tele.localNames.set",
+		"tg.ui.registerMenuItem",
+		"tg.ui.registerSettingsEntry",
+		"tg.ui.openSection",
+		"tg.registerQuickAction",
+	};
+	const auto capability = [&]() -> std::optional<Capability> {
+		switch (magic) {
+		case 1: case 3: case 5: case 6: case 7: case 9:
+			return Capability::App;
+		case 11: case 12: case 13: case 14:
+			return Capability::Calls;
+		case 15: case 16:
+			return Capability::Accounts;
+		case 17:
+			return Capability::Exec;
+		case 18:
+			return Capability::InterceptDrop;
+		case 20: case 22: case 25:
+			return Capability::Options;
+		}
+		return std::nullopt;
+	}();
+	if ((magic == 19 || magic == 21 || magic == 23 || magic == 24)
+		&& !instance->_permissions.allows(Capability::AccountRead, "peers")) {
+		return ThrowNotGranted(
+			ctx,
+			QString::fromLatin1(names[magic]),
+			GrantText(Capability::AccountRead, "peers"));
+	}
+	const auto peerAt = [&](int index) -> PeerData* {
+		const auto session = instance->_session;
+		const auto id = (argc > index)
+			? PeerFromValue(ctx, argv[index], session->user()->id)
+			: std::nullopt;
+		return id ? session->data().peerLoaded(*id) : nullptr;
+	};
+	static const auto ghostModes = std::array{
+		std::pair{ GhostOverride::Default, "default" },
+		std::pair{ GhostOverride::Always, "always" },
+		std::pair{ GhostOverride::Never, "never" },
+	};
+	const auto ghostName = [](GhostOverride mode) {
+		const auto i = ranges::find(ghostModes, mode, [](const auto &pair) {
+			return pair.first;
+		});
+		return (i != end(ghostModes)) ? i->second : "default";
+	};
+	if (capability && !instance->_permissions.allows(*capability, {})) {
+		return ThrowNotGranted(
+			ctx,
+			QString::fromLatin1(names[magic]),
+			GrantText(*capability, {}));
+	}
+	const auto enroll = [&](Kind kind) {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "%s(function)", names[magic]);
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = kind,
+			.fn = JS_DupValue(ctx, argv[0]),
+		});
+		return instance->disposer(id);
+	};
+	const auto string = [&](int index) {
+		return (argc > index && JS_IsString(argv[index]))
+			? std::make_optional(FromStd(ToStd(ctx, argv[index])))
+			: std::nullopt;
+	};
+	switch (magic) {
+	case 0: {
+		auto result = JS_NewObject(ctx);
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"dark",
+			JS_NewBool(ctx, Window::Theme::IsNightMode()));
+		return result;
+	}
+	case 1: {
+		const auto dark = (argc > 0) && JS_ToBool(ctx, argv[0]);
+		if (dark != Window::Theme::IsNightMode()) {
+			crl::on_main([] { Window::Theme::ToggleNightMode(); });
+		}
+		return JS_UNDEFINED;
+	}
+	case 2: {
+		const auto name = string(0);
+		const auto color = name ? PaletteColor(*name) : std::nullopt;
+		return color ? NewString(ctx, ScriptColorText(*color)) : JS_UNDEFINED;
+	}
+	case 3: {
+		if (argc < 1 || !JS_IsObject(argv[0]) || JS_IsArray(argv[0])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.app.theme.setColors({ name: '#rrggbb' | '#rrggbbaa' })");
+		}
+		auto properties = (JSPropertyEnum*)nullptr;
+		auto count = uint32_t();
+		if (JS_GetOwnPropertyNames(
+				ctx,
+				&properties,
+				&count,
+				argv[0],
+				JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY) < 0) {
+			return JS_EXCEPTION;
+		}
+		auto colors = std::vector<std::pair<QString, QColor>>();
+		auto bad = QString();
+		for (auto i = uint32_t(); i != count; ++i) {
+			const auto key = JS_AtomToCString(ctx, properties[i].atom);
+			const auto name = key ? QString::fromUtf8(key) : QString();
+			if (key) {
+				JS_FreeCString(ctx, key);
+			}
+			auto value = JS_GetProperty(ctx, argv[0], properties[i].atom);
+			const auto parsed = JS_IsString(value)
+				? ParseScriptColor(FromStd(ToStd(ctx, value)))
+				: std::nullopt;
+			JS_FreeValue(ctx, value);
+			if (!parsed) {
