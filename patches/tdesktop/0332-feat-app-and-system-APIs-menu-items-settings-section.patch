+void Instance::clickRegistration(
+		int id,
+		Fn<JSValue(JSContext*)> payload,
+		const QString &where) {
+	const auto i = _registrations.find(id);
+	if (i == end(_registrations)
+		|| !_engine
+		|| !JS_IsFunction(_engine->ctx(), i->second.fn)) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto fn = JS_DupValue(ctx, i->second.fn);
+	auto argument = payload ? payload(ctx) : JS_UNDEFINED;
+	JSValueConst args[] = { argument };
+	JS_FreeValue(
+		ctx,
+		invoke(
+			fn,
+			std::span<JSValueConst>(args, payload ? 1 : 0),
+			kListenerBudget,
+			where));
+	if (!_engine) {
+		return;
+	}
+	JS_FreeValue(ctx, fn);
+	JS_FreeValue(ctx, argument);
+	_engine->drain();
+}
