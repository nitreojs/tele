+void ConfirmDelete(
+		not_null<State*> state,
+		std::vector<Data::SavedStarGiftId> ids,
+		bool final) {
+	if (const auto reason = DeleteReason(state, ids); !reason.isEmpty()) {
+		ShowTeleToast(state->window->uiShow(), reason);
+		return;
+	}
+	const auto weak = base::make_weak(state->list);
+	const auto window = base::make_weak(state->window.get());
+	const auto session = base::make_weak(&state->window->session());
+	const auto approved = std::make_shared<bool>(false);
+	const auto total = int(ids.size());
+	state->window->show(Ui::MakeConfirmBox({
+		.text = final
+			? Lower(Plural(
+				u"Confirm permanent deletion of %1 gift. This can't be undone and pays no Stars."_q,
+				u"Confirm permanent deletion of %1 gifts. This can't be undone and pays no Stars."_q,
+				total)).arg(total)
+			: Lower(Plural(
+				u"Delete %1 gift permanently? You won't receive any Stars."_q,
+				u"Delete %1 gifts permanently? You won't receive any Stars."_q,
+				total)).arg(total),
+		.confirmed = [=](Fn<void()> close) {
+			if (*approved) {
+				return;
+			}
+			*approved = true;
+			close();
+			const auto strong = weak.get();
+			const auto current = (strong && window && session)
+				? Find(strong)
+				: nullptr;
+			if (!current || !current->active || current->busy || !GiftSelect()) {
+				return;
+			}
+			if (!final) {
+				ConfirmDelete(current, ids, true);
+				return;
+			}
+			const auto reason = DeleteReason(current, ids);
+			const auto show = current->window->uiShow();
+			if (!reason.isEmpty()) {
+				ShowTeleToast(show, reason);
+				return;
+			}
+			RunBatch(current, Lower(u"Deleting gifts"_q), ids, [=](
+					int index,
+					Fn<void(bool, QString)> done) {
+				const auto strong = weak.get();
+				const auto current = (strong && window && session)
+					? Find(strong)
+					: nullptr;
+				if (!current || !CanDelete(current, ids[index])) {
+					done(false, Lower(u"This gift can no longer be deleted."_q));
+					return;
+				}
+				Settings::DeleteSavedStarGift(
+					show,
+					ids[index],
+					std::move(done),
+					true);
+			}, Lower(Plural(
+				u"%1 gift deleted"_q,
+				u"%1 gifts deleted"_q,
+				total)).arg(total));
+		},
+		.confirmText = tr::lng_box_delete(),
+		.confirmStyle = &st::attentionBoxButton,
+		.title = tr::lng_gift_menu_delete(),
+	}));
+}
