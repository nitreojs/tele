+bool GiftSelectionDragBegin(
+		not_null<Ui::RpWidget*> list,
+		const Data::SavedStarGift &anchor) {
+	const auto state = Find(list);
+	if (!state || !state->active || state->busy || !GiftSelect()) {
+		return false;
+	}
+	state->drag.emplace();
+	auto &drag = *state->drag;
+	drag.select = !Contains(state, anchor.manageId);
+	for (const auto &gift : state->selected) {
+		drag.before.emplace(gift.manageId);
+	}
+	return true;
+}
+
+void GiftSelectionDragUpdate(
+		not_null<Ui::RpWidget*> list,
+		int from,
+		int till,
+		Fn<const Data::SavedStarGift&(int)> giftAt) {
+	const auto state = Find(list);
+	if (!state || !state->active || state->busy || !state->drag) {
+		return;
+	}
+	auto &drag = *state->drag;
+	auto changed = false;
+	if (drag.from == from && drag.till == till) {
+		return;
+	}
+	for (auto i = drag.from; i != drag.till; ++i) {
+		if (i < from || i >= till) {
+			const auto &gift = giftAt(i);
+			changed |= SetSelected(
+				state,
+				gift,
+				drag.before.contains(gift.manageId));
+		}
+	}
+	for (auto i = from; i != till; ++i) {
+		if (i < drag.from || i >= drag.till) {
+			changed |= SetSelected(state, giftAt(i), drag.select);
+		}
+	}
+	drag.from = from;
+	drag.till = till;
+	if (changed) {
+		state->changes.fire({});
+	}
+}
+
+void GiftSelectionDragEnd(not_null<Ui::RpWidget*> list) {
+	if (const auto state = Find(list)) {
+		state->drag.reset();
+	}
+}
+
+void GiftSelectionRefresh(not_null<Ui::RpWidget*> list) {
+	if (const auto state = Find(list); state && state->active) {
+		state->changes.fire({});
+	}
+}
