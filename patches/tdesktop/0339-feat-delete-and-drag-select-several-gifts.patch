+void InnerWidget::updateRangeSelection(QPoint global) {
+	if (!_perRow
+		|| _rangeSelection.anchor < 0
+		|| _rangeSelection.anchor >= _list->size()
+		|| !Tele::GiftSelectionActive(this)) {
+		cancelDragging();
+		return;
+	}
+	_rangeSelection.position = global;
+	const auto extend = _delegate.buttonExtend();
+	const auto origin = posFromIndex(0) + QPoint(extend.left(), extend.top());
+	const auto point = mapFromGlobal(global) - origin;
+	const auto skip = st::giftBoxGiftSkip;
+	const auto row = std::clamp(
+		std::max(point.y(), 0) / (_single.height() + skip.y()),
+		0,
+		(int(_list->size()) - 1) / _perRow);
+	const auto column = std::clamp(
+		std::max(point.x(), 0) / (_single.width() + skip.x()),
+		0,
+		_perRow - 1);
+	const auto target = std::min(row * _perRow + column, int(_list->size()) - 1);
+	const auto anchor = _rangeSelection.anchor;
+	Tele::GiftSelectionDragUpdate(
+		this,
+		std::min(anchor, target),
+		std::max(anchor, target) + 1,
+		[=](int index) -> const Data::SavedStarGift& {
+			return (*_list)[index].gift;
+		});
+	checkForScrollAnimation();
+}
