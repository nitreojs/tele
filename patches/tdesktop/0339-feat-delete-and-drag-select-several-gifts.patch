+const Data::SavedStarGift *InnerWidget::teleLookupGift(
+		const Data::SavedStarGiftId &id) const {
+	const auto find = [&](const Entries &entries) -> const Data::SavedStarGift* {
+		const auto i = ranges::find(entries.list, id, [](const Entry &entry) {
+			return entry.gift.manageId;
+		});
+		return (i != end(entries.list)) ? &i->gift : nullptr;
+	};
+	if (const auto gift = find(*_entries)) {
+		return gift;
+	} else if (const auto gift = find(_all)) {
+		return gift;
+	} else if (const auto gift = find(_teleFound)) {
+		return gift;
+	}
+	for (const auto &[_, entries] : _perCollection) {
+		if (const auto gift = find(entries)) {
+			return gift;
+		}
+	}
+	return nullptr;
 }
 
