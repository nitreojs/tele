From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Thu, 1 Oct 2026 04:41:56 +0300
Subject: [PATCH] fix: land the send animation where the message really is

---
 .../SourceFiles/history/history_widget.cpp    | 15 +++---------
 .../history/view/history_view_list_widget.cpp | 10 +++-----
 .../message_sending_animation_controller.cpp  | 24 +++++++++----------
 .../message_sending_animation_controller.h    |  2 +-
 4 files changed, 19 insertions(+), 32 deletions(-)

diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index 70d33405ad0c94368fe23e948a2193129e1b844a..82f451b47cdc16c1d2cb478419a5e824023ac04e 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -8981,23 +8981,14 @@ void HistoryWidget::startMessageSendingAnimation(
 	}
 	Assert(item->mainView() != nullptr);
 
-	auto globalEndTopLeft = rpl::merge(
-		_scroll->innerResizes() | rpl::to_empty,
-		session().data().newItemAdded() | rpl::to_empty,
-		geometryValue() | rpl::to_empty,
-		_scroll->geometryValue() | rpl::to_empty,
-		_list->geometryValue() | rpl::to_empty
-	) | rpl::map([=]() -> std::optional<QPoint> {
+	auto globalEndTopLeft = [=]() -> std::optional<QPoint> {
 		const auto view = item->mainView();
 		const auto top = view ? _list->itemTop(view) : -1;
 		if (top < 0) {
 			return std::nullopt;
 		}
-		const auto additional = (_list->height() == _scroll->height())
-			? view->height()
-			: 0;
-		return _list->mapToGlobal(QPoint(0, top - additional));
-	});
+		return _list->mapToGlobal(QPoint(0, top));
+	};
 
 	sendingAnimation.startAnimation({
 		.globalEndTopLeft = std::move(globalEndTopLeft),
diff --git a/Telegram/SourceFiles/history/view/history_view_list_widget.cpp b/Telegram/SourceFiles/history/view/history_view_list_widget.cpp
index ba0413a5a16944b9a2ba2dc6a2cc2947e312e409..2aad537070100eb5671ceb793394189f378b737c 100644
--- a/Telegram/SourceFiles/history/view/history_view_list_widget.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_list_widget.cpp
@@ -2782,17 +2782,13 @@ void ListWidget::startMessageSendingAnimation(
 		return;
 	}
 
-	auto globalEndTopLeft = rpl::merge(
-		session().data().newItemAdded() | rpl::to_empty,
-		geometryValue() | rpl::to_empty
-	) | rpl::map([=]() -> std::optional<QPoint> {
+	auto globalEndTopLeft = [=]() -> std::optional<QPoint> {
 		const auto view = viewForItem(item);
 		if (!view) {
 			return std::nullopt;
 		}
-		const auto additional = !_visibleTop ? view->height() : 0;
-		return mapToGlobal(QPoint(0, itemTop(view) - additional));
-	});
+		return mapToGlobal(QPoint(0, itemTop(view)));
+	};
 
 	sendingAnimation->startAnimation({
 		.globalEndTopLeft = std::move(globalEndTopLeft),
diff --git a/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.cpp b/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.cpp
index 4b66885b149f08497aef9478f1adcac2c991cafc..6edeb76e9d05b4cd97938d7c98e1bff4c1b8337c 100644
--- a/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.cpp
+++ b/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.cpp
@@ -24,6 +24,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "ui/rp_widget.h"
 #include "ui/power_saving.h"
 #include "ui/text/text_isolated_emoji.h"
+#include "ui/ui_utility.h"
 #include "window/window_session_controller.h"
 #include "styles/style_chat.h"
 #include "styles/style_chat_style.h"
@@ -107,17 +108,6 @@ Content::Content(
 	setAttribute(Qt::WA_TransparentForMouseEvents);
 	raise();
 
-	base::take(
-		_toInfo.globalEndTopLeft
-	) | rpl::distinct_until_changed(
-	) | rpl::on_next([=](const std::optional<QPoint> &p) {
-		if (p) {
-			_to = parent->mapFromGlobal(*p);
-		} else {
-			_destroyRequests.fire({});
-		}
-	}, lifetime());
-
 	_controller->session().downloaderTaskFinished(
 	) | rpl::on_next([=] {
 		update();
@@ -128,6 +118,12 @@ Content::Content(
 	const auto innerGeometry = maybeView()->innerGeometry();
 
 	auto animationCallback = [=](float64 value) {
+		const auto to = _toInfo.globalEndTopLeft();
+		if (!to) {
+			_destroyRequests.fire({});
+			return;
+		}
+		_to = parent->mapFromGlobal(*to);
 		auto resultFrom = rect();
 		if (_isText) {
 			resultFrom.moveTo(
@@ -193,7 +189,11 @@ Content::Content(
 	};
 	animationCallback(0.);
 	_animation.start(
-		std::move(animationCallback),
+		[=] {
+			PostponeCall(this, [=] {
+				animationCallback(_animation.value(1.));
+			});
+		},
 		0.,
 		1.,
 		st::itemRevealDuration,
diff --git a/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.h b/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.h
index 8250e778ad79b3ae5c5763e82ef35247dc999bfc..8cedf07228fe4fdd6f9932f5e30906d2d5dacf90 100644
--- a/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.h
+++ b/Telegram/SourceFiles/ui/effects/message_sending_animation_controller.h
@@ -29,7 +29,7 @@ public:
 		not_null<Window::SessionController*> controller);
 
 	struct SendingInfoTo {
-		rpl::producer<std::optional<QPoint>> globalEndTopLeft;
+		Fn<std::optional<QPoint>()> globalEndTopLeft;
 		Fn<HistoryView::Element*()> view;
 		Fn<Ui::ChatPaintContext()> paintContext;
 	};
