+namespace Tele::Scripting {
+namespace {
+
+[[nodiscard]] base::flat_map<not_null<const HistoryItem*>, double> &Marked() {
+	static auto result = base::flat_map<
+		not_null<const HistoryItem*>,
+		double>();
+	return result;
+}
+
+[[nodiscard]] QByteArray Serialize(
+		const std::string &bytes,
+		double opacity) {
+	return QByteArray::number(opacity, 'g', 6)
+		+ ' '
+		+ QByteArray(bytes.data(), int(bytes.size())).toBase64();
+}
+
+} // namespace
+
+LocalMessages::LocalMessages(
+	not_null<Main::Session*> session,
+	not_null<ScriptStorage*> storage)
+: _session(session)
+, _storage(storage) {
+	_session->data().itemRemoved(
+	) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		removed(item);
+	}, _lifetime);
+}
+
+LocalMessages::~LocalMessages() {
+	_lifetime.destroy();
+	for (const auto &[key, local] : base::take(_locals)) {
+		destroy(local.id);
+	}
+}
+
+void LocalMessages::restore() {
+	auto broken = QStringList();
+	for (const auto &[name, value] : _storage->values()) {
+		auto ok = false;
+		const auto key = name.toInt(&ok);
+		const auto space = value.indexOf(' ');
+		if (!ok || key <= 0 || space <= 0) {
+			broken.push_back(name);
+			continue;
+		}
+		const auto opacity = value.left(space).toDouble();
+		const auto decoded = QByteArray::fromBase64(value.mid(space + 1));
+		auto bytes = std::string(decoded.constData(), decoded.size());
+		auto error = QString();
+		const auto id = create(bytes, opacity, error);
+		if (!id) {
+			broken.push_back(name);
+			continue;
+		}
+		_locals.emplace(key, Local{
+			.id = id,
+			.bytes = std::move(bytes),
+			.opacity = opacity,
+			.persist = true,
+		});
+		_key = std::max(_key, key);
+	}
+	for (const auto &name : broken) {
+		_storage->remove(name);
+	}
+}
+
+int LocalMessages::add(
+		std::string bytes,
+		double opacity,
+		bool persist,
+		QString &error) {
+	const auto id = create(bytes, opacity, error);
+	if (!id) {
+		return 0;
+	}
+	const auto key = ++_key;
+	auto &local = _locals.emplace(key, Local{
+		.id = id,
+		.bytes = std::move(bytes),
+		.opacity = opacity,
+		.persist = persist,
+	}).first->second;
+	if (persist && !save(key, local)) {
+		_locals.erase(key);
+		destroy(id);
+		error = u"persisted local messages are over the 1 MB quota"_q;
+		return 0;
+	}
+	return key;
+}
+
+bool LocalMessages::replace(
+		int key,
+		std::string bytes,
+		double opacity,
+		QString &error) {
+	const auto i = _locals.find(key);
+	if (i == end(_locals)) {
+		error = u"this local message was removed"_q;
+		return false;
+	}
+	const auto id = create(bytes, opacity, error);
+	if (!id) {
+		return false;
+	}
+	const auto old = std::exchange(i->second.id, id);
+	i->second.bytes = std::move(bytes);
+	i->second.opacity = opacity;
+	destroy(old);
+	if (i->second.persist && !save(key, i->second)) {
+		error = u"persisted local messages are over the 1 MB quota"_q;
+	}
+	return true;
+}
+
+bool LocalMessages::remove(int key) {
+	const auto i = _locals.find(key);
+	if (i == end(_locals)) {
+		return false;
+	}
+	const auto local = std::move(i->second);
+	_locals.erase(i);
+	if (local.persist) {
+		_storage->remove(QString::number(key));
+	}
+	destroy(local.id);
+	return true;
+}
+
+std::vector<LocalMessages::Entry> LocalMessages::list() const {
+	auto result = std::vector<Entry>();
+	result.reserve(_locals.size());
+	for (const auto &[key, local] : _locals) {
+		result.push_back({
+			.key = key,
+			.bytes = local.bytes,
+			.opacity = local.opacity,
+			.persist = local.persist,
+		});
+	}
+	return result;
+}
+
+FullMsgId LocalMessages::create(
+		const std::string &bytes,
+		double opacity,
+		QString &error) {
+	auto from = reinterpret_cast<const mtpPrime*>(bytes.data());
+	const auto till = from + (bytes.size() / sizeof(mtpPrime));
+	auto message = MTPMessage();
+	if (!message.read(from, till)) {
+		error = u"the message doesn't encode"_q;
+		return {};
+	} else if (message.type() == mtpc_messageEmpty) {
+		error = u"a local message can't be messageEmpty"_q;
+		return {};
+	}
+	auto &owner = _session->data();
+	const auto item = owner.addNewMessage(
+		owner.nextLocalMessageId(),
+		message,
+		MessageFlag::Local,
+		NewMessageType::Existing);
+	if (!item) {
+		error = u"the message has no chat"_q;
+		return {};
+	}
+	Marked()[item] = std::clamp(opacity, 0., 1.);
+	const auto history = item->history();
+	history->checkLocalMessages();
+	if (item->mainView()) {
+		owner.notifyHistoryChangeDelayed(history);
+		_session->changes().messageUpdated(
+			item,
+			Data::MessageUpdate::Flag::NewMaybeAdded);
+	}
+	return item->fullId();
+}
+
+void LocalMessages::destroy(FullMsgId id) {
+	if (const auto item = _session->data().message(id)) {
+		Marked().remove(item);
+		item->destroy();
+	}
+}
+
+bool LocalMessages::save(int key, const Local &local) {
+	return _storage->set(
+		QString::number(key),
+		Serialize(local.bytes, local.opacity));
+}
+
+void LocalMessages::removed(not_null<const HistoryItem*> item) {
+	if (!Marked().remove(item)) {
+		return;
+	}
+	const auto id = item->fullId();
+	for (auto i = begin(_locals); i != end(_locals); ++i) {
+		if (i->second.id == id) {
+			if (i->second.persist) {
+				_storage->remove(QString::number(i->first));
+			}
+			_locals.erase(i);
+			return;
+		}
+	}
+}
+
+bool IsScriptLocal(not_null<const HistoryItem*> item) {
+	return item->isLocal() && Marked().contains(item);
+}
+
+double LocalOpacity(not_null<const HistoryItem*> item) {
+	if (!item->isLocal()) {
+		return 1.;
+	}
+	const auto &marked = Marked();
+	const auto i = marked.find(item);
+	return (i != end(marked)) ? i->second : 1.;
+}
+
+void DrawElement(
+		Painter &p,
+		not_null<const HistoryView::Element*> view,
+		const Ui::ChatPaintContext &context) {
+	const auto opacity = LocalOpacity(view->data());
+	if (opacity >= 1.) {
+		view->draw(p, context);
+		return;
+	}
+	const auto was = p.opacity();
+	p.setOpacity(was * opacity);
+	view->draw(p, context);
+	p.setOpacity(was);
+}
+
+} // namespace Tele::Scripting
