+JSValue Instance::NativeLocal(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance || !instance->_local) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto local = instance->_local.get();
+	if (magic == 3) {
+		auto result = JS_NewArray(ctx);
+		auto index = std::uint32_t();
+		for (const auto &entry : local->list()) {
+			auto decoded = DecodeTl(
+				ctx,
+				entry.bytes,
+				"Message",
+				instance->filter());
+			if (!decoded.error.empty()) {
+				continue;
+			}
+			auto object = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, object, "key", JS_NewInt32(ctx, entry.key));
+			JS_SetPropertyStr(
+				ctx,
+				object,
+				"persist",
+				JS_NewBool(ctx, entry.persist));
+			JS_SetPropertyStr(
+				ctx,
+				object,
+				"opacity",
+				JS_NewFloat64(ctx, entry.opacity));
+			JS_SetPropertyStr(ctx, object, "message", decoded.value);
+			JS_SetPropertyUint32(ctx, result, index++, object);
+		}
+		return result;
+	}
+	auto key = 0;
+	if (magic != 0
+		&& (argc < 1 || !JS_IsNumber(argv[0]) || JS_ToInt32(ctx, &key, argv[0]))) {
+		return JS_ThrowTypeError(ctx, "a local message key is a number");
+	} else if (magic == 2) {
+		return JS_NewBool(ctx, local->remove(key));
+	}
+	const auto index = (magic == 0) ? 0 : 1;
+	if (argc <= index || !JS_IsObject(argv[index])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"a local message is a TL message or messageService");
+	}
+	auto encoded = EncodeTl(ctx, argv[index], "Message");
+	if (!encoded.error.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"local message: %s",
+			encoded.error.c_str());
+	}
+	auto opacity = 0.5;
+	if (argc > index + 1
+		&& !JS_IsUndefined(argv[index + 1])
+		&& (!JS_IsNumber(argv[index + 1])
+			|| JS_ToFloat64(ctx, &opacity, argv[index + 1]))) {
+		return JS_ThrowTypeError(ctx, "opacity is a number from 0 to 1");
+	}
+	auto error = QString();
+	if (magic == 1) {
+		if (!local->replace(key, std::move(encoded.bytes), opacity, error)) {
+			return JS_ThrowTypeError(ctx, "%s", error.toUtf8().constData());
+		} else if (!error.isEmpty()) {
+			instance->log(LogLevel::Warning, error);
+		}
+		return JS_UNDEFINED;
+	}
+	const auto persist = (argc > 2) && JS_ToBool(ctx, argv[2]);
+	const auto result = local->add(
+		std::move(encoded.bytes),
+		opacity,
+		persist,
+		error);
+	if (!result) {
+		return JS_ThrowTypeError(ctx, "%s", error.toUtf8().constData());
+	}
+	return JS_NewInt32(ctx, result);
+}
