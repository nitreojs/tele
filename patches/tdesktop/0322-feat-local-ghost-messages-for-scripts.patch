 			return message;
 		};
 
+		const localFieldsOf = async (options) => {
+			const fields = {};
+			if (options.text !== undefined) {
+				const content = textOf(options.text);
+				fields.message = content.text;
+				fields.entities = content.entities;
+			}
+			if (options.date !== undefined) {
+				fields.date = seconds(options.date);
+			}
+			if (options.from !== undefined) {
+				const from = peerOfInput(await resolvePeer(options.from));
+				fields.fromId = from;
+				fields.out = (from._ === 'peerUser' && from.userId === selfId);
+			}
+			if (options.out !== undefined) {
+				fields.out = options.out;
+			}
+			if (options.replyTo !== undefined) {
+				fields.replyTo = (options.replyTo === null)
+					? undefined
+					: { _: 'messageReplyHeader', replyToMsgId: options.replyTo };
+			}
+			if (options.media !== undefined) {
+				fields.media = (options.media instanceof Message) ? options.media.media : options.media;
+			}
+			if (options.action !== undefined) {
+				fields.action = options.action;
+			}
+			return { ...fields, ...(options.raw ?? {}) };
+		};
+
+		const localMessageOf = (fields) => {
+			const result = { ...fields };
+			const service = (result.action !== undefined && result.action !== null);
+			result._ = service ? 'messageService' : 'message';
+			if (service) {
+				delete result.message;
+				delete result.entities;
+				delete result.media;
+			} else {
+				delete result.action;
+				result.message ??= '';
+			}
+			for (const key of Object.keys(result)) {
+				if (result[key] === undefined || result[key] === null) {
+					delete result[key];
+				}
+			}
+			return result;
+		};
+
+		class LocalMessage {
+			#entry;
+
+			constructor(entry) {
+				this.#entry = entry;
+			}
+
+			get key() {
+				return this.#entry.key;
+			}
+
+			get persisted() {
+				return this.#entry.persist;
+			}
+
+			get opacity() {
+				return this.#entry.opacity;
+			}
+
+			get raw() {
+				return this.#entry.message;
+			}
+
+			get chatId() {
+				return markedId(this.#entry.message.peerId, selfId);
+			}
+
+			get message() {
+				return new Message(this.#entry.message, tg);
+			}
+
+			async edit(changes = {}) {
+				const message = localMessageOf({ ...this.#entry.message, ...(await localFieldsOf(changes)) });
+				const opacity = changes.opacity ?? this.#entry.opacity;
+				given.localReplace(this.#entry.key, message, opacity);
+				this.#entry = { ...this.#entry, message, opacity };
+				return this;
+			}
+
+			remove() {
+				return given.localRemove(this.#entry.key);
+			}
+
+			toJSON() {
+				return { key: this.key, chatId: this.chatId, persisted: this.persisted, opacity: this.opacity, message: this.raw };
+			}
+		}
+
 		const wrapMessages = (result) => {
 			if (result._ === 'messages.messagesNotModified') {
 				return [];
@@ -1013,6 +1124,29 @@
 				return given.listenSend((context) => (sendMatches(filter, context.message) ? middleware(context) : 'send'));
 			},
 
+			async addLocalMessage(chat, options = {}) {
+				const peerId = peerOfInput(await resolvePeer(chat));
+				const channel = (tg.peers.get(markedId(peerId, selfId))?.kind === 'channel');
+				const fields = await localFieldsOf(options);
+				const anonymous = (fields.out === false && fields.fromId === undefined);
+				const message = localMessageOf({
+					id: 0,
+					peerId,
+					date: seconds(new Date()),
+					out: true,
+					...(channel ? { post: true } : anonymous ? {} : { fromId: { _: 'peerUser', userId: selfId } }),
+					...fields,
+				});
+				const opacity = options.opacity ?? 0.5;
+				const persist = (options.persist === true);
+				const key = given.localAdd(message, opacity, persist);
+				return new LocalMessage({ key, persist, opacity, message });
+			},
+
+			localMessages() {
+				return given.localList().map((entry) => new LocalMessage(entry));
+			},
+
 			registerCommand(options) {
 				return given.command(options);
 			},
