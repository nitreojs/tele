+	hidden('__teleRunSends', async (message, handlers, fault) => {
+		for (const handler of handlers) {
+			let verdict;
+			try {
+				verdict = await handler({ message });
+			} catch (error) {
+				fault('interceptSendMessage', error);
+				return { verdict: 'fail', message };
+			}
+			if (verdict === 'drop') {
+				return { verdict: 'drop', message };
+			} else if (verdict !== 'send') {
+				fault('interceptSendMessage', new TypeError("an interceptor must return 'send' or 'drop'"));
+				return { verdict: 'fail', message };
+			}
+		}
+		return { verdict: 'send', message };
