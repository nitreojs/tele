+#include "styles/style_layers.h"
+
+namespace Tele::Scripting {
+namespace {
+
+void AddHeader(
+		not_null<Ui::GenericBox*> box,
+		const QString &script,
+		const QString &title,
+		const QString &message) {
+	box->setTitle(rpl::single(title.isEmpty() ? script : title));
+	if (!message.isEmpty()) {
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			message,
+			st::boxLabel));
+		Ui::AddSkip(box->verticalLayout());
+	}
+	if (!title.isEmpty()) {
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"From the script %1"_q).arg(script),
+			st::boxDividerLabel));
+	}
+}
+
+[[nodiscard]] Fn<void()> Once(
+		not_null<Ui::GenericBox*> box,
+		Fn<void()> dismissed) {
+	const auto answered = box->lifetime().make_state<bool>(false);
+	box->boxClosing() | rpl::on_next([=] {
+		if (!*answered) {
+			*answered = true;
+			dismissed();
+		}
+	}, box->lifetime());
+	return [=] {
+		*answered = true;
+	};
+}
+
+} // namespace
+
+void ShowScriptDialog(
+		not_null<Window::SessionController*> window,
+		ScriptDialog descriptor,
+		Fn<void(QString)> done) {
+	window->show(Box([=](not_null<Ui::GenericBox*> box) {
+		AddHeader(box, descriptor.script, descriptor.title, descriptor.message);
+		const auto answer = Once(box, [=] { done(u"dismissed"_q); });
+		const auto add = [&](const QString &text, const QString &result) {
+			if (text.isEmpty()) {
+				return;
+			}
+			const auto button = box->addButton(rpl::single(text), [=] {
+				answer();
+				done(result);
+				box->closeBox();
+			});
+			if (descriptor.danger && result == u"positive"_q) {
+				button->setTextFgOverride(st::attentionButtonFg->c);
+			}
+		};
+		add(
+			descriptor.positive.isEmpty()
+				? tr::lng_box_ok(tr::now)
+				: descriptor.positive,
+			u"positive"_q);
+		add(descriptor.negative, u"negative"_q);
+		add(descriptor.neutral, u"neutral"_q);
+	}));
+}
+
+void ShowScriptPrompt(
+		not_null<Window::SessionController*> window,
+		ScriptPrompt descriptor,
+		Fn<void(std::optional<QString>)> done) {
+	window->show(Box([=](not_null<Ui::GenericBox*> box) {
+		AddHeader(box, descriptor.script, descriptor.title, descriptor.message);
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			descriptor.multiline
+				? Ui::InputField::Mode::MultiLine
+				: Ui::InputField::Mode::SingleLine,
+			rpl::single(descriptor.placeholder),
+			descriptor.value));
+		if (descriptor.maxLength > 0) {
+			field->setMaxLength(descriptor.maxLength);
+		}
+		box->setFocusCallback([=] {
+			field->setFocusFast();
+			field->selectAll();
+		});
+		const auto answer = Once(box, [=] { done(std::nullopt); });
+		const auto submit = [=] {
+			answer();
+			done(field->getLastText());
+			box->closeBox();
+		};
+		field->submits() | rpl::on_next(submit, field->lifetime());
+		box->addButton(tr::lng_box_ok(), submit);
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
+
+void ShowScriptChooser(
+		not_null<Window::SessionController*> window,
+		ScriptChooser descriptor,
+		Fn<void(std::optional<std::vector<int>>)> done) {
+	window->show(Box([=](not_null<Ui::GenericBox*> box) {
+		AddHeader(box, descriptor.script, descriptor.title, QString());
+		const auto answer = Once(box, [=] { done(std::nullopt); });
+		const auto count = int(descriptor.items.size());
+		if (descriptor.multiple) {
+			auto checks = std::vector<not_null<Ui::Checkbox*>>();
+			for (auto i = 0; i != count; ++i) {
+				checks.push_back(box->addRow(object_ptr<Ui::Checkbox>(
+					box,
+					descriptor.items[i],
+					ranges::contains(descriptor.selected, i),
+					st::defaultBoxCheckbox)));
+				Ui::AddSkip(box->verticalLayout());
+			}
+			box->addButton(tr::lng_box_ok(), [=] {
+				auto result = std::vector<int>();
+				for (auto i = 0; i != count; ++i) {
+					if (checks[i]->checked()) {
+						result.push_back(i);
+					}
+				}
+				answer();
+				done(std::move(result));
+				box->closeBox();
+			});
+			box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+			return;
+		}
+		const auto initial = descriptor.selected.empty()
+			? -1
+			: descriptor.selected.front();
+		const auto group = std::make_shared<Ui::RadiobuttonGroup>(initial);
+		for (auto i = 0; i != count; ++i) {
+			box->addRow(object_ptr<Ui::Radiobutton>(
+				box,
+				group,
+				i,
+				descriptor.items[i],
+				st::defaultBoxCheckbox));
+			Ui::AddSkip(box->verticalLayout());
+		}
+		group->setChangedCallback([=](int value) {
+			answer();
+			done(std::vector<int>{ value });
+			box->closeBox();
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
+
+} // namespace Tele::Scripting
