+JSValue Instance::TgDialog(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	static const auto names = std::array<const char*, 3>{
+		"tg.ui.dialog",
+		"tg.ui.prompt",
+		"tg.ui.chooser",
+	};
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (magic < 0 || magic > 2) {
+		return JS_UNDEFINED;
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(ctx, "%s needs an options object", names[magic]);
+	} else if (instance->_dialogOpen) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			QString::fromLatin1(names[magic])
+				+ u": this script already shows a dialog"_q);
+	}
+	const auto window = instance->_session->tryResolveWindow();
+	if (!window) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			QString::fromLatin1(names[magic])
+				+ u": this account has no window"_q);
+	}
+	const auto options = argv[0];
+	const auto script = instance->_name;
+	const auto title = StringProperty(ctx, options, "title");
+	const auto message = StringProperty(ctx, options, "message");
+	auto items = std::vector<QString>();
+	if (magic == 2) {
+		auto list = JS_GetPropertyStr(ctx, options, "items");
+		auto length = std::int64_t();
+		if (JS_IsArray(list) && JS_GetLength(ctx, list, &length) >= 0) {
+			for (auto i = std::int64_t(); i != length; ++i) {
+				auto item = JS_GetPropertyUint32(ctx, list, std::uint32_t(i));
+				items.push_back(FromStd(ToStd(ctx, item)));
+				JS_FreeValue(ctx, item);
+			}
+		}
+		JS_FreeValue(ctx, list);
+		if (items.empty()) {
+			return JS_ThrowTypeError(ctx, "tg.ui.chooser needs items");
+		}
+	}
+	auto created = instance->newPromise();
+	const auto key = created.first;
+	if (!key) {
+		return created.second;
+	}
+	instance->_dialogOpen = true;
+	const auto weak = base::make_weak(instance);
+	const auto finish = [=](JSValue (*make)(JSContext*, QVariant), QVariant result) {
+		crl::on_main(weak, [=] {
+			if (const auto strong = weak.get(); strong && strong->_engine) {
+				strong->_dialogOpen = false;
+				strong->settle(key, true, make(strong->_engine->ctx(), result));
+			}
+		});
+	};
+	if (magic == 0) {
+		ShowScriptDialog(window, {
+			.script = script,
+			.title = title,
+			.message = message,
+			.positive = StringProperty(ctx, options, "positive"),
+			.negative = StringProperty(ctx, options, "negative"),
+			.neutral = StringProperty(ctx, options, "neutral"),
+			.danger = BoolProperty(ctx, options, "danger"),
+		}, [=](QString result) {
+			finish([](JSContext *ctx, QVariant value) {
+				return NewString(ctx, value.toString());
+			}, result);
+		});
+	} else if (magic == 1) {
+		auto length = JS_GetPropertyStr(ctx, options, "maxLength");
+		auto maxLength = 0;
+		if (JS_IsNumber(length)) {
+			JS_ToInt32(ctx, &maxLength, length);
+		}
+		JS_FreeValue(ctx, length);
+		ShowScriptPrompt(window, {
+			.script = script,
+			.title = title,
+			.message = message,
+			.placeholder = StringProperty(ctx, options, "placeholder"),
+			.value = StringProperty(ctx, options, "value"),
+			.maxLength = maxLength,
+			.multiline = BoolProperty(ctx, options, "multiline"),
+		}, [=](std::optional<QString> result) {
+			finish([](JSContext *ctx, QVariant value) {
+				return value.isNull()
+					? JS_NULL
+					: NewString(ctx, value.toString());
+			}, result ? QVariant(*result) : QVariant());
+		});
+	} else {
+		const auto multiple = BoolProperty(ctx, options, "multiple");
+		ShowScriptChooser(window, {
+			.script = script,
+			.title = title,
+			.items = std::move(items),
+			.selected = IndexesProperty(ctx, options, "selected"),
+			.multiple = multiple,
+		}, [=](std::optional<std::vector<int>> result) {
+			auto list = QVariantList();
+			if (result) {
+				for (const auto index : *result) {
+					list.push_back(index);
+				}
+			}
+			finish(multiple ? [](JSContext *ctx, QVariant value) {
+				if (value.isNull()) {
+					return JS_NULL;
+				}
+				auto array = JS_NewArray(ctx);
+				auto i = std::uint32_t();
+				for (const auto &item : value.toList()) {
+					JS_SetPropertyUint32(ctx, array, i++, JS_NewInt32(ctx, item.toInt()));
+				}
+				return array;
+			} : [](JSContext *ctx, QVariant value) {
+				const auto list = value.toList();
+				return (value.isNull() || list.isEmpty())
+					? JS_NULL
+					: JS_NewInt32(ctx, list.front().toInt());
+			}, result ? QVariant(list) : QVariant());
+		});
+	}
+	return created.second;
+}
