+
+bool Host::interceptSendMessage(
+		const Api::MessageToSend &message,
+		std::optional<MsgId> localMessageId) {
+	if (Resending > 0) {
+		return false;
+	}
+	const auto peerId = message.action.history->peer->id;
+	const auto i = _sends.find(peerId);
+	const auto queued = (i != end(_sends)) && !i->second.empty();
+	if (!queued && senders().empty()) {
+		return false;
+	}
+	_sends[peerId].push_back(std::make_shared<HeldSend>(HeldSend{
+		.message = message,
+		.local = localMessageId,
+	}));
+	if (!queued) {
+		crl::on_main(this, [=] {
+			processSend(peerId);
+		});
+	}
+	return true;
+}
+
+void Host::processSend(PeerId peerId) {
+	const auto i = _sends.find(peerId);
+	if (i == end(_sends) || i->second.empty()) {
+		return;
+	}
+	const auto held = i->second.front();
+	const auto weak = base::make_weak(this);
+	runSend(held, senders(), 0, [=](bool send) {
+		crl::on_main(weak, [=] {
+			const auto j = _sends.find(peerId);
+			if (j == end(_sends)
+				|| j->second.empty()
+				|| j->second.front() != held) {
+				return;
+			}
+			j->second.pop_front();
+			if (send) {
+				++Resending;
+				_session->api().sendMessage(
+					Api::MessageToSend(held->message),
+					held->local);
+				--Resending;
+			}
+			if (j->second.empty()) {
+				_sends.erase(j);
+			} else {
+				processSend(peerId);
+			}
+		});
+	});
+}
+
+void Host::runSend(
+		std::shared_ptr<HeldSend> held,
+		std::vector<QString> scripts,
+		int index,
+		Fn<void(bool)> done) {
+	if (index >= int(scripts.size())) {
+		done(true);
+		return;
+	}
+	const auto instance = instanceOf(scripts[index]);
+	if (!instance) {
+		runSend(std::move(held), std::move(scripts), index + 1, done);
+		return;
+	}
+	const auto &action = held->message.action;
+	const auto peer = action.history->peer;
+	auto data = SendData{
+		.text = held->message.textWithTags,
+		.peer = peer,
+		.replyTo = (action.replyTo.messageId.peer == peer->id)
+			? action.replyTo.messageId.msg
+			: MsgId(),
+		.scheduled = action.options.scheduled,
+		.silent = action.options.silent,
+	};
+	const auto weak = base::make_weak(this);
+	instance->interceptSend(std::move(data), [=](
+			std::optional<SendData> result) {
+		crl::on_main(weak, [=] {
+			if (!result) {
+				done(false);
+				return;
+			}
+			auto &message = held->message;
+			message.textWithTags = result->text;
+			message.action.options.silent = result->silent;
+			message.action.options.scheduled = result->scheduled;
+			const auto peerId = message.action.history->peer->id;
+			if (!result->replyTo) {
+				message.action.replyTo = FullReplyTo{
+					.topicRootId = message.action.replyTo.topicRootId,
+				};
+			} else if (message.action.replyTo.messageId
+				!= FullMsgId(peerId, result->replyTo)) {
+				message.action.replyTo = FullReplyTo{
+					.messageId = FullMsgId(peerId, result->replyTo),
+					.topicRootId = message.action.replyTo.topicRootId,
+				};
+			}
+			runSend(held, scripts, index + 1, done);
+		});
+	});
+}
