+	const SEND_KINDS = { user: 'user', bot: 'user', chat: 'group', supergroup: 'group', channel: 'channel' };
+
+	const sendMatches = (filter, message) => {
+		const text = (typeof message.text === 'string') ? message.text : message.text.text;
+		if (filter.text instanceof RegExp) {
+			filter.text.lastIndex = 0;
+			if (!filter.text.test(text)) {
+				return false;
+			}
+		} else if (typeof filter.text === 'boolean' && filter.text !== (text.length > 0)) {
+			return false;
+		}
+		if (filter.peer !== undefined) {
+			const kind = SEND_KINDS[message.chat?.kind] ?? null;
+			const wanted = [filter.peer].flat();
+			if (!wanted.some((item) => ((typeof item === 'string') ? item === kind : BigInt(item) === message.chatId))) {
+				return false;
+			}
+		}
+		return true;
+	};
