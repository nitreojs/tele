+[[nodiscard]] QString StringProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = QString();
+	if (JS_IsString(value)) {
+		result = FromStd(ToStd(ctx, value));
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] bool BoolProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	const auto result = (JS_ToBool(ctx, value) > 0);
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] std::vector<int> IndexesProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::vector<int>();
+	auto length = std::int64_t();
+	if (JS_IsNumber(value)) {
+		auto index = 0;
+		JS_ToInt32(ctx, &index, value);
+		result.push_back(index);
+	} else if (JS_IsArray(value) && JS_GetLength(ctx, value, &length) >= 0) {
+		for (auto i = std::int64_t(); i != length; ++i) {
+			auto item = JS_GetPropertyUint32(ctx, value, std::uint32_t(i));
+			auto index = 0;
+			JS_ToInt32(ctx, &index, item);
+			JS_FreeValue(ctx, item);
+			result.push_back(index);
+		}
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
