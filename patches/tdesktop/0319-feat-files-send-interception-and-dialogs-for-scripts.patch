+JSValue Instance::NativeSend(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.interceptSendMessage(filter?, function)");
+	} else if (!instance->_permissions.any(Capability::InterceptSendMessage)) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.interceptSendMessage"_q,
+			GrantText(Capability::InterceptSendMessage, {}));
+	}
+	const auto id = NextRegistrationId();
+	instance->_registrations.emplace(id, Registration{
+		.kind = Kind::Send,
+		.fn = JS_DupValue(ctx, argv[0]),
+	});
+	return instance->disposer(id);
+}
+
+bool Instance::interceptsSends() const {
+	return _started
+		&& ranges::any_of(_registrations, [](const auto &pair) {
+			return pair.second.kind == Kind::Send;
+		});
+}
+
+void Instance::interceptSend(
+		SendData data,
+		Fn<void(std::optional<SendData>)> done) {
+	if (!_engine || !interceptsSends() || !data.peer) {
+		done(std::move(data));
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	const auto entities = Api::EntitiesToMTP(
+		_session,
+		TextUtilities::ConvertTextTagsToEntities(data.text.tags),
+		Api::ConvertOption::SkipLocal);
+	auto buffer = mtpBuffer();
+	entities.write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "Vector<MessageEntity>");
+	auto text = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, text, "text", NewString(ctx, data.text.text));
+	JS_SetPropertyStr(
+		ctx,
+		text,
+		"entities",
+		decoded.error.empty() ? decoded.value : JS_NewArray(ctx));
+	auto message = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, message, "text", text);
+	JS_SetPropertyStr(
+		ctx,
+		message,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(data.peer->id)));
+	JS_SetPropertyStr(ctx, message, "chat", peerInfo(data.peer));
+	JS_SetPropertyStr(
+		ctx,
+		message,
+		"replyTo",
+		data.replyTo ? JS_NewInt64(ctx, data.replyTo.bare) : JS_NULL);
+	JS_SetPropertyStr(ctx, message, "silent", JS_NewBool(ctx, data.silent));
+	JS_SetPropertyStr(
+		ctx,
+		message,
+		"scheduleDate",
+		data.scheduled ? JS_NewInt32(ctx, data.scheduled) : JS_NULL);
+	auto handlers = JS_NewArray(ctx);
+	auto count = std::uint32_t();
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::Send) {
+			JS_SetPropertyUint32(
+				ctx,
+				handlers,
+				count++,
+				JS_DupValue(ctx, registration.fn));
+		}
+	}
+	const auto key = ++_sendRunKey;
+	_sendRuns.emplace(key, SendRun{
+		.done = std::move(done),
+		.data = std::move(data),
+	});
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleRunSends");
+	JS_FreeValue(ctx, global);
+	auto report = JS_NewCFunctionMagic(
+		ctx,
+		UpdateFault,
+		"fault",
+		2,
+		JS_CFUNC_generic_magic,
+		0);
+	JSValueConst args[] = { message, handlers, report };
+	auto promise = invoke(runner, args, kListenerBudget, u"interceptSendMessage"_q);
+	for (const auto value : { runner, report, handlers, message }) {
+		JS_FreeValue(ctx, value);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishSend(key, std::nullopt);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, SendsSettled, key));
+	_engine->drain();
+	if (!_sendRuns.contains(key)) {
+		return;
+	}
+	base::call_delayed(kSendBudget, this, [=] {
+		if (_sendRuns.contains(key)) {
+			fault(
+				u"interceptSendMessage"_q,
+				u"took longer than 60 s, the message was not sent"_q);
+			finishSend(key, std::nullopt);
+		}
+	});
+}
+
+std::optional<SendData> Instance::readSend(
+		JSValueConst message,
+		SendData data) {
+	const auto ctx = _engine->ctx();
+	auto text = JS_GetPropertyStr(ctx, message, "text");
+	if (JS_IsString(text)) {
+		data.text = TextWithTags{ FromStd(ToStd(ctx, text)) };
+	} else if (JS_IsObject(text)) {
+		auto body = JS_GetPropertyStr(ctx, text, "text");
+		auto list = JS_GetPropertyStr(ctx, text, "entities");
+		const auto value = FromStd(ToStd(ctx, body));
+		auto tags = TextWithTags::Tags();
+		if (JS_IsArray(list)) {
+			auto encoded = EncodeTl(ctx, list, "Vector<MessageEntity>");
+			auto entities = MTPVector<MTPMessageEntity>();
+			auto from = reinterpret_cast<const mtpPrime*>(encoded.bytes.data());
+			const auto till = from + (encoded.bytes.size() / sizeof(mtpPrime));
+			if (!encoded.error.empty() || !entities.read(from, till)) {
+				JS_FreeValue(ctx, body);
+				JS_FreeValue(ctx, list);
+				JS_FreeValue(ctx, text);
+				fault(
+					u"interceptSendMessage"_q,
+					u"message.text.entities are wrong: "_q
+						+ FromStd(encoded.error));
+				return std::nullopt;
+			}
+			tags = TextUtilities::ConvertEntitiesToTextTags(
+				Api::EntitiesFromMTP(_session, entities.v));
+		}
+		data.text = TextWithTags{ value, std::move(tags) };
+		JS_FreeValue(ctx, body);
+		JS_FreeValue(ctx, list);
+	}
+	JS_FreeValue(ctx, text);
+	auto silent = JS_GetPropertyStr(ctx, message, "silent");
+	data.silent = JS_ToBool(ctx, silent);
+	JS_FreeValue(ctx, silent);
+	auto reply = JS_GetPropertyStr(ctx, message, "replyTo");
+	auto replyTo = 0;
+	data.replyTo = (JS_IsNumber(reply) && !JS_ToInt32(ctx, &replyTo, reply))
+		? MsgId(replyTo)
+		: MsgId();
+	JS_FreeValue(ctx, reply);
+	auto schedule = JS_GetPropertyStr(ctx, message, "scheduleDate");
+	auto scheduled = 0;
+	data.scheduled = (JS_IsNumber(schedule)
+		&& !JS_ToInt32(ctx, &scheduled, schedule))
+		? TimeId(scheduled)
+		: TimeId();
+	JS_FreeValue(ctx, schedule);
+	return data;
+}
+
+JSValue Instance::SendsSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	const auto i = instance->_sendRuns.find(key);
+	if (i == end(instance->_sendRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(
+			u"interceptSendMessage"_q,
+			instance->_engine->describe(value));
+		instance->finishSend(key, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto verdict = JS_GetPropertyStr(ctx, value, "verdict");
+	const auto send = (ToStd(ctx, verdict) == "send");
+	JS_FreeValue(ctx, verdict);
+	if (!send) {
+		instance->finishSend(key, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto message = JS_GetPropertyStr(ctx, value, "message");
+	auto result = instance->readSend(message, i->second.data);
+	JS_FreeValue(ctx, message);
+	instance->finishSend(key, std::move(result));
+	return JS_UNDEFINED;
+}
+
+void Instance::finishSend(int key, std::optional<SendData> result) {
+	const auto i = _sendRuns.find(key);
+	if (i == end(_sendRuns)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	_sendRuns.erase(i);
+	done(std::move(result));
+}
+
+JSValue Instance::NativeDownload(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (!instance->_permissions.allows(
+			Capability::AccountRead,
+			"messages")) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.downloadMedia"_q,
+			GrantText(Capability::AccountRead, "messages"));
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia needs a Message, a message media, a photo "
+			"or a document");
+	}
+	const auto session = instance->_session;
+	auto &owner = session->data();
+	auto type = JS_GetPropertyStr(ctx, argv[0], "_");
+	const auto name = ToStd(ctx, type);
+	JS_FreeValue(ctx, type);
+	const auto tl = name.starts_with("messageMedia")
+		? std::string_view("MessageMedia")
+		: (name == "photo")
+		? std::string_view("Photo")
+		: (name == "document")
+		? std::string_view("Document")
+		: std::string_view();
+	if (tl.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia: %s is not a photo or a document",
+			name.c_str());
+	}
+	auto encoded = EncodeTl(ctx, argv[0], tl);
+	if (!encoded.error.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia: %s",
+			encoded.error.c_str());
+	}
+	auto from = reinterpret_cast<const mtpPrime*>(encoded.bytes.data());
+	const auto till = from + (encoded.bytes.size() / sizeof(mtpPrime));
+	auto photo = (PhotoData*)nullptr;
+	auto document = (DocumentData*)nullptr;
+	if (tl == "MessageMedia") {
+		auto media = MTPMessageMedia();
+		if (media.read(from, till)) {
+			media.match([&](const MTPDmessageMediaPhoto &data) {
+				if (const auto value = data.vphoto()) {
+					photo = owner.processPhoto(*value);
+				}
+			}, [&](const MTPDmessageMediaDocument &data) {
+				if (const auto value = data.vdocument()) {
+					document = owner.processDocument(
+						*value,
+						data.valt_documents());
+				}
+			}, [](const auto &) {
+			});
+		}
+	} else if (tl == "Photo") {
+		auto value = MTPPhoto();
+		if (value.read(from, till)) {
+			photo = owner.processPhoto(value);
+		}
+	} else {
+		auto value = MTPDocument();
+		if (value.read(from, till)) {
+			document = owner.processDocument(value);
+		}
+	}
+	if (!photo && !document) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia: this media has no photo or document");
+	} else if (document && document->size > Storage::kMaxFileInMemory) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			u"tg.downloadMedia: the file is over 10 MB"_q);
+	}
+	auto origin = Data::FileOrigin();
+	const auto peer = (argc > 1)
+		? PeerFromValue(ctx, argv[1], session->userPeerId())
+		: std::nullopt;
+	auto msgId = 0;
+	if (argc > 2) {
+		JS_ToInt32(ctx, &msgId, argv[2]);
+	}
+	if (peer && msgId > 0) {
+		origin = Data::FileOriginMessage(FullMsgId(*peer, MsgId(msgId)));
+	}
+	auto created = instance->newPromise();
+	const auto key = created.first;
+	if (!key) {
+		return created.second;
+	}
+	auto &transfer = instance->_transfers[key];
+	const auto weak = base::make_weak(instance);
+	const auto finish = [=](QByteArray bytes, QString error) {
+		crl::on_main(weak, [=] {
+			if (const auto strong = weak.get()) {
+				strong->finishTransfer(key, bytes, error);
+			}
+		});
+	};
+	if (document) {
+		const auto media = document->createMediaView();
+		transfer.document = media;
+		const auto read = [=] {
+			auto bytes = media->bytes();
+			if (bytes.isEmpty()) {
+				auto file = QFile(document->filepath(true));
+				if (file.open(QIODevice::ReadOnly)) {
+					bytes = file.readAll();
+				}
+			}
+			return bytes;
+		};
+		if (!media->loaded(true)) {
+			document->save(origin, QString());
+		}
+		if (media->loaded(true)) {
+			finish(read(), QString());
+		} else if (!document->loading()) {
+			finish(QByteArray(), u"tele couldn't start the download"_q);
+		} else {
+			session->downloaderTaskFinished(
+			) | rpl::filter([=] {
+				return media->loaded(true) || !document->loading();
+			}) | rpl::take(1) | rpl::on_next([=] {
+				finish(
+					media->loaded(true) ? read() : QByteArray(),
+					u"the download failed"_q);
+			}, transfer.lifetime);
+		}
+	} else {
+		const auto media = photo->createMediaView();
+		transfer.photo = media;
+		const auto read = [=] {
+			return media->imageBytes(Data::PhotoSize::Large);
+		};
+		media->wanted(Data::PhotoSize::Large, origin);
+		if (media->loaded()) {
+			finish(read(), QString());
+		} else {
+			session->downloaderTaskFinished(
+			) | rpl::filter([=] {
+				return media->loaded()
+					|| photo->failed(Data::PhotoSize::Large);
+			}) | rpl::take(1) | rpl::on_next([=] {
+				finish(
+					media->loaded() ? read() : QByteArray(),
+					u"the download failed"_q);
+			}, transfer.lifetime);
+		}
+	}
+	base::call_delayed(kTransferTimeout, instance, [=] {
+		if (const auto strong = weak.get()) {
+			strong->finishTransfer(key, QByteArray(), u"timed out"_q);
+		}
+	});
+	return created.second;
+}
+
+JSValue Instance::NativeUpload(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (!instance->_permissions.allows(
+			Capability::AccountWrite,
+			"send")) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.uploadFile"_q,
+			GrantText(Capability::AccountWrite, "send"));
+	}
+	auto size = std::size_t();
+	const auto data = (argc > 0)
+		? JS_GetUint8Array(ctx, &size, argv[0])
+		: nullptr;
+	if (!data) {
+		return JS_ThrowTypeError(ctx, "tg.uploadFile needs a Uint8Array");
+	} else if (!size) {
+		return JS_ThrowTypeError(ctx, "tg.uploadFile: the file is empty");
+	} else if (size > std::size_t(Storage::kMaxFileInMemory)) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			u"tg.uploadFile: the file is over 10 MB"_q);
+	}
+	const auto name = (argc > 1 && JS_IsString(argv[1]))
+		? FromStd(ToStd(ctx, argv[1]))
+		: u"file"_q;
+	auto prepared = MakePreparedFile({
+		.id = base::RandomValue<uint64>(),
+		.type = SendMediaType::SecondaryFile,
+	});
+	prepared->filename = name;
+	prepared->filesize = int64(size);
+	prepared->setFileData(QByteArray(
+		reinterpret_cast<const char*>(data),
+		int(size)));
+	const auto session = instance->_session;
+	const auto id = FullMsgId(
+		session->userPeerId(),
+		session->data().nextLocalMessageId());
+	auto created = instance->newPromise();
+	const auto key = created.first;
+	if (!key) {
+		return created.second;
+	}
+	auto &transfer = instance->_transfers[key];
+	transfer.upload = id;
+	const auto weak = base::make_weak(instance);
+	auto &uploader = session->uploader();
+	uploader.secondaryFileReady(
+	) | rpl::filter([=](const Storage::UploadedMedia &media) {
+		return media.fullId == id;
+	}) | rpl::take(1) | rpl::on_next([=](const Storage::UploadedMedia &media) {
+		crl::on_main(weak, [=, file = media.info.file] {
+			if (const auto strong = weak.get()) {
+				strong->finishUpload(key, file);
+			}
+		});
+	}, transfer.lifetime);
+	uploader.secondaryFileFailed(
+	) | rpl::filter([=](const FullMsgId &failed) {
+		return failed == id;
+	}) | rpl::take(1) | rpl::on_next([=] {
+		crl::on_main(weak, [=] {
+			if (const auto strong = weak.get()) {
+				strong->finishTransfer(key, QByteArray(), u"the upload failed"_q);
+			}
+		});
+	}, transfer.lifetime);
+	uploader.upload(id, prepared);
+	base::call_delayed(kTransferTimeout, instance, [=] {
+		if (const auto strong = weak.get()) {
+			strong->finishTransfer(key, QByteArray(), u"timed out"_q);
+		}
+	});
+	return created.second;
+}
+
+void Instance::finishTransfer(int key, QByteArray bytes, QString error) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers) || !_engine) {
+		return;
+	}
+	const auto upload = i->second.upload;
+	_transfers.erase(i);
+	const auto ctx = _engine->ctx();
+	if (!bytes.isEmpty()) {
+		settle(key, true, JS_NewUint8ArrayCopy(
+			ctx,
+			reinterpret_cast<const uint8_t*>(bytes.constData()),
+			bytes.size()));
+		return;
+	} else if (upload) {
+		_session->uploader().cancel(upload);
+	}
+	const auto timedOut = (error == u"timed out"_q);
+	settle(key, false, MakeTeleError(
+		ctx,
+		timedOut ? "timed-out" : "network",
+		(upload ? u"tg.uploadFile: "_q : u"tg.downloadMedia: "_q)
+			+ (error.isEmpty() ? u"the file came back empty"_q : error)));
+}
+
+void Instance::finishUpload(int key, const MTPInputFile &file) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers) || !_engine) {
+		return;
+	}
+	_transfers.erase(i);
+	auto buffer = mtpBuffer();
+	file.write(buffer);
+	auto decoded = DecodeTl(_engine->ctx(), Bytes(buffer), "InputFile");
+	if (!decoded.error.empty()) {
+		settle(key, false, rpcError(0, FromStd(decoded.error)));
+		return;
+	}
+	settle(key, true, decoded.value);
+}
