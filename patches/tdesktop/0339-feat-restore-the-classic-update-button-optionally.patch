 	const auto controller = builder.controller();
 	const auto button = AddButton(builder, {
 		.id = u"tele-check-updates"_q,
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index cfe6a287fa79a6d73a83a30521b07dbf4511d2d4..b44e18f12d8583b4433e69ab771031e93c0ab360 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -20,6 +20,7 @@ const char kOptionGhostChats[] = "tele-ghost-chats";
 const char kOptionButtonPayloads[] = "tele-button-payloads";
 const char kOptionCopyButtonData[] = "tele-copy-button-data";
 const char kOptionAutoUpdate[] = "tele-auto-update";
+const char kOptionClassicUpdateButton[] = "tele-classic-update-button";
 const char kOptionShowChangelog[] = "tele-show-changelog";
 const char kOptionChangelogShown[] = "tele-changelog-shown";
 const char kOptionChangelogAccounts[] = "tele-changelog-accounts";
@@ -373,6 +374,12 @@ base::options::toggle AutoUpdateOption({
 	.defaultValue = true,
 });
 
+base::options::toggle ClassicUpdateButtonOption({
+	.id = kOptionClassicUpdateButton,
+	.name = "Classic update button",
+	.description = "Use the full gradient background in dark themes.",
+});
+
 base::options::toggle ShowChangelogOption({
 	.id = kOptionShowChangelog,
 	.name = "Show what's new after updates",
@@ -2062,6 +2069,20 @@ rpl::producer<bool> AutoUpdateValue() {
 	});
 }
 
+bool ClassicUpdateButton() {
+	return ClassicUpdateButtonOption.value();
+}
+
+rpl::producer<bool> ClassicUpdateButtonValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		ClassicUpdateButtonOption.changes()
+	) | rpl::map([] {
+		return ClassicUpdateButtonOption.value();
+	});
+}
+
 bool ShowChangelog() {
 	return ShowChangelogOption.value();
 }
