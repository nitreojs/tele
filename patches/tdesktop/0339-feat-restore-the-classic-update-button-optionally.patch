+++ b/Telegram/SourceFiles/dialogs/ui/dialogs_bottom_button.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "dialogs/ui/dialogs_bottom_button.h"
 
+#include "tele/tele_options.h"
 #include "ui/color_contrast.h"
 #include "ui/effects/radial_animation.h"
 #include "ui/painter.h"
@@ -89,13 +90,16 @@ BottomButton::BottomButton(
 	resize(st::columnMinimalWidthLeft, _st.height);
 
 	if (_hasTextIcon) {
-		rpl::single(rpl::empty_value()) | rpl::then(
+		rpl::merge(
+			Tele::ClassicUpdateButtonValue() | rpl::to_empty,
 			style::PaletteChanged()
 		) | rpl::on_next([this] {
-			_quiet = !Ui::IsLightBackground(st::dialogsBg->c);
+			_quiet = !Tele::ClassicUpdateButton()
+				&& !Ui::IsLightBackground(st::dialogsBg->c);
 			_textIcon = _quiet
 				? style::colorizeImage(UpdateIcon(), st::groupCallLive1)
 				: UpdateIcon();
+			update();
 		}, lifetime());
 	}
 }
