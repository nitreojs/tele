 void AddUpdates(SectionBuilder &builder) {
 	AddOptionToggle(builder, ::Tele::kOptionAutoUpdate);
 	AddOptionToggle(builder, ::Tele::kOptionShowChangelog);
+	AddOptionToggle(builder, ::Tele::kOptionClassicUpdateButton);
+	if (!Picked) {
+		builder.add([](const WidgetContext &ctx) {
+			auto preview = object_ptr<Ui::VerticalLayout>(ctx.container);
+			preview->setAttribute(Qt::WA_TransparentForMouseEvents);
+			preview->add(
+				object_ptr<Ui::FlatLabel>(
+					preview,
+					::Tele::Lower(u"Preview"_q),
+					st::settingsExperimentalAbout),
+				QMargins(0, 0, 0, st::settingsExperimentalAboutPadding.bottom()));
+			const auto button = preview->add(
+				object_ptr<Dialogs::BottomButton>(
+					preview,
+					tr::lng_update_telegram(tr::now),
+					st::dialogsUpdateButton,
+					st::dialogsInstallUpdate,
+					st::dialogsInstallUpdateOver,
+					true));
+			button->setFocusPolicy(Qt::NoFocus);
+			button->setCursor(Qt::ArrowCursor);
+			return SectionBuilder::WidgetToAdd{
+				.widget = std::move(preview),
+				.margin = QMargins(
+					st::settingsButtonNoIcon.padding.left(),
+					0,
+					st::settingsButtonNoIcon.padding.left(),
+					st::settingsExperimentalAboutPadding.bottom()),
+				.align = style::al_justify,
+			};
+		}, nullptr);
+	}
 	const auto controller = builder.controller();
 	const auto button = AddButton(builder, {
 		.id = u"tele-check-updates"_q,
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
