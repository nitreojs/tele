diff --git a/Telegram/SourceFiles/dialogs/ui/dialogs_bottom_button.cpp b/Telegram/SourceFiles/dialogs/ui/dialogs_bottom_button.cpp
index cc07c054f045bb51add5b7ab9d912a397e01a598..fac5b4520ee326d2057b9da782119136567847df 100644
