-[[nodiscard]] rpl::producer<int> PeerDcValue(not_null<PeerData*> peer) {
-	return peer->session().changes().peerFlagsValue(
-		peer,
-		Data::PeerUpdate::Flag::Photo
-	) | rpl::map([=](const Data::PeerUpdate &) {
-		return PeerDc(peer);
-	}) | rpl::distinct_until_changed();
+[[nodiscard]] PeerDcInfo ComputePeerDc(
+		not_null<PeerData*> peer,
+		const std::optional<PhotoHistory> &history) {
+	const auto current = PeerDc(peer);
+	if (!current || !history) {
+		return { .dc = current };
+	}
+	if (!history->oldest) {
+		return { .dc = current, .uncertain = true };
+	}
+	return {
+		.dc = history->oldest,
+		.uncertain = !history->complete
+			|| (history->dcs.size() > 1)
+			|| (current != history->oldest),
+	};
+}
+
+[[nodiscard]] rpl::producer<PeerDcInfo> PeerDcValue(
+		not_null<PeerData*> peer) {
+	using History = std::optional<PhotoHistory>;
+	return ShowDcValue(
+	) | rpl::map([=](bool shown) -> rpl::producer<PeerDcInfo> {
+		if (!shown) {
+			return rpl::single(PeerDcInfo());
+		}
+		const auto photo = [=] {
+			return peer->session().changes().peerFlagsValue(
+				peer,
+				Data::PeerUpdate::Flag::Photo
+			) | rpl::to_empty;
+		};
+		return rpl::combine(
+			photo(),
+			photo() | rpl::map([=] {
+				return !peer->isUser() && PeerDc(peer);
+			}) | rpl::distinct_until_changed(
+			) | rpl::map([=](bool load) -> rpl::producer<History> {
+				return load
+					? PhotoHistoryValue(peer)
+					: rpl::single(History());
+			}) | rpl::flatten_latest()
+		) | rpl::map([=](rpl::empty_value, const History &history) {
+			return ComputePeerDc(peer, history);
+		});
+	}) | rpl::flatten_latest() | rpl::distinct_until_changed();
+}
+
+[[nodiscard]] QString UncertainText() {
+	return Lower(u"uncertain"_q);
 }
 
