+[[nodiscard]] int PhotoDc(not_null<PhotoData*> photo) {
+	for (const auto size : {
+		Data::PhotoSize::Large,
+		Data::PhotoSize::Thumbnail,
+		Data::PhotoSize::Small,
+	}) {
+		const auto &data = photo->location(size).file().data;
+		if (const auto file = std::get_if<StorageFileLocation>(&data)) {
+			if (const auto dc = file->dcId()) {
+				return dc;
+			}
+		}
+	}
+	return 0;
+}
+
+[[nodiscard]] PhotoHistory ParsePhotoHistory(
+		not_null<PeerData*> peer,
+		const SparseIdsMergedSlice &slice) {
+	auto result = PhotoHistory{ .complete = (slice.skippedAfter() == 0) };
+	for (auto i = 0, count = slice.size(); i != count; ++i) {
+		const auto item = peer->owner().message(slice[i]);
+		const auto media = item ? item->media() : nullptr;
+		const auto photo = media ? media->photo() : nullptr;
+		if (const auto dc = photo ? PhotoDc(photo) : 0) {
+			if (!result.oldest) {
+				result.oldest = dc;
+			}
+			result.dcs.emplace(dc);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] rpl::producer<std::optional<PhotoHistory>> PhotoHistoryValue(
+		not_null<PeerData*> peer) {
+	const auto migrated = peer->migrateFrom();
+	const auto migratedPeerId = migrated ? migrated->id : PeerId();
+	return SharedMediaMergedViewer(
+		&peer->session(),
+		SharedMediaMergedKey(
+			SparseIdsMergedSlice::Key(
+				peer->id,
+				MsgId(),
+				PeerId(),
+				migratedPeerId,
+				(migrated ? (MsgId(1) - ServerMaxMsgId) : MsgId(1))),
+			Storage::SharedMediaType::ChatPhoto),
+		0,
+		kPhotoHistoryLimit
+	) | rpl::map([=](
+			SparseIdsMergedSlice &&slice) -> std::optional<PhotoHistory> {
+		if (!slice.fullCount()) {
+			return std::nullopt;
+		}
+		return ParsePhotoHistory(peer, slice);
+	});
+}
