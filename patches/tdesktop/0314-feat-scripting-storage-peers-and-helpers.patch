+#include "tele/scripting/tele_script_storage.h"
+
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/serialize_common.h"
+#include "storage/storage_account.h"
+
+#include <QtCore/QFileInfo>
+
+namespace Tele::Scripting {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E5C22);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxScripts = quint32(4096);
+constexpr auto kMaxValues = quint32(1024 * 1024);
+constexpr auto kSaveDelay = crl::time(1000);
+
+} // namespace
+
+ScriptStorage::ScriptStorage(Fn<void()> changed)
+: _changed(std::move(changed)) {
+}
+
+const QByteArray *ScriptStorage::find(const QString &key) const {
+	const auto i = _values.find(key);
+	return (i != end(_values)) ? &i->second : nullptr;
+}
+
+bool ScriptStorage::set(const QString &key, QByteArray value) {
+	const auto old = find(key);
+	const auto size = _size
+		- (old ? SizeOf(key, *old) : 0)
+		+ SizeOf(key, value);
+	if (size > kStorageQuota) {
+		return false;
+	} else if (old && *old == value) {
+		return true;
+	}
+	_values[key] = std::move(value);
+	_size = size;
+	_changed();
+	return true;
+}
+
+bool ScriptStorage::remove(const QString &key) {
+	const auto i = _values.find(key);
+	if (i == end(_values)) {
+		return false;
+	}
+	_size -= SizeOf(i->first, i->second);
+	_values.erase(i);
+	_changed();
+	return true;
+}
+
+void ScriptStorage::clear() {
+	if (_values.empty()) {
+		return;
+	}
+	_values.clear();
+	_size = 0;
+	_changed();
+}
+
+QStringList ScriptStorage::keys() const {
+	auto result = QStringList();
+	result.reserve(int(_values.size()));
+	for (const auto &[key, value] : _values) {
+		result.push_back(key);
+	}
+	return result;
+}
+
+const std::map<QString, QByteArray> &ScriptStorage::values() const {
+	return _values;
+}
+
+void ScriptStorage::load(std::map<QString, QByteArray> values) {
+	_values = std::move(values);
+	_size = 0;
+	for (const auto &[key, value] : _values) {
+		_size += SizeOf(key, value);
+	}
+}
+
+qint64 ScriptStorage::SizeOf(const QString &key, const QByteArray &value) {
+	return qint64(key.toUtf8().size()) + value.size();
+}
+
+StorageStore::StorageStore(not_null<Main::Session*> session)
+: _session(session)
+, _saveTimer([=] { write(); }) {
+	read();
+}
+
+StorageStore::~StorageStore() {
+	if (_dirty) {
+		write();
+	}
+}
+
+not_null<ScriptStorage*> StorageStore::storage(const QString &id) {
+	auto i = _scripts.find(id);
+	if (i == end(_scripts)) {
+		i = _scripts.emplace(
+			std::piecewise_construct,
+			std::forward_as_tuple(id),
+			std::forward_as_tuple([=] {
+				_dirty = true;
+				_saveTimer.callOnce(kSaveDelay);
+			})).first;
+	}
+	return &i->second;
+}
+
+QString StorageStore::directory() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void StorageStore::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(
+			file,
+			u"tele_script_storage"_q,
+			directory(),
+			key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxScripts) {
+		return;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = QString();
+		auto values = quint32();
+		file.stream >> id >> values;
+		if (file.stream.status() != QDataStream::Ok || values > kMaxValues) {
+			return;
+		}
+		auto map = std::map<QString, QByteArray>();
+		for (auto j = quint32(); j != values; ++j) {
+			auto name = QString();
+			auto value = QByteArray();
+			file.stream >> name >> value;
+			if (file.stream.status() != QDataStream::Ok) {
+				return;
+			}
+			map.emplace(std::move(name), std::move(value));
+		}
+		storage(id)->load(std::move(map));
+	}
+}
+
+void StorageStore::write() {
+	_dirty = false;
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	auto count = quint32();
+	for (const auto &[id, storage] : _scripts) {
+		if (storage.values().empty()) {
+			continue;
+		}
+		++count;
+		size += Serialize::stringSize(id) + sizeof(quint32);
+		for (const auto &[name, value] : storage.values()) {
+			size += Serialize::stringSize(name)
+				+ Serialize::bytearraySize(value);
+		}
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< count;
+	for (const auto &[id, storage] : _scripts) {
+		if (storage.values().empty()) {
+			continue;
+		}
+		data.stream << id << quint32(storage.values().size());
+		for (const auto &[name, value] : storage.values()) {
+			data.stream << name << value;
+		}
+	}
+	auto file = FileWriteDescriptor(u"tele_script_storage"_q, directory());
+	file.writeEncrypted(data, key);
+}
