+JSValue Instance::TgUi(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto what = (magic == kUiToast)
+		? "tg.toast"
+		: (magic == kUiNotify)
+		? "tg.notify"
+		: "tg.open";
+	const auto instance = Permitted(ctx, Capability::Ui, what);
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto argument = [&](int index) {
+		return (argc > index && !JS_IsUndefined(argv[index]))
+			? FromStd(ToStd(ctx, argv[index]))
+			: QString();
+	};
+	const auto session = instance->_session;
+	switch (magic) {
+	case kUiToast: {
+		const auto text = argument(0);
+		const auto now = crl::now();
+		auto &toasts = instance->_toasts;
+		while (!toasts.empty() && now - toasts.front() > kToastWindow) {
+			toasts.pop_front();
+		}
+		if (toasts.size() >= kToastLimit) {
+			instance->log(
+				LogLevel::Warning,
+				u"tg.toast: more than 3 toasts in 5 s, skipped one"_q);
+			return JS_UNDEFINED;
+		}
+		toasts.push_back(now);
+		crl::on_main(session, [=] {
+			if (const auto window = session->tryResolveWindow()) {
+				window->showToast(text);
+			}
+		});
+	} break;
+	case kUiNotify: {
+		const auto title = argument(0);
+		const auto text = argument(1);
+		crl::on_main(session, [=] {
+			ShowTeleNotification({
+				.user = session->user(),
+				.title = title,
+				.text = text,
+				.fallback = title.isEmpty()
+					? text
+					: (title + u": "_q + text),
+				.id = kScriptNotificationId,
+			});
+		});
+	} break;
+	case kUiOpen: {
+		const auto link = argument(0).trimmed();
+		if (link.isEmpty()) {
+			return JS_ThrowTypeError(ctx, "tg.open needs a link");
+		}
+		crl::on_main(session, [=] {
+			const auto window = session->tryResolveWindow();
+			UrlClickHandler::Open(link, QVariant::fromValue(ClickHandlerContext{
+				.sessionWindow = window
+					? base::make_weak(window)
+					: base::weak_ptr<Window::SessionController>(),
+			}));
+		});
+	} break;
+	}
+	return JS_UNDEFINED;
+}
