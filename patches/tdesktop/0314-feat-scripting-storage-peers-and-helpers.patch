+std::pair<int, JSValue> Instance::newPromise() {
+	const auto ctx = _engine->ctx();
+	JSValue functions[2];
+	auto promise = JS_NewPromiseCapability(ctx, functions);
+	if (JS_IsException(promise)) {
+		return { 0, promise };
+	}
+	const auto key = ++_callKey;
+	_calls.emplace(key, Call{
+		.resolve = functions[0],
+		.reject = functions[1],
+	});
+	return { key, promise };
+}
+
+JSValue Instance::peerInfo(not_null<PeerData*> peer) {
+	const auto ctx = _engine->ctx();
+	auto result = JS_NewObject(ctx);
+	const auto id = peer->id;
+	const auto marked = peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+	JS_SetPropertyStr(ctx, result, "id", JS_NewBigInt64(ctx, marked));
+	const auto kind = peer->isUser()
+		? (peer->asUser()->isBot() ? "bot" : "user")
+		: peer->isChat()
+		? "chat"
+		: (peer->isMegagroup() || peer->isGigagroup())
+		? "supergroup"
+		: "channel";
+	JS_SetPropertyStr(ctx, result, "kind", JS_NewString(ctx, kind));
+	JS_SetPropertyStr(ctx, result, "name", NewString(ctx, peer->name()));
+	if (const auto username = peer->username(); !username.isEmpty()) {
+		JS_SetPropertyStr(ctx, result, "username", NewString(ctx, username));
+	}
+	auto buffer = mtpBuffer();
+	peer->input().write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "InputPeer");
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"input",
+		decoded.error.empty() ? decoded.value : JS_UNDEFINED);
+	return result;
+}
