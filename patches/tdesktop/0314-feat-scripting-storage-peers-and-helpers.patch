+JSValue Instance::Fetch(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsString(argv[0])) {
+		return JS_ThrowTypeError(ctx, "fetch needs a url string");
+	}
+	const auto url = QUrl(FromStd(ToStd(ctx, argv[0])));
+	const auto scheme = url.scheme().toLower();
+	if (!url.isValid()
+		|| (scheme != u"http"_q && scheme != u"https"_q)
+		|| url.host().isEmpty()) {
+		return JS_ThrowTypeError(ctx, "fetch only takes http and https urls");
+	}
+	const auto host = url.host().toLower().toStdString();
+	if (!instance->_permissions.allows(Capability::Network, host)) {
+		return JS_ThrowTypeError(
+			ctx,
+			"fetch(%s) needs the permission 'network:%s'",
+			host.c_str(),
+			host.c_str());
+	}
+	auto method = QByteArray("GET");
+	auto headers = std::vector<std::pair<QByteArray, QByteArray>>();
+	auto body = QByteArray();
+	if (argc > 1 && JS_IsObject(argv[1])) {
+		const auto init = argv[1];
+		auto value = JS_GetPropertyStr(ctx, init, "method");
+		if (JS_IsString(value)) {
+			method = QByteArray::fromStdString(ToStd(ctx, value)).toUpper();
+		}
+		JS_FreeValue(ctx, value);
+		value = JS_GetPropertyStr(ctx, init, "headers");
+		if (JS_IsObject(value)) {
+			JSPropertyEnum *properties = nullptr;
+			auto count = std::uint32_t();
+			if (!JS_GetOwnPropertyNames(
+					ctx,
+					&properties,
+					&count,
+					value,
+					JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY)) {
+				for (auto i = std::uint32_t(); i != count; ++i) {
+					const auto name = JS_AtomToCString(
+						ctx,
+						properties[i].atom);
+					auto item = JS_GetProperty(ctx, value, properties[i].atom);
+					if (name) {
+						headers.emplace_back(
+							QByteArray(name),
+							QByteArray::fromStdString(ToStd(ctx, item)));
+						JS_FreeCString(ctx, name);
+					}
+					JS_FreeValue(ctx, item);
+				}
+				JS_FreePropertyEnum(ctx, properties, count);
+			}
+		}
+		JS_FreeValue(ctx, value);
+		value = JS_GetPropertyStr(ctx, init, "body");
+		if (JS_IsString(value)) {
+			body = QByteArray::fromStdString(ToStd(ctx, value));
+		} else if (JS_GetTypedArrayType(value) == JS_TYPED_ARRAY_UINT8) {
+			auto size = std::size_t();
+			const auto data = JS_GetUint8Array(ctx, &size, value);
+			body = QByteArray(reinterpret_cast<const char*>(data), int(size));
+		} else if (!JS_IsUndefined(value) && !JS_IsNull(value)) {
+			JS_FreeValue(ctx, value);
+			return JS_ThrowTypeError(
+				ctx,
+				"fetch: body must be a string or a Uint8Array");
+		}
+		JS_FreeValue(ctx, value);
+	}
+	return instance->fetch(url, method, std::move(headers), body);
+}
+
+JSValue Instance::fetch(
+		QUrl url,
+		QByteArray method,
+		std::vector<std::pair<QByteArray, QByteArray>> headers,
+		QByteArray body) {
+	if (!_network) {
+		_network = std::make_unique<QNetworkAccessManager>();
+	}
+	auto request = QNetworkRequest(url);
+	for (const auto &[name, value] : headers) {
+		request.setRawHeader(name, value);
+	}
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::SameOriginRedirectPolicy);
+	request.setTransferTimeout(kFetchTimeout);
+	auto created = newPromise();
+	const auto key = created.first;
+	const auto promise = created.second;
+	if (!key) {
+		return promise;
+	}
+	const auto reply = _network->sendCustomRequest(request, method, body);
+	const auto large = std::make_shared<bool>(false);
+	QObject::connect(reply, &QNetworkReply::downloadProgress, reply, [=](
+			qint64 received,
+			qint64 total) {
+		if (received > kFetchLimit && !*large) {
+			*large = true;
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, _network.get(), [=] {
+		reply->deleteLater();
+		if (!_engine) {
+			return;
+		}
+		const auto ctx = _engine->ctx();
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (*large) {
+			settle(key, false, MakeTypeError(
+				ctx,
+				u"fetch: the response is over 16 MB"_q));
+			return;
+		} else if (!status) {
+			settle(key, false, MakeTypeError(
+				ctx,
+				u"fetch failed: "_q + reply->errorString()));
+			return;
+		}
+		const auto data = reply->readAll();
+		auto fields = JS_NewObject(ctx);
+		for (const auto &[name, value] : reply->rawHeaderPairs()) {
+			const auto lower = name.toLower();
+			auto previous = JS_GetPropertyStr(ctx, fields, lower.constData());
+			const auto joined = JS_IsString(previous)
+				? (QByteArray::fromStdString(ToStd(ctx, previous)) + ", " + value)
+				: value;
+			JS_FreeValue(ctx, previous);
+			JS_SetPropertyStr(
+				ctx,
+				fields,
+				lower.constData(),
+				JS_NewStringLen(ctx, joined.constData(), joined.size()));
+		}
+		JSValue args[] = {
+			JS_NewInt32(ctx, status),
+			NewString(ctx, reply->attribute(
+				QNetworkRequest::HttpReasonPhraseAttribute).toString()),
+			NewString(ctx, reply->url().toString()),
