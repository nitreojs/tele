+JSValue Instance::TgFormat(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsString(argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.format needs a string");
+	}
+	const auto text = FromStd(ToStd(ctx, argv[0]));
+	const auto tagged = magic
+		? TextUtilities::TextWithTagsFromHtml(text).value_or(
+			TextWithTags{ text, {} })
+		: ApplyMarkdown(text);
+	const auto entities = Api::EntitiesToMTP(
+		instance->_session,
+		TextUtilities::ConvertTextTagsToEntities(tagged.tags),
+		Api::ConvertOption::SkipLocal);
+	auto buffer = mtpBuffer();
+	entities.write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "Vector<MessageEntity>");
+	if (!decoded.error.empty()) {
+		return JS_ThrowInternalError(
+			ctx,
+			"tg.format: %s",
+			decoded.error.c_str());
+	}
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "message", NewString(ctx, tagged.text));
+	JS_SetPropertyStr(ctx, result, "entities", decoded.value);
+	return result;
+}
