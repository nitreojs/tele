+
+Walker::Walker(std::string_view data, const ObjectFound &found)
+: _data(data)
+, _found(found) {
+}
+
+bool Walker::has(std::size_t count) const {
+	return (_data.size() - _offset) >= count;
+}
+
+std::uint32_t Walker::get32() {
+	auto result = std::uint32_t();
+	for (auto i = 0; i != 4; ++i) {
+		result |= std::uint32_t(
+			static_cast<unsigned char>(_data[_offset + i])) << (8 * i);
+	}
+	_offset += 4;
+	return result;
+}
+
+bool Walker::skip(std::size_t count) {
+	if (!has(count)) {
+		return false;
+	}
+	_offset += count;
+	return true;
+}
+
+bool Walker::bytes() {
+	if (!has(4)) {
+		return false;
