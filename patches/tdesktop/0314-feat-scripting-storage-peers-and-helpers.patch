+void FeedPeers(
+		not_null<Main::Session*> session,
+		const QByteArray &bytes,
+		std::string_view type) {
+	auto users = QVector<MTPUser>();
+	auto chats = QVector<MTPChat>();
+	ForEachObject(
+		std::string_view(bytes.constData(), bytes.size()),
+		type,
+		[&](std::string_view kind, std::string_view span) {
+			auto from = reinterpret_cast<const mtpPrime*>(span.data());
+			const auto end = from + (span.size() / sizeof(mtpPrime));
+			if (kind == "User") {
+				auto user = MTPUser();
+				if (user.read(from, end)) {
+					users.push_back(user);
+				}
+			} else {
+				auto chat = MTPChat();
+				if (chat.read(from, end)) {
+					chats.push_back(chat);
+				}
+			}
+		});
+	if (!users.isEmpty()) {
+		session->data().processUsers(MTP_vector<MTPUser>(std::move(users)));
+	}
+	if (!chats.isEmpty()) {
+		session->data().processChats(MTP_vector<MTPChat>(std::move(chats)));
+	}
+}
+
+[[nodiscard]] Instance *Permitted(
+		JSContext *ctx,
+		Capability capability,
+		const char *what) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		JS_ThrowInternalError(ctx, "the script was stopped");
+		return nullptr;
+	} else if (!instance->permissions().allows(
+			capability,
+			std::string_view())) {
+		JS_ThrowTypeError(
+			ctx,
+			"%s needs the permission '%s'",
+			what,
+			CapabilityName(capability));
+		return nullptr;
+	}
+	return instance;
+}
