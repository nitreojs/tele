+JSValue Instance::TgStorage(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto storage = instance->_storage;
+	if (magic == kStorageKeys) {
+		auto result = JS_NewArray(ctx);
+		auto index = std::uint32_t();
+		for (const auto &key : storage->keys()) {
+			JS_SetPropertyUint32(ctx, result, index++, NewString(ctx, key));
+		}
+		return result;
+	} else if (magic == kStorageClear) {
+		storage->clear();
+		return JS_UNDEFINED;
+	}
+	const auto key = (argc > 0 && JS_IsString(argv[0]))
+		? FromStd(ToStd(ctx, argv[0]))
+		: QString();
+	if (key.isEmpty() || key.size() > kMaxKeyLength) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.storage keys are strings of 1 to %d characters",
+			kMaxKeyLength);
+	}
+	switch (magic) {
+	case kStorageGet: {
+		const auto value = storage->find(key);
+		if (!value) {
+			return JS_UNDEFINED;
+		}
+		auto text = JS_NewStringLen(ctx, value->constData(), value->size());
+		JSValueConst args[] = { text };
+		auto result = CallGlobal(ctx, "__teleLoad", args);
+		JS_FreeValue(ctx, text);
+		return result;
+	}
+	case kStorageHas:
+		return JS_NewBool(ctx, storage->find(key) != nullptr);
+	case kStorageDelete:
+		return JS_NewBool(ctx, storage->remove(key));
+	case kStorageSet: {
+		if (argc < 2 || JS_IsUndefined(argv[1])) {
+			storage->remove(key);
+			return JS_UNDEFINED;
+		}
+		JSValueConst args[] = { argv[1] };
+		auto text = CallGlobal(ctx, "__teleStore", args);
+		if (JS_IsException(text)) {
+			return text;
+		}
+		auto size = std::size_t();
+		const auto data = JS_ToCStringLen(ctx, &size, text);
+		auto bytes = data ? QByteArray(data, int(size)) : QByteArray();
+		if (data) {
+			JS_FreeCString(ctx, data);
+		}
+		JS_FreeValue(ctx, text);
+		if (!storage->set(key, std::move(bytes))) {
+			return JS_ThrowRangeError(
+				ctx,
+				"tg.storage is over its 1 MB quota");
+		}
+		return JS_UNDEFINED;
+	}
+	}
+	return JS_UNDEFINED;
+}
