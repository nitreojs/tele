+		global,
+		"__teleUtf8Decode",
+		JS_NewCFunction(_ctx, Utf8Decode, "__teleUtf8Decode", 2));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"__teleRandomFill",
+		JS_NewCFunction(_ctx, RandomFill, "__teleRandomFill", 1));
 	JS_FreeValue(_ctx, global);
