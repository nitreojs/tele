+JSValue Instance::TgPeersGet(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(ctx, Capability::Peers, "tg.peers.get");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->_session;
+	const auto id = (argc > 0)
+		? PeerFromValue(ctx, argv[0], session->user()->id)
+		: std::nullopt;
+	if (!id) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.peers.get needs a peer, an input peer or a marked id");
+	}
+	const auto peer = session->data().peerLoaded(*id);
+	return peer ? instance->peerInfo(peer) : JS_UNDEFINED;
+}
