+JSValue Instance::TgPeersResolve(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Peers,
+		"tg.peers.resolve");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto username = (argc > 0 && JS_IsString(argv[0]))
+		? FromStd(ToStd(ctx, argv[0])).trimmed()
+		: QString();
+	if (username.startsWith('@')) {
+		username = username.mid(1);
+	}
+	if (username.isEmpty()) {
+		return JS_ThrowTypeError(ctx, "tg.peers.resolve needs a username");
+	}
+	return instance->resolve(username);
+}
+
+JSValue Instance::resolve(QString username) {
+	const auto ctx = _engine->ctx();
+	if (const auto peer = _session->data().peerByUsername(username)) {
+		JSValue functions[2];
+		auto promise = JS_NewPromiseCapability(ctx, functions);
+		auto value = peerInfo(peer);
+		JS_FreeValue(ctx, JS_Call(ctx, functions[0], JS_UNDEFINED, 1, &value));
+		JS_FreeValue(ctx, value);
+		JS_FreeValue(ctx, functions[0]);
+		JS_FreeValue(ctx, functions[1]);
+		return promise;
+	}
+	auto created = newPromise();
+	const auto key = created.first;
+	const auto promise = created.second;
+	if (key) {
+		resolveRemote(key, username);
+	}
+	return promise;
+}
+
+void Instance::resolveRemote(int key, QString username) {
+	const auto scope = SendingFromScript();
+	_api.request(MTPcontacts_ResolveUsername(
+		MTP_flags(0),
+		MTP_string(username),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		if (!_engine) {
+			return;
+		}
+		const auto &data = result.data();
+		_session->data().processUsers(data.vusers());
+		_session->data().processChats(data.vchats());
+		const auto peer = _session->data().peerLoaded(
+			peerFromMTP(data.vpeer()));
+		settle(key, true, peer ? peerInfo(peer) : JS_UNDEFINED);
+	}).fail([=](const MTP::Error &error) {
+		if (!_engine) {
+			return;
+		}
+		const auto type = error.type();
+		const auto wait = FloodWaitSeconds(type);
+		if (wait > 0 && wait <= kFloodSleep) {
+			base::call_delayed(wait * crl::time(1000) + 10, this, [=] {
+				if (_engine && _calls.contains(key)) {
+					resolveRemote(key, username);
+				}
+			});
+		} else if (type == u"USERNAME_NOT_OCCUPIED"_q
+			|| type == u"USERNAME_INVALID"_q) {
+			settle(key, true, JS_UNDEFINED);
+		} else {
+			settle(key, false, rpcError(error.code(), type));
+		}
+	}).handleFloodErrors().send();
+}
