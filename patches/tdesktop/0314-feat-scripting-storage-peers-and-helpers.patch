 	Object.defineProperty(globalThis, '__teleFormat', {
 		value: (...args) => args.map((arg) => format(arg, 0)).join(' '),
 	});
+
+	const marker = '\u0000';
+	const encode = (value, seen) => {
+		switch (typeof value) {
+		case 'string':
+		case 'boolean':
+			return value;
+		case 'number':
+			if (!Number.isFinite(value)) {
+				throw new TypeError('tg.storage keeps only finite numbers');
+			}
+			return value;
+		case 'bigint':
+			return { [marker + 'n']: value.toString() };
+		case 'object':
+			break;
+		default:
+			throw new TypeError("tg.storage can't keep a " + typeof value);
+		}
+		if (value === null) {
+			return null;
+		} else if (value instanceof Uint8Array) {
+			return { [marker + 'b']: value.toBase64() };
+		} else if (seen.has(value)) {
+			throw new TypeError("tg.storage can't keep cycles");
+		}
+		seen.add(value);
+		try {
+			if (Array.isArray(value)) {
+				return value.map((item) => (item === undefined)
+					? null
+					: encode(item, seen));
+			}
+			const proto = Object.getPrototypeOf(value);
+			if (proto !== Object.prototype && proto !== null) {
+				throw new TypeError('tg.storage keeps only plain objects, not '
+					+ (value.constructor?.name ?? 'this one'));
+			}
+			const result = {};
+			for (const [key, item] of Object.entries(value)) {
+				if (item !== undefined) {
+					result[key.startsWith(marker) ? (marker + key) : key]
+						= encode(item, seen);
+				}
+			}
+			return result;
+		} finally {
+			seen.delete(value);
+		}
+	};
+	const decode = (value) => {
+		if (Array.isArray(value)) {
+			return value.map(decode);
+		} else if (value === null || typeof value !== 'object') {
+			return value;
+		}
+		const keys = Object.keys(value);
+		if (keys.length === 1 && keys[0] === marker + 'n') {
+			return BigInt(value[keys[0]]);
+		} else if (keys.length === 1 && keys[0] === marker + 'b') {
+			return Uint8Array.fromBase64(value[keys[0]]);
+		}
+		const result = {};
+		for (const key of keys) {
+			result[key.startsWith(marker) ? key.slice(1) : key]
+				= decode(value[key]);
+		}
+		return result;
+	};
+	Object.defineProperty(globalThis, '__teleStore', {
+		value: (value) => JSON.stringify(encode(value, new Set())),
+	});
+	Object.defineProperty(globalThis, '__teleLoad', {
+		value: (text) => decode(JSON.parse(text)),
+	});
+
+	const bytesOf = (input) => ArrayBuffer.isView(input)
+		? new Uint8Array(input.buffer, input.byteOffset, input.byteLength)
+		: new Uint8Array(input);
+	class TextEncoder {
+		get encoding() {
+			return 'utf-8';
+		}
+		encode(input = '') {
+			return __teleUtf8Encode(String(input));
+		}
+	}
+	class TextDecoder {
+		#fatal;
+		constructor(label = 'utf-8', options = {}) {
+			if (!/^utf-?8$/i.test(String(label).trim())) {
+				throw new RangeError('TextDecoder only knows utf-8');
+			}
+			this.#fatal = !!options?.fatal;
+		}
+		get encoding() {
+			return 'utf-8';
+		}
+		get fatal() {
+			return this.#fatal;
+		}
+		decode(input) {
+			return (input === undefined)
+				? ''
+				: __teleUtf8Decode(bytesOf(input), this.#fatal);
+		}
+	}
+	globalThis.TextEncoder = TextEncoder;
+	globalThis.TextDecoder = TextDecoder;
+	globalThis.crypto = {
+		getRandomValues(array) {
+			if (!ArrayBuffer.isView(array)
+				|| array instanceof DataView
+				|| array instanceof Float16Array
+				|| array instanceof Float32Array
+				|| array instanceof Float64Array) {
+				throw new TypeError(
+					'crypto.getRandomValues needs an integer typed array');
+			} else if (array.byteLength > 65536) {
+				throw new RangeError(
+					'crypto.getRandomValues fills at most 65536 bytes');
+			}
+			__teleRandomFill(bytesOf(array));
+			return array;
+		},
+	};
+	Object.defineProperty(globalThis, '__teleResponse', {
+		value: (status, statusText, url, headers, body) => ({
+			ok: status >= 200 && status < 300,
+			status,
+			statusText,
+			url,
+			headers,
+			bytes: async () => body.slice(),
+			text: async () => new TextDecoder().decode(body),
+			json: async () => JSON.parse(new TextDecoder().decode(body)),
+		}),
+	});
 })();
 )js";
 
+[[nodiscard]] bool ValidUtf8(const char *data, std::size_t size) {
+	auto i = std::size_t();
+	while (i < size) {
+		const auto c = static_cast<unsigned char>(data[i]);
+		const auto length = (c < 0x80) ? 1
+			: ((c >> 5) == 0x6) ? 2
+			: ((c >> 4) == 0xE) ? 3
+			: ((c >> 3) == 0x1E) ? 4
+			: 0;
+		if (!length || i + length > size) {
+			return false;
+		}
+		for (auto j = 1; j != length; ++j) {
+			if ((static_cast<unsigned char>(data[i + j]) >> 6) != 0x2) {
+				return false;
+			}
+		}
+		i += length;
+	}
+	return true;
+}
+
+JSValue Utf8Encode(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	auto size = std::size_t();
+	const auto text = JS_ToCStringLen(ctx, &size, argv[0]);
+	if (!text) {
+		return JS_EXCEPTION;
+	}
+	auto result = JS_NewUint8ArrayCopy(
+		ctx,
+		reinterpret_cast<const uint8_t*>(text),
+		size);
+	JS_FreeCString(ctx, text);
+	return result;
+}
+
+JSValue Utf8Decode(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	auto size = std::size_t();
+	const auto data = JS_GetUint8Array(ctx, &size, argv[0]);
+	if (!data && size) {
+		return JS_EXCEPTION;
+	}
+	const auto raw = reinterpret_cast<const char*>(data);
+	if (argc > 1 && JS_ToBool(ctx, argv[1]) && !ValidUtf8(raw, size)) {
+		return JS_ThrowTypeError(ctx, "the data is not valid utf-8");
+	}
+	const auto text = QString::fromUtf8(raw, int(size)).toUtf8();
+	return JS_NewStringLen(ctx, text.constData(), text.size());
+}
+
+JSValue RandomFill(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	auto size = std::size_t();
+	const auto data = JS_GetUint8Array(ctx, &size, argv[0]);
+	if (data && size) {
+		base::RandomFill(data, size);
+	}
+	return JS_UNDEFINED;
+}
+
 class Stripper final {
 public:
 	Stripper();
@@ -386,6 +596,21 @@ void Engine::installGlobals() {
 		global,
