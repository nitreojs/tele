+[[nodiscard]] JSValue CallGlobal(
+		JSContext *ctx,
+		const char *name,
+		std::span<JSValueConst> args) {
+	auto global = JS_GetGlobalObject(ctx);
+	auto function = JS_GetPropertyStr(ctx, global, name);
+	JS_FreeValue(ctx, global);
+	auto result = JS_Call(
+		ctx,
+		function,
+		JS_UNDEFINED,
+		int(args.size()),
+		const_cast<JSValue*>(args.data()));
+	JS_FreeValue(ctx, function);
+	return result;
+}
+
+[[nodiscard]] JSValue MakeTypeError(JSContext *ctx, const QString &text) {
+	JS_ThrowTypeError(ctx, "%s", text.toUtf8().constData());
+	return JS_GetException(ctx);
+}
+
+[[nodiscard]] JSValue NewString(JSContext *ctx, const QString &text) {
+	const auto utf8 = text.toUtf8();
+	return JS_NewStringLen(ctx, utf8.constData(), utf8.size());
+}
+
+[[nodiscard]] std::string_view Bytes(const mtpBuffer &buffer) {
+	return std::string_view(
+		reinterpret_cast<const char*>(buffer.constData()),
+		std::size_t(buffer.size()) * sizeof(mtpPrime));
+}
+
+[[nodiscard]] std::optional<std::uint64_t> BigField(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::optional<std::uint64_t>();
+	if (JS_IsBigInt(value)) {
+		auto number = std::int64_t();
+		JS_ToBigInt64(ctx, &number, value);
+		result = std::uint64_t(number);
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] std::optional<PeerId> PeerFromValue(
+		JSContext *ctx,
+		JSValueConst value,
+		PeerId self) {
+	if (JS_IsBigInt(value) || JS_IsNumber(value)) {
+		auto id = std::int64_t();
+		if (JS_IsBigInt(value)) {
+			JS_ToBigInt64(ctx, &id, value);
+		} else {
+			auto number = 0.;
+			JS_ToFloat64(ctx, &number, value);
+			if (number != std::floor(number)) {
+				return std::nullopt;
+			}
+			id = std::int64_t(number);
+		}
+		if (id > 0) {
+			return peerFromUser(UserId(std::uint64_t(id)));
+		} else if (id <= -kChannelShift) {
+			return peerFromChannel(ChannelId(std::uint64_t(-id - kChannelShift)));
+		} else if (id < 0) {
+			return peerFromChat(ChatId(std::uint64_t(-id)));
+		}
+		return std::nullopt;
+	} else if (!JS_IsObject(value)) {
+		return std::nullopt;
+	}
+	auto name = JS_GetPropertyStr(ctx, value, "_");
+	const auto type = ToStd(ctx, name);
+	JS_FreeValue(ctx, name);
+	if (type == "inputPeerSelf" || type == "inputUserSelf") {
+		return self;
+	} else if (const auto user = BigField(ctx, value, "userId")) {
+		return peerFromUser(UserId(*user));
+	} else if (const auto chat = BigField(ctx, value, "chatId")) {
+		return peerFromChat(ChatId(*chat));
+	} else if (const auto channel = BigField(ctx, value, "channelId")) {
+		return peerFromChannel(ChannelId(*channel));
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] TextWithTags ExtractMarkdownLinks(const QString &text) {
+	static const auto expression = QRegularExpression(
+		uR"(\[([^\[\]\n]+)\]\(([^()\s]+)\))"_q);
+	auto result = TextWithTags();
+	auto from = 0;
+	auto iterator = expression.globalMatch(text);
+	while (iterator.hasNext()) {
+		const auto match = iterator.next();
+		const auto url = match.captured(2);
+		if (!Ui::InputField::IsValidMarkdownLink(url)) {
+			continue;
+		}
+		const auto label = match.captured(1);
+		result.text.append(text.mid(from, match.capturedStart() - from));
+		result.tags.push_back({
+			int(result.text.size()),
+			int(label.size()),
+			url,
+		});
+		result.text.append(label);
+		from = match.capturedEnd();
+	}
+	result.text.append(text.mid(from));
+	return result;
+}
+
+[[nodiscard]] TextWithTags ApplyMarkdown(const QString &text) {
+	auto field = Ui::InputField(
+		nullptr,
+		st::defaultInputField,
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(QString()),
+		QString());
+	field.setMarkdownReplacesEnabled(true);
+	field.setTextWithTags(ExtractMarkdownLinks(text));
+	return field.getTextWithAppliedMarkdown();
+}
