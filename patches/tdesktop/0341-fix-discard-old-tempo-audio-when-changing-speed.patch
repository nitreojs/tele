 }
 
 int64 AbstractAudioFFMpegLoader::startReadingQueuedFrames(float64 newSpeed) {
+	// Original frames are replayed below; saved PCM still has the old tempo.
+	if (holdsSavedDecodedSamples()) {
+		auto oldSpeedSamples = QByteArray();
+		takeSavedDecodedSamples(&oldSpeedSamples);
+	}
 	changeSpeedFilter(newSpeed);
 	if (_framesQueued.empty()) {
 		_framesQueuedIndex = -1;
