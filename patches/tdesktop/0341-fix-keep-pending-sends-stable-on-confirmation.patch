+// Keep local messages between old neighbours where confirmed order permits it.
+// A genuinely late send can reverse those neighbours; predecessors win then.
+void PreservePendingOrder(
+		const std::vector<FullMsgId> &previous,
+		not_null<Data::MessagesSlice*> slice) {
+	if (previous == slice->ids) {
+		return;
+	}
+	const auto pending = ranges::count_if(previous, [](FullMsgId id) {
+		return IsClientMsgId(id.msg);
+	});
+	if (!pending) {
+		return;
+	}
+	auto &ids = slice->ids;
+	auto positions = base::flat_map<FullMsgId, int>();
+	positions.reserve(ids.size());
+	for (auto i = 0; i != ids.size(); ++i) {
+		positions.emplace(ids[i], i);
+	}
+	auto following = positions.end();
+	auto bounds = std::vector<FullMsgId>();
+	bounds.reserve(pending);
+	for (const auto &id : previous | ranges::views::reverse) {
+		const auto i = positions.find(id);
+		if (i == positions.end()) {
+			continue;
+		}
+		if (IsClientMsgId(id.msg)) {
+			bounds.push_back((following == positions.end())
+				? FullMsgId()
+				: following->first);
+		}
+		if (following == positions.end() || i->second < following->second) {
+			following = i;
+		}
+	}
+	auto preceding = positions.end();
+	for (const auto &id : previous) {
+		const auto i = positions.find(id);
+		if (i == positions.end()) {
+			continue;
+		}
+		if (IsClientMsgId(id.msg)) {
+			const auto next = positions.find(bounds.back());
+			bounds.pop_back();
+			const auto from = i->second;
+			const auto lower = (preceding == positions.end())
+				? -1
+				: preceding->second;
+			const auto upper = (next == positions.end())
+				? int(ids.size())
+				: next->second;
+			const auto to = (from < lower)
+				? lower
+				: (from > upper && lower < upper)
+				? upper
+				: from;
+			if (from < to) {
+				std::rotate(begin(ids) + from, begin(ids) + from + 1, begin(ids) + to + 1);
+			} else if (from > to) {
+				std::rotate(begin(ids) + to, begin(ids) + from, begin(ids) + from + 1);
+			}
+			for (auto j = std::min(from, to); j <= std::max(from, to); ++j) {
+				positions.find(ids[j])->second = j;
+			}
+		}
+		if (preceding == positions.end() || i->second > preceding->second) {
+			preceding = i;
+		}
+	}
+}
