+bool SecretWidget::canSendNow() const {
+	const auto chat = this->chat();
+	if (!chat || chat->state != ChatState::Ready) {
+		controller()->showToast(Lower(u"The secret chat isn't ready."_q));
+		return false;
+	}
+	return true;
+}
+
+int64 SecretWidget::replyRandomId() const {
+	const auto manager = this->manager();
+	const auto reply = _composeControls->replyingToMessage();
+	return (manager && reply.messageId.peer == _history->peer->id)
+		? manager->randomIdOf(_chatId, reply.messageId.msg)
+		: int64();
+}
+
+void SecretWidget::finishSending() {
+	_composeControls->cancelReplyMessage();
+	_composeControls->hidePanelsAnimated();
+	_composeControls->focus();
+	crl::on_main(this, [=] {
+		listScrollTo(_scroll->scrollTopMax());
+	});
+}
+
+void SecretWidget::setupDragArea() {
+	const auto filter = [=](not_null<const QMimeData*> data) {
+		const auto chat = this->chat();
+		return chat
+			&& (chat->state == ChatState::Ready)
+			&& !_composeControls->isRecording();
+	};
+	const auto areas = DragArea::SetupDragAreaToContainer(
+		this,
+		filter,
+		nullptr,
+		[=] { updateControlsGeometry(); });
+	const auto dropped = [=](bool overrideSendImagesAsPhotos) {
+		return [=](const QMimeData *data) {
+			confirmSendingFiles(data, overrideSendImagesAsPhotos);
+			Window::ActivateWindow(controller());
+		};
+	};
+	areas.document->setDroppedCallback(dropped(false));
+	areas.photo->setDroppedCallback(dropped(true));
+}
+
+void SecretWidget::chooseAttach(
+		std::optional<bool> overrideSendImagesAsPhotos) {
+	_choosingAttach = false;
+	if (!canSendNow()) {
+		return;
+	}
+	const auto filter = (overrideSendImagesAsPhotos == true)
+		? FileDialog::PhotoVideoFilesFilter()
+		: FileDialog::AllOrImagesFilter();
+	FileDialog::GetOpenPaths(this, tr::lng_choose_files(tr::now), filter, crl::guard(this, [=](
+			FileDialog::OpenResult &&result) {
+		if (result.paths.isEmpty() && result.remoteContent.isEmpty()) {
+			return;
+		}
+		if (!result.remoteContent.isEmpty()) {
+			auto read = Images::Read({
+				.content = result.remoteContent,
+			});
+			if (!read.image.isNull() && !read.animated) {
+				confirmSendingFiles(
+					std::move(read.image),
+					std::move(result.remoteContent),
+					overrideSendImagesAsPhotos);
+			} else if (const auto manager = this->manager()) {
+				auto file = OutgoingFile();
+				file.content = result.remoteContent;
+				file.mime = Core::MimeTypeForData(file.content).name();
+				file.name = u"file"_q;
+				file.replyTo = replyRandomId();
+				manager->sendFile(_chatId, std::move(file));
+				finishSending();
+			}
+		} else {
+			const auto premium = controller()->session().user()->isPremium();
+			auto list = Storage::PrepareMediaList(
+				result.paths,
+				st::sendMediaPreviewSize,
+				premium);
+			list.overrideSendImagesAsPhotos = overrideSendImagesAsPhotos;
+			confirmSendingFiles(std::move(list));
+		}
+	}), nullptr);
+}
+
+bool SecretWidget::confirmSendingFiles(
+		not_null<const QMimeData*> data,
+		std::optional<bool> overrideSendImagesAsPhotos,
+		const QString &insertTextOnCancel) {
+	const auto hasImage = data->hasImage();
+	const auto premium = controller()->session().user()->isPremium();
+	if (const auto urls = Core::ReadMimeUrls(data); !urls.empty()) {
+		auto list = Storage::PrepareMediaList(
+			urls,
+			st::sendMediaPreviewSize,
+			premium);
+		if (list.error != Ui::PreparedList::Error::NonLocalUrl) {
+			if (list.error == Ui::PreparedList::Error::None || !hasImage) {
+				list.overrideSendImagesAsPhotos = overrideSendImagesAsPhotos;
+				confirmSendingFiles(std::move(list), QString());
+				return true;
+			}
+		}
+	}
+	if (auto read = Core::ReadMimeImage(data)) {
+		confirmSendingFiles(
+			std::move(read.image),
+			std::move(read.content),
+			overrideSendImagesAsPhotos,
+			insertTextOnCancel);
+		return true;
+	}
+	return false;
+}
+
+bool SecretWidget::confirmSendingFiles(
+		QImage &&image,
+		QByteArray &&content,
+		std::optional<bool> overrideSendImagesAsPhotos,
+		const QString &insertTextOnCancel) {
+	if (image.isNull()) {
+		return false;
+	}
+	auto list = Storage::PrepareMediaFromImage(
+		std::move(image),
+		std::move(content),
+		st::sendMediaPreviewSize);
+	list.overrideSendImagesAsPhotos = overrideSendImagesAsPhotos;
+	return confirmSendingFiles(std::move(list), insertTextOnCancel);
+}
+
+bool SecretWidget::confirmSendingFiles(
+		Ui::PreparedList &&list,
+		const QString &insertTextOnCancel) {
+	using Error = Ui::PreparedList::Error;
+	if (!canSendNow()) {
+		return false;
+	} else if (list.error == Error::TooLargeFile) {
+		controller()->showToast(Lower(
+			u"Files over 100 MB can't be sent in secret chats."_q));
+		return false;
+	} else if (list.error != Error::None || list.files.empty()) {
+		controller()->showToast(Lower(u"Couldn't read the file."_q));
+		return false;
+	}
+	auto box = Box<SendFilesBox>(
+		controller(),
+		std::move(list),
+		_composeControls->getTextWithAppliedMarkdown(),
+		_history->peer,
+		Api::SendType::Normal,
+		SendMenu::Details());
+	box->setReplyTo(_composeControls->replyingToMessage());
+	box->setConfirmedCallback(crl::guard(this, [=](
+			std::shared_ptr<Ui::PreparedBundle> bundle,
+			Api::SendOptions options,
+			FullReplyTo replyTo) {
+		sendingFilesConfirmed(std::move(bundle), replyTo);
+	}));
+	box->setCancelledCallback(_composeControls->restoreTextCallback(
+		insertTextOnCancel));
+	box->takeTextWithTagsRequests(
+	) | rpl::on_next([=](TextWithTags &&text) {
+		_composeControls->setText(std::move(text));
+	}, box->lifetime());
+	Window::ActivateWindow(controller());
+	controller()->show(std::move(box));
+	return true;
+}
+
+void SecretWidget::sendingFilesConfirmed(
+		std::shared_ptr<Ui::PreparedBundle> bundle,
+		FullReplyTo replyTo) {
+	const auto manager = this->manager();
+	if (!manager || !canSendNow()) {
+		return;
+	}
+	const auto compress = bundle->way.sendImagesAsPhotos();
+	auto reply = (replyTo.messageId.peer == _history->peer->id)
+		? manager->randomIdOf(_chatId, replyTo.messageId.msg)
+		: int64();
+	for (auto &group : bundle->groups) {
+		for (auto &file : group.list.files) {
+			if (file.size > kMaxFileSize) {
+				controller()->showToast(Lower(
+					u"Files over 100 MB can't be sent in secret chats."_q));
+				continue;
+			}
+			auto outgoing = ToOutgoing(file, compress);
+			outgoing.replyTo = std::exchange(reply, int64());
+			manager->sendFile(_chatId, std::move(outgoing));
+		}
+	}
+	finishSending();
+}
+
+void SecretWidget::sendVoice(const ComposeControls::VoiceToSend &data) {
+	const auto manager = this->manager();
+	if (!manager || !canSendNow() || data.bytes.isEmpty()) {
+		return;
+	}
+	auto file = OutgoingFile();
+	file.content = data.bytes;
+	file.duration = int(std::max(data.duration, crl::time(1000)) / 1000);
+	file.replyTo = replyRandomId();
+	if (data.video) {
+		file.type = MediaType::Round;
+		file.mime = u"video/mp4"_q;
+	} else {
+		file.type = MediaType::Voice;
+		file.mime = u"audio/ogg"_q;
+		file.waveform = documentWaveformEncode5bit(data.waveform);
+	}
+	manager->sendFile(_chatId, std::move(file));
+	finishSending();
+}
+
+void SecretWidget::sendChosenDocument(
+		not_null<DocumentData*> document,
+		TextWithTags caption) {
+	const auto manager = this->manager();
+	if (!manager || !canSendNow()) {
+		return;
+	}
+	if (document->sticker()) {
+		manager->sendSticker(_chatId, document, replyRandomId());
+		_composeControls->clearFieldAfterStickerSend();
+		finishSending();
+	} else if (document->isAnimation()) {
+		sendAnimation(document, std::move(caption));
+	} else {
+		controller()->showToast(
+			Lower(u"This can't be sent in secret chats yet."_q));
+	}
+}
+
+void SecretWidget::sendAnimation(
+		not_null<DocumentData*> document,
+		TextWithTags caption) {
+	if (!canSendNow()) {
+		return;
+	}
+	const auto replyTo = replyRandomId();
+	const auto chatId = _chatId;
+	const auto session = &_history->session();
+	finishSending();
+	ObtainBytes(document, crl::guard(this, [=](QByteArray bytes) {
+		const auto manager = FindManager(session);
+		if (!manager || bytes.isEmpty()) {
+			return;
+		}
+		auto file = OutgoingFile();
+		file.content = std::move(bytes);
+		file.name = document->filename();
+		file.mime = document->mimeString();
+		file.type = MediaType::Animation;
+		file.width = document->dimensions.width();
+		file.height = document->dimensions.height();
+		const auto duration = document->duration();
+		file.duration = (duration > 0) ? int(duration / 1000) : 0;
+		file.caption = TextWithEntities{
+			caption.text,
+			TextUtilities::ConvertTextTagsToEntities(caption.tags),
+		};
+		file.replyTo = replyTo;
+		manager->sendFile(chatId, std::move(file));
+	}), lifetime());
+}
