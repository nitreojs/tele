+[[nodiscard]] QByteArray JpegBytes(const QImage &image, int quality) {
+	auto result = QByteArray();
+	auto buffer = QBuffer(&result);
+	buffer.open(QIODevice::WriteOnly);
+	image.save(&buffer, "JPEG", quality);
+	return result;
+}
+
+[[nodiscard]] QImage Opaque(const QImage &image) {
+	if (!image.hasAlphaChannel()) {
+		return image;
+	}
+	auto result = QImage(image.size(), QImage::Format_RGB32);
+	result.fill(Qt::white);
+	{
+		auto p = QPainter(&result);
+		p.drawImage(0, 0, image);
+	}
+	return result;
+}
+
+void SetThumb(Media &media, const QImage &image) {
+	if (image.isNull()) {
+		return;
+	}
+	const auto thumb = Opaque(image).scaled(
+		kThumbSide,
+		kThumbSide,
+		Qt::KeepAspectRatio,
+		Qt::SmoothTransformation);
+	media.thumb = JpegBytes(thumb, kThumbQuality);
+	media.thumbWidth = thumb.width();
+	media.thumbHeight = thumb.height();
+}
