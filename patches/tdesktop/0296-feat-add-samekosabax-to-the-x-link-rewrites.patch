From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 10 Oct 2026 13:05:52 +0300
Subject: [PATCH] feat: add samekosabax to the x link rewrites

---
 Telegram/SourceFiles/tele/tele_link_rewrites.cpp | 1 +
 Telegram/SourceFiles/tele/tele_links.cpp         | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/tele/tele_link_rewrites.cpp b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
index b083d6366ab5fa2f51896c64d9d617a5c22dfce2..62c1c7fcb9b069bc4eff7850427b298ee9557ac9 100644
--- a/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
+++ b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
@@ -570,6 +570,7 @@ const std::vector<LinkRewritePreset> &LinkRewritePresets() {
 					u"fxtwitter.com"_q,
 					u"vxtwitter.com"_q,
 					u"fixvx.com"_q,
+					u"samekosabax.com"_q,
 				},
 				true),
 		},
diff --git a/Telegram/SourceFiles/tele/tele_links.cpp b/Telegram/SourceFiles/tele/tele_links.cpp
index 4ad5e645168378344a66276b27fbac542ea64174..3727df8f13189297ef19bddc8b78adfddade2fed 100644
--- a/Telegram/SourceFiles/tele/tele_links.cpp
+++ b/Telegram/SourceFiles/tele/tele_links.cpp
@@ -81,7 +81,7 @@ using Rules = std::vector<const QRegularExpression*>;
 			}
 		},
 		{
-			u"(?:^|\\.)(?:twitter\\.com|x\\.com|fxtwitter\\.com|vxtwitter\\.com|fixupx\\.com|fixvx\\.com)$"_q,
+			u"(?:^|\\.)(?:twitter\\.com|x\\.com|fxtwitter\\.com|vxtwitter\\.com|fixupx\\.com|fixvx\\.com|samekosabax\\.com)$"_q,
 			{
 				u"s"_q, u"t"_q, u"src"_q, u"ref_src"_q, u"ref_url"_q, u"cn"_q
 			}
