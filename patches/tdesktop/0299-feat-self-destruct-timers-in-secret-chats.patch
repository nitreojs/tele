+bool SetupTimerButton(
+		not_null<Ui::IconButtonWithText*> button,
+		std::shared_ptr<Ui::Show> show,
+		not_null<PeerData*> peer) {
+	if (!IsSecretPeer(peer)) {
+		return false;
+	}
+	const auto session = &peer->session();
+	const auto chatId = ChatIdOf(peer->id);
+	button->setClickedCallback([=] {
+		ChooseTimer(show, peer);
+	});
+	const auto refresh = [=] {
+		const auto manager = FindManager(session);
+		const auto chat = manager ? manager->find(chatId) : nullptr;
+		button->setText(chat ? TimerTinyText(chat->ttl) : QString());
+	};
+	refresh();
+	if (const auto manager = FindManager(session)) {
+		manager->chatChanges(
+		) | rpl::filter(
+			rpl::mappers::_1 == chatId
+		) | rpl::on_next(refresh, button->lifetime());
+	}
+	return true;
+}
