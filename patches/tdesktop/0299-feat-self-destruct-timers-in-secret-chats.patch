+
+bool IsTimedMedia(not_null<const HistoryItem*> item) {
+	const auto media = item->media();
+	return media
+		&& (media->photo() || media->document())
+		&& (MessageTtl(item) > 0);
+}
+
+crl::time HoldMediaTtl(not_null<History*> history, MsgId id) {
+	const auto peer = history->peer;
+	if (!IsSecretPeerId(peer->id)) {
+		return 0;
+	}
+	const auto manager = FindManager(&peer->session());
+	const auto message = manager
+		? manager->messageOf(ChatIdOf(peer->id), id)
+		: nullptr;
+	return (message && !message->out && IsHoldMedia(*message))
+		? crl::time(message->ttl)
+		: crl::time(0);
+}
