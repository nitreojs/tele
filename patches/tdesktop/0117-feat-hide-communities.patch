diff --git a/Telegram/SourceFiles/tele/tele_communities.cpp b/Telegram/SourceFiles/tele/tele_communities.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0595318d80ad052fa85e6dc2930555a42acbbf07
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_communities.cpp
@@ -0,0 +1,132 @@
+#include "tele/tele_communities.h"
+
+#include "api/api_peer_search.h"
+#include "apiwrap.h"
+#include "core/application.h"
+#include "data/data_channel.h"
+#include "data/data_community.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "history/view/history_view_element.h"
+#include "info/info_content_widget.h"
+#include "info/info_memento.h"
+#include "main/main_session.h"
+#include "tele/tele_ignored.h"
+#include "tele/tele_options.h"
+#include "window/window_controller.h"
+#include "window/window_separate_id.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool IsCommunity(not_null<PeerData*> peer) {
+	const auto channel = peer->asChannel();
+	return channel && channel->isCommunity();
+}
+
+[[nodiscard]] bool IsCommunityService(not_null<const HistoryItem*> item) {
+	return item->Has<HistoryServiceCommunityAdded>()
+		|| item->Has<HistoryServiceJoinedViaCommunity>();
+}
+
+void RefreshChatLists(not_null<Main::Session*> session) {
+	session->data().enumerateBroadcasts([](not_null<ChannelData*> channel) {
+		if (!channel->isCommunity()) {
+			return;
+		} else if (const auto info = channel->communityInfo()) {
+			if (info->collapsedInChatLists() != info->collapsedInDialogs()) {
+				info->collapsedChanged();
+			}
+		}
+	});
+	session->api().reloadPinnedDialogs();
+}
+
+void RefreshServiceViews(not_null<Main::Session*> session) {
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	EnumerateViews([&](not_null<HistoryView::Element*> view) {
+		const auto item = view->data();
+		if (&item->history()->session() == session
+			&& IsCommunityService(item)) {
+			items.emplace(item);
+		}
+	});
+	for (const auto &item : items) {
+		session->data().requestItemViewRefresh(item);
+	}
+}
+
+void CloseCommunityWindows(not_null<Main::Session*> session) {
+	auto windows = std::vector<not_null<Window::Controller*>>();
+	Core::App().enumerateWindows([&](not_null<Window::Controller*> window) {
+		const auto info = window->id().community();
+		if (info && &info->channel()->session() == session) {
+			windows.push_back(window);
+		}
+	});
+	for (const auto &window : windows) {
+		Core::App().closeWindow(window);
+	}
+}
+
+} // namespace
+
+bool CommunityCollapsed(not_null<const ChannelData*> channel) {
+	return channel->collapsedInDialogs() && !HideCommunities();
+}
+
+ChannelId LinkedCommunityId(not_null<PeerData*> peer) {
+	return HideCommunities() ? ChannelId() : Data::PeerLinkedCommunityId(peer);
+}
+
+std::vector<not_null<PeerData*>> WithoutCommunities(
+		std::vector<not_null<PeerData*>> list) {
+	if (HideCommunities()) {
+		list.erase(ranges::remove_if(list, IsCommunity), end(list));
+	}
+	return list;
+}
+
+void StripCommunities(Api::PeerSearchResult &result) {
+	if (!HideCommunities()) {
+		return;
+	}
+	result.my = WithoutCommunities(std::move(result.my));
+	result.peers = WithoutCommunities(std::move(result.peers));
+	result.sponsored.erase(
+		ranges::remove_if(result.sponsored, [](const auto &sponsored) {
+			return IsCommunity(sponsored.peer);
+		}),
+		end(result.sponsored));
+}
+
+bool BlocksCommunitySection(not_null<Window::SectionMemento*> memento) {
+	if (!HideCommunities()) {
+		return false;
+	}
+	const auto info = dynamic_cast<Info::Memento*>(memento.get());
+	if (!info || !info->stackSize()) {
+		return false;
+	}
+	const auto peer = info->content()->peer();
+	return peer && IsCommunity(peer);
+}
+
+bool CommunityServiceHidden(not_null<const HistoryView::Element*> view) {
+	return HideCommunities() && IsCommunityService(view->data());
+}
+
+void SetupCommunities(not_null<Main::Session*> session) {
+	HideCommunitiesChanges(
+	) | rpl::on_next([=] {
+		RefreshChatLists(session);
+		RefreshServiceViews(session);
+		if (HideCommunities()) {
+			CloseCommunityWindows(session);
+		}
+	}, session->lifetime());
+}
+
+} // namespace Tele
