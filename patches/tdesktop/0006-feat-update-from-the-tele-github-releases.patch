@@ -0,0 +1,399 @@
+#include "tele/tele_updater.h"
+
+#include "base/timer.h"
+#include "base/zlib_help.h"
+#include "core/application.h"
+#include "core/update_verify.h"
+#include "core/version.h"
+#include "settings.h"
+#include "tele/tele_build.h"
+#include "tele/tele_options.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QFile>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QPointer>
+#include <QtCore/QThread>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele {
+namespace {
+
+constexpr auto kFirstCheckDelay = 15 * crl::time(1000);
+constexpr auto kCheckInterval = 3 * 60 * 60 * crl::time(1000);
+constexpr auto kTransferTimeout = 60 * 1000;
+constexpr auto kMaxFeedSize = qint64(64 * 1024);
+constexpr auto kMaxZipSize = qint64(512 * 1024 * 1024);
+constexpr auto kMaxExeSize = 1024 * 1024 * 1024;
+constexpr auto kRenameAttempts = 10;
+constexpr auto kRenameRetryDelay = 100;
+constexpr auto kPublicKeyHex = "b824f455f8a50732a1f062b7e29029a7"
+	"7691cab1e88bc23f84187bba26d82ea7";
+constexpr auto kFeedUrl = "https://github.com/nitreojs/tele/releases/"
+	"latest/download/tele-update-win64.json";
+constexpr auto kDownloadPrefix = "https://github.com/nitreojs/tele/"
+	"releases/download/";
+constexpr auto kExeInZip = "tele.exe";
+
+struct Release {
+	QString tag;
+	QString url;
+	QByteArray zipSha256;
+	QByteArray exeSha256;
+};
+
+[[nodiscard]] quint64 RunningVersion() {
+	return Core::Updates::MakeUpdateVersion(
+		quint32(AppVersion),
+		quint32(BuildNumber()));
+}
+
+[[nodiscard]] QByteArray Sha256Hex(const QByteArray &data) {
+	return QCryptographicHash::hash(
+		data,
+		QCryptographicHash::Sha256).toHex();
+}
+
+[[nodiscard]] QByteArray FileSha256Hex(const QString &path) {
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return QByteArray();
+	}
+	auto hash = QCryptographicHash(QCryptographicHash::Sha256);
+	if (!hash.addData(&file)) {
+		return QByteArray();
+	}
+	return hash.result().toHex();
+}
+
+[[nodiscard]] QString ExePath() {
+	return QCoreApplication::applicationFilePath();
+}
+
+[[nodiscard]] bool CanWriteNextToExe() {
+	const auto probe = ExePath() + u".probe"_q;
+	auto file = QFile(probe);
+	if (!file.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	file.close();
+	return QFile::remove(probe);
+}
+
+[[nodiscard]] bool RenameWithRetries(const QString &from, const QString &to) {
+	for (auto attempt = 0; attempt != kRenameAttempts; ++attempt) {
+		if (QFile::rename(from, to)) {
+			return true;
+		}
+		QThread::msleep(kRenameRetryDelay);
+	}
+	return false;
+}
+
+[[nodiscard]] QString Unpack(const Release &release, const QByteArray &zip) {
+	if (Sha256Hex(zip) != release.zipSha256) {
+		return u"downloaded archive doesn't match the feed"_q;
+	}
+	auto archive = zlib::FileToRead(zip);
+	const auto exe = archive.readFileContent(kExeInZip, 0, kMaxExeSize);
+	if (exe.isEmpty() || archive.error() != UNZ_OK) {
+		return u"can't unpack %1 from the archive"_q.arg(kExeInZip);
+	} else if (Sha256Hex(exe) != release.exeSha256) {
+		return u"unpacked exe doesn't match the feed"_q;
+	}
+	const auto newPath = ExePath() + u".new"_q;
+	QFile::remove(newPath);
+	auto file = QFile(newPath);
+	if (!file.open(QIODevice::WriteOnly)
+		|| file.write(exe) != exe.size()
+		|| !file.flush()) {
+		file.close();
+		QFile::remove(newPath);
+		return u"can't write %1"_q.arg(newPath);
+	}
+	return QString();
+}
+
+class Updater final : public QObject, public base::has_weak_ptr {
+public:
+	Updater();
+
+	void check();
+
+	[[nodiscard]] UpdateStatus status() const;
+	[[nodiscard]] rpl::producer<UpdateStatus> statusValue() const;
+
+private:
+	using Done = Fn<void(QByteArray)>;
+
+	void scheduleCheck(crl::time delay);
+	void get(const QString &url, qint64 limit, bool progress, Done done);
+	void verifyFeed(const QByteArray &envelope);
+	void download(const Release &release);
+	void install(const Release &release);
+	void fail(const QString &error);
+	void finish(UpdateStatus status);
+
+	QNetworkAccessManager _manager;
+	base::Timer _timer;
+	bool _busy = false;
+	rpl::variable<UpdateStatus> _status;
+	rpl::lifetime _lifetime;
+
+};
+
+QPointer<Updater> Instance;
+
+Updater::Updater()
+: QObject(QCoreApplication::instance())
+, _timer([=] { check(); }) {
+	_status = UpdateStatus{
+		.state = BuildNumber() > 0
+			? UpdateState::Idle
+			: UpdateState::Disabled,
+	};
+	if (BuildNumber() <= 0) {
+		return;
+	}
+	QFile::remove(ExePath() + u".old"_q);
+	QFile::remove(ExePath() + u".new"_q);
+	AutoUpdateValue() | rpl::on_next([=](bool enabled) {
+		if (!enabled) {
+			_timer.cancel();
+		} else if (!_busy
+			&& _status.current().state != UpdateState::Ready) {
+			scheduleCheck(kFirstCheckDelay);
+		}
+	}, _lifetime);
+}
+
+void Updater::scheduleCheck(crl::time delay) {
+	if (AutoUpdate() && _status.current().state != UpdateState::Ready) {
+		_timer.callOnce(delay);
+	}
+}
+
+UpdateStatus Updater::status() const {
+	return _status.current();
+}
+
+rpl::producer<UpdateStatus> Updater::statusValue() const {
+	return _status.value();
+}
+
+void Updater::check() {
+	const auto state = _status.current().state;
+	if (state == UpdateState::Disabled
+		|| state == UpdateState::Ready
+		|| _busy) {
+		return;
+	}
+	_busy = true;
+	_timer.cancel();
+	_status = UpdateStatus{ .state = UpdateState::Checking };
+	get(QString::fromLatin1(kFeedUrl), kMaxFeedSize, false, [=](
+			QByteArray envelope) {
+		verifyFeed(envelope);
+	});
+}
+
+void Updater::get(
+		const QString &url,
+		qint64 limit,
+		bool progress,
+		Done done) {
+	auto request = QNetworkRequest(QUrl(url));
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(kTransferTimeout);
+	const auto reply = _manager.get(request);
+	const auto tooLarge = std::make_shared<bool>(false);
+	connect(reply, &QNetworkReply::downloadProgress, this, [=](
+			qint64 ready,
+			qint64 total) {
+		if (ready > limit || total > limit) {
+			*tooLarge = true;
+			reply->abort();
+			return;
+		} else if (progress) {
+			auto status = _status.current();
+			status.ready = ready;
+			status.total = total;
+			_status = std::move(status);
+		}
+	});
+	connect(reply, &QNetworkReply::finished, this, [=] {
+		reply->deleteLater();
+		const auto code = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (*tooLarge) {
+			fail(u"response is too large"_q);
+		} else if (reply->error() != QNetworkReply::NoError) {
+			fail(u"network error: %1"_q.arg(reply->errorString()));
+		} else if (code != 200) {
+			fail(u"unexpected http status %1"_q.arg(code));
+		} else {
+			done(reply->readAll());
+		}
+	});
+}
+
+void Updater::verifyFeed(const QByteArray &envelope) {
+	const auto outer = QJsonDocument::fromJson(envelope).object();
+	const auto feed = QByteArray::fromBase64(
+		outer.value(u"feed"_q).toString().toLatin1());
+	const auto signature = QByteArray::fromBase64(
+		outer.value(u"signature"_q).toString().toLatin1());
+	auto error = QString();
+	const auto key = Core::Updates::ManifestKey{
+		.ed25519 = true,
+		.x = QByteArray::fromHex(kPublicKeyHex),
+	};
+	if (!Core::Updates::VerifySignature(key, feed, signature, &error)) {
+		fail(u"bad feed signature: %1"_q.arg(error));
+		return;
+	}
+	const auto object = QJsonDocument::fromJson(feed).object();
+	const auto base = object.value(u"base"_q).toVariant().toULongLong();
+	const auto counter = object.value(u"counter"_q).toVariant().toULongLong();
+	const auto release = Release{
+		.tag = object.value(u"tag"_q).toString(),
+		.url = object.value(u"url"_q).toString(),
+		.zipSha256 = object.value(u"zip_sha256"_q).toString().toLatin1(),
+		.exeSha256 = object.value(u"exe_sha256"_q).toString().toLatin1(),
+	};
+	if (!base
+		|| !counter
+		|| base > 0xFFFFFFFFULL
+		|| counter > 0xFFFFFFFFULL
+		|| release.tag.isEmpty()
+		|| !release.url.startsWith(QString::fromLatin1(kDownloadPrefix))
+		|| release.zipSha256.size() != 64
+		|| release.exeSha256.size() != 64) {
+		fail(u"malformed feed"_q);
+		return;
+	}
+	const auto version = Core::Updates::MakeUpdateVersion(
+		quint32(base),
+		quint32(counter));
+	if (version <= RunningVersion()) {
+		finish({ .state = UpdateState::Latest });
+		return;
+	} else if (!CanWriteNextToExe()) {
+		fail(u"can't write to the tele folder, "
+			"download %1 from GitHub by hand"_q.arg(release.tag));
+		return;
+	}
+	_status = UpdateStatus{
+		.state = UpdateState::Downloading,
+		.tag = release.tag,
+	};
+	crl::async([=, weak = base::make_weak(this), path = ExePath()] {
+		const auto installed = (FileSha256Hex(path) == release.exeSha256);
+		crl::on_main(weak, [=] {
+			if (installed) {
+				finish({ .state = UpdateState::Ready, .tag = release.tag });
+			} else {
+				download(release);
+			}
+		});
+	});
+}
+
+void Updater::download(const Release &release) {
+	get(release.url, kMaxZipSize, true, [=](QByteArray zip) {
+		crl::async([=, weak = base::make_weak(this)] {
+			const auto error = Unpack(release, zip);
+			crl::on_main(weak, [=] {
+				if (!error.isEmpty()) {
+					fail(error);
+				} else {
+					install(release);
+				}
+			});
+		});
+	});
+}
+
+void Updater::install(const Release &release) {
+	const auto path = ExePath();
+	const auto newPath = path + u".new"_q;
+	const auto oldPath = path + u".old"_q;
+	QFile::remove(oldPath);
+	if (!RenameWithRetries(path, oldPath)) {
+		QFile::remove(newPath);
+		fail(u"can't move the running exe aside"_q);
+		return;
+	} else if (!RenameWithRetries(newPath, path)) {
+		if (!RenameWithRetries(oldPath, path)) {
+			fail(u"%1 is missing, rename %2 back to it"_q.arg(path, oldPath));
+			return;
+		}
+		QFile::remove(newPath);
+		fail(u"can't put the new exe in place"_q);
+		return;
+	}
+	finish({ .state = UpdateState::Ready, .tag = release.tag });
+}
+
+void Updater::fail(const QString &error) {
+	LOG(("Tele Updater Error: %1").arg(error));
+	finish({ .state = UpdateState::Failed, .error = error });
+}
+
+void Updater::finish(UpdateStatus status) {
+	_busy = false;
+	_status = std::move(status);
+	scheduleCheck(kCheckInterval);
+}
+
+} // namespace
+
+void StartUpdater() {
+	if (!Instance) {
+		Instance = new Updater();
+	}
+}
+
+void CheckForUpdates() {
+	if (Instance) {
+		Instance->check();
+	}
+}
+
+void RestartToUpdate() {
+	if (UpdateReady()) {
+		cSetRestarting(true);
+		Core::Quit();
+	}
+}
+
+UpdateStatus CurrentUpdateStatus() {
+	return Instance
+		? Instance->status()
+		: UpdateStatus{ .state = UpdateState::Disabled };
+}
+
+rpl::producer<UpdateStatus> UpdateStatusValue() {
+	return Instance
+		? Instance->statusValue()
+		: rpl::single(UpdateStatus{ .state = UpdateState::Disabled });
+}
+
+bool UpdateReady() {
+	return CurrentUpdateStatus().state == UpdateState::Ready;
+}
+
+rpl::producer<bool> UpdateReadyValue() {
+	return UpdateStatusValue(
+	) | rpl::map([](const UpdateStatus &status) {
+		return status.state == UpdateState::Ready;
+	}) | rpl::distinct_until_changed();
+}
+
+} // namespace Tele
