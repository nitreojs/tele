From: nitreojs <hello@starkow.dev>
Date: Thu, 8 Oct 2026 16:42:39 +0300
Subject: [PATCH] fix: rewrite tiktok links to tnktok now that vxtiktok is gone

---
 .../SourceFiles/tele/tele_link_rewrites.cpp   | 21 +++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_link_rewrites.cpp b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
index f7cacafc0df681f624f096ac04af48acbff40cee..b083d6366ab5fa2f51896c64d9d617a5c22dfce2 100644
--- a/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
+++ b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
@@ -165,6 +165,22 @@ using Memo = base::flat_map<QString, std::optional<QString>>;
 	return result;
 }
 
+// Rewrite targets that shut down, with the live service that replaces them.
+[[nodiscard]] QStringList ReplaceGoneTargets(QStringList targets) {
+	static const auto gone = base::flat_map<QString, QString>{
+		{ u"vxtiktok.com"_q, u"tnktok.com"_q },
+	};
+	auto result = QStringList();
+	for (const auto &target : targets) {
+		const auto i = gone.find(target);
+		const auto live = (i != end(gone)) ? i->second : target;
+		if (!result.contains(live)) {
+			result.push_back(live);
+		}
+	}
+	return result;
+}
+
 [[nodiscard]] std::optional<LinkRewriteRule> ParseRule(
 		const QJsonObject &object) {
 	auto result = LinkRewriteRule{
@@ -174,7 +190,8 @@ using Memo = base::flat_map<QString, std::optional<QString>>;
 	if (type == u"domains"_q) {
 		result.type = LinkRewriteType::Domains;
 		result.from = ParseDomains(object.value(u"from"_q));
-		result.to = ParseDomains(object.value(u"to"_q));
+		result.to = ReplaceGoneTargets(
+			ParseDomains(object.value(u"to"_q)));
 		result.random = (object.value(u"pick"_q).toString() != u"first"_q);
 		if (result.from.isEmpty() || result.to.isEmpty()) {
 			return std::nullopt;
@@ -567,7 +584,7 @@ const std::vector<LinkRewritePreset> &LinkRewritePresets() {
 			u"TikTok"_q,
 			DomainsPreset(
 				{ u"tiktok.com"_q },
-				{ u"vxtiktok.com"_q, u"tnktok.com"_q },
+				{ u"tnktok.com"_q },
 				false),
 		},
 		{
