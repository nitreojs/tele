From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Tue, 6 Oct 2026 06:26:26 +0300
Subject: [PATCH] fix: messages with relative dates no longer freeze tele

---
 Telegram/SourceFiles/data/data_session.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/data/data_session.cpp b/Telegram/SourceFiles/data/data_session.cpp
index dd82011ab17ba5be8d8483023c7f328a852dc00e..d149434d68688d6e6fb44bbe8ac92bb6f4025f0c 100644
--- a/Telegram/SourceFiles/data/data_session.cpp
+++ b/Telegram/SourceFiles/data/data_session.cpp
@@ -3328,11 +3328,15 @@ void Session::checkFormattedDateUpdates() {
 		expired.insert(expired.end(), list.begin(), list.end());
 		_formattedDateUpdates.erase(_formattedDateUpdates.begin());
 	}
+	auto items = base::flat_set<not_null<HistoryItem*>>();
 	for (const auto &weak : expired) {
 		if (const auto strong = weak.get()) {
-			requestItemTextRefresh(strong->data());
+			items.emplace(strong->data());
 		}
 	}
+	for (const auto &item : items) {
+		requestItemTextRefresh(item);
+	}
 	scheduleNextFormattedDateUpdate();
 }
 
