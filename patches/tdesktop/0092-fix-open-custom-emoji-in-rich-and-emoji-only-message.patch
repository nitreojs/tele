+[[nodiscard]] DocumentId LargeCustomEmojiId(const LargeCustomEmoji &element) {
+	if (const auto id = std::get_if<DocumentId>(&element)) {
+		return *id;
+	} else if (const auto sticker = std::get_if<StickerPtr>(&element)) {
+		const auto document = (*sticker)->document();
+		return document ? document->id : DocumentId();
+	} else if (const auto custom = std::get_if<CustomPtr>(&element)) {
+		return Data::ParseCustomEmojiData((*custom)->entityData());
+	}
+	return DocumentId();
+}
