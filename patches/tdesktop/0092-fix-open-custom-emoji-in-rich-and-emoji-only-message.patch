+#include "tele/tele_custom_emoji.h"
+
+#include "core/click_handler_types.h"
+#include "data/data_document.h"
+#include "data/data_message_reaction_id.h"
+#include "data/data_session.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_reaction_preview.h"
+#include "iv/iv_rich_page.h"
+#include "iv/markdown/iv_markdown_prepare.h"
+#include "iv/markdown/iv_markdown_prepare_serialize.h"
+#include "mainwindow.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+namespace {
+
+class ResolveListener final : public Data::CustomEmojiManager::Listener {
+public:
+	void customEmojiResolveDone(not_null<DocumentData*> document) override {
+	}
+
+};
+
+void CollectText(
+		const TextWithEntities &text,
+		const Fn<void(DocumentId)> &callback) {
+	for (const auto &entity : text.entities) {
+		if (entity.type() != EntityType::CustomEmoji) {
+			continue;
+		}
+		const auto data = QStringView(entity.data());
+		if (const auto object = Iv::Markdown::ParseInlineTextObjectEntity(
+				data)) {
+			using Button = Iv::Markdown::InlineTextObjectButtonData;
+			if (const auto button = std::get_if<Button>(&object->data)) {
+				CollectText(button->label, callback);
+			}
+		} else if (const auto id = Data::ParseCustomEmojiData(data)) {
+			callback(id);
+		}
+	}
+}
+
+void CollectBlocks(
+		const std::vector<Iv::RichPage::Block> &blocks,
+		const Fn<void(DocumentId)> &callback) {
+	for (const auto &block : blocks) {
+		CollectText(block.text.text, callback);
+		CollectText(block.caption.text, callback);
+		for (const auto &item : block.listItems) {
+			CollectText(item.text.text, callback);
+			CollectBlocks(item.blocks, callback);
+		}
+		for (const auto &row : block.tableRows) {
+			for (const auto &cell : row.cells) {
+				CollectText(cell.text.text, callback);
+			}
+		}
+		for (const auto &button : block.buttons) {
+			CollectText(button.text.text, callback);
+		}
+		CollectBlocks(block.blocks, callback);
+	}
+}
+
+} // namespace
+
+bool CustomEmojiClickable(QStringView data) {
+	return Data::ParseCustomEmojiData(data) != 0;
+}
+
+void OpenCustomEmoji(QStringView data, ClickContext context) {
+	const auto id = Data::ParseCustomEmojiData(data);
+	const auto my = context.other.value<ClickHandlerContext>();
+	const auto controller = my.sessionWindow.get();
+	if (!id || !controller) {
+		return;
+	}
+	if (!controller->widget()->isActiveWindow()) {
+		controller->window().activate();
+	}
+	HistoryView::ShowReactionPreview(
+		controller,
+		my.itemId,
+		Data::ReactionId{ id },
+		true);
+}
+
+ClickHandlerPtr MakeCustomEmojiLink(DocumentId id) {
+	const auto data = Data::SerializeCustomEmojiId(id);
+	return std::make_shared<LambdaClickHandler>([=](ClickContext context) {
+		OpenCustomEmoji(data, std::move(context));
+	});
+}
+
+void ForEachRichPageCustomEmoji(
+		not_null<HistoryItem*> item,
+		Fn<void(DocumentId)> callback) {
+	static auto listener = ResolveListener();
+	const auto manager = &item->history()->owner().customEmojiManager();
+	const auto push = Fn<void(DocumentId)>([&](DocumentId id) {
+		manager->resolve(id, &listener);
+		callback(id);
+	});
+	for (const auto &page : { item->richPage(), item->fullRichPage() }) {
+		if (page) {
+			CollectBlocks(page->blocks, push);
+		}
+	}
+}
+
+} // namespace Tele
