+[[nodiscard]] TextWithEntities TranscriptionQuote(
+		not_null<HistoryView::Element*> view,
+		TextSelection selection) {
+	const auto document = dynamic_cast<HistoryView::Document*>(
+		view->media());
+	const auto voice = document
+		? document->Get<HistoryDocumentVoice>()
+		: nullptr;
+	if (!voice || selection == FullSelection) {
+		return {};
+	}
+	const auto item = view->data();
+	const auto mediaBefore = (item->invertMedia() && !item->emptyText())
+		? !document->aboveTextByDefault()
+		: document->aboveTextByDefault();
+	if (view->hasVisibleText() && !mediaBefore) {
+		return {};
+	}
+	const auto length = voice->transcribeText.length();
+	if (selection.empty() || selection.from >= length) {
+		return {};
+	}
+	const auto &entry = item->history()->session().api().transcribes().entry(
+		item);
+	if (!entry.shown
+		|| entry.failed
+		|| entry.toolong
+		|| entry.pending
+		|| entry.requestId) {
+		return {};
+	}
+	selection.to = uint16(std::min(int(selection.to), int(length)));
+	auto result = voice->transcribeText.toTextWithEntities(selection);
+	result.entities.clear();
+	return result;
+}
+
