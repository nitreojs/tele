From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 22:20:54 +0300
Subject: [PATCH] feat: group the tele interface and profile settings

---
 .../SourceFiles/settings/settings_tele.cpp     | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 9fb5b0a79d10b863d4df68248debe42bae98c7da..982a3518080be5ed8aa6f5394d91061663d3ac2a 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1046,13 +1046,20 @@ void AddGhostChats(SectionBuilder &builder) {
 
 void FillInterface(SectionBuilder &builder) {
 	builder.addSkip();
+	AddGroupTitle(builder, u"Title bar"_q);
 	AddTitle(builder);
-	AddOptionToggle(builder, ::Tele::kOptionLowercase);
-	AddOptionToggle(builder, ::Tele::kOptionBubbleBadges);
-	AddCallButtons(builder);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Chat list"_q);
 	AddOptionToggle(builder, ::Tele::kOptionHideAllChats);
 	AddOptionToggle(builder, ::Tele::kOptionStaticUserpicsList);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Chats and profiles"_q);
+	AddOptionToggle(builder, ::Tele::kOptionBubbleBadges);
 	AddOptionToggle(builder, ::Tele::kOptionStaticUserpicsChats);
+	AddCallButtons(builder);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Text"_q);
+	AddOptionToggle(builder, ::Tele::kOptionLowercase);
 	builder.addSkip();
 }
 
@@ -1119,10 +1126,15 @@ void FillPrivacy(SectionBuilder &builder) {
 
 void FillProfiles(SectionBuilder &builder) {
 	builder.addSkip();
+	AddGroupTitle(builder, u"Peer IDs"_q);
 	AddOptionToggle(builder, ::Info::Profile::kOptionShowPeerIdBelowAbout);
 	AddOptionToggle(builder, ::Tele::kOptionPeerIdsWithoutSpaces);
 	AddOptionToggle(builder, ::Tele::kOptionBotApiPeerIds);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Profiles"_q);
 	AddOptionToggle(builder, ::Tele::kOptionShowDc);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Gifts"_q);
 	AddOptionToggle(builder, ::Tele::kOptionShowGiftIds);
 	AddOptionToggle(builder, ::Tele::kOptionSeeTgButton);
 	builder.addSkip();
