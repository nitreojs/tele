@@ -0,0 +1,166 @@
+#include "tele/scripting/tele_script_permissions.h"
+
+#include "tele/tele_mtp_console_requests.h"
+#include "tele/tele_tl_runtime.h"
+
+namespace Tele::Scripting {
+namespace {
+
+constexpr Capability kCapabilities[] = {
+	Capability::Updates,
+	Capability::Call,
+	Capability::Requests,
+	Capability::Results,
+};
+
+[[nodiscard]] bool IsUpdateName(std::string_view name) {
+	const auto combinator = TlRuntime::BundledSchema().constructor(name);
+	return combinator
+		&& (combinator->type == "Update"
+			|| name == "updateShortMessage"
+			|| name == "updateShortChatMessage"
+			|| name == "updateShortSentMessage");
+}
+
+[[nodiscard]] std::string_view Prefix(std::string_view pattern) {
+	return IsGlob(pattern) ? pattern.substr(0, pattern.size() - 1) : pattern;
+}
+
+[[nodiscard]] bool Covers(const Grant &wide, const Grant &narrow) {
+	if (wide.capability != narrow.capability) {
+		return false;
+	} else if (wide.pattern == narrow.pattern) {
+		return true;
+	}
+	const auto exact = !narrow.pattern.empty() && !IsGlob(narrow.pattern);
+	if (exact) {
+		if (!wide.pattern.empty() && !IsGlob(wide.pattern)) {
+			return false;
+		} else if (DangerousName(narrow.capability, narrow.pattern)) {
+			return false;
+		}
+		return wide.pattern.empty()
+			|| narrow.pattern.starts_with(Prefix(wide.pattern));
+	} else if (wide.pattern.empty()) {
+		return true;
+	} else if (narrow.pattern.empty() || !IsGlob(wide.pattern)) {
+		return false;
+	}
+	return Prefix(narrow.pattern).starts_with(Prefix(wide.pattern));
+}
+
+} // namespace
+
+const char *CapabilityName(Capability capability) {
+	switch (capability) {
+	case Capability::Updates: return "updates";
+	case Capability::Call: return "call";
+	case Capability::Requests: return "requests";
+	case Capability::Results: return "results";
+	}
+	Unexpected("Capability in CapabilityName.");
+}
+
+bool IsGlob(std::string_view pattern) {
+	return !pattern.empty() && pattern.back() == '*';
+}
+
+bool DangerousName(Capability capability, std::string_view name) {
+	return (capability != Capability::Updates) && IsDangerousMethod(name);
+}
+
+Permissions Permissions::Parse(const QStringList &list, QString &error) {
+	auto result = Permissions();
+	for (const auto &entry : list) {
+		const auto text = entry.trimmed().toStdString();
+		const auto colon = text.find(':');
+		const auto name = std::string_view(text).substr(0, colon);
+		const auto i = ranges::find_if(kCapabilities, [&](Capability c) {
+			return name == CapabilityName(c);
+		});
+		if (i == std::end(kCapabilities)) {
+			error = u"unknown permission '%1'"_q.arg(entry);
+			return Permissions();
+		}
+		auto pattern = (colon == std::string::npos)
+			? std::string()
+			: text.substr(colon + 1);
+		if (colon != std::string::npos && pattern.empty()) {
+			error = u"permission '%1' needs a name after ':'"_q.arg(entry);
+			return Permissions();
+		} else if (pattern == "*") {
+			pattern.clear();
+		}
+		if (!pattern.empty() && !IsGlob(pattern)) {
+			const auto updates = (*i == Capability::Updates);
+			const auto valid = updates
+				? IsUpdateName(pattern)
+				: (TlRuntime::BundledSchema().method(pattern) != nullptr);
+			if (!valid) {
+				error = u"permission '%1': %2 is not %3"_q.arg(
+					entry,
+					QString::fromStdString(pattern),
+					updates ? u"an update"_q : u"a method"_q);
+				return Permissions();
+			}
+		}
+		auto grant = Grant{ .capability = *i, .pattern = std::move(pattern) };
+		if (!ranges::contains(result._grants, grant)) {
+			result._grants.push_back(std::move(grant));
+		}
+	}
+	return result;
+}
+
+bool Permissions::allows(Capability capability, std::string_view name) const {
+	const auto dangerous = DangerousName(capability, name);
+	for (const auto &grant : _grants) {
+		if (grant.capability != capability) {
+			continue;
+		} else if (grant.pattern == name) {
+			return true;
+		} else if (dangerous) {
+			continue;
+		} else if (grant.pattern.empty()
+			|| (IsGlob(grant.pattern)
+				&& name.starts_with(Prefix(grant.pattern)))) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool Permissions::any(Capability capability) const {
+	return ranges::any_of(_grants, [&](const Grant &grant) {
+		return grant.capability == capability;
+	});
+}
+
+bool Permissions::covers(const Permissions &other) const {
+	return ranges::all_of(other._grants, [&](const Grant &narrow) {
+		return ranges::any_of(_grants, [&](const Grant &wide) {
+			return Covers(wide, narrow);
+		});
+	});
+}
+
+bool Permissions::empty() const {
+	return _grants.empty();
+}
+
+QStringList Permissions::strings() const {
+	auto result = QStringList();
+	for (const auto &grant : _grants) {
+		const auto name = QString::fromLatin1(CapabilityName(grant.capability));
+		result.push_back(grant.pattern.empty()
+			? name
+			: (name + ':' + QString::fromStdString(grant.pattern)));
+	}
+	return result;
+}
+
+const std::vector<Grant> &Permissions::grants() const {
+	return _grants;
+}
+
+} // namespace Tele::Scripting
