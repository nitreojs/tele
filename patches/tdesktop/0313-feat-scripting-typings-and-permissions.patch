+)ts";
+
+struct Name {
+	std::string space;
+	std::string base;
+};
+
+[[nodiscard]] Name SplitName(std::string_view full) {
+	const auto dot = full.rfind('.');
+	return (dot == std::string_view::npos)
+		? Name{ std::string(), std::string(full) }
+		: Name{
+			std::string(full.substr(0, dot)),
+			std::string(full.substr(dot + 1)),
+		};
+}
+
+[[nodiscard]] std::string Pascal(std::string_view base) {
+	auto result = CamelCase(base);
+	if (!result.empty() && result[0] >= 'a' && result[0] <= 'z') {
+		result[0] = char(result[0] - 'a' + 'A');
+	}
+	return result;
+}
+
+[[nodiscard]] std::string Path(const std::string &space, std::string name) {
+	return space.empty()
+		? ("tl." + name)
+		: ("tl." + space + '.' + name);
+}
+
+[[nodiscard]] std::string RawName(const Combinator &combinator) {
+	return "Raw"
+		+ Pascal(SplitName(combinator.name).base)
+		+ (combinator.method ? "Request" : "");
+}
+
+[[nodiscard]] std::string RawPath(const Combinator &combinator) {
+	return Path(SplitName(combinator.name).space, RawName(combinator));
+}
+
+[[nodiscard]] std::string TypeName(std::string_view type) {
+	return "Type" + Pascal(SplitName(type).base);
+}
+
+[[nodiscard]] std::string TypePath(std::string_view type) {
+	return Path(SplitName(type).space, TypeName(type));
+}
+
+[[nodiscard]] bool IsIdentifier(std::string_view name) {
+	if (name.empty() || (name[0] >= '0' && name[0] <= '9')) {
+		return false;
+	}
+	for (const auto ch : name) {
+		const auto ok = (ch >= 'a' && ch <= 'z')
+			|| (ch >= 'A' && ch <= 'Z')
+			|| (ch >= '0' && ch <= '9')
+			|| ch == '_'
+			|| ch == '$';
+		if (!ok) {
+			return false;
+		}
+	}
+	return true;
+}
+
+class Generator final {
+public:
+	explicit Generator(const TlRuntime::Schema &schema) : _schema(schema) {
+	}
+
+	[[nodiscard]] QByteArray generate();
+
+private:
+	[[nodiscard]] std::string ts(std::string_view type) const;
+	[[nodiscard]] std::string result(const Combinator &method) const;
+	[[nodiscard]] std::string object(const Combinator &combinator) const;
+	[[nodiscard]] std::string field(const Param &param) const;
+
+	const TlRuntime::Schema &_schema;
+
+};
+
+std::string Generator::ts(std::string_view type) const {
+	if (type == "int" || type == "double") {
+		return "number";
+	} else if (type == "long") {
+		return "bigint";
+	} else if (type == "string") {
+		return "string";
+	} else if (type == "bytes" || type == "int128" || type == "int256") {
+		return "Uint8Array";
+	} else if (type == "Bool" || type == "true") {
+		return "boolean";
+	} else if (type.starts_with('!') || type == "X" || type == "Object") {
+		return "tl.TlObject";
+	} else if (type.size() > 8
+		&& (type.starts_with("Vector<") || type.starts_with("vector<"))
+		&& type.back() == '>') {
+		return ts(type.substr(7, type.size() - 8)) + "[]";
+	} else if (type.starts_with('%')) {
+		const auto list = _schema.constructorsOf(type.substr(1));
+		return (list.size() == 1) ? RawPath(*list.front()) : "tl.TlObject";
+	}
+	const auto base = SplitName(type).base;
+	if (!base.empty() && base[0] >= 'a' && base[0] <= 'z') {
+		const auto combinator = _schema.constructor(type);
+		return combinator ? RawPath(*combinator) : "tl.TlObject";
+	} else if (_schema.constructorsOf(type).empty()) {
+		return "tl.TlObject";
+	}
+	return TypePath(type);
+}
+
+std::string Generator::result(const Combinator &method) const {
+	return (method.type == "X") ? "unknown" : ts(method.type);
+}
+
+std::string Generator::field(const Param &param) const {
+	if (param.type == "#") {
+		return std::string();
+	}
+	const auto name = CamelCase(param.name);
+	const auto key = IsIdentifier(name) ? name : ('\'' + name + '\'');
+	if (param.type == "true") {
+		return key + "?: boolean";
+	}
+	return key + ((param.flagBit >= 0) ? "?: " : ": ") + ts(param.type);
+}
+
+std::string Generator::object(const Combinator &combinator) const {
+	const auto indent = SplitName(combinator.name).space.empty()
+		? std::string("  ")
+		: std::string("    ");
+	auto result = indent + "interface " + RawName(combinator) + " {\n";
+	result += indent + "  _: '" + combinator.name + "'\n";
+	for (const auto &param : combinator.params) {
+		if (auto line = field(param); !line.empty()) {
+			result += indent + "  " + line + '\n';
+		}
+	}
+	result += indent + "}\n";
+	return result;
+}
+
+QByteArray Generator::generate() {
+	auto spaces = std::map<std::string, std::string>();
+	auto types = std::vector<std::string>();
+	auto seenTypes = std::set<std::string, std::less<>>();
+	auto methods = std::string();
+	for (const auto &combinator : _schema.list()) {
+		const auto space = SplitName(combinator.name).space;
+		spaces[space] += object(combinator);
+		if (combinator.method) {
+			methods += "    '" + combinator.name + "': {\n"
+				+ "      request: " + RawPath(combinator) + '\n'
+				+ "      result: " + result(combinator) + '\n'
+				+ "    }\n";
+		} else if (seenTypes.emplace(combinator.type).second) {
+			types.push_back(combinator.type);
+		}
+	}
+	for (const auto &type : types) {
+		const auto space = SplitName(type).space;
+		const auto indent = space.empty()
+			? std::string("  ")
+			: std::string("    ");
+		auto line = indent + "type " + TypeName(type) + " =\n";
+		for (const auto constructor : _schema.constructorsOf(type)) {
+			line += indent + "  | " + RawPath(*constructor) + '\n';
+		}
+		spaces[SplitName(type).space] += line;
+	}
+	auto out = std::string("// tele.d.ts for layer ")
+		+ std::to_string(MTP::details::kCurrentLayer)
+		+ ", generated by tele from the schema it speaks. "
+		+ "tele rewrites this file, don't edit it.\n\n"
+		+ "declare namespace tl {\n";
+	out += kHelpers;
+	out += "\n  interface RpcMethods {\n" + methods + "  }\n\n";
+	if (const auto i = spaces.find(std::string()); i != end(spaces)) {
+		out += i->second;
+	}
+	for (const auto &[space, body] : spaces) {
+		if (!space.empty()) {
+			out += "\n  namespace " + space + " {\n" + body + "  }\n";
+		}
+	}
+	out += "}\n";
+	out += kModule;
+	return QByteArray::fromStdString(out);
+}
+
+} // namespace
+
+const QByteArray &Typings() {
+	static const auto result = Generator(TlRuntime::BundledSchema())
+		.generate();
+	return result;
+}
+
+void WriteTypings(const QString &folder) {
+	const auto dir = QDir(folder);
+	if (!dir.exists()) {
+		return;
+	}
+	const auto &content = Typings();
+	auto typings = QFile(dir.filePath(u"tele.d.ts"_q));
+	if (!typings.open(QIODevice::ReadOnly) || typings.readAll() != content) {
+		typings.close();
+		if (typings.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+			typings.write(content);
+		}
+	}
+	auto config = QFile(dir.filePath(u"tsconfig.json"_q));
+	if (!config.exists() && config.open(QIODevice::WriteOnly)) {
+		config.write(kTsConfig);
+	}
+}
+
+} // namespace Tele::Scripting
