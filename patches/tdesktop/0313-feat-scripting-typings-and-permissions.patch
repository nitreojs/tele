+[[nodiscard]] QString Joined(const std::vector<std::string> &names) {
+	auto result = QStringList();
+	for (const auto &name : names) {
+		result.push_back(QString::fromStdString(name));
+	}
+	return result.join(u", "_q);
+}
+
+[[nodiscard]] TextWithEntities Describe(
+		const QString &name,
+		const QStringList &requested) {
+	auto error = QString();
+	const auto permissions = Permissions::Parse(requested, error);
+	struct Group {
+		Capability capability;
+		QString everything;
+		QString some;
+		QString danger;
+	};
+	const auto groups = std::array<Group, 4>{ {
+		{
+			Capability::Updates,
+			Lower(u"See everything this account receives."_q),
+			Lower(u"See these updates: %1."_q),
+			QString(),
+		},
+		{
+			Capability::Call,
+			Lower(u"Send any request as you, except dangerous ones."_q),
+			Lower(u"Send these requests as you: %1."_q),
+			Lower(u"send"_q),
+		},
+		{
+			Capability::Requests,
+			Lower(u"Change or block any request tele sends, "
+				"except dangerous ones."_q),
+			Lower(u"Change or block these requests from tele: %1."_q),
+			Lower(u"change or block"_q),
+		},
+		{
+			Capability::Results,
+			Lower(u"Change any answer tele receives, "
+				"except to dangerous requests."_q),
+			Lower(u"Change the answers to: %1."_q),
+			Lower(u"change the answers to"_q),
+		},
+	} };
+	auto result = TextWithEntities{
+		Lower(u"%1 asks to:"_q).arg(name),
+	};
+	auto dangerous = QStringList();
+	for (const auto &group : groups) {
+		auto everything = false;
+		auto some = std::vector<std::string>();
+		auto risky = std::vector<std::string>();
+		for (const auto &grant : permissions.grants()) {
+			if (grant.capability != group.capability) {
+				continue;
+			} else if (grant.pattern.empty()) {
+				everything = true;
+			} else if (!IsGlob(grant.pattern)
+				&& DangerousName(grant.capability, grant.pattern)) {
+				risky.push_back(grant.pattern);
+			} else {
+				some.push_back(grant.pattern);
+			}
+		}
+		if (everything) {
+			result.append(u"\n\u2022 "_q).append(group.everything);
+		} else if (!some.empty()) {
+			result.append(u"\n\u2022 "_q).append(group.some.arg(Joined(some)));
+		}
+		if (!risky.empty()) {
+			dangerous.push_back(group.danger + ' ' + Joined(risky));
+		}
+	}
+	if (!dangerous.isEmpty()) {
+		result.append(u"\n\n"_q).append(
+			Ui::Text::Bold(Lower(u"Dangerous: %1."_q).arg(
+				dangerous.join(u"; "_q))));
+	}
+	return result;
+}
