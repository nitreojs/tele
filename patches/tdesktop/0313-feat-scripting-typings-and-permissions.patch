@@ -0,0 +1,47 @@
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Tele::Scripting {
+
+enum class Capability : uchar {
+	Updates,
+	Call,
+	Requests,
+	Results,
+};
+
+struct Grant {
+	Capability capability = Capability::Call;
+	std::string pattern;
+
+	friend inline bool operator==(const Grant &, const Grant &) = default;
+};
+
+class Permissions final {
+public:
+	[[nodiscard]] static Permissions Parse(
+		const QStringList &list,
+		QString &error);
+
+	[[nodiscard]] bool allows(
+		Capability capability,
+		std::string_view name) const;
+	[[nodiscard]] bool any(Capability capability) const;
+	[[nodiscard]] bool covers(const Permissions &other) const;
+	[[nodiscard]] bool empty() const;
+	[[nodiscard]] QStringList strings() const;
+	[[nodiscard]] const std::vector<Grant> &grants() const;
+
+private:
+	std::vector<Grant> _grants;
+
+};
+
+[[nodiscard]] const char *CapabilityName(Capability capability);
+[[nodiscard]] bool DangerousName(Capability capability, std::string_view name);
+[[nodiscard]] bool IsGlob(std::string_view pattern);
+
+} // namespace Tele::Scripting
