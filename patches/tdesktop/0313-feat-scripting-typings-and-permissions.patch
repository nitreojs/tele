+
+constexpr auto kHelpers = R"ts(
+  interface TlObject {
+    _: string
+  }
+
+  type RpcMethod = keyof RpcMethods
+  type AnyRequest = RpcMethods[RpcMethod]['request']
+  type RpcResult<N extends RpcMethod> = RpcMethods[N]['result']
+
+  type AnyUpdate =
+    | tl.TypeUpdate
+    | tl.RawUpdateShortMessage
+    | tl.RawUpdateShortChatMessage
+    | tl.RawUpdateShortSentMessage
+  type UpdateName = AnyUpdate['_']
+  type UpdateOf<N extends UpdateName> = Extract<AnyUpdate, { _: N }>
+)ts";
+
+constexpr auto kModule = R"ts(
+declare module 'tele' {
+  export interface Peers {
+    users: tl.TypeUser[]
+    chats: tl.TypeChat[]
+  }
+
+  export interface RpcError extends Error {
+    code: number
+    type: string
+  }
+
+  type Scope<T extends string> = T | `${string}*`
+
+  export type Permission =
+    | 'updates'
+    | `updates:${Scope<tl.UpdateName>}`
+    | 'call'
+    | `call:${Scope<tl.RpcMethod>}`
+    | 'requests'
+    | `requests:${Scope<tl.RpcMethod>}`
+    | 'results'
+    | `results:${Scope<tl.RpcMethod>}`
+
+  export type RequestHookResult<N extends tl.RpcMethod = tl.RpcMethod> =
+    | void
+    | null
+    | false
+    | tl.AnyRequest
+    | { result: tl.RpcResult<N> }
+    | { error: string; code?: number }
+
+  export type Listener<N extends tl.UpdateName = tl.UpdateName> = (
+    update: tl.UpdateOf<N>,
+    peers: Peers,
+  ) => unknown
+  export type AnyListener = (update: tl.AnyUpdate, peers: Peers) => unknown
+  export type RequestHook<N extends tl.RpcMethod> = (
+    request: tl.RpcMethods[N]['request'],
+  ) => RequestHookResult<N>
+  export type AnyRequestHook = (request: tl.AnyRequest) => RequestHookResult
+  export type ResultHook<N extends tl.RpcMethod> = (
+    result: tl.RpcResult<N> | tl.RawRpcError,
+    request: tl.RpcMethods[N]['request'] | undefined,
+  ) => unknown
+  export type AnyResultHook = (
+    result: unknown,
+    request: tl.AnyRequest | undefined,
+  ) => unknown
+
+  export interface Tg {
+    readonly selfId: bigint
+    readonly scriptName: string
+    call<R extends tl.AnyRequest>(request: R): Promise<tl.RpcResult<R['_']>>
+    on<N extends tl.UpdateName>(name: N, listener: Listener<N>): void
+    on(name: 'update' | '*', listener: AnyListener): void
+    off<N extends tl.UpdateName>(name: N, listener: Listener<N>): void
+    off(name: 'update' | '*', listener: AnyListener): void
+    onRequest<N extends tl.RpcMethod>(method: N, hook: RequestHook<N>): void
+    onRequest(method: '*', hook: AnyRequestHook): void
+    offRequest<N extends tl.RpcMethod>(method: N, hook: RequestHook<N>): void
+    offRequest(method: '*', hook: AnyRequestHook): void
+    onResult<N extends tl.RpcMethod>(method: N, hook: ResultHook<N>): void
+    onResult(method: '*', hook: AnyResultHook): void
+    offResult<N extends tl.RpcMethod>(method: N, hook: ResultHook<N>): void
+    offResult(method: '*', hook: AnyResultHook): void
+  }
+
+  export type Cleanup = () => void
+
+  export interface ScriptDefinition {
