+
+using TlRuntime::Combinator;
+using TlRuntime::Param;
+
+constexpr auto kTsConfig = R"json({
+  "compilerOptions": {
+    "target": "ESNext",
+    "module": "ESNext",
+    "moduleResolution": "Bundler",
+    "lib": ["ESNext"],
+    "types": [],
+    "strict": true,
