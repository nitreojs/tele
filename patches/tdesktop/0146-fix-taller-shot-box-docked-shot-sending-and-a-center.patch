From: nitreojs <hello@starkow.dev>
Date: Wed, 30 Sep 2026 04:12:01 +0300
Subject: [PATCH] fix: taller shot box, docked shot sending and a centered
 draft button

---
 .../SourceFiles/tele/tele_docked_media.cpp    | 16 ++++++++++++++
 Telegram/SourceFiles/tele/tele_docked_media.h |  4 ++++
 .../SourceFiles/tele/tele_drafts_compose.cpp  | 12 +++++++++--
 Telegram/SourceFiles/tele/tele_shot.cpp       | 21 ++++++++++++++-----
 4 files changed, 46 insertions(+), 7 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_docked_media.cpp b/Telegram/SourceFiles/tele/tele_docked_media.cpp
index 281ebdbcf6b678fe928b4bf006f67127b715d418..bea3f20670942e13e920cda991455d3e15feb2b5 100644
--- a/Telegram/SourceFiles/tele/tele_docked_media.cpp
+++ b/Telegram/SourceFiles/tele/tele_docked_media.cpp
@@ -4278,6 +4278,22 @@ void DockedAfterSend(
 	Docked(session).setAfterSend({ .thread = thread }, std::move(callback));
 }
 
+bool DockedAdd(
+		not_null<Data::Thread*> thread,
+		std::shared_ptr<ChatHelpers::Show> show,
+		Ui::PreparedList &list) {
+	if (!DockedAttachments()
+		|| list.error != Ui::PreparedList::Error::None
+		|| (list.files.empty() && list.filesToProcess.empty())) {
+		return false;
+	}
+	Docked(&thread->session()).add(
+		{ .thread = DraftsThread::From(thread) },
+		std::move(show),
+		std::move(list));
+	return true;
+}
+
 bool ComposeDockedAdd(ComposeDocked *docked, Ui::PreparedList &list) {
 	return docked && docked->add(list);
 }
diff --git a/Telegram/SourceFiles/tele/tele_docked_media.h b/Telegram/SourceFiles/tele/tele_docked_media.h
index 2b41a7d9555b70c8ef1071f9bb742c5e2dbfe4c6..f850a547573f1ad03b8aa57e02f0c9b471592259 100644
