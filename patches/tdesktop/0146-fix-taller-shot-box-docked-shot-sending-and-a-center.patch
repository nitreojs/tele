+++ b/Telegram/SourceFiles/tele/tele_docked_media.h
@@ -158,6 +158,10 @@ void DockedAfterSend(
 	not_null<Main::Session*> session,
 	DraftsThread thread,
 	Fn<void()> callback);
+bool DockedAdd(
+	not_null<Data::Thread*> thread,
+	std::shared_ptr<ChatHelpers::Show> show,
+	Ui::PreparedList &list);
 
 bool ComposeDockedAdd(ComposeDocked *docked, Ui::PreparedList &list);
 bool ComposeDockedSend(ComposeDocked *docked, Api::SendOptions options);
diff --git a/Telegram/SourceFiles/tele/tele_drafts_compose.cpp b/Telegram/SourceFiles/tele/tele_drafts_compose.cpp
index 8e1ab80d788f742a0629f37c935877c1bf81c10c..292ee1c2f48008f225179d8da56648faffa94ebb 100644
--- a/Telegram/SourceFiles/tele/tele_drafts_compose.cpp
+++ b/Telegram/SourceFiles/tele/tele_drafts_compose.cpp
@@ -1208,10 +1208,18 @@ void SendFilesBoxAccess::AddButton(not_null<SendFilesBox*> box) {
 	if (!Allowed(box)) {
 		return;
 	}
-	const auto button = box->addTopButton(box->_st.files.menu, [=] {
+	const auto &menu = box->_st.files.menu;
+	const auto &icon = st::menuIconArchive;
+	const auto area = menu.rippleAreaSize;
+	const auto centered = std::make_shared<style::IconButton>(menu);
+	centered->iconPosition = menu.rippleAreaPosition + QPoint(
+		(area - icon.width()) / 2,
+		(area - icon.height()) / 2);
+	const auto button = box->addTopButton(*centered, [=] {
 		Save(box, false);
 	});
-	button->setIconOverride(&st::menuIconArchive, &st::menuIconArchive);
+	button->lifetime().add([centered] {});
+	button->setIconOverride(&icon, &icon);
 	button->setAccessibleName(Lower(u"Save as draft"_q));
 }
 
