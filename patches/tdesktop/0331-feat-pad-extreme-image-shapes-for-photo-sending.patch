diff --git a/Telegram/SourceFiles/tele/tele_photo_padding.cpp b/Telegram/SourceFiles/tele/tele_photo_padding.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f75653a803b16691235125aefc88162d5b016d9e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_photo_padding.cpp
@@ -0,0 +1,96 @@
+#include "tele/tele_photo_padding.h"
+
+#include "tele/tele_options.h"
+#include "editor/photo_editor_common.h"
+#include "ui/chat/attach/attach_prepare.h"
+
+#include <QtGui/QImage>
+#include <QtGui/QPainter>
+
+#include <algorithm>
+
+namespace Tele {
+
+QSize PhotoPaddingSize(QSize size) {
+	if (!PadPhotos() || size.isEmpty()) {
+		return size;
+	}
+	const auto longer = std::max(size.width(), size.height());
+	const auto minimum = longer / 20 + (longer % 20 != 0);
+	return QSize(
+		std::max(size.width(), minimum),
+		std::max(size.height(), minimum));
+}
+
+bool PadPhoto(QImage &image, int sideLimit) {
+	const auto size = PhotoPaddingSize(image.size());
+	if (image.isNull() || size == image.size()) {
+		return false;
+	}
+	Expects(sideLimit > 0);
+
+	// A decoded panorama can be huge despite containing very few pixels.
+	// Scale its content first, never allocate its full padded canvas.
+	const auto scaledSize = (image.width() > sideLimit
+		|| image.height() > sideLimit)
+		? image.size().scaled(sideLimit, sideLimit, Qt::KeepAspectRatio)
+		: image.size();
+	// QSize::scaled can round the short edge to zero for very thin images.
+	const auto contentSize = QSize(
+		std::max(scaledSize.width(), 1),
+		std::max(scaledSize.height(), 1));
+	const auto content = (contentSize == image.size())
+		? image
+		: image.scaled(
+			contentSize,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation);
+	if (content.isNull()) {
+		return false;
+	}
+	const auto paddedSize = PhotoPaddingSize(content.size());
+	if (paddedSize == content.size()) {
+		image = content;
+		return true;
+	}
+	auto padded = QImage(paddedSize, QImage::Format_ARGB32_Premultiplied);
+	if (padded.isNull()) {
+		return false;
+	}
+	padded.fill(Qt::black);
+	{
+		auto painter = QPainter(&padded);
+		painter.drawImage(
+			QRect(
+				QPoint(
+					(padded.width() - content.width()) / 2,
+					(padded.height() - content.height()) / 2),
+				content.size()),
+			content);
+	}
+	image = std::move(padded);
+	return true;
+}
+
+QImage PhotoFilePreview(const Ui::PreparedFile &file) {
+	const auto image = std::get_if<Ui::PreparedFileInformation::Image>(
+		&file.information->media);
+	if (image && !image->animated
+		&& !Ui::ValidateThumbDimensions(
+			file.originalDimensions.width(), file.originalDimensions.height())) {
+		auto raw = Editor::ImageModified(image->data, image->modifications);
+		const auto limit = std::max(file.preview.width(), file.preview.height());
+		if (limit > 0 && (raw.width() > limit || raw.height() > limit)) {
+			const auto size = raw.size().scaled(limit, limit, Qt::KeepAspectRatio);
+			raw = raw.scaled(
+				QSize(std::max(size.width(), 1), std::max(size.height(), 1)),
+				Qt::IgnoreAspectRatio,
+				Qt::SmoothTransformation);
+		}
+		return raw;
+	}
+	return file.videoCover ? file.videoCover->preview
+		: file.preview.isNull() && image ? image->data : file.preview;
+}
+
+} // namespace Tele
