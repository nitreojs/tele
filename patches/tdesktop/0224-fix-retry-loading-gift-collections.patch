From: nitreojs <hello@starkow.dev>
Date: Sun, 4 Oct 2026 11:41:26 +0300
Subject: [PATCH] fix: retry loading gift collections

---
 .../info/peer_gifts/info_peer_gifts_widget.cpp    | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/Telegram/SourceFiles/info/peer_gifts/info_peer_gifts_widget.cpp b/Telegram/SourceFiles/info/peer_gifts/info_peer_gifts_widget.cpp
index 80b13590281f6bc121afb0d892c037569dfa7424..da6263e8537b35e5a5f801162c1e58ccfd3d688d 100644
--- a/Telegram/SourceFiles/info/peer_gifts/info_peer_gifts_widget.cpp
+++ b/Telegram/SourceFiles/info/peer_gifts/info_peer_gifts_widget.cpp
@@ -63,6 +63,7 @@ constexpr auto kPreloadPages = 2;
 constexpr auto kPerPage = 50;
 constexpr auto kScrollFactor = 0.05;
 constexpr auto kPreloadButtonRows = 2;
+constexpr auto kCollectionsRetryDelay = crl::time(3000);
 
 [[nodiscard]] GiftDescriptor DescriptorForGift(
 		not_null<PeerData*> to,
@@ -218,6 +219,7 @@ private:
 	void applyUpdateTo(Entries &entries, const Data::GiftUpdate &update);
 	void switchTo(int collectionId);
 	void loadCollections();
+	void retryCollections();
 	void loadMore();
 	void loaded(const MTPpayments_SavedStarGifts &result);
 	void markInCollection(const Data::SavedStarGift &gift);
@@ -289,6 +291,7 @@ private:
 	Fn<void()> _collectionsLoadedCallback;
 	QString _offset;
 	bool _collectionsLoaded = false;
+	crl::time _collectionsFailedAt = 0;
 
 	rpl::event_stream<Descriptor> _descriptorChanges;
 	rpl::event_stream<bool> _notifyEnabled;
@@ -445,6 +448,7 @@ void InnerWidget::switchTo(int collectionId) {
 		teleShowFound();
 		return;
 	}
+	retryCollections();
 	_collectionsLoadedCallback = nullptr;
 	_api.request(base::take(_loadMoreRequestId)).cancel();
 	_entries = collectionId ? &_perCollection[collectionId] : &_all;
@@ -512,17 +516,27 @@ void InnerWidget::loadCollections() {
 		}, [&](const MTPDpayments_starGiftCollectionsNotModified &) {
 		});
 		_collectionsLoaded = true;
+		_collectionsFailedAt = 0;
 		if (const auto onstack = base::take(_collectionsLoadedCallback)) {
 			onstack();
 		}
 	}).fail([=] {
 		_collectionsLoaded = true;
+		_collectionsFailedAt = crl::now();
 		if (const auto onstack = base::take(_collectionsLoadedCallback)) {
 			onstack();
 		}
 	}).send();
 }
 
+void InnerWidget::retryCollections() {
+	if (_collectionsFailedAt
+		&& crl::now() - _collectionsFailedAt >= kCollectionsRetryDelay) {
+		_collectionsFailedAt = 0;
+		loadCollections();
+	}
+}
+
 void InnerWidget::subscribeToUpdates() {
 	_peer->owner().giftUpdates(
 	) | rpl::on_next([=](const Data::GiftUpdate &update) {
@@ -688,6 +702,7 @@ void InnerWidget::markUnpinned(std::vector<Entry>::iterator i) {
 void InnerWidget::visibleTopBottomUpdated(
 		int visibleTop,
 		int visibleBottom) {
+	retryCollections();
 	const auto page = (visibleBottom - visibleTop);
 	if (visibleBottom + page * kPreloadPages >= height()) {
 		loadMore();
