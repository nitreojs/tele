+			return pair.second.kind == Kind::Decorator;
+		});
+}
+
+void Instance::decorate(FullMsgId id, std::string_view bytes) {
+	auto ids = std::vector<int>();
+	for (const auto &[key, registration] : _registrations) {
+		if (registration.kind == Kind::Decorator) {
+			ids.push_back(key);
+		}
+	}
+	for (const auto key : ids) {
+		decorateWith(key, id, bytes);
+	}
+}
+
+void Instance::decorateWith(
+		int registration,
+		FullMsgId id,
+		std::string_view bytes) {
+	const auto i = _registrations.find(registration);
+	if (!_engine || i == end(_registrations)) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto decoded = DecodeTl(ctx, bytes, "Message", filter());
+	if (!decoded.error.empty()) {
+		return;
+	}
+	const auto key = ++_decorateRunKey;
+	_decorateRuns.emplace(key, DecorateRun{
+		.id = id,
+		.registration = registration,
+	});
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleRunDecorator");
+	JS_FreeValue(ctx, global);
+	auto fn = JS_DupValue(ctx, i->second.fn);
+	JSValueConst call[] = { fn, decoded.value };
+	auto promise = invoke(runner, call, kListenerBudget, u"decorateMessages"_q);
+	for (const auto item : { runner, fn, decoded.value }) {
+		JS_FreeValue(ctx, item);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		_decorateRuns.erase(key);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, DecoratorSettled, key));
+	_engine->drain();
+}
+
+std::optional<MessageDecoration> Instance::decorationFromValue(
+		JSValueConst value,
+		QString &error) {
+	const auto ctx = _engine->ctx();
+	if (!JS_IsObject(value)) {
+		error = u"a decoration is an object"_q;
+		return std::nullopt;
+	}
+	auto result = MessageDecoration();
+	auto text = JS_GetPropertyStr(ctx, value, "text");
+	if (JS_IsString(text)) {
+		result.text = TextWithEntities{ FromStd(ToStd(ctx, text)) };
+	} else if (JS_IsObject(text)) {
+		auto body = JS_GetPropertyStr(ctx, text, "text");
+		auto list = JS_GetPropertyStr(ctx, text, "entities");
+		auto parsed = TextWithEntities{
+			JS_IsString(body) ? FromStd(ToStd(ctx, body)) : QString(),
+		};
+		if (JS_IsArray(list)) {
+			auto encoded = EncodeTl(ctx, list, "Vector<MessageEntity>");
+			auto entities = MTPVector<MTPMessageEntity>();
+			auto from = reinterpret_cast<const mtpPrime*>(
+				encoded.bytes.data());
+			const auto till = from
+				+ (encoded.bytes.size() / sizeof(mtpPrime));
+			if (!encoded.error.empty() || !entities.read(from, till)) {
+				error = u"text.entities are wrong: "_q
+					+ FromStd(encoded.error);
+			} else {
+				parsed.entities = Api::EntitiesFromMTP(_session, entities.v);
+			}
+		}
+		JS_FreeValue(ctx, body);
+		JS_FreeValue(ctx, list);
+		result.text = std::move(parsed);
+	} else if (!JS_IsUndefined(text)) {
+		error = u"text is a string or { text, entities }"_q;
+	}
+	JS_FreeValue(ctx, text);
+	auto opacity = JS_GetPropertyStr(ctx, value, "opacity");
+	auto number = double();
+	if (JS_IsNumber(opacity)
+		&& !JS_ToFloat64(ctx, &number, opacity)
+		&& number >= 0.
+		&& number <= 1.) {
+		result.opacity = number;
+	} else if (!JS_IsUndefined(opacity)) {
+		error = u"opacity is a number from 0 to 1"_q;
+	}
+	JS_FreeValue(ctx, opacity);
+	auto hidden = JS_GetPropertyStr(ctx, value, "hidden");
+	if (JS_IsBool(hidden)) {
+		result.hidden = (JS_ToBool(ctx, hidden) != 0);
+	} else if (!JS_IsUndefined(hidden)) {
+		error = u"hidden is a boolean"_q;
+	}
+	JS_FreeValue(ctx, hidden);
+	auto badge = JS_GetPropertyStr(ctx, value, "badge");
+	if (JS_IsString(badge)) {
+		result.badge = FromStd(ToStd(ctx, badge));
+	} else if (!JS_IsUndefined(badge)) {
+		error = u"badge is a string"_q;
+	}
+	JS_FreeValue(ctx, badge);
+	if (!error.isEmpty()) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+JSValue Instance::NativeDecorate(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = instance->_session;
+	const auto readable = instance->_permissions.allows(
+		Capability::AccountRead,
+		"messages");
+	if (magic == 0) {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.decorateMessages(function)");
+		} else if (!readable) {
+			return ThrowNotGranted(
+				ctx,
+				u"tg.decorateMessages"_q,
+				GrantText(Capability::AccountRead, "messages"));
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = Kind::Decorator,
+			.fn = JS_DupValue(ctx, argv[0]),
+		});
+		const auto weak = base::make_weak(instance);
+		crl::on_main(weak, [=] {
+			const auto strong = weak.get();
+			if (!strong || !strong->_engine) {
+				return;
+			}
+			for (const auto &entry : LoadedCachedMessages(strong->_session)) {
+				if (!strong->_engine || !strong->_registrations.contains(id)) {
+					return;
+				}
+				strong->decorateWith(id, entry.id, entry.bytes);
+			}
+		});
+		return instance->disposer(id);
+	}
+	const auto chat = (argc > 0 && !JS_IsNull(argv[0]))
+		? PeerFromValue(ctx, argv[0], session->user()->id)
+		: std::optional<PeerId>(PeerId());
+	auto id = std::int64_t();
+	if (!chat
+		|| (magic == 1 && !*chat)
+		|| argc < 2
+		|| !JS_IsNumber(argv[1])
+		|| JS_ToInt64(ctx, &id, argv[1])) {
+		return JS_ThrowTypeError(ctx, "needs a chat and a message id");
+	} else if (magic == 2) {
+		if (!readable) {
+			return JS_UNDEFINED;
+		}
+		const auto bytes = CachedMessage(session, *chat, MsgId(id));
+		if (!bytes) {
+			return JS_UNDEFINED;
+		}
+		auto decoded = DecodeTl(ctx, *bytes, "Message", instance->filter());
+		return decoded.error.empty() ? decoded.value : JS_UNDEFINED;
+	}
+	const auto full = FullMsgId(*chat, MsgId(id));
+	if (argc < 3 || JS_IsNull(argv[2]) || JS_IsUndefined(argv[2])) {
+		SetMessageDecoration(session, full, instance, 0, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto error = QString();
+	auto value = instance->decorationFromValue(argv[2], error);
+	if (!value) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.decorateMessage: %s",
+			error.toUtf8().constData());
+	}
+	SetMessageDecoration(session, full, instance, 0, std::move(*value));
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::DecoratorSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto i = instance->_decorateRuns.find(magic / 2);
+	if (i == end(instance->_decorateRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto run = i->second;
+	instance->_decorateRuns.erase(i);
+	if (!instance->_registrations.contains(run.registration)) {
+		return JS_UNDEFINED;
+	}
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	const auto where = u"decorateMessages"_q;
+	if (!(magic % 2)) {
+		instance->fault(where, instance->_engine->describe(value));
+		return JS_UNDEFINED;
+	} else if (JS_IsNull(value) || JS_IsUndefined(value)) {
+		SetMessageDecoration(
+			instance->_session,
+			run.id,
+			instance,
+			run.registration,
+			std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto error = QString();
+	auto decoration = instance->decorationFromValue(value, error);
+	if (!decoration) {
+		instance->fault(where, error);
+		return JS_UNDEFINED;
+	}
+	SetMessageDecoration(
+		instance->_session,
+		run.id,
+		instance,
+		run.registration,
+		std::move(*decoration));
+	return JS_UNDEFINED;
+}
