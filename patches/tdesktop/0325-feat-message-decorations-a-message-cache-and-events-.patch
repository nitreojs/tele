+bool Host::running() const {
+	return ranges::any_of(_entries, [](const Entry &entry) {
+		return entry.instance != nullptr;
+	});
+}
+
+void Host::dispatchMessage(FullMsgId id, const std::string &bytes) {
+	for (auto &entry : _entries) {
+		if (entry.instance && entry.instance->decorates()) {
+			entry.instance->decorate(id, bytes);
+		}
+	}
+}
+
+void Host::feedDeleted(PeerId channel, const QVector<MTPint> &ids) {
+	if (ids.isEmpty()) {
+		return;
+	}
+	const auto count = MTP_int(ids.size());
+	const auto update = peerIsChannel(channel)
+		? MTP_updateDeleteChannelMessages(
+			MTP_long(peerToChannel(channel).bare),
+			MTP_vector<MTPint>(ids),
+			MTP_int(0),
+			count)
+		: MTP_updateDeleteMessages(
+			MTP_vector<MTPint>(ids),
+			MTP_int(0),
+			count);
+	auto buffer = mtpBuffer();
+	MTPUpdates(
+		MTP_updateShort(update, MTP_int(base::unixtime::now()))
+	).write(buffer);
+	crl::on_main(this, [=, bytes = std::string(
+			View(buffer.constData(), buffer.size()))] {
+		feed(bytes);
+	});
+}
+
 void Host::feed(std::string_view bytes) {
 	for (auto &entry : _entries) {
 		if (entry.instance && entry.instance->listens()) {
@@ -1485,6 +1534,29 @@ bool BeforeUpdate(
