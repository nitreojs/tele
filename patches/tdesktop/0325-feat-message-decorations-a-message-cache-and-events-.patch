@@ -0,0 +1,377 @@
+#include "tele/scripting/tele_script_messages.h"
+
+#include "api/api_text_entities.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+#include "tele/scripting/tele_script_hooks.h"
+
+#include <deque>
+#include <map>
+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kCacheLimit = std::size_t(20000);
+
+using Key = std::tuple<const void*, uint64, int64>;
+
+struct Cached {
+	FullMsgId id;
+	std::string bytes;
+	uint64 generation = 0;
+};
+
+struct Cache {
+	std::map<Key, Cached> entries;
+	std::deque<std::pair<Key, uint64>> order;
+	uint64 generation = 0;
+};
+
+struct Layer {
+	const void *owner = nullptr;
+	int layer = 0;
+	MessageDecoration value;
+};
+
+struct Decorated {
+	std::vector<Layer> layers;
+	MessageDecoration merged;
+};
+
+[[nodiscard]] Cache &CacheState() {
+	static auto result = Cache();
+	return result;
+}
+
+[[nodiscard]] std::map<Key, Decorated> &Decorations() {
+	static auto result = std::map<Key, Decorated>();
+	return result;
+}
+
+[[nodiscard]] Key CacheKeyOf(
+		not_null<const Main::Session*> session,
+		PeerId peer,
+		MsgId id) {
+	return Key(
+		session.get(),
+		peerIsChannel(peer) ? peer.value : uint64(),
+		id.bare);
+}
+
+[[nodiscard]] Key ItemKey(not_null<const HistoryItem*> item) {
+	return Key(
+		&item->history()->session(),
+		item->history()->peer->id.value,
+		item->id.bare);
+}
+
+[[nodiscard]] const MessageDecoration *Find(
+		not_null<const HistoryItem*> item) {
+	const auto &decorations = Decorations();
+	if (decorations.empty()) {
+		return nullptr;
+	}
+	const auto i = decorations.find(ItemKey(item));
+	return (i != end(decorations)) ? &i->second.merged : nullptr;
+}
+
+[[nodiscard]] MessageDecoration Merge(const std::vector<Layer> &layers) {
+	auto result = MessageDecoration();
+	for (const auto &layer : layers) {
+		const auto &value = layer.value;
+		if (value.text) {
+			result.text = value.text;
+		}
+		if (value.opacity) {
+			result.opacity = value.opacity;
+		}
+		if (value.hidden) {
+			result.hidden = value.hidden;
+		}
+		if (value.badge) {
+			result.badge = value.badge;
+		}
+	}
+	return result;
+}
+
+void Refresh(not_null<Main::Session*> session, FullMsgId id) {
+	auto &owner = session->data();
+	if (const auto item = owner.message(id)) {
+		owner.requestItemViewRefresh(item);
+		owner.requestItemResize(item);
+	}
+}
+
+void Store(
+		not_null<Main::Session*> session,
+		not_null<HistoryItem*> item,
+		std::string bytes) {
+	auto &cache = CacheState();
+	const auto key = CacheKeyOf(session, item->history()->peer->id, item->id);
+	const auto generation = ++cache.generation;
+	cache.entries[key] = Cached{
+		.id = item->fullId(),
+		.bytes = std::move(bytes),
+		.generation = generation,
+	};
+	cache.order.emplace_back(key, generation);
+	while (cache.entries.size() > kCacheLimit && !cache.order.empty()) {
+		const auto [oldest, stamp] = cache.order.front();
+		cache.order.pop_front();
+		const auto i = cache.entries.find(oldest);
+		if (i != end(cache.entries) && i->second.generation == stamp) {
+			cache.entries.erase(i);
+		}
+	}
+	if (cache.order.size() > 4 * kCacheLimit) {
+		auto order = std::deque<std::pair<Key, uint64>>();
+		for (const auto &[key, stamp] : cache.order) {
+			const auto i = cache.entries.find(key);
+			if (i != end(cache.entries) && i->second.generation == stamp) {
+				order.emplace_back(key, stamp);
+			}
+		}
+		cache.order = std::move(order);
+	}
+}
+
+} // namespace
+
+void MessageArrived(
+		not_null<HistoryItem*> item,
+		const MTPMessage &message,
+		bool fresh) {
+	const auto session = &item->history()->session();
+	if (!CapturesMessages(session)) {
+		return;
+	}
+	auto buffer = mtpBuffer();
+	message.write(buffer);
+	auto bytes = std::string(
+		reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(mtpPrime));
+	Store(session, item, bytes);
+	if (fresh) {
+		DispatchMessage(session, item->fullId(), bytes);
+	}
+}
+
+void MessageApplied(
+		not_null<Main::Session*> session,
+		const MTPMessage &message) {
+	if (message.type() != mtpc_message || !CapturesMessages(session)) {
+		return;
+	}
+	const auto &data = message.c_message();
+	const auto item = session->data().message(
+		peerFromMTP(data.vpeer_id()),
+		data.vid().v);
+	if (item) {
+		MessageArrived(item, message, true);
+	}
+}
+
+void ShortSentArrived(
+		not_null<HistoryItem*> item,
+		const MTPDupdateShortSentMessage &data) {
+	const auto session = &item->history()->session();
+	if (!CapturesMessages(session)) {
+		return;
+	}
+	using Flag = MTPDmessage::Flag;
+	const auto &text = item->originalText();
+	const auto entities = Api::EntitiesToMTP(
+		session,
+		text.entities,
+		Api::ConvertOption::SkipLocal);
+	const auto media = data.vmedia();
+	const auto ttl = data.vttl_period();
+	const auto flags = Flag::f_out
+		| Flag::f_from_id
+		| (entities.v.isEmpty() ? Flag() : Flag::f_entities)
+		| (media ? Flag::f_media : Flag())
+		| (ttl ? Flag::f_ttl_period : Flag());
+	MessageArrived(item, MTP_message(
+		MTP_flags(flags),
+		data.vid(),
+		peerToMTP(session->userPeerId()),
+		MTPint(),
+		MTPstring(),
+		peerToMTP(item->history()->peer->id),
+		MTPPeer(),
+		MTPMessageFwdHeader(),
+		MTPlong(),
+		MTPlong(),
+		MTPPeer(),
+		MTPMessageReplyHeader(),
+		data.vdate(),
+		MTP_string(text.text),
+		media ? *media : MTPMessageMedia(),
+		MTPReplyMarkup(),
+		entities,
+		MTPint(),
+		MTPint(),
+		MTPMessageReplies(),
+		MTPint(),
+		MTPstring(),
+		MTPlong(),
+		MTPMessageReactions(),
+		MTPVector<MTPRestrictionReason>(),
+		ttl ? *ttl : MTPint(),
+		MTPint(),
+		MTPlong(),
+		MTPFactCheck(),
+		MTPint(),
+		MTPlong(),
+		MTPSuggestedPost(),
+		MTPint(),
+		MTPstring(),
+		MTPRichMessage()), true);
+}
+
+std::optional<std::string> CachedMessage(
+		not_null<Main::Session*> session,
+		PeerId peer,
+		MsgId id) {
+	const auto &entries = CacheState().entries;
+	const auto i = entries.find(CacheKeyOf(session, peer, id));
+	if (i == end(entries)) {
+		return std::nullopt;
+	}
+	return i->second.bytes;
+}
+
+std::vector<CachedEntry> LoadedCachedMessages(
+		not_null<Main::Session*> session) {
+	auto result = std::vector<CachedEntry>();
+	auto &owner = session->data();
+	for (const auto &[key, cached] : CacheState().entries) {
+		if (std::get<0>(key) == session.get() && owner.message(cached.id)) {
+			result.push_back({ .id = cached.id, .bytes = cached.bytes });
+		}
+	}
+	return result;
+}
+
+void ForgetMessages(not_null<Main::Session*> session) {
+	auto &cache = CacheState();
+	for (auto i = begin(cache.entries); i != end(cache.entries);) {
+		if (std::get<0>(i->first) == session.get()) {
+			i = cache.entries.erase(i);
+		} else {
+			++i;
+		}
+	}
+	auto &decorations = Decorations();
+	for (auto i = begin(decorations); i != end(decorations);) {
+		if (std::get<0>(i->first) == session.get()) {
+			i = decorations.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+void SetMessageDecoration(
+		not_null<Main::Session*> session,
+		FullMsgId id,
+		const void *owner,
+		int layer,
+		std::optional<MessageDecoration> value) {
+	auto &decorations = Decorations();
+	const auto key = Key(session.get(), id.peer.value, id.msg.bare);
+	auto i = decorations.find(key);
+	if (!value && i == end(decorations)) {
+		return;
+	} else if (i == end(decorations)) {
+		i = decorations.emplace(key, Decorated()).first;
+	}
+	auto &layers = i->second.layers;
+	const auto j = ranges::find_if(layers, [&](const Layer &existing) {
+		return existing.owner == owner && existing.layer == layer;
+	});
+	if (value) {
+		if (j != end(layers)) {
+			j->value = std::move(*value);
+		} else {
+			layers.push_back({
+				.owner = owner,
+				.layer = layer,
+				.value = std::move(*value),
+			});
+		}
+	} else if (j != end(layers)) {
+		layers.erase(j);
+	} else {
+		return;
+	}
+	if (layers.empty()) {
+		decorations.erase(i);
+	} else {
+		i->second.merged = Merge(layers);
+	}
+	Refresh(session, id);
+}
+
+void RemoveMessageDecorations(const void *owner, std::optional<int> layer) {
+	auto &decorations = Decorations();
+	auto changed = std::vector<std::pair<Main::Session*, FullMsgId>>();
+	for (auto i = begin(decorations); i != end(decorations);) {
+		auto &layers = i->second.layers;
+		const auto removed = ranges::remove_if(layers, [&](const Layer &l) {
+			return l.owner == owner && (!layer || l.layer == *layer);
+		});
+		if (removed == end(layers)) {
+			++i;
+			continue;
+		}
+		layers.erase(removed, end(layers));
+		const auto &[session, peer, msg] = i->first;
+		changed.emplace_back(
+			static_cast<Main::Session*>(const_cast<void*>(session)),
+			FullMsgId(PeerId(peer), MsgId(msg)));
+		if (layers.empty()) {
+			i = decorations.erase(i);
+		} else {
+			i->second.merged = Merge(layers);
+			++i;
+		}
+	}
+	for (const auto &[session, id] : changed) {
+		Refresh(session, id);
+	}
+}
+
+TextWithEntities DecoratedText(
+		not_null<const HistoryItem*> item,
+		TextWithEntities text) {
+	const auto decoration = Find(item);
+	return (decoration && decoration->text)
+		? *decoration->text
+		: std::move(text);
+}
+
+bool DecoratedHidden(not_null<const HistoryItem*> item) {
+	const auto decoration = Find(item);
+	return decoration && decoration->hidden.value_or(false);
+}
+
+double DecoratedOpacity(not_null<const HistoryItem*> item) {
+	const auto decoration = Find(item);
+	return decoration ? decoration->opacity.value_or(1.) : 1.;
+}
+
+QString DecoratedBadge(not_null<const HistoryItem*> item, QString author) {
+	const auto decoration = Find(item);
+	if (!decoration || !decoration->badge || decoration->badge->isEmpty()) {
+		return author;
+	}
+	return author.isEmpty()
+		? *decoration->badge
+		: (author + u" \u00B7 "_q + *decoration->badge);
+}
+
+} // namespace Tele::Scripting
