+}
+
+void DispatchMessage(
+		not_null<Main::Session*> session,
+		FullMsgId id,
+		const std::string &bytes) {
+	if (const auto host = Host::Find(session)) {
+		host->dispatchMessage(id, bytes);
+	}
+}
+
+void FeedDeleted(
+		not_null<Main::Session*> session,
+		PeerId channel,
+		const QVector<MTPint> &ids) {
+	if (const auto host = Host::Find(session)) {
+		host->feedDeleted(channel, ids);
+	}
+}
