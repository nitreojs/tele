+						chatId,
+						ids: update.messages,
+						messages: update.messages.map((id) => {
+							const raw = given.cached(chatId, id);
+							return (raw === undefined) ? null : new Message(raw, tg);
+						}),
+					});
+				});
+			},
+
+			decorateMessages(decorator) {
+				return given.decorate(decorator);
+			},
+
+			async decorateMessage(peer, id, decoration) {
+				const input = await resolvePeer(peer);
+				given.decorateMessage(input, id, decoration ?? null);
+				return __teleDisposer(() => given.decorateMessage(input, id, null));
+			},
+
+			async getCachedMessage(peer, id) {
+				const raw = given.cached(await resolvePeer(peer), id);
+				return (raw === undefined) ? null : new Message(raw, tg);
 			},
