index 0000000000000000000000000000000000000000..3a733d2e92b7197f2122d21a448138a13f600614
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_round_videos.cpp
@@ -0,0 +1,279 @@
+#include "tele/tele_round_videos.h"
+
+#include "base/weak_ptr.h"
+#include "data/data_document.h"
+#include "data/data_media_types.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "history/view/history_view_list_widget.h"
+#include "history/view/history_view_message.h"
+#include "history/view/media/history_view_media.h"
+#include "main/main_session.h"
+#include "media/audio/media_audio.h"
+#include "media/player/media_player_instance.h"
+#include "tele/tele_options.h"
+#include "tele/tele_smooth_scroll.h"
+#include "ui/effects/animations.h"
+#include "styles/style_chat.h"
+
+namespace Tele {
+namespace {
+
+using namespace HistoryView;
+
+constexpr auto kDuration = crl::time(200);
+constexpr auto kPlayingSize = 400;
+constexpr auto kMinGain = 40;
+
+struct Entry {
+	Ui::Animations::Simple animation;
+	bool shown = false;
+};
+
+class Tracker final : public base::has_weak_ptr {
+public:
+	explicit Tracker(not_null<Main::Session*> session);
+	~Tracker();
+
+	[[nodiscard]] float64 progress(FullMsgId id) const;
+
+private:
+	void apply(const ::Media::Player::TrackState &state);
+	void setCurrent(FullMsgId id);
+	void toggle(FullMsgId id, bool shown);
+	void resize(FullMsgId id);
+
+	const not_null<Main::Session*> _session;
+	FullMsgId _current;
+	base::flat_map<FullMsgId, std::unique_ptr<Entry>> _entries;
+	rpl::lifetime _lifetime;
+
+};
+
+[[nodiscard]] auto Registry()
+-> base::flat_map<not_null<Main::Session*>, Tracker*> & {
+	static auto result = base::flat_map<not_null<Main::Session*>, Tracker*>();
+	return result;
+}
+
+Tracker::Tracker(not_null<Main::Session*> session)
+: _session(session) {
+	using namespace ::Media::Player;
+	Registry().emplace(session, this);
+
+	const auto player = instance();
+	player->updatedNotifier(
+	) | rpl::on_next([=](const TrackState &state) {
+		apply(state);
+	}, _lifetime);
+
+	rpl::merge(
+		player->stops(AudioMsgId::Type::Voice),
+		player->tracksFinished(
+		) | rpl::filter([](AudioMsgId::Type type) {
+			return (type == AudioMsgId::Type::Voice);
+		}) | rpl::to_empty
+	) | rpl::on_next([=] {
+		setCurrent(FullMsgId());
+	}, _lifetime);
+
+	BiggerRoundVideosValue(
+	) | rpl::on_next([=](bool enabled) {
+		crl::on_main(this, [=] {
+			if (enabled) {
+				apply(instance()->getState(AudioMsgId::Type::Voice));
+			} else {
+				setCurrent(FullMsgId());
+			}
+		});
+	}, _lifetime);
+}
+
+Tracker::~Tracker() {
+	Registry().remove(_session);
+}
+
+float64 Tracker::progress(FullMsgId id) const {
+	const auto i = _entries.find(id);
+	return (i != end(_entries))
+		? i->second->animation.value(i->second->shown ? 1. : 0.)
+		: 0.;
+}
+
+void Tracker::apply(const ::Media::Player::TrackState &state) {
+	using namespace ::Media::Player;
+	if (state.id.type() != AudioMsgId::Type::Voice) {
+		return;
+	}
+	const auto document = state.id.audio();
+	const auto id = state.id.contextId();
+	const auto round = BiggerRoundVideos()
+		&& document
+		&& document->isVideoMessage()
+		&& (&document->session() == _session);
+	if (round && !IsStoppedOrStopping(state.state)) {
+		setCurrent(id);
+	} else if (!round || state.state != State::Stopped || id != _current) {
+		setCurrent(FullMsgId());
+	}
+}
+
+void Tracker::setCurrent(FullMsgId id) {
+	if (_current == id) {
+		return;
+	}
+	const auto was = std::exchange(_current, id);
+	if (was) {
+		toggle(was, false);
+	}
+	if (id) {
+		toggle(id, true);
+	}
+}
+
+void Tracker::toggle(FullMsgId id, bool shown) {
+	for (auto i = begin(_entries); i != end(_entries);) {
+		const auto &entry = i->second;
+		if (i->first != id
+			&& !entry->shown
+			&& !entry->animation.animating()) {
+			i = _entries.erase(i);
+		} else {
+			++i;
+		}
+	}
+	auto i = _entries.find(id);
+	if (i == end(_entries)) {
+		if (!shown) {
+			return;
+		}
+		i = _entries.emplace(id, std::make_unique<Entry>()).first;
+	}
+	const auto &entry = i->second;
+	if (entry->shown == shown) {
+		return;
+	}
+	entry->shown = shown;
+	const auto from = entry->animation.value(shown ? 0. : 1.);
+	const auto to = shown ? 1. : 0.;
+	if (anim::Disabled() || ReduceMotion() || SmoothGlideActive()) {
+		entry->animation.stop();
+		resize(id);
+	} else {
+		entry->animation.start(
+			[=] { resize(id); },
+			from,
+			to,
+			kDuration,
+			anim::easeOutCubic);
+	}
+}
+
+void Tracker::resize(FullMsgId id) {
+	if (const auto item = _session->data().message(id)) {
+		_session->data().requestItemResize(item);
+	}
+}
+
+[[nodiscard]] bool Included(
+		not_null<const Element*> view,
+		not_null<const HistoryView::Media*> media) {
+	if (view->media() != media.get()) {
+		return false;
+	}
+	const auto document = media->getDocument();
+	if (!document || !document->isVideoMessage()) {
+		return false;
+	}
+	switch (view->context()) {
+	case Context::History:
+	case Context::Replies:
+	case Context::Pinned:
+	case Context::Monoforum:
+	case Context::SavedSublist:
+	case Context::ShortcutMessages:
+	case Context::ScheduledTopic:
+		break;
+	default:
+		return false;
+	}
+	if (view->Get<InstantViewMediaRuntime>()) {
+		return false;
+	} else if (const auto data = view->data()->media()
+		; data && data->ttlSeconds()) {
+		return false;
+	}
+	return (view->data()->mainView() == view.get())
+		|| dynamic_cast<const ListWidget*>(view->delegate().get());
+}
+
+[[nodiscard]] float64 Progress(
+		not_null<const Element*> view,
+		not_null<const HistoryView::Media*> media) {
+	if (!Included(view, media)) {
+		return 0.;
+	}
+	const auto session = &view->history()->session();
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	const auto tracker = (i != end(registry))
+		? i->second
+		: session->lifetime().make_state<Tracker>(session);
+	return tracker->progress(view->data()->fullId());
+}
+
+[[nodiscard]] int Grown(int normal, int target, float64 progress) {
+	return normal + int(base::SafeRound((target - normal) * progress));
+}
+
+} // namespace
+
+bool RoundVideoResized(
+		not_null<const Element*> view,
+		not_null<const HistoryView::Media*> media) {
+	return Progress(view, media) > 0.;
+}
+
+int RoundVideoSize(
+		not_null<const Element*> view,
+		not_null<const HistoryView::Media*> media,
+		int normal) {
+	return (Progress(view, media) > 0.)
+		? std::max(style::ConvertScale(kPlayingSize), normal)
+		: normal;
+}
+
+int RoundVideoFit(
+		not_null<const Element*> view,
+		not_null<const HistoryView::Media*> media,
+		int normal,
+		int available,
+		int additional) {
+	const auto progress = Progress(view, media);
+	const auto target = std::min(
+		style::ConvertScale(kPlayingSize),
+		available - additional);
+	const auto size = (target - normal < style::ConvertScale(kMinGain))
+		? normal
+		: Grown(normal, target, progress);
+	return std::max(std::min(size, available), 1);
+}
+
+QSize RoundVideoSource(
+		not_null<const Element*> view,
+		not_null<const HistoryView::Media*> media,
+		QSize size,
+		int maxSize) {
+	if (size.isEmpty()
+		|| maxSize <= st::maxVideoMessageSize
+		|| size.width() >= maxSize
+		|| size.height() >= maxSize
+		|| !RoundVideoResized(view, media)) {
+		return size;
+	}
+	return size.scaled(maxSize, maxSize, Qt::KeepAspectRatio);
+}
+
+} // namespace Tele
