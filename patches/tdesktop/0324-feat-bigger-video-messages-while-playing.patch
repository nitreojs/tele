+} // namespace HistoryView
+
+namespace Tele {
+
+[[nodiscard]] bool RoundVideoResized(
+	not_null<const HistoryView::Element*> view,
+	not_null<const HistoryView::Media*> media);
+[[nodiscard]] int RoundVideoSize(
+	not_null<const HistoryView::Element*> view,
+	not_null<const HistoryView::Media*> media,
+	int normal);
+[[nodiscard]] int RoundVideoFit(
+	not_null<const HistoryView::Element*> view,
+	not_null<const HistoryView::Media*> media,
+	int normal,
+	int available,
+	int additional);
+[[nodiscard]] QSize RoundVideoSource(
+	not_null<const HistoryView::Element*> view,
+	not_null<const HistoryView::Media*> media,
+	QSize size,
+	int maxSize);
+
+} // namespace Tele
