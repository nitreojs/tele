+using OptionValue = Fn<rpl::producer<bool>(not_null<::Main::Session*>)>;
+
+struct Requirement {
+	Requirement(const char *id) : id(id) {
+	}
+	Requirement(const char *id, OptionValue value)
+	: id(id)
+	, value(std::move(value)) {
+	}
+
+	const char *id = nullptr;
+	bool off = false;
+	OptionValue value;
+};
+
+[[nodiscard]] Requirement Off(const char id[]) {
+	auto result = Requirement(id);
+	result.off = true;
+	return result;
+}
+
+struct Parent {
+	Parent() = default;
+	Parent(const char *id) {
+		if (id) {
+			list.emplace_back(id);
+		}
+	}
+	Parent(std::initializer_list<Requirement> requirements)
+	: list(requirements) {
+	}
+
+	std::vector<Requirement> list;
+};
+
+[[nodiscard]] base::flat_map<QString, Parent> &Parents() {
+	static auto result = base::flat_map<QString, Parent>();
+	return result;
+}
+
+[[nodiscard]] bool Current(rpl::producer<bool> value) {
+	auto result = false;
+	auto lifetime = rpl::lifetime();
+	std::move(value).start(
+		[&](bool now) { result = now; },
+		[](auto&&) {},
+		[] {},
+		lifetime);
+	return result;
+}
+
+[[nodiscard]] rpl::producer<bool> OptionOnValue(const char id[]) {
+	const auto option = &base::options::details::Lookup(id);
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		option->changes()
+	) | rpl::map([=] {
+		return v::match(option->value(), [](bool value) {
+			return value;
+		}, [](int value) {
+			return (value != 0);
+		}, [](const QString &value) {
+			return !value.isEmpty();
+		});
+	});
+}
+
+[[nodiscard]] rpl::producer<bool> RequirementValue(
+		not_null<::Main::Session*> session,
+		const Requirement &requirement) {
+	auto value = requirement.value
+		? requirement.value(session)
+		: OptionOnValue(requirement.id);
+	return std::move(value) | rpl::map([off = requirement.off](bool on) {
+		return (on != off);
+	});
+}
+
+[[nodiscard]] rpl::producer<bool> ShownValue(
+		not_null<::Main::Session*> session,
+		const QString &id) {
+	const auto i = Parents().find(id);
+	if (i == end(Parents())) {
+		return rpl::single(true);
+	}
+	auto list = std::vector<rpl::producer<bool>>();
+	for (const auto &requirement : i->second.list) {
+		list.push_back(RequirementValue(session, requirement));
+		list.push_back(ShownValue(
+			session,
+			QString::fromLatin1(requirement.id)));
+	}
+	return rpl::combine(
+		std::move(list)
+	) | rpl::map([](const std::vector<bool> &values) {
+		return ranges::all_of(values, [](bool value) { return value; });
+	}) | rpl::distinct_until_changed();
+}
+
+[[nodiscard]] const Requirement *HiddenBy(
+		not_null<::Main::Session*> session,
+		const QString &id) {
+	const auto i = Parents().find(id);
+	if (i == end(Parents())) {
+		return nullptr;
+	}
+	for (const auto &requirement : i->second.list) {
+		const auto parent = QString::fromLatin1(requirement.id);
+		if (const auto above = HiddenBy(session, parent)) {
+			return above;
+		} else if (!Current(RequirementValue(session, requirement))) {
+			return &requirement;
+		}
+	}
+	return nullptr;
+}
+
+void AddAncestors(base::flat_set<QString> &ids, const QString &id) {
+	const auto i = Parents().find(id);
+	if (i == end(Parents())) {
+		return;
+	}
+	for (const auto &requirement : i->second.list) {
+		const auto parent = QString::fromLatin1(requirement.id);
+		if (ids.emplace(parent).second) {
+			AddAncestors(ids, parent);
+		}
+	}
+}
+
+void RedirectHighlight(
+		not_null<Window::SessionController*> controller,
+		const QString &id,
+		const QString &name) {
+	if (controller->highlightControlId() != id) {
+		return;
+	}
+	const auto requirement = HiddenBy(&controller->session(), id);
+	if (!requirement) {
+		return;
+	}
+	const auto &option = base::options::details::Lookup(requirement->id);
+	controller->setHighlightControlId(option.id());
+	controller->showToast(::Tele::Lower((requirement->off
+		? u"Turn off \"%1\" to see \"%2\"."_q
+		: u"Turn on \"%1\" to see \"%2\"."_q).arg(option.name(), name)));
+}
+
+void WithParent(
+		SectionBuilder &builder,
+		const QString &id,
+		const QString &name,
+		Parent parent,
+		FnMut<void()> add,
+		const QString &owner = QString()) {
+	if (parent.list.empty()) {
+		add();
+		return;
+	}
+	Parents()[id] = std::move(parent);
+	if (!Shown(owner.isEmpty() ? id : owner)) {
+		return;
+	}
+	if (const auto controller = builder.controller()) {
+		RedirectHighlight(controller, id, name);
+	}
+	builder.scope(std::move(add), ShownValue(builder.session(), id));
+}
+
+[[nodiscard]] Requirement GhostSwitches() {
+	return Requirement(::Tele::kOptionGhost, [](
+			not_null<::Main::Session*> session) {
+		return rpl::combine(
+			::Tele::GhostValue(),
+			::Tele::GhostChatsCountValue(
+				session,
+				::Tele::GhostOverride::Always)
+		) | rpl::map([](bool ghost, int always) {
+			return ghost || (always > 0);
+		});
+	});
+}
