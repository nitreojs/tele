From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Tue, 13 Oct 2026 17:26:32 +0300
Subject: [PATCH] build: take wallet-engine from gettele/money for private key
 import

---
 Telegram/build/docker/centos_env/Dockerfile | 2 ++
 Telegram/build/prepare/prepare.py           | 4 +++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/Telegram/build/docker/centos_env/Dockerfile b/Telegram/build/docker/centos_env/Dockerfile
index 3135794864044f21d2a0092b32cff787c86704bf..500cbc45ffba432d875813dd5e0a71131e373cf0 100644
--- a/Telegram/build/docker/centos_env/Dockerfile
+++ b/Telegram/build/docker/centos_env/Dockerfile
@@ -1015,6 +1015,8 @@ cd wallet-engine
 git remote add origin https://github.com/i582/wallet-engine.git
 git fetch --depth=1 origin e59e0d89d7ee90c388bf36e3334c5b276f396697
 git reset --hard FETCH_HEAD
+git fetch --depth=1 https://github.com/gettele/money.git "tele/$(git rev-parse HEAD)/5"
+git reset --hard FETCH_HEAD
 git apply ../patches/wallet-engine.patch
 cd ..
 # One archive for every Rust library. Each staticlib carries its own copy of
diff --git a/Telegram/build/prepare/prepare.py b/Telegram/build/prepare/prepare.py
index c090735b04151a886ea2c3e8fd84b42105437f18..5c0781e4024ac4191db07fe174d1a22264a2f415 100644
--- a/Telegram/build/prepare/prepare.py
+++ b/Telegram/build/prepare/prepare.py
@@ -2053,6 +2053,8 @@ win_mac:
     git clone https://github.com/i582/wallet-engine.git
     cd wallet-engine
     git checkout """ + walletEngineRevision + """
+    git fetch https://github.com/gettele/money.git tele/""" + walletEngineRevision + """/5
+    git checkout FETCH_HEAD
     git apply ../patches/wallet-engine.patch
 """)
 
@@ -2072,7 +2074,7 @@ win_mac:
 # flushes a cache whose generated source the CI prune had already deleted.
 # The wallet-engine patch rewrites those sources, so it is a dependency here.
 stage('tdesktop_rust', """
-version: 2.""" + tlottieRevision + '.' + walletEngineRevision + """
+version: 2.""" + tlottieRevision + '.' + walletEngineRevision + """.tele5
 depends:patches/wallet-engine.patch
 win:
     SET "RUSTUP_HOME=%THIRDPARTY_DIR%\\rust\\rustup"
