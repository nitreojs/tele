From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 21 Nov 2026 06:54:15 +0300
Subject: [PATCH] fix: render emoji in members list ranks

---
 .../info_profile_members_controllers.cpp      | 67 +++++++++----------
 .../info_profile_members_controllers.h        |  5 +-
 2 files changed, 33 insertions(+), 39 deletions(-)

diff --git a/Telegram/SourceFiles/info/profile/info_profile_members_controllers.cpp b/Telegram/SourceFiles/info/profile/info_profile_members_controllers.cpp
index 643a6d13967b7ff77dfacc8a020e179883c5a20c..21de85a5c64a0696b39fa0cbbd88e0a22ad3cc42 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_members_controllers.cpp
+++ b/Telegram/SourceFiles/info/profile/info_profile_members_controllers.cpp
@@ -15,6 +15,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "lang/lang_keys.h"
 #include "ui/effects/ripple_animation.h"
 #include "ui/painter.h"
+#include "ui/text/text_options.h"
 #include "styles/style_info.h"
 #include "styles/style_boxes.h"
 #include "styles/style_widgets.h"
@@ -36,28 +37,31 @@ void MemberListRow::setType(Type type) {
 	_type = type;
 	_tagRipple = nullptr;
 	_removeRipple = nullptr;
+	auto tagText = QString();
 	if (_type.canAddTag) {
 		_tagMode = TagMode::AddTag;
-		_tagText = tr::lng_context_add_my_tag(tr::now);
+		tagText = tr::lng_context_add_my_tag(tr::now);
 	} else if (!_type.rank.isEmpty()) {
 		_tagMode = (_type.rights == Rights::Admin
 			|| _type.rights == Rights::Creator)
 			? TagMode::AdminPill
 			: TagMode::NormalText;
-		_tagText = _type.rank;
+		tagText = _type.rank;
 	} else if (_type.rights == Rights::Creator) {
 		_tagMode = TagMode::AdminPill;
-		_tagText = tr::lng_owner_badge(tr::now);
+		tagText = tr::lng_owner_badge(tr::now);
 	} else if (_type.rights == Rights::Admin) {
 		_tagMode = TagMode::AdminPill;
-		_tagText = tr::lng_admin_badge(tr::now);
+		tagText = tr::lng_admin_badge(tr::now);
 	} else {
 		_tagMode = TagMode::None;
-		_tagText = QString();
 	}
-	_tagTextWidth = _tagText.isEmpty()
-		? 0
-		: st::normalFont->width(_tagText);
+	if (tagText.isEmpty()) {
+		_tagText.clear();
+	} else {
+		_tagText.setText(st::defaultTextStyle, tagText, Ui::NameTextOptions());
+	}
+	_tagTextWidth = _tagText.maxWidth();
 	if (_type.canRemove) {
 		_removeText = _type.removeText.isEmpty()
 			? tr::lng_profile_kick(tr::now)
@@ -319,8 +323,6 @@ void MemberListRow::paintColoredPill(
 		int x,
 		int y,
 		int w,
-		int textWidth,
-		const QString &text,
 		const QColor &color,
 		bool over,
 		std::unique_ptr<Ui::RippleAnimation> &ripple,
@@ -337,14 +339,22 @@ void MemberListRow::paintColoredPill(
 			ripple.reset();
 		}
 	}
-	p.setFont(st::normalFont);
 	p.setPen(color);
-	p.drawTextLeft(
-		x + (w - textWidth) / 2,
-		y + pad.top(),
-		outerWidth,
-		text,
-		textWidth);
+	paintTagText(p, x + (w - _tagTextWidth) / 2, y + pad.top(), outerWidth);
+}
+
+void MemberListRow::paintTagText(
+		Painter &p,
+		int x,
+		int y,
+		int outerWidth) const {
+	const auto left = style::RightToLeft()
+		? (outerWidth - x - _tagTextWidth)
+		: x;
+	_tagText.draw(p, {
+		.position = QPoint(left, y),
+		.availableWidth = _tagTextWidth,
+	});
 }
 
 void MemberListRow::paintTag(
@@ -371,8 +381,6 @@ void MemberListRow::paintTag(
 			x,
 			y,
 			w,
-			_tagTextWidth,
-			_tagText,
 			nameColor,
 			over,
 			_tagRipple,
@@ -397,19 +405,12 @@ void MemberListRow::paintTag(
 					_tagRipple.reset();
 				}
 			}
-			p.setFont(st::normalFont);
 			p.setPen(st::rankUserFg);
-			p.drawTextLeft(
-				x + (w - _tagTextWidth) / 2,
-				y + pad.top(),
-				outerWidth,
-				_tagText,
-				_tagTextWidth);
+			paintTagText(
+				p, x + (w - _tagTextWidth) / 2, y + pad.top(), outerWidth);
 		} else {
-			p.setFont(st::normalFont);
 			p.setPen(st::rankUserFg);
-			p.drawTextLeft(
-				x, y, outerWidth, _tagText, _tagTextWidth);
+			paintTagText(p, x, y, outerWidth);
 		}
 	} break;
 	case TagMode::AddTag: {
@@ -426,16 +427,10 @@ void MemberListRow::paintTag(
 				_tagRipple.reset();
 			}
 		}
-		p.setFont(st::normalFont);
 		p.setPen(over
 			? st::lightButtonFgOver
 			: st::lightButtonFg);
-		p.drawTextLeft(
-			x + (w - _tagTextWidth) / 2,
-			y + pad.top(),
-			outerWidth,
-			_tagText,
-			_tagTextWidth);
+		paintTagText(p, x + (w - _tagTextWidth) / 2, y + pad.top(), outerWidth);
 	} break;
 	case TagMode::None:
 		break;
diff --git a/Telegram/SourceFiles/info/profile/info_profile_members_controllers.h b/Telegram/SourceFiles/info/profile/info_profile_members_controllers.h
index 16e9b8448c5d00aad5269a7e710c0a1e915cff6f..3ffdcdcea6f7233371105b5a0211a76603eec27b 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_members_controllers.h
+++ b/Telegram/SourceFiles/info/profile/info_profile_members_controllers.h
@@ -105,12 +105,11 @@ private:
 		int x,
 		int y,
 		int w,
-		int textWidth,
-		const QString &text,
 		const QColor &color,
 		bool over,
 		std::unique_ptr<Ui::RippleAnimation> &ripple,
 		int outerWidth);
+	void paintTagText(Painter &p, int x, int y, int outerWidth) const;
 	void paintTag(
 		Painter &p,
 		QRect geometry,
@@ -127,7 +126,7 @@ private:
 
 	Type _type;
 	TagMode _tagMode = TagMode::None;
-	QString _tagText;
+	Ui::Text::String _tagText;
 	int _tagTextWidth = 0;
 	QString _removeText;
 	int _removeTextWidth = 0;
