From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Mon, 28 Sep 2026 21:28:24 +0300
Subject: [PATCH] feat: regroup the sending settings

---
 .../SourceFiles/settings/settings_tele.cpp    | 27 ++++++++++++++-----
 Telegram/SourceFiles/tele/tele_options.cpp    |  3 +--
 2 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 8e747a31e4968abf6ff4c866b514afb974ae8eb9..061ff6b474cd19c70157a9a72f7e6d4b3b571716 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1920,11 +1920,7 @@ void FillChats(SectionBuilder &builder) {
 	AddOptionToggle(builder, ::Tele::kOptionRevealSpoilers);
 	AddOptionToggle(builder, ::Tele::kOptionCopyProtected);
 	AddGroupDivider(builder);
-	AddGroupTitle(builder, u"Sending"_q);
-	AddOptionToggle(builder, ::Tele::kOptionParallelUploads);
-	AddOptionToggle(builder, ::Tele::kOptionCalcmula);
-	AddOptionToggle(builder, ::Tele::kOptionCalcmulaPreview);
-	AddOptionToggle(builder, ::Tele::kOptionSentToBottom);
+	AddGroupTitle(builder, u"Sending order"_q);
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionQueueBehindMedia,
@@ -1939,13 +1935,30 @@ void FillChats(SectionBuilder &builder) {
 		::Tele::kOptionDoubleEnterSend,
 		{ u"queue"_q },
 		::Tele::kOptionQueueBehindMedia);
-	AddOptionToggle(builder, ::Tele::kOptionPunctualScheduled);
+	AddOptionToggle(builder, ::Tele::kOptionSentToBottom);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Uploads"_q);
+	AddOptionToggle(builder, ::Tele::kOptionParallelUploads);
 	AddOptionToggle(builder, ::Tele::kOptionHdPhotos);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Message field"_q);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionDockedAttachments,
+		{ u"docked"_q, u"tray"_q, u"attach"_q, u"send box"_q });
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionNoRichPastePrompt,
 		{ u"formatted"_q });
-	AddOptionToggle(builder, ::Tele::kOptionDockedAttachments);
+	AddOptionToggle(builder, ::Tele::kOptionCalcmula);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionCalcmulaPreview,
+		{},
+		::Tele::kOptionCalcmula);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Scheduled messages"_q);
+	AddOptionToggle(builder, ::Tele::kOptionPunctualScheduled);
 	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Drafts"_q);
 	AddSavedDrafts(builder);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index fe38469030ae60a6b800609f103cd8286d578729..6cf45bc490e2923a635b7b99a805bf071ccdd08b 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -587,8 +587,7 @@ base::options::toggle NoRichPastePromptOption({
 base::options::toggle PunctualScheduledOption({
 	.id = kOptionPunctualScheduled,
 	.name = "Send scheduled messages on time",
-	.description = "While running, tele sends them itself, Telegram can be "
-		"minutes late.",
+	.description = "Tele sends them itself while it's running.",
 });
 
 base::options::toggle HdPhotosOption({
