diff --git a/Telegram/SourceFiles/tele/tele_settings_language.cpp b/Telegram/SourceFiles/tele/tele_settings_language.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..94db0a6e0e484fbc47f9fb261473ce23d0dc58fd
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_settings_language.cpp
@@ -0,0 +1,175 @@
+#include "tele/tele_settings_language.h"
+
+#include "core/application.h"
+#include "info/info_top_bar.h"
+#include "lang/lang_keys.h"
+#include "settings/settings_tele.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/boxes/confirm_box.h"
+#include "ui/boxes/single_choice_box.h"
+#include "ui/effects/ripple_animation.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/tooltip.h"
+#include "ui/painter.h"
+#include "ui/ui_utility.h"
+#include "window/window_session_controller.h"
+#include "styles/style_info.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtGui/QCursor>
+
+namespace Tele {
+namespace {
+
+struct Choice {
+	QString value;
+	QString label;
+};
+
+[[nodiscard]] std::vector<Choice> Choices() {
+	return {
+		{ QString(), u"Same as Telegram"_q },
+		{ u"en"_q, u"English"_q },
+		{ u"ru"_q, u"Русский"_q },
+		{ u"uk"_q, u"Українська"_q },
+	};
+}
+
+class LanguageButton final
+	: public Ui::RippleButton
+	, public Ui::AbstractTooltipShower {
+public:
+	LanguageButton(QWidget *parent, const style::IconButton &st);
+
+	QString tooltipText() const override;
+	QPoint tooltipPos() const override;
+	bool tooltipWindowActive() const override;
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+	void onStateChanged(State was, StateChangeSource source) override;
+	QImage prepareRippleMask() const override;
+	QPoint prepareRippleStartPosition() const override;
+
+	const style::IconButton &_st;
+
+};
+
+LanguageButton::LanguageButton(QWidget *parent, const style::IconButton &st)
+: RippleButton(parent, st.ripple)
+, _st(st) {
+	resize(_st.width, _st.height);
+	setCursor(style::cur_pointer);
+}
+
+QString LanguageButton::tooltipText() const {
+	return Lower(u"tele language"_q);
+}
+
+QPoint LanguageButton::tooltipPos() const {
+	return QCursor::pos();
+}
+
+bool LanguageButton::tooltipWindowActive() const {
+	return Ui::AppInFocus() && Ui::InFocusChain(window());
+}
+
+void LanguageButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	paintRipple(p, _st.rippleAreaPosition);
+	const auto &icon = st::menuIconTranslate;
+	const auto position = _st.iconPosition;
+	const auto x = (position.x() < 0)
+		? (width() - icon.width()) / 2
+		: position.x();
+	const auto y = (position.y() < 0)
+		? (height() - icon.height()) / 2
+		: position.y();
+	icon.paint(
+		p,
+		x,
+		y,
+		width(),
+		(isOver() || isDown())
+			? st::boxTitleCloseFgOver->c
+			: st::boxTitleCloseFg->c);
+}
+
+void LanguageButton::onStateChanged(State was, StateChangeSource source) {
+	RippleButton::onStateChanged(was, source);
+	if (isOver()) {
+		Ui::Tooltip::Show(1000, this);
+	} else {
+		Ui::Tooltip::Hide();
+	}
+	update();
+}
+
+QImage LanguageButton::prepareRippleMask() const {
+	return Ui::RippleAnimation::EllipseMask(
+		QSize(_st.rippleAreaSize, _st.rippleAreaSize));
+}
+
+QPoint LanguageButton::prepareRippleStartPosition() const {
+	return mapFromGlobal(QCursor::pos()) - _st.rippleAreaPosition;
+}
+
+void ShowLanguageBox(not_null<Window::SessionController*> controller) {
+	const auto choices = Choices();
+	auto labels = std::vector<QString>();
+	for (const auto &choice : choices) {
+		labels.push_back(Lower(choice.label));
+	}
+	const auto current = ranges::find(choices, TeleLanguage(), &Choice::value);
+	const auto selected = (current != end(choices))
+		? int(current - begin(choices))
+		: 0;
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		SingleChoiceBox(box, {
+			.title = rpl::single(Lower(u"tele language"_q)),
+			.options = labels,
+			.initialSelection = selected,
+			.callback = [=](int index) {
+				const auto value = choices[index].value;
+				if (value == TeleLanguage()) {
+					return;
+				}
+				SetTeleLanguage(value);
+				controller->show(Ui::MakeConfirmBox({
+					.text = tr::lng_settings_need_restart(),
+					.confirmed = [] { Core::Restart(); },
+					.confirmText = tr::lng_settings_restart_now(),
+					.cancelText = tr::lng_settings_restart_later(),
+				}));
+			},
+		});
+	}));
+}
+
+} // namespace
+
+void AddSettingsLanguageButton(
+		not_null<Info::TopBar*> topBar,
+		::Settings::Type section,
+		bool layer,
+		not_null<Window::SessionController*> controller) {
+	const auto paths = ::Settings::TeleSettingsPaths();
+	const auto tele = ranges::any_of(paths, [&](const auto &path) {
+		return path.second == section;
+	});
+	if (!tele) {
+		return;
+	}
+	const auto button = topBar->addButton(
+		base::make_unique_q<LanguageButton>(
+			topBar,
+			layer ? st::infoLayerTopBarSearch : st::infoTopBarSearch));
+	button->setAccessibleName(Lower(u"tele language"_q));
+	button->setClickedCallback([=] {
+		ShowLanguageBox(controller);
+	});
+}
+
+} // namespace Tele
