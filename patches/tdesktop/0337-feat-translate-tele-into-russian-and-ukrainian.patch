diff --git a/Telegram/SourceFiles/tele/tele_translations.cpp b/Telegram/SourceFiles/tele/tele_translations.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fd20046999e3a82f4782efc82e9f6f525cc620f3
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_translations.cpp
@@ -0,0 +1,197 @@
+#include "tele/tele_translations.h"
+
+#include "core/application.h"
+#include "lang/lang_instance.h"
+#include "tele/tele_options.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QFile>
+#include <QtCore/QHash>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QThread>
+
+#include <array>
+#include <atomic>
+#include <mutex>
+
+namespace Tele {
+namespace {
+
+enum class Form {
+	One,
+	Few,
+	Many,
+	Other,
+};
+
+struct Entry {
+	QString text;
+	std::array<QString, 4> forms;
+};
+
+struct Table {
+	QString language;
+	QHash<QString, Entry> entries;
+};
+
+[[nodiscard]] QString ResourcePath(const QString &language) {
+	return u":/tele/translations/%1.json"_q.arg(language);
+}
+
+[[nodiscard]] bool Available(const QString &language) {
+	return !language.isEmpty()
+		&& (language != u"en"_q)
+		&& QFile::exists(ResourcePath(language));
+}
+
+[[nodiscard]] QString FromTelegram(const QString &id, const QString &base) {
+	for (auto candidate : { id, base }) {
+		candidate = candidate.toLower();
+		if (Available(candidate)) {
+			return candidate;
+		}
+		const auto dash = candidate.indexOf('-');
+		if (dash > 0 && Available(candidate.left(dash))) {
+			return candidate.left(dash);
+		}
+	}
+	return QString();
+}
+
+[[nodiscard]] Table Load(const QString &language) {
+	auto result = Table{ .language = language };
+	auto file = QFile(ResourcePath(language));
+	if (!file.open(QIODevice::ReadOnly)) {
+		return result;
+	}
+	const auto document = QJsonDocument::fromJson(file.readAll());
+	const auto strings = document.object().value(u"strings"_q).toObject();
+	result.entries.reserve(strings.size());
+	for (auto i = strings.begin(); i != strings.end(); ++i) {
+		auto entry = Entry();
+		const auto value = i.value();
+		if (value.isString()) {
+			entry.text = value.toString();
+		} else if (value.isObject()) {
+			const auto forms = value.toObject();
+			entry.forms = {
+				forms.value(u"one"_q).toString(),
+				forms.value(u"few"_q).toString(),
+				forms.value(u"many"_q).toString(),
+				forms.value(u"other"_q).toString(),
+			};
+		}
+		const auto empty = entry.text.isEmpty()
+			&& ranges::all_of(entry.forms, &QString::isEmpty);
+		if (!empty) {
+			result.entries.emplace(i.key(), std::move(entry));
+		}
+	}
+	return result;
+}
+
+std::mutex Mutex;
+std::optional<Table> Cached;
+std::atomic<bool> Dirty = true;
+bool Watching = false;
+
+void Watch() {
+	if (Watching
+		|| !Core::IsAppLaunched()
+		|| QThread::currentThread() != QCoreApplication::instance()->thread()) {
+		return;
+	}
+	Watching = true;
+	static auto lifetime = rpl::lifetime();
+	rpl::merge(
+		Lang::GetInstance().updated(),
+		TeleLanguageValue() | rpl::skip(1) | rpl::to_empty
+	) | rpl::on_next([] {
+		Dirty = true;
+	}, lifetime);
+}
+
+[[nodiscard]] QString Resolve() {
+	const auto chosen = TeleLanguage();
+	if (!chosen.isEmpty()) {
+		return Available(chosen) ? chosen : QString();
+	} else if (!Core::IsAppLaunched()) {
+		return QString();
+	}
+	const auto &instance = Lang::GetInstance();
+	return FromTelegram(instance.id(), instance.baseId());
+}
+
+[[nodiscard]] const Table *Current() {
+	Watch();
+	if (Dirty.exchange(false) || !Cached || !Watching) {
+		const auto language = Resolve();
+		if (!Cached || Cached->language != language) {
+			Cached = language.isEmpty() ? Table() : Load(language);
+		}
+	}
+	return Cached->entries.isEmpty() ? nullptr : &*Cached;
+}
+
+[[nodiscard]] Form PluralForm(const QString &language, int64 count) {
+	const auto n = (count < 0) ? -count : count;
+	if (language == u"ru"_q || language == u"uk"_q || language == u"be"_q) {
+		const auto mod10 = n % 10;
+		const auto mod100 = n % 100;
+		if (mod10 == 1 && mod100 != 11) {
+			return Form::One;
+		} else if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) {
+			return Form::Few;
+		}
+		return Form::Many;
+	}
+	return (n == 1) ? Form::One : Form::Other;
+}
+
+[[nodiscard]] QString PickForm(const Entry &entry, Form form) {
+	if (const auto &exact = entry.forms[int(form)]; !exact.isEmpty()) {
+		return exact;
+	}
+	for (const auto fallback : { Form::Other, Form::Many, Form::Few }) {
+		if (const auto &text = entry.forms[int(fallback)]; !text.isEmpty()) {
+			return text;
+		}
+	}
+	return entry.text.isEmpty() ? entry.forms[int(Form::One)] : entry.text;
+}
+
+} // namespace
+
+QString Translate(const QString &text) {
+	if (text.isEmpty()) {
+		return text;
+	}
+	const auto lock = std::lock_guard(Mutex);
+	const auto table = Current();
+	if (!table) {
+		return text;
+	}
+	const auto i = table->entries.constFind(text);
+	if (i == table->entries.cend()) {
+		return text;
+	}
+	return i->text.isEmpty() ? PickForm(*i, Form::Other) : i->text;
+}
+
+QString Plural(const QString &one, const QString &other, int64 count) {
+	{
+		const auto lock = std::lock_guard(Mutex);
+		if (const auto table = Current()) {
+			const auto i = table->entries.constFind(other);
+			if (i != table->entries.cend()) {
+				return i->text.isEmpty()
+					? PickForm(*i, PluralForm(table->language, count))
+					: i->text;
+			}
+		}
+	}
+	return (count == 1 || count == -1) ? one : other;
+}
+
+} // namespace Tele
