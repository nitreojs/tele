+void AddPageRow(
+		not_null<Ui::VerticalLayout*> inner,
+		not_null<Window::SessionController*> window,
+		const QString &script,
+		not_null<rpl::variable<PageRow>*> state,
+		Fn<void(QVariant)> event,
+		Fn<QString(double)> label) {
+	const auto &row = state->current();
+	const auto text = state->value() | rpl::map([](const PageRow &row) {
+		return row.text;
+	});
+	const auto addSubtitle = [&] {
+		if (!row.subtitle.isEmpty()) {
+			inner->add(
+				object_ptr<Ui::FlatLabel>(
+					inner,
+					state->value() | rpl::map([](const PageRow &row) {
+						return row.subtitle;
+					}),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+			Ui::AddSkip(inner);
+		}
+	};
+	if (row.type == u"header"_q) {
+		Ui::AddSkip(inner);
+		Ui::AddSubsectionTitle(inner, rpl::duplicate(text));
+	} else if (row.type == u"separator"_q) {
+		Ui::AddSkip(inner);
+		if (row.text.isEmpty()) {
+			Ui::AddDivider(inner);
+		} else {
+			Ui::AddDividerText(inner, rpl::duplicate(text));
+		}
+		Ui::AddSkip(inner);
+	} else if (row.type == u"button"_q) {
+		const auto button = row.value.isEmpty()
+			? Settings::AddButtonWithIcon(
+				inner,
+				rpl::duplicate(text),
+				st::settingsButtonNoIcon)
+			: Settings::AddButtonWithLabel(
+				inner,
+				rpl::duplicate(text),
+				state->value() | rpl::map([](const PageRow &row) {
+					return row.value;
+				}),
+				st::settingsButtonNoIcon);
+		button->setClickedCallback([=] { event(QVariant()); });
+		addSubtitle();
+	} else if (row.type == u"check"_q) {
+		const auto button = Settings::AddButtonWithIcon(
+			inner,
+			rpl::duplicate(text),
+			st::settingsButtonNoIcon);
+		button->toggleOn(state->value() | rpl::map([](const PageRow &row) {
+			return row.checked;
+		}));
+		button->toggledChanges(
+		) | rpl::filter([=](bool value) {
+			return value != state->current().checked;
+		}) | rpl::on_next([=](bool value) {
+			event(value);
+		}, button->lifetime());
+		addSubtitle();
+	} else if (row.type == u"select"_q) {
+		Settings::AddButtonWithLabel(
+			inner,
+			rpl::duplicate(text),
+			state->value() | rpl::map([](const PageRow &row) {
+				const auto index = row.selected;
+				return (index >= 0 && index < int(row.options.size()))
+					? row.options[index]
+					: QString();
+			}),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			const auto now = state->current();
+			ShowScriptChooser(window, {
+				.script = script,
+				.title = now.text,
+				.items = now.options,
+				.selected = (now.selected >= 0)
+					? std::vector<int>{ now.selected }
+					: std::vector<int>(),
+			}, [=](std::optional<std::vector<int>> result) {
+				if (result
+					&& !result->empty()
+					&& result->front() != state->current().selected) {
+					event(result->front());
+				}
+			});
+		});
+		addSubtitle();
+	} else if (row.type == u"slider"_q) {
+		if (!row.text.isEmpty()) {
+			inner->add(
+				object_ptr<Ui::FlatLabel>(inner, rpl::duplicate(text), st::boxLabel),
+				st::boxRowPadding);
+			Ui::AddSkip(inner);
+		}
+		const auto step = (row.step > 0.) ? row.step : 1.;
+		const auto steps = std::clamp(
+			int(std::floor((row.max - row.min) / step)) + 1,
+			2,
+			kMaxSliderSteps);
+		const auto min = row.min;
+		const auto index = std::clamp(
+			int(std::round((row.number - min) / step)),
+			0,
+			steps - 1);
+		const auto &labelSt = st::settingsScaleLabel;
+		auto slider = Settings::MakeSliderWithLabel(
+			inner,
+			st::settingsScale,
+			labelSt,
+			st::normalFont->spacew * 2,
+			labelSt.style.font->width(label(row.max)),
+			true);
+		const auto shown = slider.label;
+		shown->setText(label(min + index * step));
+		slider.slider->setPseudoDiscrete(
+			steps,
+			[](int value) { return value; },
+			index,
+			[=](int value) {
+				const auto number = min + value * step;
+				shown->setText(label(number));
+				event(number);
+			});
+		inner->add(std::move(slider.widget), st::boxRowPadding);
+		Ui::AddSkip(inner);
+		addSubtitle();
+	}
+}
