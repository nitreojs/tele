+[[nodiscard]] QString StructureKey(const PageRow &row) {
+	auto result = row.type
+		+ QChar(1) + (row.subtitle.isEmpty() ? u"0"_q : u"1"_q)
+		+ QChar(1) + (row.value.isEmpty() ? u"0"_q : u"1"_q);
+	if (row.type == u"separator"_q) {
+		result += row.text.isEmpty() ? u"e"_q : u"t"_q;
+	} else if (row.type == u"select"_q) {
+		result += QString::number(row.options.size());
+	} else if (row.type == u"slider"_q) {
+		result += QString::number(row.min)
+			+ ':' + QString::number(row.max)
+			+ ':' + QString::number(row.step)
+			+ ':' + (row.text.isEmpty() ? u"e"_q : u"t"_q);
+	}
+	return result;
+}
