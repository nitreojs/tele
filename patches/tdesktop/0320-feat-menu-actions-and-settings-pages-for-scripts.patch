+void Instance::applyResult(const QByteArray &request, const QByteArray &result) {
+	const auto shortSent = (result.size() >= 4)
+		&& (LeadingId(std::string_view(result.constData(), result.size()))
+			== std::uint32_t(mtpc_updateShortSentMessage));
+	if (!shortSent || !_engine) {
+		ApplyRawUpdates(_session, result);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto sent = DecodeTl(
+		ctx,
+		std::string_view(request.constData(), request.size()),
+		"Object");
+	auto answer = DecodeTl(
+		ctx,
+		std::string_view(result.constData(), result.size()),
+		"Updates");
+	auto expanded = JS_UNDEFINED;
+	if (sent.error.empty() && answer.error.empty()) {
+		auto name = JS_GetPropertyStr(ctx, sent.value, "_");
+		const auto method = ToStd(ctx, name);
+		JS_FreeValue(ctx, name);
+		if (method == "messages.sendMessage") {
+			auto self = JS_NewBigInt64(
+				ctx,
+				std::int64_t(_session->userId().bare));
+			JSValueConst args[] = { sent.value, answer.value, self };
+			expanded = CallGlobal(ctx, "__teleExpandShortSent", args);
+			JS_FreeValue(ctx, self);
+		}
+	}
+	JS_FreeValue(ctx, sent.value);
+	JS_FreeValue(ctx, answer.value);
+	auto applied = false;
+	if (JS_IsObject(expanded)) {
+		auto encoded = EncodeTl(ctx, expanded, "Updates");
+		if (encoded.error.empty()) {
+			applied = ApplyRawUpdates(
+				_session,
+				QByteArray(encoded.bytes.data(), int(encoded.bytes.size())));
+		} else {
+			log(LogLevel::Warning, u"can't show the sent message: "_q
+				+ FromStd(encoded.error));
+		}
+	} else if (JS_IsException(expanded)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+	}
+	JS_FreeValue(ctx, expanded);
+	if (!applied) {
+		ApplyRawUpdates(_session, result);
+	}
+}
