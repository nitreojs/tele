+[[nodiscard]] std::map<QString, int> &ActionReferences() {
+	static auto result = std::map<QString, int>();
+	return result;
+}
+
+void ReferenceAction(int menu, const QString &key, const QString &text) {
+	++ActionReferences()[key];
+	SetScriptMenuItem(kActionMenus[menu], key, text, true);
+}
+
+void UnreferenceAction(int menu, const QString &key, const QString &text) {
+	auto &references = ActionReferences();
+	const auto i = references.find(key);
+	if (i == end(references) || --i->second > 0) {
+		return;
+	}
+	references.erase(i);
+	SetScriptMenuItem(kActionMenus[menu], key, text, false);
+}
+
+[[nodiscard]] QString MenuKeyPart(const QString &text) {
+	auto result = QString();
+	for (const auto ch : text.toLower()) {
+		const auto plain = (ch >= 'a' && ch <= 'z')
+			|| (ch >= '0' && ch <= '9')
+			|| (ch == '_');
+		result += plain ? ch : QChar('_');
+	}
+	return result;
+}
