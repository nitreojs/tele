+
+JSValue Instance::NativePage(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	if (magic == 0) {
+		if (argc < 2 || !JS_IsFunction(ctx, argv[1])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.settingsPage needs an items function");
+		}
+		const auto id = ++instance->_pageKey;
+		auto page = std::make_unique<Page>();
+		page->items = JS_DupValue(ctx, argv[1]);
+		page->title = JS_IsString(argv[0])
+			? FromStd(ToStd(ctx, argv[0]))
+			: QString();
+		instance->_pages.emplace(id, std::move(page));
+		return JS_NewInt32(ctx, id);
+	}
+	auto id = 0;
+	if (argc < 1 || JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_ThrowTypeError(ctx, "expected a page");
+	}
+	const auto i = instance->_pages.find(id);
+	if (i == end(instance->_pages)) {
+		return (magic == 2 || magic == 5)
+			? JS_UNDEFINED
+			: ThrowTeleError(
+				ctx,
+				"handle-expired",
+				u"this page was disposed"_q);
+	}
+	switch (magic) {
+	case 1:
+		i->second->invalidated.fire({});
+		break;
+	case 2:
+		instance->disposePage(id);
+		break;
+	case 3: {
+		const auto window = instance->_session->tryResolveWindow();
+		if (!window) {
+			return ThrowTeleError(
+				ctx,
+				"unsupported",
+				u"tg.ui.openPage: this account has no window"_q);
+		}
+		instance->openPage(id, window);
+	} break;
+	case 4:
+	case 5:
+		if (magic == 4 || instance->_settingsPage == id) {
+			instance->_settingsPage = (magic == 4) ? id : 0;
+			if (instance->_changed) {
+				instance->_changed();
+			}
+		}
+		break;
+	}
+	return JS_UNDEFINED;
+}
+
+void Instance::disposePage(int id) {
+	const auto i = _pages.find(id);
+	if (i == end(_pages)) {
+		return;
+	}
+	auto page = std::move(i->second);
+	_pages.erase(i);
+	page->closed.fire({});
+	if (_engine) {
+		JS_FreeValue(_engine->ctx(), page->items);
+		JS_FreeValue(_engine->ctx(), page->rendered);
+	}
+	if (_settingsPage == id) {
+		_settingsPage = 0;
+		if (_changed) {
+			_changed();
+		}
+	}
+}
+
+void Instance::openPage(int id, not_null<Window::SessionController*> window) {
+	const auto i = _pages.find(id);
+	if (i == end(_pages)) {
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	ShowScriptPage(window, {
+		.script = _name,
+		.title = i->second->title,
+		.render = [=]() -> std::optional<std::vector<PageRow>> {
+			const auto strong = weak.get();
+			return strong ? strong->renderPage(id) : std::nullopt;
+		},
+		.event = [=](int index, QVariant value) {
+			if (const auto strong = weak.get()) {
+				strong->pageEvent(id, index, value);
+			}
+		},
+		.label = [=](int index, double value) {
+			const auto strong = weak.get();
+			return strong
+				? strong->pageLabel(id, index, value)
+				: QString::number(value);
+		},
+		.invalidated = i->second->invalidated.events(),
+		.closed = i->second->closed.events(),
+	});
+}
+
+std::optional<std::vector<PageRow>> Instance::renderPage(int id) {
+	const auto i = _pages.find(id);
+	if (!_engine || !_started || i == end(_pages)) {
+		return std::nullopt;
+	}
+	const auto page = i->second.get();
+	const auto ctx = _engine->ctx();
+	auto items = JS_DupValue(ctx, page->items);
+	auto list = invoke(items, {}, kListenerBudget, u"settings page"_q);
+	JS_FreeValue(ctx, items);
+	if (!_engine || !_pages.contains(id)) {
+		JS_FreeValue(ctx, list);
+		return std::nullopt;
+	}
+	auto length = std::int64_t();
+	if (JS_IsException(list)) {
+		return page->rows;
+	} else if (!JS_IsArray(list) || JS_GetLength(ctx, list, &length) < 0) {
+		JS_FreeValue(ctx, list);
+		fault(u"settings page"_q, u"items() must return an array"_q);
+		return page->rows;
+	}
+	const auto number = [&](JSValueConst object, const char *name, double fallback) {
+		auto value = JS_GetPropertyStr(ctx, object, name);
+		auto result = fallback;
+		if (JS_IsNumber(value)) {
+			JS_ToFloat64(ctx, &result, value);
+		}
+		JS_FreeValue(ctx, value);
+		return result;
+	};
+	auto rows = std::vector<PageRow>();
+	for (auto index = std::int64_t(); index != length; ++index) {
+		auto item = JS_GetPropertyUint32(ctx, list, std::uint32_t(index));
+		auto row = PageRow{
+			.type = StringProperty(ctx, item, "type"),
+			.text = StringProperty(ctx, item, "text"),
+			.subtitle = StringProperty(ctx, item, "subtitle"),
+			.value = StringProperty(ctx, item, "value"),
+			.checked = BoolProperty(ctx, item, "checked"),
+		};
+		if (row.type == u"select"_q) {
+			auto options = JS_GetPropertyStr(ctx, item, "items");
+			auto count = std::int64_t();
+			if (JS_IsArray(options) && JS_GetLength(ctx, options, &count) >= 0) {
+				for (auto j = std::int64_t(); j != count; ++j) {
+					auto option = JS_GetPropertyUint32(ctx, options, std::uint32_t(j));
+					row.options.push_back(FromStd(ToStd(ctx, option)));
+					JS_FreeValue(ctx, option);
+				}
+			}
+			JS_FreeValue(ctx, options);
+			row.selected = int(number(item, "selected", -1));
+		} else if (row.type == u"slider"_q) {
+			row.min = number(item, "min", 0.);
+			row.max = number(item, "max", 100.);
+			row.step = number(item, "step", 1.);
+			row.number = number(item, "value", row.min);
+		}
+		JS_FreeValue(ctx, item);
+		rows.push_back(std::move(row));
+	}
+	JS_FreeValue(ctx, page->rendered);
+	page->rendered = list;
+	page->rows = rows;
+	_engine->drain();
+	return rows;
+}
+
+void Instance::pageEvent(int id, int index, QVariant value) {
+	const auto i = _pages.find(id);
+	if (!_engine || !_started || i == end(_pages)) {
+		return;
+	}
+	const auto page = i->second.get();
+	const auto ctx = _engine->ctx();
+	auto item = JS_GetPropertyUint32(ctx, page->rendered, std::uint32_t(index));
+	const auto type = StringProperty(ctx, item, "type");
+	const auto click = (type == u"button"_q);
+	auto handler = JS_GetPropertyStr(ctx, item, click ? "onClick" : "onChange");
+	JS_FreeValue(ctx, item);
+	if (!JS_IsFunction(ctx, handler)) {
+		JS_FreeValue(ctx, handler);
+		return;
+	}
+	auto argument = click
+		? JS_UNDEFINED
+		: (value.userType() == QMetaType::Bool)
+		? JS_NewBool(ctx, value.toBool())
+		: (type == u"select"_q)
+		? JS_NewInt32(ctx, value.toInt())
+		: JS_NewFloat64(ctx, value.toDouble());
+	JSValueConst args[] = { argument };
+	auto result = invoke(
+		handler,
+		std::span<JSValueConst>(args, click ? 0 : 1),
+		kListenerBudget,
+		u"settings page"_q);
+	JS_FreeValue(ctx, handler);
+	JS_FreeValue(ctx, argument);
+	JS_FreeValue(ctx, result);
+	if (!_engine) {
+		return;
+	}
+	_engine->drain();
+	if (type != u"slider"_q) {
+		if (const auto j = _pages.find(id); j != end(_pages)) {
+			j->second->invalidated.fire({});
+		}
+	}
+}
+
+QString Instance::pageLabel(int id, int index, double value) {
+	const auto fallback = QString::number(value);
+	const auto i = _pages.find(id);
+	if (!_engine || !_started || i == end(_pages)) {
+		return fallback;
+	}
+	const auto ctx = _engine->ctx();
+	auto item = JS_GetPropertyUint32(
+		ctx,
+		i->second->rendered,
+		std::uint32_t(index));
+	auto label = JS_GetPropertyStr(ctx, item, "label");
+	JS_FreeValue(ctx, item);
+	if (!JS_IsFunction(ctx, label)) {
+		JS_FreeValue(ctx, label);
+		return fallback;
+	}
+	auto argument = JS_NewFloat64(ctx, value);
+	JSValueConst args[] = { argument };
+	auto result = invoke(label, args, kListenerBudget, u"slider label"_q);
+	JS_FreeValue(ctx, label);
+	const auto text = JS_IsException(result)
+		? fallback
+		: FromStd(ToStd(ctx, result));
+	JS_FreeValue(ctx, result);
+	return text;
+}
+
+void Instance::release(Registration &registration) {
+	if (registration.kind == Kind::Action) {
+		UnreferenceAction(registration.menu, registration.key, registration.text);
+	}
+	if (_engine) {
+		JS_FreeValue(_engine->ctx(), registration.fn);
+		JS_FreeValue(_engine->ctx(), registration.visible);
+	}
+	registration.fn = JS_UNDEFINED;
+	registration.visible = JS_UNDEFINED;
+}
+
+JSValue Instance::NativeAction(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	static const auto names = std::array<const char*, 4>{
+		"tg.registerMessageAction",
+		"tg.registerChatAction",
+		"tg.registerChatAction",
+		"tg.registerProfileAction",
+	};
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (magic < 0 || magic > 3) {
+		return JS_UNDEFINED;
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(ctx, "%s needs an options object", names[magic]);
+	}
+	const auto options = argv[0];
+	const auto id = StringProperty(ctx, options, "id");
+	const auto text = StringProperty(ctx, options, "text");
+	static const auto valid = QRegularExpression(u"^[a-z0-9_]{1,64}$"_q);
+	if (!valid.match(id).hasMatch()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: id must be 1 to 64 of a-z, 0-9 and _",
+			names[magic]);
+	} else if (text.trimmed().isEmpty()) {
+		return JS_ThrowTypeError(ctx, "%s needs a text", names[magic]);
+	}
+	auto click = JS_GetPropertyStr(ctx, options, "onClick");
+	auto visible = JS_GetPropertyStr(ctx, options, "visible");
+	const auto clickable = JS_IsFunction(ctx, click);
+	const auto checkable = JS_IsUndefined(visible)
+		|| JS_IsFunction(ctx, visible);
+	if (!clickable || !checkable) {
+		JS_FreeValue(ctx, click);
+		JS_FreeValue(ctx, visible);
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: onClick must be a function, visible a function if given",
+			names[magic]);
+	}
+	const auto count = ranges::count_if(
+		instance->_registrations,
+		[&](const auto &pair) {
+			return pair.second.kind == Kind::Action
+				&& pair.second.menu == magic;
+		});
+	if (count >= kMaxActionsPerMenu) {
+		JS_FreeValue(ctx, click);
+		JS_FreeValue(ctx, visible);
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			QString::fromLatin1(names[magic])
+				+ u": at most 8 actions per menu"_q);
+	}
+	const auto key = u"script."_q
+		+ MenuKeyPart(instance->_file.id)
+		+ '.'
+		+ id;
+	const auto taken = ranges::any_of(
+		instance->_registrations,
+		[&](const auto &pair) {
+			return pair.second.kind == Kind::Action
+				&& pair.second.menu == magic
+				&& pair.second.key == key;
+		});
+	if (taken) {
+		JS_FreeValue(ctx, click);
+		JS_FreeValue(ctx, visible);
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: the id '%s' is already registered",
+			names[magic],
+			id.toUtf8().constData());
+	}
+	const auto registration = NextRegistrationId();
+	instance->_registrations.emplace(registration, Registration{
+		.kind = Kind::Action,
+		.fn = click,
+		.visible = visible,
+		.menu = magic,
+		.key = key,
+		.text = text,
+	});
+	ReferenceAction(magic, key, text);
+	return instance->disposer(registration);
+}
+
+std::vector<ScriptAction> Instance::actions(int menu) const {
+	auto result = std::vector<ScriptAction>();
+	if (!_started) {
+		return result;
+	}
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::Action && registration.menu == menu) {
+			result.push_back({
+				.id = id,
+				.key = registration.key,
+				.text = registration.text,
+			});
+		}
+	}
+	return result;
+}
+
+JSValue Instance::actionContext(const ActionContext &context) {
+	const auto ctx = _engine->ctx();
+	auto result = JS_NewObject(ctx);
+	if (context.peer) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"chatId",
+			JS_NewBigInt64(ctx, MarkedId(context.peer->id)));
+		JS_SetPropertyStr(ctx, result, "chat", peerInfo(context.peer));
+	}
+	if (context.messageId) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"messageId",
+			JS_NewInt64(ctx, context.messageId.bare));
+		JS_SetPropertyStr(ctx, result, "text", NewString(ctx, context.text));
+	}
+	return result;
+}
+
+bool Instance::actionVisible(int id, const ActionContext &context) {
+	const auto i = _registrations.find(id);
+	if (!_engine || !_started || i == end(_registrations)) {
+		return false;
+	} else if (JS_IsUndefined(i->second.visible)) {
+		return true;
+	}
+	const auto ctx = _engine->ctx();
+	auto visible = JS_DupValue(ctx, i->second.visible);
+	auto argument = actionContext(context);
+	JSValueConst args[] = { argument };
+	auto result = invoke(
+		visible,
+		args,
+		kListenerBudget,
+		u"action %1 visible"_q.arg(i->second.key));
+	JS_FreeValue(ctx, visible);
+	JS_FreeValue(ctx, argument);
+	const auto shown = !JS_IsException(result) && (JS_ToBool(ctx, result) > 0);
+	JS_FreeValue(ctx, result);
+	if (_engine) {
+		_engine->drain();
+	}
+	return shown;
+}
+
+void Instance::runAction(int id, const ActionContext &context) {
+	const auto i = _registrations.find(id);
+	if (!_engine || !_started || i == end(_registrations)) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto click = JS_DupValue(ctx, i->second.fn);
+	auto argument = actionContext(context);
+	JSValueConst args[] = { argument };
+	auto result = invoke(
+		click,
+		args,
+		kListenerBudget,
+		u"action %1"_q.arg(i->second.key));
+	JS_FreeValue(ctx, click);
+	JS_FreeValue(ctx, argument);
+	JS_FreeValue(ctx, result);
+	if (_engine) {
+		_engine->drain();
+	}
+}
