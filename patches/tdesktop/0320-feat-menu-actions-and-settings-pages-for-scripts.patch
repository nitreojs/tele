+void ShowScriptPage(
+		not_null<Window::SessionController*> window,
+		ScriptPageView view) {
+	const auto state = std::make_shared<ScriptPageView>(std::move(view));
+	window->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setWidth(st::boxWideWidth);
+		box->setTitle(rpl::single(state->title.isEmpty()
+			? state->script
+			: state->title));
+		const auto inner = box->addRow(
+			object_ptr<Ui::VerticalLayout>(box),
+			style::margins());
+		const auto rows = box->lifetime().make_state<
+			std::vector<std::unique_ptr<rpl::variable<PageRow>>>>();
+		const auto structure = box->lifetime().make_state<
+			std::vector<QString>>();
+		const auto rebuild = std::make_shared<Fn<void()>>();
+		*rebuild = [=] {
+			const auto rendered = state->render();
+			if (!rendered) {
+				box->closeBox();
+				return;
+			}
+			auto keys = std::vector<QString>();
+			for (const auto &row : *rendered) {
+				keys.push_back(StructureKey(row));
+			}
+			if (keys == *structure) {
+				for (auto i = 0; i != int(rendered->size()); ++i) {
+					*(*rows)[i] = (*rendered)[i];
+				}
+				return;
+			}
+			*structure = std::move(keys);
+			inner->clear();
+			rows->clear();
+			for (auto i = 0; i != int(rendered->size()); ++i) {
+				rows->push_back(
+					std::make_unique<rpl::variable<PageRow>>((*rendered)[i]));
+				AddPageRow(
+					inner,
+					window,
+					state->script,
+					rows->back().get(),
+					[=](QVariant value) { state->event(i, value); },
+					[=](double value) { return state->label(i, value); });
+			}
+			inner->resizeToWidth(inner->width());
+		};
+		(*rebuild)();
+		std::move(state->invalidated) | rpl::on_next([=] {
+			crl::on_main(box, [=] {
+				(*rebuild)();
+			});
+		}, box->lifetime());
+		std::move(state->closed) | rpl::on_next([=] {
+			box->closeBox();
+		}, box->lifetime());
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	}));
+}
