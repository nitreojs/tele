From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 10 Oct 2026 16:01:13 +0300
Subject: [PATCH] fix: scripts never activate an account to find its window

---
 .../tele/scripting/tele_script_hooks.cpp      | 15 ++++++++++-
 .../tele/scripting/tele_script_instance.cpp   | 27 ++++++++++++++-----
 2 files changed, 34 insertions(+), 8 deletions(-)

diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp
index 37f8aebbd2c45cfa8d9854b2a8d39c85d0637b81..8c6b46c4caa7d01c0627cb09d062672a2fd3e9ac 100644
--- a/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp
@@ -506,6 +506,19 @@ Host::~Host() {
 	ForgetMessages(_session);
 }
 
+[[nodiscard]] Window::SessionController *WindowOf(
+		not_null<Main::Session*> session) {
+	auto result = (Window::SessionController*)nullptr;
+	for (const auto &window : session->windows()) {
+		if (window->isPrimary()) {
+			return window;
+		} else if (!result) {
+			result = window;
+		}
+	}
+	return result;
+}
+
 int ReopeningLinks = 0;
 int ReschedulingNotifications = 0;
 
@@ -865,7 +878,7 @@ void Host::notify(const QString &id, const QString &text) {
 		i->toasted = now;
 	}
 	crl::on_main(this, [=] {
-		if (const auto window = _session->tryResolveWindow()) {
+		if (const auto window = WindowOf(_session)) {
 			window->showToast(text);
 		}
 	});
diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_instance.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_instance.cpp
