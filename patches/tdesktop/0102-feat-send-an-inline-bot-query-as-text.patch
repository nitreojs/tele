diff --git a/Telegram/SourceFiles/tele/tele_inline_text.cpp b/Telegram/SourceFiles/tele/tele_inline_text.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8a7dc7269968a18544be0b5fa6d97fa09693993e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_inline_text.cpp
@@ -0,0 +1,102 @@
+#include "tele/tele_inline_text.h"
+
+#include "base/event_filter.h"
+#include "menu/menu_send_details.h"
+#include "tele/tele_lowercase.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtGui/QKeyEvent>
+#include <QtWidgets/QTextEdit>
+
+namespace Tele {
+namespace {
+
+class Handler final : public QObject {
+public:
+	Handler(
+		not_null<Ui::InputField*> field,
+		Fn<bool()> active,
+		Fn<void()> send)
+	: QObject(field)
+	, _active(std::move(active))
+	, _send(std::move(send)) {
+	}
+
+	[[nodiscard]] bool active() const {
+		return _active();
+	}
+	void send() const {
+		_send();
+	}
+
+private:
+	const Fn<bool()> _active;
+	const Fn<void()> _send;
+
+};
+
+[[nodiscard]] Handler *FindHandler(not_null<Ui::InputField*> field) {
+	for (const auto child : field->children()) {
+		if (const auto handler = dynamic_cast<Handler*>(child)) {
+			return handler;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] bool IsShortcut(not_null<QKeyEvent*> event) {
+	const auto key = event->key();
+	const auto modifiers = event->modifiers()
+		& ~(Qt::KeypadModifier | Qt::GroupSwitchModifier);
+	return (key == Qt::Key_Enter || key == Qt::Key_Return)
+		&& (modifiers == (Qt::ControlModifier | Qt::ShiftModifier));
+}
+
+} // namespace
+
+void SetupInlineAsText(
+		not_null<Ui::InputField*> field,
+		Fn<bool()> active,
+		Fn<void()> send) {
+	const auto handler = new Handler(
+		field,
+		std::move(active),
+		std::move(send));
+	base::install_event_filter(
+		handler,
+		field->rawTextEdit(),
+		[=](not_null<QEvent*> e) {
+			if (e->type() != QEvent::KeyPress
+				|| !IsShortcut(static_cast<QKeyEvent*>(e.get()))
+				|| !handler->active()) {
+				return base::EventFilterResult::Continue;
+			}
+			handler->send();
+			return base::EventFilterResult::Cancel;
+		});
+}
+
+SendMenu::Details InlineAsTextMenu(
+		not_null<Ui::InputField*> field,
+		SendMenu::Details details) {
+	const auto handler = FindHandler(field);
+	if (!handler || !handler->active()) {
+		return {};
+	}
+	details.teleMenu = crl::guard(handler, [=](
+			not_null<Ui::PopupMenu*> menu) {
+		if (!menu->empty()) {
+			menu->addSeparator();
+		}
+		menu->addAction(Lower(u"Send as text"_q), crl::guard(handler, [=] {
+			if (handler->active()) {
+				handler->send();
+			}
+		}), &st::menuIconSend);
+	});
+	return details;
+}
+
+} // namespace Tele
