From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Mon, 28 Sep 2026 04:23:42 +0300
Subject: [PATCH] fix: name the item Copy Callback Data like telegram does

---
 Telegram/SourceFiles/tele/tele_button_payload.cpp | 4 ++--
 Telegram/SourceFiles/tele/tele_menu_order.cpp     | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_button_payload.cpp b/Telegram/SourceFiles/tele/tele_button_payload.cpp
index 1b99c8bccb1b0dd91f7b99a153ae796e7557f8c1..915c21c0bc356fd58250e78c58984d3ac20555a3 100644
--- a/Telegram/SourceFiles/tele/tele_button_payload.cpp
+++ b/Telegram/SourceFiles/tele/tele_button_payload.cpp
@@ -299,10 +299,10 @@ void AddCopyButtonPayloadAction(
 	case Type::Callback:
 	case Type::CallbackWithPassword:
 		if (IsText(data)) {
-			action = u"Copy callback data"_q;
+			action = u"Copy Callback Data"_q;
 			text = QString::fromUtf8(data);
 		} else {
-			action = u"Copy callback data as hex"_q;
+			action = u"Copy Callback Data as hex"_q;
 			text = QString::fromLatin1(data.toHex());
 		}
 		toast = u"Callback data copied to clipboard."_q;
diff --git a/Telegram/SourceFiles/tele/tele_menu_order.cpp b/Telegram/SourceFiles/tele/tele_menu_order.cpp
index b1ca897790e58fcc55d8a20c7de2abb32bffacb3..ff14c692824e351433c0c8bdbda0b8e5cf1733ae 100644
--- a/Telegram/SourceFiles/tele/tele_menu_order.cpp
+++ b/Telegram/SourceFiles/tele/tele_menu_order.cpp
@@ -233,9 +233,9 @@ struct Found {
 				&st::menuIconLink },
 		} },
 		{ u"copy_button_data"_q, {
-			{ [](int) { return Lower(u"Copy callback data"_q); },
+			{ [](int) { return Lower(u"Copy Callback Data"_q); },
 				&st::menuIconCopy },
-			{ [](int) { return Lower(u"Copy callback data as hex"_q); },
+			{ [](int) { return Lower(u"Copy Callback Data as hex"_q); },
 				&st::menuIconCopy },
 			{ [](int) { return Lower(u"Copy inline query"_q); },
 				&st::menuIconCopy },
