+class ShotGrid final : public Ui::RpWidget {
+public:
+	using RpWidget::RpWidget;
+
+	void add(not_null<Ui::RpWidget*> cell);
+
+private:
+	int resizeGetHeight(int newWidth) override;
+
+	std::vector<not_null<Ui::RpWidget*>> _cells;
+	bool _inResize = false;
+
+};
+
+void ShotGrid::add(not_null<Ui::RpWidget*> cell) {
+	_cells.push_back(cell);
+	cell->heightValue() | rpl::on_next([=] {
+		if (!_inResize) {
+			resizeToWidth(width());
+		}
+	}, cell->lifetime());
+}
+
+int ShotGrid::resizeGetHeight(int newWidth) {
+	if (newWidth <= 0) {
+		return 0;
+	}
+	_inResize = true;
+	const auto guard = gsl::finally([&] { _inResize = false; });
+
+	const auto columns = (newWidth >= 2 * st::boxWidth) ? 2 : 1;
+	const auto cellWidth = newWidth / columns;
+	const auto count = int(_cells.size());
+	auto top = 0;
+	for (auto i = 0; i < count; i += columns) {
+		auto rowHeight = 0;
+		for (auto j = 0; j != columns && i + j != count; ++j) {
+			const auto cell = _cells[i + j];
+			const auto left = j * cellWidth;
+			cell->resizeToWidth((j + 1 == columns)
+				? (newWidth - left)
+				: cellWidth);
+			cell->moveToLeft(left, top, newWidth);
+			rowHeight = std::max(rowHeight, cell->height());
+		}
+		top += rowHeight;
+	}
+	return top;
+}
