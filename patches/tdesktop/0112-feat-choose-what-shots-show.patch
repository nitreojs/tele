+struct PartKey {
+	ShotPart part;
+	const char *key;
+};
+
+constexpr auto kPartKeys = std::array{
+	PartKey{ ShotPart::Names, "names" },
+	PartKey{ ShotPart::Userpics, "userpics" },
+	PartKey{ ShotPart::Replies, "replies" },
+	PartKey{ ShotPart::Forwards, "forwards" },
+	PartKey{ ShotPart::Previews, "previews" },
+	PartKey{ ShotPart::Buttons, "buttons" },
+	PartKey{ ShotPart::Reactions, "reactions" },
+	PartKey{ ShotPart::Info, "info" },
+};
+
+[[nodiscard]] ShotOptions LoadOptions() {
+	auto result = ShotOptions();
+	const auto document = QJsonDocument::fromJson(ShotView().toUtf8());
+	if (!document.isObject()) {
+		return result;
+	}
+	const auto object = document.object();
+	const auto flag = [&](const char *key, bool &value) {
+		const auto i = object.find(QLatin1String(key));
+		if (i != object.end() && i->isBool()) {
+			value = i->toBool();
+		}
+	};
+	flag("background", result.background);
+	flag("dates", result.dates);
+	flag("transparent", result.transparent);
+	for (const auto &[part, key] : kPartKeys) {
+		auto shown = !(result.hidden & uint16(part));
+		flag(key, shown);
+		if (shown) {
+			result.hidden &= ~uint16(part);
+		} else {
+			result.hidden |= uint16(part);
+		}
+	}
+	const auto scale = object.value(u"scale"_q).toInt(result.scale);
+	result.scale = std::clamp(scale, 1, kMaxScale);
+	return result;
+}
+
+void SaveOptions(const ShotOptions &options) {
+	auto object = QJsonObject();
+	object.insert(u"background"_q, options.background);
+	object.insert(u"dates"_q, options.dates);
+	object.insert(u"transparent"_q, options.transparent);
+	for (const auto &[part, key] : kPartKeys) {
+		object.insert(QLatin1String(key), !(options.hidden & uint16(part)));
+	}
+	object.insert(u"scale"_q, options.scale);
+	SetShotView(QString::fromUtf8(
+		QJsonDocument(object).toJson(QJsonDocument::Compact)));
+}
+
+[[nodiscard]] bool &HidingButtons() {
