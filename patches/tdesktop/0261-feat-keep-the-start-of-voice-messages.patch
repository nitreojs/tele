-	auto skipSamples = static_cast<int>(kCaptureSkipDuration * kCaptureFrequency / 1000);
+	auto skipSamples = _skipSamples;
 	auto fadeSamples = _fadeSamples;
 	if (d->fullSamples < skipSamples + fadeSamples) {
 		int32 fadedCnt = std::min(
