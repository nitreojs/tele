diff --git a/Telegram/SourceFiles/tele/tele_window_size.cpp b/Telegram/SourceFiles/tele/tele_window_size.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..03f2ac649975b9325ba8587022adef0e748ac4ad
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_window_size.cpp
@@ -0,0 +1,25 @@
+#include "tele/tele_window_size.h"
+
+#include "tele/tele_options.h"
+#include "ui/style/style_core_scale.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kSmallSide = 256;
+
+} // namespace
+
+int WindowMinWidth(int width) {
+	return SmallWindow()
+		? std::min(width, style::ConvertScale(kSmallSide))
+		: width;
+}
+
+int WindowMinHeight(int height) {
+	return SmallWindow()
+		? std::min(height, style::ConvertScale(kSmallSide))
+		: height;
+}
+
+} // namespace Tele
