+struct SliceEdge {
+	bool first = false;
+	bool last = false;
+};
+
+// Native history copy uses Ui::Text::Mid on directly addressed boundary
+// leaves. Count distinct offsets, not just distinct resulting text.
+[[nodiscard]] int TrimmedTextMatches(
+		const RichText &source,
+		const RichText &quote,
+		SliceEdge edge) {
+	if (source.anchorId != quote.anchorId
+		|| source.anchorIds != quote.anchorIds) {
+		return 0;
+	}
+	const auto from = QStringView(source.text.text);
+	const auto text = QStringView(quote.text.text);
+	const auto plain = source.text.entities.empty();
+	if (text.isEmpty()
+		|| text.size() >= from.size()
+		|| (plain && !quote.text.entities.empty())) {
+		return 0;
+	}
+	const auto last = from.size() - text.size();
+	const auto min = edge.last ? 0 : last;
+	const auto max = edge.first ? last : 0;
+	auto result = 0;
+	for (auto i = min; i <= max;) {
+		const auto offset = from.indexOf(text, i);
+		if (offset < 0 || offset > max) {
+			break;
+		}
+		const auto till = offset + text.size();
+		if ((offset == 0 || !from.at(offset).isLowSurrogate())
+			&& (till == from.size() || !from.at(till).isLowSurrogate())
+			&& (plain
+				|| Ui::Text::Mid(source.text, int(offset), int(text.size()))
+					== quote.text)
+			&& ++result == 2) {
+			break;
+		}
+		i = offset + 1;
+	}
+	return result;
+}
+
+[[nodiscard]] int ListItemMatches(
+		const Iv::RichPage::ListItem &source,
+		const Iv::RichPage::ListItem &quote,
+		SliceEdge edge) {
+	if (source.taskState != quote.taskState
+		|| source.number != quote.number
+		|| source.anchorId != quote.anchorId
+		|| source.blocks != quote.blocks) {
+		return 0;
+	}
+	return (source.text == quote.text)
+		? 1
+		: TrimmedTextMatches(source.text, quote.text, edge);
+}
+
+[[nodiscard]] int ListMatches(
+		const Block &source,
+		const Block &quote,
+		SliceEdge edge) {
+	// In the parsed model a list's only variable data besides its
+	// anchor and numbering is the item vector. Preserve original numbering,
+	// exactly as the history selection copier does when erasing edge items.
+	if (source.listKind != quote.listKind
+		|| source.orderedList != quote.orderedList
+		|| source.anchorId != quote.anchorId) {
+		return 0;
+	}
+	const auto size = int(quote.listItems.size());
+	const auto last = int(source.listItems.size()) - size;
+	if (!size || last < 0) {
+		return 0;
+	}
+	auto result = 0;
+	for (auto i = (edge.last ? 0 : last), end = (edge.first ? last : 0);
+			i <= end;
+			++i) {
+		auto matches = 1;
+		for (auto j = 0; j != size; ++j) {
+			const auto count = ListItemMatches(
+				source.listItems[i + j],
+				quote.listItems[j],
+				{ edge.first && j == 0, edge.last && j == size - 1 });
+			if (!count) {
+				matches = 0;
+				break;
+			}
+			matches = std::max(matches, count);
+		}
+		result += matches;
+		if (result >= 2) {
+			return 2;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] int BoundaryBlockMatches(
+		const Block &source,
+		const Block &quote,
+		SliceEdge edge) {
+	if (source.kind != quote.kind) {
+		return 0;
+	}
+	if (source.kind == BlockKind::List && !quote.listItems.empty()) {
+		return ListMatches(source, quote, edge);
+	}
+	if (source == quote) {
+		return 1;
+	}
+	const auto text = [&] {
+		switch (source.kind) {
+		case BlockKind::Heading:
+		case BlockKind::Paragraph:
+		case BlockKind::Footer:
+		case BlockKind::Code:
+		case BlockKind::Thinking:
+		case BlockKind::Details:
+		case BlockKind::Table:
+			return true;
+		case BlockKind::Quote:
+			return source.blocks.empty() && !source.collapsed;
+		default:
+			return false;
+		}
+	}();
+	const auto caption = [&] {
+		switch (source.kind) {
+		case BlockKind::Quote:
+			return !source.collapsed;
+		case BlockKind::Photo:
+		case BlockKind::Video:
+		case BlockKind::Audio:
+		case BlockKind::File:
+		case BlockKind::GroupedMedia:
+		case BlockKind::Map:
+			return true;
+		default:
+			return false;
+		}
+	}();
+	const auto trimText = (source.text != quote.text);
+	const auto trimCaption = (source.caption != quote.caption);
+	if ((!trimText && !trimCaption)
+		|| (trimText && !text)
+		|| (trimCaption && !caption)
+		|| (trimText && trimCaption && (!edge.first || !edge.last))) {
+		return 0;
+	}
+	const auto textCount = trimText
+		? TrimmedTextMatches(
+			source.text,
+			quote.text,
+			{ edge.first, edge.last && !trimCaption })
+		: 1;
+	const auto captionCount = trimCaption
+		? TrimmedTextMatches(
+			source.caption,
+			quote.caption,
+			{ edge.first && !trimText, edge.last })
+		: 1;
+	if (!textCount || !captionCount || source.anchorId != quote.anchorId) {
+		return 0;
+	}
+	// Compare canonical metadata and children without cloning tables or
+	// nested blocks merely to replace their directly addressed text.
+	const auto metadataMatches = [&] {
+		switch (source.kind) {
+		case BlockKind::Quote:
+			return (source.pullquote == quote.pullquote)
+				&& (source.collapsed == quote.collapsed)
+				&& (source.blocks == quote.blocks);
+		case BlockKind::Details:
+			return (source.open == quote.open)
+				&& (source.blocks == quote.blocks);
+		case BlockKind::Table:
+			return (source.bordered == quote.bordered)
+				&& (source.striped == quote.striped)
+				&& (source.compact == quote.compact)
+				&& (source.tableRows == quote.tableRows);
+		case BlockKind::GroupedMedia:
+			return (source.mediaIntent == quote.mediaIntent)
+				&& (source.mediaItems == quote.mediaItems);
+		default: {
+			auto trimmed = source;
+			trimmed.text = quote.text;
+			trimmed.caption = quote.caption;
+			return trimmed == quote;
+		}
+		}
+	}();
+	return metadataMatches ? std::max(textCount, captionCount) : 0;
+}
