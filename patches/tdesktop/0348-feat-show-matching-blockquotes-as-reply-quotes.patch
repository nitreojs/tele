+[[nodiscard]] bool IsPlainQuoteParagraph(const Block &block) {
+	return (block.kind == Iv::RichPage::BlockKind::Paragraph)
+		&& block.anchorId.isEmpty()
+		&& block.text.anchorId.isEmpty()
+		&& block.text.anchorIds.empty()
+		&& !block.text.text.empty();
+}
+
+[[nodiscard]] TextWithEntities LeadingRichQuoteText(const Block &block) {
+	if (block.blocks.empty()) {
+		return block.text.text;
+	}
+	auto result = TextWithEntities();
+	for (const auto &child : block.blocks) {
+		if (!IsPlainQuoteParagraph(child)) {
+			return {};
+		}
+		if (!result.empty()) {
+			result.append(QChar('\n'));
+		}
+		result.append(child.text.text);
+	}
+	return result;
+}
