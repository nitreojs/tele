+void Reply::paintRichBlock(
+		Painter &p,
+		const Ui::ChatPaintContext &context,
+		QRect rect) const {
+	auto &preview = *_richBlockPreview;
+	if (!preview.article || rect.isEmpty()) {
+		return;
+	}
+	auto &article = *preview.article;
+	const auto paletteVersion = context.st->paletteVersion();
+	if (preview.paletteVersion != paletteVersion) {
+		preview.paletteVersion = paletteVersion;
+		article.invalidatePaletteCache();
+	}
+	const auto clip = context.clip.intersected(rect);
+	if (!clip.isEmpty()) {
+		const auto stm = context.messageStyle();
+		const auto repaint = [weak = preview.view] {
+			if (const auto owner = weak.get()) {
+				owner->repaint();
+			}
+		};
+		auto articleContext = Iv::Markdown::MarkdownArticlePaintContext(
+			context).translated(-rect.topLeft());
+		articleContext.clip = clip.translated(-rect.topLeft());
+		articleContext.paused = true;
+		articleContext.passiveMedia = true;
+		articleContext.selection = {};
+		articleContext.messageSelection = nullptr;
+		articleContext.highlight = {};
+		articleContext.highlightPathCache = nullptr;
+		const auto owner = preview.view.get();
+		articleContext.caches = {
+			.pre = stm->preCache.get(),
+			.blockquote = context.quoteCache(
+				_colorPeer ? _colorPeer->colorCollectible() : nullptr,
+				_colorPeer
+					? _colorPeer->colorIndex()
+					: std::max(int(_hiddenSenderColorIndexPlusOne) - 1, 0)),
+			.colors = context.st->highlightColors(),
+			.st = &stm->richPageStyle,
+			.repaint = repaint,
+			.repaintRect = [repaint](QRect) { repaint(); },
+		};
+		article.setVisibleTopBottom(
+			articleContext.clip.top(),
+			articleContext.clip.bottom() + 1);
+		p.save();
+		p.setClipRect(clip, Qt::IntersectClip);
+		p.translate(rect.topLeft());
+		article.paint(p, articleContext);
+		p.restore();
+		if (owner && article.hasHeavyPart()) {
+			owner->history()->owner().registerHeavyViewPart(owner);
+		}
+	}
+	if (preview.clipped) {
+		p.setFont(st::normalFont);
+		p.setPen(context.messageStyle()->historyTextFg);
+		p.drawText(
