+};
+
+[[nodiscard]] CellRange CellBounds(const GridCell &cell) {
+	return { cell.rowFrom, cell.rowTill, cell.columnFrom, cell.columnTill };
+}
+
+void IncludeCell(CellRange &range, const GridCell &cell) {
+	range.rowFrom = std::min(range.rowFrom, cell.rowFrom);
+	range.rowTill = std::max(range.rowTill, cell.rowTill);
+	range.columnFrom = std::min(range.columnFrom, cell.columnFrom);
+	range.columnTill = std::max(range.columnTill, cell.columnTill);
+}
+
+[[nodiscard]] const TableCell &SourceCell(
+		const Block &source,
+		const GridCell &cell) {
+	return source.tableRows[cell.rowIndex].cells[cell.cellIndex];
+}
+
+[[nodiscard]] bool CopiedCellEquals(
+		const Block &source,
+		const GridCell &cell,
+		const TableCell &quote) {
+	const auto &original = SourceCell(source, cell);
+	return (cell.rowTill - cell.rowFrom == quote.rowspan)
+		&& (cell.columnTill - cell.columnFrom == quote.colspan)
+		&& (original.header == quote.header)
+		&& (original.alignment == quote.alignment)
+		&& (original.verticalAlignment == quote.verticalAlignment)
+		&& (original.text == quote.text);
+}
+
+[[nodiscard]] bool IsSelectableCellRange(
+		std::span<const GridCell> cells,
+		const CellRange &range) {
+	const auto contains = [&](const GridCell &cell) {
+		return Iv::Editor::TableGridCellIntersectsRange(cell, range);
+	};
+	auto corners = std::array<const GridCell*, 4>();
+	auto spans = false;
+	for (const auto &cell : cells) {
+		if (!contains(cell)) {
+			continue;
+		}
+		if (cell.rowFrom == range.rowFrom) {
+			if (cell.columnFrom == range.columnFrom) {
+				corners[0] = &cell;
+			}
+			if (cell.columnTill == range.columnTill) {
+				corners[1] = &cell;
+			}
+		}
+		if (cell.rowTill == range.rowTill) {
+			if (cell.columnFrom == range.columnFrom) {
+				corners[2] = &cell;
+			}
+			if (cell.columnTill == range.columnTill) {
+				corners[3] = &cell;
+			}
+		}
+		spans = spans
+			|| (cell.rowTill - cell.rowFrom > 1)
+			|| (cell.columnTill - cell.columnFrom > 1);
+	}
+	const auto opposite = [&](int a, int b) {
+		return corners[a] && corners[b] && corners[a] != corners[b];
+	};
+	if (opposite(0, 3) || opposite(1, 2)) {
+		return true;
+	} else if (!spans) {
+		return false;
+	}
+	const auto selectsRange = [&](const GridCell &a, const GridCell &b) {
+		auto actual = CellBounds(a);
+		IncludeCell(actual, b);
+		while (actual != range) {
+			const auto before = actual;
+			for (const auto &cell : cells) {
+				if (Iv::Editor::TableGridCellIntersectsRange(cell, actual)) {
+					IncludeCell(actual, cell);
+				}
+			}
+			if (actual == before) {
+				return false;
+			}
+		}
+		return true;
+	};
+	// Merged cells can grow a selection past either hit cell.
+	for (auto i = size_t(0); i < cells.size(); ++i) {
+		if (!contains(cells[i])) {
+			continue;
+		}
+		for (auto j = i + 1; j < cells.size(); ++j) {
+			if (contains(cells[j]) && selectsRange(cells[i], cells[j])) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] int TableRangeMatches(
+		const Block &source,
+		const Block &quote,
+		const Iv::Markdown::MarkdownPrepareTableRenderLimits &limits,
+		bool skipWholeMatch) {
+	// TableCellRangeBlocks preserves the title and table styling, drops
+	// anchor/caption, and copies cells with their prepared spans.
+	const auto height = int(quote.tableRows.size());
+	if (source.kind != BlockKind::Table
+		|| !height
+		|| height > int(source.tableRows.size())
+		|| !quote.anchorId.isEmpty()
+		|| quote.caption != RichText()
+		|| source.bordered != quote.bordered
+		|| source.striped != quote.striped
+		|| source.compact != quote.compact
+		|| source.text != quote.text) {
+		return 0;
+	}
+	const auto &firstRow = quote.tableRows.front().cells;
+	if (firstRow.empty()) {
+		return 0;
+	}
+	const auto grid = Iv::Editor::BuildTableGrid(source, limits);
+	const auto cells = std::span(grid.cells);
+	const auto rowStart = [&](int row) {
+		return std::lower_bound(
+			cells.begin(),
+			cells.end(),
+			row,
+			[](const GridCell &cell, int row) {
+				return cell.rowFrom < row;
+			}) - cells.begin();
+	};
+	auto result = 0;
+	for (auto row = 0; row + height <= grid.rowCount; ++row) {
+		const auto first = rowStart(row);
+		const auto last = rowStart(row + height);
+		const auto candidates = cells.subspan(first, last - first);
+		if (ranges::none_of(candidates, [&](const GridCell &cell) {
+			return (cell.rowFrom == row)
+				&& CopiedCellEquals(source, cell, firstRow.front());
+		})) {
+			continue;
+		}
+		for (auto left = 0; left < grid.columnCount; ++left) {
+			for (auto right = left + 1; right <= grid.columnCount; ++right) {
+				const auto range = CellRange{ row, row + height, left, right };
+				if (skipWholeMatch
+					&& range == CellRange{ 0, grid.rowCount, 0, grid.columnCount }) {
+					continue;
+				}
+				auto matches = true;
+				auto bounds = std::optional<CellRange>();
+				auto index = first;
+				for (auto y = 0; y != height && matches; ++y) {
+					const auto &expected = quote.tableRows[y].cells;
+					auto current = size_t(0);
+					for (; index != last && cells[index].rowFrom == row + y;
+							++index) {
+						const auto &cell = cells[index];
+						if (!Iv::Editor::TableGridCellIntersectsRange(cell, range)) {
+							continue;
+						} else if (current == expected.size()
+							|| !CopiedCellEquals(source, cell, expected[current++])) {
+							matches = false;
+							break;
+						}
+						if (bounds) {
+							IncludeCell(*bounds, cell);
+						} else {
+							bounds = CellBounds(cell);
+						}
+					}
+					matches = matches && (current == expected.size());
+				}
+				if (!matches || bounds != range) {
+					continue;
+				}
+				// Spans that begin above the top edge also pull the
+				// selection outside this rectangle.
+				if (ranges::any_of(cells.first(first), [&](const GridCell &cell) {
+					return Iv::Editor::TableGridCellIntersectsRange(cell, range);
+				})) {
+					continue;
+				}
+				if (IsSelectableCellRange(candidates, range)
+					&& ++result == 2) {
+					return result;
+				}
+			}
+		}
+	}
+	return result;
+}
+
+struct StructuralMatches {
+	int count = 0;
+	std::vector<BlockPath> paths;
+};
+
+void FindBlockRanges(
+		const std::vector<Block> &blocks,
+		std::span<const Block> quote,
+		const Iv::Markdown::MarkdownPrepareTableRenderLimits *limits,
+		Iv::Markdown::PreparedEditBlockContainerPath &container,
+		StructuralMatches &result) {
+	const auto size = int(quote.size());
+	const auto end = int(blocks.size()) - size;
+	for (auto i = 0; i <= end && result.count < 2; ++i) {
+		auto count = 1;
+		for (auto j = 0; j != size; ++j) {
+			const auto edge = SliceEdge{ j == 0, j == size - 1 };
+			const auto &block = blocks[i + j];
+			const auto &part = quote[j];
+			auto matches = (edge.first || edge.last)
+				? BoundaryBlockMatches(block, part, edge)
+				: int(block == part);
+			if (limits && part.kind == BlockKind::Table) {
+				matches += TableRangeMatches(block, part, *limits, matches > 0);
+			}
+			if (!matches) {
+				count = 0;
+				break;
+			}
+			count = std::max(matches, count);
+		}
+		if (count && !result.count) {
+			result.paths.reserve(size);
+			for (auto j = 0; j != size; ++j) {
+				result.paths.push_back({ .container = container, .index = i + j });
+			}
+		}
+		result.count += count;
+	}
+	for (auto i = 0; i != int(blocks.size()) && result.count < 2; ++i) {
+		const auto &block = blocks[i];
+		if (!block.blocks.empty()) {
+			container.steps.push_back({ ContainerKind::BlockChildren, i });
+			FindBlockRanges(block.blocks, quote, limits, container, result);
+			container.steps.pop_back();
+		}
+		for (auto j = 0; j != int(block.listItems.size()) && result.count < 2; ++j) {
+			const auto &children = block.listItems[j].blocks;
+			if (!children.empty()) {
+				container.steps.push_back({ ContainerKind::ListItemChildren, i, j });
+				FindBlockRanges(children, quote, limits, container, result);
+				container.steps.pop_back();
+			}
+		}
+	}
+}
+
+[[nodiscard]] StructuralMatches FindStructuralMatches(
+		const Iv::RichPage &source,
+		std::span<const Block> quote,
+		not_null<Main::Session*> session) {
+	auto result = StructuralMatches();
+	const auto includesTable = ranges::any_of(quote, [](const Block &part) {
+		return part.kind == BlockKind::Table;
+	});
+	const auto limits = includesTable
+		? std::make_optional(Iv::Markdown::PrepareTableRenderLimitsForRichMessage(
+			Iv::ResolveRichMessageLimits(session)))
+		: std::nullopt;
+	auto container = Iv::Markdown::PreparedEditBlockContainerPath();
+	FindBlockRanges(
+		source.blocks,
+		quote,
+		limits ? &*limits : nullptr,
+		container,
+		result);
+	return result;
+}
+
+[[nodiscard]] TextWithEntities LeadingTextQuote(
+		const TextWithEntities &body,
+		int &prefix) {
+	const auto first = ranges::find_if(body.entities, [](const auto &entity) {
+		return entity.offset() == 0 && entity.type() == EntityType::Blockquote;
+	});
+	if (first == body.entities.cend()) {
+		return {};
+	}
+	const auto length = first->length();
+	if (length <= 0 || length > body.text.size()) {
+		return {};
+	}
+	prefix = length;
+	while (prefix < body.text.size() && body.text.at(prefix) == QChar('\n')) {
+		++prefix;
+	}
+	auto result = TextWithEntities{ body.text.left(length) };
+	for (const auto &entity : body.entities) {
+		if (&entity == &*first || entity.offset() >= prefix) {
+			continue;
+		} else if (entity.type() == EntityType::Blockquote
+			|| entity.offset() + entity.length() > length) {
+			return {};
+		}
+		result.entities.push_back(entity);
+	}
+	return result;
+}
+
+[[nodiscard]] std::shared_ptr<const Iv::RichQuote> MatchTextQuote(
+		not_null<Main::Session*> session,
+		const Iv::RichPage &page,
+		TextWithEntities quoted) {
+	const auto model = page.quoteModel.get();
+	const auto limit = session->appConfig().quoteLengthMax();
+	if (!model
+		|| model->partial()
+		|| quoted.text.trimmed().isEmpty()
+		|| quoted.text.size() > limit) {
+		return nullptr;
+	}
+	const auto &projection = model->projection();
+	const auto offset = projection.indexOf(quoted.text);
+	if (offset < 0 || projection.indexOf(quoted.text, offset + 1) >= 0) {
+		return nullptr;
+	}
+	const auto built = Iv::BuildRichQuote(session, page, {
+		.from = int(offset),
+		.till = int(offset + quoted.text.size()),
+	}, limit);
+	if (!built || built->offset != offset || built->overflown) {
+		return nullptr;
+	}
+	auto quote = Iv::ParseRichQuote(session, built->fragments, built->offset);
+	Iv::Markdown::SortEntities(&quoted);
+	return (quote && quote->text == quoted) ? std::move(quote) : nullptr;
+}
+
 } // namespace
 
+PromotedReplyQuote PromoteReplyQuote(
+		not_null<const HistoryItem*> item,
+		not_null<const HistoryMessageReply*> reply) {
+	if (!PromoteReplyQuotes()) {
+		return {};
+	}
+	const auto &fields = reply->fields();
+	const auto source = reply->resolvedMessage.get();
+	if (!source
+		|| source == item.get()
+		|| fields.manualQuote
+		|| !fields.quote.empty()
+		|| fields.richQuote
+		|| fields.todoItemId
+		|| !fields.pollOption.isEmpty()
+		|| item->groupId()
+		|| !item->computeUnavailableReason().isEmpty()
+		|| &item->translatedText() != &item->originalText()
+		|| &source->translatedText() != &source->originalText()) {
+		return {};
+	}
+	const auto page = source->richPage();
+	if (!page
+		|| page->part
+		|| !source->computeUnavailableReason().isEmpty()
+		|| source->translatedRichPage() != page) {
+		return {};
+	}
+	const auto body = item->richPage();
+	if (item->translatedRichPage() != body) {
+		return {};
+	}
+	const auto session = &item->history()->session();
+	if (!body) {
+		auto prefix = 0;
+		auto quote = MatchTextQuote(
+			session,
+			*page,
+			LeadingTextQuote(item->originalText(), prefix));
+		return quote
+			? PromotedReplyQuote{ .quote = std::move(quote), .textPrefix = prefix }
+			: PromotedReplyQuote();
+	}
+	const auto outer = body->part ? nullptr : LeadingRichQuoteBlock(*body);
+	if (!outer) {
+		return {};
+	} else if (outer->blocks.empty()) {
+		auto quote = MatchTextQuote(session, *page, outer->text.text);
+		return quote
+			? PromotedReplyQuote{ .quote = std::move(quote), .richBlock = true }
+			: PromotedReplyQuote();
+	}
+	auto matched = FindStructuralMatches(*page, outer->blocks, session);
+	if (matched.count != 1) {
+		return {};
+	}
+	if (auto quote = MatchTextQuote(session, *page, LeadingRichQuoteText(*outer))) {
+		return { .quote = std::move(quote), .richBlock = true };
+	}
+	auto preview = std::make_shared<Iv::RichPage>();
+	preview->url = body->url;
+	preview->rtl = body->rtl;
+	preview->blocks = outer->blocks;
+	return {
+		.richBlock = true,
+		.preview = std::move(preview),
+		.sourcePage = page,
+		.sourcePaths = std::move(matched.paths),
+	};
+}
