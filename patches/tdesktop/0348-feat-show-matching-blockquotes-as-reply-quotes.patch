+		&& block.anchorId.isEmpty()
+		&& block.text.anchorId.isEmpty()
+		&& block.text.anchorIds.empty()
+		&& block.caption == Iv::RichPage::RichText()
+		&& !block.pullquote
+		&& (block.blocks.empty() || block.text.text.empty()))
