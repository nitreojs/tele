From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Thu, 5 Nov 2026 15:35:43 +0300
Subject: [PATCH] fix: saving or copying a shot of a gif no longer crashes tele

---
 .../history/view/media/history_view_gif.cpp   | 31 ++++++++++++++-----
 1 file changed, 24 insertions(+), 7 deletions(-)

diff --git a/Telegram/SourceFiles/history/view/media/history_view_gif.cpp b/Telegram/SourceFiles/history/view/media/history_view_gif.cpp
index 3c9ead768a8287ec5deb1a34f770520bbd42d868..aae1440898c3ea7c3597ef3a0c7bae937c6ab342 100644
--- a/Telegram/SourceFiles/history/view/media/history_view_gif.cpp
+++ b/Telegram/SourceFiles/history/view/media/history_view_gif.cpp
@@ -774,13 +774,15 @@ void Gif::draw(Painter &p, const PaintContext &context) const {
 			_seekLastFrame = QImage();
 		}
 		auto paused = context.paused || !shouldBePlaying;
+		const auto sharp = Tele::ShotSharpRatio();
 		auto request = ::Media::Streaming::FrameRequest{
 			.outer = (ScaledInstantViewMediaSize(
 				QSize(usew, painth),
 				HostedInstantViewMediaPixelScale(_parent))
-				* style::DevicePixelRatio()),
+				* (sharp ? sharp : style::DevicePixelRatio())),
 			.blurredBackground = true,
 		};
+		auto shotRounding = Images::CornersMaskRef();
 		if (isRound) {
 			if (activeRoundStreamed()) {
 				paused = false;
@@ -789,9 +791,16 @@ void Gif::draw(Painter &p, const PaintContext &context) const {
 			}
 			validateRoundingMask(request.outer);
 			request.mask = _roundingMask;
+		} else if (sharp) {
+			shotRounding = MediaRoundingMask(rounding);
 		} else {
 			request.rounding = MediaRoundingMask(rounding);
 		}
+		const auto shotRound = [&](QImage image) {
+			return (sharp && !isRound)
+				? Images::Round(std::move(image), shotRounding)
+				: image;
+		};
 		if (!activeRoundPlaying && activeOwnPlaying->instance.playerLocked()) {
 			if (activeOwnPlaying->frozenFrame.isNull()) {
 				activeOwnPlaying->frozenRequest = request;
@@ -801,7 +810,7 @@ void Gif::draw(Painter &p, const PaintContext &context) const {
 				activeOwnPlaying->frozenRequest = request;
 				activeOwnPlaying->frozenFrame = streamed->frame(request);
 			}
-			p.drawImage(rthumb, activeOwnPlaying->frozenFrame);
+			p.drawImage(rthumb, shotRound(activeOwnPlaying->frozenFrame));
 		} else {
 			if (activeOwnPlaying
 				&& !activeOwnPlaying->frozenFrame.isNull()) {
@@ -810,7 +819,7 @@ void Gif::draw(Painter &p, const PaintContext &context) const {
 			}
 
 			const auto frame = streamed->frameWithInfo(request);
-			p.drawImage(rthumb, frame.image);
+			p.drawImage(rthumb, shotRound(frame.image));
 			if (_seeking) {
 				_seekLastFrame = frame.image;
 			}
@@ -1887,11 +1896,19 @@ void Gif::drawGrouped(
 		const auto pixSize = Ui::GetImageScaleSizeForGeometry(
 			{ originalWidth, originalHeight },
 			{ scaled.width(), scaled.height() });
-		const auto ratio = style::DevicePixelRatio();
+		const auto sharp = Tele::ShotSharpRatio();
+		const auto ratio = sharp ? sharp : style::DevicePixelRatio();
 		auto request = ::Media::Streaming::FrameRequest{
 			.resize = pixSize * ratio,
 			.outer = scaled * ratio,
-			.rounding = MediaRoundingMask(rounding),
+			.rounding = (sharp
+				? Images::CornersMaskRef()
+				: MediaRoundingMask(rounding)),
+		};
+		const auto shotRound = [&](QImage image) {
+			return sharp
+				? Images::Round(std::move(image), MediaRoundingMask(rounding))
+				: image;
 		};
 		if (activeOwnPlaying->instance.playerLocked()) {
 			if (activeOwnPlaying->frozenFrame.isNull()) {
@@ -1902,13 +1919,13 @@ void Gif::drawGrouped(
 				activeOwnPlaying->frozenRequest = request;
 				activeOwnPlaying->frozenFrame = streamed->frame(request);
 			}
-			p.drawImage(geometry, activeOwnPlaying->frozenFrame);
+			p.drawImage(geometry, shotRound(activeOwnPlaying->frozenFrame));
 		} else {
 			if (activeOwnPlaying) {
 				activeOwnPlaying->frozenFrame = QImage();
 				activeOwnPlaying->frozenStatusText = QString();
 			}
-			p.drawImage(geometry, streamed->frame(request));
+			p.drawImage(geometry, shotRound(streamed->frame(request)));
 			const auto paused = context.paused
 				|| (autoplayUnderCursor() && !underCursor(!_smallGroupPart));
 			if (!paused) {
