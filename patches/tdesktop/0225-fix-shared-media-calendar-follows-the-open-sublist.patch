From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 4 Oct 2026 12:03:34 +0300
Subject: [PATCH] fix: shared media calendar follows the open sublist

---
 Telegram/SourceFiles/data/data_search_calendar.cpp    | 11 +++++++++--
 Telegram/SourceFiles/data/data_search_calendar.h      |  2 ++
 Telegram/SourceFiles/info/media/info_media_widget.cpp |  6 +++++-
 .../profile/tabs/adapters/info_profile_tab_media.cpp  |  8 +++++++-
 .../SourceFiles/window/window_session_controller.cpp  |  1 +
 5 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/Telegram/SourceFiles/data/data_search_calendar.cpp b/Telegram/SourceFiles/data/data_search_calendar.cpp
index 5ce8cd9fd85f5e68820dec85be299b77755beb93..9522600693694ad66f02f485aebda31e97e486a2 100644
--- a/Telegram/SourceFiles/data/data_search_calendar.cpp
+++ b/Telegram/SourceFiles/data/data_search_calendar.cpp
@@ -32,9 +32,11 @@ namespace {
 SearchCalendarController::SearchCalendarController(
 	not_null<Main::Session*> session,
 	PeerId peerId,
+	PeerId savedPeerId,
 	Storage::SharedMediaType type)
 : _session(session)
 , _peerId(peerId)
+, _savedPeerId(savedPeerId)
 , _type(type)
 , _api(&session->mtp()) {
 }
@@ -99,6 +101,9 @@ void SearchCalendarController::sendDeferredRequests() {
 
 void SearchCalendarController::performMonthRequest(const MonthKey &key) {
 	const auto peer = _session->data().peer(key.peerId);
+	const auto saved = _savedPeerId
+		? _session->data().peer(_savedPeerId).get()
+		: nullptr;
 	const auto filter = PrepareSearchFilter(_type);
 
 	const auto month = QDate(key.year, key.month, 1);
@@ -113,9 +118,11 @@ void SearchCalendarController::performMonthRequest(const MonthKey &key) {
 
 	data.requestId = _api.request(
 		MTPmessages_GetSearchResultsCalendar(
-			MTP_flags(0),
+			MTP_flags(saved
+				? MTPmessages_GetSearchResultsCalendar::Flag::f_saved_peer_id
+				: MTPmessages_GetSearchResultsCalendar::Flag()),
 			peer->input(),
-			MTPInputPeer(),
+			saved ? saved->input() : MTPInputPeer(),
 			filter,
 			MTP_int(data.state.offsetId),
 			MTP_int(usedDate)
diff --git a/Telegram/SourceFiles/data/data_search_calendar.h b/Telegram/SourceFiles/data/data_search_calendar.h
index 0823d173aa0822fdb937c8bc8d6235fe088cece0..c9436e00e43e42949633502d3826c0583f3b1fa3 100644
--- a/Telegram/SourceFiles/data/data_search_calendar.h
+++ b/Telegram/SourceFiles/data/data_search_calendar.h
@@ -48,6 +48,7 @@ public:
 	SearchCalendarController(
 		not_null<Main::Session*> session,
 		PeerId peerId,
+		PeerId savedPeerId,
 		Storage::SharedMediaType type);
 
 	void monthThumbnails(
@@ -118,6 +119,7 @@ private:
 
 	const not_null<Main::Session*> _session;
 	const PeerId _peerId;
+	const PeerId _savedPeerId;
 	const Storage::SharedMediaType _type;
 
 	MTP::Sender _api;
diff --git a/Telegram/SourceFiles/info/media/info_media_widget.cpp b/Telegram/SourceFiles/info/media/info_media_widget.cpp
index 603958b00d8c1a430e8258d2932619fd2dacf642..724a857981818128809ef73b727e99079073af90 100644
--- a/Telegram/SourceFiles/info/media/info_media_widget.cpp
+++ b/Telegram/SourceFiles/info/media/info_media_widget.cpp
@@ -184,9 +184,13 @@ void Widget::fillTopBarMenu(const Ui::Menu::MenuCallback &addAction) {
 			_inner->zoomOut();
 		}, &st::menuIconZoomOut);
 	}
+	if (controller()->key().topic()) {
+		return;
+	}
 	addAction(tr::lng_calendar(tr::now), [=] {
+		const auto sublist = controller()->key().sublist();
 		controller()->parentController()->showCalendar({
-			.chat = Dialogs::Key(
+			.chat = sublist ? Dialogs::Key(sublist) : Dialogs::Key(
 				controller()->session().data().history(
 					controller()->key().peer())),
 			.date = QDate::currentDate(),
diff --git a/Telegram/SourceFiles/info/profile/tabs/adapters/info_profile_tab_media.cpp b/Telegram/SourceFiles/info/profile/tabs/adapters/info_profile_tab_media.cpp
index e3193bf310e72b58667c806ce2972e8eee1798a0..75f1fd416ae902bda28d4ab148164e3d77713d89 100644
--- a/Telegram/SourceFiles/info/profile/tabs/adapters/info_profile_tab_media.cpp
+++ b/Telegram/SourceFiles/info/profile/tabs/adapters/info_profile_tab_media.cpp
@@ -261,12 +261,18 @@ private:
 				list->zoomOut();
 			}, &st::menuIconZoomOut);
 		}
+		if (_context.topic) {
+			return;
+		}
 		const auto type = _type;
 		const auto peer = _context.peer;
+		const auto sublist = _context.sublist;
 		const auto controller = _subController.parentController();
 		addAction(tr::lng_calendar(tr::now), [=] {
 			controller->showCalendar({
-				.chat = Dialogs::Key(peer->owner().history(peer)),
+				.chat = (sublist
+					? Dialogs::Key(sublist)
+					: Dialogs::Key(peer->owner().history(peer))),
 				.date = QDate::currentDate(),
 				.mediaPhoto = (type != SharedMediaType::Video),
 				.mediaVideo = (type != SharedMediaType::Photo),
diff --git a/Telegram/SourceFiles/window/window_session_controller.cpp b/Telegram/SourceFiles/window/window_session_controller.cpp
index 0c75d4272568f75e5c117c77a7342b018641f0d2..72c9f9d602bba3ee0751c68f6948a344c883035b 100644
--- a/Telegram/SourceFiles/window/window_session_controller.cpp
+++ b/Telegram/SourceFiles/window/window_session_controller.cpp
@@ -3016,6 +3016,7 @@ void SessionController::showCalendar(ShowCalendarDescriptor &&descriptor) {
 		const auto search = std::make_shared<Api::SearchCalendarController>(
 			&session(),
 			history->peer->id,
+			sublist ? sublist->sublistPeer()->id : PeerId(),
 			(descriptor.mediaPhoto && descriptor.mediaVideo)
 				? Storage::SharedMediaType::PhotoVideo
 				: descriptor.mediaPhoto
