+void ChooseIconFile(
+		not_null<Window::SessionController*> controller,
+		::Tele::IconSlot slot) {
+	FileDialog::GetOpenPath(
+		Core::App().getFileDialogParent(),
+		::Tele::Lower(u"Choose an image"_q),
+		FileDialog::ImagesOrAllFilter(),
+		crl::guard(controller, [=](const FileDialog::OpenResult &result) {
+			if (result.paths.isEmpty() && result.remoteContent.isEmpty()) {
+				return;
+			}
+			const auto path = result.paths.isEmpty()
+				? QString()
+				: result.paths.front();
+			if (!::Tele::SetCustomIcon(slot, path, result.remoteContent)) {
+				controller->showToast(
+					::Tele::Lower(u"Couldn't read this image."_q));
+			}
+		}));
+}
+
+void AddIconButton(
+		SectionBuilder &builder,
+		const char id[],
+		rpl::producer<QString> label,
+		Fn<void(not_null<Ui::PopupMenu*>)> fill) {
+	const auto &option = base::options::lookup<QString>(id);
+	const auto description = ::Tele::Lower(option.description());
+	const auto button = builder.addButton({
+		.id = option.id(),
+		.title = rpl::single(::Tele::Lower(option.name())),
+		.st = &st::settingsButtonNoIcon,
+		.label = std::move(label),
+		.keywords = { description, u"logo"_q, u"image"_q },
+	});
+	if (button) {
+		const auto menu = button->lifetime().make_state<
+			base::unique_qptr<Ui::PopupMenu>>();
+		button->addClickHandler([=] {
+			*menu = base::make_unique_q<Ui::PopupMenu>(
+				button,
+				st::popupMenuWithIcons);
+			fill(menu->get());
+			(*menu)->popup(QCursor::pos());
+		});
+		SetupLink(button, option.id());
+	}
+	AddAbout(builder, description);
+}
+
+void AddAppIcons(SectionBuilder &builder) {
+	using Slot = ::Tele::IconSlot;
+	const auto controller = builder.controller();
+	const auto custom = u"custom"_q;
+	AddIconButton(
+		builder,
+		::Tele::kOptionAppIcon,
+		::Tele::AppIconValue() | rpl::map([=](const QString &value) {
+			return ::Tele::Lower((value == custom)
+				? u"Custom"_q
+				: u"Default"_q);
+		}),
+		[=](not_null<Ui::PopupMenu*> menu) {
+			menu->addAction(::Tele::Lower(u"Choose an image..."_q), [=] {
+				ChooseIconFile(controller, Slot::App);
+			}, &st::menuIconPhoto);
+			if (::Tele::AppIcon() == custom) {
+				menu->addAction(::Tele::Lower(u"Reset to default"_q), [] {
+					::Tele::ResetIcon(Slot::App);
+				}, &st::menuIconRestore);
+			}
+		});
+	AddIconButton(
+		builder,
+		::Tele::kOptionTrayIcon,
+		::Tele::TrayIconValue() | rpl::map([=](const QString &value) {
+			return ::Tele::Lower((value == custom)
+				? u"Custom"_q
+				: (value == u"default"_q)
+				? u"Default"_q
+				: u"Same as app"_q);
+		}),
+		[=](not_null<Ui::PopupMenu*> menu) {
+			const auto tray = ::Tele::TrayIcon();
+			menu->addAction(::Tele::Lower(u"Choose an image..."_q), [=] {
+				ChooseIconFile(controller, Slot::Tray);
+			}, &st::menuIconPhoto);
+			if (!tray.isEmpty()) {
+				menu->addAction(
+					::Tele::Lower(u"Same as the app icon"_q),
+					[] { ::Tele::SetTraySameAsApp(); },
+					&st::menuIconPhotoSet);
+			}
+			if (tray != u"default"_q && ::Tele::AppIcon() == custom) {
+				menu->addAction(::Tele::Lower(u"Reset to default"_q), [] {
+					::Tele::ResetIcon(Slot::Tray);
+				}, &st::menuIconRestore);
+			}
+		});
+}
+
 void FillInterface(SectionBuilder &builder) {
 	builder.addSkip();
 	AddGroupTitle(builder, u"Title bar"_q);
 	AddTitle(builder);
 	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"App icon"_q);
+	AddAppIcons(builder);
+	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Chat list"_q);
 	AddOptionToggle(builder, ::Tele::kOptionHideAllChats);
 	AddOptionToggle(builder, ::Tele::kOptionStaticUserpicsList);
diff --git a/Telegram/SourceFiles/tele/tele_app_icons.cpp b/Telegram/SourceFiles/tele/tele_app_icons.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..41dc1871539a668d592bffdba4a8b7968a4c454e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_app_icons.cpp
@@ -0,0 +1,205 @@
+#include "tele/tele_app_icons.h"
+
+#include "core/application.h"
+#include "mainwindow.h"
+#include "tele/tele_options.h"
+#include "tray.h"
+#include "ui/image/image_prepare.h"
+#include "ui/ui_utility.h"
+#include "window/main_window.h"
+#include "window/window_controller.h"
+
+#ifdef Q_OS_WIN
+#include "platform/win/tray_win.h"
+#endif // Q_OS_WIN
+
+namespace Tele {
+namespace {
+
+constexpr auto kIconSide = 256;
+
+struct LoadedIcon {
+	QImage image;
+	bool ready = false;
+};
+
+int Generation = 0;
+
+[[nodiscard]] QString IconPath(IconSlot slot) {
+	return cWorkingDir() + ((slot == IconSlot::App)
+		? u"tdata/tele_app_icon.png"_q
+		: u"tdata/tele_tray_icon.png"_q);
+}
+
+[[nodiscard]] LoadedIcon &Loaded(IconSlot slot) {
+	static auto app = LoadedIcon();
+	static auto tray = LoadedIcon();
+	return (slot == IconSlot::App) ? app : tray;
+}
+
+[[nodiscard]] const QImage *Load(IconSlot slot) {
+	auto &loaded = Loaded(slot);
+	if (!loaded.ready) {
+		loaded.ready = true;
+		auto image = QImage(IconPath(slot));
+		loaded.image = image.isNull()
+			? QImage()
+			: std::move(image).convertToFormat(
+				QImage::Format_ARGB32_Premultiplied);
+	}
+	return loaded.image.isNull() ? nullptr : &loaded.image;
+}
+
+[[nodiscard]] const QImage &DefaultLogoNoMargin() {
+	static const auto result = QImage(
+		u":/gui/art/logo_256_no_margin.png"_q);
+	return result;
+}
+
+void Forget(IconSlot slot) {
+	QFile::remove(IconPath(slot));
+	Loaded(slot) = LoadedIcon();
+}
+
+void Apply() {
+	++Generation;
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	Core::App().refreshApplicationIcon();
+	Core::App().enumerateWindows([](not_null<Window::Controller*> window) {
+		window->widget()->updateWindowIcon();
+	});
+	Core::App().tray().updateIconCounters();
+}
+
+} // namespace
+
+const QImage *CustomAppLogo() {
+	return (AppIcon() == u"custom"_q) ? Load(IconSlot::App) : nullptr;
+}
+
+const QImage *CustomTrayLogo() {
+	const auto tray = TrayIcon();
+	if (tray == u"custom"_q) {
+		return Load(IconSlot::Tray);
+	} else if (tray == u"default"_q && CustomAppLogo()) {
+		return &DefaultLogoNoMargin();
+	}
+	return nullptr;
+}
+
+bool HasCustomTrayIcon() {
+	return CustomTrayLogo() || CustomAppLogo();
+}
+
+const QImage &TrayLogo(const QImage &fallback) {
+	const auto custom = CustomTrayLogo();
+	return custom ? *custom : fallback;
+}
+
+void ValidateLogoCaches(
+		base::flat_map<int, QImage> &logo,
+		base::flat_map<int, QImage> &noMargin) {
+	static auto seen = 0;
+	if (seen != Generation) {
+		seen = Generation;
+		logo.clear();
+		noMargin.clear();
+	}
+}
+
+#ifdef Q_OS_WIN
+QPixmap TrayIconWithCounter(
+		Window::CounterLayerArgs &&args,
+		bool smallIcon,
+		bool monochrome,
+		bool supportMode) {
+	const auto custom = CustomTrayLogo();
+	if (!custom || (monochrome && Platform::IsDarkTaskbar().has_value())) {
+		return Platform::Tray::IconWithCounter(
+			std::move(args),
+			smallIcon,
+			monochrome,
+			supportMode);
+	}
+	static auto cache = base::flat_map<int, QImage>();
+	static auto seen = 0;
+	if (seen != Generation) {
+		seen = Generation;
+		cache.clear();
+	}
+	const auto size = int(args.size);
+	auto i = cache.find(size);
+	if (i == cache.end()) {
+		i = cache.emplace(
+			size,
+			custom->scaledToWidth(size, Qt::SmoothTransformation)).first;
+	}
+	auto result = i->second;
+	if (supportMode) {
+		Window::ConvertIconToBlack(result);
+	}
+	if (args.count) {
+		result = Window::WithSmallCounter(std::move(result), std::move(args));
+	}
+	return Ui::PixmapFromImage(std::move(result));
+}
+#endif // Q_OS_WIN
+
+bool SetCustomIcon(
+		IconSlot slot,
+		const QString &path,
+		const QByteArray &content) {
+	auto image = Images::Read({
+		.path = path,
+		.content = content,
+	}).image;
+	if (image.isNull() || image.width() <= 0 || image.height() <= 0) {
+		return false;
+	}
+	const auto side = std::min(image.width(), image.height());
+	image = image.copy(
+		(image.width() - side) / 2,
+		(image.height() - side) / 2,
+		side,
+		side
+	).scaled(
+		kIconSide,
+		kIconSide,
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation
+	).convertToFormat(QImage::Format_ARGB32);
+	image.setDevicePixelRatio(1.);
+	const auto target = IconPath(slot);
+	QDir().mkpath(QFileInfo(target).absolutePath());
+	if (!image.save(target, "PNG")) {
+		return false;
+	}
+	Loaded(slot) = LoadedIcon();
+	if (slot == IconSlot::App) {
+		SetAppIcon(u"custom"_q);
+	} else {
+		SetTrayIcon(u"custom"_q);
+	}
+	Apply();
+	return true;
+}
+
+void SetTraySameAsApp() {
+	Forget(IconSlot::Tray);
+	SetTrayIcon(QString());
+	Apply();
+}
+
+void ResetIcon(IconSlot slot) {
+	Forget(slot);
+	if (slot == IconSlot::App) {
+		SetAppIcon(QString());
+	} else {
+		SetTrayIcon(u"default"_q);
+	}
+	Apply();
+}
+
+} // namespace Tele
