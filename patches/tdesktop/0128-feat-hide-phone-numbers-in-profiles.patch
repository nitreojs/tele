From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: inteko <223821898+inteko@users.noreply.github.com>
Date: Wed, 30 Sep 2026 03:50:56 +0400
Subject: [PATCH] feat: hide phone numbers in profiles

---
 .../info/profile/info_profile_actions.cpp        |  4 +++-
 Telegram/SourceFiles/settings/settings_tele.cpp  |  4 ++++
 Telegram/SourceFiles/tele/tele_options.cpp       | 16 ++++++++++++++++
 Telegram/SourceFiles/tele/tele_options.h         |  2 ++
 Telegram/SourceFiles/tele/tele_phones.cpp        | 10 ++++++++++
 Telegram/SourceFiles/tele/tele_phones.h          |  2 ++
 Telegram/SourceFiles/tele/tele_settings_io.cpp   |  1 +
 7 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/info/profile/info_profile_actions.cpp b/Telegram/SourceFiles/info/profile/info_profile_actions.cpp
index 919c5ca2761a74324eae44104192e493205b65bc..7f91a50892bd01d6154b6d517479786c2eb4bec8 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_actions.cpp
+++ b/Telegram/SourceFiles/info/profile/info_profile_actions.cpp
@@ -82,6 +82,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "tele/tele_name_badges.h"
 #include "tele/tele_options.h"
 #include "tele/tele_peer_id.h"
+#include "tele/tele_phones.h"
 #include "tele/tele_username_aliases.h"
 #include "tele/tele_verify_details.h"
 #include "ui/boxes/peer_qr_box.h"
@@ -1641,7 +1642,8 @@ Section DetailsFiller::makeInfo() {
 		{
 			const auto phoneLabel = addInfoOneLine(
 				tr::lng_info_mobile_label(),
-				PhoneWithSpoilerValue(user, PhoneOrHiddenValue(user)),
+				Tele::ProfilePhoneValue(
+					PhoneWithSpoilerValue(user, PhoneOrHiddenValue(user))),
 				tr::lng_profile_copy_phone(tr::now),
 				st::infoProfileLabeledPadding,
 				st::popupMenuWithIcons).text;
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 29ea26a63e6f3b4f5d3f1781ea2e739b55d1e93d..cf0c78c2306d909340e2fad9f8aa0bace37be384 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -2097,6 +2097,10 @@ void FillProfiles(SectionBuilder &builder) {
 		::Info::Profile::kOptionShowPeerIdBelowAbout,
 	});
 	AddOptionToggle(builder, ::Tele::kOptionNoPhoneInHeader);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionHidePhoneInProfile,
+		{ u"mobile"_q });
 	AddOptionToggle(builder, ::Tele::kOptionNftPurchasePrice);
 	AddLocalNames(builder);
 	AddGroupDivider(builder);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index cbd7db96b3954896328bf9c0488d813da02031f4..2b09fb3d482960ceaa19b21ec0bae63fccaace2d 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -98,6 +98,7 @@ const char kOptionLocalPins[] = "tele-local-pins";
 const char kOptionDockedAttachments[] = "tele-docked-attachments";
 const char kOptionDockedGrid[] = "tele-docked-grid";
 const char kOptionLocalFolders[] = "tele-local-folders";
+const char kOptionHidePhoneInProfile[] = "tele-hide-phone-in-profile";
 
 namespace {
 
@@ -682,6 +683,11 @@ base::options::toggle LocalFoldersOption({
 		"device.",
 });
 
+base::options::toggle HidePhoneInProfileOption({
+	.id = kOptionHidePhoneInProfile,
+	.name = "Hide phone numbers in profiles",
+});
+
 void MigrateHideCalls() {
 	if (!HideCallsOption.value()) {
 		return;
@@ -1495,4 +1501,14 @@ rpl::producer<bool> LocalFoldersValue() {
 	});
 }
 
+rpl::producer<bool> HidePhoneInProfileValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		HidePhoneInProfileOption.changes()
+	) | rpl::map([] {
+		return HidePhoneInProfileOption.value();
+	});
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 88d868851d17127e3ee5329d921933695b068eb6..bd91fe1e0e3fcd33b70bcf44c1d2b4c729441f7e 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -94,6 +94,7 @@ extern const char kOptionLocalPins[];
 extern const char kOptionDockedAttachments[];
 extern const char kOptionDockedGrid[];
 extern const char kOptionLocalFolders[];
+extern const char kOptionHidePhoneInProfile[];
 
 [[nodiscard]] bool HideStories();
 [[nodiscard]] bool InvisibleStories();
@@ -249,5 +250,6 @@ void SetDockedGrid(bool enabled);
 [[nodiscard]] rpl::producer<> DockedGridChanges();
 [[nodiscard]] bool LocalFolders();
 [[nodiscard]] rpl::producer<bool> LocalFoldersValue();
+[[nodiscard]] rpl::producer<bool> HidePhoneInProfileValue();
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_phones.cpp b/Telegram/SourceFiles/tele/tele_phones.cpp
index 706ace65492bf8d9cad4274c4418994c0ce2eebd..1b32967008a952dc58c83c8e5078b338af261782 100644
--- a/Telegram/SourceFiles/tele/tele_phones.cpp
+++ b/Telegram/SourceFiles/tele/tele_phones.cpp
@@ -52,4 +52,14 @@ QString TopBarNameText(not_null<PeerData*> peer) {
 		: peer->topBarNameText();
 }
 
+rpl::producer<TextWithEntities> ProfilePhoneValue(
+		rpl::producer<TextWithEntities> phone) {
+	return rpl::combine(
+		std::move(phone),
+		HidePhoneInProfileValue()
+	) | rpl::map([](TextWithEntities phone, bool hidden) {
+		return hidden ? TextWithEntities() : phone;
+	});
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_phones.h b/Telegram/SourceFiles/tele/tele_phones.h
index 42971452c3e0bc01859a16907f799eb3906baa89..959532111bb2bb80dcffb7e067c0737cd85083aa 100644
--- a/Telegram/SourceFiles/tele/tele_phones.h
+++ b/Telegram/SourceFiles/tele/tele_phones.h
@@ -5,5 +5,7 @@ class PeerData;
 namespace Tele {
 
 [[nodiscard]] QString TopBarNameText(not_null<PeerData*> peer);
+[[nodiscard]] rpl::producer<TextWithEntities> ProfilePhoneValue(
+	rpl::producer<TextWithEntities> phone);
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index 691eec09becb7e4a77a578fdf78b7b821fd0b46b..911a3cdbaab2d3ac60e60fa658b9f315ed4c5da9 100644
--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
+++ b/Telegram/SourceFiles/tele/tele_settings_io.cpp
@@ -159,6 +159,7 @@ struct Spec {
 		Toggle(kOptionDockedAttachments),
 		Toggle(kOptionDockedGrid),
 		Toggle(kOptionNoPhoneInHeader),
+		Toggle(kOptionHidePhoneInProfile),
 		Toggle(kOptionNftPurchasePrice),
 		Toggle(kOptionLocalDrafts),
 		Toggle(kOptionLocalPins),
