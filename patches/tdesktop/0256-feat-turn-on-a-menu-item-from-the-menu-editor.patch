From: nitreojs <hello@starkow.dev>
Date: Wed, 7 Oct 2026 17:06:28 +0300
Subject: [PATCH] feat: turn on a menu item from the menu editor

---
 .../SourceFiles/tele/tele_menu_editor.cpp     | 32 +++++++++++++++++--
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_menu_editor.cpp b/Telegram/SourceFiles/tele/tele_menu_editor.cpp
index e5589bfbec9ffbcbeeed96c6cb006c56c1c6a860..a396f70cafa8f7131b2de878d98f0edf38acb97d 100644
--- a/Telegram/SourceFiles/tele/tele_menu_editor.cpp
+++ b/Telegram/SourceFiles/tele/tele_menu_editor.cpp
@@ -236,6 +236,15 @@ void CollectSubmenus(
 	return Lower(u"Turn on "_q) + Lower(option.name());
 }
 
+[[nodiscard]] const MenuItemInfo *OffItem(
+		MenuKind kind,
+		const MenuEntry &data) {
+	const auto item = (data.type == MenuEntry::Type::Item)
+		? LookupMenuItem(kind, data.key)
+		: nullptr;
+	return (item && !FeatureOn(*item)) ? item : nullptr;
+}
+
 [[nodiscard]] bool TopLevelOnly(const MenuItemInfo &item) {
 	return (item.flags & MenuItemFlag::Fixed)
 		|| (item.flags & MenuItemFlag::TopLevel)
@@ -543,7 +552,11 @@ void LayoutList::paintRow(
 	p.setFont(font);
 	if (!hint.isEmpty()) {
 		const auto &small = st::defaultTextStyle.font;
-		const auto available = (textRight - textLeft) / 2;
+		const auto title = EntryTitle(_state->kind, data);
+		const auto dots = data.fresh ? st::boxRowPadding.left() : 0;
+		const auto available = std::max(
+			(textRight - textLeft) / 2,
+			textRight - textLeft - font->width(title) - dots - skip);
 		const auto shown = small->elided(hint, available);
 		const auto hintWidth = small->width(shown);
 		p.setFont(small);
@@ -927,6 +940,12 @@ void LayoutList::toggleHidden(const Path &path) {
 		return;
 	}
 	auto &data = At(_state->layout, path);
+	if (const auto item = OffItem(_state->kind, data)) {
+		base::options::lookup<bool>(item->gate).set(true);
+		data.hidden = false;
+		changed();
+		return;
+	}
 	data.hidden = !data.hidden;
 	changed();
 }
@@ -1047,10 +1066,17 @@ void LayoutList::showRowMenu(int index, QPoint global) {
 		st::popupMenuWithIcons);
 	const auto path = row.path;
 	if (row.type != Type::Separator) {
+		const auto off = OffItem(_state->kind, data);
 		_menu->addAction(
-			data.hidden ? Lower(u"Show"_q) : Lower(u"Hide"_q),
+			(off
+				? FeatureHint(*off)
+				: data.hidden
+				? Lower(u"Show"_q)
+				: Lower(u"Hide"_q)),
 			[=] { toggleHidden(path); },
-			data.hidden ? &st::menuIconShowInChat : &st::menuIconStealth);
+			((off || data.hidden)
+				? &st::menuIconShowInChat
+				: &st::menuIconStealth));
 	} else {
 		const auto thick = SeparatorThick(
 			_state->kind,
