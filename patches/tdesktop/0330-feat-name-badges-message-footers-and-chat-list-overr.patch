@@ -84,6 +84,9 @@ struct Decorated {
 		if (value.text) {
 			result.text = value.text;
 		}
+		if (value.footer) {
+			result.footer = value.footer;
+		}
 		if (value.opacity) {
 			result.opacity = value.opacity;
 		}
@@ -349,9 +352,24 @@ TextWithEntities DecoratedText(
 		not_null<const HistoryItem*> item,
 		TextWithEntities text) {
 	const auto decoration = Find(item);
-	return (decoration && decoration->text)
-		? *decoration->text
-		: std::move(text);
+	if (!decoration) {
+		return text;
+	}
+	auto result = decoration->text ? *decoration->text : std::move(text);
+	const auto &footer = decoration->footer;
+	if (footer && !footer->text.isEmpty()) {
+		if (!result.text.isEmpty()) {
+			result.append(QChar('\n'));
+		}
+		auto piece = TextWithEntities{ footer->text };
+		piece.entities.push_back(EntityInText(
+			EntityType::Blockquote,
+			0,
+			int(footer->text.size())));
+		piece.entities.append(footer->entities);
+		result.append(std::move(piece));
+	}
+	return result;
 }
 
