 	const auto &value = merged.value;
 	for (const auto flag : kFlags) {
@@ -221,10 +239,20 @@ void Apply(not_null<PeerData*> peer) {
 		merged.color = std::nullopt;
 		peer->changeColorIndex(real);
 	}
-	if (value.name || hadName) {
+	if (value.name || value.badge || hadName) {
 		const auto real = std::exchange(merged.name, std::nullopt);
 		RefreshName(peer, real);
 	}
+	const auto hidden = value.hidden.value_or(false);
+	const auto list = value.label.has_value() || value.preview.has_value();
+	if (hidden != wasHidden || list || hadList) {
+		if (const auto history = peer->owner().historyLoaded(peer)) {
+			if (hidden != wasHidden) {
+				history->updateChatListExistence();
+			}
+			history->updateChatListEntry();
+		}
+	}
 	if (!active) {
 		state.merged.remove(peer);
 		if (layers != end(state.layers)) {
@@ -276,12 +304,39 @@ void RemovePeerOverrides(const void *owner) {
 
 QString OverrideName(not_null<PeerData*> peer, const QString &name) {
 	const auto merged = Find(peer);
-	if (!merged || !merged->value.name) {
+	if (!merged || (!merged->value.name && !merged->value.badge)) {
 		return name;
-	} else if (name != *merged->value.name) {
+	}
+	const auto &badge = merged->value.badge;
+	const auto shown = merged->value.name.value_or(name)
+		+ ((badge && !badge->isEmpty()) ? (u" "_q + *badge) : QString());
+	if (name != shown) {
 		merged->name = name;
 	}
-	return *merged->value.name;
+	return shown;
+}
+
+bool HiddenInList(not_null<const PeerData*> peer) {
+	const auto merged = Find(const_cast<PeerData*>(peer.get()));
+	return merged && merged->value.hidden.value_or(false);
+}
+
+QString ListLabel(const PeerData *peer) {
+	const auto merged = peer
+		? Find(const_cast<PeerData*>(peer))
+		: nullptr;
+	return (merged && merged->value.label)
+		? *merged->value.label
+		: QString();
+}
+
+QString ListPreview(const PeerData *peer) {
+	const auto merged = peer
+		? Find(const_cast<PeerData*>(peer))
+		: nullptr;
+	return (merged && merged->value.preview)
+		? *merged->value.preview
+		: QString();
 }
 
 bool OverrideFlag(not_null<PeerData*> peer, PeerFlag flag, bool real) {
