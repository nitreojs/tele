+[[nodiscard]] QString WriteStaged(
+		const QString &path,
+		const QByteArray &data,
+		QFileDevice::Permissions permissions) {
+	const auto newPath = path + u".new"_q;
 	QFile::remove(newPath);
+	QDir().mkpath(QFileInfo(path).absolutePath());
 	auto file = QFile(newPath);
 	if (!file.open(QIODevice::WriteOnly)
-		|| file.write(exe) != exe.size()
+		|| file.write(data) != data.size()
 		|| !file.flush()) {
 		file.close();
 		QFile::remove(newPath);
 		return u"can't write %1"_q.arg(newPath);
 	}
 #ifndef Q_OS_WIN
-	file.setPermissions(QFile::permissions(InstallPath())
-		| QFileDevice::ReadOwner
-		| QFileDevice::WriteOwner
-		| QFileDevice::ExeOwner);
+	file.setPermissions(permissions);
 	base::Platform::FlushFileData(file);
 #endif
 	return QString();
 }
+
+[[nodiscard]] QString Unpack(const Release &release, const QByteArray &zip) {
+	auto archive = zlib::FileToRead(zip);
+	if (!release.helperSha256.isEmpty()) {
+		const auto helper = archive.readFileContent(
+			kHelperInZip,
+			0,
+			kMaxExeSize);
+		if (helper.isEmpty() || archive.error() != UNZ_OK) {
+			return u"can't unpack %1 from the archive"_q.arg(kHelperInZip);
+		} else if (Sha256Hex(helper) != release.helperSha256) {
+			return u"unpacked widget helper doesn't match the feed"_q;
+		}
+		const auto error = WriteStaged(
+			HelperPath(),
+			helper,
+			QFileDevice::ReadOwner
+				| QFileDevice::WriteOwner
+				| QFileDevice::ExeOwner
+				| QFileDevice::ReadGroup
+				| QFileDevice::ExeGroup
+				| QFileDevice::ReadOther
+				| QFileDevice::ExeOther);
+		if (!error.isEmpty() || release.helperOnly) {
+			return error;
+		}
+	}
+	const auto exe = archive.readFileContent(kExeInZip, 0, kMaxExeSize);
+	if (exe.isEmpty() || archive.error() != UNZ_OK) {
+		return u"can't unpack %1 from the archive"_q.arg(kExeInZip);
+	} else if (Sha256Hex(exe) != release.exeSha256) {
+		return u"unpacked exe doesn't match the feed"_q;
+	}
+	return WriteStaged(
+		InstallPath(),
+		exe,
+		QFile::permissions(InstallPath())
+			| QFileDevice::ReadOwner
+			| QFileDevice::WriteOwner
+			| QFileDevice::ExeOwner);
+}
+
+// Puts a staged <path>.new in place, keeping the replaced file as <path>.old.
+[[nodiscard]] bool SwapStaged(const QString &path) {
+	const auto newPath = path + u".new"_q;
+	const auto oldPath = path + u".old"_q;
+	QFile::remove(oldPath);
+#ifdef Q_OS_WIN
+	const auto rename = RenameWithRetries;
+#else
+	const auto rename = [](const QString &from, const QString &to) {
+		return QFile::rename(from, to);
+	};
+#endif
+	const auto existed = QFile::exists(path);
+	if (existed && !rename(path, oldPath)) {
+		QFile::remove(newPath);
+		return false;
+	} else if (!rename(newPath, path)) {
+		if (existed) {
+			rename(oldPath, path);
+		}
+		QFile::remove(newPath);
+		return false;
+	}
+	return true;
+}
+
+void RestoreSwapped(const QString &path) {
+	const auto oldPath = path + u".old"_q;
+	if (QFile::exists(oldPath)) {
+		QFile::remove(path);
+		QFile::rename(oldPath, path);
+	}
+}
 #endif
 
