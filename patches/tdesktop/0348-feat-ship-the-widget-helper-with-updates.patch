+// Updaters older than tele 29 install only the exe, so a release build can
+// run without the widget helper its exe was built with: fetch it once.
+void Updater::checkHelper(Release release) {
+	release.helperOnly = true;
+	crl::async([=, weak = base::make_weak(this), path = HelperPath()] {
+		const auto matches = (FileSha256Hex(path) == release.helperSha256);
+		crl::on_main(weak, [=] {
+			if (matches) {
+				RemoveParts(QString());
+				finish({ .state = UpdateState::Latest });
+			} else if (!CanWriteNextToInstall()) {
+				fail(u"can't write the widget helper next to tele"_q);
+			} else {
+				LOG(("Tele Updater: widget helper missing or outdated, "
+					"getting it from %1.").arg(release.tag));
+				_status = UpdateStatus{
+					.state = UpdateState::Downloading,
+					.tag = release.tag,
+				};
+				download(release);
+			}
+		});
+	});
+}
+
 void Updater::download(const Release &release) {
 	const auto name = PartName(release);
 	const auto path = cExeDir() + name;
@@ -747,10 +865,24 @@ void Updater::install(const Release &release) {
 		QFile::encodeName(newPath).constData(),
