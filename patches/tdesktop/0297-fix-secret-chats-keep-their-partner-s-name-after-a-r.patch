+void Manager::rememberPeer(Chat &chat) {
+	const auto real = chat.binding.real;
+	if (!real) {
+		return;
+	}
+	auto dirty = false;
+	if (const auto hash = real->accessHash()
+		; hash && hash != chat.peerAccessHash) {
+		chat.peerAccessHash = hash;
+		dirty = true;
+	}
+	if (const auto name = real->name()
+		; !name.isEmpty() && name != chat.peerName) {
+		chat.peerName = name;
+		dirty = true;
+	}
+	if (dirty) {
+		save();
+	}
+}
+
+void Manager::bindReal(Chat &chat) {
+	if (chat.binding.real || !chat.binding.user) {
+		return;
+	}
+	ensureBinding(chat);
+	if (!chat.binding.real) {
+		return;
+	}
+	_session->changes().peerUpdated(
+		chat.binding.user,
+		(Data::PeerUpdate::Flag::Photo
+			| Data::PeerUpdate::Flag::OnlineStatus));
+	_chatChanges.fire_copy(chat.id);
+}
+
+void Manager::refreshUsers() {
+	for (auto &[id, chat] : _chats) {
+		bindReal(chat);
+	}
+	requestUsers();
+}
+
+void Manager::requestUsers() {
+	if (_usersRequested) {
+		return;
+	}
+	auto users = QVector<MTPInputUser>();
+	for (const auto &[id, chat] : _chats) {
+		if (!chat.binding.real && chat.peerUserId && chat.peerAccessHash) {
+			users.push_back(MTP_inputUser(
+				MTP_long(chat.peerUserId),
+				MTP_long(chat.peerAccessHash)));
+		}
+	}
+	if (users.isEmpty()) {
+		return;
+	}
+	_usersRequested = true;
+	_session->api().request(MTPusers_GetUsers(
+		MTP_vector<MTPInputUser>(std::move(users))
+	)).done(crl::guard(this, [=](const MTPVector<MTPUser> &result) {
+		_session->data().processUsers(result);
+		for (auto &[id, chat] : _chats) {
+			bindReal(chat);
+		}
+	})).fail(crl::guard(this, [=](const MTP::Error &) {
+		_usersRequested = false;
+	})).send();
+}
