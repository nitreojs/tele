+	case kUiNotice: {
+		const auto options = (argc > 0) ? argv[0] : JS_UNDEFINED;
+		auto title = QString();
+		auto tone = NoticeTone::None;
+		auto buttons = std::vector<NoticeButton>();
+		auto source = JS_DupValue(ctx, options);
+		if (JS_IsObject(options) && !JS_IsArray(options)) {
+			JS_FreeValue(ctx, source);
+			source = JS_GetPropertyStr(ctx, options, "text");
+			title = StringProperty(ctx, options, "title");
+			const auto name = StringProperty(ctx, options, "tone");
+			static const auto tones = std::array{
+				std::pair{ u""_q, NoticeTone::None },
+				std::pair{ u"info"_q, NoticeTone::Info },
+				std::pair{ u"success"_q, NoticeTone::Success },
+				std::pair{ u"warning"_q, NoticeTone::Warning },
+				std::pair{ u"critical"_q, NoticeTone::Critical },
+			};
+			const auto i = ranges::find(tones, name, [](const auto &pair) {
+				return pair.first;
+			});
+			if (i == end(tones)) {
+				JS_FreeValue(ctx, source);
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.ui.notice: tone is info, success, warning or critical");
+			}
+			tone = i->second;
+			auto list = JS_GetPropertyStr(ctx, options, "buttons");
+			auto length = std::int64_t();
+			if (JS_IsArray(list) && JS_GetLength(ctx, list, &length) >= 0) {
+				for (auto j = std::int64_t(); j != length && j < 2; ++j) {
