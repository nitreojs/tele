 #include "data/data_user.h"
 #include "history/history_item.h"
@@ -873,6 +875,13 @@ void Host::notify(const QString &id, const QString &text) {
 	const auto i = ranges::find(_entries, id, [](const Entry &e) {
 		return e.file.id;
 	});
+	ScriptNotice(
+		_session,
+		(i != end(_entries) && i->instance)
+			? i->instance->name()
+			: QFileInfo(id).completeBaseName(),
+		NoticeTone::Warning,
+		TextWithEntities{ text });
 	const auto now = crl::now();
 	if (i != end(_entries)) {
 		if (i->toasted && now - i->toasted < kToastMerge) {
@@ -1789,6 +1798,25 @@ void AddProfileRows(
 	}
 }
 
+void ScriptNotice(
+		not_null<Main::Session*> session,
+		const QString &script,
+		NoticeTone tone,
+		TextWithEntities text,
+		std::vector<NoticeButton> buttons) {
+	if (!::Tele::NoticesScripts()
+		|| (script.isEmpty() && text.text.trimmed().isEmpty())) {
+		return;
+	}
+	::Tele::Notify(session, ::Tele::Notice{
+		.kind = ::Tele::NoticeKind::Script,
+		.tone = tone,
+		.title = script,
+		.text = std::move(text),
+		.buttons = std::move(buttons),
+	});
+}
+
 void SetupScripts(not_null<Main::Session*> session) {
 	session->lifetime().make_state<Host>(session);
 }
