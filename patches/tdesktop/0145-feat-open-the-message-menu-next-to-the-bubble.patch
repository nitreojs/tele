+namespace HistoryView {
+class Element;
+enum class PointState : char;
+} // namespace HistoryView
+
+namespace Tele {
+
+[[nodiscard]] HistoryView::Element *MenuHoveredView(
+	HistoryView::Element *hovered,
+	HistoryView::Element *moused,
+	QPoint point,
+	bool overLink);
+[[nodiscard]] HistoryView::PointState MenuPointState(
+	const HistoryView::Element *view,
+	QPoint point,
+	HistoryView::PointState state,
+	bool overLink);
+
+} // namespace Tele
