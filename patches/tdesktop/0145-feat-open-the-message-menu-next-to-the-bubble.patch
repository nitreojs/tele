diff --git a/Telegram/SourceFiles/tele/tele_rmb_beside_bubble.cpp b/Telegram/SourceFiles/tele/tele_rmb_beside_bubble.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5cf562aecabbb5df8c0fce2e4430a40343fa28d1
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_rmb_beside_bubble.cpp
@@ -0,0 +1,49 @@
+#include "tele/tele_rmb_beside_bubble.h"
+
+#include "history/history_item.h"
+#include "history/view/history_view_cursor_state.h"
+#include "history/view/history_view_element.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+using HistoryView::PointState;
+
+[[nodiscard]] bool BesideBubble(
+		not_null<const HistoryView::Element*> view,
+		QPoint point,
+		bool overLink) {
+	return RmbBesideBubble()
+		&& !overLink
+		&& !view->data()->isService()
+		&& point.y() >= view->marginTop()
+		&& point.y() < view->height() - view->marginBottom()
+		&& view->pointState(point) == PointState::Outside;
+}
+
+} // namespace
+
+HistoryView::Element *MenuHoveredView(
+		HistoryView::Element *hovered,
+		HistoryView::Element *moused,
+		QPoint point,
+		bool overLink) {
+	return (!hovered && moused && BesideBubble(moused, point, overLink))
+		? moused
+		: hovered;
+}
+
+PointState MenuPointState(
+		const HistoryView::Element *view,
+		QPoint point,
+		PointState state,
+		bool overLink) {
+	return (state == PointState::Outside
+		&& view
+		&& BesideBubble(view, point, overLink))
+		? PointState::Inside
+		: state;
+}
+
+} // namespace Tele
