 #include "data/data_msg_id.h"
 
 class HistoryItem;
+class QWidget;
+
+namespace Api {
+struct WhoReadPeer;
+} // namespace Api
 
 namespace Data {
 class Session;
@@ -37,4 +42,44 @@ template <typename Value>
 	}) | rpl::flatten_latest();
 }
 
+[[nodiscard]] bool RestartWhoReadRequest(
+	not_null<QWidget*> context,
+	not_null<HistoryItem*> item,
+	mtpRequestId &requestId);
+
+template <typename Entry>
+void RestartWhoRead(
+		not_null<QWidget*> context,
+		not_null<HistoryItem*> item,
+		Entry &entry) {
+	using Value = std::decay_t<decltype(entry.data.current())>;
+	using State = decltype(Value::state);
+	const auto stale = RestartWhoReadRequest(context, item, entry.requestId);
+	const auto &current = entry.data.current();
+	if (stale && current.state == State::Empty && current.list.empty()) {
+		entry.data = Value{ .state = State::Unknown };
+	}
+}
+
+[[nodiscard]] rpl::producer<> WhoReadRefreshes(not_null<HistoryItem*> item);
+
+void LoadWhoReadPeers(
+	not_null<HistoryItem*> item,
+	const std::vector<Api::WhoReadPeer> &list);
+
+template <typename Value>
+[[nodiscard]] rpl::producer<Value> RefreshedWhoRead(
+		not_null<HistoryItem*> item,
+		rpl::producer<Value> ids) {
+	return WhoReadRefreshes(
+		item
+	) | rpl::map([=]() -> rpl::producer<Value> {
+		return rpl::duplicate(
+			ids
+		) | rpl::before_next([=](const Value &value) {
+			LoadWhoReadPeers(item, value.list);
+		});
+	}) | rpl::flatten_latest();
+}
+
 } // namespace Tele
