-		session->api().request(id).cancel();
+template <typename Key>
+void Prune(
+		base::flat_map<Key, crl::time> &map,
+		crl::time now,
+		crl::time delay) {
+	for (auto i = begin(map); i != end(map);) {
+		if (now - i->second >= delay) {
+			i = map.erase(i);
+		} else {
+			++i;
+		}
 	}
 }
 
-rpl::producer<> WhoReactedRefreshes(not_null<HistoryItem*> item) {
+[[nodiscard]] rpl::producer<> ReactionsChanges(not_null<HistoryItem*> item) {
 	return [=](auto consumer) {
-		struct State {
-			std::vector<Counted> snapshot;
-			crl::time fired = 0;
-			base::Timer timer;
-			bool removed = false;
-		};
 		auto lifetime = rpl::lifetime();
-		const auto state = lifetime.make_state<State>();
-		const auto fire = [=] {
-			state->fired = crl::now();
-			consumer.put_next({});
-		};
-		state->snapshot = Snapshot(item);
-		state->timer.setCallback(fire);
-
-		const auto owner = &item->history()->owner();
+		const auto snapshot = lifetime.make_state<std::vector<Counted>>(
+			Snapshot(item));
 		rpl::merge(
-			owner->itemDataChanges(
+			item->history()->owner().itemDataChanges(
 			) | rpl::filter([=](not_null<HistoryItem*> changed) {
-				if (changed != item || state->removed) {
+				if (changed != item) {
 					return false;
 				}
 				auto now = Snapshot(item);
-				if (now == state->snapshot) {
+				if (now == *snapshot) {
 					return false;
 				}
-				state->snapshot = std::move(now);
+				*snapshot = std::move(now);
 				return true;
 			}) | rpl::to_empty,
 			SendsFinished().events(
 			) | rpl::filter([=](not_null<HistoryItem*> finished) {
-				return (finished == item) && !state->removed;
+				return (finished == item);
 			}) | rpl::to_empty
 		) | rpl::on_next([=] {
+			consumer.put_next({});
+		}, lifetime);
+		return lifetime;
+	};
+}
+
+[[nodiscard]] rpl::producer<> Refreshes(
+		not_null<HistoryItem*> item,
+		rpl::producer<> changes) {
+	return [=](auto consumer) {
+		struct State {
+			crl::time fired = 0;
+			base::Timer timer;
+			rpl::lifetime changes;
+		};
+		auto lifetime = rpl::lifetime();
+		const auto state = lifetime.make_state<State>();
+		const auto fire = [=] {
+			state->fired = crl::now();
+			consumer.put_next({});
+		};
+		state->timer.setCallback(fire);
+
+		rpl::duplicate(changes) | rpl::on_next([=] {
 			if (state->timer.isActive()) {
 				return;
 			}
@@ -121,13 +145,13 @@ rpl::producer<> WhoReactedRefreshes(not_null<HistoryItem*> item) {
 			} else {
 				fire();
 			}
-		}, lifetime);
+		}, state->changes);
 
-		owner->itemRemoved(
+		item->history()->owner().itemRemoved(
 		) | rpl::filter([=](not_null<const HistoryItem*> removed) {
 			return (removed == item);
 		}) | rpl::on_next([=] {
-			state->removed = true;
+			state->changes.destroy();
 			state->timer.cancel();
 		}, lifetime);
 
@@ -136,4 +160,88 @@ rpl::producer<> WhoReactedRefreshes(not_null<HistoryItem*> item) {
 	};
 }
 
+} // namespace
+
+void ReactionSendFinished(
+		not_null<Data::Session*> owner,
+		FullMsgId itemId,
+		bool success) {
+	if (const auto item = owner->message(itemId)) {
+		if (!success) {
+			item->updateReactionsUnknown();
+		}
+		SendsFinished().fire_copy(item);
+	}
+}
+
+void CancelWhoReactedRequest(
+		not_null<Main::Session*> session,
+		mtpRequestId &requestId) {
+	if (const auto id = base::take(requestId)) {
+		session->api().request(id).cancel();
+	}
+}
+
+rpl::producer<> WhoReactedRefreshes(not_null<HistoryItem*> item) {
+	return Refreshes(item, ReactionsChanges(item));
+}
+
+bool RestartWhoReadRequest(
+		not_null<QWidget*> context,
+		not_null<HistoryItem*> item,
+		mtpRequestId &requestId) {
+	CancelWhoReactedRequest(&item->history()->session(), requestId);
+	const auto now = crl::now();
+	auto &requested = WhoReadRequested();
+	Prune(requested, now, kEmptyReuse);
+	const auto key = std::make_pair(context.get(), item.get());
+	const auto stale = !requested.contains(key);
+	requested[key] = now;
+	return stale;
+}
+
+rpl::producer<> WhoReadRefreshes(not_null<HistoryItem*> item) {
+	const auto history = item->history();
+	const auto peer = history->peer;
+	if (peer->isUser()) {
+		return Refreshes(item, rpl::never<>());
+	}
+	const auto changes = &history->session().changes();
+	return Refreshes(item, rpl::merge(
+		changes->historyUpdates(
+			history,
+			Data::HistoryUpdate::Flag::OutboxRead
+		) | rpl::to_empty,
+		changes->peerUpdates(
+			peer,
+			Data::PeerUpdate::Flag::Members
+		) | rpl::to_empty));
+}
+
+void LoadWhoReadPeers(
+		not_null<HistoryItem*> item,
+		const std::vector<Api::WhoReadPeer> &list) {
+	const auto peer = item->history()->peer;
+	const auto owner = &peer->owner();
+	const auto unknown = ranges::any_of(list, [&](
+			const Api::WhoReadPeer &entry) {
+		return !owner->peerLoaded(entry.peer);
+	});
+	if (!unknown) {
+		return;
+	}
+	const auto now = crl::now();
+	auto &requested = MembersRequested();
+	Prune(requested, now, kMembersRequestDelay);
+	if (requested.contains(peer)) {
+		return;
+	}
+	requested.emplace(peer, now);
+	if (const auto channel = peer->asMegagroup()) {
+		peer->session().api().chatParticipants().requestLast(channel);
+	} else if (const auto chat = peer->asChat()) {
+		peer->session().api().requestFullPeer(chat);
+	}
+}
+
 } // namespace Tele
