+bool Host::interceptSendInline(
+		not_null<UserData*> bot,
+		const std::shared_ptr<InlineBots::Result> &result,
+		const Api::SendAction &action,
+		std::optional<MsgId> localMessageId,
+		const Fn<void(bool)> &done) {
+	const auto peer = action.history->peer;
+	if (!result || !holds(peer, u"inline"_q)) {
+		return false;
+	}
+	const auto replyTo = ReplyInChat(action, peer->id);
+	const auto session = _session;
+	hold(peer->id, std::make_shared<HeldSend>(HeldSend{
+		.data = SendData{
+			.kind = u"inline"_q,
+			.peer = peer,
+			.replyTo = replyTo,
+			.scheduled = action.options.scheduled,
+			.silent = action.options.silent,
+			.document = result->document(),
+			.inlineResult = InlineSendInfo{
