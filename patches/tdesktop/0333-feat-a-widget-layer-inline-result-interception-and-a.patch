+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kIdProperty = "_teleScriptWidget";
+constexpr auto kSweepEvery = 4096;
+
+struct Registry {
+	base::flat_map<int, QPointer<QWidget>> widgets;
+	int next = 0;
+	int added = 0;
+};
+
+[[nodiscard]] Registry &Widgets() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] int IdOf(not_null<QWidget*> widget) {
+	const auto stored = widget->property(kIdProperty);
+	if (stored.isValid()) {
+		return stored.toInt();
+	}
+	auto &registry = Widgets();
+	if (++registry.added >= kSweepEvery) {
+		registry.added = 0;
+		for (auto i = begin(registry.widgets); i != end(registry.widgets);) {
+			i = i->second ? (i + 1) : registry.widgets.erase(i);
+		}
+	}
+	const auto id = ++registry.next;
+	registry.widgets.emplace(id, widget.get());
+	widget->setProperty(kIdProperty, id);
+	return id;
+}
+
+[[nodiscard]] QWidget *ById(int id) {
+	auto &registry = Widgets();
+	const auto i = registry.widgets.find(id);
+	return (i != end(registry.widgets)) ? i->second.data() : nullptr;
+}
+
+[[nodiscard]] QString TypeName(not_null<QWidget*> widget) {
+	const auto raw = typeid(*widget.get()).name();
+#if defined(__GNUC__)
+	auto status = 0;
+	const auto demangled = abi::__cxa_demangle(raw, nullptr, nullptr, &status);
+	auto result = QString::fromLatin1(
+		(status == 0 && demangled) ? demangled : raw);
+	std::free(demangled);
+#else
+	auto result = QString::fromLatin1(raw);
+#endif
+	static const auto prefix = QRegularExpression(
+		u"\\b(class|struct) "_q);
+	result.remove(prefix);
+	return result;
+}
+
+[[nodiscard]] QString RoleName(QAccessible::Role role) {
+	switch (role) {
+	case QAccessible::Button: return u"button"_q;
+	case QAccessible::CheckBox: return u"checkbox"_q;
+	case QAccessible::RadioButton: return u"radio"_q;
+	case QAccessible::StaticText: return u"text"_q;
+	case QAccessible::Link: return u"link"_q;
+	case QAccessible::EditableText: return u"input"_q;
+	case QAccessible::List: return u"list"_q;
+	case QAccessible::ListItem: return u"listitem"_q;
+	case QAccessible::Dialog: return u"dialog"_q;
+	case QAccessible::Window: return u"window"_q;
+	case QAccessible::Grouping: return u"group"_q;
+	case QAccessible::PageTab: return u"tab"_q;
+	case QAccessible::PageTabList: return u"tabs"_q;
+	case QAccessible::MenuItem: return u"menuitem"_q;
+	case QAccessible::PopupMenu: return u"menu"_q;
+	case QAccessible::Slider: return u"slider"_q;
+	case QAccessible::Separator: return u"separator"_q;
+	case QAccessible::Graphic: return u"image"_q;
+	case QAccessible::ScrollBar: return u"scrollbar"_q;
+	case QAccessible::ToolTip: return u"tooltip"_q;
+	case QAccessible::Table: return u"table"_q;
+	case QAccessible::Cell: return u"cell"_q;
+	default: return u"widget"_q;
+	}
+}
+
+struct Compiled {
+	QRegularExpression type;
+	QRegularExpression name;
+	QString role;
+	bool anyType = true;
+	bool anyName = true;
+	bool includeHidden = false;
+};
+
+[[nodiscard]] Compiled Compile(const WidgetQuery &query) {
+	auto result = Compiled{
+		.role = query.role,
+		.anyType = query.type.isEmpty(),
+		.anyName = query.name.isEmpty(),
+		.includeHidden = query.includeHidden,
+	};
+	if (!result.anyType) {
+		result.type = QRegularExpression(
+			query.type,
+			query.typeCaseInsensitive
+				? QRegularExpression::CaseInsensitiveOption
+				: QRegularExpression::NoPatternOption);
+	}
+	if (!result.anyName) {
+		result.name = QRegularExpression(
+			query.name,
+			query.nameCaseInsensitive
+				? QRegularExpression::CaseInsensitiveOption
+				: QRegularExpression::NoPatternOption);
+	}
+	return result;
+}
+
+[[nodiscard]] bool Matches(not_null<QWidget*> widget, const Compiled &query) {
+	if (!query.includeHidden && !widget->isVisible()) {
+		return false;
+	} else if (!query.anyType
+		&& !query.type.match(TypeName(widget)).hasMatch()) {
+		return false;
+	}
+	const auto rp = dynamic_cast<Ui::RpWidget*>(widget.get());
+	if (!query.role.isEmpty()) {
+		const auto role = rp
+			? RoleName(rp->accessibilityRole())
+			: u"widget"_q;
+		if (role != query.role) {
+			return false;
+		}
+	}
+	if (!query.anyName) {
+		const auto name = rp ? rp->accessibilityName() : QString();
+		if (!query.name.match(name).hasMatch()) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void Collect(
+		not_null<QWidget*> widget,
+		const Compiled &query,
+		int limit,
+		std::vector<int> &result) {
+	if (int(result.size()) >= limit) {
+		return;
+	} else if (!query.includeHidden && !widget->isVisible()) {
+		return;
+	} else if (Matches(widget, query)) {
+		result.push_back(IdOf(widget));
+	}
+	for (const auto child : widget->children()) {
+		if (const auto inner = qobject_cast<QWidget*>(child)) {
+			Collect(inner, query, limit, result);
+		}
+	}
+}
+
+class Observer final : public QObject {
+public:
+	Observer();
+
+	[[nodiscard]] rpl::lifetime add(
+		WidgetQuery query,
+		Fn<void(int)> shown);
+
+protected:
+	bool eventFilter(QObject *object, QEvent *event) override;
+
+private:
+	struct Entry {
+		int key = 0;
+		Compiled query;
+		Fn<void(int)> shown;
+	};
+	std::vector<Entry> _entries;
+	int _next = 0;
+
+};
+
+Observer::Observer() : QObject(QCoreApplication::instance()) {
+	QCoreApplication::instance()->installEventFilter(this);
+}
+
+rpl::lifetime Observer::add(WidgetQuery query, Fn<void(int)> shown) {
+	const auto key = ++_next;
+	_entries.push_back({
+		.key = key,
+		.query = Compile(query),
+		.shown = shown,
+	});
+	auto existing = std::vector<int>();
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		Collect(widget, _entries.back().query, 4096, existing);
+	}
+	if (!existing.empty()) {
+		crl::on_main(this, [=] {
+			if (ranges::contains(_entries, key, &Entry::key)) {
+				for (const auto id : existing) {
+					shown(id);
+				}
+			}
+		});
+	}
+	return rpl::lifetime([=] {
+		_entries.erase(
+			ranges::remove(_entries, key, &Entry::key),
+			end(_entries));
+	});
+}
+
+bool Observer::eventFilter(QObject *object, QEvent *event) {
+	if (event->type() != QEvent::Show || _entries.empty()) {
+		return false;
+	}
+	const auto widget = qobject_cast<QWidget*>(object);
+	if (!widget) {
+		return false;
+	}
+	auto calls = std::vector<std::pair<int, Fn<void(int)>>>();
+	for (const auto &entry : _entries) {
+		auto query = entry.query;
+		query.includeHidden = true;
+		if (Matches(widget, query)) {
+			calls.emplace_back(entry.key, entry.shown);
+		}
+	}
+	if (calls.empty()) {
+		return false;
+	}
+	const auto id = IdOf(widget);
+	crl::on_main(this, [=] {
+		for (const auto &[key, shown] : calls) {
+			if (ranges::contains(_entries, key, &Entry::key)) {
+				shown(id);
+			}
+		}
+	});
+	return false;
+}
+
+[[nodiscard]] Observer &Watcher() {
+	static const auto result = new Observer();
+	return *result;
+}
+
+struct Change {
+	const void *owner = nullptr;
+	int key = 0;
+	QPointer<QWidget> widget;
+	std::optional<bool> wasVisible;
+	std::optional<Ui::Text::String> wasText;
+	std::vector<QPointer<QWidget>> added;
+	QPointer<QAction> action;
+	Fn<void()> gone;
+};
+
+[[nodiscard]] std::vector<Change> &Changes() {
+	static auto result = std::vector<Change>();
+	return result;
+}
+
+void Undo(Change &change) {
+	if (const auto action = change.action.data()) {
+		if (const auto menu = dynamic_cast<Ui::PopupMenu*>(
+				change.widget.data())) {
+			const auto &actions = menu->actions();
+			for (auto i = 0; i != int(actions.size()); ++i) {
+				if (actions[i].get() == action) {
+					menu->removeAction(i);
+					break;
+				}
+			}
+		}
+		return;
+	}
+	for (const auto &added : change.added) {
+		if (const auto widget = added.data()) {
+			widget->hide();
+			widget->deleteLater();
+		}
+	}
+	if (const auto widget = change.widget.data()) {
+		if (change.wasVisible) {
+			widget->setVisible(*change.wasVisible);
+		}
+		if (change.wasText) {
+			if (const auto label = dynamic_cast<Ui::FlatLabel*>(widget)) {
+				label->exchangeText(std::move(*change.wasText));
+			}
+		}
+	}
+}
+
+void Dropped(not_null<QObject*> widget) {
+	auto &changes = Changes();
+	auto gone = std::vector<Fn<void()>>();
+	for (auto i = begin(changes); i != end(changes);) {
+		if (i->widget.isNull() || i->widget.data() == widget.get()) {
+			if (i->gone) {
+				gone.push_back(std::move(i->gone));
+			}
+			i = changes.erase(i);
+		} else {
+			++i;
+		}
+	}
+	if (!gone.empty()) {
+		crl::on_main([gone = std::move(gone)] {
+			for (const auto &callback : gone) {
+				callback();
+			}
+		});
+	}
+}
+
+void Track(not_null<QWidget*> widget) {
+	if (widget->property("_teleScriptTracked").toBool()) {
+		return;
+	}
+	widget->setProperty("_teleScriptTracked", true);
+	const auto raw = widget.get();
+	QObject::connect(raw, &QObject::destroyed, [=] {
+		Dropped(raw);
+	});
+}
+
+void Remember(Change &&change) {
+	if (const auto widget = change.widget.data()) {
+		Track(widget);
+	}
+	Changes().push_back(std::move(change));
+}
+
+[[nodiscard]] Change &BaseChange(const void *owner, not_null<QWidget*> widget) {
+	auto &changes = Changes();
+	const auto i = ranges::find_if(changes, [&](const Change &change) {
+		return change.owner == owner
+			&& !change.key
+			&& change.widget.data() == widget.get();
+	});
+	if (i != end(changes)) {
+		return *i;
+	}
+	Remember({ .owner = owner, .widget = widget.get() });
+	return changes.back();
+}
+
+} // namespace
+
+std::optional<WidgetInfo> DescribeWidget(int id) {
+	const auto widget = ById(id);
+	if (!widget) {
+		return std::nullopt;
+	}
+	const auto rp = dynamic_cast<Ui::RpWidget*>(widget);
+	const auto window = widget->window();
+	return WidgetInfo{
+		.type = TypeName(widget),
+		.role = rp ? RoleName(rp->accessibilityRole()) : u"widget"_q,
+		.name = rp ? rp->accessibilityName() : QString(),
+		.value = rp ? rp->accessibilityValue() : QString(),
+		.description = rp ? rp->accessibilityDescription() : QString(),
+		.rect = QRect(widget->mapTo(window, QPoint()), widget->size()),
+		.visible = widget->isVisible(),
+	};
+}
+
+std::vector<int> WidgetRoots() {
+	auto result = std::vector<int>();
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		if (widget->isVisible()) {
+			result.push_back(IdOf(widget));
+		}
+	}
+	return result;
+}
+
+std::vector<int> WidgetChildren(int id) {
+	auto result = std::vector<int>();
+	if (const auto widget = ById(id)) {
+		for (const auto child : widget->children()) {
+			if (const auto inner = qobject_cast<QWidget*>(child)) {
+				result.push_back(IdOf(inner));
+			}
+		}
+	}
+	return result;
+}
+
+int WidgetParent(int id) {
+	const auto widget = ById(id);
+	const auto parent = widget ? widget->parentWidget() : nullptr;
+	return parent ? IdOf(parent) : 0;
+}
+
+std::vector<int> FindWidgets(int root, const WidgetQuery &query, int limit) {
+	const auto compiled = Compile(query);
+	auto result = std::vector<int>();
+	if (root) {
+		if (const auto widget = ById(root)) {
+			for (const auto child : widget->children()) {
+				if (const auto inner = qobject_cast<QWidget*>(child)) {
+					Collect(inner, compiled, limit, result);
+				}
+			}
+		}
+	} else {
+		for (const auto widget : QApplication::topLevelWidgets()) {
+			Collect(widget, compiled, limit, result);
+		}
+	}
+	return result;
+}
+
+rpl::lifetime ObserveWidgets(WidgetQuery query, Fn<void(int)> shown) {
+	return Watcher().add(std::move(query), std::move(shown));
+}
+
+void SetWidgetVisible(const void *owner, int id, bool visible) {
+	const auto widget = ById(id);
+	if (!widget) {
+		return;
+	}
+	auto &change = BaseChange(owner, widget);
+	if (!change.wasVisible) {
+		change.wasVisible = widget->isVisible();
+	}
+	widget->setVisible(visible);
+}
+
+bool SetWidgetText(const void *owner, int id, const QString &text) {
+	const auto label = dynamic_cast<Ui::FlatLabel*>(ById(id));
+	if (!label) {
+		return false;
+	}
+	auto &change = BaseChange(owner, label);
+	if (!change.wasText) {
+		change.wasText = label->exchangeText(Ui::Text::String());
+	}
+	label->setText(text);
+	return true;
+}
+
+bool ClickWidget(int id) {
+	const auto button = dynamic_cast<Ui::AbstractButton*>(ById(id));
+	if (!button || button->isDisabled()) {
+		return false;
+	}
+	const auto weak = QPointer<Ui::AbstractButton>(button);
+	crl::on_main(button, [=] {
+		if (const auto strong = weak.data()) {
+			strong->clicked(Qt::NoModifier, Qt::LeftButton);
+		}
+	});
+	return true;
+}
+
+Ui::VerticalLayout *InsertWidgetBlock(
+		const void *owner,
+		int key,
+		int id,
+		bool before,
+		Fn<void()> gone) {
+	auto widget = ById(id);
+	auto layout = (Ui::VerticalLayout*)nullptr;
+	while (widget) {
+		layout = dynamic_cast<Ui::VerticalLayout*>(widget->parentWidget());
+		if (layout) {
+			break;
+		}
+		widget = widget->parentWidget();
+	}
+	if (!layout) {
+		return nullptr;
+	}
+	auto index = -1;
+	for (auto i = 0; i != layout->count(); ++i) {
+		if (layout->widgetAt(i).get() == widget) {
+			index = i;
+			break;
+		}
+	}
+	if (index < 0) {
+		return nullptr;
+	}
+	const auto block = layout->insert(
+		before ? index : (index + 1),
+		object_ptr<Ui::VerticalLayout>(layout));
+	if (!block) {
+		return nullptr;
+	}
+	block->show();
+	Remember({
+		.owner = owner,
+		.key = key,
+		.widget = layout,
+		.added = { QPointer<QWidget>(block) },
+		.gone = std::move(gone),
+	});
+	return block;
+}
+
+bool InsertTableRow(
+		const void *owner,
+		int key,
+		int id,
+		int index,
+		const QString &label,
+		const QString &value,
+		Fn<void()> click,
+		Fn<void()> gone) {
+	const auto table = dynamic_cast<Ui::TableLayout*>(ById(id));
+	if (!table) {
+		return false;
+	}
+	const auto count = table->rowsCount();
+	auto at = std::min(index, count);
+	if (at < 0) {
+		at = count;
+		while (at > 0 && table->rowSpans(at - 1)) {
+			--at;
+		}
+	}
+	auto labelWidget = object_ptr<Ui::FlatLabel>(
+		table,
+		label,
+		st::defaultTableLabel);
+	auto valueWidget = object_ptr<Ui::FlatLabel>(
+		table,
+		rpl::single(click
+			? Ui::Text::Link(value)
+			: TextWithEntities{ value }),
+		st::defaultTableValue);
+	if (click) {
+		valueWidget->setClickHandlerFilter([=](const auto &...) {
+			crl::on_main(click);
+			return false;
+		});
+	}
+	const auto rawLabel = labelWidget.data();
+	const auto rawValue = valueWidget.data();
+	table->insertRow(
+		at,
+		std::move(labelWidget),
+		std::move(valueWidget),
+		st::giveawayGiftCodeLabelMargin,
+		st::giveawayGiftCodeValueMargin);
+	rawLabel->show();
+	rawValue->show();
+	Remember({
+		.owner = owner,
+		.key = key,
+		.widget = table,
+		.added = { QPointer<QWidget>(rawLabel), QPointer<QWidget>(rawValue) },
+		.gone = std::move(gone),
+	});
+	return true;
+}
+
+bool AddMenuAction(
+		const void *owner,
+		int key,
+		int id,
+		const QString &text,
+		Fn<void()> click,
+		Fn<void()> gone) {
+	auto widget = ById(id);
+	auto menu = (Ui::PopupMenu*)nullptr;
+	while (widget && !menu) {
+		menu = dynamic_cast<Ui::PopupMenu*>(widget);
+		widget = widget->parentWidget();
+	}
+	if (!menu) {
+		return false;
+	}
+	const auto action = menu->addAction(text, std::move(click));
+	Remember({
+		.owner = owner,
+		.key = key,
+		.widget = menu,
+		.action = action.get(),
+		.gone = std::move(gone),
+	});
+	return true;
+}
+
+void RemoveWidgetChange(const void *owner, int key) {
+	auto &changes = Changes();
+	for (auto i = begin(changes); i != end(changes);) {
+		if (i->owner == owner && i->key == key && key) {
+			auto change = std::move(*i);
+			i = changes.erase(i);
+			Undo(change);
+		} else {
+			++i;
+		}
+	}
+}
+
+void RemoveWidgetChanges(const void *owner) {
+	auto &changes = Changes();
+	auto taken = std::vector<Change>();
+	for (auto i = begin(changes); i != end(changes);) {
+		if (i->owner == owner) {
+			taken.push_back(std::move(*i));
+			i = changes.erase(i);
+		} else {
+			++i;
+		}
+	}
+	for (auto &change : ranges::views::reverse(taken)) {
+		Undo(change);
+	}
+}
