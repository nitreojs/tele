 				}
@@ -1207,14 +1207,14 @@
 					throw new TypeError('tg.interceptSendMessage(filter?, function)');
 				}
 				const kinds = (filter.kinds === 'all')
-					? ['text', 'files', 'document', 'photo', 'forward']
+					? ['text', 'files', 'document', 'photo', 'forward', 'inline']
 					: [filter.kinds ?? 'text'].flat();
 				return given.listenSend((context) => (sendMatches(filter, context.message) ? middleware(context) : 'send'), kinds);
 			},
 
 			async addLocalMessage(chat, options = {}) {
 				const peerId = peerOfInput(await resolvePeer(chat));
-				const channel = (tg.peers.get(markedId(peerId, selfId))?.kind === 'channel');
+				const channel = (given.peerInput(markedId(peerId, selfId))?.kind === 'channel');
 				const fields = await localFieldsOf(options);
 				const anonymous = (fields.out === false && fields.fromId === undefined);
 				const message = localMessageOf({
@@ -1657,7 +1657,160 @@
 			}
 			return id;
 		};
+		const patternOf = (value, field) => {
+			if (value === undefined) {
+				return {};
+			} else if (typeof value === 'string') {
+				return { [field]: `^${value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}$` };
+			} else if (value instanceof RegExp) {
+				return { [field]: value.source, [`${field}Ci`]: value.flags.includes('i') };
+			}
+			throw new TypeError(`selector.${field} must be a string or a RegExp`);
+		};
+		const queryOf = (selector) => {
+			if (selector === null || typeof selector !== 'object') {
+				throw new TypeError('a widget selector is an object: { type?, name?, role?, within?, hidden? }');
+			}
+			return {
+				...patternOf(selector.type, 'type'),
+				...patternOf(selector.name, 'name'),
+				role: selector.role ?? '',
+				hidden: selector.hidden === true,
+			};
+		};
+		const widgetOf = (id) => {
+			const info = () => given.widgetInfo(id);
+			const field = (name, fallback) => () => info()?.[name] ?? fallback;
+			const widget = {
+				id,
+				get alive() { return info() !== undefined; },
+				get type() { return field('type', '')(); },
+				get role() { return field('role', '')(); },
+				get name() { return field('name', '')(); },
+				get value() { return field('value', '')(); },
+				get description() { return field('description', '')(); },
+				get visible() { return field('visible', false)(); },
+				get rect() { return field('rect', { x: 0, y: 0, width: 0, height: 0 })(); },
+				parent() {
+					const parent = given.widgetParent(id);
+					return parent ? widgetOf(parent) : null;
+				},
+				children() {
+					return given.widgetChildren(id).map(widgetOf);
+				},
+				find(selector, limit) {
+					return findWidgets(id, selector, limit);
+				},
+				closest(selector) {
+					const query = queryOf(selector);
+					const type = query.type === undefined ? null : new RegExp(query.type, query.typeCi ? 'i' : '');
+					const name = query.name === undefined ? null : new RegExp(query.name, query.nameCi ? 'i' : '');
+					for (let current = widget.parent(); current; current = current.parent()) {
+						if ((!type || type.test(current.type))
+							&& (!name || name.test(current.name))
+							&& (!query.role || query.role === current.role)
+							&& (selector.within === undefined || current.closest(selector.within))) {
+							return current;
+						}
+					}
+					return null;
+				},
+				setVisible(visible) {
+					given.widgetSetVisible(id, visible === true);
+				},
+				setText(text) {
+					return given.widgetSetText(id, String(text));
+				},
+				insert(where, page) {
+					if (where !== 'before' && where !== 'after') {
+						throw new TypeError("widget.insert('before' | 'after', page)");
+					}
+					const result = given.widgetInsert(id, where === 'before', pageId(page));
+					if (result === undefined) {
+						throw new TeleError('not-found', 'this page was disposed, or this account has no window');
+					} else if (!result) {
+						throw new TeleError('not-found', "this widget isn't inside a vertical layout tele can insert into");
+					}
+					return result;
+				},
+				insertRow(row) {
+					if (row === null || typeof row !== 'object') {
+						throw new TypeError('widget.insertRow({ label, value, index?, onClick? })');
+					}
+					const result = given.widgetInsertRow(
+						id,
+						row.index ?? -1,
+						String(row.label ?? ''),
+						String(row.value ?? ''),
+						(typeof row.onClick === 'function') ? row.onClick : undefined);
+					if (!result) {
+						throw new TeleError('not-found', "this widget isn't a table");
+					}
+					return result;
+				},
+				addMenuItem(item) {
+					if (typeof item?.onClick !== 'function') {
+						throw new TypeError('widget.addMenuItem({ text, onClick })');
+					}
+					const result = given.widgetAddMenuItem(id, String(item.text ?? ''), item.onClick);
+					if (!result) {
+						throw new TeleError('not-found', "this widget isn't inside a popup menu");
+					}
+					return result;
+				},
+				click() {
+					return given.widgetClick(id);
+				},
+			};
+			return Object.freeze(widget);
+		};
+		const findWidgets = (root, selector, limit) => {
+			const query = queryOf(selector);
+			const within = selector.within;
+			if (within === undefined) {
+				return given.widgetsFind(root, query, limit ?? 1000).map(widgetOf);
+			}
+			const result = [];
+			const max = limit ?? 1000;
+			for (const scope of findWidgets(root, within, 1000)) {
+				for (const found of given.widgetsFind(scope.id, query, max - result.length)) {
+					if (!result.some((widget) => widget.id === found)) {
+						result.push(widgetOf(found));
+					}
+				}
+				if (result.length >= max) {
+					break;
+				}
+			}
+			return result;
+		};
+		const widgets = Object.freeze({
+			roots() {
+				return given.widgetRoots().map(widgetOf);
+			},
+			find(selector, limit) {
+				return findWidgets(0, selector, limit);
+			},
+			observe(selector, callback) {
+				if (typeof callback !== 'function') {
+					throw new TypeError('tg.ui.widgets.observe(selector, callback)');
+				}
+				const query = queryOf(selector);
+				const name = query.name === undefined ? null : new RegExp(query.name, query.nameCi ? 'i' : '');
+				const within = selector.within;
+				return given.widgetsObserve(query, (id) => {
+					const widget = widgetOf(id);
+					if (name && !name.test(widget.name)) {
+						return;
+					} else if (within && !widget.closest(within)) {
+						return;
+					}
+					return callback(widget);
+				});
+			},
+		});
 		Object.assign(tg.ui, {
+			widgets,
 			header: element('header'),
 			button: element('button'),
 			check: element('check'),
diff --git a/Telegram/SourceFiles/apiwrap.cpp b/Telegram/SourceFiles/apiwrap.cpp
