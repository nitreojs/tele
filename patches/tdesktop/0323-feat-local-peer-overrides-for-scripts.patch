new file mode 100644
index 0000000000000000000000000000000000000000..baacfd020e36f5184fa21bbf9ec9cd7ee786552f
--- /dev/null
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_peers.cpp
@@ -0,0 +1,335 @@
+#include "tele/scripting/tele_script_peers.h"
+
+#include "data/data_changes.h"
+#include "data/data_channel.h"
+#include "data/data_chat.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "ui/unread_badge.h"
+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kFlags = std::array{
+	PeerFlag::Verified,
+	PeerFlag::Scam,
+	PeerFlag::Fake,
+	PeerFlag::Premium,
+};
+
+struct Layer {
+	const void *owner = nullptr;
+	PeerOverride value;
+};
+
+struct Merged {
+	PeerOverride value;
+	std::array<std::optional<bool>, kFlags.size()> flags;
+	std::optional<Ui::BotVerifyDetails> botVerify;
+	std::optional<EmojiStatusId> emojiStatus;
+	std::optional<uint8> color;
+	std::optional<QString> name;
+};
+
+struct State {
+	base::flat_map<not_null<PeerData*>, std::vector<Layer>> layers;
+	base::flat_map<not_null<PeerData*>, Merged> merged;
+};
+
+[[nodiscard]] State &Get() {
+	static auto result = State();
+	return result;
+}
+
+[[nodiscard]] Merged *Find(not_null<PeerData*> peer) {
+	auto &merged = Get().merged;
+	if (merged.empty()) {
+		return nullptr;
+	}
+	const auto i = merged.find(peer);
+	return (i != end(merged)) ? &i->second : nullptr;
+}
+
+[[nodiscard]] PeerOverride Merge(const std::vector<Layer> &layers) {
+	auto result = PeerOverride();
+	for (const auto &layer : layers) {
+		const auto &value = layer.value;
+		if (value.name) {
+			result.name = value.name;
+		}
+		if (value.verified) {
+			result.verified = value.verified;
+		}
+		if (value.scam) {
+			result.scam = value.scam;
+		}
+		if (value.fake) {
+			result.fake = value.fake;
+		}
+		if (value.premium) {
+			result.premium = value.premium;
+		}
+		if (value.botVerifyIcon) {
+			result.botVerifyIcon = value.botVerifyIcon;
+			result.botVerifyDescription = value.botVerifyDescription;
+			result.botVerifyBot = value.botVerifyBot;
+		}
+		if (value.emojiStatus) {
+			result.emojiStatus = value.emojiStatus;
+		}
+		if (value.color) {
+			result.color = value.color;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<bool> Forced(
+		const PeerOverride &value,
+		PeerFlag flag) {
+	switch (flag) {
+	case PeerFlag::Verified: return value.verified;
+	case PeerFlag::Scam: return value.scam;
+	case PeerFlag::Fake: return value.fake;
+	case PeerFlag::Premium: return value.premium;
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] UserDataFlag UserFlag(PeerFlag flag) {
+	switch (flag) {
+	case PeerFlag::Verified: return UserDataFlag::Verified;
+	case PeerFlag::Scam: return UserDataFlag::Scam;
+	case PeerFlag::Fake: return UserDataFlag::Fake;
+	case PeerFlag::Premium: return UserDataFlag::Premium;
+	}
+	Unexpected("Flag in Tele::Scripting::UserFlag.");
+}
+
+[[nodiscard]] std::optional<ChannelDataFlag> ChannelFlag(PeerFlag flag) {
+	switch (flag) {
+	case PeerFlag::Verified: return ChannelDataFlag::Verified;
+	case PeerFlag::Scam: return ChannelDataFlag::Scam;
+	case PeerFlag::Fake: return ChannelDataFlag::Fake;
+	case PeerFlag::Premium: return std::nullopt;
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] bool HasFlag(not_null<PeerData*> peer, PeerFlag flag) {
+	if (const auto user = peer->asUser()) {
+		return (user->flags() & UserFlag(flag));
+	} else if (const auto channel = peer->asChannel()) {
+		const auto bit = ChannelFlag(flag);
+		return bit && (channel->flags() & *bit);
+	}
+	return false;
+}
+
+void SetFlag(not_null<PeerData*> peer, PeerFlag flag, bool value) {
+	if (const auto user = peer->asUser()) {
+		if (value) {
+			user->addFlags(UserFlag(flag));
+		} else {
+			user->removeFlags(UserFlag(flag));
+		}
+	} else if (const auto channel = peer->asChannel()) {
+		if (const auto bit = ChannelFlag(flag)) {
+			if (value) {
+				channel->addFlags(*bit);
+			} else {
+				channel->removeFlags(*bit);
+			}
+		}
+	}
+}
+
+[[nodiscard]] Ui::BotVerifyDetails CurrentBotVerify(
+		not_null<PeerData*> peer) {
+	const auto details = peer->asUser()
+		? peer->asUser()->botVerifyDetails()
+		: peer->asChannel()
+		? peer->asChannel()->botVerifyDetails()
+		: nullptr;
+	return details ? *details : Ui::BotVerifyDetails();
+}
+
+void SetBotVerify(
+		not_null<PeerData*> peer,
+		const Ui::BotVerifyDetails &details) {
+	if (const auto user = peer->asUser()) {
+		user->setBotVerifyDetails(details);
+	} else if (const auto channel = peer->asChannel()) {
+		channel->setBotVerifyDetails(details);
+	}
+}
+
+void RefreshName(
+		not_null<PeerData*> peer,
+		const std::optional<QString> &real) {
+	if (const auto user = peer->asUser()) {
+		user->setName(
+			user->firstName,
+			user->lastName,
+			user->nameOrPhone,
+			user->editableUsername());
+	} else if (const auto chat = peer->asChat()) {
+		chat->setName(real.value_or(chat->name()));
+	} else if (const auto channel = peer->asChannel()) {
+		channel->setName(real.value_or(channel->name()), channel->username());
+	}
+}
+
+void Apply(not_null<PeerData*> peer) {
+	auto &state = Get();
+	const auto layers = state.layers.find(peer);
+	const auto active = (layers != end(state.layers))
+		&& !layers->second.empty();
+	auto &merged = state.merged[peer];
+	const auto hadName = merged.value.name.has_value();
+	merged.value = active ? Merge(layers->second) : PeerOverride();
+	const auto &value = merged.value;
+	for (const auto flag : kFlags) {
+		auto &real = merged.flags[int(flag)];
+		if (const auto forced = Forced(value, flag)) {
+			if (!real) {
+				real = HasFlag(peer, flag);
+			}
+			if (HasFlag(peer, flag) != *forced) {
+				SetFlag(peer, flag, *forced);
+			}
+		} else if (real) {
+			const auto restore = *real;
+			real = std::nullopt;
+			if (HasFlag(peer, flag) != restore) {
+				SetFlag(peer, flag, restore);
+			}
+		}
+	}
+	if (value.botVerifyIcon || merged.botVerify) {
+		const auto real = merged.botVerify.value_or(CurrentBotVerify(peer));
+		merged.botVerify = std::nullopt;
+		SetBotVerify(peer, real);
+	}
+	if (value.emojiStatus || merged.emojiStatus) {
+		const auto real = merged.emojiStatus.value_or(peer->emojiStatusId());
+		merged.emojiStatus = std::nullopt;
+		peer->setEmojiStatus(real);
+	}
+	if (value.color || merged.color) {
+		const auto real = merged.color.value_or(peer->colorIndex());
+		merged.color = std::nullopt;
+		peer->changeColorIndex(real);
+	}
+	if (value.name || hadName) {
+		const auto real = std::exchange(merged.name, std::nullopt);
+		RefreshName(peer, real);
+	}
+	if (!active) {
+		state.merged.remove(peer);
+		if (layers != end(state.layers)) {
+			state.layers.erase(layers);
+		}
+	}
+	using Flag = Data::PeerUpdate::Flag;
+	peer->session().changes().peerUpdated(
+		peer,
+		Flag::Name | Flag::VerifyInfo | Flag::EmojiStatus | Flag::Color);
+}
+
+} // namespace
+
+void SetPeerOverride(
+		not_null<PeerData*> peer,
+		const void *owner,
+		std::optional<PeerOverride> value) {
+	auto &layers = Get().layers[peer];
+	const auto i = ranges::find(layers, owner, &Layer::owner);
+	if (value) {
+		if (i != end(layers)) {
+			i->value = std::move(*value);
+		} else {
+			layers.push_back({ .owner = owner, .value = std::move(*value) });
+		}
+	} else if (i != end(layers)) {
+		layers.erase(i);
+	} else if (!Find(peer)) {
+		Get().layers.remove(peer);
+		return;
+	}
+	Apply(peer);
+}
+
+void RemovePeerOverrides(const void *owner) {
+	auto peers = std::vector<not_null<PeerData*>>();
+	for (auto &[peer, layers] : Get().layers) {
+		const auto i = ranges::find(layers, owner, &Layer::owner);
+		if (i != end(layers)) {
+			layers.erase(i);
+			peers.push_back(peer);
+		}
+	}
+	for (const auto &peer : peers) {
+		Apply(peer);
+	}
+}
+
+QString OverrideName(not_null<PeerData*> peer, const QString &name) {
+	const auto merged = Find(peer);
+	if (!merged || !merged->value.name) {
+		return name;
+	} else if (name != *merged->value.name) {
+		merged->name = name;
+	}
+	return *merged->value.name;
+}
+
+bool OverrideFlag(not_null<PeerData*> peer, PeerFlag flag, bool real) {
+	const auto merged = Find(peer);
+	const auto forced = merged ? Forced(merged->value, flag) : std::nullopt;
+	if (!forced) {
+		return real;
+	}
+	merged->flags[int(flag)] = real;
+	return *forced;
+}
+
+void OverrideBotVerify(
+		not_null<PeerData*> peer,
+		Ui::BotVerifyDetails &details) {
+	const auto merged = Find(peer);
+	if (!merged || !merged->value.botVerifyIcon) {
+		return;
+	}
+	merged->botVerify = details;
+	const auto &value = merged->value;
+	details = *value.botVerifyIcon
+		? Ui::BotVerifyDetails{
+			.botId = UserId(value.botVerifyBot),
+			.iconId = *value.botVerifyIcon,
+			.description = TextWithEntities{ value.botVerifyDescription },
+		}
+		: Ui::BotVerifyDetails();
+}
+
+EmojiStatusId OverrideEmojiStatus(
+		not_null<PeerData*> peer,
+		EmojiStatusId real) {
+	const auto merged = Find(peer);
+	if (!merged || !merged->value.emojiStatus) {
+		return real;
+	}
+	merged->emojiStatus = std::move(real);
+	return EmojiStatusId{ .documentId = *merged->value.emojiStatus };
+}
+
+uint8 OverrideColor(not_null<PeerData*> peer, uint8 real) {
+	const auto merged = Find(peer);
+	if (!merged || !merged->value.color) {
+		return real;
+	}
+	merged->color = real;
+	return *merged->value.color;
+}
+
+} // namespace Tele::Scripting
