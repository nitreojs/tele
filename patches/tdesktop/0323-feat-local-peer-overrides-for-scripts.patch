+#pragma once
+
+class PeerData;
+struct EmojiStatusId;
+
+namespace Ui {
+struct BotVerifyDetails;
+} // namespace Ui
+
+namespace Tele::Scripting {
+
+enum class PeerFlag : uchar {
+	Verified,
+	Scam,
+	Fake,
+	Premium,
+};
+
+struct PeerOverride {
+	std::optional<QString> name;
+	std::optional<bool> verified;
+	std::optional<bool> scam;
+	std::optional<bool> fake;
+	std::optional<bool> premium;
+	std::optional<uint64> botVerifyIcon;
+	QString botVerifyDescription;
+	uint64 botVerifyBot = 0;
+	std::optional<uint64> emojiStatus;
+	std::optional<uint8> color;
+};
+
+void SetPeerOverride(
+	not_null<PeerData*> peer,
+	const void *owner,
+	std::optional<PeerOverride> value);
+void RemovePeerOverrides(const void *owner);
+
+[[nodiscard]] QString OverrideName(
+	not_null<PeerData*> peer,
+	const QString &name);
+[[nodiscard]] bool OverrideFlag(
+	not_null<PeerData*> peer,
+	PeerFlag flag,
+	bool real);
+void OverrideBotVerify(
+	not_null<PeerData*> peer,
+	Ui::BotVerifyDetails &details);
+[[nodiscard]] EmojiStatusId OverrideEmojiStatus(
+	not_null<PeerData*> peer,
+	EmojiStatusId real);
+[[nodiscard]] uint8 OverrideColor(not_null<PeerData*> peer, uint8 real);
+
+} // namespace Tele::Scripting
