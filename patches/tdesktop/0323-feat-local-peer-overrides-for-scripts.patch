+JSValue Instance::NativePeerOverride(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = instance->_session;
+	const auto id = (argc > 0)
+		? PeerFromValue(ctx, argv[0], session->user()->id)
+		: std::nullopt;
+	const auto peer = id ? session->data().peerLoaded(*id) : nullptr;
+	if (!peer) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.overridePeer: this peer isn't in tele's cache");
+	} else if (argc < 2 || JS_IsNull(argv[1]) || JS_IsUndefined(argv[1])) {
+		SetPeerOverride(peer, instance, std::nullopt);
+		return JS_UNDEFINED;
+	} else if (!JS_IsObject(argv[1])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.overridePeer: an override is an object or null");
+	}
+	const auto object = argv[1];
+	auto value = PeerOverride();
+	auto wrong = std::string();
+	const auto field = [&](const char *name, auto &&read) {
+		auto property = JS_GetPropertyStr(ctx, object, name);
+		if (wrong.empty() && !JS_IsUndefined(property) && !read(property)) {
+			wrong = name;
+		}
+		JS_FreeValue(ctx, property);
+	};
+	const auto id64 = [&](JSValueConst from, uint64 &to) {
+		auto number = std::int64_t();
+		if (JS_IsBigInt(from)) {
+			JS_ToBigInt64(ctx, &number, from);
+		} else if (JS_IsNumber(from)) {
+			JS_ToInt64(ctx, &number, from);
+		} else {
+			return false;
+		}
+		to = uint64(number);
+		return true;
+	};
+	const auto flag = [&](const char *name, std::optional<bool> &to) {
+		field(name, [&](JSValueConst from) {
+			if (!JS_IsBool(from)) {
+				return false;
+			}
+			to = (JS_ToBool(ctx, from) != 0);
+			return true;
+		});
+	};
+	field("name", [&](JSValueConst from) {
+		if (!JS_IsString(from)) {
+			return false;
+		}
+		value.name = FromStd(ToStd(ctx, from));
+		return true;
+	});
+	flag("verified", value.verified);
+	flag("scam", value.scam);
+	flag("fake", value.fake);
+	flag("premium", value.premium);
+	field("botVerification", [&](JSValueConst from) {
+		if (JS_IsNull(from)) {
+			value.botVerifyIcon = 0;
+			return true;
+		} else if (!JS_IsObject(from)) {
+			return false;
+		}
+		auto icon = JS_GetPropertyStr(ctx, from, "icon");
+		auto bot = JS_GetPropertyStr(ctx, from, "bot");
+		auto description = JS_GetPropertyStr(ctx, from, "description");
+		auto iconId = uint64();
+		auto botId = uint64();
+		const auto ok = id64(icon, iconId)
+			&& (iconId != 0)
+			&& (JS_IsUndefined(bot) || id64(bot, botId))
+			&& (JS_IsUndefined(description) || JS_IsString(description));
+		if (ok) {
+			value.botVerifyIcon = iconId;
+			value.botVerifyBot = botId;
+			value.botVerifyDescription = JS_IsString(description)
+				? FromStd(ToStd(ctx, description))
+				: QString();
+		}
+		JS_FreeValue(ctx, icon);
+		JS_FreeValue(ctx, bot);
+		JS_FreeValue(ctx, description);
+		return ok;
+	});
+	field("emojiStatus", [&](JSValueConst from) {
+		auto documentId = uint64();
+		if (JS_IsNull(from)) {
+			value.emojiStatus = 0;
+			return true;
+		} else if (!id64(from, documentId)) {
+			return false;
+		}
+		value.emojiStatus = documentId;
+		return true;
+	});
+	field("color", [&](JSValueConst from) {
+		auto number = 0;
+		if (!JS_IsNumber(from)
+			|| JS_ToInt32(ctx, &number, from)
+			|| number < 0
+			|| number > 255) {
+			return false;
+		}
+		value.color = uint8(number);
+		return true;
+	});
+	if (!wrong.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.overridePeer: %s has the wrong type",
+			wrong.c_str());
+	}
+	SetPeerOverride(peer, instance, std::move(value));
+	return JS_UNDEFINED;
+}
