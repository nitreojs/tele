+
+[[nodiscard]] const Unit *FindUnit(const QString &text) {
+	const auto folded = text.toLower();
+	for (const auto &unit : Units()) {
+		if (unit.aliases.contains(folded)) {
+			return &unit;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] std::optional<LocalCalcNumber> Factor(const Unit &unit) {
+	const auto numerator = LocalCalcNumber::Parse(unit.factor);
+	const auto denominator = LocalCalcNumber::Parse(unit.divisor);
+	return (numerator && denominator)
+		? numerator->Divide(*denominator)
+		: std::nullopt;
+}
+
+[[nodiscard]] QString WithUnit(const LocalCalcNumber &number, const Unit &unit) {
+	const auto compact = (unit.symbol == QString::fromUtf8("°"))
+		|| (unit.symbol == QString::fromUtf8("′"))
+		|| (unit.symbol == QString::fromUtf8("″"));
+	const auto value = number.Format();
+	return value.isEmpty()
+		? QString()
+		: value + (compact ? QString() : u" "_q) + unit.symbol;
+}
+
+[[nodiscard]] bool IsCoefficient(const QString &text) {
+	static const auto literal = QRegularExpression(
+		u"^[+-]?\\s*(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|"_q
+		+ u"(?:[0-9][0-9,_ ]*(?:\\.[0-9]*)?|\\.[0-9]+)"_q
+		+ u"(?:[eE][+-]?[0-9]+)?)$"_q);
+	if (literal.match(text).hasMatch()) {
+		return true;
+	}
+	if (!text.startsWith('(') || !text.endsWith(')')) {
+		return false;
+	}
+	auto depth = 0;
+	for (auto i = 0; i != text.size(); ++i) {
+		if (text[i] == '(') {
+			++depth;
+		} else if (text[i] == ')') {
+			if (--depth == 0 && i + 1 != text.size()) {
+				return false;
+			}
+		}
+	}
+	return depth == 0;
+}
+
+struct Quantity {
+	LocalCalcNumber amount;
+	const Unit *unit;
+};
+
+[[nodiscard]] std::optional<Quantity> ParseQuantity(const QString &query) {
+	const Unit *found = nullptr;
+	auto size = qsizetype(0);
+	for (const auto &unit : Units()) {
+		for (const auto &alias : unit.aliases) {
+			if (alias.size() > size && query.endsWith(alias, Qt::CaseInsensitive)) {
+				found = &unit;
+				size = alias.size();
+			}
+		}
+	}
+	if (!found) {
+		return std::nullopt;
+	}
+	const auto prefix = query.left(query.size() - size);
+	const auto coefficient = prefix.trimmed();
+	if (!IsCoefficient(coefficient)
+		|| (coefficient.contains(u"0x"_q, Qt::CaseInsensitive)
+			&& (prefix.isEmpty() || !prefix.back().isSpace()))) {
+		return std::nullopt;
+	}
+	const auto amount = ParseLocalCalcmulaNumber(coefficient);
+	return amount
+		? std::make_optional(Quantity{ *amount, found })
+		: std::nullopt;
+}
+
+[[nodiscard]] std::optional<LocalCalcNumber> BaseAmount(const Quantity &quantity) {
+	const auto factor = Factor(*quantity.unit);
+	if (!factor) {
+		return std::nullopt;
+	}
+	auto amount = std::make_optional(quantity.amount);
+	if (quantity.unit->kind == Kind::Temperature) {
+		if (quantity.unit->symbol == QString::fromUtf8("°F")) {
+			amount = amount->Subtract(LocalCalcNumber::Integer(32));
+		}
+		amount = amount ? amount->Multiply(*factor) : std::nullopt;
+		return (amount && quantity.unit->symbol != "K")
+			? amount->Add(*LocalCalcNumber::Parse("273.15"))
+			: amount;
+	}
+	return amount->Multiply(*factor);
+}
+
+[[nodiscard]] QString Convert(const Quantity &quantity, const Unit &target) {
+	if (quantity.unit->kind != target.kind) {
+		return QString();
+	}
+	auto amount = BaseAmount(quantity);
+	const auto factor = Factor(target);
+	if (!amount || !factor) {
+		return QString();
+	}
+	if (target.kind == Kind::Temperature && target.symbol != "K") {
+		amount = amount->Subtract(*LocalCalcNumber::Parse("273.15"));
+	}
+	amount = amount ? amount->Divide(*factor) : std::nullopt;
+	if (amount
+		&& target.kind == Kind::Temperature
+		&& target.symbol == QString::fromUtf8("°F")) {
+		amount = amount->Add(LocalCalcNumber::Integer(32));
+	}
+	return amount ? WithUnit(*amount, target) : QString();
+}
+
+[[nodiscard]] QString Breakdown(const Quantity &quantity, const QStringList &symbols) {
+	const auto base = BaseAmount(quantity);
+	if (!base || base->IsZero()) {
+		return base ? WithUnit(quantity.amount, *quantity.unit) : QString();
+	}
+	auto rest = base->Absolute();
+	const auto smallest = FindUnit(symbols.back());
+	const auto smallestFactor = smallest ? Factor(*smallest) : std::nullopt;
+	if (!smallestFactor || rest.Compare(*smallestFactor) < 0) {
+		return WithUnit(quantity.amount, *quantity.unit);
+	}
+	auto parts = QStringList();
+	for (auto i = 0; i != symbols.size(); ++i) {
+		const auto unit = FindUnit(symbols[i]);
+		const auto factor = unit ? Factor(*unit) : std::nullopt;
+		const auto divided = factor ? rest.Divide(*factor) : std::nullopt;
+		if (!divided) {
+			return QString();
+		}
+		const auto amount = (i + 1 == symbols.size()) ? *divided : divided->Floor();
+		if (!amount.IsZero()) {
+			const auto part = WithUnit(amount, *unit);
+			if (part.isEmpty()) {
+				return QString();
+			}
+			parts.push_back(part);
+			const auto used = amount.Multiply(*factor);
+			const auto remaining = used ? rest.Subtract(*used) : std::nullopt;
+			if (!remaining) {
+				return QString();
+			}
+			rest = *remaining;
+		}
+	}
+	return (base->Compare(LocalCalcNumber::Integer(0)) < 0 ? u"-"_q : QString())
+		+ parts.join(' ');
+}
+
+[[nodiscard]] QString Format(const Quantity &quantity) {
+	switch (quantity.unit->kind) {
+	case Kind::Length:
+		if (quantity.unit->symbol == u"ly"_q
+			|| quantity.unit->symbol == u"au"_q) {
+			return WithUnit(quantity.amount, *quantity.unit);
+		}
+		return Breakdown(quantity, { "km", "m", "cm", "mm" });
+	case Kind::Mass:
+		return Breakdown(quantity, { "t", "kg", "g", "mg" });
+	case Kind::Volume:
+		return quantity.unit->symbol == QString::fromUtf8("m³")
+			? WithUnit(quantity.amount, *quantity.unit)
+			: Breakdown(quantity, { "l", "ml" });
+	case Kind::Time:
+		return Breakdown(quantity, { "y", "d", "h", "min", "s", "ms" });
+	case Kind::Data:
+		if (quantity.unit->symbol.contains("bit")) {
+			return QString();
+		}
+		return quantity.unit->symbol.contains("iB")
+			? Breakdown(quantity, { "PiB", "TiB", "GiB", "MiB", "KiB", "b" })
+			: Breakdown(quantity, { "PB", "TB", "GB", "MB", "KB", "b" });
+	case Kind::Temperature:
+		return WithUnit(quantity.amount, *quantity.unit);
+	default:
+		return QString();
+	}
+}
+
+}
+
+QString LocalCalcmulaUnits(const QString &query) {
+	if (query.size() > 1024 || query.contains('\n') || query.contains('\r')) {
+		return QString();
+	}
+	static const auto conversion = QRegularExpression(
+		QString::fromUtf8("^(.+?)\\s+(?:in|to|в|во|на|по|у|до)\\s+(.+)$"));
+	const auto trimmed = query.trimmed();
+	const auto match = conversion.match(trimmed);
+	const auto quantity = ParseQuantity(
+		match.hasMatch() ? match.captured(1) : trimmed);
+	if (!quantity) {
+		return QString();
+	}
+	if (match.hasMatch()) {
+		const auto target = FindUnit(match.captured(2).trimmed());
+		return target ? Convert(*quantity, *target) : QString();
+	}
+	return Format(*quantity);
+}
