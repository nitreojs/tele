+#pragma once
+
+#include <QString>
+#include <memory>
+#include <optional>
+
+namespace Tele {
+
+class LocalCalcNumber {
+public:
+	[[nodiscard]] static std::optional<LocalCalcNumber> Parse(
+		const QString &text,
+		int base = 10);
+	[[nodiscard]] static LocalCalcNumber Integer(qint64 value);
+
+	[[nodiscard]] std::optional<LocalCalcNumber> Add(
+		const LocalCalcNumber &other) const;
+	[[nodiscard]] std::optional<LocalCalcNumber> Subtract(
+		const LocalCalcNumber &other) const;
+	[[nodiscard]] std::optional<LocalCalcNumber> Multiply(
+		const LocalCalcNumber &other) const;
+	[[nodiscard]] std::optional<LocalCalcNumber> Divide(
+		const LocalCalcNumber &other) const;
+	[[nodiscard]] std::optional<LocalCalcNumber> Power(
+		const LocalCalcNumber &other) const;
+	[[nodiscard]] std::optional<LocalCalcNumber> Modulo(
+		const LocalCalcNumber &other) const;
+	[[nodiscard]] LocalCalcNumber Negated() const;
+	[[nodiscard]] LocalCalcNumber Absolute() const;
+	[[nodiscard]] LocalCalcNumber Floor() const;
+	[[nodiscard]] LocalCalcNumber Ceil() const;
+	[[nodiscard]] LocalCalcNumber Round() const;
+	[[nodiscard]] std::optional<qint64> ToInteger() const;
+	[[nodiscard]] int Compare(const LocalCalcNumber &other) const;
+	[[nodiscard]] bool IsZero() const;
+	[[nodiscard]] bool IsInteger() const;
+	[[nodiscard]] QString Format() const;
+
+private:
+	struct Value;
+	explicit LocalCalcNumber(std::shared_ptr<const Value> value);
+	[[nodiscard]] static std::optional<LocalCalcNumber> Make(
+		std::shared_ptr<Value> value);
+	[[nodiscard]] LocalCalcNumber Rounded(int direction) const;
+
+	std::shared_ptr<const Value> _value;
+
+};
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_calcmula_local_parser.cpp b/Telegram/SourceFiles/tele/tele_calcmula_local_parser.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8bf658c338757bb6a3f1d8188462dad444fb52fc
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_calcmula_local_parser.cpp
@@ -0,0 +1,464 @@
+#include "tele/tele_calcmula_local_parser.h"
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxLength = 1024;
+constexpr auto kMaxDepth = 64;
+constexpr auto kMaxOperations = 256;
+constexpr auto kMaxArguments = 32;
+
+using Number = LocalCalcNumber;
+
+struct Value {
+	Number number;
+	bool percent = false;
+};
+
+struct Depth {
+	explicit Depth(int &value);
+	~Depth();
+	int &value;
+};
+
+[[nodiscard]] bool Digit(QChar ch) {
+	return ch >= '0' && ch <= '9';
+}
+
+[[nodiscard]] bool Letter(QChar ch) {
+	return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
+}
+
+[[nodiscard]] int DigitValue(QChar ch) {
+	return Digit(ch)
+		? ch.unicode() - '0'
+		: (ch >= 'a' && ch <= 'f')
+		? ch.unicode() - 'a' + 10
+		: (ch >= 'A' && ch <= 'F')
+		? ch.unicode() - 'A' + 10
+		: -1;
+}
+
+class Parser {
+public:
+	explicit Parser(const QString &text);
+
+	[[nodiscard]] std::optional<Number> parse();
+
+private:
+	void space();
+
+	[[nodiscard]] bool operation();
+
+	[[nodiscard]] QChar current() const;
+
+	[[nodiscard]] bool take(QChar ch);
+
+	[[nodiscard]] std::optional<Value> addition();
+
+	[[nodiscard]] std::optional<Value> multiplication();
+
+	[[nodiscard]] std::optional<Value> unary();
+
+	[[nodiscard]] std::optional<Value> power();
+
+	[[nodiscard]] std::optional<Value> postfix();
+
+	[[nodiscard]] std::optional<Value> primary();
+
+	[[nodiscard]] std::optional<Number> literal();
+
+	[[nodiscard]] std::optional<Value> call();
+
+	const QString &_text;
+	int _position = 0;
+	int _depth = 0;
+	int _operations = 0;
+	int _callDepth = 0;
+
+};
+
+Depth::Depth(int &value) : value(value) {
+	++value;
+}
+
+Depth::~Depth() {
+	--value;
+}
+
+Parser::Parser(const QString &text)
+: _text(text) {
+}
+
+std::optional<Number> Parser::parse() {
+	if (_text.isEmpty()
+		|| _text.size() > kMaxLength
+		|| _text.contains('\n')
+		|| _text.contains('\r')) {
+		return std::nullopt;
+	}
+	auto result = addition();
+	space();
+	return (result && _position == _text.size())
+		? std::make_optional(std::move(result->number))
+		: std::nullopt;
+}
+
+void Parser::space() {
+	while (_position < _text.size() && _text[_position].isSpace()) {
+		++_position;
+	}
+}
+
+bool Parser::operation() {
+	return ++_operations <= kMaxOperations;
+}
+
+QChar Parser::current() const {
+	return (_position < _text.size()) ? _text[_position] : QChar();
+}
+
+bool Parser::take(QChar ch) {
+	space();
+	if (current() != ch) {
+		return false;
+	}
+	++_position;
+	return true;
+}
+
+std::optional<Value> Parser::addition() {
+	auto result = multiplication();
+	while (result) {
+		space();
+		const auto ch = current();
+		const auto subtract = ch == '-' || ch.unicode() == 0x2212;
+		if (ch != '+' && !subtract) {
+			break;
+		}
+		++_position;
+		auto right = multiplication();
+		if (!right || result->percent || right->percent || !operation()) {
+			return std::nullopt;
+		}
+		auto number = subtract
+			? result->number.Subtract(right->number)
+			: result->number.Add(right->number);
+		if (!number) {
+			return std::nullopt;
+		}
+		result = Value{ std::move(*number) };
+	}
+	return result;
+}
+
+std::optional<Value> Parser::multiplication() {
+	auto result = unary();
+	while (result) {
+		space();
+		const auto ch = current();
+		const auto divide = ch == '/' || ch.unicode() == 0x00F7;
+		const auto modulo = _text.mid(_position, 3) == u"mod"_q
+			&& _position > 0
+			&& _text[_position - 1].isSpace()
+			&& _position + 3 < _text.size()
+			&& _text[_position + 3].isSpace();
+		if ((ch != '*' && ch.unicode() != 0x00D7 && !divide && !modulo)
+			|| (ch == '*' && _position + 1 < _text.size()
+				&& _text[_position + 1] == '*')) {
+			break;
+		}
+		_position += modulo ? 3 : 1;
+		auto right = unary();
+		if (!right || !operation()) {
+			return std::nullopt;
+		}
+		auto number = divide
+			? result->number.Divide(right->number)
+			: modulo
+			? result->number.Modulo(right->number)
+			: result->number.Multiply(right->number);
+		if (!number) {
+			return std::nullopt;
+		}
+		result = Value{
+			std::move(*number),
+			result->percent || right->percent,
+		};
+	}
+	return result;
+}
+
+std::optional<Value> Parser::unary() {
+	const auto depth = Depth(_depth);
+	if (_depth > kMaxDepth) {
+		return std::nullopt;
+	}
+	space();
+	const auto ch = current();
+	if (ch == '+' || ch == '-' || ch.unicode() == 0x2212) {
+		++_position;
+		auto result = unary();
+		if (!result || !operation()) {
+			return std::nullopt;
+		}
+		if (ch != '+') {
+			result->number = result->number.Negated();
+		}
+		return result;
+	}
+	return power();
+}
+
+std::optional<Value> Parser::power() {
+	auto result = postfix();
+	if (!result) {
+		return std::nullopt;
+	}
+	space();
+	if (current() == '^') {
+		++_position;
+	} else if (current() == '*'
+		&& _position + 1 < _text.size()
+		&& _text[_position + 1] == '*') {
+		_position += 2;
+	} else {
+		return result;
+	}
+	auto exponent = unary();
+	if (!exponent || !operation()) {
+		return std::nullopt;
+	}
+	auto number = result->number.Power(exponent->number);
+	return number
+		? std::make_optional(Value{
+			std::move(*number),
+			result->percent || exponent->percent,
+		})
+		: std::nullopt;
+}
+
+std::optional<Value> Parser::postfix() {
+	auto result = primary();
+	if (!result) {
+		return std::nullopt;
+	}
+	space();
+	const auto ch = current();
+	if (ch != '%' && ch.unicode() != 0x2030) {
+		return result;
+	}
+	++_position;
+	if (!operation()) {
+		return std::nullopt;
+	}
+	auto number = result->number.Divide(Number::Integer(
+		(ch == '%') ? 100 : 1000));
+	return number
+		? std::make_optional(Value{ std::move(*number), true })
+		: std::nullopt;
+}
+
+std::optional<Value> Parser::primary() {
+	space();
+	if (take('(')) {
+		auto result = addition();
+		return (result && take(')')) ? std::move(result) : std::nullopt;
+	} else if (Letter(current())) {
+		return call();
+	}
+	auto number = literal();
+	return number
+		? std::make_optional(Value{ std::move(*number) })
+		: std::nullopt;
+}
+
+std::optional<Number> Parser::literal() {
+	const auto start = _position;
+	if (current() == '0' && _position + 1 < _text.size()) {
+		const auto next = _text[_position + 1].toLower();
+		const auto base = (next == 'x') ? 16
+			: (next == 'b') ? 2
+			: (next == 'o') ? 8
+			: 0;
+		if (base) {
+			_position += 2;
+			const auto from = _position;
+			while (DigitValue(current()) >= 0 && DigitValue(current()) < base) {
+				++_position;
+			}
+			return (_position > from)
+				? Number::Parse(_text.mid(from, _position - from), base)
+				: std::nullopt;
+		}
+	}
+	auto text = QString();
+	while (Digit(current())) {
+		text += current();
+		++_position;
+	}
+	const auto first = text.size();
+	auto separator = QChar();
+	if (first > 0 && first <= 3) {
+		while (_position < _text.size()) {
+			const auto ch = current();
+			if (ch != '_' && ch != ',' && !ch.isSpace()) {
+				break;
+			}
+			auto next = _position + 1;
+			if (ch.isSpace()) {
+				while (next < _text.size() && _text[next].isSpace()) {
+					++next;
+				}
+			}
+			const auto from = next;
+			while (next < _text.size() && Digit(_text[next])) {
+				++next;
+			}
+			if (next - from != 3) {
+				break;
+			} else if (ch == ',' && _callDepth) {
+				return std::nullopt;
+			} else if (!separator.isNull()
+				&& (separator.isSpace() ? !ch.isSpace() : ch != separator)) {
+				return std::nullopt;
+			}
+			separator = ch;
+			text += _text.mid(from, 3);
+			_position = next;
+		}
+	}
+	if (current() == '.') {
+		if (!first) {
+			return std::nullopt;
+		}
+		text += current();
+		++_position;
+		const auto from = _position;
+		while (Digit(current())) {
+			text += current();
+			++_position;
+		}
+		if (from == _position) {
+			return std::nullopt;
+		}
+	}
+	if (text.isEmpty() || text == QLatin1String(".")) {
+		return std::nullopt;
+	}
+	if (current() == 'e' || current() == 'E') {
+		text += current();
+		++_position;
+		if (current() == '+' || current() == '-') {
+			text += current();
+			++_position;
+		}
+		const auto from = _position;
+		while (Digit(current())) {
+			text += current();
+			++_position;
+		}
+		if (from == _position) {
+			return std::nullopt;
+		}
+	}
+	return (_position > start) ? Number::Parse(text) : std::nullopt;
+}
+
+std::optional<Value> Parser::call() {
+	const auto from = _position;
+	while (Letter(current()) || Digit(current()) || current() == '.') {
+		++_position;
+	}
+	const auto name = _text.mid(from, _position - from);
+	if (!take('(')) {
+		return std::nullopt;
+	}
+	const auto callDepth = Depth(_callDepth);
+	auto arguments = std::vector<Value>();
+	if (!take(')')) {
+		do {
+			if (arguments.size() >= kMaxArguments) {
+				return std::nullopt;
+			}
+			auto value = addition();
+			if (!value) {
+				return std::nullopt;
+			}
+			arguments.push_back(std::move(*value));
+		} while (take(','));
+		if (!take(')')) {
+			return std::nullopt;
+		}
+	}
+	if (arguments.empty() || !operation()) {
+		return std::nullopt;
+	}
+	const auto percent = std::any_of(
+		begin(arguments),
+		end(arguments),
+		[](const Value &value) { return value.percent; });
+	const auto count = arguments.size();
+	const auto &first = arguments.front().number;
+	auto number = std::optional<Number>();
+	if (name == QLatin1String("math.abs") && count == 1) {
+		number = first.Absolute();
+	} else if (name == QLatin1String("math.floor") && count == 1) {
+		number = first.Floor();
+	} else if (name == QLatin1String("math.ceil") && count == 1) {
+		number = first.Ceil();
+	} else if (name == QLatin1String("math.round") && count == 1) {
+		number = first.Round();
+	} else if (name == QLatin1String("math.min")
+		|| name == QLatin1String("math.max")) {
+		if (count < 2) {
+			return std::nullopt;
+		}
+		number = first;
+		const auto maximum = name == QLatin1String("math.max");
+		for (auto i = size_t(1); i < count; ++i) {
+			const auto &value = arguments[i].number;
+			if ((number->Compare(value) < 0) == maximum) {
+				number = value;
+			}
+		}
+	} else if (name == QLatin1String("math.sum")
+		|| name == QLatin1String("math.avg")) {
+		number = first;
+		for (auto i = size_t(1); number && i < count; ++i) {
+			if (!operation()) {
+				return std::nullopt;
+			}
+			number = number->Add(arguments[i].number);
+		}
+		if (number && name == QLatin1String("math.avg")) {
+			number = number->Divide(Number::Integer(qint64(count)));
+		}
+	} else if (name == QLatin1String("math.clamp") && count == 3) {
+		const auto &low = arguments[1].number;
+		const auto &high = arguments[2].number;
+		if (low.Compare(high) > 0) {
+			return std::nullopt;
+		}
+		number = (first.Compare(low) < 0)
+			? low
+			: (first.Compare(high) > 0)
+			? high
+			: first;
+	}
+	return number
+		? std::make_optional(Value{ std::move(*number), percent })
+		: std::nullopt;
+}
+
+}
+
+std::optional<LocalCalcNumber> ParseLocalCalcmulaNumber(const QString &query) {
+	return Parser(query).parse();
+}
+
+}
