diff --git a/Telegram/SourceFiles/tele/tele_calcmula_local_number.cpp b/Telegram/SourceFiles/tele/tele_calcmula_local_number.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e4a1c7479dffaf9d9f7096cacacfaef7ee99ea93
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_calcmula_local_number.cpp
@@ -0,0 +1,407 @@
+#include "tele/tele_calcmula_local_number.h"
+
+#include <openssl/bn.h>
+#include <cstdlib>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxBits = 4096;
+constexpr auto kMaxExponent = 1024;
+using Big = std::unique_ptr<BIGNUM, decltype(&BN_free)>;
+using Context = std::unique_ptr<BN_CTX, decltype(&BN_CTX_free)>;
+
+[[nodiscard]] Big NewBig() {
+	return Big(BN_new(), BN_free);
+}
+
+[[nodiscard]] Big Copy(const BIGNUM *value) {
+	return Big(BN_dup(value), BN_free);
+}
+
+[[nodiscard]] Context NewContext() {
+	return Context(BN_CTX_new(), BN_CTX_free);
+}
+
+[[nodiscard]] Big TenPower(int power) {
+	auto result = NewBig();
+	BN_one(result.get());
+	for (auto i = 0; i != power; ++i) {
+		BN_mul_word(result.get(), 10);
+	}
+	return result;
+}
+
+[[nodiscard]] QString Decimal(const BIGNUM *value) {
+	const auto free = [](char *value) { OPENSSL_free(value); };
+	const auto raw = std::unique_ptr<char, decltype(free)>(
+		BN_bn2dec(value),
+		free);
+	return QString::fromLatin1(raw.get());
+}
+
+[[nodiscard]] QString Group(QString text) {
+	for (auto i = text.size() - 3; i > 0; i -= 3) {
+		text.insert(i, QChar(','));
+	}
+	return text;
+}
+
+[[nodiscard]] Big RoundedQuotient(const BIGNUM *numerator, const BIGNUM *denominator) {
+	auto result = NewBig();
+	auto remainder = NewBig();
+	auto context = NewContext();
+	BN_div(result.get(), remainder.get(), numerator, denominator, context.get());
+	BN_lshift1(remainder.get(), remainder.get());
+	if (BN_cmp(remainder.get(), denominator) >= 0) {
+		BN_add_word(result.get(), 1);
+	}
+	return result;
+}
+
+}
+
+struct LocalCalcNumber::Value {
+	Big numerator = NewBig();
+	Big denominator = NewBig();
+
+	Value() {
+		BN_one(denominator.get());
+	}
+};
+
+LocalCalcNumber::LocalCalcNumber(std::shared_ptr<const Value> value)
+: _value(std::move(value)) {
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Make(
+		std::shared_ptr<Value> value) {
+	auto n = value->numerator.get();
+	auto d = value->denominator.get();
+	if (BN_is_zero(d)
+		|| BN_num_bits(n) > kMaxBits
+		|| BN_num_bits(d) > kMaxBits) {
+		return std::nullopt;
+	}
+	if (BN_is_negative(d)) {
+		BN_set_negative(d, 0);
+		BN_set_negative(n, !BN_is_negative(n));
+	}
+	auto context = NewContext();
+	auto divisor = NewBig();
+	BN_gcd(divisor.get(), n, d, context.get());
+	BN_div(n, nullptr, n, divisor.get(), context.get());
+	BN_div(d, nullptr, d, divisor.get(), context.get());
+	return LocalCalcNumber(std::move(value));
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Parse(
+		const QString &text,
+		int base) {
+	if (text.isEmpty() || text.size() > 1024
+		|| (base != 2 && base != 8 && base != 10 && base != 16)) {
+		return std::nullopt;
+	}
+	auto value = std::make_shared<Value>();
+	auto n = value->numerator.get();
+	auto digits = text;
+	const auto negative = digits.startsWith(QChar('-'));
+	if (negative || digits.startsWith(QChar('+'))) {
+		digits.remove(0, 1);
+	}
+	auto scale = 0;
+	if (base == 10) {
+		const auto e = digits.indexOf(QChar('e'), 0, Qt::CaseInsensitive);
+		if (e >= 0) {
+			auto ok = false;
+			const auto exponent = digits.mid(e + 1).toInt(&ok);
+			if (!ok || exponent < -kMaxExponent || exponent > kMaxExponent) {
+				return std::nullopt;
+			}
+			scale = -exponent;
+			digits.truncate(e);
+		}
+		const auto point = digits.indexOf(QChar('.'));
+		if (point >= 0) {
+			scale += digits.size() - point - 1;
+			digits.remove(point, 1);
+		}
+	}
+	if (digits.isEmpty() || std::abs(scale) > kMaxExponent) {
+		return std::nullopt;
+	}
+	for (const auto ch : digits) {
+		const auto c = ch.toLower().unicode();
+		const auto digit = (c >= '0' && c <= '9')
+			? c - '0'
+			: (c >= 'a' && c <= 'f') ? c - 'a' + 10 : 16;
+		if (digit >= base) {
+			return std::nullopt;
+		}
+		BN_mul_word(n, base);
+		BN_add_word(n, digit);
+		if (BN_num_bits(n) > kMaxBits) {
+			return std::nullopt;
+		}
+	}
+	if (scale > 0) {
+		value->denominator = TenPower(scale);
+	} else if (scale < 0) {
+		auto multiplier = TenPower(-scale);
+		auto context = NewContext();
+		BN_mul(n, n, multiplier.get(), context.get());
+	}
+	BN_set_negative(n, negative);
+	return Make(std::move(value));
+}
+
+LocalCalcNumber LocalCalcNumber::Integer(qint64 value) {
+	return *Parse(QString::number(value));
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Add(
+		const LocalCalcNumber &other) const {
+	auto value = std::make_shared<Value>();
+	auto context = NewContext();
+	auto right = NewBig();
+	BN_mul(
+		value->numerator.get(),
+		_value->numerator.get(),
+		other._value->denominator.get(),
+		context.get());
+	BN_mul(
+		right.get(),
+		other._value->numerator.get(),
+		_value->denominator.get(),
+		context.get());
+	BN_add(value->numerator.get(), value->numerator.get(), right.get());
+	BN_mul(
+		value->denominator.get(),
+		_value->denominator.get(),
+		other._value->denominator.get(),
+		context.get());
+	return Make(std::move(value));
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Subtract(
+		const LocalCalcNumber &other) const {
+	return Add(other.Negated());
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Multiply(
+		const LocalCalcNumber &other) const {
+	auto value = std::make_shared<Value>();
+	auto context = NewContext();
+	BN_mul(
+		value->numerator.get(),
+		_value->numerator.get(),
+		other._value->numerator.get(),
+		context.get());
+	BN_mul(
+		value->denominator.get(),
+		_value->denominator.get(),
+		other._value->denominator.get(),
+		context.get());
+	return Make(std::move(value));
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Divide(
+		const LocalCalcNumber &other) const {
+	if (other.IsZero()) {
+		return std::nullopt;
+	}
+	auto value = std::make_shared<Value>();
+	auto context = NewContext();
+	BN_mul(
+		value->numerator.get(),
+		_value->numerator.get(),
+		other._value->denominator.get(),
+		context.get());
+	BN_mul(
+		value->denominator.get(),
+		_value->denominator.get(),
+		other._value->numerator.get(),
+		context.get());
+	return Make(std::move(value));
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Power(
+		const LocalCalcNumber &other) const {
+	const auto exponent = other.ToInteger();
+	if (!exponent || *exponent < -kMaxExponent || *exponent > kMaxExponent
+		|| (IsZero() && *exponent < 0)) {
+		return std::nullopt;
+	}
+	const auto count = std::abs(*exponent);
+	if (count * BN_num_bits(_value->numerator.get()) > kMaxBits
+		|| count * BN_num_bits(_value->denominator.get()) > kMaxBits) {
+		return std::nullopt;
+	}
+	auto value = std::make_shared<Value>();
+	auto context = NewContext();
+	auto power = NewBig();
+	BN_set_word(power.get(), count);
+	BN_exp(
+		value->numerator.get(),
+		_value->numerator.get(),
+		power.get(),
+		context.get());
+	BN_exp(
+		value->denominator.get(),
+		_value->denominator.get(),
+		power.get(),
+		context.get());
+	if (*exponent < 0) {
+		value->numerator.swap(value->denominator);
+	}
+	return Make(std::move(value));
+}
+
+std::optional<LocalCalcNumber> LocalCalcNumber::Modulo(
+		const LocalCalcNumber &other) const {
+	const auto ratio = Divide(other);
+	if (!ratio) {
+		return std::nullopt;
+	}
+	const auto product = ratio->Floor().Multiply(other);
+	return product ? Subtract(*product) : std::nullopt;
+}
+
+LocalCalcNumber LocalCalcNumber::Negated() const {
+	auto value = std::make_shared<Value>();
+	value->numerator = Copy(_value->numerator.get());
+	value->denominator = Copy(_value->denominator.get());
+	BN_set_negative(
+		value->numerator.get(),
+		!BN_is_negative(value->numerator.get()));
+	return LocalCalcNumber(std::move(value));
+}
+
+LocalCalcNumber LocalCalcNumber::Absolute() const {
+	return BN_is_negative(_value->numerator.get()) ? Negated() : *this;
+}
+
+LocalCalcNumber LocalCalcNumber::Rounded(int direction) const {
+	auto value = std::make_shared<Value>();
+	auto context = NewContext();
+	auto remainder = NewBig();
+	const auto negative = BN_is_negative(_value->numerator.get());
+	BN_div(
+		value->numerator.get(),
+		remainder.get(),
+		_value->numerator.get(),
+		_value->denominator.get(),
+		context.get());
+	if (!BN_is_zero(remainder.get())) {
+		BN_set_negative(remainder.get(), 0);
+		BN_lshift1(remainder.get(), remainder.get());
+		if ((direction < 0 && negative)
+			|| (direction > 0 && !negative)
+			|| (!direction && BN_cmp(
+				remainder.get(),
+				_value->denominator.get()) >= (negative ? 1 : 0))) {
+			BN_set_negative(value->numerator.get(), 0);
+			BN_add_word(value->numerator.get(), 1);
+			BN_set_negative(value->numerator.get(), negative);
+		}
+	}
+	return LocalCalcNumber(std::move(value));
+}
+
+LocalCalcNumber LocalCalcNumber::Floor() const {
+	return Rounded(-1);
+}
+
+LocalCalcNumber LocalCalcNumber::Ceil() const {
+	return Rounded(1);
+}
+
+LocalCalcNumber LocalCalcNumber::Round() const {
+	return Rounded(0);
+}
+
+std::optional<qint64> LocalCalcNumber::ToInteger() const {
+	if (!IsInteger()) {
+		return std::nullopt;
+	}
+	auto ok = false;
+	const auto result = Decimal(_value->numerator.get()).toLongLong(&ok);
+	return ok ? std::make_optional(result) : std::nullopt;
+}
+
+int LocalCalcNumber::Compare(const LocalCalcNumber &other) const {
+	auto left = NewBig();
+	auto right = NewBig();
+	auto context = NewContext();
+	BN_mul(
+		left.get(),
+		_value->numerator.get(),
+		other._value->denominator.get(),
+		context.get());
+	BN_mul(
+		right.get(),
+		other._value->numerator.get(),
+		_value->denominator.get(),
+		context.get());
+	return BN_cmp(left.get(), right.get());
+}
+
+bool LocalCalcNumber::IsZero() const {
+	return BN_is_zero(_value->numerator.get());
+}
+
+bool LocalCalcNumber::IsInteger() const {
+	return BN_is_one(_value->denominator.get());
+}
+
+QString LocalCalcNumber::Format() const {
+	if (IsZero()) {
+		return u"0"_q;
+	}
+	auto numerator = Copy(_value->numerator.get());
+	BN_set_negative(numerator.get(), 0);
+	const auto denominator = _value->denominator.get();
+	const auto negative = BN_is_negative(_value->numerator.get());
+	const auto prefix = negative ? u"-"_q : QString();
+	auto scaled = NewBig();
+	auto context = NewContext();
+	const auto million = TenPower(6);
+	BN_mul(scaled.get(), numerator.get(), million.get(), context.get());
+	auto rounded = RoundedQuotient(scaled.get(), denominator);
+	if (!BN_is_zero(rounded.get())) {
+		auto digits = Decimal(rounded.get()).rightJustified(7, QChar('0'));
+		auto fraction = digits.right(6);
+		while (fraction.endsWith(QChar('0'))) {
+			fraction.chop(1);
+		}
+		return prefix + Group(digits.left(digits.size() - 6))
+			+ (fraction.isEmpty() ? QString() : QChar('.') + fraction);
+	}
+	auto exponent = Decimal(numerator.get()).size()
+		- Decimal(denominator).size();
+	auto multiplier = TenPower(-exponent);
+	BN_mul(scaled.get(), numerator.get(), multiplier.get(), context.get());
+	if (BN_cmp(scaled.get(), denominator) < 0) {
+		--exponent;
+	}
+	if (exponent < -300) {
+		return QString();
+	}
+	multiplier = TenPower(6 - exponent);
+	BN_mul(scaled.get(), numerator.get(), multiplier.get(), context.get());
+	rounded = RoundedQuotient(scaled.get(), denominator);
+	auto digits = Decimal(rounded.get());
+	if (digits.size() > 7) {
+		++exponent;
+		digits.chop(1);
+	}
+	auto fraction = digits.mid(1);
+	while (fraction.endsWith(QChar('0'))) {
+		fraction.chop(1);
+	}
+	return prefix + digits.left(1)
+		+ (fraction.isEmpty() ? QString() : QChar('.') + fraction)
+		+ QChar('e') + QString::number(exponent);
+}
+
+}
