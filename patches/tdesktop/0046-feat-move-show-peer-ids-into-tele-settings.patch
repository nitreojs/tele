From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 18:32:59 +0300
Subject: [PATCH] feat: move show peer ids into tele settings

---
 Telegram/SourceFiles/settings/settings_experimental.cpp | 1 -
 Telegram/SourceFiles/settings/settings_tele.cpp         | 2 ++
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/settings/settings_experimental.cpp b/Telegram/SourceFiles/settings/settings_experimental.cpp
index 04815cbdb95ace9f2bec778638a9c2a88fabcd3e..330c321e8ea6a87c6083da763eaa530f308ccd08 100644
--- a/Telegram/SourceFiles/settings/settings_experimental.cpp
+++ b/Telegram/SourceFiles/settings/settings_experimental.cpp
@@ -416,7 +416,6 @@ void SetupExperimental(
 			u"Profile"_q,
 			{
 				Window::kOptionViewProfileInChatsListContextMenu,
-				Info::Profile::kOptionShowPeerIdBelowAbout,
 				Info::Profile::kOptionShowChannelJoinedBelowAbout,
 				Info::Profile::kOptionProfileMediaTabs,
 				Info::Profile::kOptionProfileMediaTabsExpanded,
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index fa798e0af6ab33bed7d8a0846bd1ba58fb5d8d85..6ff5002ffe93f9c994848705b247fd2499f59408 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -10,6 +10,7 @@
 #include "data/data_session.h"
 #include "data/data_user.h"
 #include "history/history.h"
+#include "info/profile/info_profile_actions.h"
 #include "lang/lang_keys.h"
 #include "main/main_session.h"
 #include "settings/sections/settings_main.h"
@@ -1001,6 +1002,7 @@ void FillPrivacy(SectionBuilder &builder) {
 
 void FillProfiles(SectionBuilder &builder) {
 	builder.addSkip();
+	AddOptionToggle(builder, ::Info::Profile::kOptionShowPeerIdBelowAbout);
 	AddOptionToggle(builder, ::Tele::kOptionPeerIdsWithoutSpaces);
 	AddOptionToggle(builder, ::Tele::kOptionBotApiPeerIds);
 	AddOptionToggle(builder, ::Tele::kOptionShowDc);
