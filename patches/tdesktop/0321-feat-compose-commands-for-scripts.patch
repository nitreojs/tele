+std::vector<ScriptCommandRow> ScriptCommands(not_null<PeerData*> peer) {
+	const auto host = Host::Find(&peer->session());
+	return host ? host->commands(peer) : std::vector<ScriptCommandRow>();
+}
+
+[[nodiscard]] Fn<void(TextWithTags)> FieldSetter(
+		not_null<Ui::InputField*> field) {
+	const auto weak = QPointer<Ui::InputField>(field.get());
+	return [=](TextWithTags text) {
+		if (const auto strong = weak.data()) {
+			const auto size = int(text.text.size());
+			strong->setTextWithTags(std::move(text));
+			strong->setCursorPosition(size);
+			strong->setFocus();
+		}
+	};
+}
+
+bool RunTypedCommand(
+		not_null<PeerData*> peer,
+		not_null<Ui::InputField*> field) {
+	static const auto expression = QRegularExpression(
+		u"^/([A-Za-z0-9_]{1,32})(?:\\s+(.*))?$"_q,
+		QRegularExpression::DotMatchesEverythingOption);
+	const auto host = Host::Find(&peer->session());
+	if (!host) {
+		return false;
+	}
+	const auto full = field->getTextWithTags().text.trimmed();
+	const auto match = expression.match(full);
+	if (!match.hasMatch()) {
+		return false;
+	}
+	const auto name = match.captured(1).toLower();
+	const auto known = ranges::any_of(host->commands(peer), [&](
+			const ScriptCommandRow &row) {
+		return row.name == name;
+	});
+	if (!known) {
+		return false;
+	}
+	field->clear();
+	return host->runCommand(
+		peer,
+		name,
+		match.captured(2).trimmed(),
+		full,
+		FieldSetter(field));
+}
+
+bool ChooseScriptCommand(
+		not_null<PeerData*> peer,
+		not_null<Ui::InputField*> field,
+		const QString &command) {
+	const auto host = Host::Find(&peer->session());
+	if (!host || !command.startsWith('/')) {
+		return false;
+	}
+	const auto name = command.mid(1).toLower();
+	const auto rows = host->commands(peer);
+	const auto i = ranges::find(rows, name, &ScriptCommandRow::name);
+	if (i == end(rows)) {
+		return false;
+	} else if (!i->args.isEmpty()) {
+		field->insertTag(command);
+		return true;
+	}
+	field->setTextWithTags(
+		field->getTextWithTagsPart(field->textCursor().position()));
+	return host->runCommand(peer, name, QString(), command, FieldSetter(field));
+}
