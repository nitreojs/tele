+JSValue Instance::NativeCommand(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.registerCommand needs an options object");
+	}
+	const auto options = argv[0];
+	auto name = StringProperty(ctx, options, "name");
+	if (name.startsWith('/')) {
+		name = name.mid(1);
+	}
+	static const auto valid = QRegularExpression(u"^[a-z0-9_]{1,32}$"_q);
+	if (!valid.match(name).hasMatch()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.registerCommand: the name must be 1 to 32 of a-z, 0-9 and _");
+	}
+	auto chats = std::vector<std::string>();
+	auto list = JS_GetPropertyStr(ctx, options, "chats");
+	auto length = std::int64_t();
+	if (JS_IsString(list)) {
+		chats.push_back(ToStd(ctx, list));
+	} else if (JS_IsArray(list) && JS_GetLength(ctx, list, &length) >= 0) {
+		for (auto i = std::int64_t(); i != length; ++i) {
+			auto item = JS_GetPropertyUint32(ctx, list, std::uint32_t(i));
+			chats.push_back(ToStd(ctx, item));
+			JS_FreeValue(ctx, item);
+		}
+	} else if (!JS_IsUndefined(list)) {
+		JS_FreeValue(ctx, list);
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.registerCommand: chats is 'all', 'private', 'groups', "
+			"'channels' or an array of them");
+	}
+	JS_FreeValue(ctx, list);
+	for (const auto &chat : chats) {
+		if (chat != "all" && chat != "private" && chat != "groups" && chat != "channels") {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.registerCommand: unknown chats '%s'",
+				chat.c_str());
+		}
+	}
+	auto run = JS_GetPropertyStr(ctx, options, "run");
+	if (!JS_IsFunction(ctx, run)) {
+		JS_FreeValue(ctx, run);
+		return JS_ThrowTypeError(ctx, "tg.registerCommand needs a run function");
+	}
+	const auto &registrations = instance->_registrations;
+	const auto commands = ranges::count_if(registrations, [](const auto &pair) {
+		return pair.second.kind == Kind::Command;
+	});
+	const auto taken = ranges::any_of(registrations, [&](const auto &pair) {
+		return pair.second.kind == Kind::Command && pair.second.key == name;
+	});
+	if (taken || commands >= kMaxCommands) {
+		JS_FreeValue(ctx, run);
+		return taken
+			? JS_ThrowTypeError(
+				ctx,
+				"tg.registerCommand: /%s is already registered",
+				name.toUtf8().constData())
+			: ThrowTeleError(
+				ctx,
+				"quota-exceeded",
+				u"tg.registerCommand: at most 50 commands per script"_q);
+	}
+	const auto id = NextRegistrationId();
+	instance->_registrations.emplace(id, Registration{
+		.kind = Kind::Command,
+		.keys = std::move(chats),
+		.fn = run,
+		.key = name,
+		.text = StringProperty(ctx, options, "description"),
+		.extra = StringProperty(ctx, options, "args"),
+	});
+	if (instance->_changed) {
+		instance->_changed();
+	}
+	return instance->disposer(id);
+}
+
+std::vector<ScriptCommand> Instance::commands(not_null<PeerData*> peer) const {
+	auto result = std::vector<ScriptCommand>();
+	if (!_started) {
+		return result;
+	}
+	const auto kind = peer->isUser()
+		? "private"
+		: peer->isBroadcast()
+		? "channels"
+		: "groups";
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind != Kind::Command) {
+			continue;
+		}
+		const auto &chats = registration.keys;
+		const auto fits = chats.empty()
+			|| ranges::contains(chats, std::string("all"))
+			|| ranges::contains(chats, std::string(kind));
+		if (fits) {
+			result.push_back({
+				.id = id,
+				.name = registration.key,
+				.description = registration.text,
+				.args = registration.extra,
+			});
+		}
+	}
+	return result;
+}
+
+void Instance::runCommand(
+		int id,
+		QString args,
+		QString full,
+		not_null<PeerData*> peer,
+		Fn<void(TextWithTags)> setText,
+		Fn<void(std::optional<TextWithTags>, bool)> done) {
+	const auto i = _registrations.find(id);
+	if (!_engine || !_started || i == end(_registrations)) {
+		done(std::nullopt, true);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	const auto where = u"command /%1"_q.arg(i->second.key);
+	const auto key = ++_commandRunKey;
+	_commandRuns.emplace(key, CommandRun{
+		.setText = std::move(setText),
+		.done = std::move(done),
+		.where = where,
+	});
+	auto context = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, context, "chat", peerInfo(peer));
+	JS_SetPropertyStr(
+		ctx,
+		context,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(peer->id)));
+	JS_SetPropertyStr(ctx, context, "text", NewString(ctx, full));
+	JS_SetPropertyStr(
+		ctx,
+		context,
+		"setText",
+		JS_NewCFunctionMagic(
+			ctx,
+			CommandSetText,
+			"setText",
+			1,
+			JS_CFUNC_generic_magic,
+			key));
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleRunCommand");
+	JS_FreeValue(ctx, global);
+	auto fn = JS_DupValue(ctx, i->second.fn);
+	auto value = NewString(ctx, args);
+	JSValueConst call[] = { fn, value, context };
+	auto promise = invoke(runner, call, kListenerBudget, where);
+	for (const auto item : { runner, fn, value, context }) {
+		JS_FreeValue(ctx, item);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishCommand(key, std::nullopt, true);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, CommandSettled, key));
+	_engine->drain();
+	if (!_commandRuns.contains(key)) {
+		return;
+	}
+	base::call_delayed(kCommandBudget, this, [=] {
+		if (_commandRuns.contains(key)) {
+			fault(where, u"took longer than 60 s"_q);
+			finishCommand(key, std::nullopt, true);
+		}
+	});
+}
+
+JSValue Instance::CommandSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	const auto i = instance->_commandRuns.find(key);
+	if (i == end(instance->_commandRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto where = i->second.where;
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(where, instance->_engine->describe(value));
+		instance->finishCommand(key, std::nullopt, true);
+	} else if (JS_IsNull(value) || JS_IsUndefined(value)) {
+		instance->finishCommand(key, std::nullopt, false);
+	} else {
+		auto text = instance->textFromValue(value, where);
+		instance->finishCommand(key, std::move(text), !text);
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::CommandSetText(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto i = instance->_commandRuns.find(magic);
+	if (i == end(instance->_commandRuns)) {
+		return ThrowTeleError(
+			ctx,
+			"handle-expired",
+			u"ctx.setText was called after the command finished"_q);
+	}
+	auto text = instance->textFromValue(
+		(argc > 0) ? argv[0] : JS_UNDEFINED,
+		i->second.where);
+	if (!text) {
+		return JS_ThrowTypeError(ctx, "ctx.setText takes a string or { text, entities }");
+	}
+	i->second.setText(std::move(*text));
+	return JS_UNDEFINED;
+}
+
+void Instance::finishCommand(
+		int key,
+		std::optional<TextWithTags> text,
+		bool failed) {
+	const auto i = _commandRuns.find(key);
+	if (i == end(_commandRuns)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	_commandRuns.erase(i);
+	done(std::move(text), failed);
+}
