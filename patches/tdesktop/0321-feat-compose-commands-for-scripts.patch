+	[[nodiscard]] bool runCommand(
+			not_null<PeerData*> peer,
+			const QString &name,
+			const QString &args,
+			const QString &full,
+			Fn<void(TextWithTags)> setText) {
+		for (const auto &entry : _entries) {
+			const auto instance = entry.instance.get();
+			if (!instance) {
+				continue;
+			}
+			for (const auto &command : instance->commands(peer)) {
+				if (command.name != name) {
+					continue;
+				}
+				const auto weak = base::make_weak(this);
+				const auto history = peer->owner().history(peer);
+				instance->runCommand(command.id, args, full, peer, setText, [=](
+						std::optional<TextWithTags> text,
+						bool failed) {
+					crl::on_main(weak, [=] {
+						if (failed) {
+							setText(TextWithTags{ full });
+						} else if (text && !text->text.trimmed().isEmpty()) {
+							auto message = Api::MessageToSend(
+								Api::SendAction(history));
+							message.textWithTags = *text;
+							_session->api().sendMessage(std::move(message));
+						}
+					});
+				});
+				return true;
+			}
+		}
