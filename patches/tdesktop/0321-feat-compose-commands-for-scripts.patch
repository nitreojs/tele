+std::optional<TextWithTags> Instance::textFromValue(
+		JSValueConst value,
+		const QString &where) {
+	const auto ctx = _engine->ctx();
+	if (JS_IsString(value)) {
+		return TextWithTags{ FromStd(ToStd(ctx, value)) };
+	} else if (!JS_IsObject(value)) {
+		return std::nullopt;
+	}
+	auto body = JS_GetPropertyStr(ctx, value, "text");
+	auto list = JS_GetPropertyStr(ctx, value, "entities");
+	const auto text = FromStd(ToStd(ctx, body));
+	JS_FreeValue(ctx, body);
+	auto tags = TextWithTags::Tags();
+	if (JS_IsArray(list)) {
+		auto encoded = EncodeTl(ctx, list, "Vector<MessageEntity>");
+		auto entities = MTPVector<MTPMessageEntity>();
+		auto from = reinterpret_cast<const mtpPrime*>(encoded.bytes.data());
+		const auto till = from + (encoded.bytes.size() / sizeof(mtpPrime));
+		if (!encoded.error.empty() || !entities.read(from, till)) {
+			JS_FreeValue(ctx, list);
+			fault(where, u"the entities are wrong: "_q + FromStd(encoded.error));
+			return std::nullopt;
+		}
+		tags = TextUtilities::ConvertEntitiesToTextTags(
+			Api::EntitiesFromMTP(_session, entities.v));
+	}
+	JS_FreeValue(ctx, list);
+	return TextWithTags{ text, std::move(tags) };
+}
