+void AddLocalDrafts(SectionBuilder &builder) {
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionLocalDrafts,
+		{ u"cloud"_q, u"sync"_q });
+	const auto controller = builder.controller();
+	const auto session = builder.session();
+	const auto id = u"tele-clear-cloud-drafts"_q;
+	const auto button = builder.addButton({
+		.id = id,
+		.title = rpl::single(::Tele::Lower(u"Clear drafts in the cloud"_q)),
+		.st = &st::settingsButtonNoIcon,
+		.onClick = [=] {
+			controller->show(Ui::MakeConfirmBox({
+				.text = ::Tele::Lower(u"Delete all drafts saved in the "
+					"cloud? Other devices lose them, drafts on this device "
+					"are kept."_q),
+				.confirmed = [=](Fn<void()> close) {
+					::Tele::ClearCloudDrafts(session, crl::guard(controller, [=](
+							QString text) {
+						controller->showToast(text);
+					}));
+					close();
+				},
+				.confirmText = ::Tele::Lower(u"Clear"_q),
+				.confirmStyle = &st::attentionBoxButton,
+			}));
+		},
+		.keywords = { u"cloud"_q, u"drafts"_q, u"delete"_q },
+		.shown = ::Tele::LocalDraftsValue(),
+	});
+	if (button) {
+		SetupLink(button, id);
+		::Tele::LocalDraftsValue(
+		) | rpl::skip(1) | rpl::filter([](bool on) {
+			return on;
+		}) | rpl::on_next([] {
+			::Tele::PersistLocalDrafts();
+		}, button->lifetime());
+	}
+}
