@@ -0,0 +1,116 @@
+#include "tele/tele_local_drafts.h"
+
+#include "apiwrap.h"
+#include "core/application.h"
+#include "data/data_channel.h"
+#include "data/data_drafts.h"
+#include "data/data_session.h"
+#include "data/data_thread.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+void PersistHistory(not_null<History*> history) {
+	if (history->draftsMap().empty()) {
+		return;
+	}
+	auto &local = history->session().local();
+	local.readDraftsWithCursors(history);
+	local.writeDrafts(history);
+	local.writeDraftCursors(history);
+}
+
+void PersistSession(not_null<Main::Session*> session) {
+	const auto data = &session->data();
+	const auto persist = [=](auto peer) {
+		if (const auto history = data->historyLoaded(peer->id)) {
+			PersistHistory(history);
+		}
+	};
+	data->enumerateUsers(persist);
+	data->enumerateGroups(persist);
+	data->enumerateBroadcasts(persist);
+}
+
+} // namespace
+
+void PersistLocalDrafts() {
+	if (!Core::IsAppLaunched() || !LocalDrafts()) {
+		return;
+	}
+	Core::App().materializeLocalDrafts();
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		if (const auto session = account->maybeSession()) {
+			if (!session->supportMode()) {
+				PersistSession(session);
+			}
+		}
+	}
+}
+
+void RestoreLocalDrafts(not_null<History*> history) {
+	auto &local = history->session().local();
+	if (!LocalDrafts()
+		|| history->session().supportMode()
+		|| !history->draftsMap().empty()
+		|| !local.hasDraft(history->peer->id)) {
+		return;
+	}
+	local.readDraftsWithCursors(history);
+	auto keys = std::vector<Data::DraftKey>();
+	for (const auto &[key, draft] : history->draftsMap()) {
+		if (key.isLocal() && !Data::DraftIsNull(draft.get())) {
+			keys.push_back(key);
+		}
+	}
+	for (const auto key : keys) {
+		const auto topicRootId = key.topicRootId();
+		const auto monoforumPeerId = key.monoforumPeerId();
+		const auto draft = history->draft(key);
+		if (!draft || history->cloudDraft(topicRootId, monoforumPeerId)) {
+			continue;
+		}
+		auto mirror = std::make_unique<Data::Draft>(
+			draft->textWithTags,
+			draft->reply,
+			draft->suggest,
+			MessageCursor(),
+			draft->webpage);
+		mirror->reply.topicRootId = topicRootId;
+		mirror->reply.monoforumPeerId = monoforumPeerId;
+		history->setDraft(
+			Data::DraftKey::Cloud(topicRootId, monoforumPeerId),
+			std::move(mirror));
+		if (const auto thread = history->threadFor(
+				topicRootId,
+				monoforumPeerId)) {
+			thread->updateChatListSortPosition();
+		}
+	}
+}
+
+void ClearCloudDrafts(
+		not_null<Main::Session*> session,
+		Fn<void(QString)> done) {
+	if (!LocalDrafts()) {
+		return;
+	}
+	Core::App().materializeLocalDrafts();
+	PersistSession(session);
+	session->api().request(MTPmessages_ClearAllDrafts(
+	)).done([=] {
+		done(Lower(u"Cloud drafts cleared, drafts on this device are kept."_q));
+	}).fail([=](const MTP::Error &error) {
+		done(Lower(u"Couldn't clear cloud drafts: "_q) + error.type());
+	}).send();
+}
+
+} // namespace Tele
