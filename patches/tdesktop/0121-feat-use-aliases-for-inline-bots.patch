@@ -81,5 +81,8 @@ void ReplaceUsernameAliases(
 	not_null<History*> history,
 	TextWithEntities &text);
 [[nodiscard]] QString NormalizeUsernameAliases(const QString &value);
+[[nodiscard]] QString InlineBotUsername(
+	not_null<Main::Session*> session,
+	const QString &username);
 
 } // namespace Tele
