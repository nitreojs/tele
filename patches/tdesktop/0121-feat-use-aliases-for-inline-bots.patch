diff --git a/Telegram/SourceFiles/tele/tele_username_aliases.cpp b/Telegram/SourceFiles/tele/tele_username_aliases.cpp
index 4097a15e7d9827731de3cd3f0a511339c42852e7..c88f7f638eac3abd0a98032f968dde680dfd130b 100644
--- a/Telegram/SourceFiles/tele/tele_username_aliases.cpp
+++ b/Telegram/SourceFiles/tele/tele_username_aliases.cpp
@@ -967,4 +967,16 @@ QString NormalizeUsernameAliases(const QString &value) {
 	return Serialize(production, test);
 }
 
+QString InlineBotUsername(
+		not_null<Main::Session*> session,
+		const QString &username) {
+	if (const auto id = AliasPeerId(session, username)) {
+		const auto peer = LoadedPeer(session, id);
+		const auto real = peer ? PublicUsername(peer) : QString();
+		return real.isEmpty() ? username : real;
+	}
+	const auto target = ServerTarget(session, username);
+	return target.isEmpty() ? username : target;
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_username_aliases.h b/Telegram/SourceFiles/tele/tele_username_aliases.h
