diff --git a/Telegram/SourceFiles/tele/tele_sealed_auto_mode.h b/Telegram/SourceFiles/tele/tele_sealed_auto_mode.h
new file mode 100644
index 0000000000000000000000000000000000000000..821aabfeecd8853cc71b88cd3a5889ebafc77764
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_auto_mode.h
@@ -0,0 +1,139 @@
+#pragma once
+
+#include <QtCore/QByteArray>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QString>
+
+#include <map>
+#include <tuple>
+
+namespace Tele {
+
+inline constexpr auto kSealedAutomaticChatLimit = 1024;
+inline constexpr auto kSealedAutomaticOptionLimit = 512 * 1024;
+
+struct SealedAutomaticChatId {
+	bool test = false;
+	quint64 account = 0;
+	quint64 peer = 0;
+
+	friend bool operator<(const SealedAutomaticChatId &a, const SealedAutomaticChatId &b) {
+		return std::tie(a.test, a.account, a.peer) < std::tie(b.test, b.account, b.peer);
+	}
+	friend bool operator==(const SealedAutomaticChatId&, const SealedAutomaticChatId&) = default;
+};
+
+struct SealedAutomaticBinding {
+	QByteArray own;
+	QByteArray remote;
+
+	friend bool operator==(const SealedAutomaticBinding&, const SealedAutomaticBinding&) = default;
+};
+
+struct SealedAutomaticPlan {
+	bool valid = true;
+	std::map<SealedAutomaticChatId, SealedAutomaticBinding> chats;
+};
+
+[[nodiscard]] inline SealedAutomaticPlan ParseSealedAutomaticPlan(const QString &value) {
+	auto result = SealedAutomaticPlan();
+	if (value.isEmpty()) {
+		return result;
+	}
+	result.valid = false;
+	if (value.size() > kSealedAutomaticOptionLimit) {
+		return result;
+	}
+	const auto bytes = value.toUtf8();
+	if (bytes.size() > kSealedAutomaticOptionLimit || QString::fromUtf8(bytes) != value) {
+		return result;
+	}
+	const auto document = QJsonDocument::fromJson(bytes);
+	if (!document.isObject()) {
+		return result;
+	}
+	const auto object = document.object();
+	if (object.size() != 2 || object.value(QStringLiteral("version")).toDouble() != 1.
+		|| !object.value(QStringLiteral("chats")).isArray()) {
+		return result;
+	}
+	const auto array = object.value(QStringLiteral("chats")).toArray();
+	if (array.size() > kSealedAutomaticChatLimit) {
+		return result;
+	}
+	const auto number = [](const QJsonValue &value) {
+		if (!value.isString()) return quint64();
+		const auto text = value.toString();
+		auto valid = false;
+		const auto result = text.toULongLong(&valid);
+		return valid && result > 0 && result <= 0xFFFFFFFFFFFFULL
+			&& QString::number(result) == text ? result : quint64();
+	};
+	const auto digest = [](const QJsonValue &value) {
+		const auto text = value.isString() ? value.toString() : QString();
+		const auto decoded = QByteArray::fromHex(text.toLatin1());
+		return decoded.size() == 64 && QString::fromLatin1(decoded.toHex()) == text
+			? decoded : QByteArray();
+	};
+	for (const auto &entry : array) {
+		if (!entry.isObject()) return result;
+		const auto row = entry.toObject();
+		const auto id = SealedAutomaticChatId{
+			.test = row.value(QStringLiteral("test")).toBool(),
+			.account = number(row.value(QStringLiteral("account"))),
+			.peer = number(row.value(QStringLiteral("peer"))),
+		};
+		const auto binding = SealedAutomaticBinding{
+			.own = digest(row.value(QStringLiteral("own"))),
+			.remote = digest(row.value(QStringLiteral("remote"))),
+		};
+		if (row.size() != 5 || !row.value(QStringLiteral("test")).isBool()
+			|| !id.account || !id.peer || binding.own.isEmpty() || binding.remote.isEmpty()
+			|| !result.chats.emplace(id, binding).second) {
+			return result;
+		}
+	}
+	result.valid = true;
+	return result;
+}
+
+[[nodiscard]] inline QString EncodeSealedAutomaticPlan(const SealedAutomaticPlan &plan) {
+	if (!plan.valid || plan.chats.size() > kSealedAutomaticChatLimit) {
+		return QStringLiteral("invalid");
+	} else if (plan.chats.empty()) {
+		return QString();
+	}
+	auto chats = QJsonArray();
+	for (const auto &[id, binding] : plan.chats) {
+		chats.push_back(QJsonObject{
+			{ QStringLiteral("test"), id.test },
+			{ QStringLiteral("account"), QString::number(id.account) },
+			{ QStringLiteral("peer"), QString::number(id.peer) },
+			{ QStringLiteral("own"), QString::fromLatin1(binding.own.toHex()) },
+			{ QStringLiteral("remote"), QString::fromLatin1(binding.remote.toHex()) },
+		});
+	}
+	return QString::fromUtf8(QJsonDocument(QJsonObject{
+		{ QStringLiteral("version"), 1 },
+		{ QStringLiteral("chats"), chats },
+	}).toJson(QJsonDocument::Compact));
+}
+
+[[nodiscard]] inline bool SealedAutomaticPlanSelected(
+		const SealedAutomaticPlan &plan,
+		const SealedAutomaticChatId &id) {
+	return !plan.valid || plan.chats.contains(id);
+}
+
+[[nodiscard]] inline bool MatchesSealedAutomaticBinding(
+		const SealedAutomaticBinding &binding,
+		const QByteArray &own,
+		const QByteArray &remote,
+		bool ownCopy) {
+	return own.size() == 64 && binding.own == own
+		&& (ownCopy || (remote.size() == 64 && binding.remote == remote));
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_backup.cpp b/Telegram/SourceFiles/tele/tele_sealed_backup.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b1af1d3d4698f467c72f6e8dde1d6d3cc2f8afd6
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_backup.cpp
@@ -0,0 +1,418 @@
+#include "tele/tele_sealed_backup.h"
+
+#include "base/weak_qptr.h"
+#include "core/file_utilities.h"
+#include "main/main_session.h"
+#include "settings/settings_common.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_sealed.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/fields/password_input.h"
+#include "ui/widgets/labels.h"
+#include "window/window_session_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_settings.h"
+
+#include <QtCore/QFile>
+#include <QtCore/QSaveFile>
+
+#include <openssl/crypto.h>
+
+#include <atomic>
+
+namespace Tele {
+namespace {
+
+constexpr auto kBackupFileLimit = 512;
+constexpr auto kPassphraseLimit = 1024;
+
+struct Password {
+	explicit Password(const QString &text);
+	~Password();
+
+	QString text;
+};
+
+struct BackupState {
+	std::atomic<bool> alive = true;
+	bool busy = false;
+};
+
+Password::Password(const QString &value)
+: text(value.constData(), value.size()) {
+}
+
+Password::~Password() {
+	if (!text.isEmpty()) {
+		OPENSSL_cleanse(text.data(), size_t(text.size()) * sizeof(QChar));
+	}
+}
+
+[[nodiscard]] bool ValidPassword(const QString &text) {
+	if (text.size() > kPassphraseLimit) {
+		return false;
+	}
+	auto count = 0;
+	for (auto i = 0; i != text.size(); ++i, ++count) {
+		if (text[i].isHighSurrogate()) {
+			if (++i == text.size() || !text[i].isLowSurrogate()) {
+				return false;
+			}
+		} else if (text[i].isLowSurrogate()) {
+			return false;
+		}
+	}
+	auto bytes = text.toUtf8();
+	const auto cleanse = gsl::finally([&] {
+		if (!bytes.isEmpty()) {
+			OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+		}
+	});
+	return count >= 16 && bytes.size() <= kPassphraseLimit;
+}
+
+[[nodiscard]] not_null<Ui::PasswordInput*> AddPassword(
+		not_null<Ui::GenericBox*> box,
+		const QString &placeholder) {
+	auto container = object_ptr<Ui::RpWidget>(box);
+	const auto raw = container.data();
+	const auto field = Ui::CreateChild<Ui::PasswordInput>(
+		raw,
+		st::defaultInputField,
+		rpl::single(placeholder));
+	field->setMaxLength(kPassphraseLimit);
+	raw->resize(raw->width(), field->height());
+	raw->widthValue() | rpl::on_next([=](int width) {
+		field->resize(width, field->height());
+		field->moveToLeft(0, 0);
+	}, raw->lifetime());
+	box->addRow(std::move(container), style::al_justify);
+	return field;
+}
+
+[[nodiscard]] not_null<Ui::SettingsButton*> AddAction(
+		not_null<Ui::GenericBox*> box,
+		const QString &text,
+		const style::icon &icon) {
+	return box->addRow(Settings::CreateButtonWithIcon(
+		box,
+		rpl::single(text),
+		st::settingsButton,
+		{ .icon = &icon, .type = Settings::IconType::Simple }
+	), style::margins(), style::al_justify);
+}
+
+[[nodiscard]] bool Ready(
+		not_null<Window::SessionController*> controller,
+		not_null<Main::Session*> session,
+		bool allowMissing) {
+	if (&controller->session() != session) {
+		return false;
+	}
+	const auto keys = LoadSealedKeys(session);
+	if (keys.error == SealedStoreError::None
+		|| (allowMissing && (keys.error == SealedStoreError::Missing
+			|| keys.error == SealedStoreError::DuressBlocked))) {
+		return true;
+	}
+	ShowSealedStoreError(controller, keys.error);
+	return false;
+}
+
+[[nodiscard]] QString BackupFilter() {
+	return Lower(u"Encrypted key backup (*.telekey)"_q)
+		+ u";;"_q + FileDialog::AllFilesFilter();
+}
+
+void PasswordBox(
+	not_null<Ui::GenericBox*> box,
+	not_null<Window::SessionController*> controller,
+	bool restore,
+	QByteArray backup);
+
+void ExportBackup(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		std::shared_ptr<BackupState> state,
+		std::shared_ptr<Password> password,
+		not_null<Ui::FlatLabel*> status) {
+	const auto session = &controller->session();
+	auto keys = CreateSealedKeys(session);
+	if (keys.error != SealedStoreError::None) {
+		state->busy = false;
+		ShowSealedStoreError(controller, keys.error);
+		return;
+	}
+	const auto identity = std::make_shared<SealedIdentity>(
+		std::move(*keys.identity));
+	const auto context = SealedBackupContext(session);
+	const auto weakBox = base::make_weak(box);
+	const auto weakController = base::make_weak(controller);
+	const auto weakSession = base::make_weak(session);
+	const auto publicKey = identity->publicKey;
+	status->setText(Lower(u"Encrypting key backup…"_q));
+	crl::async([=] {
+		if (!state->alive) {
+			return;
+		}
+		auto bytes = ExportSealedIdentity(
+			identity->privateKey,
+			password->text,
+			context);
+		crl::on_main([=, bytes = std::move(bytes)] {
+			if (!state->alive || !weakBox || !weakController || !weakSession) {
+				return;
+			} else if (!Ready(weakController.get(), weakSession.get(), false)) {
+				state->busy = false;
+				return;
+			}
+			if (!bytes) {
+				state->busy = false;
+				status->setText(Lower(u"Could not encrypt the key backup."_q));
+				return;
+			}
+			status->setText(Lower(
+				u"Choose where to save the encrypted backup."_q));
+			FileDialog::GetWritePath(
+				weakBox.get(),
+				Lower(u"Save encrypted key backup"_q),
+				BackupFilter(),
+				u"tele-sealed-key.telekey"_q,
+				crl::guard(weakBox.get(), [=](const QString &path) {
+					state->busy = false;
+					if (path.isEmpty() || !state->alive || !weakController
+						|| !weakSession
+						|| !Ready(weakController.get(), weakSession.get(), false)) {
+						return;
+					}
+					const auto keys = LoadSealedKeys(weakSession.get());
+					if (!keys.identity || keys.identity->publicKey != publicKey) {
+						ShowSealedStoreError(
+							weakController.get(),
+							SealedStoreError::Changed);
+						return;
+					}
+					auto file = QSaveFile(path);
+					const auto saved = file.open(QIODevice::WriteOnly)
+						&& file.setPermissions(QFile::ReadOwner | QFile::WriteOwner)
+						&& (file.write(*bytes) == bytes->size())
+						&& file.commit();
+					if (!saved) {
+						status->setText(Lower(
+							u"Could not save the encrypted backup."_q));
+						return;
+					}
+					weakController->showToast(Lower(
+						u"Encrypted key backup saved."_q));
+					weakBox->closeBox();
+				}),
+				crl::guard(weakBox.get(), [=] { state->busy = false; }));
+		});
+	});
+}
+
+void RestoreBackup(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		std::shared_ptr<BackupState> state,
+		std::shared_ptr<Password> password,
+		not_null<Ui::FlatLabel*> status,
+		const QByteArray &backup) {
+	const auto session = &controller->session();
+	if (!Ready(controller, session, true)) {
+		state->busy = false;
+		return;
+	}
+	const auto context = SealedBackupContext(session);
+	const auto weakBox = base::make_weak(box);
+	const auto weakController = base::make_weak(controller);
+	const auto weakSession = base::make_weak(session);
+	status->setText(Lower(u"Decrypting key backup…"_q));
+	crl::async([=] {
+		if (!state->alive) {
+			return;
+		}
+		auto identity = ImportSealedIdentity(backup, password->text, context);
+		crl::on_main([=, identity = std::move(identity)] {
+			if (!state->alive || !weakBox || !weakController || !weakSession) {
+				return;
+			}
+			state->busy = false;
+			if (!Ready(weakController.get(), weakSession.get(), true)) {
+				return;
+			}
+			if (!identity) {
+				status->setText(Lower(u"Wrong passphrase, account or backup file."_q));
+				return;
+			}
+			const auto error = RestoreSealedKeys(weakSession.get(), *identity);
+			if (error != SealedStoreError::None) {
+				ShowSealedStoreError(weakController.get(), error);
+				return;
+			}
+			if (weakController) {
+				weakController->showToast(Lower(u"Decryption key restored."_q));
+			}
+			if (weakBox) {
+				weakBox->closeBox();
+			}
+		});
+	});
+}
+
+void PasswordBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		bool restore,
+		QByteArray backup) {
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(restore
+		? u"Restore encrypted key"_q
+		: u"Export encrypted key"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Use at least 16 characters, preferably five random words."_q),
+		st::boxLabel), style::al_justify);
+	const auto field = AddPassword(box, Lower(u"Backup passphrase"_q));
+	const auto confirm = restore
+		? nullptr
+		: AddPassword(box, Lower(u"Repeat passphrase"_q)).get();
+	const auto status = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		QString(),
+		st::boxLabel), style::al_justify);
+	const auto state = std::make_shared<BackupState>();
+	const auto clear = [=] {
+		state->alive = false;
+		field->setText(QString());
+		if (confirm) {
+			confirm->setText(QString());
+		}
+	};
+	GuardSealedBox(box, &controller->session(), clear);
+	box->boxClosing() | rpl::on_next(clear, box->lifetime());
+	const auto submit = [=] {
+		if (state->busy || !state->alive) {
+			return;
+		} else if (!ValidPassword(field->getLastText())) {
+			field->showError();
+			field->setFocusFast();
+			status->setText(Lower(u"Use at least 16 characters, preferably five random words."_q));
+			return;
+		} else if (confirm && confirm->getLastText() != field->getLastText()) {
+			confirm->showError();
+			confirm->setFocusFast();
+			status->setText(Lower(u"The passphrases do not match."_q));
+			return;
+		}
+		state->busy = true;
+		const auto password = std::make_shared<Password>(field->getLastText());
+		field->setText(QString());
+		if (confirm) {
+			confirm->setText(QString());
+		}
+		if (restore) {
+			RestoreBackup(box, controller, state, password, status, backup);
+		} else {
+			ExportBackup(box, controller, state, password, status);
+		}
+	};
+	QObject::connect(
+		field,
+		&Ui::MaskedInputField::submitted,
+		box,
+		[=](Qt::KeyboardModifiers) {
+			if (confirm) {
+				confirm->setFocusFast();
+			} else {
+				submit();
+			}
+		});
+	if (confirm) {
+		QObject::connect(
+			confirm,
+			&Ui::MaskedInputField::submitted,
+			box,
+			[=](Qt::KeyboardModifiers) { submit(); });
+	}
+	box->setFocusCallback([=] { field->setFocusFast(); });
+	box->addButton(rpl::single(Lower(restore ? u"Restore"_q : u"Export"_q)), submit);
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] { box->closeBox(); });
+}
+
+void BackupBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Encrypted key backup"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Restore this device’s key only on the same Telegram account."_q),
+		st::boxLabel), style::al_justify);
+	const auto session = &controller->session();
+	const auto alive = std::make_shared<bool>(true);
+	GuardSealedBox(box, session, [=] { *alive = false; });
+	box->boxClosing() | rpl::on_next([=] { *alive = false; }, box->lifetime());
+	const auto exportKey = AddAction(
+		box,
+		Lower(u"Export encrypted key"_q),
+		st::menuIconExport);
+	exportKey->setClickedCallback([=] {
+		if (*alive && Ready(controller, session, true)) {
+			controller->show(Box(PasswordBox, controller, false, QByteArray()));
+		}
+	});
+	const auto importKey = AddAction(
+		box,
+		Lower(u"Restore encrypted key"_q),
+		st::menuIconRestore);
+	importKey->setClickedCallback([=] {
+		if (!*alive || !Ready(controller, session, true)) {
+			return;
+		}
+		const auto weakController = base::make_weak(controller);
+		const auto weakSession = base::make_weak(session);
+		FileDialog::GetOpenPath(
+			box.get(),
+			Lower(u"Open encrypted key backup"_q),
+			BackupFilter(),
+			crl::guard(box, [=](FileDialog::OpenResult &&result) {
+				if (!*alive || !weakController || !weakSession
+					|| !Ready(weakController.get(), weakSession.get(), true)) {
+					return;
+				}
+				auto backup = std::move(result.remoteContent);
+				if (backup.isEmpty() && !result.paths.isEmpty()) {
+					auto file = QFile(result.paths.front());
+					if (file.open(QIODevice::ReadOnly)
+						&& file.size() <= kBackupFileLimit) {
+						backup = file.read(kBackupFileLimit + 1);
+					}
+				}
+				if (backup.isEmpty() || backup.size() > kBackupFileLimit) {
+					weakController->showToast(Lower(
+						u"Could not read the encrypted key backup."_q));
+					return;
+				}
+				weakController->show(Box(
+					PasswordBox,
+					weakController.get(),
+					true,
+					std::move(backup)));
+			}));
+	});
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+}
+
+}
+
+void ShowSealedBackup(not_null<Window::SessionController*> controller) {
+	if (Ready(controller, &controller->session(), true)) {
+		controller->show(Box(BackupBox, controller));
+	}
+}
+
+}
