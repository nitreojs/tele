diff --git a/Telegram/SourceFiles/tele/tele_sealed_send_plan.h b/Telegram/SourceFiles/tele/tele_sealed_send_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..4153c8baee5a75bd250c123183e6cb49afbf6af0
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_send_plan.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include <QtCore/QByteArray>
+#include <QtCore/QString>
+#include <QtCore/QtGlobal>
+
+namespace Tele {
+
+inline constexpr auto kSealedSendProofLifetime = qint64(10 * 60 * 1000);
+
+struct SealedSendProof {
+	quint64 account = 0;
+	quint64 chat = 0;
+	QByteArray digest;
+	QByteArray reply;
+	QByteArray own;
+	QByteArray peer;
+	quint64 epoch = 0;
+	quint64 fileId = 0;
+	qint64 when = 0;
+	bool file = false;
+};
+
+[[nodiscard]] inline bool SealedSendProofLive(
+		const SealedSendProof &proof,
+		quint64 epoch,
+		qint64 now) {
+	return proof.account && proof.chat && epoch && proof.epoch == epoch
+		&& proof.when >= 0 && now >= 0
+		&& proof.digest.size() == 32 && !proof.own.isEmpty() && !proof.peer.isEmpty()
+		&& now >= proof.when && now - proof.when <= kSealedSendProofLifetime;
+}
+
+[[nodiscard]] inline bool SealedSendProofMatches(
+		const SealedSendProof &proof,
+		quint64 account,
+		quint64 chat,
+		quint64 epoch,
+		qint64 now,
+		const QByteArray &own,
+		const QByteArray &peer) {
+	return SealedSendProofLive(proof, epoch, now)
+		&& proof.account == account && proof.chat == chat
+		&& proof.own == own && proof.peer == peer;
+}
+
+[[nodiscard]] inline bool SealedSendTextMatches(
+		const SealedSendProof &proof,
+		const QByteArray &digest,
+		const QByteArray &reply) {
+	return !proof.file && !proof.fileId && proof.digest == digest && proof.reply == reply;
+}
+
+[[nodiscard]] inline bool SealedSendFileContentMatches(
+		const SealedSendProof &proof,
+		const QByteArray &digest) {
+	return proof.file && proof.reply.isEmpty() && proof.digest == digest;
+}
+
+[[nodiscard]] inline bool PrepareSealedFileUpload(
+		SealedSendProof &proof,
+		const QByteArray &digest,
+		quint64 fileId,
+		QString &transportName) {
+	if (!fileId || !SealedSendFileContentMatches(proof, digest)
+		|| (proof.fileId && proof.fileId != fileId)) {
+		return false;
+	}
+	transportName = QStringLiteral("message.teleenc");
+	proof.fileId = fileId;
+	return true;
+}
+
+[[nodiscard]] inline bool SealedSendUploadedFileMatches(
+		const SealedSendProof &proof,
+		quint64 fileId) {
+	return proof.file && proof.reply.isEmpty() && fileId && proof.fileId == fileId;
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_store.cpp b/Telegram/SourceFiles/tele/tele_sealed_store.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f4e6d775ee2c215ea0b2839059aa6a621df17747
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_store.cpp
@@ -0,0 +1,311 @@
+#include "tele/tele_sealed_store.h"
+
+#include "core/application.h"
+#include "data/data_peer_id.h"
+#include "main/main_domain.h"
+#include "main/main_account.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "storage/storage_domain.h"
+#include "tele/tele_sealed_duress.h"
+#include "tele/tele_sealed_auto.h"
+#include "tele/tele_sealed_registry_native.h"
+
+#include <QtCore/QFileInfo>
+
+#include <openssl/crypto.h>
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E5EA1);
+constexpr auto kVersion = quint32(1);
+constexpr auto kPrivateKeySize = kSealedPrivateKeySize;
+constexpr auto kPublicKeySize = kSealedPublicKeySize;
+constexpr auto kMaxPeers = quint32(4096);
+constexpr auto kHeaderSize = 3 * sizeof(quint32)
+	+ sizeof(quint64)
+	+ kPrivateKeySize;
+constexpr auto kPeerSize = sizeof(quint64) + kPublicKeySize;
+constexpr auto kMaxFileSize = qint64(kHeaderSize + kMaxPeers * kPeerSize + 128);
+constexpr auto kMaxPeerId = quint64(0xFFFFFFFFFFFF);
+
+void Cleanse(QByteArray &value) {
+	if (!value.isEmpty()) {
+		OPENSSL_cleanse(value.data(), size_t(value.size()));
+	}
+}
+
+[[nodiscard]] SealedStoreError Ready(
+		not_null<Main::Session*> session,
+		bool recovering = false) {
+	if (Core::App().passcodeLocked()) {
+		return SealedStoreError::Locked;
+	} else if (!Core::App().domain().local().hasLocalPasscode()) {
+		return SealedStoreError::PasscodeRequired;
+	} else if (!session->local().peekLegacyLocalKey()
+		|| session->account().maybeSession() != session) {
+		return SealedStoreError::Unavailable;
+	}
+	return recovering ? SealedStoreError::None : CheckSealedDuressStorage(session);
+}
+
+[[nodiscard]] QString Directory(not_null<Main::Session*> session) {
+	return QFileInfo(session->local().supportModePath()).absolutePath() + '/';
+}
+
+[[nodiscard]] QString Name() {
+	return u"tele_sealed_keys"_q;
+}
+
+[[nodiscard]] SealedStoreError FileStatus(const QString &directory) {
+	const auto info = QFileInfo(directory);
+	if (info.exists() && (!info.isDir() || !info.isReadable())) {
+		return SealedStoreError::Unavailable;
+	}
+	auto found = false;
+	for (const auto postfix : { 's', '0', '1' }) {
+		const auto file = QFileInfo(directory + Name() + postfix);
+		if (!file.exists() && !file.isSymLink()) {
+			continue;
+		}
+		found = true;
+		if (!file.isFile() || file.isSymLink()
+			|| file.size() <= 0 || file.size() > kMaxFileSize) {
+			return SealedStoreError::Corrupt;
+		} else if (!file.isReadable()) {
+			return SealedStoreError::Unavailable;
+		}
+	}
+	return found ? SealedStoreError::None : SealedStoreError::Missing;
+}
+
+[[nodiscard]] SealedStoredKeys Failed(SealedStoreError error) {
+	return { .error = error };
+}
+
+[[nodiscard]] bool ValidPeer(
+		not_null<Main::Session*> session,
+		quint64 peerId) {
+	return peerId > 0
+		&& peerId <= kMaxPeerId
+		&& peerId != session->userId().bare;
+}
+
+[[nodiscard]] SealedStoreError Write(
+		not_null<Main::Session*> session,
+		const SealedStoredKeys &keys,
+		bool recovering = false) {
+	const auto ready = Ready(session, recovering);
+	if (ready != SealedStoreError::None) {
+		return ready;
+	} else if (!keys.identity || keys.identity->privateKey.size() != kPrivateKeySize
+		|| keys.peers.size() > kMaxPeers) {
+		return SealedStoreError::Corrupt;
+	}
+	const auto size = kHeaderSize + keys.peers.size() * kPeerSize;
+	auto data = EncryptedDescriptor(uint32(size));
+	const auto cleanse = gsl::finally([&] { Cleanse(data.data); });
+	data.stream << kMagic << kVersion << quint64(session->uniqueId());
+	data.stream.writeRawData(keys.identity->privateKey.constData(), kPrivateKeySize);
+	data.stream << quint32(keys.peers.size());
+	for (const auto &[peerId, publicKey] : keys.peers) {
+		if (!ValidPeer(session, peerId) || !IsSealedPublicKey(publicKey)
+			|| publicKey == keys.identity->publicKey) {
+			return SealedStoreError::InvalidPeer;
+		}
+		data.stream << peerId;
+		data.stream.writeRawData(publicKey.constData(), kPublicKeySize);
+	}
+	if (data.stream.status() != QDataStream::Ok) {
+		return SealedStoreError::WriteFailed;
+	}
+	const auto written = RegisteredSealedKeyWrite(session, [&] {
+		if (Ready(session, recovering) != SealedStoreError::None) {
+			return false;
+		}
+		auto file = FileWriteDescriptor(Name(), Directory(session), true);
+		file.writeEncrypted(data, session->local().peekLegacyLocalKey());
+		return file.finish();
+	});
+	if (written != SealedRegistryError::None) {
+		return SealedStoreError::WriteFailed;
+	}
+	NotifySealedAutomaticKeysChanged(session);
+	return SealedStoreError::None;
+}
+
+}
+
+SealedStoredKeys LoadSealedKeys(not_null<Main::Session*> session) {
+	const auto ready = Ready(session);
+	if (ready != SealedStoreError::None) {
+		return Failed(ready);
+	}
+	const auto directory = Directory(session);
+	const auto status = FileStatus(directory);
+	if (status != SealedStoreError::Missing
+		&& RegisterSealedKeyStore(session) != SealedRegistryError::None) {
+		return Failed(SealedStoreError::Unavailable);
+	}
+	if (status != SealedStoreError::None) {
+		return Failed(status);
+	}
+	auto file = FileReadDescriptor();
+	if (!ReadFile(file, Name(), directory)) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto length = quint32();
+	file.stream >> length;
+	if (file.stream.status() != QDataStream::Ok
+		|| length < 32 || length > kMaxFileSize || (length & 15)
+		|| file.buffer.bytesAvailable() != length) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto encrypted = QByteArray(length, Qt::Uninitialized);
+	if (file.stream.readRawData(encrypted.data(), length) != length) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto data = EncryptedDescriptor();
+	const auto cleanse = gsl::finally([&] { Cleanse(data.data); });
+	if (!DecryptLocal(data, encrypted, session->local().peekLegacyLocalKey())) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto magic = quint32();
+	auto version = quint32();
+	auto owner = quint64();
+	data.stream >> magic >> version >> owner;
+	if (data.stream.status() != QDataStream::Ok
+		|| magic != kMagic || version != kVersion
+		|| owner != session->uniqueId()) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto privateKey = QByteArray(kPrivateKeySize, Qt::Uninitialized);
+	const auto cleanseKey = gsl::finally([&] { Cleanse(privateKey); });
+	if (data.stream.readRawData(privateKey.data(), kPrivateKeySize) != kPrivateKeySize) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto publicKey = DeriveSealedPublicKey(privateKey);
+	if (!publicKey) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto count = quint32();
+	data.stream >> count;
+	if (data.stream.status() != QDataStream::Ok || count > kMaxPeers
+		|| data.buffer.bytesAvailable() != qint64(count) * qint64(kPeerSize)) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	auto result = SealedStoredKeys();
+	result.identity.emplace(std::move(privateKey), std::move(*publicKey));
+	for (auto i = quint32(); i != count; ++i) {
+		auto peerId = quint64();
+		auto key = QByteArray(kPublicKeySize, Qt::Uninitialized);
+		data.stream >> peerId;
+		if (data.stream.readRawData(key.data(), kPublicKeySize) != kPublicKeySize
+			|| !ValidPeer(session, peerId) || !IsSealedPublicKey(key)
+			|| key == result.identity->publicKey
+			|| !result.peers.emplace(peerId, std::move(key)).second) {
+			return Failed(SealedStoreError::Corrupt);
+		}
+	}
+	if (data.stream.status() != QDataStream::Ok || !data.stream.atEnd()) {
+		return Failed(SealedStoreError::Corrupt);
+	}
+	return result;
+}
+
+SealedStoredKeys CreateSealedKeys(not_null<Main::Session*> session) {
+	auto result = LoadSealedKeys(session);
+	if (result.error != SealedStoreError::Missing) {
+		return result;
+	}
+	auto identity = GenerateSealedIdentity();
+	if (!identity) {
+		return Failed(SealedStoreError::Unavailable);
+	}
+	result.error = SealedStoreError::None;
+	result.identity = std::move(identity);
+	const auto error = Write(session, result);
+	return (error == SealedStoreError::None)
+		? std::move(result)
+		: Failed(error);
+}
+
+SealedStoreError RestoreSealedKeys(
+		not_null<Main::Session*> session,
+		const SealedIdentity &identity) {
+	auto keys = LoadSealedKeys(session);
+	if (keys.error != SealedStoreError::None
+		&& keys.error != SealedStoreError::Missing
+		&& keys.error != SealedStoreError::DuressBlocked) {
+		return keys.error;
+	}
+	const auto publicKey = DeriveSealedPublicKey(identity.privateKey);
+	if (!publicKey || *publicKey != identity.publicKey) {
+		return SealedStoreError::Corrupt;
+	} else if (keys.error == SealedStoreError::DuressBlocked) {
+		auto recovered = SealedStoredKeys();
+		recovered.identity = identity;
+		return RecoverSealedDuressStorage(session, [&] {
+			return Write(session, recovered, true) == SealedStoreError::None;
+		});
+	} else if (keys.identity) {
+		return (keys.identity->publicKey == identity.publicKey)
+			? SealedStoreError::None
+			: SealedStoreError::Changed;
+	}
+	keys.error = SealedStoreError::None;
+	keys.identity = identity;
+	return Write(session, keys);
+}
+
+SealedStoreError SaveVerifiedSealedPeer(
+		not_null<Main::Session*> session,
+		quint64 peerId,
+		const QByteArray &publicKey,
+		const QByteArray &previousKey) {
+	auto keys = LoadSealedKeys(session);
+	if (keys.error != SealedStoreError::None) {
+		return keys.error;
+	} else if (!ValidPeer(session, peerId) || !IsSealedPublicKey(publicKey)
+		|| publicKey == keys.identity->publicKey) {
+		return SealedStoreError::InvalidPeer;
+	}
+	const auto i = keys.peers.find(peerId);
+	const auto current = (i == end(keys.peers)) ? QByteArray() : i->second;
+	if (current != previousKey) {
+		return SealedStoreError::Changed;
+	} else if (current == publicKey) {
+		return SealedStoreError::None;
+	} else if (i == end(keys.peers) && keys.peers.size() == kMaxPeers) {
+		return SealedStoreError::InvalidPeer;
+	}
+	keys.peers[peerId] = publicKey;
+	return Write(session, keys);
+}
+
+SealedStoreError ForgetSealedPeer(
+		not_null<Main::Session*> session,
+		quint64 peerId,
+		const QByteArray &previousKey) {
+	auto keys = LoadSealedKeys(session);
+	if (keys.error != SealedStoreError::None) {
+		return keys.error;
+	} else if (!ValidPeer(session, peerId)) {
+		return SealedStoreError::InvalidPeer;
+	}
+	const auto i = keys.peers.find(peerId);
+	const auto current = (i == end(keys.peers)) ? QByteArray() : i->second;
+	if (current != previousKey) {
+		return SealedStoreError::Changed;
+	} else if (i == end(keys.peers)) {
+		return SealedStoreError::None;
+	}
+	keys.peers.erase(i);
+	return Write(session, keys);
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_store.h b/Telegram/SourceFiles/tele/tele_sealed_store.h
new file mode 100644
index 0000000000000000000000000000000000000000..acdda490fa9456481bf41570eb97d3775877d14f
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_store.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "tele/tele_sealed_crypto.h"
+
+#include <map>
+
+namespace Main {
+class Session;
+}
+
+namespace Tele {
+
+enum class SealedStoreError {
+	None,
+	PasscodeRequired,
+	Locked,
+	Missing,
+	Corrupt,
+	Unavailable,
+	WriteFailed,
+	InvalidPeer,
+	Changed,
+	DuressBlocked,
+};
+
+struct SealedStoredKeys {
+	SealedStoreError error = SealedStoreError::None;
+	std::optional<SealedIdentity> identity;
+	std::map<quint64, QByteArray> peers;
+};
+
+[[nodiscard]] SealedStoredKeys LoadSealedKeys(not_null<Main::Session*> session);
+[[nodiscard]] SealedStoredKeys CreateSealedKeys(not_null<Main::Session*> session);
+[[nodiscard]] SealedStoreError RestoreSealedKeys(
+	not_null<Main::Session*> session,
+	const SealedIdentity &identity);
+[[nodiscard]] SealedStoreError SaveVerifiedSealedPeer(
+	not_null<Main::Session*> session,
+	quint64 peerId,
+	const QByteArray &publicKey,
+	const QByteArray &previousKey);
+[[nodiscard]] SealedStoreError ForgetSealedPeer(
+	not_null<Main::Session*> session,
+	quint64 peerId,
+	const QByteArray &previousKey);
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_text.cpp b/Telegram/SourceFiles/tele/tele_sealed_text.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f5178f0d03004cb596b41697e75041be94a0073a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_text.cpp
@@ -0,0 +1,393 @@
+#include "tele/tele_sealed_text.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QtEndian>
+
+#include <openssl/crypto.h>
+#include <openssl/rand.h>
+
+#include <algorithm>
+#include <array>
+#include <map>
+#include <tuple>
+#include <utility>
+
+namespace Tele {
+namespace {
+
+constexpr auto kPrefix = "tele-sealed:v2:";
+constexpr auto kPrefixSize = 15;
+constexpr auto kHeaderSize = qsizetype(35);
+constexpr auto kEnvelopeSize = 1 + 2 * kSealedPublicKeySize
+	+ 2 * (4 + kSealedPlaintextLimit + 16);
+constexpr auto kTokenSize = kPrefixSize + ((kHeaderSize + kEnvelopeSize) * 4 + 2) / 3;
+constexpr auto kRichMagic = "TELERTXT";
+constexpr auto kRichMagicSize = qsizetype(8);
+constexpr auto kRichMinimum = qsizetype(17);
+constexpr auto kFragmentMetadataSize = qsizetype(68);
+
+void Cleanse(QByteArray &bytes) {
+	if (!bytes.isEmpty()) OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+	bytes.clear();
+}
+
+struct ByteWiper {
+	QByteArray &bytes;
+
+	~ByteWiper() {
+		Cleanse(bytes);
+	}
+};
+
+[[nodiscard]] bool Nonzero(const QByteArray &bytes) {
+	return std::any_of(bytes.begin(), bytes.end(), [](char value) { return value != 0; });
+}
+
+[[nodiscard]] QByteArray Digest(const QByteArray &bytes) {
+	return QCryptographicHash::hash(bytes, QCryptographicHash::Sha512);
+}
+
+[[nodiscard]] bool EqualDigest(const QByteArray &a, const QByteArray &b) {
+	return a.size() == 64 && b.size() == 64
+		&& CRYPTO_memcmp(a.constData(), b.constData(), 64) == 0;
+}
+
+[[nodiscard]] bool StrictUnicode(const QString &text) {
+	for (auto i = qsizetype(); i < text.size(); ++i) {
+		if (text[i].isHighSurrogate()) {
+			if (++i == text.size() || !text[i].isLowSurrogate()) return false;
+		} else if (text[i].isLowSurrogate()) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] bool ScalarBoundary(const QString &text, qsizetype offset) {
+	return offset >= 0 && offset <= text.size()
+		&& !(offset && offset < text.size()
+			&& text[offset].isLowSurrogate() && text[offset - 1].isHighSurrogate());
+}
+
+[[nodiscard]] bool ContextAllowed(const QByteArray &context) {
+	return context.size() == 17 && uchar(context[0]) <= 1
+		&& qFromBigEndian<quint64>(reinterpret_cast<const uchar*>(context.constData() + 1))
+		&& qFromBigEndian<quint64>(reinterpret_cast<const uchar*>(context.constData() + 9));
+}
+
+void Append16(QByteArray &bytes, quint16 value) {
+	const auto offset = bytes.size();
+	bytes.resize(offset + 2);
+	qToBigEndian(value, bytes.data() + offset);
+}
+
+void Append32(QByteArray &bytes, quint32 value) {
+	const auto offset = bytes.size();
+	bytes.resize(offset + 4);
+	qToBigEndian(value, bytes.data() + offset);
+}
+
+class Reader final {
+public:
+	explicit Reader(const QByteArray &bytes) : _bytes(bytes) {
+	}
+
+	[[nodiscard]] std::optional<QByteArray> take(qsizetype size) {
+		if (size < 0 || size > _bytes.size() - _offset) return std::nullopt;
+		const auto result = _bytes.mid(_offset, size);
+		_offset += size;
+		return result;
+	}
+
+	[[nodiscard]] std::optional<quint16> read16() {
+		if (_bytes.size() - _offset < 2) return std::nullopt;
+		const auto result = qFromBigEndian<quint16>(reinterpret_cast<const uchar*>(_bytes.constData() + _offset));
+		_offset += 2;
+		return result;
+	}
+
+	[[nodiscard]] std::optional<quint32> read32() {
+		if (_bytes.size() - _offset < 4) return std::nullopt;
+		const auto result = qFromBigEndian<quint32>(reinterpret_cast<const uchar*>(_bytes.constData() + _offset));
+		_offset += 4;
+		return result;
+	}
+
+	[[nodiscard]] bool ended() const {
+		return _offset == _bytes.size();
+	}
+
+private:
+	const QByteArray &_bytes;
+	qsizetype _offset = 0;
+};
+
+[[nodiscard]] std::optional<QByteArray> Encode(const SealedRichText &text) {
+	if (text.text.isEmpty() || text.text.size() > kSealedRichPayloadLimit
+		|| text.tags.size() > kSealedRichTagLimit || !StrictUnicode(text.text)) return std::nullopt;
+	const auto utf8 = text.text.toUtf8();
+	auto size = qint64(kRichMinimum) + utf8.size() + qint64(text.tags.size()) * 10;
+	if (size > kSealedRichPayloadLimit) return std::nullopt;
+	auto dictionary = std::map<QByteArray, quint16>();
+	for (const auto &tag : text.tags) {
+		if (tag.offset < 0 || tag.length <= 0 || tag.offset > text.text.size()
+			|| tag.length > text.text.size() - tag.offset
+			|| !ScalarBoundary(text.text, tag.offset)
+			|| !ScalarBoundary(text.text, qsizetype(tag.offset) + tag.length)
+			|| tag.id.isEmpty() || tag.id.size() > kSealedRichTagIdLimit
+			|| !StrictUnicode(tag.id)) return std::nullopt;
+		const auto id = tag.id.toUtf8();
+		if (id.size() > kSealedRichTagIdLimit
+			|| std::any_of(id.begin(), id.end(), [](char value) {
+				return uchar(value) < 0x20 || uchar(value) == 0x7F;
+			})) return std::nullopt;
+		if (dictionary.emplace(id, 0).second) {
+			size += 2 + id.size();
+			if (dictionary.size() > kSealedRichDictionaryLimit
+				|| size > kSealedRichPayloadLimit) return std::nullopt;
+		}
+	}
+	auto next = quint16();
+	for (auto &[id, index] : dictionary) index = next++;
+	auto spans = std::vector<std::tuple<quint32, quint32, quint16>>();
+	spans.reserve(text.tags.size());
+	for (const auto &tag : text.tags) {
+		spans.emplace_back(quint32(tag.offset), quint32(tag.length), dictionary.at(tag.id.toUtf8()));
+	}
+	std::sort(spans.begin(), spans.end());
+	if (std::adjacent_find(spans.begin(), spans.end()) != spans.end()) return std::nullopt;
+	auto end = quint32();
+	for (const auto &[offset, length, id] : spans) {
+		if (offset < end) return std::nullopt;
+		end = offset + length;
+	}
+	auto result = QByteArray(kRichMagic, kRichMagicSize);
+	result.reserve(qsizetype(size));
+	result.append(char(1));
+	Append32(result, quint32(utf8.size()));
+	result.append(utf8);
+	Append16(result, quint16(dictionary.size()));
+	for (const auto &[id, index] : dictionary) {
+		Append16(result, quint16(id.size()));
+		result.append(id);
+	}
+	Append16(result, quint16(spans.size()));
+	for (const auto &[offset, length, id] : spans) {
+		Append32(result, offset);
+		Append32(result, length);
+		Append16(result, id);
+	}
+	return result;
+}
+
+[[nodiscard]] bool HeaderAllowed(const SealedRichPartHeader &header) {
+	return header.group.size() == 32 && Nonzero(header.group)
+		&& header.count >= 1 && header.count <= kSealedRichPartLimit
+		&& header.index >= 0 && header.index < header.count;
+}
+
+[[nodiscard]] QByteArray EncodeHeader(const SealedRichPartHeader &header) {
+	auto result = QByteArray(1, char(2));
+	result.append(header.group);
+	result.append(char(header.index));
+	result.append(char(header.count));
+	return result;
+}
+
+struct Token {
+	SealedRichPartHeader header;
+	QByteArray headerBytes;
+	QByteArray envelope;
+};
+
+[[nodiscard]] std::optional<Token> ParseToken(const QString &token) {
+	if (token.size() != kTokenSize || !token.startsWith(QLatin1String(kPrefix))) return std::nullopt;
+	const auto encoded = token.mid(kPrefixSize);
+	if (QString::fromLatin1(encoded.toLatin1()) != encoded) return std::nullopt;
+	const auto decoded = QByteArray::fromBase64Encoding(encoded.toLatin1(),
+		QByteArray::Base64UrlEncoding | QByteArray::AbortOnBase64DecodingErrors);
+	if (!decoded || decoded.decoded.size() != kHeaderSize + kEnvelopeSize
+		|| QString::fromLatin1(decoded.decoded.toBase64(
+			QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals)) != encoded
+		|| decoded.decoded[0] != char(2)) return std::nullopt;
+	const auto header = SealedRichPartHeader{
+		.group = decoded.decoded.mid(1, 32),
+		.index = uchar(decoded.decoded[33]),
+		.count = uchar(decoded.decoded[34]),
+	};
+	if (!HeaderAllowed(header)) return std::nullopt;
+	return Token{ header, decoded.decoded.left(kHeaderSize), decoded.decoded.mid(kHeaderSize) };
+}
+
+[[nodiscard]] QByteArray PartContext(const QByteArray &context, const QByteArray &header) {
+	auto result = QByteArray("tele sealed rich context v2");
+	result.append(context);
+	result.append(header);
+	return result;
+}
+
+[[nodiscard]] QByteArray MergeBinding(
+		const QByteArray &context,
+		const QByteArray &sender,
+		const QByteArray &recipient) {
+	auto result = QByteArray("tele sealed rich merge v2");
+	result.append(context);
+	result.append(sender);
+	result.append(recipient);
+	return Digest(result);
+}
+
+[[nodiscard]] bool FragmentAllowed(const SealedRichPart &part) {
+	if (!HeaderAllowed(part.header) || part.size < kRichMinimum
+		|| part.size > kSealedRichPayloadLimit || part.digest.size() != 64
+		|| part.binding.size() != 64
+		|| (part.size + kSealedRichFragmentLimit - 1) / kSealedRichFragmentLimit != quint32(part.header.count)) return false;
+	const auto expected = std::min(quint32(kSealedRichFragmentLimit),
+		part.size - quint32(part.header.index * kSealedRichFragmentLimit));
+	return part.bytes.size() == expected;
+}
+
+}
+
+bool ValidateSealedRichText(const SealedRichText &text) {
+	auto encoded = Encode(text);
+	if (!encoded) return false;
+	Cleanse(*encoded);
+	return true;
+}
+
+std::optional<QByteArray> EncodeSealedRichText(const SealedRichText &text) {
+	return Encode(text);
+}
+
+std::optional<SealedRichText> DecodeSealedRichText(const QByteArray &payload) {
+	if (payload.size() < kRichMinimum || payload.size() > kSealedRichPayloadLimit
+		|| !payload.startsWith(QByteArray(kRichMagic, kRichMagicSize))
+		|| payload[kRichMagicSize] != char(1)) return std::nullopt;
+	auto reader = Reader(payload);
+	if (!reader.take(kRichMagicSize + 1)) return std::nullopt;
+	const auto textSize = reader.read32();
+	if (!textSize || !*textSize || *textSize > kSealedRichPayloadLimit) return std::nullopt;
+	const auto utf8 = reader.take(*textSize);
+	if (!utf8) return std::nullopt;
+	auto result = SealedRichText{ .text = QString::fromUtf8(*utf8) };
+	if (result.text.toUtf8() != *utf8 || !StrictUnicode(result.text)) return std::nullopt;
+	const auto dictionarySize = reader.read16();
+	if (!dictionarySize || *dictionarySize > kSealedRichDictionaryLimit) return std::nullopt;
+	auto dictionary = std::vector<QString>();
+	dictionary.reserve(*dictionarySize);
+	for (auto i = 0; i < *dictionarySize; ++i) {
+		const auto size = reader.read16();
+		if (!size || !*size || *size > kSealedRichTagIdLimit) return std::nullopt;
+		const auto id = reader.take(*size);
+		if (!id) return std::nullopt;
+		const auto parsed = QString::fromUtf8(*id);
+		if (parsed.toUtf8() != *id) return std::nullopt;
+		dictionary.push_back(parsed);
+	}
+	const auto tags = reader.read16();
+	if (!tags || *tags > kSealedRichTagLimit) return std::nullopt;
+	result.tags.reserve(*tags);
+	for (auto i = 0; i < *tags; ++i) {
+		const auto offset = reader.read32();
+		const auto length = reader.read32();
+		const auto id = reader.read16();
+		if (!offset || !length || !id || *id >= dictionary.size()
+			|| *offset > quint32(result.text.size()) || *length > quint32(result.text.size()) - *offset) return std::nullopt;
+		result.tags.push_back({ int(*offset), int(*length), dictionary[*id] });
+	}
+	if (!reader.ended()) return std::nullopt;
+	auto encoded = Encode(result);
+	if (!encoded) return std::nullopt;
+	const auto wipe = ByteWiper{ *encoded };
+	return *encoded == payload ? std::make_optional(std::move(result)) : std::nullopt;
+}
+
+std::optional<std::vector<QString>> EncryptSealedRichParts(
+		const QByteArray &senderPrivateKey,
+		const QByteArray &recipientPublicKey,
+		const SealedRichText &text,
+		const QByteArray &context) {
+	if (!ContextAllowed(context)) return std::nullopt;
+	auto payload = Encode(text);
+	if (!payload) return std::nullopt;
+	const auto wipe = ByteWiper{ *payload };
+	if (text.tags.empty() && text.text.toUtf8().size() <= kSealedPlaintextLimit) {
+		const auto encrypted = SealedEncrypt(senderPrivateKey, recipientPublicKey, text.text.toUtf8(), context);
+		return encrypted ? std::make_optional(std::vector<QString>{ FormatSealedEnvelope(*encrypted) }) : std::nullopt;
+	}
+	auto group = QByteArray(32, Qt::Uninitialized);
+	if (RAND_bytes(reinterpret_cast<unsigned char*>(group.data()), int(group.size())) != 1 || !Nonzero(group)) return std::nullopt;
+	const auto digest = Digest(*payload);
+	const auto count = int((payload->size() + kSealedRichFragmentLimit - 1) / kSealedRichFragmentLimit);
+	auto result = std::vector<QString>();
+	result.reserve(count);
+	for (auto index = 0; index < count; ++index) {
+		const auto header = EncodeHeader({ group, index, count });
+		auto fragment = QByteArray();
+		Append32(fragment, quint32(payload->size()));
+		fragment.append(digest);
+		fragment.append(payload->mid(index * kSealedRichFragmentLimit, kSealedRichFragmentLimit));
+		const auto wipeFragment = ByteWiper{ fragment };
+		const auto encrypted = SealedEncrypt(senderPrivateKey, recipientPublicKey, fragment, PartContext(context, header));
+		if (!encrypted) return std::nullopt;
+		result.push_back(QString::fromLatin1(kPrefix) + QString::fromLatin1((header + *encrypted).toBase64(
+			QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals)));
+	}
+	return result;
+}
+
+std::optional<SealedRichPartHeader> ParseSealedRichPartHeader(const QString &token) {
+	const auto parsed = ParseToken(token);
+	return parsed ? std::make_optional(parsed->header) : std::nullopt;
+}
+
+std::optional<SealedRichPart> DecryptSealedRichPart(
+		const QByteArray &recipientPrivateKey,
+		const QByteArray &expectedSenderPublicKey,
+		const QString &token,
+		const QByteArray &context) {
+	if (!ContextAllowed(context)) return std::nullopt;
+	const auto parsed = ParseToken(token);
+	if (!parsed) return std::nullopt;
+	auto plain = SealedDecrypt(recipientPrivateKey, expectedSenderPublicKey,
+		parsed->envelope, PartContext(context, parsed->headerBytes));
+	if (!plain) return std::nullopt;
+	const auto wipe = ByteWiper{ *plain };
+	if (plain->size() <= kFragmentMetadataSize) return std::nullopt;
+	const auto own = DeriveSealedPublicKey(recipientPrivateKey);
+	if (!own) return std::nullopt;
+	auto result = SealedRichPart{
+		.header = parsed->header,
+		.size = qFromBigEndian<quint32>(reinterpret_cast<const uchar*>(plain->constData())),
+		.digest = plain->mid(4, 64),
+		.binding = MergeBinding(context, expectedSenderPublicKey, *own),
+		.bytes = plain->mid(kFragmentMetadataSize),
+	};
+	return FragmentAllowed(result) ? std::make_optional(std::move(result)) : std::nullopt;
+}
+
+std::optional<SealedRichText> MergeSealedRichParts(const std::vector<SealedRichPart> &parts) {
+	if (parts.empty() || parts.size() > kSealedRichPartLimit
+		|| !FragmentAllowed(parts.front()) || parts.size() != size_t(parts.front().header.count)) return std::nullopt;
+	const auto &first = parts.front();
+	auto ordered = std::array<const SealedRichPart*, kSealedRichPartLimit>();
+	for (const auto &part : parts) {
+		if (!FragmentAllowed(part) || part.header.group != first.header.group
+			|| part.header.count != first.header.count || part.size != first.size
+			|| !EqualDigest(part.digest, first.digest) || !EqualDigest(part.binding, first.binding)
+			|| ordered[part.header.index]) return std::nullopt;
+		ordered[part.header.index] = &part;
+	}
+	auto payload = QByteArray();
+	payload.reserve(first.size);
+	const auto wipe = ByteWiper{ payload };
+	for (auto i = 0; i < first.header.count; ++i) {
+		if (!ordered[i]) return std::nullopt;
+		payload.append(ordered[i]->bytes);
+	}
+	if (payload.size() != first.size || !EqualDigest(Digest(payload), first.digest)) return std::nullopt;
+	return DecodeSealedRichText(payload);
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_text.h b/Telegram/SourceFiles/tele/tele_sealed_text.h
new file mode 100644
index 0000000000000000000000000000000000000000..f9d339e7097d8e1a3c3d43d003075f131cb91991
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_text.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "tele/tele_sealed_crypto.h"
+
+#include <QtCore/QByteArray>
+#include <QtCore/QString>
+
+#include <optional>
+#include <vector>
+
+namespace Tele {
+
+inline constexpr auto kSealedRichPartLimit = 64;
+inline constexpr auto kSealedRichFragmentLimit = kSealedPlaintextLimit - 68;
+inline constexpr auto kSealedRichPayloadLimit = kSealedRichFragmentLimit * kSealedRichPartLimit;
+inline constexpr auto kSealedRichTagLimit = 1024;
+inline constexpr auto kSealedRichTagIdLimit = 2048;
+inline constexpr auto kSealedRichDictionaryLimit = 256;
+
+struct SealedRichTag {
+	int offset = 0;
+	int length = 0;
+	QString id;
+
+	friend bool operator==(const SealedRichTag&, const SealedRichTag&) = default;
+};
+
+struct SealedRichText {
+	QString text;
+	std::vector<SealedRichTag> tags;
+
+	friend bool operator==(const SealedRichText&, const SealedRichText&) = default;
+};
+
+struct SealedRichPartHeader {
+	QByteArray group;
+	int index = 0;
+	int count = 0;
+
+	friend bool operator==(const SealedRichPartHeader&, const SealedRichPartHeader&) = default;
+};
+
+struct SealedRichPart {
+	SealedRichPartHeader header;
+	quint32 size = 0;
+	QByteArray digest;
+	QByteArray binding;
+	QByteArray bytes;
+};
+
+[[nodiscard]] bool ValidateSealedRichText(const SealedRichText &text);
+[[nodiscard]] std::optional<QByteArray> EncodeSealedRichText(const SealedRichText &text);
+[[nodiscard]] std::optional<SealedRichText> DecodeSealedRichText(const QByteArray &payload);
+[[nodiscard]] std::optional<std::vector<QString>> EncryptSealedRichParts(
+	const QByteArray &senderPrivateKey,
+	const QByteArray &recipientPublicKey,
+	const SealedRichText &text,
+	const QByteArray &context);
+[[nodiscard]] std::optional<SealedRichPartHeader> ParseSealedRichPartHeader(
+	const QString &token);
+[[nodiscard]] std::optional<SealedRichPart> DecryptSealedRichPart(
+	const QByteArray &recipientPrivateKey,
+	const QByteArray &expectedSenderPublicKey,
+	const QString &token,
+	const QByteArray &context);
+[[nodiscard]] std::optional<SealedRichText> MergeSealedRichParts(
+	const std::vector<SealedRichPart> &parts);
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_upload.cpp b/Telegram/SourceFiles/tele/tele_sealed_upload.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d3067595a8c54816c21daf8408a0f99a7db4c367
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_upload.cpp
@@ -0,0 +1,410 @@
+#include "tele/tele_sealed_upload.h"
+
+#include "api/api_common.h"
+#include "apiwrap.h"
+#include "base/weak_ptr.h"
+#include "base/timer.h"
+#include "core/application.h"
+#include "crl/crl_on_main.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "main/main_session.h"
+#include "storage/localimageloader.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_sealed_auto.h"
+#include "tele/tele_sealed_files.h"
+#include "tele/tele_sealed_parts.h"
+#include "tele/tele_sealed_rich_send.h"
+#include "tele/tele_sealed_text.h"
+#include "tele/tele_sealed_send.h"
+#include "ui/chat/attach/attach_prepare.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+
+#include <QtCore/QBuffer>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QMimeDatabase>
+
+#include <openssl/crypto.h>
+
+#include <atomic>
+
+namespace Tele {
+namespace {
+
+constexpr auto kBatchFiles = 4;
+constexpr auto kBatchBytes = int64(32 * 1024 * 1024);
+constexpr auto kImagePixels = int64(16 * 1024 * 1024);
+constexpr auto kHeldImageBytes = int64(64 * 1024 * 1024);
+constexpr auto kCiphertextBytes = qsizetype(34 * 1024 * 1024);
+bool Busy = false;
+
+void Cleanse(QByteArray &bytes) {
+	if (!bytes.isEmpty()) OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+	bytes.clear();
+}
+
+void Cleanse(TextWithTags &text) {
+	if (!text.text.isEmpty()) OPENSSL_cleanse(text.text.data(), size_t(text.text.size()) * sizeof(QChar));
+	text.text.clear();
+	for (auto &tag : text.tags) {
+		if (!tag.id.isEmpty()) OPENSSL_cleanse(tag.id.data(), size_t(tag.id.size()) * sizeof(QChar));
+	}
+	text.tags.clear();
+}
+
+struct Source {
+	QString path;
+	QString name;
+	QByteArray bytes;
+	TextWithTags caption;
+	QImage image;
+	SealedFilePresentation presentation = SealedFilePresentation::Document;
+	std::shared_ptr<const QString> temporaryPath;
+
+	~Source() {
+		Cleanse(bytes);
+		Cleanse(caption);
+	}
+};
+
+struct Job {
+	std::atomic_bool canceled = false;
+	rpl::lifetime lifetime;
+	std::vector<std::unique_ptr<Source>> sources;
+};
+
+struct Encrypted {
+	QByteArray file;
+	TextWithTags caption;
+
+	~Encrypted() {
+		Cleanse(caption);
+	}
+};
+
+struct Dispatch {
+	explicit Dispatch(const Api::SendAction &action) : send(action) {
+	}
+
+	Api::SendAction send;
+	base::weak_ptr<History> history;
+	uint64 epoch = 0;
+	QByteArray own;
+	QByteArray remote;
+	std::vector<Encrypted> files;
+	std::vector<std::optional<Api::MessageToSend>> captions;
+	size_t index = 0;
+	size_t fileIndex = 0;
+	base::Timer timeout;
+	rpl::lifetime lifetime;
+};
+
+std::shared_ptr<Dispatch> Dispatching;
+
+void Toast(not_null<History*> history, const QString &text) {
+	if (const auto window = Core::App().windowFor(history->peer)) {
+		if (const auto controller = window->sessionController()) {
+			if (&controller->session() == &history->session()) controller->showToast(text);
+		}
+	}
+}
+
+void EndDispatch(const std::shared_ptr<Dispatch> &state) {
+	if (Dispatching == state) Dispatching.reset();
+}
+
+bool DispatchValid(const std::shared_ptr<Dispatch> &state) {
+	if (Dispatching != state || !state->history || state->epoch != SealedAutomaticEpoch()) return false;
+	const auto keys = SealedAutomaticKeys(state->history.get(), SealedKeyPurpose::Send);
+	return keys && keys->identity.publicKey == state->own && keys->peerKey == state->remote;
+}
+
+void FailDispatch(const std::shared_ptr<Dispatch> &state) {
+	if (DispatchValid(state)) {
+		Toast(state->history.get(), Lower(u"The encrypted upload stopped. Choose the remaining files again."_q));
+	}
+	EndDispatch(state);
+}
+
+bool SendDispatchFile(const std::shared_ptr<Dispatch> &state) {
+	if (!DispatchValid(state) || state->fileIndex >= state->files.size()) return false;
+	auto &encrypted = state->files[state->fileIndex];
+	const auto history = state->history.get();
+	if (!HasSealedFileContentAuthorization(history, encrypted.file)) return false;
+	auto output = Ui::PreparedList();
+	auto file = Ui::PreparedFile(QString());
+	file.size = encrypted.file.size();
+	file.content = std::move(encrypted.file);
+	file.displayName = u"message.teleenc"_q;
+	file.type = Ui::PreparedFile::Type::File;
+	output.files.push_back(std::move(file));
+	++state->fileIndex;
+	history->session().api().sendFiles(std::move(output), SendMediaType::File, nullptr, state->send);
+	return true;
+}
+
+void AdvanceDispatch(const std::shared_ptr<Dispatch> &state) {
+	if (!DispatchValid(state)) { EndDispatch(state); return; }
+	while (state->index < state->captions.size()) {
+		if (state->captions[state->index]) {
+			auto message = std::move(*state->captions[state->index]);
+			state->captions[state->index].reset();
+			const auto weak = std::weak_ptr<Dispatch>(state);
+			if (!AfterSealedRichSend(state->history.get(), message.textWithTags.text, [weak] {
+				if (const auto state = weak.lock()) {
+					++state->index;
+					AdvanceDispatch(state);
+				}
+			})) { FailDispatch(state); return; }
+			state->history->session().api().sendMessage(std::move(message));
+			return;
+		}
+		++state->index;
+	}
+	while (state->fileIndex < state->files.size()) {
+		if (!SendDispatchFile(state)) { FailDispatch(state); return; }
+	}
+	EndDispatch(state);
+}
+
+class BoundedImageBuffer final : public QBuffer {
+public:
+	explicit BoundedImageBuffer(QByteArray *bytes) : QBuffer(bytes) {
+	}
+
+protected:
+	qint64 writeData(const char *data, qint64 size) override {
+		return size >= 0 && pos() >= 0 && pos() <= kSealedFilePayloadLimit
+			&& size <= kSealedFilePayloadLimit - pos()
+			? QBuffer::writeData(data, size) : qint64(-1);
+	}
+};
+
+std::optional<QByteArray> Read(Source &source) {
+	if (!source.image.isNull()) {
+		const auto image = source.presentation == SealedFilePresentation::Image
+			&& (source.image.width() > kSealedPhotoSideLimit
+				|| source.image.height() > kSealedPhotoSideLimit)
+			? source.image.scaled(kSealedPhotoSideLimit, kSealedPhotoSideLimit,
+				Qt::KeepAspectRatio, Qt::SmoothTransformation)
+			: source.image;
+		auto bytes = QByteArray();
+		const auto clear = gsl::finally([&] { Cleanse(bytes); });
+		auto buffer = BoundedImageBuffer(&bytes);
+		return buffer.open(QIODevice::WriteOnly) && image.save(&buffer, "PNG")
+			&& bytes.size() <= kSealedFilePayloadLimit
+			? std::make_optional(std::move(bytes)) : std::nullopt;
+	} else if (source.path.isEmpty()) {
+		return std::move(source.bytes);
+	}
+	if (!QFileInfo(source.path).isFile()) return std::nullopt;
+	auto file = QFile(source.path);
+	if (!file.open(QIODevice::ReadOnly) || file.size() < 0 || file.size() > kSealedFilePayloadLimit) return std::nullopt;
+	auto bytes = file.read(kSealedFilePayloadLimit + 1);
+	if (file.error() == QFileDevice::NoError && file.atEnd() && bytes.size() <= kSealedFilePayloadLimit) return bytes;
+	Cleanse(bytes);
+	return std::nullopt;
+}
+
+std::optional<std::vector<Encrypted>> Encrypt(
+		const std::shared_ptr<Job> &job,
+		const SealedContactKeys &keys,
+		const QByteArray &context) {
+	auto result = std::vector<Encrypted>();
+	auto total = int64();
+	auto payloadTotal = int64();
+	for (const auto &source : job->sources) {
+		if (job->canceled.load()) return std::nullopt;
+		auto bytes = Read(*source);
+		if (!bytes) return std::nullopt;
+		const auto clear = gsl::finally([&] { Cleanse(*bytes); });
+		total += bytes->size();
+		if (total > kBatchBytes || job->canceled.load()) return std::nullopt;
+		const auto photo = QMimeDatabase().mimeTypeForData(*bytes).name().startsWith(u"image/"_q);
+		auto payload = PrepareSealedFilePayload(source->name, *bytes, photo, source->presentation);
+		if (!payload || job->canceled.load()) return std::nullopt;
+		const auto clearPayload = gsl::finally([&] { Cleanse(*payload); });
+		payloadTotal += payload->size();
+		if (payloadTotal > kBatchBytes) return std::nullopt;
+		auto file = SealedEncryptFile(keys.identity.privateKey, keys.peerKey, *payload, context);
+		if (!file || job->canceled.load()) return std::nullopt;
+		result.push_back({ std::move(*file), source->caption });
+	}
+	return result;
+}
+
+}
+
+bool InterceptSealedClipboardUpload(
+		not_null<Main::Session*> session,
+		const QByteArray &content,
+		SendMediaType type,
+		const Api::SendAction &action) {
+	if (!SealedAutomaticSelected(action.history)) return false;
+	auto list = Ui::PreparedList();
+	auto file = Ui::PreparedFile(QString());
+	file.content = content;
+	file.size = content.size();
+	file.displayName = type == SendMediaType::Photo ? u"photo.png"_q : u"file"_q;
+	file.type = type == SendMediaType::Photo
+		? Ui::PreparedFile::Type::Photo : Ui::PreparedFile::Type::File;
+	list.files.push_back(std::move(file));
+	return InterceptSealedUploads(session, list, type, action);
+}
+
+bool InterceptSealedUploads(
+		not_null<Main::Session*> session,
+		Ui::PreparedList &list,
+		SendMediaType type,
+		const Api::SendAction &action) {
+	const auto history = action.history;
+	if (!SealedAutomaticSelected(history)) return false;
+	if (&history->session() != session) {
+		Toast(history, Lower(u"Encryption is unavailable. Nothing was sent."_q));
+		return true;
+	}
+	if (list.files.size() == 1
+		&& list.files.front().content.size() <= kCiphertextBytes
+		&& HasSealedFileContentAuthorization(history, list.files.front().content)) return false;
+	auto keys = SealedAutomaticKeys(history, SealedKeyPurpose::Send);
+	if (!keys || !SealedSendOptionsAllowed(action) || action.replyTo) {
+		Toast(history, Lower(u"Encryption is unavailable. Nothing was sent."_q));
+		return true;
+	} else if (Busy || Dispatching) {
+		Toast(history, Lower(u"Wait for the current encrypted upload to finish preparing."_q));
+		return true;
+	} else if (list.error != Ui::PreparedList::Error::None || !list.filesToProcess.empty()
+		|| list.files.empty() || list.files.size() > kBatchFiles) {
+		Toast(history, Lower(u"Send up to four files at a time with automatic encryption."_q));
+		return true;
+	}
+	auto job = std::make_shared<Job>();
+	auto total = int64();
+	auto heldImages = int64();
+	for (auto &file : list.files) {
+		const auto size = file.path.isEmpty() ? int64(file.content.size()) : QFileInfo(file.path).size();
+		const auto image = file.information
+			? std::get_if<Ui::PreparedFileInformation::Image>(&file.information->media) : nullptr;
+		const auto video = file.information
+			? std::get_if<Ui::PreparedFileInformation::Video>(&file.information->media) : nullptr;
+		if (size < 0 || size > kSealedFilePayloadLimit || file.archive || file.animationJob
+			|| (!file.path.isEmpty() && !QFileInfo(file.path).isFile())
+			|| file.ttlSeconds || file.videoCover || (image && (!image->modifications.empty() || image->animated))
+			|| (video && (!video->modifications.geometry.empty()
+				|| video->modifications.from > 0 || video->modifications.cover > 0
+				|| (video->modifications.till > 0 && video->modifications.till < video->duration)
+				|| video->modifications.quality > 0 || video->modifications.gif
+				|| !video->modifications.canvasMediaRect.isEmpty()))) {
+			Toast(history, Lower(u"This attachment needs to be saved as an ordinary file before it can be encrypted."_q));
+			return true;
+		}
+		const auto pixels = image ? int64(image->data.width()) * image->data.height() : 0;
+		const auto imageBytes = image ? int64(image->data.sizeInBytes()) : 0;
+		auto caption = SealedRichText();
+		if ((!file.caption.text.isEmpty() || !file.caption.tags.isEmpty())
+			&& (!SealedRichFromNative(file.caption, caption) || !ValidateSealedRichText(caption))) {
+			Toast(history, Lower(u"This formatting cannot be encrypted safely."_q));
+			return true;
+		}
+		if (pixels > kImagePixels) {
+			Toast(history, Lower(u"Encrypted files are limited to 16 MiB each and 32 MiB per batch."_q));
+			return true;
+		}
+		total += size;
+		if (image && file.path.isEmpty() && file.content.isEmpty()) heldImages += imageBytes;
+		if (total > kBatchBytes || heldImages > kHeldImageBytes) {
+			Toast(history, Lower(u"Encrypted files are limited to 16 MiB each and 32 MiB per batch."_q));
+			return true;
+		}
+		auto source = std::make_unique<Source>();
+		source->presentation = (type == SendMediaType::Photo
+			&& file.type == Ui::PreparedFile::Type::Photo)
+			? SealedFilePresentation::Image
+			: SealedFilePresentation::Document;
+		source->path = file.path;
+		source->name = file.displayName.isEmpty() ? QFileInfo(file.path).fileName() : file.displayName;
+		if (source->name.isEmpty()) source->name = u"file"_q;
+		if (source->path.isEmpty()) source->bytes = file.content;
+		source->caption = file.caption;
+		source->temporaryPath = file.temporaryPath;
+		if (image && source->path.isEmpty() && source->bytes.isEmpty()) source->image = image->data;
+		job->sources.push_back(std::move(source));
+	}
+	const auto weak = base::make_weak(history);
+	const auto epoch = SealedAutomaticEpoch();
+	const auto own = keys->identity.publicKey;
+	const auto remote = keys->peerKey;
+	const auto silent = action.options.silent;
+	const auto context = SealedContext(session, session->userId().bare, peerToUser(history->peer->id).bare);
+	const auto weakJob = std::weak_ptr<Job>(job);
+	SealedAutomaticChanges() | rpl::on_next([weakJob, epoch] {
+		if (const auto pending = weakJob.lock(); pending && SealedAutomaticEpoch() != epoch) {
+			pending->canceled.store(true);
+		}
+	}, job->lifetime);
+	Core::App().passcodeLockChanges() | rpl::on_next([weakJob](bool locked) {
+		if (const auto pending = weakJob.lock(); locked && pending) pending->canceled.store(true);
+	}, job->lifetime);
+	Busy = true;
+	crl::async([=, keys = std::move(*keys)] {
+		auto result = Encrypt(job, keys, context);
+		crl::on_main(&Core::App(), [=, result = std::move(result)]() mutable {
+			Busy = false;
+			job->lifetime.destroy();
+			job->sources.clear();
+			const auto valid = [&] {
+				if (!weak || job->canceled.load() || SealedAutomaticEpoch() != epoch) return false;
+				const auto current = SealedAutomaticKeys(weak.get(), SealedKeyPurpose::Send);
+				return current && current->identity.publicKey == own && current->peerKey == remote;
+			};
+			if (!valid()) return;
+			if (!result) {
+				Toast(weak.get(), Lower(u"The file could not be read, sanitized or encrypted within the size limit."_q));
+				return;
+			}
+			auto send = Api::SendAction(weak.get());
+			send.clearDraft = false;
+			send.options.silent = silent;
+			auto captions = std::vector<std::optional<Api::MessageToSend>>();
+			captions.reserve(result->size());
+			for (auto &encrypted : *result) {
+				if (!valid()) return;
+				if (!AuthorizeSealedFileContent(weak.get(), encrypted.file)) {
+					Toast(weak.get(), Lower(u"Wait for the queued encrypted messages to finish."_q));
+					return;
+				}
+				auto caption = std::optional<Api::MessageToSend>();
+				if (!encrypted.caption.text.isEmpty()) {
+					caption.emplace(send);
+					caption->textWithTags = std::move(encrypted.caption);
+					if (PrepareSealedSend(*caption)) return;
+				}
+				captions.push_back(std::move(caption));
+			}
+			if (!valid()) return;
+			auto state = std::make_shared<Dispatch>(send);
+			state->history = weak;
+			state->epoch = epoch;
+			state->own = own;
+			state->remote = remote;
+			state->files = std::move(*result);
+			state->captions = std::move(captions);
+			const auto weakState = std::weak_ptr<Dispatch>(state);
+			SealedAutomaticChanges() | rpl::on_next([weakState] {
+				if (const auto state = weakState.lock(); state && !DispatchValid(state)) EndDispatch(state);
+			}, state->lifetime);
+			state->timeout.setCallback([weakState] {
+				if (const auto state = weakState.lock()) FailDispatch(state);
+			});
+			state->timeout.callOnce(90 * 1000);
+			Dispatching = state;
+			AdvanceDispatch(state);
+		});
+	});
+	return true;
+}
+
+}
