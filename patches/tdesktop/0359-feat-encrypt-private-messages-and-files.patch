diff --git a/Telegram/SourceFiles/tele/tele_sealed_duress.cpp b/Telegram/SourceFiles/tele/tele_sealed_duress.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1f34ff1b9f7175b75d406e0a2a9ef51816475bf4
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_duress.cpp
@@ -0,0 +1,282 @@
+#include "tele/tele_sealed_duress.h"
+#include "tele/tele_sealed_auto.h"
+
+#include "core/application.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "storage/storage_account.h"
+#include "storage/storage_domain.h"
+#include "tele/tele_sealed_store.h"
+#include "tele/tele_sealed_codes.h"
+#include "tele/tele_sealed_duress_signouts.h"
+#include "tele/tele_sealed_passcode_gate.h"
+#include "tele/tele_options.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDir>
+#include <QtCore/QFileInfo>
+
+#include <openssl/crypto.h>
+
+#include <algorithm>
+
+namespace Tele {
+namespace {
+
+QString ProfileName;
+bool EmergencyBlocked = false;
+rpl::event_stream<> Changes;
+
+struct Attempt {
+	Attempt(Storage::PasscodeDerivation value, const QByteArray &typed);
+	~Attempt();
+
+	std::optional<Storage::PasscodeDerivation> job;
+	QByteArray password;
+};
+
+Attempt::Attempt(Storage::PasscodeDerivation value, const QByteArray &typed)
+: job(std::move(value))
+, password(typed.constData(), typed.size()) {
+}
+
+Attempt::~Attempt() {
+	if (!password.isEmpty()) {
+		OPENSSL_cleanse(password.data(), size_t(password.size()));
+	}
+}
+
+[[nodiscard]] bool Matches(
+		const SealedDuressAccount &account,
+		const QString &directory) {
+	return account.relativeDirectory == directory;
+}
+
+[[nodiscard]] bool PendingCleanup(const SealedDuressState &state) {
+	return std::ranges::any_of(state.accounts, [](const auto &account) {
+		return account.cleanupPending;
+	});
+}
+
+[[nodiscard]] SealedDuressResult Registered(
+		not_null<Main::Session*> session) {
+	auto result = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	if (!result.state || result.error != SealedDuressError::None) {
+		return result;
+	}
+	const auto directory = SealedDuressDirectory(session);
+	const auto &accounts = result.state->accounts;
+	if (std::ranges::any_of(accounts, [&](const auto &account) {
+			return Matches(account, directory);
+		}) || (!result.state->armed && !result.state->quarantined)) {
+		return result;
+	}
+	return RegisterSealedDuressAccount(
+		SealedDuressRoot(),
+		SealedDuressContext(),
+		directory,
+		result.state->generation);
+}
+
+}
+
+void StartSealedDuress(
+		not_null<Main::Domain*> domain,
+		const QString &dataName,
+		rpl::lifetime &lifetime) {
+	ProfileName = dataName;
+	EmergencyBlocked = false;
+	StartSealedCodeMode(domain, lifetime);
+	StartSealedAutomatic(domain, lifetime);
+	StartSealedDuressSignouts(domain, lifetime);
+	domain->local().localPasscodeChanged() | rpl::on_next([] {
+		const auto state = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+		if (state.state && state.state->armed) {
+			const auto disabled = DisableSealedDuressForProfile();
+			(void)disabled;
+		}
+	}, lifetime);
+	const auto state = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	if (state.state && PendingCleanup(*state.state)) {
+		const auto result = RetrySealedDuressCleanup(
+			SealedDuressRoot(),
+			SealedDuressContext(),
+			state.state->generation);
+		EmergencyBlocked = !result.state;
+	}
+	crl::on_main(domain, [] {
+		const auto loaded = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+		if (loaded.state && !loaded.state->activationId.isEmpty()) {
+			ActivateSealedCodeMode(loaded.state->activationId, loaded.state->activatedAtUTC);
+			TriggerSealedDuressSignouts(loaded.state->activationId);
+		}
+		NotifySealedDuressUpdate();
+	});
+}
+
+void DerivePasscodeWithDuress(
+		Storage::PasscodeDerivation job,
+		const QByteArray &typedUtf8,
+		Fn<void(Storage::PasscodeDerivation&&, Fn<bool(bool)>)> normalDone) {
+	const auto loaded = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	if (loaded.error != SealedDuressError::None
+		|| !loaded.state || !loaded.state->armed) {
+		Storage::DeriveOnWorker(std::move(job), [done = std::move(normalDone)](
+				Storage::PasscodeDerivation &&derived) mutable {
+			done(std::move(derived), [](bool correct) { return correct; });
+		});
+		return;
+	}
+	const auto attempt = std::make_shared<Attempt>(std::move(job), typedUtf8);
+	const auto root = SealedDuressRoot();
+	const auto context = SealedDuressContext();
+	const auto state = *loaded.state;
+	const auto domain = &Core::App().domain();
+	const auto weakDomain = base::make_weak(domain);
+	const auto wasStarted = domain->started();
+	auto publish = crl::guard(domain, [=,
+		normalDone = std::move(normalDone)](bool matched) mutable {
+		if (Core::Quitting()) {
+			return;
+		}
+		const auto gate = std::make_shared<SealedPasscodeGate>();
+		auto finalize = [=](bool correct) {
+			if (correct) {
+				if (matched) {
+					const auto disabled = DisableSealedDuressForProfile();
+					(void)disabled;
+				}
+				return true;
+			} else if (!gate->mayTrigger(correct, matched)
+				|| !weakDomain || Core::Quitting()
+				|| wasStarted != weakDomain->started()
+				|| !Core::App().passcodeLocked()) {
+				return false;
+			}
+			const auto result = TriggerSealedDuress(root, context, state.generation);
+			if (result.error != SealedDuressError::Changed) {
+				const auto persisted = (result.error == SealedDuressError::None
+					|| result.error == SealedDuressError::CleanupFailed)
+					&& result.state && result.state->activationId.size() == 16
+					&& result.state->activationId != state.activationId;
+				EmergencyBlocked = !persisted;
+				if (persisted) {
+					ActivateSealedCodeMode(result.state->activationId, result.state->activatedAtUTC);
+					TriggerSealedDuressSignouts(result.state->activationId);
+				}
+				NotifySealedDuressUpdate();
+			}
+			return false;
+		};
+		const auto scope = SealedPasscodeGateScope(*gate);
+		normalDone(std::move(*attempt->job), std::move(finalize));
+		attempt->job.reset();
+	});
+	crl::async([=, publish = std::move(publish)]() mutable {
+		const auto matched = CheckSealedDuressVerifier(
+			attempt->password,
+			context,
+			state.verifier);
+		OPENSSL_cleanse(attempt->password.data(), size_t(attempt->password.size()));
+		attempt->password.clear();
+		attempt->job->run();
+		crl::on_main([publish = std::move(publish), matched]() mutable {
+			publish(matched);
+		});
+	});
+}
+
+QString SealedDuressRoot() {
+	return QDir::cleanPath(cWorkingDir() + u"tdata"_q);
+}
+
+QByteArray SealedDuressContext() {
+	return QByteArray("tele sealed duress profile v1")
+		+ QCryptographicHash::hash(ProfileName.toUtf8(), QCryptographicHash::Sha512);
+}
+
+QString SealedDuressDirectory(not_null<Main::Session*> session) {
+	return QDir(SealedDuressRoot()).relativeFilePath(
+		QFileInfo(session->local().supportModePath()).absolutePath());
+}
+
+SealedStoreError CheckSealedDuressStorage(not_null<Main::Session*> session) {
+	if (EmergencyBlocked) {
+		return SealedStoreError::DuressBlocked;
+	}
+	const auto result = Registered(session);
+	if (result.error == SealedDuressError::Missing) {
+		return SealedStoreError::None;
+	} else if (result.error != SealedDuressError::None || !result.state) {
+		return SealedStoreError::Unavailable;
+	}
+	const auto directory = SealedDuressDirectory(session);
+	for (const auto &account : result.state->accounts) {
+		if (Matches(account, directory)) {
+			return account.blocked
+				? SealedStoreError::DuressBlocked
+				: SealedStoreError::None;
+		}
+	}
+	return result.state->quarantined
+		? SealedStoreError::DuressBlocked
+		: SealedStoreError::None;
+}
+
+bool SealedDuressBlocked(not_null<Main::Session*> session) {
+	return CheckSealedDuressStorage(session) == SealedStoreError::DuressBlocked;
+}
+
+SealedStoreError RecoverSealedDuressStorage(
+		not_null<Main::Session*> session,
+		Fn<bool()> authenticatedWriter) {
+	if (EmergencyBlocked) {
+		return SealedStoreError::Unavailable;
+	}
+	const auto loaded = Registered(session);
+	if (!loaded.state || loaded.error != SealedDuressError::None) {
+		return SealedStoreError::Unavailable;
+	}
+	const auto result = RecoverSealedDuressAccount(
+		SealedDuressRoot(),
+		SealedDuressContext(),
+		SealedDuressDirectory(session),
+		loaded.state->generation,
+		[&] { return authenticatedWriter(); });
+	if (result.error != SealedDuressError::None) {
+		return SealedStoreError::WriteFailed;
+	}
+	NotifySealedDuressUpdate();
+	return SealedStoreError::None;
+}
+
+SealedDuressResult DisableSealedDuressForProfile() {
+	const auto loaded = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	if (!loaded.state || loaded.error != SealedDuressError::None) {
+		return loaded;
+	}
+	const auto result = SetSealedDuressArmed(
+		SealedDuressRoot(),
+		SealedDuressContext(),
+		false,
+		loaded.state->generation);
+	if (result.error == SealedDuressError::None) {
+		NotifySealedDuressUpdate();
+	}
+	return result;
+}
+
+rpl::producer<> SealedDuressChanges() {
+	return Changes.events();
+}
+
+void NotifySealedDuressUpdate() {
+	crl::on_main(&Core::App(), [] {
+		const auto loaded = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+		SetSealedDuressEnabled(loaded.state && loaded.state->armed);
+		Changes.fire({});
+	});
+}
+
+}
