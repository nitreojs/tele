+#include "window/window_session_controller.h"
+#include "styles/style_chat.h"
+#include "styles/style_layers.h"
+
+#include <QtCore/QPointer>
+#include <QtCore/QSaveFile>
+
+#include <algorithm>
+#include <set>
+#include <utility>
+#include <vector>
+
+namespace Tele {
+namespace {
+
+class SealedPhoto;
+std::set<SealedPhoto*> Views;
+bool ClearingMediaViews = false;
+
+struct PreviewState {
+	base::weak_ptr<HistoryView::Element> view;
+	std::shared_ptr<const SealedDecodedMedia> image;
+	QPointer<Ui::GenericBox> box;
+	QPointer<Ui::RpWidget> picture;
+	bool active = true;
+};
+
+std::vector<std::weak_ptr<PreviewState>> Previews;
+
+[[nodiscard]] bool PreviewCurrent(const std::shared_ptr<PreviewState> &state) {
+	return state->active && state->view && state->image
+		&& state->image->epoch == SealedAutomaticEpoch()
+		&& SealedMediaImageCurrent(state->view.get(), state->image->token);
+}
+
+void ClearPreview(const std::shared_ptr<PreviewState> &state, bool close) {
+	const auto active = std::exchange(state->active, false);
+	state->image.reset();
+	if (state->picture) state->picture->update();
+	if (close && active && state->box) state->box->closeBox();
+}
+
+void PreviewBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		const std::shared_ptr<PreviewState> &state) {
+	state->box = box.get();
+	const auto weakController = base::make_weak(controller.get());
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Encrypted file"_q)));
+	const auto picture = box->addRow(object_ptr<Ui::RpWidget>(box), style::al_justify);
+	state->picture = picture;
+	picture->widthValue() | rpl::on_next([=](int width) {
+		const auto size = state->image
+			? state->image->image.size().scaled(std::max(width, 1), st::boxWideWidth, Qt::KeepAspectRatio)
+			: QSize();
+		picture->resize(width, size.height());
+	}, picture->lifetime());
+	picture->paintRequest() | rpl::on_next([=] {
+		if (!PreviewCurrent(state)) return;
+		const auto current = state->image;
+		if (!current) return;
+		auto p = QPainter(picture);
+		auto quality = PainterHighQualityEnabler(p);
+		const auto size = current->image.size().scaled(picture->size(), Qt::KeepAspectRatio);
+		p.drawImage(QRect((picture->width() - size.width()) / 2,
+			(picture->height() - size.height()) / 2, size.width(), size.height()), current->image);
+	}, picture->lifetime());
+	const auto clear = [=] { ClearPreview(state, false); };
+	GuardSealedBox(box, &controller->session(), clear);
+	SealedAutomaticChanges() | rpl::on_next([=] {
+		if (!PreviewCurrent(state)) ClearPreview(state, true);
+	}, box->lifetime());
+	box->addButton(rpl::single(Lower(u"Save"_q)), [=] {
+		if (!weakController || !PreviewCurrent(state)) return;
+		FileDialog::GetWritePath(box.get(), Lower(u"Save decrypted file"_q),
+			FileDialog::AllFilesFilter(), u"photo.png"_q,
+			crl::guard(box, [=](QString &&path) {
+				const auto window = weakController.get();
+				if (path.isEmpty() || !window || !PreviewCurrent(state)) return;
+				const auto current = state->image;
+				if (!current) return;
+				auto output = QSaveFile(path);
+				if (!output.open(QIODevice::WriteOnly)
+					|| !current->image.save(&output, "PNG") || !output.commit()) {
+					window->showToast(Lower(u"The decrypted file could not be saved."_q));
+					return;
+				}
+				Platform::File::PostprocessDownloaded(path);
+				window->showToast(Lower(u"Decrypted file saved."_q));
+			}));
+	});
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+}
+
+void OpenPreview(
+		const base::weak_ptr<HistoryView::Element> &view,
+		const QByteArray &token,
+		const ClickContext &context) {
+	if (!view || !SealedMediaImageCurrent(view.get(), token)) return;
+	const auto image = SealedMediaImageFor(view.get());
+	if (!image || image->token != token) return;
+	const auto window = Core::App().windowFor(view->history()->peer);
+	const auto preferred = context.other.value<ClickHandlerContext>().sessionWindow;
+	const auto controller = preferred ? preferred.get() : window ? window->sessionController() : nullptr;
+	if (!controller || &controller->session() != &view->history()->session()) return;
+	const auto previous = Previews;
+	for (const auto &weak : previous) {
+		if (const auto state = weak.lock()) ClearPreview(state, true);
+	}
+	std::erase_if(Previews, [](const auto &weak) { return weak.expired(); });
+	const auto state = std::make_shared<PreviewState>();
+	state->view = view;
+	state->image = image;
+	Previews.push_back(state);
+	controller->show(Box(PreviewBox, controller, state));
+}
+
+class SealedPhoto final : public HistoryView::Media {
+public:
+	SealedPhoto(
+		not_null<HistoryView::Element*> parent,
+		not_null<HistoryItem*> item,
+		not_null<DocumentData*> document,
+		std::shared_ptr<const SealedDecodedMedia> image)
+	: Media(parent)
+	, _document(document)
+	, _image(std::move(image))
+	, _photo(std::make_unique<PhotoData>(&item->history()->session().data(), 0)) {
+		const auto size = _image->image.size();
+		_photo->setFields(item->date(), false);
+		_photo->updateImages({}, {}, {},
+			{ .location = { {}, size.width(), size.height() } }, {}, {}, 0);
+		_photoMedia = _photo->createMediaView();
+		_photoMedia->set(Data::PhotoSize::Large, Data::PhotoSize::Large, _image->image, {});
+		_delegate = std::make_unique<HistoryView::Photo>(parent, item, _photo.get(), false);
+		const auto weak = base::make_weak(parent.get());
+		const auto token = _image->token;
+		_open = std::make_shared<LambdaClickHandler>([=](ClickContext context) { OpenPreview(weak, token, context); });
+		Views.insert(this);
+	}
+
+	~SealedPhoto() {
+		Views.erase(this);
+		clear();
+	}
+
+	[[nodiscard]] bool authenticated() const {
+		return _delegate && _image && _image->epoch == SealedAutomaticEpoch()
+			&& SealedMediaImageCurrent(_parent, _image->token);
+	}
+
+	[[nodiscard]] bool populated() const {
+		return _delegate != nullptr || _image != nullptr;
+	}
+
+	[[nodiscard]] bool owns(const HistoryView::Media *media) const {
+		return _delegate.get() == media;
+	}
+
+	void clear() {
+		if (_delegate) _delegate->unloadHeavyPart();
+		_delegate.reset();
+		_photoMedia.reset();
+		_photo.reset();
+		_image.reset();
+		_open.reset();
+		_parent->checkHeavyPart();
+	}
+
+	void draw(Painter &p, const HistoryView::PaintContext &context) const override {
+		if (!authenticated()) return;
+		sync();
+		_delegate->draw(p, context);
+	}
+
+	[[nodiscard]] HistoryView::TextState textState(
+			QPoint point,
+			HistoryView::StateRequest request) const override {
+		if (!authenticated()) return HistoryView::TextState(_parent);
+		if (const auto info = _parent->bottomInfoTextState(width(), height(), point,
+				HistoryView::InfoDisplayType::Image);
+			info.link || info.cursor != HistoryView::CursorState::None || info.customTooltip) {
+			return info;
+		}
+		return HistoryView::TextState(_parent,
+			QRect(QPoint(), currentSize()).contains(point) ? _open : ClickHandlerPtr());
+	}
+
+	[[nodiscard]] bool toggleSelectionByHandlerClick(const ClickHandlerPtr &handler) const override {
+		return handler == _open;
+	}
+
+	[[nodiscard]] bool dragItemByHandler(const ClickHandlerPtr &handler) const override {
+		return handler == _open;
+	}
+
+	[[nodiscard]] DocumentData *getDocument() const override {
+		return _document;
+	}
+
+	[[nodiscard]] bool hideMessageText() const override {
+		return false;
+	}
+
+	[[nodiscard]] bool needsBubble() const override {
+		return _delegate ? _delegate->needsBubble() : true;
+	}
+
+	[[nodiscard]] bool customInfoLayout() const override {
+		return true;
+	}
+
+	[[nodiscard]] bool skipBubbleTail() const override {
+		return isRoundedInBubbleBottom();
+	}
+
+	[[nodiscard]] bool enforceBubbleWidth() const override {
+		return true;
+	}
+
+	[[nodiscard]] bool isReadyForOpen() const override {
+		return authenticated();
+	}
+
+	[[nodiscard]] QPoint resolveCustomInfoRightBottom() const override {
+		return _delegate ? _delegate->resolveCustomInfoRightBottom() : QPoint();
+	}
+
+	[[nodiscard]] bool hasHeavyPart() const override {
+		return _delegate && _delegate->hasHeavyPart();
+	}
+
+	void unloadHeavyPart() override {
+		if (_delegate) _delegate->unloadHeavyPart();
+	}
+
+	void refreshParentId(not_null<HistoryItem*> item) override {
+		if (_delegate) _delegate->refreshParentId(item);
+	}
+
+private:
+	void sync() const {
+		if (_delegate) {
+			_delegate->setInBubbleState(inBubbleState());
+			_delegate->setBubbleRounding(bubbleRounding());
+		}
+	}
+
+	[[nodiscard]] QSize countOptimalSize() override {
+		if (!_delegate) return { st::minPhotoSize, st::minPhotoSize };
+		sync();
+		_delegate->initDimensions();
+		return _delegate->optimalSize();
+	}
+
+	[[nodiscard]] QSize countCurrentSize(int width) override {
+		if (!_delegate) return { width, st::minPhotoSize };
+		sync();
+		_delegate->resizeGetHeight(width);
+		return _delegate->currentSize();
+	}
+
+	const not_null<DocumentData*> _document;
+	std::shared_ptr<const SealedDecodedMedia> _image;
+	std::unique_ptr<PhotoData> _photo;
+	std::shared_ptr<Data::PhotoMedia> _photoMedia;
+	std::unique_ptr<HistoryView::Photo> _delegate;
+	ClickHandlerPtr _open;
+};
+
+}
+
+std::unique_ptr<HistoryView::Media> CreateSealedMediaView(
+		HistoryView::Element *view,
+		HistoryItem *item,
+		DocumentData *document) {
+	if (ClearingMediaViews || !view || !item || !document || view->data() != item
+		|| item->groupId() || !SealedAutomaticSelected(item->history())
+		|| !item->media() || item->media()->document() != document) return nullptr;
+	TouchSealedMediaView(view);
+	const auto image = SealedMediaImageFor(view);
+	return image ? std::make_unique<SealedPhoto>(view, item, document, image) : nullptr;
+}
+
+void RefreshSealedMediaView(
+		HistoryView::Element *view,
+		const std::function<void()> &refresh) {
+	if (!view || ClearingMediaViews) return;
+	if (dynamic_cast<SealedPhoto*>(view->media())) {
+		refresh();
+	} else if (SealedAutomaticSelected(view->history())) {
+		const auto image = SealedMediaImageFor(view);
+		if (image) refresh();
+	}
+}
+
+void ClearSealedMediaViews() {
+	if (ClearingMediaViews) return;
+	ClearingMediaViews = true;
+	const auto reset = gsl::finally([] { ClearingMediaViews = false; });
+	const auto previews = Previews;
+	for (const auto &weak : previews) {
+		if (const auto state = weak.lock()) ClearPreview(state, true);
+	}
+	std::erase_if(Previews, [](const auto &weak) { return weak.expired(); });
+	const auto views = Views;
+	for (const auto view : views) {
+		if (!Views.contains(view) || !view->populated()) continue;
+		const auto parent = base::make_weak(view->parent().get());
+		view->clear();
+		if (!parent) continue;
+		crl::on_main(&parent->history()->session(), [=] {
+			if (!parent || Core::Quitting()) return;
+			parent->itemTextUpdated();
+			if (parent) parent->history()->owner().requestViewResize(parent.get());
+		});
+	}
+}
+
+bool SealedMediaViewAuthenticated(const HistoryView::Element *view) {
+	if (!view || ClearingMediaViews) return false;
+	const auto photo = dynamic_cast<const SealedPhoto*>(view->media());
+	return photo && photo->authenticated();
+}
+
+bool SealedMediaInWebPage(
+		const HistoryView::Element *view,
+		const HistoryView::Media *media) {
+	if (!view || view->media() == media) return false;
+	const auto photo = dynamic_cast<const SealedPhoto*>(view->media());
+	return !photo || !photo->owns(media);
+}
+
+}
