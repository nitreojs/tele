diff --git a/Telegram/SourceFiles/tele/tele_sealed_duress_signout_plan.h b/Telegram/SourceFiles/tele/tele_sealed_duress_signout_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..15daf4952b528ae2a4778007e76ca9b4448b083f
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_duress_signout_plan.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <QtCore/QtGlobal>
+
+#include <algorithm>
+#include <set>
+#include <vector>
+
+namespace Tele {
+
+struct SealedDuressSignoutDevice {
+	quint64 hash = 0;
+	int created = 0;
+	bool done = false;
+};
+
+enum class SealedDuressSignoutAction {
+	Changed,
+	TerminateDevice,
+	MarkMissingDevice,
+	LogoutLocal,
+	ClearLocal,
+	Complete,
+};
+
+struct SealedDuressSignoutPlan {
+	SealedDuressSignoutAction action = SealedDuressSignoutAction::Changed;
+	quint64 hash = 0;
+	int created = 0;
+};
+
+[[nodiscard]] inline SealedDuressSignoutPlan PlanSealedDuressLocalFallback(
+		bool selectedHere,
+		bool sameLocalSession,
+		bool localAlreadyRemoved,
+		bool deadlineExpired) {
+	return {
+		(selectedHere && sameLocalSession && !localAlreadyRemoved && deadlineExpired)
+			? SealedDuressSignoutAction::ClearLocal
+			: SealedDuressSignoutAction::Changed,
+	};
+}
+
+[[nodiscard]] inline SealedDuressSignoutPlan NextSealedDuressSignout(
+		quint64 expectedCurrent,
+		int expectedCreated,
+		quint64 actualCurrent,
+		int actualCreated,
+		bool here,
+		const std::vector<SealedDuressSignoutDevice> &selected,
+		const std::vector<SealedDuressSignoutDevice> &available) {
+	if (expectedCurrent != actualCurrent || expectedCreated <= 0
+		|| expectedCreated != actualCreated || selected.size() > 256
+		|| available.size() > 256) {
+		return {};
+	}
+	auto hashes = std::set<quint64>();
+	for (const auto &device : selected) {
+		if (!device.hash || device.hash == actualCurrent || device.created <= 0
+			|| !hashes.insert(device.hash).second) {
+			return {};
+		}
+	}
+	hashes.clear();
+	for (const auto &device : available) {
+		if (!device.hash || device.hash == actualCurrent || device.created <= 0
+			|| !hashes.insert(device.hash).second) {
+			return {};
+		}
+	}
+	for (const auto &device : selected) {
+		if (device.done) {
+			continue;
+		}
+		const auto found = std::find_if(available.begin(), available.end(), [&](const auto &entry) {
+			return entry.hash == device.hash;
+		});
+		if (found == available.end()) {
+			return { SealedDuressSignoutAction::MarkMissingDevice, device.hash, device.created };
+		} else if (found->created != device.created) {
+			return {};
+		}
+		return { SealedDuressSignoutAction::TerminateDevice, device.hash, device.created };
+	}
+	return { here ? SealedDuressSignoutAction::LogoutLocal : SealedDuressSignoutAction::Complete };
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_duress_signouts.cpp b/Telegram/SourceFiles/tele/tele_sealed_duress_signouts.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d3a7d0ae102333154dc2a638463fa2d56a5a1b8c
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_duress_signouts.cpp
@@ -0,0 +1,1166 @@
+#include "tele/tele_sealed_duress_signouts.h"
+
+#include "base/timer.h"
+#include "base/weak_qptr.h"
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "core/core_settings_proxy.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "mtproto/sender.h"
+#include "storage/storage_account.h"
+#include "storage/storage_domain.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "tele/tele_sealed.h"
+#include "tele/tele_sealed_duress.h"
+#include "tele/tele_sealed_duress_signout_plan.h"
+#include "tele/tele_sealed_duress_ui.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/checkbox.h"
+#include "ui/widgets/labels.h"
+#include "window/window_session_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_widgets.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDateTime>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QLockFile>
+#include <QtCore/QSaveFile>
+
+#include <algorithm>
+#include <climits>
+#include <limits>
+#include <map>
+#include <set>
+
+namespace Tele {
+namespace {
+
+constexpr auto kFileLimit = 2 * 1024 * 1024;
+constexpr auto kAccountLimit = 1536;
+constexpr auto kSessionLimit = 256;
+constexpr auto kTotalSessionLimit = 8192;
+
+struct Device {
+	quint64 hash = 0;
+	int created = 0;
+	QString name;
+	bool current = false;
+	bool done = false;
+};
+
+struct Binding {
+	quint64 owner = 0;
+	QString directory;
+	QByteArray fingerprint;
+	quint64 currentHash = 0;
+	int created = 0;
+};
+
+struct Rule {
+	Binding binding;
+	bool here = false;
+	std::vector<Device> devices;
+};
+
+struct Job {
+	Rule rule;
+	int result = 0;
+	int failure = 0;
+	int attempts = 0;
+	qint64 nextTry = 0;
+	bool localRequested = false;
+	bool localForced = false;
+	bool localServerConfirmed = false;
+};
+
+struct State {
+	QByteArray activation;
+	std::vector<Rule> rules;
+	std::vector<Job> jobs;
+};
+
+struct Snapshot {
+	Device current;
+	std::vector<Device> others;
+};
+
+class Runner;
+Runner *Runtime = nullptr;
+
+[[nodiscard]] bool SameAccount(const Binding &a, const Binding &b) {
+	return a.owner == b.owner && a.directory == b.directory;
+}
+
+[[nodiscard]] bool SameLocal(const Binding &a, const Binding &b) {
+	return SameAccount(a, b) && a.fingerprint == b.fingerprint;
+}
+
+[[nodiscard]] bool SameBinding(const Binding &a, const Binding &b) {
+	return SameLocal(a, b)
+		&& a.currentHash == b.currentHash
+		&& a.created == b.created;
+}
+
+[[nodiscard]] bool Ready(not_null<Main::Session*> session) {
+	return !Core::Quitting()
+		&& !Core::App().passcodeLocked()
+		&& session->account().maybeSession() == session
+		&& !session->account().loggingOut()
+		&& session->domain().local().hasLocalPasscode();
+}
+
+[[nodiscard]] Binding LocalBinding(not_null<Main::Session*> session) {
+	auto result = Binding();
+	result.owner = session->uniqueId();
+	result.directory = SealedDuressDirectory(session);
+	const auto &mtp = session->account().mtp();
+	for (const auto &key : mtp.getKeysForWrite()) {
+		if (key && key->dcId() == mtp.mainDcId() && key->keyId()) {
+			const auto bytes = QByteArray::number(result.owner)
+				+ ':' + QByteArray::number(key->dcId())
+				+ ':' + QByteArray::number(key->keyId());
+			result.fingerprint = QCryptographicHash::hash(
+				bytes,
+				QCryptographicHash::Sha256);
+			break;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<Snapshot> ParseSnapshot(
+		const MTPaccount_Authorizations &value) {
+	const auto &list = value.data().vauthorizations().v;
+	if (list.size() > kSessionLimit + 1) {
+		return std::nullopt;
+	}
+	auto result = Snapshot();
+	auto currentCount = 0;
+	auto hashes = std::set<quint64>();
+	for (const auto &entry : list) {
+		const auto &data = entry.data();
+		auto device = Device{
+			.hash = quint64(data.vhash().v),
+			.created = data.vdate_created().v,
+			.name = (qs(data.vdevice_model()).left(128)
+				+ u" · "_q + qs(data.vapp_name()).left(128)),
+			.current = data.is_current(),
+		};
+		if (device.created <= 0 || (!device.current && !device.hash)
+			|| !hashes.insert(device.hash).second) {
+			return std::nullopt;
+		}
+		if (device.current) {
+			++currentCount;
+			result.current = device;
+		} else {
+			result.others.push_back(std::move(device));
+		}
+	}
+	return (currentCount == 1)
+		? std::make_optional(std::move(result))
+		: std::nullopt;
+}
+
+[[nodiscard]] QByteArray ContextHash() {
+	return QCryptographicHash::hash(
+		SealedDuressContext(),
+		QCryptographicHash::Sha256);
+}
+
+[[nodiscard]] QString StatePath() {
+	return QDir(SealedDuressRoot()).filePath(
+		u"tele_sealed_signouts_%1.json"_q.arg(
+			QString::fromLatin1(ContextHash().toHex())));
+}
+
+[[nodiscard]] QJsonObject EncodeRule(const Rule &rule) {
+	auto devices = QJsonArray();
+	for (const auto &device : rule.devices) {
+		devices.push_back(QJsonObject{
+			{ u"hash"_q, QString::number(device.hash) },
+			{ u"created"_q, device.created },
+			{ u"done"_q, device.done },
+		});
+	}
+	return {
+		{ u"owner"_q, QString::number(rule.binding.owner) },
+		{ u"directory"_q, rule.binding.directory },
+		{ u"fingerprint"_q,
+			QString::fromLatin1(rule.binding.fingerprint.toBase64()) },
+		{ u"current"_q, QString::number(rule.binding.currentHash) },
+		{ u"created"_q, rule.binding.created },
+		{ u"here"_q, rule.here },
+		{ u"devices"_q, devices },
+	};
+}
+
+[[nodiscard]] std::optional<quint64> Unsigned(
+		const QJsonValue &value,
+		bool zero = false) {
+	if (!value.isString()) {
+		return std::nullopt;
+	}
+	const auto text = value.toString();
+	auto ok = false;
+	const auto number = text.toULongLong(&ok);
+	return (ok && (zero || number) && text == QString::number(number))
+		? std::make_optional(number)
+		: std::nullopt;
+}
+
+[[nodiscard]] std::optional<int> Integer(
+		const QJsonValue &value,
+		int low,
+		int high) {
+	if (!value.isDouble()) {
+		return std::nullopt;
+	}
+	const auto number = value.toDouble();
+	return (number >= low && number <= high && number == int(number))
+		? std::make_optional(int(number))
+		: std::nullopt;
+}
+
+[[nodiscard]] std::optional<Rule> DecodeRule(
+		const QJsonObject &object,
+		int &total) {
+	const auto owner = Unsigned(object[u"owner"_q]);
+	const auto current = Unsigned(object[u"current"_q], true);
+	const auto created = Integer(object[u"created"_q], 1, INT_MAX);
+	const auto directory = object[u"directory"_q].toString();
+	const auto fingerprint = QByteArray::fromBase64(
+		object[u"fingerprint"_q].toString().toLatin1(),
+		QByteArray::AbortOnBase64DecodingErrors);
+	if (!owner || !current || !created || directory.isEmpty()
+		|| directory.size() > 128 || directory.contains('/')
+		|| directory.contains('\\') || directory.contains('.')
+		|| fingerprint.size() != 32
+		|| fingerprint.toBase64() != object[u"fingerprint"_q].toString().toLatin1()
+		|| !object[u"here"_q].isBool()
+		|| !object[u"devices"_q].isArray()) {
+		return std::nullopt;
+	}
+	auto result = Rule{
+		.binding = {
+			.owner = *owner,
+			.directory = directory,
+			.fingerprint = fingerprint,
+			.currentHash = *current,
+			.created = *created,
+		},
+		.here = object[u"here"_q].toBool(),
+	};
+	const auto devices = object[u"devices"_q].toArray();
+	if (devices.size() > kSessionLimit
+		|| (total += int(devices.size())) > kTotalSessionLimit) {
+		return std::nullopt;
+	}
+	auto hashes = std::set<quint64>();
+	for (const auto &entry : devices) {
+		if (!entry.isObject()) {
+			return std::nullopt;
+		}
+		const auto object = entry.toObject();
+		const auto hash = Unsigned(object[u"hash"_q]);
+		const auto created = Integer(object[u"created"_q], 1, INT_MAX);
+		if (!hash || !created || *hash == *current
+			|| !hashes.insert(*hash).second || !object[u"done"_q].isBool()) {
+			return std::nullopt;
+		}
+		result.devices.push_back({
+			.hash = *hash,
+			.created = *created,
+			.done = object[u"done"_q].toBool(),
+		});
+	}
+	if (!result.here && result.devices.empty()) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<State> LoadState() {
+	const auto path = StatePath();
+	const auto info = QFileInfo(path);
+	if (info.isSymLink()) {
+		return std::nullopt;
+	} else if (!info.exists()) {
+		return State();
+	} else if (!info.isFile() || info.size() <= 0
+		|| info.size() > kFileLimit) {
+		return std::nullopt;
+	}
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return std::nullopt;
+	}
+	const auto bytes = file.read(kFileLimit + 1);
+	if (bytes.size() != info.size() || !file.atEnd()) {
+		return std::nullopt;
+	}
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(bytes, &error);
+	if (error.error != QJsonParseError::NoError || !document.isObject()) {
+		return std::nullopt;
+	}
+	const auto object = document.object();
+	if (object[u"version"_q].toInt() != 3
+		|| object[u"context"_q].toString().toLatin1() != ContextHash().toHex()
+		|| !object[u"rules"_q].isArray() || !object[u"jobs"_q].isArray()
+		|| !object[u"activation"_q].isString()) {
+		return std::nullopt;
+	}
+	auto result = State();
+	result.activation = QByteArray::fromBase64(
+		object[u"activation"_q].toString().toLatin1(),
+		QByteArray::AbortOnBase64DecodingErrors);
+	if ((!result.activation.isEmpty() && result.activation.size() != 16)
+		|| result.activation.toBase64() != object[u"activation"_q].toString().toLatin1()) {
+		return std::nullopt;
+	}
+	const auto rules = object[u"rules"_q].toArray();
+	const auto jobs = object[u"jobs"_q].toArray();
+	if (rules.size() > kAccountLimit || jobs.size() > kAccountLimit
+		|| (!jobs.isEmpty() && result.activation.size() != 16)) {
+		return std::nullopt;
+	}
+	auto total = 0;
+	auto accounts = std::set<std::pair<quint64, QString>>();
+	for (const auto &value : rules) {
+		const auto rule = value.isObject()
+			? DecodeRule(value.toObject(), total)
+			: std::nullopt;
+		if (!rule || ranges::any_of(rule->devices, &Device::done)
+			|| !accounts.emplace(
+				rule->binding.owner, rule->binding.directory).second) {
+			return std::nullopt;
+		}
+		result.rules.push_back(*rule);
+	}
+	accounts.clear();
+	for (const auto &value : jobs) {
+		if (!value.isObject()) {
+			return std::nullopt;
+		}
+		const auto object = value.toObject();
+		const auto rule = object[u"rule"_q].isObject()
+			? DecodeRule(object[u"rule"_q].toObject(), total)
+			: std::nullopt;
+		const auto status = Integer(object[u"result"_q], 0, 3);
+		const auto failure = Integer(object[u"failure"_q], 0, 2);
+		const auto attempts = Integer(object[u"attempts"_q], 0, 32);
+		const auto next = Unsigned(object[u"next"_q], true);
+		if (!rule || !status || !failure || !attempts || !next
+			|| *next > quint64(std::numeric_limits<qint64>::max())
+			|| !object[u"localRequested"_q].isBool()
+			|| !object[u"localForced"_q].isBool()
+			|| !object[u"localServerConfirmed"_q].isBool()
+			|| (object[u"localRequested"_q].toBool() && !rule->here)
+			|| (object[u"localForced"_q].toBool()
+				&& (!rule->here || !object[u"localRequested"_q].toBool()))
+			|| (object[u"localServerConfirmed"_q].toBool()
+				&& (!object[u"localForced"_q].toBool()
+					|| !object[u"localRequested"_q].toBool()))
+			|| ((*status == 1 || (object[u"localRequested"_q].toBool()
+				&& !object[u"localForced"_q].toBool()))
+				&& ranges::any_of(rule->devices, [](const Device &device) { return !device.done; }))
+			|| (*status == 1 && rule->here && !object[u"localRequested"_q].toBool())
+			|| (*status == 3 && (!rule->here || !object[u"localForced"_q].toBool()
+				|| !object[u"localRequested"_q].toBool()))
+			|| !accounts.emplace(
+				rule->binding.owner, rule->binding.directory).second) {
+			return std::nullopt;
+		}
+		result.jobs.push_back({
+			.rule = *rule,
+			.result = *status,
+			.failure = *failure,
+			.attempts = *attempts,
+			.nextTry = qint64(*next),
+			.localRequested = object[u"localRequested"_q].toBool(),
+			.localForced = object[u"localForced"_q].toBool(),
+			.localServerConfirmed = object[u"localServerConfirmed"_q].toBool(),
+		});
+	}
+	return result;
+}
+
+[[nodiscard]] bool WriteState(const State &state) {
+	if (state.rules.size() > kAccountLimit || state.jobs.size() > kAccountLimit) {
+		return false;
+	}
+	auto total = 0;
+	for (const auto &rule : state.rules) {
+		if (rule.devices.size() > kSessionLimit
+			|| (total += int(rule.devices.size())) > kTotalSessionLimit / 2) {
+			return false;
+		}
+	}
+	for (const auto &job : state.jobs) {
+		if (job.rule.devices.size() > kSessionLimit
+			|| (total += int(job.rule.devices.size())) > kTotalSessionLimit) {
+			return false;
+		}
+	}
+	auto rules = QJsonArray();
+	for (const auto &rule : state.rules) {
+		rules.push_back(EncodeRule(rule));
+	}
+	auto jobs = QJsonArray();
+	for (const auto &job : state.jobs) {
+		jobs.push_back(QJsonObject{
+			{ u"rule"_q, EncodeRule(job.rule) },
+			{ u"result"_q, job.result },
+			{ u"failure"_q, job.failure },
+			{ u"attempts"_q, job.attempts },
+			{ u"next"_q, QString::number(job.nextTry) },
+			{ u"localRequested"_q, job.localRequested },
+			{ u"localForced"_q, job.localForced },
+			{ u"localServerConfirmed"_q, job.localServerConfirmed },
+		});
+	}
+	const auto bytes = QJsonDocument(QJsonObject{
+		{ u"version"_q, 3 },
+		{ u"context"_q, QString::fromLatin1(ContextHash().toHex()) },
+		{ u"activation"_q, QString::fromLatin1(state.activation.toBase64()) },
+		{ u"rules"_q, rules },
+		{ u"jobs"_q, jobs },
+	}).toJson(QJsonDocument::Compact);
+	if (bytes.size() > kFileLimit || QFileInfo(StatePath()).isSymLink()) {
+		return false;
+	}
+	auto file = QSaveFile(StatePath());
+	file.setDirectWriteFallback(false);
+	return file.open(QIODevice::WriteOnly)
+		&& file.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner)
+		&& file.write(bytes) == bytes.size()
+		&& file.commit();
+}
+
+[[nodiscard]] bool ChangeState(Fn<bool(State&)> change) {
+	auto lock = QLockFile(StatePath() + u".lock"_q);
+	lock.setStaleLockTime(0);
+	if (!lock.tryLock()) {
+		return false;
+	}
+	auto state = LoadState();
+	return state && change(*state) && WriteState(*state);
+}
+
+[[nodiscard]] bool CurrentLocalIntent(
+		const QByteArray &activation,
+		const Binding &binding) {
+	const auto state = LoadState();
+	const auto authority = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	return state && authority.state && authority.error == SealedDuressError::None
+		&& state->activation == activation
+		&& authority.state->activationId == activation
+		&& ranges::any_of(state->jobs, [&](const Job &job) {
+			return !job.result && SameBinding(job.rule.binding, binding)
+				&& job.localRequested && job.localForced;
+		});
+}
+
+[[nodiscard]] QString JobStatus(const Job &job) {
+	if (job.result == 1) {
+		return (job.rule.here && !job.localServerConfirmed)
+			? Lower(u"This device signed out locally. Server revocation could not be confirmed."_q)
+			: Lower(u"Selected sessions signed out."_q);
+	} else if (job.result == 2) {
+		return Lower(u"Sign-outs stopped because the signed-in session changed."_q);
+	} else if (job.result == 3) {
+		return Lower(u"This device signed out locally; other devices were not confirmed signed out."_q);
+	} else if (job.failure == 2) {
+		return Lower(u"Telegram temporarily prevents signing out other devices."_q);
+	} else if (job.localRequested) {
+		return Lower(u"Sign-out requested for this device."_q);
+	}
+	return Lower(u"Sign-outs pending an internet connection or Telegram permission."_q);
+}
+
+[[nodiscard]] int RetryWait(const MTP::Error &error) {
+	const auto type = error.type();
+	if (type.startsWith(u"FLOOD_WAIT_")) {
+		auto ok = false;
+		const auto seconds = type.mid(11).toInt(&ok);
+		if (ok && seconds > 0) {
+			return std::clamp(seconds, 60, 30 * 24 * 60 * 60);
+		}
+	}
+	return 0;
+}
+
+class Runner final : public QObject {
+public:
+	explicit Runner(not_null<Main::Domain*> domain);
+	~Runner();
+	void schedule();
+
+private:
+	struct Watch {
+		std::optional<Binding> last;
+		rpl::lifetime lifetime;
+	};
+
+	void watchAccounts();
+	void pump();
+	void received(const MTPaccount_Authorizations &value);
+	void failed(bool tooFresh = false, int retryWait = 0);
+	void finish(bool soon);
+	[[nodiscard]] bool update(Fn<void(Job&)> callback);
+	void completedLocal(const Binding &binding);
+	void finishLocal(bool serverConfirmed);
+	void invalidateDirectory(const QString &directory);
+	void updateDeadline(const State &state, const SealedDuressState &authority);
+	void enforceLocalDeadline();
+
+	const not_null<Main::Domain*> _domain;
+	base::Timer _timer;
+	base::Timer _timeout;
+	base::Timer _localTimer;
+	std::map<Main::Account*, std::unique_ptr<Watch>> _watches;
+	rpl::lifetime _lifetime;
+	base::weak_ptr<Main::Session> _session;
+	std::unique_ptr<MTP::Sender> _sender;
+	QByteArray _activation;
+	Job _job;
+	QByteArray _deadlineActivation;
+	crl::time _deadlineAt = 0;
+	std::size_t _cursor = 0;
+	bool _scheduled = false;
+};
+
+Runner::Runner(not_null<Main::Domain*> domain)
+: _domain(domain)
+, _timer([=] { schedule(); })
+, _timeout([=] { failed(); })
+, _localTimer([=] { enforceLocalDeadline(); schedule(); }) {
+	domain->accountsChanges() | rpl::on_next([=] {
+		watchAccounts();
+		schedule();
+	}, _lifetime);
+	domain->activeValue() | rpl::on_next([=](Main::Account*) {
+		watchAccounts();
+		schedule();
+	}, _lifetime);
+	Core::App().settings().proxy().connectionTypeChanges(
+	) | rpl::on_next([=] { schedule(); }, _lifetime);
+	watchAccounts();
+	schedule();
+}
+
+Runner::~Runner() {
+	if (Runtime == this) {
+		Runtime = nullptr;
+	}
+}
+
+void Runner::watchAccounts() {
+	auto live = std::set<Main::Account*>();
+	for (const auto &entry : _domain->accounts()) {
+		const auto account = entry.account.get();
+		live.insert(account);
+		if (_watches.contains(account)) {
+			continue;
+		}
+		auto watch = std::make_unique<Watch>();
+		const auto raw = watch.get();
+		account->sessionValue() | rpl::on_next([=](Main::Session *session) {
+			if (!session && raw->last) {
+				completedLocal(*raw->last);
+				if (_sender && SameLocal(_job.rule.binding, *raw->last)) {
+					finish(false);
+				}
+				raw->last.reset();
+			} else if (!session) {
+				invalidateDirectory(QDir(SealedDuressRoot()).relativeFilePath(
+					QFileInfo(account->local().supportModePath()).absolutePath()));
+			} else if (session) {
+				raw->last = LocalBinding(session);
+			}
+			schedule();
+		}, raw->lifetime);
+		_watches.emplace(account, std::move(watch));
+	}
+	std::erase_if(_watches, [&](const auto &entry) {
+		return !live.contains(entry.first);
+	});
+}
+
+void Runner::completedLocal(const Binding &binding) {
+	if (Core::Quitting()) {
+		return;
+	}
+	const auto changed = ChangeState([&](State &state) {
+		auto changed = false;
+		for (auto &job : state.jobs) {
+			if (!job.result && SameLocal(job.rule.binding, binding)) {
+				job.result = !job.localRequested
+					? 2
+					: ranges::all_of(job.rule.devices, &Device::done) ? 1 : 3;
+				changed = true;
+			}
+		}
+		changed = std::erase_if(state.rules, [&](const Rule &rule) {
+			return SameLocal(rule.binding, binding);
+		}) || changed;
+		return changed;
+	});
+	(void)changed;
+}
+
+void Runner::invalidateDirectory(const QString &directory) {
+	if (Core::Quitting()) {
+		return;
+	}
+	const auto changed = ChangeState([&](State &state) {
+		auto changed = false;
+		for (auto &job : state.jobs) {
+			if (!job.result && job.rule.binding.directory == directory) {
+				job.result = 2;
+				changed = true;
+			}
+		}
+		changed = std::erase_if(state.rules, [&](const Rule &rule) {
+			return rule.binding.directory == directory;
+		}) || changed;
+		return changed;
+	});
+	(void)changed;
+}
+
+void Runner::schedule() {
+	if (_scheduled || Core::Quitting()) {
+		return;
+	}
+	_scheduled = true;
+	crl::on_main(this, [=] {
+		_scheduled = false;
+		pump();
+	});
+}
+
+void Runner::updateDeadline(
+		const State &state,
+		const SealedDuressState &authority) {
+	if (ranges::none_of(state.jobs, [](const Job &job) {
+		return !job.result && job.rule.here;
+	})) {
+		_localTimer.cancel();
+		return;
+	}
+	if (_deadlineActivation != state.activation) {
+		_deadlineActivation = state.activation;
+		const auto remaining = std::clamp<qint64>(
+			authority.activatedAtUTC + 30 - QDateTime::currentSecsSinceEpoch(),
+			0,
+			30);
+		_deadlineAt = crl::now() + remaining * 1000;
+	}
+	const auto remaining = _deadlineAt - crl::now();
+	if (remaining > 0) {
+		_localTimer.callOnce(remaining);
+	} else {
+		_localTimer.cancel();
+	}
+}
+
+void Runner::enforceLocalDeadline() {
+	if (Core::Quitting() || !_domain->started() || crl::now() < _deadlineAt) {
+		return;
+	}
+	const auto state = LoadState();
+	const auto authority = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	if (!state || !authority.state || authority.error != SealedDuressError::None
+		|| state->activation != _deadlineActivation
+		|| state->activation != authority.state->activationId) {
+		return;
+	}
+	auto candidates = std::vector<std::pair<Job, base::weak_ptr<Main::Session>>>();
+	for (const auto &job : state->jobs) {
+		if (job.result || !job.rule.here) {
+			continue;
+		}
+		for (const auto &entry : _domain->accounts()) {
+			const auto session = entry.account->maybeSession();
+			if (session && SealedDuressDirectory(session) == job.rule.binding.directory) {
+				candidates.emplace_back(job, base::make_weak(session));
+				break;
+			}
+		}
+	}
+	auto retry = false;
+	for (const auto &[saved, session] : candidates) {
+		if (!session) {
+			continue;
+		}
+		const auto same = SameLocal(LocalBinding(session.get()), saved.rule.binding);
+		const auto plan = PlanSealedDuressLocalFallback(
+			saved.rule.here,
+			same,
+			saved.result != 0,
+			true);
+		const auto marked = ChangeState([&](State &value) {
+			if (value.activation != state->activation) {
+				return false;
+			}
+			for (auto &job : value.jobs) {
+				if (!job.result && SameBinding(job.rule.binding, saved.rule.binding)) {
+					if (plan.action == SealedDuressSignoutAction::ClearLocal) {
+						job.localRequested = true;
+						job.localForced = true;
+					} else {
+						job.result = 2;
+					}
+					return true;
+				}
+			}
+			return false;
+		});
+		if (!marked) {
+			retry = true;
+			continue;
+		}
+		if (plan.action != SealedDuressSignoutAction::ClearLocal) {
+			continue;
+		}
+		if (_sender && SameLocal(_job.rule.binding, saved.rule.binding)) {
+			finish(false);
+		}
+		if (session && SameLocal(LocalBinding(session.get()), saved.rule.binding)
+			&& CurrentLocalIntent(state->activation, saved.rule.binding)) {
+			session->account().forcedLogOut();
+		}
+	}
+	if (retry) {
+		_localTimer.callOnce(1000);
+	}
+}
+
+void Runner::pump() {
+	if (Core::Quitting() || !_domain->started()) {
+		return;
+	}
+	_timer.cancel();
+	auto state = LoadState();
+	const auto authority = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	if (!state || state->activation.size() != 16
+		|| !authority.state || authority.error != SealedDuressError::None
+		|| authority.state->activationId != state->activation
+		|| authority.state->activatedAtUTC <= 0) {
+		_localTimer.cancel();
+		return;
+	}
+	updateDeadline(*state, *authority.state);
+	if (_deadlineActivation == state->activation && crl::now() >= _deadlineAt) {
+		enforceLocalDeadline();
+		state = LoadState();
+		if (!state) {
+			return;
+		}
+	}
+	if (_sender && _activation != state->activation) {
+		finish(false);
+	}
+	if (_sender) {
+		_timer.callOnce(60000);
+		return;
+	}
+	if (ranges::none_of(state->jobs, [](const Job &job) { return !job.result; })) {
+		return;
+	}
+	_timer.callOnce(60000);
+	const auto now = QDateTime::currentSecsSinceEpoch();
+	for (auto offset = std::size_t(0); offset != state->jobs.size(); ++offset) {
+		const auto index = (_cursor + offset) % state->jobs.size();
+		const auto &job = state->jobs[index];
+		if (job.result || job.nextTry > now
+			|| (job.rule.here && _deadlineActivation == state->activation
+				&& crl::now() >= _deadlineAt)) {
+			continue;
+		}
+		for (const auto &entry : _domain->accounts()) {
+			const auto session = entry.account->maybeSession();
+			if (!session || entry.account->loggingOut()) {
+				continue;
+			}
+			const auto binding = LocalBinding(session);
+			if (binding.directory != job.rule.binding.directory) {
+				continue;
+			}
+			_activation = state->activation;
+			_job = job;
+			if (!SameLocal(binding, job.rule.binding)) {
+				const auto changed = update([](Job &job) { job.result = 2; });
+				(void)changed;
+				continue;
+			}
+			_session = base::make_weak(session);
+			_cursor = (index + 1) % state->jobs.size();
+			_sender = std::make_unique<MTP::Sender>(&session->account().mtp());
+			_timeout.callOnce(60000);
+			_sender->request(MTPaccount_GetAuthorizations(
+			)).done([=](const MTPaccount_Authorizations &value) {
+				received(value);
+			}).fail([=](const MTP::Error &error) {
+				failed(false, RetryWait(error));
+			}).handleAllErrors().send();
+			return;
+		}
+	}
+}
+
+bool Runner::update(Fn<void(Job&)> callback) {
+	const auto authority = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+	if (!authority.state || authority.error != SealedDuressError::None
+		|| authority.state->activationId != _activation) {
+		return false;
+	}
+	return ChangeState([&](State &state) {
+		if (state.activation != _activation) {
+			return false;
+		}
+		for (auto &job : state.jobs) {
+			if (!job.result && SameBinding(job.rule.binding, _job.rule.binding)) {
+				callback(job);
+				_job = job;
+				return true;
+			}
+		}
+		return false;
+	});
+}
+
+void Runner::received(const MTPaccount_Authorizations &value) {
+	const auto snapshot = ParseSnapshot(value);
+	if (!_session || !snapshot || _session->account().loggingOut()
+		|| !SameLocal(LocalBinding(_session.get()), _job.rule.binding)) {
+		failed();
+		return;
+	}
+	auto selected = std::vector<SealedDuressSignoutDevice>();
+	for (const auto &device : _job.rule.devices) {
+		selected.push_back({ device.hash, device.created, device.done });
+	}
+	auto available = std::vector<SealedDuressSignoutDevice>();
+	for (const auto &device : snapshot->others) {
+		available.push_back({ device.hash, device.created });
+	}
+	const auto plan = NextSealedDuressSignout(
+		_job.rule.binding.currentHash,
+		_job.rule.binding.created,
+		snapshot->current.hash,
+		snapshot->current.created,
+		_job.rule.here,
+		selected,
+		available);
+	if (plan.action == SealedDuressSignoutAction::Changed) {
+		const auto changed = update([](Job &job) { job.result = 2; });
+		finish(changed);
+	} else if (plan.action == SealedDuressSignoutAction::MarkMissingDevice) {
+		const auto changed = update([&](Job &job) {
+			for (auto &entry : job.rule.devices) {
+				if (entry.hash == plan.hash && entry.created == plan.created) {
+					entry.done = true;
+				}
+			}
+		});
+		finish(changed);
+	} else if (plan.action == SealedDuressSignoutAction::TerminateDevice) {
+		if (!update([](Job&) {})) {
+			finish(false);
+			return;
+		}
+		_sender->request(MTPaccount_ResetAuthorization(
+			MTP_long(plan.hash)
+		)).done([=](const MTPBool &result) {
+			if (!mtpIsTrue(result)) {
+				failed();
+				return;
+			}
+			const auto changed = update([&](Job &job) {
+				for (auto &entry : job.rule.devices) {
+					if (entry.hash == plan.hash && entry.created == plan.created) {
+						entry.done = true;
+					}
+				}
+				job.failure = 0;
+				job.attempts = 0;
+				job.nextTry = 0;
+			});
+			finish(changed);
+		}).fail([=](const MTP::Error &error) {
+			failed(error.type() == u"FRESH_RESET_AUTHORISATION_FORBIDDEN"_q
+				|| error.type() == u"SESSION_TOO_FRESH"_q,
+				RetryWait(error));
+		}).handleAllErrors().send();
+	} else if (plan.action == SealedDuressSignoutAction::LogoutLocal) {
+		if (!update([](Job &job) {
+			job.localRequested = true;
+			job.localForced = true;
+			job.localServerConfirmed = false;
+		})) {
+			finish(false);
+			return;
+		}
+		_sender->request(MTPauth_LogOut(
+		)).done([=] {
+			finishLocal(true);
+		}).fail([=] {
+			finishLocal(false);
+		}).handleAllErrors().send();
+	} else {
+		const auto changed = update([](Job &job) { job.result = 1; });
+		finish(changed);
+	}
+}
+void Runner::finishLocal(bool serverConfirmed) {
+	if (!_session || !SameLocal(LocalBinding(_session.get()), _job.rule.binding)) {
+		finish(false);
+		return;
+	}
+	const auto session = _session;
+	const auto binding = _job.rule.binding;
+	const auto activation = _activation;
+	const auto recorded = update([&](Job &job) {
+		job.localServerConfirmed = serverConfirmed;
+	});
+	(void)recorded;
+	finish(false);
+	if (session && SameLocal(LocalBinding(session.get()), binding)
+		&& CurrentLocalIntent(activation, binding)) {
+		session->account().forcedLogOut();
+	}
+}
+
+void Runner::failed(bool tooFresh, int retryWait) {
+	const auto changed = update([&](Job &job) {
+		job.failure = tooFresh ? 2 : 1;
+		job.attempts = std::min(job.attempts + 1, 32);
+		job.nextTry = QDateTime::currentSecsSinceEpoch()
+			+ std::max(retryWait,
+				tooFresh ? 3600 : std::min(60 << std::min(job.attempts, 5), 3600));
+	});
+	finish(changed);
+}
+
+void Runner::finish(bool soon) {
+	_timeout.cancel();
+	_sender.reset();
+	_session = nullptr;
+	if (soon) {
+		schedule();
+	}
+}
+
+struct PickerState {
+	std::unique_ptr<MTP::Sender> sender;
+	Binding binding;
+	Ui::Checkbox *here = nullptr;
+	std::vector<std::pair<Device, Ui::Checkbox*>> devices;
+	bool busy = true;
+};
+
+void PickerBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto weakSession = base::make_weak(session);
+	const auto weakController = base::make_weak(controller);
+	const auto weakBox = base::make_weak(box);
+	const auto state = box->lifetime().make_state<PickerState>();
+	state->binding = LocalBinding(session);
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Duress sign-outs"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Telegram needs internet access to sign out other devices."_q),
+		st::boxLabel));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Changes apply to future duress activations."_q),
+		st::boxLabel));
+	const auto status = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Loading signed-in devices…"_q),
+		st::boxLabel));
+	GuardSealedBox(box, session);
+	state->sender = std::make_unique<MTP::Sender>(&session->account().mtp());
+	state->sender->request(MTPaccount_GetAuthorizations(
+	)).done([=](const MTPaccount_Authorizations &value) {
+		if (!weakBox || !weakSession || !Ready(weakSession.get())) {
+			return;
+		}
+		const auto snapshot = ParseSnapshot(value);
+		const auto stored = LoadState();
+		if (!snapshot || !stored || state->binding.fingerprint.size() != 32) {
+			status->setText(Lower(u"Could not read sign-out rules or signed-in devices."_q));
+			return;
+		}
+		state->binding.currentHash = snapshot->current.hash;
+		state->binding.created = snapshot->current.created;
+		const auto saved = ranges::find_if(stored->rules, [&](const Rule &rule) {
+			return SameBinding(rule.binding, state->binding);
+		});
+		state->here = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			Lower(u"Sign out this device"_q),
+			saved != stored->rules.end() && saved->here,
+			st::defaultBoxCheckbox));
+		state->here->setAllowTextLines(0);
+		state->here->setFocusPolicy(Qt::TabFocus);
+		const auto localAbout = box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"This device signs out after 30 seconds even if other devices could not be signed out."_q)
+				+ ' ' + Lower(u"Signing out removes normal local account data."_q),
+			st::boxDividerLabel));
+		localAbout->setVisible(state->here->checked());
+		state->here->checkedChanges() | rpl::on_next([=](bool checked) {
+			localAbout->setVisible(checked);
+		}, box->lifetime());
+		for (const auto &device : snapshot->others) {
+			const auto checked = saved != stored->rules.end()
+				&& ranges::any_of(saved->devices, [&](const Device &entry) {
+					return entry.hash == device.hash && entry.created == device.created;
+				});
+			const auto checkbox = box->addRow(object_ptr<Ui::Checkbox>(
+				box,
+				LowerOnly(device.name),
+				checked,
+				st::defaultBoxCheckbox));
+			checkbox->setAllowTextLines(0);
+			checkbox->setTextBreakEverywhere(true);
+			checkbox->setFocusPolicy(Qt::TabFocus);
+			state->devices.emplace_back(device, checkbox);
+		}
+		const auto job = ranges::find_if(stored->jobs, [&](const Job &job) {
+			return SameAccount(job.rule.binding, state->binding);
+		});
+		status->setText(job != stored->jobs.end()
+			? JobStatus(*job)
+			: Lower(u"No devices are selected by default."_q));
+		state->busy = false;
+	}).fail([=] {
+		if (weakBox) {
+			status->setText(Lower(u"Could not load signed-in devices. Check your connection and try again."_q));
+		}
+	}).handleAllErrors().send();
+	box->addButton(rpl::single(Lower(u"Save"_q)), [=] {
+		if (state->busy || !weakSession || !Ready(weakSession.get())) {
+			return;
+		}
+		auto selected = Rule{ .binding = state->binding, .here = state->here->checked() };
+		for (const auto &[device, checkbox] : state->devices) {
+			if (checkbox->checked()) {
+				selected.devices.push_back(device);
+			}
+		}
+		RequireSealedOrdinaryPasscode(controller, [=] {
+			if (!weakBox || !weakController || !weakSession
+				|| !Ready(weakSession.get()) || state->busy) {
+				return;
+			}
+			state->busy = true;
+			state->sender->request(MTPaccount_GetAuthorizations(
+			)).done([=](const MTPaccount_Authorizations &value) {
+				if (!weakBox || !weakSession || !Ready(weakSession.get())) {
+					return;
+				}
+				state->busy = false;
+				const auto snapshot = ParseSnapshot(value);
+				if (!snapshot || !SameLocal(LocalBinding(weakSession.get()), selected.binding)
+					|| snapshot->current.hash != selected.binding.currentHash
+					|| snapshot->current.created != selected.binding.created
+					|| !ranges::all_of(selected.devices, [&](const Device &device) {
+						return ranges::any_of(snapshot->others, [&](const Device &entry) {
+							return entry.hash == device.hash && entry.created == device.created;
+						});
+					})) {
+					status->setText(Lower(u"Signed-in devices changed. Close this window and choose them again."_q));
+					return;
+				}
+				auto mirror = QJsonArray();
+				const auto saved = ChangeState([&](State &value) {
+					std::erase_if(value.rules, [&](const Rule &rule) {
+						return SameAccount(rule.binding, selected.binding);
+					});
+					if (selected.here || !selected.devices.empty()) {
+						value.rules.push_back(selected);
+					}
+					if (value.rules.size() > kAccountLimit) {
+						return false;
+					}
+					for (const auto &rule : value.rules) {
+						mirror.push_back(EncodeRule(rule));
+					}
+					return true;
+				});
+				if (!saved) {
+					status->setText(Lower(u"Could not save sign-out rules. Nothing was changed."_q));
+					return;
+				}
+				SetSealedDuressSignouts(
+					QString::fromUtf8(QJsonDocument(mirror).toJson(QJsonDocument::Compact)));
+				weakBox->closeBox();
+			}).fail([=] {
+				if (weakBox) {
+					state->busy = false;
+					status->setText(Lower(u"Could not refresh signed-in devices. Nothing was changed."_q));
+				}
+			}).handleAllErrors().send();
+		});
+	});
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+}
+
+}
+
+void ShowSealedDuressSignouts(
+		not_null<Window::SessionController*> controller) {
+	if (!Ready(&controller->session())) {
+		controller->showToast(Lower(u"Set a local passcode and unlock tele first."_q));
+		return;
+	}
+	controller->show(Box(PickerBox, controller));
+}
+
+void StartSealedDuressSignouts(
+		not_null<Main::Domain*> domain,
+		rpl::lifetime &lifetime) {
+	Runtime = lifetime.make_state<Runner>(domain);
+}
+
+void TriggerSealedDuressSignouts(const QByteArray &activationId) {
+	if (activationId.size() != 16) {
+		return;
+	}
+	const auto changed = ChangeState([&](State &state) {
+		if (state.activation == activationId) {
+			return false;
+		}
+		state.activation = activationId;
+		state.jobs.clear();
+		for (const auto &rule : state.rules) {
+			state.jobs.push_back({ .rule = rule });
+		}
+		return true;
+	});
+	(void)changed;
+	if (Runtime) {
+		Runtime->schedule();
+	}
+}
+
