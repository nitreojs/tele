+
+struct AutomaticState;
+AutomaticState *Runtime = nullptr;
+uint64 Epoch = 1;
+rpl::event_stream<> Changes;
+bool Scheduled = false;
+
+struct AutomaticState {
+	explicit AutomaticState(not_null<Main::Domain*> value) : domain(value) {
+	}
+	~AutomaticState() {
+		if (Runtime == this) Runtime = nullptr;
+	}
+
+	not_null<Main::Domain*> domain;
+	SealedAutomaticPlan plan;
+	Main::Session *cachedSession = nullptr;
+	std::optional<SealedStoredKeys> keys;
+	rpl::lifetime activeLifetime;
+	rpl::lifetime applicationLifetime;
+};
+
+void Invalidate() {
+	if (Runtime) {
+		Runtime->keys.reset();
+		Runtime->cachedSession = nullptr;
+	}
+	++Epoch;
+	ClearSealedSearch();
+	ClearSealedViews();
+	if (!Scheduled) {
+		Scheduled = true;
+		crl::on_main(&Core::App(), [] {
+			Scheduled = false;
+			Changes.fire({});
+		});
+	}
+}
+
+[[nodiscard]] SealedAutomaticChatId Id(not_null<UserData*> peer) {
+	const auto session = &peer->session();
+	return {
+		.test = session->isTestMode(),
+		.account = session->userId().bare,
+		.peer = peerToUser(peer->id).bare,
+	};
+}
+
+[[nodiscard]] bool Available(not_null<Main::Session*> session) {
+	return Runtime && !Core::Quitting() && !Core::App().passcodeLocked()
+		&& Runtime->domain->started()
+		&& Runtime->domain->local().hasLocalPasscode()
+		&& Runtime->domain->active().maybeSession() == session
+		&& session->account().maybeSession() == session
+		&& !session->account().loggingOut();
+}
+
+[[nodiscard]] const SealedStoredKeys *Stored(not_null<Main::Session*> session) {
+	if (!EncryptedMessages() || !Available(session)) {
+		return nullptr;
+	}
+	if (Runtime->cachedSession != session || !Runtime->keys) {
+		Runtime->keys.reset();
+		Runtime->cachedSession = session;
+		Runtime->keys.emplace(LoadSealedKeys(session));
+	}
+	return &*Runtime->keys;
+}
+
+[[nodiscard]] QByteArray Fingerprint(const QByteArray &key) {
+	return QCryptographicHash::hash(key, QCryptographicHash::Sha512);
+}
+
+[[nodiscard]] std::optional<SealedAutomaticBinding> Binding(not_null<UserData*> peer) {
+	if (!SealedPeerAllowed(peer)) return std::nullopt;
+	const auto keys = Stored(&peer->session());
+	if (!keys || keys->error != SealedStoreError::None || !keys->identity) {
+		return std::nullopt;
+	}
+	const auto found = keys->peers.find(peerToUser(peer->id).bare);
+	if (!peer->isSelf() && found == keys->peers.end()) return std::nullopt;
+	return SealedAutomaticBinding{
+		.own = Fingerprint(keys->identity->publicKey),
+		.remote = Fingerprint(peer->isSelf() ? keys->identity->publicKey : found->second),
+	};
+}
+
+void AddText(not_null<Ui::GenericBox*> box, const QString &text) {
+	box->addRow(object_ptr<Ui::FlatLabel>(box, text, st::boxLabel), style::al_justify);
+}
+
+void Prepare(not_null<Ui::GenericBox*> box, const QString &title) {
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(title));
+}
+
+void ConfirmChatBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer,
+		bool enabled,
+		std::optional<SealedAutomaticBinding> binding) {
+	Prepare(box, Lower(u"Automatic encryption"_q));
+	const auto session = &controller->session();
+	const auto weakSession = base::make_weak(session);
+	const auto weakController = base::make_weak(controller);
+	const auto expected = SealedAutoChats();
+	const auto epoch = Epoch;
+	const auto id = Id(peer);
+	AddText(box, LowerOnly(peer->name()));
+	if (enabled) {
+		AddText(box, Lower(u"Clears cloud drafts and the attachment tray; drafts disappear on lock or exit."_q));
+	} else {
+		AddText(box, Lower(u"Future messages will be readable to Telegram; the current draft will be discarded."_q));
+	}
+	GuardSealedBox(box, session);
+	box->addButton(rpl::single(Lower(enabled ? u"Enable"_q : u"Turn off"_q)), [=] {
+		if (!weakController || !weakSession || !Available(weakSession.get()) || Epoch != epoch
+			|| SealedAutoChats() != expected || !Runtime || !Runtime->plan.valid
+			|| (enabled && (!binding || Binding(peer) != binding))) {
+			if (weakController) {
+				weakController->showToast(Lower(u"Encryption settings or keys changed; open this screen again."_q));
+			}
+			box->closeBox();
+			return;
+		}
+		auto plan = Runtime->plan;
+		if (enabled) {
+			if (!plan.chats.contains(id) && plan.chats.size() >= kSealedAutomaticChatLimit) {
+				controller->showToast(Lower(u"Too many chats use automatic encryption."_q));
+				return;
+			}
+			plan.chats[id] = *binding;
+		} else {
+			plan.chats.erase(id);
+		}
+		SetSealedAutoChats(EncodeSealedAutomaticPlan(plan));
+		SealedAutomaticModeChanged(weakSession.get(), peer);
+		box->closeBox();
+	});
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] { box->closeBox(); });
+}
+
+void ManagementBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	Prepare(box, Lower(u"Automatically encrypted chats"_q));
+	const auto session = &controller->session();
+	const auto weakSession = base::make_weak(session);
+	const auto weakBox = base::make_weak(box);
+	const auto weakController = base::make_weak(controller);
+	GuardSealedBox(box, session);
+	SealedAutomaticChanges() | rpl::on_next([=] { box->closeBox(); }, box->lifetime());
+	if (!Runtime || !Runtime->plan.valid) {
+		AddText(box, Lower(u"Automatic encryption settings are damaged, so sending is blocked until they are reset."_q));
+		AddText(box, Lower(u"Resetting makes all chats use ordinary readable messages."_q));
+		const auto expected = SealedAutoChats();
+		box->addButton(rpl::single(Lower(u"Reset"_q)), [=] {
+			RequireSealedOrdinaryPasscode(controller, [=] {
+				if (!weakBox || !weakController || !weakSession
+					|| !Available(weakSession.get()) || SealedAutoChats() != expected) return;
+				SetSealedAutoChats(QString());
+				weakBox->closeBox();
+			});
+		});
+	} else {
+		AddText(box, Lower(u"Choose a chat to turn off automatic encryption."_q));
+		auto count = 0;
+		for (const auto &[id, binding] : Runtime->plan.chats) {
+			if (id.test != session->isTestMode() || id.account != session->userId().bare) continue;
+			++count;
+			const auto peer = session->data().user(UserId(id.peer));
+			const auto button = box->addRow(Settings::CreateButtonWithIcon(
+				box,
+				rpl::single(LowerOnly(peer->name())),
+				st::settingsButton,
+				{ .icon = &st::menuIconLock, .type = Settings::IconType::Simple }
+			), style::margins(), style::al_justify);
+			button->setFocusPolicy(Qt::TabFocus);
+			button->setAllowTextLines(0);
+			button->setClickedCallback([=] {
+				if (weakController && weakSession && Available(weakSession.get())) {
+					SetSealedAutomaticChat(weakController.get(), peer, false);
+				}
+			});
+		}
+		if (!count) AddText(box, Lower(u"No chats in this account use automatic encryption."_q));
+	}
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+}
+
+}
+
+void StartSealedAutomatic(not_null<Main::Domain*> domain, rpl::lifetime &lifetime) {
+	Runtime = lifetime.make_state<AutomaticState>(domain);
+	Runtime->plan = ParseSealedAutomaticPlan(SealedAutoChats());
+	base::options::lookup<QString>(kOptionSealedAutoChats).changes(
+	) | rpl::on_next([] {
+		if (Runtime) Runtime->plan = ParseSealedAutomaticPlan(SealedAutoChats());
+		Invalidate();
+	}, lifetime);
+	base::options::lookup<bool>(kOptionEncryptedMessages).changes(
+	) | rpl::on_next(Invalidate, lifetime);
+	domain->local().localPasscodeChanged() | rpl::on_next(Invalidate, lifetime);
+	SealedDuressChanges() | rpl::on_next(Invalidate, lifetime);
+	domain->accountsChanges() | rpl::on_next(Invalidate, lifetime);
+	domain->activeValue() | rpl::on_next([=](Main::Account *account) {
+		Runtime->activeLifetime.destroy();
+		Invalidate();
+		if (account) {
+			account->sessionChanges() | rpl::on_next(Invalidate, Runtime->activeLifetime);
+		}
+	}, lifetime);
+	const auto state = Runtime;
+	crl::on_main(domain, [=] {
+		if (Runtime != state) return;
+		Core::App().passcodeLockChanges() | rpl::on_next(Invalidate, state->applicationLifetime);
+		StartSealedSend(domain, state->applicationLifetime);
+		StartSealedSearch(domain, state->applicationLifetime);
+		Invalidate();
+	});
+}
+
+bool SealedAutomaticSelected(not_null<History*> history) {
+	const auto peer = history->peer->asUser();
+	if (!peer || Secret::IsSecretPeer(peer)) return false;
+	return Runtime ? SealedAutomaticPlanSelected(Runtime->plan, Id(peer)) : !SealedAutoChats().isEmpty();
+}
+
+SealedAutomaticState SealedAutomaticStateFor(not_null<History*> history) {
+	if (!SealedAutomaticSelected(history)) return SealedAutomaticState::Off;
+	return SealedAutomaticKeys(history, SealedKeyPurpose::Send)
+		? SealedAutomaticState::Ready : SealedAutomaticState::Blocked;
+}
+
+std::optional<SealedContactKeys> SealedAutomaticKeys(
+		not_null<History*> history,
+		SealedKeyPurpose purpose) {
+	const auto peer = history->peer->asUser();
+	if (!Runtime || !Runtime->plan.valid || !peer || !EncryptedMessages()
+		|| Secret::IsSecretPeer(peer)
+		|| (purpose != SealedKeyPurpose::ReadOwn
+			&& (peer->isBot() || peer->isServiceUser() || peer->isInaccessible()))) return std::nullopt;
+	const auto selected = Runtime->plan.chats.find(Id(peer));
+	if (selected == Runtime->plan.chats.end()) return std::nullopt;
+	const auto keys = Stored(&history->session());
+	if (!keys || keys->error != SealedStoreError::None || !keys->identity) return std::nullopt;
+	const auto own = Fingerprint(keys->identity->publicKey);
+	if (purpose == SealedKeyPurpose::ReadOwn) {
+		if (!MatchesSealedAutomaticBinding(selected->second, own, QByteArray(), true)) return std::nullopt;
+		return SealedContactKeys{ keys->identity.value(), QByteArray() };
+	}
+	const auto found = keys->peers.find(peerToUser(peer->id).bare);
+	if (!peer->isSelf() && found == keys->peers.end()) return std::nullopt;
+	const auto remote = peer->isSelf() ? keys->identity->publicKey : found->second;
+	if (!MatchesSealedAutomaticBinding(selected->second, own, Fingerprint(remote), false)) return std::nullopt;
+	return SealedContactKeys{ keys->identity.value(), remote };
+}
+
+uint64 SealedAutomaticEpoch() {
+	return Epoch;
+}
+
+rpl::producer<> SealedAutomaticChanges() {
+	return Changes.events();
+}
+
+void NotifySealedAutomaticKeysChanged(not_null<Main::Session*> session) {
+	(void)session;
+	Invalidate();
+}
+
+void SetSealedAutomaticChat(
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer,
+		bool enabled) {
+	const auto session = &controller->session();
+	if (&peer->session() != session || !Available(session)) {
+		controller->showToast(Lower(u"Unlock tele and set a local passcode first."_q));
+		return;
+	} else if (!Runtime->plan.valid) {
+		ShowSealedAutomaticChats(controller);
+		return;
+	}
+	const auto binding = enabled ? Binding(peer) : std::nullopt;
+	if (enabled && !binding) {
+		controller->showToast(Lower(peer->isSelf()
+			? u"Create a device key first."_q
+			: u"Create a device key and verify this person's public key first."_q));
+		return;
+	} else if (!enabled && !Runtime->plan.chats.contains(Id(peer))) {
+		return;
+	}
+	controller->show(Box(ConfirmChatBox, controller, peer, enabled, binding));
+}
+
+void ShowSealedAutomaticChats(not_null<Window::SessionController*> controller) {
+	if (!Available(&controller->session())) {
+		controller->showToast(Lower(u"Unlock tele and set a local passcode first."_q));
+		return;
+	}
+	controller->show(Box(ManagementBox, controller));
+}
+
+}
