+#include <QtCore/QDataStream>
+#include <QtCore/QUrl>
+
+#include <openssl/crypto.h>
+
+#include <algorithm>
+#include <atomic>
+#include <map>
+#include <set>
+#include <utility>
+
+namespace Tele {
+namespace {
+
+constexpr auto kViewLimit = 256;
+constexpr auto kNeighborLimit = 128;
+constexpr auto kGroupLimit = 64;
+constexpr auto kCacheBytes = qsizetype(128 * 1024);
+constexpr auto kTokenLimit = 4096;
+
+void Wipe(QString &text) {
+	if (!text.isEmpty()) OPENSSL_cleanse(text.data(), size_t(text.size()) * sizeof(QChar));
+	text.clear();
+}
+
+void Wipe(SealedRichText &text) {
+	Wipe(text.text);
+	for (auto &tag : text.tags) Wipe(tag.id);
+	text.tags.clear();
+}
+
+bool Decimal(QStringView text, bool nonzero) {
+	auto ok = false;
+	const auto value = text.toULongLong(&ok);
+	return ok && (!nonzero || value) && QString::number(value) == text;
+}
+
+std::optional<QString> SafeTag(const QString &source) {
+	using Field = Ui::InputField;
+	auto result = QString();
+	for (const auto &tag : source.split(QChar('\\'), Qt::SkipEmptyParts)) {
+		auto value = tag;
+		if (tag == Field::kTagBold || tag == Field::kTagItalic
+			|| tag == Field::kTagUnderline || tag == Field::kTagStrikeOut
+			|| tag == Field::kTagCode || tag == Field::kTagSpoiler
+			|| tag == Field::kTagBlockquote || tag == Field::kTagBlockquoteCollapsed
+			|| tag == Field::kTagIvMarked || tag == Field::kTagIvSubscript
+			|| tag == Field::kTagIvSuperscript) {
+		} else if (tag.startsWith(Field::kTagPre)) {
+			const auto language = QStringView(tag).mid(Field::kTagPre.size());
+			if (language.size() > 64 || std::any_of(language.begin(), language.end(), [](QChar c) {
+				return !((c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z')
+					|| (c >= u'0' && c <= u'9') || c == u'_' || c == u'-'
+					|| c == u'+' || c == u'#' || c == u'.');
+			})) return std::nullopt;
+		} else if (Field::IsCustomEmojiLink(tag)) {
+			const auto data = Field::CustomEmojiEntityData(tag);
+			if (!Decimal(data, true)) return std::nullopt;
+			const auto index = tag.indexOf('?');
+			if (index >= 0 && !Decimal(QStringView(tag).mid(index + 1), false)) return std::nullopt;
+			value = Field::kCustomEmojiTagStart + data;
+			if (index >= 0) value += tag.mid(index);
+		} else if (Field::IsCustomDateLink(tag) || tag.startsWith(u"td-date-data-"_q)
+			|| TextUtilities::IsMentionLink(tag)) {
+			continue;
+		} else {
+			auto url = QUrl(tag, QUrl::StrictMode);
+			if (url.scheme().isEmpty() && tag.contains(QChar('.'))
+				&& !tag.startsWith(QChar('/')) && !tag.contains(QChar('@'))) {
+				url = QUrl(u"https://"_q + tag, QUrl::StrictMode);
+				value = url.toString();
+			}
+			const auto scheme = url.scheme().toLower();
+			if (!url.isValid() || !Field::IsValidMarkdownLink(tag)
+				|| !((scheme == u"http"_q || scheme == u"https"_q)
+					? !url.host().isEmpty()
+					: scheme == u"mailto"_q && !url.path().isEmpty())) return std::nullopt;
+		}
+		result = TextUtilities::TagWithAdded(result, value);
+	}
+	return result;
+}
+
+bool Normalize(const SealedRichText &source, SealedRichText &result) {
+	if (!ValidateSealedRichText(source)) return false;
+	auto normalized = SealedRichText{ .text = source.text };
+	for (const auto &tag : source.tags) {
+		const auto safe = SafeTag(tag.id);
+		if (!safe) return false;
+		if (!safe->isEmpty()) normalized.tags.push_back({ tag.offset, tag.length, *safe });
+	}
+	if (!ValidateSealedRichText(normalized)) return false;
+	result = std::move(normalized);
+	return true;
+}
+
+bool ContextAllowed(const HistoryView::Element *view) {
+	using Context = HistoryView::Context;
+	return view && (view->context() == Context::History || view->context() == Context::Replies
+		|| view->context() == Context::Pinned || view->context() == Context::SavedSublist);
+}
+
+bool TokenItem(HistoryItem *item) {
+	return item && item->originalText().text.size() <= kTokenLimit
+		&& item->originalText().text.startsWith(u"tele-sealed:v2:"_q);
+}
+
+bool Eligible(HistoryItem *item) {
+	return TokenItem(item) && item->isRegular() && IsServerMsgId(item->id)
+		&& !item->isSending() && !item->hasFailed() && !item->isService()
+		&& !item->media() && !item->isSponsored() && !item->groupId()
+		&& !item->Get<HistoryMessageForwarded>() && !item->Get<HistoryMessageEdited>()
+		&& item->history()->peer->asUser() && item->computeUnavailableReason().isEmpty();
+}
+
+struct Provider {
+	std::function<std::vector<HistoryView::Element*>(const HistoryView::Element*, int)> neighbors;
+	std::function<void()> changed;
+	quint64 instance = 0;
+};
+
+std::map<const HistoryView::ElementDelegate*, Provider> Providers;
+quint64 NextProvider = 0;
+
+const void *Scope(const HistoryView::Element *view) {
+	return view->block() ? static_cast<const void*>(view->history().get())
+		: static_cast<const void*>(view->delegate().get());
+}
+
+std::vector<HistoryView::Element*> Neighbors(const HistoryView::Element *view) {
+	if (!ContextAllowed(view)) return {};
+	if (!view->block()) {
+		const auto provider = Providers.find(view->delegate());
+		return provider != Providers.end() ? provider->second.neighbors(view, kNeighborLimit)
+			: std::vector<HistoryView::Element*>{ const_cast<HistoryView::Element*>(view) };
+	}
+	auto result = std::vector<HistoryView::Element*>();
+	auto first = const_cast<HistoryView::Element*>(view);
+	for (auto i = 0; i < kSealedRichPartLimit; ++i) {
+		const auto previous = first->previousInBlocks();
+		if (!previous) break;
+		first = previous;
+	}
+	for (auto current = first; current && result.size() < kNeighborLimit; current = current->nextInBlocks()) {
+		result.push_back(current);
+	}
+	return result;
+}
+
+struct Member {
+	base::weak_ptr<HistoryView::Element> view;
+	FullMsgId id;
+	QString token;
+};
+
+struct Proof {
+	const void *scope = nullptr;
+	std::vector<Member> members;
+	QByteArray group;
+	QByteArray signature;
+	QByteArray own;
+	QByteArray expected;
+	QByteArray context;
+	PeerId sender;
+	quint64 epoch = 0;
+};
+
+struct Recipe {
+	Proof proof;
+	SealedContactKeys keys;
+};
+
+struct Result {
+	QByteArray bytes;
+	~Result() {
+		if (!bytes.isEmpty()) OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+	}
+};
+
+bool NativeResult(const Result &result, TextWithEntities &native) {
+	auto rich = DecodeSealedRichText(result.bytes);
+	if (!rich) return false;
+	const auto wipe = gsl::finally([&] { Wipe(*rich); });
+	return SealedRichToNative(*rich, native);
+}
+
+struct Job {
+	Proof proof;
+	std::shared_ptr<std::atomic_bool> canceled;
+};
+
+struct Entry {
+	Proof proof;
+	std::shared_ptr<Result> result;
+	qsizetype bytes = 0;
+	quint64 touched = 0;
+};
+
+struct ViewRecord {
+	base::weak_ptr<HistoryView::Element> view;
+	QString token;
+	std::optional<SealedRichPartHeader> header;
+	QByteArray groupKey;
+	QByteArray renderKey;
+	bool populated = false;
+	quint64 touched = 0;
+};
+
+struct HeaderRecord {
+	QString token;
+	std::optional<SealedRichPartHeader> header;
+	quint64 touched = 0;
+};
+
+class SessionParts;
+std::map<Main::Session*, SessionParts*> Sessions;
+bool Clearing = false;
+quint64 NextInstance = 0;
+
+void PumpAll();
+std::optional<SealedRichPartHeader> HeaderFor(const HistoryView::Element *view);
+
+QByteArray Digest(const QByteArray &bytes) {
+	return QCryptographicHash::hash(bytes, QCryptographicHash::Sha256);
+}
+
+QByteArray GroupKey(const Proof &proof) {
+	auto bytes = QByteArray();
+	QDataStream stream(&bytes, QIODevice::WriteOnly);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << quint64(reinterpret_cast<quintptr>(proof.scope)) << proof.epoch << proof.group
+		<< quint64(proof.members.front().id.peer.value) << quint64(proof.sender.value);
+	return Digest(bytes);
+}
+
+
+
+}
+
+bool SealedPartItemEligible(const HistoryItem *item) {
+	return Eligible(const_cast<HistoryItem*>(item));
+}
+
+bool SealedRichFromNative(const TextWithTags &source, SealedRichText &result) {
+	auto text = SealedRichText{ .text = source.text };
+	text.tags.reserve(source.tags.size());
+	for (const auto &tag : source.tags) text.tags.push_back({ tag.offset, tag.length, tag.id });
+	return Normalize(text, result);
+}
+
+bool SealedRichToNative(const SealedRichText &source, TextWithEntities &result) {
+	auto normalized = SealedRichText();
+	if (!Normalize(source, normalized)) return false;
+	auto tags = TextWithTags::Tags();
+	tags.reserve(normalized.tags.size());
+	for (const auto &tag : normalized.tags) tags.push_back({ tag.offset, tag.length, tag.id });
+	result = { normalized.text, TextUtilities::ConvertTextTagsToEntities(tags) };
+	return true;
+}
+
+namespace {
+
+bool ExtraFollowerUi(const HistoryView::Element *view) {
+	const auto item = view->data();
+	return view->displayDate() || view->Has<HistoryView::UnreadBar>()
+		|| view->displayForumThreadBar() || view->Has<HistoryView::ServicePreMessage>()
+		|| view->Has<HistoryView::ViewAddedMargins>() || item->replyToId()
+		|| item->inlineReplyMarkup() || !item->reactions().empty();
+}
+
+bool Visible(const HistoryView::Element *view) {
+	return view && ContextAllowed(view)
+		&& view->history()->owner().queryItemVisibility(view->data(), view);
+}
+
+bool ProofLive(const Proof &proof, not_null<Main::Session*> session) {
+	if (Clearing || !proof.epoch || proof.epoch != SealedAutomaticEpoch() || proof.members.empty()) return false;
+	for (auto i = size_t(); i < proof.members.size(); ++i) {
+		const auto &member = proof.members[i];
+		const auto view = member.view.get();
+		const auto item = session->data().message(member.id);
+		if (!view || !item || view->data() != item || !Eligible(item)
+			|| Scope(view) != proof.scope || item->from()->id != proof.sender
+			|| item->originalText().text != member.token || (i && ExtraFollowerUi(view))) return false;
+	}
+	const auto first = proof.members.front().view.get();
+	if (!first || !SealedAutomaticSelected(first->history())) return false;
+	const auto nearby = Neighbors(first);
+	const auto start = std::find(nearby.begin(), nearby.end(), first);
+	if (start == nearby.end() || size_t(nearby.end() - start) < proof.members.size()) return false;
+	for (auto i = size_t(); i < proof.members.size(); ++i) {
+		if (start[i] != proof.members[i].view.get()) return false;
+	}
+	auto count = 0;
+	for (const auto view : nearby) {
+		if (!view || view->history() != first->history() || Scope(view) != proof.scope
+			|| view->data()->from()->id != proof.sender || !TokenItem(view->data())) continue;
+		const auto header = HeaderFor(view);
+		if (!header || header->group != proof.group) continue;
+		if (header->count != int(proof.members.size()) || header->index >= int(proof.members.size())
+			|| proof.members[header->index].view.get() != view) return false;
+		++count;
+	}
+	if (count != int(proof.members.size())) return false;
+	const auto own = proof.sender == session->userPeerId();
+	const auto keys = SealedAutomaticKeys(first->history(), own
+		? SealedKeyPurpose::ReadOwn : SealedKeyPurpose::ReadIncoming);
+	return keys && keys->identity.publicKey == proof.own
+		&& (own ? keys->identity.publicKey : keys->peerKey) == proof.expected
+		&& proof.epoch == SealedAutomaticEpoch();
+}
+
+bool GroupVisible(const Proof &proof) {
+	return std::any_of(proof.members.begin(), proof.members.end(), [](const Member &member) {
+		return member.view && Visible(member.view.get());
+	});
+}
+
+std::optional<Recipe> Build(const HistoryView::Element *anchor) {
+	if (Clearing || !ContextAllowed(anchor) || !Eligible(anchor->data())
+		|| !SealedAutomaticSelected(anchor->history())) return std::nullopt;
+	const auto header = HeaderFor(anchor);
+	if (!header) return std::nullopt;
+	const auto neighbors = Neighbors(anchor);
+	if (neighbors.size() > kNeighborLimit) return std::nullopt;
+	const auto session = &anchor->history()->session();
+	const auto sender = anchor->data()->from()->id;
+	const auto scope = Scope(anchor);
+	const auto own = sender == session->userPeerId();
+	if (!own && sender != anchor->history()->peer->id) return std::nullopt;
+	auto members = std::vector<Member>();
+	auto last = -2;
+	for (auto i = 0; i < int(neighbors.size()); ++i) {
+		const auto view = neighbors[i];
+		if (!view || view->history() != anchor->history() || Scope(view) != scope
+			|| view->data()->from()->id != sender || !TokenItem(view->data())) continue;
+		const auto part = HeaderFor(view);
+		if (!part || part->group != header->group) continue;
+		if (part->count != header->count || part->index != int(members.size())
+			|| (!members.empty() && i != last + 1) || !Eligible(view->data())
+			|| (!members.empty() && (ExtraFollowerUi(view)
+				|| view->dateTime().date() != members.front().view->dateTime().date()))) return std::nullopt;
+		members.push_back({ base::make_weak(view), view->data()->fullId(), view->data()->originalText().text });
+		last = i;
+	}
+	if (members.size() != size_t(header->count)) return std::nullopt;
+	const auto epoch = SealedAutomaticEpoch();
+	auto keys = SealedAutomaticKeys(anchor->history(), own
+		? SealedKeyPurpose::ReadOwn : SealedKeyPurpose::ReadIncoming);
+	if (!keys || !epoch || epoch != SealedAutomaticEpoch()) return std::nullopt;
+	const auto expected = own ? keys->identity.publicKey : keys->peerKey;
+	const auto context = SealedContext(session,
+		own ? session->userId().bare : peerToUser(sender).bare,
+		own ? peerToUser(anchor->history()->peer->id).bare : session->userId().bare);
+	auto bytes = QByteArray();
+	QDataStream stream(&bytes, QIODevice::WriteOnly);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << epoch << keys->identity.publicKey << expected << context;
+	for (const auto &member : members) stream << quint64(member.id.peer.value) << qint64(member.id.msg.bare) << member.token;
+	return Recipe{ { scope, std::move(members), header->group, Digest(bytes),
+		keys->identity.publicKey, expected, context, sender, epoch }, std::move(*keys) };
+}
+
+class SessionParts final {
+public:
+	explicit SessionParts(not_null<Main::Session*> value) : session(value), instance(++NextInstance) {
+		Sessions.emplace(session, this);
+		session->data().itemVisibilitiesUpdates() | rpl::on_next([=] { schedule(); }, lifetime);
+		session->data().itemRemoved() | rpl::on_next([=](not_null<const HistoryItem*> item) {
+			invalidate(item->fullId());
+			std::erase_if(views, [&](const auto &entry) { return entry.second.view && entry.second.view->data() == item; });
+		}, lifetime);
+		session->data().itemIdChanged() | rpl::on_next([=] { clear(); schedule(); }, lifetime);
+		session->data().itemDataChanges() | rpl::on_next([=](not_null<HistoryItem*> item) {
+			validate(item->fullId());
+			schedule();
+		}, lifetime);
+		session->data().sessionDataAboutToBeCleared() | rpl::on_next([=] { clear(); }, lifetime);
+		SealedAutomaticChanges() | rpl::on_next([=] { schedule(); }, lifetime);
+		SealedDecryptJobsChanges() | rpl::on_next([=] { schedule(); }, lifetime);
+		session->changes().historyUpdates(Data::HistoryUpdate::Flag::OutboxRead
+			| Data::HistoryUpdate::Flag::UnreadView) | rpl::on_next([=] {
+			for (const auto &[key, entry] : groups) {
+				if (const auto view = entry.proof.members.front().view.get()) view->repaint();
+			}
+		}, lifetime);
+		const auto weak = base::make_weak(session.get());
+		const auto token = instance;
+		crl::on_main(session, [=] {
+			const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+			if (i == Sessions.end() || i->second->instance != token) return;
+			Core::App().passcodeLockChanges() | rpl::on_next([=](bool locked) { if (locked) clear(); }, lifetime);
+			Core::App().domain().activeSessionChanges() | rpl::on_next([=](Main::Session *active) {
+				if (active != session) clear();
+			}, lifetime);
+			session->account().sessionChanges() | rpl::on_next([=](Main::Session *active) {
+				if (active != session) clear();
+			}, lifetime);
+		});
+	}
+
+	~SessionParts() {
+		for (const auto &[key, job] : jobs) job.canceled->store(true);
+		Sessions.erase(session);
+	}
+
+	std::optional<SealedRichPartHeader> header(const HistoryView::Element *view) {
+		auto &cached = headers[view];
+		if (cached.token != view->data()->originalText().text) {
+			cached.token = view->data()->originalText().text;
+			cached.header = ParseSealedRichPartHeader(cached.token);
+		}
+		cached.touched = ++clock;
+		while (headers.size() > size_t(kViewLimit * 2)) {
+			const auto old = std::min_element(headers.begin(), headers.end(), [](const auto &a, const auto &b) {
+				return a.second.touched < b.second.touched;
+			});
+			headers.erase(old);
+		}
+		return cached.header;
+	}
+
+	void touch(HistoryView::Element *view) {
+		auto &record = views[view];
+		record.view = base::make_weak(view);
+		record.touched = ++clock;
+		if (record.token != view->data()->originalText().text) {
+			const auto old = record.groupKey;
+			record.token = view->data()->originalText().text;
+			record.header = header(view);
+			record.renderKey.clear();
+			if (!old.isEmpty()) drop(old);
+		}
+		while (views.size() > kViewLimit) {
+			const auto old = std::min_element(views.begin(), views.end(), [](const auto &a, const auto &b) {
+				return a.second.touched < b.second.touched;
+			});
+			const auto key = old->second.groupKey;
+			views.erase(old);
+			if (!key.isEmpty()) drop(key);
+		}
+		schedule();
+	}
+
+	void notify(const Proof &proof) {
+		const auto guard = gsl::finally([&] { --resetting; });
+		++resetting;
+		auto targets = std::vector<base::weak_ptr<HistoryView::Element>>();
+		for (const auto &member : proof.members) {
+			if (member.view) {
+				targets.push_back(member.view);
+				if (const auto next = member.view->nextInBlocks()) targets.push_back(base::make_weak(next));
+			}
+		}
+		for (const auto &view : targets) {
+			if (!view) continue;
+			view->itemTextUpdated();
+			if (view && view->block()) view->previousInBlocksChanged();
+			if (view) session->data().requestViewResize(view.get());
+		}
+		if (!proof.members.empty() && proof.members.front().view) {
+			const auto provider = Providers.find(proof.members.front().view->delegate());
+			if (provider != Providers.end() && provider->second.changed) {
+				const auto changed = provider->second.changed;
+				changed();
+			}
+		}
+	}
+
+	void drop(const QByteArray &key, bool repaint = true) {
+		const auto i = groups.find(key);
+		if (i == groups.end()) return;
+		auto old = std::move(i->second);
+		groups.erase(i);
+		bytes -= old.bytes;
+		for (auto &[pointer, record] : views) {
+			if (record.groupKey == key) { record.groupKey.clear(); record.renderKey.clear(); }
+		}
+		if (repaint) notify(old.proof);
+	}
+
+	void clear() {
+		++serial;
+		for (const auto &[key, job] : jobs) job.canceled->store(true);
+		jobs.clear();
+		attempted.clear();
+		inflight.clear();
+		auto keys = std::vector<QByteArray>();
+		for (const auto &[key, entry] : groups) keys.push_back(key);
+		for (const auto &key : keys) drop(key);
+		auto remaining = std::vector<base::weak_ptr<HistoryView::Element>>();
+		for (auto &[pointer, record] : views) {
+			if (record.populated && record.view) remaining.push_back(record.view);
+			record.populated = false;
+			record.renderKey.clear();
+		}
+		for (const auto &view : remaining) {
+			if (view) {
+				view->itemTextUpdated();
+				if (view) session->data().requestViewResize(view.get());
+			}
+		}
+	}
+
+	void invalidate(FullMsgId id) {
+		for (const auto &[key, job] : jobs) {
+			if (std::any_of(job.proof.members.begin(), job.proof.members.end(), [&](const Member &member) { return member.id == id; })) job.canceled->store(true);
+		}
+		auto keys = std::vector<QByteArray>();
+		for (const auto &[key, entry] : groups) {
+			if (std::any_of(entry.proof.members.begin(), entry.proof.members.end(), [&](const Member &member) { return member.id == id; })) {
+				keys.push_back(key);
+			}
+		}
+		for (const auto &key : keys) { attempted.erase(key); drop(key); }
+	}
+
+	void validate(FullMsgId id) {
+		for (const auto &[key, job] : jobs) {
+			if (std::any_of(job.proof.members.begin(), job.proof.members.end(), [&](const Member &member) { return member.id == id; })
+				&& !ProofLive(job.proof, session)) job.canceled->store(true);
+		}
+		auto keys = std::vector<QByteArray>();
+		for (const auto &[key, entry] : groups) {
+			if (std::any_of(entry.proof.members.begin(), entry.proof.members.end(), [&](const Member &member) { return member.id == id; })
+				&& !ProofLive(entry.proof, session)) keys.push_back(key);
+		}
+		for (const auto &key : keys) { attempted.erase(key); drop(key); }
+	}
+
+	Entry *entry(const HistoryView::Element *view) {
+		const auto record = views.find(view);
+		if (record == views.end() || record->second.groupKey.isEmpty()) return nullptr;
+		const auto i = groups.find(record->second.groupKey);
+		if (i == groups.end() || !ProofLive(i->second.proof, session)) return nullptr;
+		i->second.touched = ++clock;
+		return &i->second;
+	}
+
+	void schedule() {
+		if (queued || Clearing) return;
+		queued = true;
+		const auto weak = base::make_weak(session.get());
+		const auto token = instance;
+		crl::on_main(session, [=] {
+			const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+			if (i == Sessions.end() || i->second->instance != token) return;
+			i->second->queued = false;
+			PumpAll();
+		});
+	}
+
+	void pump() {
+		if (Clearing || Core::Quitting()) return;
+		std::erase_if(views, [](const auto &entry) { return !entry.second.view; });
+		auto stale = std::vector<QByteArray>();
+		for (const auto &[key, entry] : groups) {
+			if (!ProofLive(entry.proof, session) || !GroupVisible(entry.proof)) stale.push_back(key);
+		}
+		for (const auto &key : stale) drop(key);
+		std::erase_if(attempted, [&](const auto &entry) {
+			return !groups.contains(entry.first) && !std::any_of(views.begin(), views.end(), [&](const auto &record) {
+				const auto view = record.second.view.get();
+				return view && record.second.header && Scope(view) == entry.second.scope
+					&& record.second.header->group == entry.second.group && Visible(view);
+			});
+		});
+		for (const auto &[key, job] : jobs) {
+			if (!ProofLive(job.proof, session) || !GroupVisible(job.proof)) job.canceled->store(true);
+		}
+		if (!SealedDecryptJobAvailable()) return;
+		auto checked = std::map<const void*, std::set<std::pair<PeerId, QByteArray>>>();
+		const auto records = views;
+		for (const auto &[pointer, record] : records) {
+			const auto view = record.view.get();
+			if (!view || !record.header || !Visible(view) || !SealedAutomaticSelected(view->history())
+				|| !checked[Scope(view)].emplace(view->data()->from()->id, record.header->group).second) continue;
+			auto recipe = Build(view);
+			if (!recipe) continue;
+			const auto key = GroupKey(recipe->proof);
+			const auto signature = recipe->proof.signature;
+			if (groups.contains(key) || inflight.contains(key)) continue;
+			const auto attempt = attempted.find(key);
+			if (attempt != attempted.end() && attempt->second.signature == signature) continue;
+			auto permit = TrySealedDecryptJob();
+			if (!permit) return;
+			attempted[key] = { signature, recipe->proof.group, recipe->proof.scope };
+			const auto proof = recipe->proof;
+			const auto generation = serial;
+			const auto token = instance;
+			const auto weak = base::make_weak(session.get());
+			const auto canceled = std::make_shared<std::atomic_bool>(false);
+			inflight[key] = signature;
+			jobs[key] = { proof, canceled };
+			crl::async([=, keys = std::move(recipe->keys), permit = std::move(permit)] {
+				(void)permit;
+				auto result = std::make_shared<Result>();
+				auto parts = std::vector<SealedRichPart>();
+				const auto wipe = gsl::finally([&] {
+					for (auto &part : parts) {
+						if (!part.bytes.isEmpty()) OPENSSL_cleanse(part.bytes.data(), size_t(part.bytes.size()));
+					}
+				});
+				for (const auto &member : proof.members) {
+					if (canceled->load()) break;
+					auto part = DecryptSealedRichPart(keys.identity.privateKey, proof.expected, member.token, proof.context);
+					if (!part) break;
+					parts.push_back(std::move(*part));
+				}
+				if (!canceled->load() && parts.size() == proof.members.size()) {
+					auto rich = MergeSealedRichParts(parts);
+					if (rich) {
+						const auto wipeRich = gsl::finally([&] { Wipe(*rich); });
+						auto encoded = EncodeSealedRichText(*rich);
+						if (encoded) result->bytes = std::move(*encoded);
+					}
+				}
+				crl::on_main([=] {
+					const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+					if (!Core::Quitting() && i != Sessions.end() && i->second->instance == token) {
+						const auto state = i->second;
+						const auto pending = state->jobs.find(key);
+						if (pending != state->jobs.end() && pending->second.canceled == canceled) {
+							state->jobs.erase(pending);
+							state->inflight.erase(key);
+						}
+						if (canceled->load()) {
+							const auto attempt = state->attempted.find(key);
+							if (attempt != state->attempted.end() && attempt->second.signature == signature) state->attempted.erase(attempt);
+						}
+						if (!canceled->load() && !result->bytes.isEmpty() && generation == state->serial && ProofLive(proof, weak.get()) && GroupVisible(proof)) {
+							auto native = TextWithEntities();
+							const auto size = result->bytes.size();
+							if (size <= kCacheBytes && NativeResult(*result, native)) {
+								while (!state->groups.empty() && (state->groups.size() >= kGroupLimit || state->bytes + size > kCacheBytes)) {
+									const auto old = std::min_element(state->groups.begin(), state->groups.end(), [](const auto &a, const auto &b) {
+										return a.second.touched < b.second.touched;
+									});
+									state->drop(old->first);
+								}
+								for (const auto &member : proof.members) {
+									if (member.view) state->touch(member.view.get());
+								}
+								if (ProofLive(proof, weak.get())) {
+									state->groups[key] = { proof, result, size, ++state->clock };
+									state->bytes += size;
+									for (const auto &member : proof.members) state->views[member.view.get()].groupKey = key;
+									state->notify(proof);
+								}
+							}
+						}
+					}
+					if (!Core::Quitting()) PumpAll();
+				});
+			});
+			if (!SealedDecryptJobAvailable()) return;
+		}
+	}
+
+	struct Attempt {
+		QByteArray signature;
+		QByteArray group;
+		const void *scope = nullptr;
+	};
+
+	not_null<Main::Session*> session;
+	quint64 instance = 0;
+	quint64 serial = 0;
+	quint64 clock = 0;
+	qsizetype bytes = 0;
+	int resetting = 0;
+	bool queued = false;
+	std::map<const HistoryView::Element*, ViewRecord> views;
+	std::map<const HistoryView::Element*, HeaderRecord> headers;
+	std::map<QByteArray, Entry> groups;
+	std::map<QByteArray, Attempt> attempted;
+	std::map<QByteArray, QByteArray> inflight;
+	std::map<QByteArray, Job> jobs;
+	rpl::lifetime lifetime;
+};
+
+void PumpAll() {
+	for (const auto &[session, state] : Sessions) state->pump();
+}
+
+SessionParts &State(not_null<Main::Session*> session) {
+	const auto i = Sessions.find(session);
+	return i != Sessions.end() ? *i->second : *session->lifetime().make_state<SessionParts>(session);
+}
+
+std::optional<SealedRichPartHeader> HeaderFor(const HistoryView::Element *view) {
+	const auto state = Sessions.find(&view->history()->session());
+	return state != Sessions.end() ? state->second->header(view)
+		: ParseSealedRichPartHeader(view->data()->originalText().text);
+}
+
+Entry *ForView(const HistoryView::Element *view) {
+	if (Clearing || !view) return nullptr;
+	const auto state = Sessions.find(&view->history()->session());
+	return state != Sessions.end() ? state->second->entry(view) : nullptr;
+}
+
+Entry *ForItem(HistoryItem *item) {
+	if (Clearing || !item) return nullptr;
+	const auto state = Sessions.find(&item->history()->session());
+	if (state == Sessions.end()) return nullptr;
+	for (auto &[key, entry] : state->second->groups) {
+		if (!ProofLive(entry.proof, state->second->session) || !GroupVisible(entry.proof)) continue;
+		if (std::any_of(entry.proof.members.begin(), entry.proof.members.end(), [&](const Member &member) { return member.id == item->fullId(); })) return &entry;
+	}
+	return nullptr;
+}
+
+}
+
+void SetupSealedPartsList(
+		const HistoryView::ElementDelegate *scope,
+		std::function<std::vector<HistoryView::Element*>(const HistoryView::Element*, int)> neighbors,
+		std::function<void()> changed,
+		rpl::lifetime &lifetime) {
+	if (!scope || !neighbors) return;
+	const auto token = ++NextProvider;
+	Providers[scope] = { std::move(neighbors), std::move(changed), token };
+	lifetime.add([=] {
+		const auto provider = Providers.find(scope);
+		if (provider == Providers.end() || provider->second.instance != token) return;
+		Providers.erase(provider);
+		for (const auto &[session, state] : Sessions) {
+			auto keys = std::vector<QByteArray>();
+			for (const auto &[key, entry] : state->groups) {
+				if (entry.proof.scope == static_cast<const void*>(scope)) keys.push_back(key);
+			}
+			for (const auto &key : keys) state->drop(key, false);
+		}
+	});
+}
+
+std::vector<HistoryView::Element*> SealedPartsListWindow(
+		const std::vector<gsl::not_null<HistoryView::Element*>> &items,
+		const HistoryView::Element *anchor,
+		bool inverted,
+		int limit) {
+	if (!anchor || items.empty() || limit <= 0 || limit > kNeighborLimit) return {};
+	const auto position = anchor->data()->position();
+	const auto found = std::lower_bound(items.begin(), items.end(), position, [&](auto view, const auto &value) {
+		return inverted ? view->data()->position() > value : view->data()->position() < value;
+	});
+	if (found == items.end() || found->get() != anchor) return {};
+	const auto index = int(found - items.begin());
+	const auto from = std::max(index - limit / 2, 0);
+	const auto till = std::min(from + limit, int(items.size()));
+	auto result = std::vector<HistoryView::Element*>();
+	result.reserve(till - from);
+	for (auto i = from; i < till; ++i) result.push_back(items[i].get());
+	if (inverted) std::reverse(result.begin(), result.end());
+	return result;
+}
+
+void TouchSealedPartsView(const HistoryView::Element *view) {
+	if (Clearing || Core::Quitting() || !ContextAllowed(view)
+		|| !SealedAutomaticSelected(view->history()) || !TokenItem(view->data())) return;
+	State(&view->history()->session()).touch(const_cast<HistoryView::Element*>(view));
+}
+
+void ForgetSealedPartsView(const HistoryView::Element *view) {
+	if (!view) return;
+	const auto i = Sessions.find(&view->history()->session());
+	if (i == Sessions.end()) return;
+	i->second->views.erase(view);
+	i->second->headers.erase(view);
+	i->second->schedule();
+}
+
+void ResetSealedPartsViewText(const HistoryView::Element *view) {
+	if (!view) return;
+	const auto i = Sessions.find(&view->history()->session());
+	if (i == Sessions.end()) return;
+	const auto record = i->second->views.find(view);
+	if (record != i->second->views.end()) {
+		record->second.populated = false;
+		record->second.renderKey.clear();
+	}
+	if (!i->second->resetting) i->second->validate(view->data()->fullId());
+}
+
+void ClearSealedPartsViews() {
+	if (Clearing) return;
+	Clearing = true;
+	const auto restore = gsl::finally([] { Clearing = false; });
+	for (const auto &[session, state] : Sessions) state->clear();
+}
+
+bool UpdateSealedPartsViewText(
+		HistoryView::Element *view,
+		const std::function<void(const TextWithEntities&)> &apply) {
+	if (!ContextAllowed(view) || !SealedAutomaticSelected(view->history())
+		|| !TokenItem(view->data()) || Core::Quitting()) return false;
+	const auto header = HeaderFor(view);
+	if (!header) return false;
+	auto &state = State(&view->history()->session());
+	state.touch(view);
+	const auto record = state.views.find(view);
+	if (record == state.views.end()) return false;
+	const auto entry = ForView(view);
+	const auto leader = entry && entry->proof.members.front().view.get() == view;
+	const auto key = QByteArray(leader ? "rich:" : "part:")
+		+ QByteArray::number(SealedAutomaticEpoch()) + Digest(view->data()->originalText().text.toUtf8());
+	if (!record->second.populated || record->second.renderKey != key) {
+		auto text = TextWithEntities();
+		if (leader && NativeResult(*entry->result, text)) {
+		} else {
+			text.text = Lower(u"Encrypted message · part %1 of %2"_q).arg(header->index + 1).arg(header->count);
+		}
+		record->second.populated = true;
+		record->second.renderKey = key;
+		apply(text);
+	}
+	return true;
+}
+
+bool SealedPartsProtectSelection(const HistoryView::Element *view) {
+	return ContextAllowed(view) && SealedAutomaticSelected(view->history()) && TokenItem(view->data())
+		&& HeaderFor(view).has_value();
+}
+
+bool SealedPartsAuthenticated(const HistoryView::Element *view) {
+	const auto entry = ForView(view);
+	return entry && entry->proof.members.front().view.get() == view && Visible(view);
+}
+
+bool SealedTextFollowerHidden(const HistoryView::Element *view) {
+	const auto entry = ForView(view);
+	return entry && entry->proof.members.front().view.get() != view;
+}
+
+HistoryView::Element *SealedPartsVisibleLeader(const HistoryView::Element *view) {
+	const auto entry = ForView(view);
+	return entry ? entry->proof.members.front().view.get() : const_cast<HistoryView::Element*>(view);
+}
+
+HistoryItem *SealedPartsReadThrough(HistoryItem *item) {
+	const auto entry = ForItem(item);
+	if (!entry || !entry->proof.members.front().view || !Visible(entry->proof.members.front().view.get())) return item;
+	const auto last = item->history()->owner().message(entry->proof.members.back().id);
+	return last ? last : item;
+}
+
+HistoryItem *SealedPartsJumpItem(HistoryItem *item) {
+	if (!item || Clearing) return item;
+	const auto state = Sessions.find(&item->history()->session());
+	if (state == Sessions.end()) return item;
+	for (const auto &[key, entry] : state->second->groups) {
+		if (!ProofLive(entry.proof, state->second->session)) continue;
+		if (std::any_of(entry.proof.members.begin(), entry.proof.members.end(), [&](const Member &member) { return member.id == item->fullId(); })) {
+			const auto first = item->history()->owner().message(entry.proof.members.front().id);
+			return first ? first : item;
+		}
+	}
+	return item;
+}
+
+bool SealedPartsShownUnread(const HistoryView::Element *view, bool normal) {
+	const auto entry = ForView(view);
+	if (!entry || entry->proof.members.front().view.get() != view) return normal;
+	const auto last = view->history()->owner().message(entry->proof.members.back().id);
+	return last ? last->unread(last->history()) : normal;
+}
+
+std::vector<FullMsgId> SealedPartsCanonicalItems(HistoryItem *item) {
+	const auto entry = ForItem(item);
+	if (!entry) return item ? std::vector<FullMsgId>{ item->fullId() } : std::vector<FullMsgId>();
+	auto result = std::vector<FullMsgId>();
+	for (const auto &member : entry->proof.members) result.push_back(member.id);
+	return result;
+}
+
+bool HasSealedPartsDecryptedText(HistoryItem *item) {
+	return ForItem(item) != nullptr;
+}
+
+bool CopySealedPartsDecryptedText(Window::SessionController *controller, HistoryItem *item) {
+	if (!controller || !item || &controller->session() != &item->history()->session()) return false;
+	const auto entry = ForItem(item);
+	if (!entry || entry->result->bytes.isEmpty()) return false;
+	auto native = TextWithEntities();
+	if (!NativeResult(*entry->result, native)) return false;
+	auto copied = TextForMimeData::Rich(std::move(native));
+	for (const auto &tag : TextUtilities::ConvertEntitiesToTextTags(copied.rich.entities)) {
+		copied.tags.push_back({ tag.offset, tag.length, tag.id });
+	}
+	TextUtilities::SetClipboardText(copied);
+	return true;
+}
+
+}
