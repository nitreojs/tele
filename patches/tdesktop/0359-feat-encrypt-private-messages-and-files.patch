diff --git a/Telegram/SourceFiles/tele/tele_sealed_crypto.cpp b/Telegram/SourceFiles/tele/tele_sealed_crypto.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9b16a24a39c3ecf027648f1d4f1c4303dd2ca37a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_crypto.cpp
@@ -0,0 +1,958 @@
+#include "tele/tele_sealed_crypto.h"
+
+#include <QtCore/QCryptographicHash>
+
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/crypto.h>
+#include <openssl/ec.h>
+#include <openssl/param_build.h>
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+#include <openssl/rand.h>
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+namespace Tele {
+namespace {
+
+constexpr auto kAeadKeySize = 32;
+constexpr auto kHashSize = 64;
+constexpr auto kDhSize = 66;
+constexpr auto kTagSize = 16;
+constexpr auto kNonceSize = 12;
+constexpr auto kHeaderSize = 1 + 2 * kSealedPublicKeySize;
+constexpr auto kLengthSize = 4;
+constexpr auto kFileBucket = 64 * 1024;
+constexpr auto kContextLimit = 256;
+constexpr auto kWireLimit = 4096;
+constexpr auto kEnvelopeVersion = char(1);
+constexpr auto kFileVersion = char(2);
+constexpr auto kBackupSaltSize = 16;
+constexpr auto kBackupIterations = 600000;
+constexpr auto kPassphraseLimit = 1024;
+constexpr auto kBackupMagic = "tele-sealed-key-backup:v1";
+constexpr auto kRecipientRole = char(0);
+constexpr auto kSenderRole = char(1);
+constexpr auto kPublicPrefix = "tele-key:v1:";
+constexpr auto kEnvelopePrefix = "tele-sealed:v1:";
+using PKey = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>;
+using PKeyContext = std::unique_ptr<EVP_PKEY_CTX, decltype(&EVP_PKEY_CTX_free)>;
+using BigNumber = std::unique_ptr<BIGNUM, decltype(&BN_clear_free)>;
+using EcGroup = std::unique_ptr<EC_GROUP, decltype(&EC_GROUP_free)>;
+using EcPoint = std::unique_ptr<EC_POINT, decltype(&EC_POINT_clear_free)>;
+using ParameterBuilder = std::unique_ptr<OSSL_PARAM_BLD, decltype(&OSSL_PARAM_BLD_free)>;
+struct CleanParameters {
+	void operator()(OSSL_PARAM *parameters) const {
+		if (parameters) {
+			for (auto current = parameters; current->key; ++current) {
+				if (current->data && current->data_size) {
+					OPENSSL_cleanse(current->data, current->data_size);
+				}
+			}
+			OSSL_PARAM_free(parameters);
+		}
+	}
+};
+using Parameters = std::unique_ptr<OSSL_PARAM, CleanParameters>;
+using CipherContext = std::unique_ptr<EVP_CIPHER_CTX, decltype(&EVP_CIPHER_CTX_free)>;
+
+void Clean(QByteArray &bytes) {
+	if (!bytes.isEmpty()) {
+		OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+		bytes.clear();
+	}
+}
+
+struct CleanBytes {
+	void operator()(QByteArray *bytes) const {
+		Clean(*bytes);
+		delete bytes;
+	}
+};
+
+using Secret = std::unique_ptr<QByteArray, CleanBytes>;
+
+struct HpkeContext {
+	Secret key;
+	Secret nonce;
+};
+
+[[nodiscard]] Secret NewSecret(qsizetype size = 0) {
+	return Secret(new QByteArray(size, Qt::Uninitialized));
+}
+
+[[nodiscard]] QByteArray CopyBytes(const QByteArray &bytes) {
+	return QByteArray(bytes.constData(), bytes.size());
+}
+
+[[nodiscard]] PKey EcKey(
+		const QByteArray &publicKey,
+		const BIGNUM *privateKey = nullptr) {
+	const auto builder = ParameterBuilder(OSSL_PARAM_BLD_new(), OSSL_PARAM_BLD_free);
+	if (!builder
+		|| OSSL_PARAM_BLD_push_utf8_string(
+			builder.get(), OSSL_PKEY_PARAM_GROUP_NAME, "secp521r1", 0) != 1
+		|| OSSL_PARAM_BLD_push_octet_string(
+			builder.get(), OSSL_PKEY_PARAM_PUB_KEY,
+			publicKey.constData(), size_t(publicKey.size())) != 1
+		|| (privateKey && OSSL_PARAM_BLD_push_BN(
+			builder.get(), OSSL_PKEY_PARAM_PRIV_KEY, privateKey) != 1)) {
+		return PKey(nullptr, EVP_PKEY_free);
+	}
+	const auto parameters = Parameters(OSSL_PARAM_BLD_to_param(builder.get()));
+	const auto context = PKeyContext(EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr), EVP_PKEY_CTX_free);
+	auto raw = static_cast<EVP_PKEY*>(nullptr);
+	const auto selection = privateKey ? EVP_PKEY_KEYPAIR : EVP_PKEY_PUBLIC_KEY;
+	if (!parameters || !context
+		|| EVP_PKEY_fromdata_init(context.get()) != 1
+		|| EVP_PKEY_fromdata(context.get(), &raw, selection, parameters.get()) != 1) {
+		EVP_PKEY_free(raw);
+		return PKey(nullptr, EVP_PKEY_free);
+	}
+	return PKey(raw, EVP_PKEY_free);
+}
+
+[[nodiscard]] PKey PrivateKey(const QByteArray &bytes) {
+	if (bytes.size() != kSealedPrivateKeySize) {
+		return PKey(nullptr, EVP_PKEY_free);
+	}
+	const auto scalar = BigNumber(BN_bin2bn(
+		reinterpret_cast<const unsigned char*>(bytes.constData()),
+		int(bytes.size()), nullptr), BN_clear_free);
+	const auto group = EcGroup(EC_GROUP_new_by_curve_name(NID_secp521r1), EC_GROUP_free);
+	if (!scalar || !group || BN_is_zero(scalar.get())
+		|| BN_cmp(scalar.get(), EC_GROUP_get0_order(group.get())) >= 0) {
+		return PKey(nullptr, EVP_PKEY_free);
+	}
+	BN_set_flags(scalar.get(), BN_FLG_CONSTTIME);
+	const auto point = EcPoint(EC_POINT_new(group.get()), EC_POINT_clear_free);
+	auto publicKey = QByteArray(kSealedPublicKeySize, Qt::Uninitialized);
+	if (!point || EC_POINT_mul(
+			group.get(), point.get(), scalar.get(), nullptr, nullptr, nullptr) != 1
+		|| EC_POINT_point2oct(
+			group.get(), point.get(), POINT_CONVERSION_UNCOMPRESSED,
+			reinterpret_cast<unsigned char*>(publicKey.data()),
+			size_t(publicKey.size()), nullptr) != kSealedPublicKeySize) {
+		return PKey(nullptr, EVP_PKEY_free);
+	}
+	return EcKey(publicKey, scalar.get());
+}
+
+[[nodiscard]] PKey PublicKey(const QByteArray &bytes) {
+	if (bytes.size() != kSealedPublicKeySize || bytes.front() != char(4)) {
+		return PKey(nullptr, EVP_PKEY_free);
+	}
+	const auto group = EcGroup(EC_GROUP_new_by_curve_name(NID_secp521r1), EC_GROUP_free);
+	const auto point = EcPoint(group ? EC_POINT_new(group.get()) : nullptr, EC_POINT_clear_free);
+	auto canonical = QByteArray(kSealedPublicKeySize, Qt::Uninitialized);
+	if (!group || !point
+		|| EC_POINT_oct2point(
+			group.get(), point.get(),
+			reinterpret_cast<const unsigned char*>(bytes.constData()),
+			size_t(bytes.size()), nullptr) != 1
+		|| EC_POINT_is_at_infinity(group.get(), point.get()) != 0
+		|| EC_POINT_is_on_curve(group.get(), point.get(), nullptr) != 1
+		|| EC_POINT_point2oct(
+			group.get(), point.get(), POINT_CONVERSION_UNCOMPRESSED,
+			reinterpret_cast<unsigned char*>(canonical.data()),
+			size_t(canonical.size()), nullptr) != kSealedPublicKeySize
+		|| canonical != bytes) {
+		return PKey(nullptr, EVP_PKEY_free);
+	}
+	auto result = EcKey(bytes);
+	const auto context = PKeyContext(result ? EVP_PKEY_CTX_new(result.get(), nullptr) : nullptr, EVP_PKEY_CTX_free);
+	return (context && EVP_PKEY_public_check(context.get()) == 1)
+		? std::move(result)
+		: PKey(nullptr, EVP_PKEY_free);
+}
+
+[[nodiscard]] Secret RandomPrivateKey() {
+	const auto context = PKeyContext(EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr), EVP_PKEY_CTX_free);
+	auto raw = static_cast<EVP_PKEY*>(nullptr);
+	if (!context || EVP_PKEY_keygen_init(context.get()) != 1
+		|| EVP_PKEY_CTX_set_group_name(context.get(), "secp521r1") != 1
+		|| EVP_PKEY_keygen(context.get(), &raw) != 1) {
+		EVP_PKEY_free(raw);
+		return nullptr;
+	}
+	const auto key = PKey(raw, EVP_PKEY_free);
+	auto rawScalar = static_cast<BIGNUM*>(nullptr);
+	if (EVP_PKEY_get_bn_param(key.get(), OSSL_PKEY_PARAM_PRIV_KEY, &rawScalar) != 1) {
+		BN_clear_free(rawScalar);
+		return nullptr;
+	}
+	const auto scalar = BigNumber(rawScalar, BN_clear_free);
+	auto result = NewSecret(kSealedPrivateKeySize);
+	return (BN_bn2binpad(scalar.get(),
+		reinterpret_cast<unsigned char*>(result->data()), kSealedPrivateKeySize)
+		== kSealedPrivateKeySize) ? std::move(result) : nullptr;
+}
+
+[[nodiscard]] Secret DiffieHellman(
+		const QByteArray &privateKey,
+		const QByteArray &publicKey) {
+	const auto local = PrivateKey(privateKey);
+	const auto peer = PublicKey(publicKey);
+	if (!local || !peer) {
+		return nullptr;
+	}
+	const auto context = PKeyContext(
+		EVP_PKEY_CTX_new(local.get(), nullptr), EVP_PKEY_CTX_free);
+	auto result = NewSecret(kDhSize);
+	auto length = size_t(kDhSize);
+	if (!context || EVP_PKEY_derive_init(context.get()) != 1
+		|| EVP_PKEY_derive_set_peer(context.get(), peer.get()) != 1
+		|| EVP_PKEY_derive(context.get(),
+			reinterpret_cast<unsigned char*>(result->data()), &length) != 1
+		|| length != kDhSize) {
+		return nullptr;
+	}
+	return result;
+}
+
+[[nodiscard]] Secret Hmac(
+		const QByteArray &key,
+		const QByteArray &data) {
+	auto result = NewSecret(kHashSize);
+	auto length = 0U;
+	if (!HMAC(
+		EVP_sha512(),
+		key.constData(),
+		int(key.size()),
+		reinterpret_cast<const unsigned char*>(data.constData()),
+		size_t(data.size()),
+		reinterpret_cast<unsigned char*>(result->data()),
+		&length) || length != kHashSize) {
+		return nullptr;
+	}
+	return result;
+}
+
+[[nodiscard]] QByteArray KemSuite() {
+	return QByteArray::fromHex("4b454d0012");
+}
+
+[[nodiscard]] QByteArray HpkeSuite() {
+	return QByteArray::fromHex("48504b45001200030002");
+}
+
+[[nodiscard]] Secret LabeledExtract(
+		const QByteArray &suite,
+		const QByteArray &salt,
+		const char *label,
+		const QByteArray &input) {
+	auto labeled = NewSecret();
+	labeled->append("HPKE-v1");
+	labeled->append(suite);
+	labeled->append(label);
+	labeled->append(input);
+	return Hmac(salt, *labeled);
+}
+
+[[nodiscard]] Secret LabeledExpand(
+		const QByteArray &suite,
+		const QByteArray &key,
+		const char *label,
+		const QByteArray &info,
+		int size) {
+	if (size < 1 || size > 255 * kHashSize) {
+		return nullptr;
+	}
+	auto labeled = NewSecret();
+	labeled->append(char((size >> 8) & 0xFF));
+	labeled->append(char(size & 0xFF));
+	labeled->append("HPKE-v1");
+	labeled->append(suite);
+	labeled->append(label);
+	labeled->append(info);
+	auto result = NewSecret();
+	auto previous = NewSecret();
+	for (auto counter = 1; result->size() < size; ++counter) {
+		auto input = NewSecret();
+		input->append(*previous);
+		input->append(*labeled);
+		input->append(char(counter));
+		previous = Hmac(key, *input);
+		if (!previous) {
+			return nullptr;
+		}
+		result->append(previous->constData(), std::min(qsizetype(size) - result->size(), previous->size()));
+	}
+	return result;
+}
+
+[[nodiscard]] Secret KemSecret(
+		const QByteArray &firstDh,
+		const QByteArray &secondDh,
+		const QByteArray &encapsulated,
+		const QByteArray &recipientPublic,
+		const QByteArray &senderPublic) {
+	auto joined = NewSecret();
+	joined->append(firstDh);
+	joined->append(secondDh);
+	const auto suite = KemSuite();
+	const auto extracted = LabeledExtract(suite, {}, "eae_prk", *joined);
+	return extracted
+		? LabeledExpand(
+			suite,
+			*extracted,
+			"shared_secret",
+			encapsulated + recipientPublic + senderPublic,
+			kHashSize)
+		: nullptr;
+}
+
+[[nodiscard]] std::optional<HpkeContext> KeySchedule(
+		const QByteArray &sharedSecret,
+		const QByteArray &info) {
+	const auto suite = HpkeSuite();
+	const auto pskIdHash = LabeledExtract(suite, {}, "psk_id_hash", {});
+	const auto infoHash = LabeledExtract(suite, {}, "info_hash", info);
+	const auto secret = LabeledExtract(suite, sharedSecret, "secret", {});
+	if (!pskIdHash || !infoHash || !secret) {
+		return std::nullopt;
+	}
+	const auto context = QByteArray(1, char(2)) + *pskIdHash + *infoHash;
+	auto key = LabeledExpand(suite, *secret, "key", context, kAeadKeySize);
+	auto nonce = LabeledExpand(suite, *secret, "base_nonce", context, kNonceSize);
+	return (key && nonce)
+		? std::make_optional(HpkeContext{ std::move(key), std::move(nonce) })
+		: std::nullopt;
+}
+
+[[nodiscard]] std::optional<QByteArray> AeadSeal(
+		const HpkeContext &keys,
+		const QByteArray &plaintext,
+		const QByteArray &aad) {
+	if (!keys.key || !keys.nonce
+		|| keys.key->size() != kAeadKeySize
+		|| keys.nonce->size() != kNonceSize) {
+		return std::nullopt;
+	}
+	const auto context = CipherContext(EVP_CIPHER_CTX_new(), EVP_CIPHER_CTX_free);
+	auto ciphertext = QByteArray(plaintext.size() + kTagSize, Qt::Uninitialized);
+	auto length = 0;
+	auto tail = 0;
+	if (!context
+		|| EVP_EncryptInit_ex(context.get(), EVP_aes_256_gcm(), nullptr, nullptr, nullptr) != 1
+		|| EVP_CIPHER_CTX_ctrl(
+			context.get(),
+			EVP_CTRL_GCM_SET_IVLEN,
+			kNonceSize,
+			nullptr) != 1
+		|| EVP_EncryptInit_ex(
+			context.get(),
+			nullptr,
+			nullptr,
+			reinterpret_cast<const unsigned char*>(keys.key->constData()),
+			reinterpret_cast<const unsigned char*>(keys.nonce->constData())) != 1
+		|| EVP_EncryptUpdate(
+			context.get(),
+			nullptr,
+			&length,
+			reinterpret_cast<const unsigned char*>(aad.constData()),
+			int(aad.size())) != 1
+		|| EVP_EncryptUpdate(
+			context.get(),
+			reinterpret_cast<unsigned char*>(ciphertext.data()),
+			&length,
+			reinterpret_cast<const unsigned char*>(plaintext.constData()),
+			int(plaintext.size())) != 1
+		|| length != plaintext.size()
+		|| EVP_EncryptFinal_ex(
+			context.get(),
+			reinterpret_cast<unsigned char*>(ciphertext.data()) + length,
+			&tail) != 1
+		|| tail != 0
+		|| EVP_CIPHER_CTX_ctrl(
+			context.get(),
+			EVP_CTRL_GCM_GET_TAG,
+			kTagSize,
+			ciphertext.data() + length) != 1) {
+		return std::nullopt;
+	}
+	return ciphertext;
+}
+
+[[nodiscard]] std::optional<QByteArray> AeadOpen(
+		const HpkeContext &keys,
+		const QByteArray &ciphertext,
+		const QByteArray &aad) {
+	if (!keys.key || !keys.nonce
+		|| keys.key->size() != kAeadKeySize
+		|| keys.nonce->size() != kNonceSize
+		|| ciphertext.size() < kTagSize) {
+		return std::nullopt;
+	}
+	const auto context = CipherContext(EVP_CIPHER_CTX_new(), EVP_CIPHER_CTX_free);
+	const auto bodySize = ciphertext.size() - kTagSize;
+	auto plaintext = NewSecret(bodySize);
+	auto length = 0;
+	auto tail = 0;
+	if (!context
+		|| EVP_DecryptInit_ex(context.get(), EVP_aes_256_gcm(), nullptr, nullptr, nullptr) != 1
+		|| EVP_CIPHER_CTX_ctrl(
+			context.get(),
+			EVP_CTRL_GCM_SET_IVLEN,
+			kNonceSize,
+			nullptr) != 1
+		|| EVP_DecryptInit_ex(
+			context.get(),
+			nullptr,
+			nullptr,
+			reinterpret_cast<const unsigned char*>(keys.key->constData()),
+			reinterpret_cast<const unsigned char*>(keys.nonce->constData())) != 1
+		|| EVP_DecryptUpdate(
+			context.get(),
+			nullptr,
+			&length,
+			reinterpret_cast<const unsigned char*>(aad.constData()),
+			int(aad.size())) != 1
+		|| EVP_DecryptUpdate(
+			context.get(),
+			reinterpret_cast<unsigned char*>(plaintext->data()),
+			&length,
+			reinterpret_cast<const unsigned char*>(ciphertext.constData()),
+			int(bodySize)) != 1
+		|| length != bodySize
+		|| EVP_CIPHER_CTX_ctrl(
+			context.get(),
+			EVP_CTRL_GCM_SET_TAG,
+			kTagSize,
+			const_cast<char*>(ciphertext.constData() + bodySize)) != 1
+		|| EVP_DecryptFinal_ex(
+			context.get(),
+			reinterpret_cast<unsigned char*>(plaintext->data()) + length,
+			&tail) != 1
+		|| tail != 0) {
+		return std::nullopt;
+	}
+	return std::move(*plaintext);
+}
+
+[[nodiscard]] std::optional<QByteArray> HpkeSeal(
+		const QByteArray &senderPrivate,
+		const QByteArray &recipientPublic,
+		const QByteArray &ephemeralPrivate,
+		const QByteArray &info,
+		const QByteArray &aad,
+		const QByteArray &plaintext) {
+	const auto encapsulated = DeriveSealedPublicKey(ephemeralPrivate);
+	const auto senderPublic = DeriveSealedPublicKey(senderPrivate);
+	const auto first = DiffieHellman(ephemeralPrivate, recipientPublic);
+	const auto second = DiffieHellman(senderPrivate, recipientPublic);
+	if (!encapsulated || !senderPublic || !first || !second) {
+		return std::nullopt;
+	}
+	const auto shared = KemSecret(
+		*first,
+		*second,
+		*encapsulated,
+		recipientPublic,
+		*senderPublic);
+	const auto keys = shared ? KeySchedule(*shared, info) : std::nullopt;
+	return keys ? AeadSeal(*keys, plaintext, aad) : std::nullopt;
+}
+
+[[nodiscard]] std::optional<QByteArray> HpkeOpen(
+		const QByteArray &recipientPrivate,
+		const QByteArray &senderPublic,
+		const QByteArray &encapsulated,
+		const QByteArray &info,
+		const QByteArray &aad,
+		const QByteArray &ciphertext) {
+	const auto recipientPublic = DeriveSealedPublicKey(recipientPrivate);
+	const auto first = DiffieHellman(recipientPrivate, encapsulated);
+	const auto second = DiffieHellman(recipientPrivate, senderPublic);
+	if (!recipientPublic || !first || !second) {
+		return std::nullopt;
+	}
+	const auto shared = KemSecret(
+		*first,
+		*second,
+		encapsulated,
+		*recipientPublic,
+		senderPublic);
+	const auto keys = shared ? KeySchedule(*shared, info) : std::nullopt;
+	return keys ? AeadOpen(*keys, ciphertext, aad) : std::nullopt;
+}
+
+[[nodiscard]] bool EqualKeys(const QByteArray &a, const QByteArray &b) {
+	return a.size() == kSealedPublicKeySize
+		&& b.size() == kSealedPublicKeySize
+		&& CRYPTO_memcmp(a.constData(), b.constData(), kSealedPublicKeySize) == 0;
+}
+
+[[nodiscard]] qsizetype PaddedSize(qsizetype size, char version) {
+	return (version == kEnvelopeVersion)
+		? kLengthSize + kSealedPlaintextLimit
+		: ((size + kLengthSize + kFileBucket - 1) / kFileBucket) * kFileBucket;
+}
+
+[[nodiscard]] Secret Pad(const QByteArray &plaintext, char version) {
+	auto result = NewSecret();
+	result->fill(char(0), PaddedSize(plaintext.size(), version));
+	const auto size = quint32(plaintext.size());
+	for (auto i = 0; i != kLengthSize; ++i) {
+		(*result)[i] = char((size >> (8 * (3 - i))) & 0xFF);
+	}
+	std::copy(plaintext.begin(), plaintext.end(), result->begin() + kLengthSize);
+	return result;
+}
+
+[[nodiscard]] std::optional<QByteArray> Unpad(
+		const QByteArray &padded,
+		char version,
+		qsizetype limit) {
+	if (padded.size() < kLengthSize) {
+		return std::nullopt;
+	}
+	auto length = quint32(0);
+	for (auto i = 0; i != kLengthSize; ++i) {
+		length = (length << 8) | static_cast<unsigned char>(padded[i]);
+	}
+	if (!length
+		|| length > limit
+		|| qsizetype(length) + kLengthSize > padded.size()
+		|| padded.size() != PaddedSize(length, version)) {
+		return std::nullopt;
+	}
+	for (auto i = qsizetype(length) + kLengthSize; i < padded.size(); ++i) {
+		if (padded[i] != char(0)) {
+			return std::nullopt;
+		}
+	}
+	return QByteArray(padded.constData() + kLengthSize, length);
+}
+
+[[nodiscard]] bool ValidEnvelope(
+		const QByteArray &envelope,
+		char version = kEnvelopeVersion,
+		qsizetype limit = kSealedPlaintextLimit) {
+	if (envelope.size() < kHeaderSize + 2 * (PaddedSize(1, version) + kTagSize)
+		|| envelope.size() > kHeaderSize + 2 * (PaddedSize(limit, version) + kTagSize)
+		|| envelope.front() != version
+		|| (envelope.size() - kHeaderSize) % 2 != 0) {
+		return false;
+	}
+	const auto padded = (envelope.size() - kHeaderSize) / 2 - kTagSize;
+	return (version == kEnvelopeVersion)
+		? padded == PaddedSize(1, version)
+		: padded % kFileBucket == 0;
+}
+
+[[nodiscard]] QByteArray Binding(
+		const char *label,
+		char role,
+		const QByteArray &context,
+		const QByteArray &header) {
+	auto result = QByteArray(label);
+	result.append(role);
+	result.append(char((context.size() >> 8) & 0xFF));
+	result.append(char(context.size() & 0xFF));
+	result.append(context);
+	result.append(header);
+	return result;
+}
+
+[[nodiscard]] QString FormatToken(
+		const char *prefix,
+		const QByteArray &bytes) {
+	return QString::fromLatin1(prefix) + QString::fromLatin1(bytes.toBase64(
+		QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals));
+}
+
+[[nodiscard]] std::optional<QByteArray> ParseToken(
+		const char *prefix,
+		const QString &text) {
+	if (text.size() > kWireLimit || !text.startsWith(QLatin1String(prefix))) {
+		return std::nullopt;
+	}
+	const auto encoded = text.mid(qstrlen(prefix));
+	if (encoded.isEmpty() || QString::fromLatin1(encoded.toLatin1()) != encoded) {
+		return std::nullopt;
+	}
+	const auto decoded = QByteArray::fromBase64Encoding(
+		encoded.toLatin1(),
+		QByteArray::Base64UrlEncoding | QByteArray::AbortOnBase64DecodingErrors);
+	if (!decoded
+		|| QString::fromLatin1(decoded.decoded.toBase64(
+			QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals)) != encoded) {
+		return std::nullopt;
+	}
+	return decoded.decoded;
+}
+
+}
+
+SealedIdentity::SealedIdentity(QByteArray privateKey, QByteArray publicKey)
+: privateKey(CopyBytes(privateKey))
+, publicKey(std::move(publicKey)) {
+}
+
+SealedIdentity::SealedIdentity(const SealedIdentity &other)
+: privateKey(CopyBytes(other.privateKey))
+, publicKey(other.publicKey) {
+}
+
+SealedIdentity::SealedIdentity(SealedIdentity &&other) noexcept
+: privateKey(std::move(other.privateKey))
+, publicKey(std::move(other.publicKey)) {
+}
+
+SealedIdentity &SealedIdentity::operator=(const SealedIdentity &other) {
+	if (this != &other) {
+		Clean(privateKey);
+		privateKey = CopyBytes(other.privateKey);
+		publicKey = other.publicKey;
+	}
+	return *this;
+}
+
+SealedIdentity &SealedIdentity::operator=(SealedIdentity &&other) noexcept {
+	if (this != &other) {
+		Clean(privateKey);
+		privateKey = std::move(other.privateKey);
+		publicKey = std::move(other.publicKey);
+	}
+	return *this;
+}
+
+SealedIdentity::~SealedIdentity() {
+	Clean(privateKey);
+}
+
+std::optional<SealedIdentity> GenerateSealedIdentity() {
+	const auto privateKey = RandomPrivateKey();
+	const auto publicKey = privateKey
+		? DeriveSealedPublicKey(*privateKey)
+		: std::nullopt;
+	return publicKey
+		? std::make_optional(SealedIdentity(*privateKey, *publicKey))
+		: std::nullopt;
+}
+
+std::optional<QByteArray> DeriveSealedPublicKey(const QByteArray &privateKey) {
+	const auto key = PrivateKey(privateKey);
+	if (!key) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(kSealedPublicKeySize, Qt::Uninitialized);
+	auto length = size_t(kSealedPublicKeySize);
+	if (EVP_PKEY_get_octet_string_param(
+		key.get(), OSSL_PKEY_PARAM_PUB_KEY,
+		reinterpret_cast<unsigned char*>(result.data()),
+		size_t(result.size()), &length) != 1 || length != kSealedPublicKeySize) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+bool IsSealedPublicKey(const QByteArray &publicKey) {
+	return bool(PublicKey(publicKey));
+}
+
+QString FormatSealedPublicKey(const QByteArray &publicKey) {
+	return IsSealedPublicKey(publicKey)
+		? FormatToken(kPublicPrefix, publicKey)
+		: QString();
+}
+
+std::optional<QByteArray> ParseSealedPublicKey(const QString &text) {
+	const auto decoded = ParseToken(kPublicPrefix, text);
+	return (decoded && IsSealedPublicKey(*decoded)) ? decoded : std::nullopt;
+}
+
+QString SealedFingerprint(const QByteArray &publicKey) {
+	if (!IsSealedPublicKey(publicKey)) {
+		return QString();
+	}
+	const auto digest = QCryptographicHash::hash(
+		QByteArray("tele sealed fingerprint v1") + publicKey,
+		QCryptographicHash::Sha512).toHex().toUpper();
+	auto result = QString();
+	for (auto i = 0; i != digest.size(); i += 4) {
+		if (i) {
+			result += QChar(' ');
+		}
+		result += QString::fromLatin1(digest.mid(i, 4));
+	}
+	return result;
+}
+
+namespace {
+
+[[nodiscard]] std::optional<QByteArray> EncryptPayload(
+		const QByteArray &senderPrivateKey,
+		const QByteArray &recipientPublicKey,
+		const QByteArray &plaintext,
+		const QByteArray &context,
+		char version,
+		qsizetype limit) {
+	if (plaintext.isEmpty()
+		|| plaintext.size() > limit
+		|| context.isEmpty()
+		|| context.size() > kContextLimit
+		|| !IsSealedPublicKey(recipientPublicKey)) {
+		return std::nullopt;
+	}
+	const auto senderPublic = DeriveSealedPublicKey(senderPrivateKey);
+	if (!senderPublic) {
+		return std::nullopt;
+	}
+	const auto peerPrivate = RandomPrivateKey();
+	const auto selfPrivate = RandomPrivateKey();
+	const auto peerEnc = peerPrivate ? DeriveSealedPublicKey(*peerPrivate) : std::nullopt;
+	const auto selfEnc = selfPrivate ? DeriveSealedPublicKey(*selfPrivate) : std::nullopt;
+	if (!peerEnc || !selfEnc) {
+		return std::nullopt;
+	}
+	const auto header = QByteArray(1, version) + *peerEnc + *selfEnc;
+	const auto padded = Pad(plaintext, version);
+	const auto peer = HpkeSeal(
+		senderPrivateKey,
+		recipientPublicKey,
+		*peerPrivate,
+		Binding("tele sealed hpke v1", kRecipientRole, context, header),
+		Binding("tele sealed aad v1", kRecipientRole, context, header),
+		*padded);
+	const auto self = HpkeSeal(
+		senderPrivateKey,
+		*senderPublic,
+		*selfPrivate,
+		Binding("tele sealed hpke v1", kSenderRole, context, header),
+		Binding("tele sealed aad v1", kSenderRole, context, header),
+		*padded);
+	return (peer && self)
+		? std::make_optional(header + *peer + *self)
+		: std::nullopt;
+}
+
+[[nodiscard]] std::optional<QByteArray> DecryptPayload(
+		const QByteArray &recipientPrivateKey,
+		const QByteArray &expectedSenderPublicKey,
+		const QByteArray &envelope,
+		const QByteArray &context,
+		char version,
+		qsizetype limit) {
+	if (!ValidEnvelope(envelope, version, limit)
+		|| context.isEmpty()
+		|| context.size() > kContextLimit
+		|| !IsSealedPublicKey(expectedSenderPublicKey)) {
+		return std::nullopt;
+	}
+	const auto ownPublic = DeriveSealedPublicKey(recipientPrivateKey);
+	if (!ownPublic) {
+		return std::nullopt;
+	}
+	const auto self = EqualKeys(*ownPublic, expectedSenderPublicKey);
+	const auto role = self ? kSenderRole : kRecipientRole;
+	const auto header = envelope.left(kHeaderSize);
+	const auto recordSize = (envelope.size() - kHeaderSize) / 2;
+	const auto encapsulated = envelope.mid(
+		1 + (self ? 1 : 0) * kSealedPublicKeySize,
+		kSealedPublicKeySize);
+	if (!IsSealedPublicKey(encapsulated)) {
+		return std::nullopt;
+	}
+	auto plain = HpkeOpen(
+		recipientPrivateKey,
+		expectedSenderPublicKey,
+		encapsulated,
+		Binding("tele sealed hpke v1", role, context, header),
+		Binding("tele sealed aad v1", role, context, header),
+		envelope.mid(kHeaderSize + (self ? recordSize : 0), recordSize));
+	if (!plain) {
+		return std::nullopt;
+	}
+	auto padded = NewSecret();
+	*padded = std::move(*plain);
+	return Unpad(*padded, version, limit);
+}
+
+[[nodiscard]] bool ValidPassphrase(const QString &passphrase) {
+	if (passphrase.size() > kPassphraseLimit) {
+		return false;
+	}
+	auto count = 0;
+	for (auto i = 0; i != passphrase.size(); ++i, ++count) {
+		if (passphrase[i].isHighSurrogate()) {
+			if (i + 1 == passphrase.size() || !passphrase[++i].isLowSurrogate()) {
+				return false;
+			}
+		} else if (passphrase[i].isLowSurrogate()) {
+			return false;
+		}
+	}
+	return count >= 16;
+}
+
+[[nodiscard]] Secret PassphraseKey(
+		const QString &passphrase,
+		const QByteArray &salt) {
+	if (!ValidPassphrase(passphrase) || salt.size() != kBackupSaltSize) {
+		return nullptr;
+	}
+	auto password = NewSecret();
+	*password = passphrase.toUtf8();
+	if (password->size() > kPassphraseLimit) {
+		return nullptr;
+	}
+	auto result = NewSecret(kAeadKeySize);
+	return (PKCS5_PBKDF2_HMAC(
+		password->constData(),
+		int(password->size()),
+		reinterpret_cast<const unsigned char*>(salt.constData()),
+		int(salt.size()),
+		kBackupIterations,
+		EVP_sha256(),
+		kAeadKeySize,
+		reinterpret_cast<unsigned char*>(result->data())) == 1)
+		? std::move(result)
+		: nullptr;
+}
+
+}
+
+std::optional<QByteArray> SealedEncrypt(
+		const QByteArray &senderPrivateKey,
+		const QByteArray &recipientPublicKey,
+		const QByteArray &plaintext,
+		const QByteArray &context) {
+	return EncryptPayload(
+		senderPrivateKey,
+		recipientPublicKey,
+		plaintext,
+		context,
+		kEnvelopeVersion,
+		kSealedPlaintextLimit);
+}
+
+std::optional<QByteArray> SealedDecrypt(
+		const QByteArray &recipientPrivateKey,
+		const QByteArray &expectedSenderPublicKey,
+		const QByteArray &envelope,
+		const QByteArray &context) {
+	return DecryptPayload(
+		recipientPrivateKey,
+		expectedSenderPublicKey,
+		envelope,
+		context,
+		kEnvelopeVersion,
+		kSealedPlaintextLimit);
+}
+
+std::optional<QByteArray> SealedEncryptFile(
+		const QByteArray &senderPrivateKey,
+		const QByteArray &recipientPublicKey,
+		const QByteArray &plaintext,
+		const QByteArray &context) {
+	return EncryptPayload(
+		senderPrivateKey,
+		recipientPublicKey,
+		plaintext,
+		context,
+		kFileVersion,
+		kSealedFileLimit);
+}
+
+std::optional<QByteArray> SealedDecryptFile(
+		const QByteArray &recipientPrivateKey,
+		const QByteArray &expectedSenderPublicKey,
+		const QByteArray &envelope,
+		const QByteArray &context) {
+	return DecryptPayload(
+		recipientPrivateKey,
+		expectedSenderPublicKey,
+		envelope,
+		context,
+		kFileVersion,
+		kSealedFileLimit);
+}
+
+std::optional<QByteArray> ExportSealedIdentity(
+		const QByteArray &privateKey,
+		const QString &passphrase,
+		const QByteArray &context) {
+	if (context.isEmpty()
+		|| context.size() > kContextLimit
+		|| !DeriveSealedPublicKey(privateKey)) {
+		return std::nullopt;
+	}
+	auto salt = QByteArray(kBackupSaltSize, Qt::Uninitialized);
+	auto nonce = NewSecret(kNonceSize);
+	if (RAND_bytes(
+		reinterpret_cast<unsigned char*>(salt.data()),
+		kBackupSaltSize) != 1
+		|| RAND_bytes(
+			reinterpret_cast<unsigned char*>(nonce->data()),
+			kNonceSize) != 1) {
+		return std::nullopt;
+	}
+	auto key = PassphraseKey(passphrase, salt);
+	if (!key) {
+		return std::nullopt;
+	}
+	const auto header = QByteArray(kBackupMagic) + salt + *nonce;
+	const auto keys = HpkeContext{ std::move(key), std::move(nonce) };
+	const auto encrypted = AeadSeal(
+		keys,
+		privateKey,
+		Binding("tele sealed backup aad v1", char(0), context, header));
+	return encrypted ? std::make_optional(header + *encrypted) : std::nullopt;
+}
+
+std::optional<SealedIdentity> ImportSealedIdentity(
+		const QByteArray &backup,
+		const QString &passphrase,
+		const QByteArray &context) {
+	const auto prefixSize = qsizetype(qstrlen(kBackupMagic));
+	const auto headerSize = prefixSize + kBackupSaltSize + kNonceSize;
+	if (context.isEmpty()
+		|| context.size() > kContextLimit
+		|| backup.size() != headerSize + kSealedPrivateKeySize + kTagSize
+		|| !backup.startsWith(kBackupMagic)) {
+		return std::nullopt;
+	}
+	const auto salt = backup.mid(prefixSize, kBackupSaltSize);
+	auto key = PassphraseKey(passphrase, salt);
+	if (!key) {
+		return std::nullopt;
+	}
+	auto nonce = NewSecret();
+	*nonce = backup.mid(prefixSize + kBackupSaltSize, kNonceSize);
+	const auto keys = HpkeContext{ std::move(key), std::move(nonce) };
+	auto plain = AeadOpen(
+		keys,
+		backup.mid(headerSize),
+		Binding(
+			"tele sealed backup aad v1",
+			char(0),
+			context,
+			backup.left(headerSize)));
+	if (!plain || plain->size() != kSealedPrivateKeySize) {
+		return std::nullopt;
+	}
+	auto secret = NewSecret();
+	*secret = std::move(*plain);
+	const auto publicKey = DeriveSealedPublicKey(*secret);
+	return publicKey
+		? std::make_optional(SealedIdentity(*secret, *publicKey))
+		: std::nullopt;
+}
+
+QString FormatSealedEnvelope(const QByteArray &envelope) {
+	return ValidEnvelope(envelope)
+		? FormatToken(kEnvelopePrefix, envelope)
+		: QString();
+}
+
+std::optional<QByteArray> ParseSealedEnvelope(const QString &text) {
+	const auto decoded = ParseToken(kEnvelopePrefix, text);
+	return (decoded && ValidEnvelope(*decoded)) ? decoded : std::nullopt;
+}
+
+}
