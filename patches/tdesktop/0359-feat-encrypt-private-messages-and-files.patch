@@ -0,0 +1,740 @@
+#include "tele/tele_sealed_duress_store.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDateTime>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QLockFile>
+#include <QtCore/QSaveFile>
+
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/rand.h>
+
+#include <algorithm>
+#include <filesystem>
+#include <system_error>
+
+namespace Tele {
+namespace {
+
+constexpr auto kSaltSize = 32;
+constexpr auto kDigestSize = 32;
+constexpr auto kGenerationSize = 16;
+constexpr auto kPassphraseLimit = 1024;
+constexpr auto kContextLimit = 256;
+constexpr auto kDirectoryLimit = 255;
+constexpr auto kFileLimit = 1024 * 1024;
+constexpr auto kIterations = 600000;
+constexpr auto kMagic = "TSEALDRS";
+constexpr auto kVersion = char(2);
+
+[[nodiscard]] bool ValidContext(const QByteArray &context) {
+	return !context.isEmpty() && context.size() <= kContextLimit;
+}
+
+[[nodiscard]] bool ValidPassphrase(const QByteArray &passphrase) {
+	return !passphrase.isEmpty()
+		&& passphrase.size() <= kPassphraseLimit
+		&& QString::fromUtf8(passphrase).toUtf8() == passphrase;
+}
+
+[[nodiscard]] bool ValidDirectory(const QString &directory) {
+	if (!directory.startsWith(QStringLiteral("user_"))
+		|| directory.size() <= 5
+		|| directory.toUtf8().size() > kDirectoryLimit
+		|| directory.endsWith(QChar('.'))
+		|| directory.endsWith(QChar(' '))) {
+		return false;
+	}
+	for (const auto ch : directory) {
+		const auto c = ch.unicode();
+		if (c < 32 || c == 127 || ch.category() == QChar::Other_Format
+			|| QStringLiteral("\\/:*?\"<>|").contains(ch)) {
+			return false;
+		}
+	}
+	return QString::fromUtf8(directory.toUtf8()) == directory;
+}
+
+[[nodiscard]] bool SamePath(const QString &a, const QString &b) {
+#ifdef Q_OS_WIN
+	return a.compare(b, Qt::CaseInsensitive) == 0;
+#else
+	return a == b;
+#endif
+}
+
+[[nodiscard]] std::optional<QString> RootPath(const QString &root) {
+	const auto info = QFileInfo(root);
+	if (!info.isAbsolute() || !info.isDir() || info.isSymLink() || info.isJunction()) {
+		return std::nullopt;
+	}
+	const auto absolute = QDir::cleanPath(info.absoluteFilePath());
+	const auto canonical = QDir::cleanPath(info.canonicalFilePath());
+	if (canonical.isEmpty() || !SamePath(absolute, canonical)) {
+		return std::nullopt;
+	}
+	return canonical;
+}
+
+[[nodiscard]] QString StatePath(const QString &root, const QByteArray &context) {
+	return QDir(root).filePath(QStringLiteral("tele_sealed_duress_")
+		+ QString::fromLatin1(QCryptographicHash::hash(
+			context, QCryptographicHash::Sha256).toHex())
+		+ QStringLiteral(".bin"));
+}
+
+[[nodiscard]] bool Equal(const QByteArray &a, const QByteArray &b) {
+	return a.size() == b.size()
+		&& CRYPTO_memcmp(a.constData(), b.constData(), size_t(a.size())) == 0;
+}
+
+[[nodiscard]] bool Random(QByteArray &bytes, int size) {
+	bytes.resize(size);
+	return RAND_bytes(reinterpret_cast<unsigned char*>(bytes.data()), size) == 1;
+}
+
+[[nodiscard]] std::optional<QByteArray> PassphraseDigest(
+		const QByteArray &passphrase,
+		const QByteArray &context,
+		const QByteArray &salt) {
+	if (!ValidPassphrase(passphrase) || !ValidContext(context)
+		|| salt.size() != kSaltSize) {
+		return std::nullopt;
+	}
+	auto binding = QByteArray("tele sealed duress verifier v1");
+	binding.append(char((context.size() >> 8) & 0xFF));
+	binding.append(char(context.size() & 0xFF));
+	binding.append(context);
+	binding.append(salt);
+	auto result = QByteArray(kDigestSize, Qt::Uninitialized);
+	return PKCS5_PBKDF2_HMAC(
+		passphrase.constData(),
+		int(passphrase.size()),
+		reinterpret_cast<const unsigned char*>(binding.constData()),
+		int(binding.size()),
+		kIterations,
+		EVP_sha256(),
+		kDigestSize,
+		reinterpret_cast<unsigned char*>(result.data())) == 1
+		? std::make_optional(std::move(result))
+		: std::nullopt;
+}
+
+void Append16(QByteArray &bytes, quint16 value) {
+	bytes.append(char(value >> 8));
+	bytes.append(char(value & 0xFF));
+}
+
+void Append64(QByteArray &bytes, quint64 value) {
+	for (auto i = 7; i >= 0; --i) {
+		bytes.append(char((value >> (8 * i)) & 0xFF));
+	}
+}
+
+struct Reader {
+	const QByteArray &bytes;
+	qsizetype position = 0;
+	bool valid = true;
+
+	QByteArray take(qsizetype size) {
+		if (size < 0 || size > bytes.size() - position) {
+			valid = false;
+			return {};
+		}
+		const auto result = bytes.mid(position, size);
+		position += size;
+		return result;
+	}
+
+	quint8 byte() {
+		const auto result = take(1);
+		return result.isEmpty() ? 0 : quint8(result.front());
+	}
+
+	quint16 word() {
+		const auto high = byte();
+		return quint16((quint16(high) << 8) | byte());
+	}
+
+	quint64 wide() {
+		auto result = quint64(0);
+		for (auto i = 0; i != 8; ++i) {
+			result = (result << 8) | byte();
+		}
+		return result;
+	}
+};
+
+[[nodiscard]] QByteArray Serialize(
+		const SealedDuressState &state,
+		const QByteArray &context) {
+	auto bytes = QByteArray(kMagic) + kVersion;
+	bytes.append(QCryptographicHash::hash(context, QCryptographicHash::Sha256));
+	bytes.append(char(state.armed));
+	bytes.append(char(state.quarantined));
+	bytes.append(state.generation);
+	bytes.append(state.activationId.isEmpty()
+		? QByteArray(kGenerationSize, char(0))
+		: state.activationId);
+	Append64(bytes, quint64(state.activatedAtUTC));
+	bytes.append(state.verifier.salt);
+	bytes.append(state.verifier.digest);
+	Append16(bytes, quint16(state.accounts.size()));
+	for (const auto &account : state.accounts) {
+		const auto name = account.relativeDirectory.toUtf8();
+		Append16(bytes, quint16(name.size()));
+		bytes.append(name);
+		bytes.append(char(account.blocked));
+		bytes.append(char(account.cleanupPending));
+	}
+	bytes.append(QCryptographicHash::hash(bytes, QCryptographicHash::Sha256));
+	return bytes;
+}
+
+[[nodiscard]] std::optional<SealedDuressState> Parse(
+		const QByteArray &bytes,
+		const QByteArray &context) {
+	if (bytes.size() < 191 || bytes.size() > kFileLimit) {
+		return std::nullopt;
+	}
+	const auto body = bytes.left(bytes.size() - kDigestSize);
+	if (!Equal(bytes.right(kDigestSize), QCryptographicHash::hash(
+			body, QCryptographicHash::Sha256))) {
+		return std::nullopt;
+	}
+	auto reader = Reader{ body };
+	if (reader.take(8) != kMagic || reader.byte() != quint8(kVersion)
+		|| reader.take(kDigestSize) != QCryptographicHash::hash(
+			context, QCryptographicHash::Sha256)) {
+		return std::nullopt;
+	}
+	auto result = SealedDuressState();
+	const auto armed = reader.byte();
+	const auto quarantined = reader.byte();
+	if (armed > 1 || quarantined > 1) {
+		return std::nullopt;
+	}
+	result.armed = armed;
+	result.quarantined = quarantined;
+	result.generation = reader.take(kGenerationSize);
+	result.activationId = reader.take(kGenerationSize);
+	if (result.activationId == QByteArray(kGenerationSize, char(0))) {
+		result.activationId.clear();
+	}
+	const auto activatedAt = reader.wide();
+	if (activatedAt > quint64(253402300799LL)
+		|| result.activationId.isEmpty() != (activatedAt == 0)
+		|| (result.quarantined && result.activationId.isEmpty())) {
+		return std::nullopt;
+	}
+	result.activatedAtUTC = qint64(activatedAt);
+	result.verifier.salt = reader.take(kSaltSize);
+	result.verifier.digest = reader.take(kDigestSize);
+	const auto count = reader.word();
+	if (!count || count > kSealedDuressAccountLimit) {
+		return std::nullopt;
+	}
+	auto previous = QString();
+	for (auto i = 0; i != count; ++i) {
+		const auto length = reader.word();
+		if (!length || length > kDirectoryLimit) {
+			return std::nullopt;
+		}
+		const auto encoded = reader.take(length);
+		const auto name = QString::fromUtf8(encoded);
+		const auto blocked = reader.byte();
+		const auto pending = reader.byte();
+		if (!ValidDirectory(name) || name.toUtf8() != encoded
+			|| (!previous.isEmpty() && previous >= name)
+			|| std::any_of(result.accounts.begin(), result.accounts.end(), [&](const auto &account) {
+				return account.relativeDirectory.compare(name, Qt::CaseInsensitive) == 0;
+			})
+			|| blocked > 1 || pending > 1 || (pending && !blocked)
+			|| (blocked && !quarantined)) {
+			return std::nullopt;
+		}
+		previous = name;
+		result.accounts.push_back({ name, bool(blocked), bool(pending) });
+	}
+	const auto anyBlocked = std::any_of(
+		result.accounts.begin(), result.accounts.end(), [](const auto &account) {
+			return account.blocked;
+		});
+	return reader.valid && reader.position == body.size()
+		&& result.quarantined == anyBlocked
+		? std::make_optional(std::move(result))
+		: std::nullopt;
+}
+
+[[nodiscard]] SealedDuressResult Failed(SealedDuressError error) {
+	return { error, std::nullopt };
+}
+
+[[nodiscard]] SealedDuressResult Loaded(
+		SealedDuressState state,
+		SealedDuressError error = SealedDuressError::None) {
+	return { error, std::move(state) };
+}
+
+[[nodiscard]] bool Write(
+		const QString &root,
+		const QByteArray &context,
+		const SealedDuressState &state) {
+	const auto path = StatePath(root, context);
+	if (QFileInfo(path).isSymLink()) {
+		return false;
+	}
+	auto file = QSaveFile(path);
+	file.setDirectWriteFallback(false);
+	const auto bytes = Serialize(state, context);
+	return file.open(QIODevice::WriteOnly)
+		&& file.setPermissions(QFile::ReadOwner | QFile::WriteOwner)
+		&& file.write(bytes) == bytes.size()
+		&& file.commit();
+}
+
+[[nodiscard]] SealedDuressResult Persist(
+		const QString &root,
+		const QByteArray &context,
+		SealedDuressState state) {
+	if (!Random(state.generation, kGenerationSize)
+		|| !Write(root, context, state)) {
+		auto current = LoadSealedDuress(root, context);
+		current.error = SealedDuressError::WriteFailed;
+		return current;
+	}
+	return Loaded(std::move(state));
+}
+
+[[nodiscard]] std::filesystem::path NativePath(const QString &path) {
+#ifdef Q_OS_WIN
+	return std::filesystem::path(path.toStdWString());
+#else
+	return std::filesystem::path(path.toStdString());
+#endif
+}
+
+[[nodiscard]] bool NeedsQuarantine(const QString &root, const QString &directory) {
+	if (!ValidDirectory(directory)) {
+		return true;
+	}
+	const auto path = QDir(root).filePath(directory);
+	auto error = std::error_code();
+	const auto status = std::filesystem::symlink_status(NativePath(path), error);
+	if (error) {
+		return error != std::errc::no_such_file_or_directory;
+	} else if (status.type() == std::filesystem::file_type::not_found) {
+		return false;
+	}
+	const auto info = QFileInfo(path);
+	if (status.type() != std::filesystem::file_type::directory
+		|| info.isSymLink() || info.isJunction() || !info.isReadable()
+		|| !SamePath(QDir::cleanPath(info.canonicalFilePath()), path)) {
+		return true;
+	}
+#ifdef Q_OS_UNIX
+	if (!info.isExecutable()) {
+		return true;
+	}
+#endif
+	return SealedKeyFilesPresentAt(path);
+}
+
+[[nodiscard]] bool RemoveKeys(const QString &root, const QString &directory) {
+	if (!ValidDirectory(directory)) {
+		return false;
+	}
+	const auto path = QDir(root).filePath(directory);
+	auto error = std::error_code();
+	const auto status = std::filesystem::symlink_status(NativePath(path), error);
+	if (error) {
+		return error == std::errc::no_such_file_or_directory;
+	} else if (status.type() == std::filesystem::file_type::not_found) {
+		return true;
+	}
+	const auto info = QFileInfo(path);
+	if (status.type() != std::filesystem::file_type::directory || info.isSymLink() || info.isJunction()
+		|| !SamePath(QDir::cleanPath(info.canonicalFilePath()), path)) {
+		return false;
+	}
+	auto success = true;
+	for (const auto suffix : { 's', '0', '1' }) {
+		const auto file = QDir(path).filePath(
+			QStringLiteral("tele_sealed_keys") + QChar(suffix));
+		error.clear();
+		const auto leaf = std::filesystem::symlink_status(NativePath(file), error);
+		if (error) {
+			if (error != std::errc::no_such_file_or_directory) {
+				success = false;
+			}
+		} else if (leaf.type() != std::filesystem::file_type::not_found) {
+			if (leaf.type() != std::filesystem::file_type::regular
+				|| QFileInfo(file).isSymLink() || !QFile::remove(file)) {
+				success = false;
+			}
+		}
+	}
+	return success;
+}
+
+[[nodiscard]] SealedDuressResult Cleanup(
+		const QString &root,
+		const QByteArray &context,
+		SealedDuressState state) {
+	auto changed = false;
+	auto success = true;
+	for (auto &account : state.accounts) {
+		if (account.blocked && account.cleanupPending) {
+			if (RemoveKeys(root, account.relativeDirectory)) {
+				account.cleanupPending = false;
+				changed = true;
+			} else {
+				success = false;
+			}
+		}
+	}
+	auto result = changed
+		? Persist(root, context, std::move(state))
+		: Loaded(std::move(state));
+	if (result.error == SealedDuressError::None && !success) {
+		result.error = SealedDuressError::CleanupFailed;
+	}
+	return result;
+}
+
+template <typename Method>
+[[nodiscard]] SealedDuressResult Mutate(
+		const QString &root,
+		const QByteArray &context,
+		const QByteArray &expected,
+		Method method) {
+	const auto canonical = RootPath(root);
+	if (!ValidContext(context) || !canonical || expected.size() != kGenerationSize) {
+		return Failed(SealedDuressError::InvalidInput);
+	}
+	auto lock = QLockFile(StatePath(*canonical, context) + QStringLiteral(".lock"));
+	lock.setStaleLockTime(0);
+	if (!lock.tryLock(0)) {
+		return Failed(SealedDuressError::Busy);
+	}
+	auto current = LoadSealedDuress(*canonical, context);
+	if (current.error != SealedDuressError::None) {
+		return current;
+	} else if (!Equal(current.state->generation, expected)) {
+		current.error = SealedDuressError::Changed;
+		return current;
+	}
+	return method(*canonical, std::move(*current.state));
+}
+
+}
+
+bool IsSealedKeyDirectoryName(const QString &directory) {
+	return ValidDirectory(directory);
+}
+
+std::optional<QString> ResolveSealedStorageRoot(const QString &root) {
+	return RootPath(root);
+}
+
+bool SealedKeyFilesPresentAt(const QString &directory) {
+	if (!QFileInfo(directory).isAbsolute()) {
+		return true;
+	}
+	for (const auto suffix : { 's', '0', '1' }) {
+		const auto file = QDir(directory).filePath(QStringLiteral("tele_sealed_keys") + QChar(suffix));
+		auto error = std::error_code();
+		const auto leaf = std::filesystem::symlink_status(NativePath(file), error);
+		if (error && error != std::errc::no_such_file_or_directory && error != std::errc::not_a_directory) {
+			return true;
+		} else if (!error && leaf.type() != std::filesystem::file_type::not_found) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool SealedKeyFilesPresentOrUnsafe(const QString &root, const QString &directory) {
+	const auto canonical = RootPath(root);
+	return !canonical || NeedsQuarantine(*canonical, directory);
+}
+
+bool EraseSealedKeyFiles(const QString &root, const QString &directory) {
+	const auto canonical = RootPath(root);
+	return canonical && RemoveKeys(*canonical, directory);
+}
+
+std::optional<SealedDuressVerifier> MakeSealedDuressVerifier(
+		const QByteArray &passphrase,
+		const QByteArray &context) {
+	auto result = SealedDuressVerifier();
+	if (!Random(result.salt, kSaltSize)) {
+		return std::nullopt;
+	}
+	const auto digest = PassphraseDigest(passphrase, context, result.salt);
+	if (!digest) {
+		return std::nullopt;
+	}
+	result.digest = *digest;
+	return result;
+}
+
+bool CheckSealedDuressVerifier(
+		const QByteArray &passphrase,
+		const QByteArray &context,
+		const SealedDuressVerifier &verifier) {
+	if (verifier.digest.size() != kDigestSize) {
+		return false;
+	}
+	auto digest = PassphraseDigest(passphrase, context, verifier.salt);
+	if (!digest) {
+		return false;
+	}
+	const auto result = Equal(*digest, verifier.digest);
+	OPENSSL_cleanse(digest->data(), size_t(digest->size()));
+	return result;
+}
+
+SealedDuressResult LoadSealedDuress(
+		const QString &root,
+		const QByteArray &context) {
+	if (!ValidContext(context)) {
+		return Failed(SealedDuressError::InvalidInput);
+	}
+	const auto canonical = RootPath(root);
+	if (!canonical) {
+		return Failed(SealedDuressError::Unavailable);
+	}
+	const auto path = StatePath(*canonical, context);
+	const auto info = QFileInfo(path);
+	if (info.isSymLink()) {
+		return Failed(SealedDuressError::Corrupt);
+	} else if (!info.exists()) {
+		return Failed(SealedDuressError::Missing);
+	} else if (!info.isFile() || info.size() <= 0 || info.size() > kFileLimit) {
+		return Failed(SealedDuressError::Corrupt);
+	}
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return Failed(SealedDuressError::Unavailable);
+	}
+	const auto bytes = file.read(kFileLimit + 1);
+	if (file.error() != QFileDevice::NoError || !file.atEnd()) {
+		return Failed(SealedDuressError::Unavailable);
+	}
+	auto state = Parse(bytes, context);
+	return state ? Loaded(std::move(*state)) : Failed(SealedDuressError::Corrupt);
+}
+
+SealedDuressResult EnrollSealedDuress(
+		const QString &root,
+		const QByteArray &context,
+		const QByteArray &passphrase,
+		const QStringList &directories,
+		const QByteArray &expectedGeneration) {
+	if (!ValidPassphrase(passphrase) || !ValidContext(context)) {
+		return Failed(SealedDuressError::InvalidInput);
+	}
+	const auto verifier = MakeSealedDuressVerifier(passphrase, context);
+	return verifier
+		? EnrollSealedDuressWithVerifier(
+			root, context, *verifier, directories, expectedGeneration)
+		: Failed(SealedDuressError::WriteFailed);
+}
+
+SealedDuressResult EnrollSealedDuressWithVerifier(
+		const QString &root,
+		const QByteArray &context,
+		const SealedDuressVerifier &verifier,
+		const QStringList &directories,
+		const QByteArray &expectedGeneration) {
+	const auto canonical = RootPath(root);
+	if (!canonical || !ValidContext(context)
+		|| verifier.salt.size() != kSaltSize || verifier.digest.size() != kDigestSize
+		|| directories.isEmpty() || directories.size() > kSealedDuressAccountLimit
+		|| (!expectedGeneration.isEmpty() && expectedGeneration.size() != kGenerationSize)
+		|| !std::all_of(directories.begin(), directories.end(), ValidDirectory)) {
+		return Failed(SealedDuressError::InvalidInput);
+	}
+	auto lock = QLockFile(StatePath(*canonical, context) + QStringLiteral(".lock"));
+	lock.setStaleLockTime(0);
+	if (!lock.tryLock(0)) {
+		return Failed(SealedDuressError::Busy);
+	}
+	auto current = LoadSealedDuress(*canonical, context);
+	if (current.error != SealedDuressError::None
+		&& current.error != SealedDuressError::Missing) {
+		return current;
+	} else if ((current.state && !Equal(current.state->generation, expectedGeneration))
+		|| (!current.state && !expectedGeneration.isEmpty())) {
+		current.error = SealedDuressError::Changed;
+		return current;
+	}
+	auto state = current.state.value_or(SealedDuressState());
+	state.armed = true;
+	state.verifier = verifier;
+	for (const auto &directory : directories) {
+		const auto found = std::find_if(state.accounts.begin(), state.accounts.end(), [&](const auto &account) {
+			return account.relativeDirectory.compare(directory, Qt::CaseInsensitive) == 0;
+		});
+		if (found == state.accounts.end()) {
+			const auto blocked = state.quarantined && NeedsQuarantine(*canonical, directory);
+			state.accounts.push_back({ directory, blocked, blocked });
+		} else if (found->relativeDirectory != directory) {
+			return Failed(SealedDuressError::InvalidInput);
+		}
+	}
+	if (state.accounts.size() > kSealedDuressAccountLimit) {
+		return Failed(SealedDuressError::InvalidInput);
+	}
+	std::sort(state.accounts.begin(), state.accounts.end(), [](const auto &a, const auto &b) {
+		return a.relativeDirectory < b.relativeDirectory;
+	});
+	return Persist(*canonical, context, std::move(state));
+}
+
+SealedDuressResult SetSealedDuressArmed(
+		const QString &root,
+		const QByteArray &context,
+		bool armed,
+		const QByteArray &expectedGeneration) {
+	return Mutate(root, context, expectedGeneration, [&](const auto &path, auto state) {
+		if (state.armed == armed) {
+			return Loaded(std::move(state));
+		}
+		state.armed = armed;
+		return Persist(path, context, std::move(state));
+	});
+}
+
+SealedDuressResult RegisterSealedDuressAccount(
+		const QString &root,
+		const QByteArray &context,
+		const QString &directory,
+		const QByteArray &expectedGeneration) {
+	if (!ValidDirectory(directory)) {
+		return Failed(SealedDuressError::InvalidInput);
+	}
+	return Mutate(root, context, expectedGeneration, [&](const auto &path, auto state) {
+		const auto found = std::find_if(state.accounts.begin(), state.accounts.end(), [&](const auto &account) {
+			return account.relativeDirectory.compare(directory, Qt::CaseInsensitive) == 0;
+		});
+		if (found != state.accounts.end()) {
+			return found->relativeDirectory == directory
+				? Loaded(std::move(state))
+				: Failed(SealedDuressError::InvalidInput);
+		} else if (state.accounts.size() >= kSealedDuressAccountLimit) {
+			return Failed(SealedDuressError::InvalidInput);
+		}
+		const auto blocked = state.quarantined && NeedsQuarantine(path, directory);
+		state.accounts.push_back({ directory, blocked, blocked });
+		std::sort(state.accounts.begin(), state.accounts.end(), [](const auto &a, const auto &b) {
+			return a.relativeDirectory < b.relativeDirectory;
+		});
+		return Persist(path, context, std::move(state));
+	});
+}
+
+SealedDuressResult TriggerSealedDuress(
+		const QString &root,
+		const QByteArray &context,
+		const QByteArray &expectedGeneration) {
+	return Mutate(root, context, expectedGeneration, [&](const auto &path, auto state) {
+		if (!state.armed) {
+			return Loaded(std::move(state), SealedDuressError::InvalidInput);
+		}
+		if (!Random(state.activationId, kGenerationSize)
+			|| state.activationId == QByteArray(kGenerationSize, char(0))) {
+			return Failed(SealedDuressError::WriteFailed);
+		}
+		state.activatedAtUTC = QDateTime::currentSecsSinceEpoch();
+		if (state.activatedAtUTC <= 0 || state.activatedAtUTC > 253402300799LL) {
+			return Failed(SealedDuressError::InvalidInput);
+		}
+		for (auto &account : state.accounts) {
+			account.blocked = account.blocked || NeedsQuarantine(path, account.relativeDirectory);
+			account.cleanupPending = account.blocked;
+		}
+		state.quarantined = std::any_of(
+			state.accounts.begin(), state.accounts.end(), [](const auto &account) {
+				return account.blocked;
+			});
+		auto persisted = Persist(path, context, std::move(state));
+		return persisted.error == SealedDuressError::None
+			? Cleanup(path, context, std::move(*persisted.state))
+			: persisted;
+	});
+}
+
+SealedDuressResult RetrySealedDuressCleanup(
+		const QString &root,
+		const QByteArray &context,
+		const QByteArray &expectedGeneration) {
+	return Mutate(root, context, expectedGeneration, [&](const auto &path, auto state) {
+		return Cleanup(path, context, std::move(state));
+	});
+}
+
+SealedDuressResult RecoverSealedDuressAccount(
+		const QString &root,
+		const QByteArray &context,
+		const QString &directory,
+		const QByteArray &expectedGeneration,
+		const std::function<bool()> &authenticatedWriter) {
+	if (!ValidDirectory(directory) || !authenticatedWriter) {
+		return Failed(SealedDuressError::InvalidInput);
+	}
+	return Mutate(root, context, expectedGeneration, [&](const auto &path, auto state) {
+		const auto find = [&](auto &value) {
+			return std::find_if(value.accounts.begin(), value.accounts.end(), [&](const auto &account) {
+				return account.relativeDirectory.compare(directory, Qt::CaseInsensitive) == 0;
+			});
+		};
+		auto account = find(state);
+		if (account == state.accounts.end() || account->relativeDirectory != directory
+			|| !account->blocked) {
+			return Loaded(std::move(state), SealedDuressError::NotBlocked);
+		} else if (account->cleanupPending) {
+			if (!RemoveKeys(path, directory)) {
+				return Loaded(std::move(state), SealedDuressError::CleanupFailed);
+			}
+			account->cleanupPending = false;
+			auto persisted = Persist(path, context, std::move(state));
+			if (persisted.error != SealedDuressError::None) {
+				return persisted;
+			}
+			state = std::move(*persisted.state);
+		}
+		auto written = false;
+		try {
+			written = authenticatedWriter();
+		} catch (...) {
+		}
+		auto current = LoadSealedDuress(path, context);
+		if (current.error != SealedDuressError::None) {
+			return current;
+		} else if (!Equal(current.state->generation, state.generation)) {
+			current.error = SealedDuressError::Changed;
+			return current;
+		} else if (!written) {
+			current.error = SealedDuressError::WriterFailed;
+			return current;
+		}
+		auto restored = find(*current.state);
+		if (restored == current.state->accounts.end() || !restored->blocked) {
+			current.error = SealedDuressError::Changed;
+			return current;
+		}
+		restored->blocked = false;
+		current.state->quarantined = std::any_of(
+			current.state->accounts.begin(), current.state->accounts.end(), [](const auto &value) {
+				return value.blocked;
+			});
+		return Persist(path, context, std::move(*current.state));
+	});
+}
+
+}
