diff --git a/Telegram/SourceFiles/tele/tele_sealed_codes_filter.cpp b/Telegram/SourceFiles/tele/tele_sealed_codes_filter.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..34d8242a6fa147d8c20b5d1994169a216e8715f0
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_codes_filter.cpp
@@ -0,0 +1,97 @@
+#include "tele/tele_sealed_codes_filter.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QMessageAuthenticationCode>
+#include <QtCore/QRegularExpression>
+
+#include <algorithm>
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] const QRegularExpression &CodePattern() {
+	static const auto result = QRegularExpression(QStringLiteral(
+		"(?<![\\p{L}\\p{N}_#-])([0-9][0-9-]{3,6}[0-9])(?![\\p{L}\\p{N}_-])"));
+	return result;
+}
+
+[[nodiscard]] bool HasEnoughDigits(const QString &text) {
+	return std::ranges::count_if(text, [](QChar ch) {
+		return ch >= '0' && ch <= '9';
+	}) >= 5;
+}
+
+[[nodiscard]] QString Decoy(
+		const QString &original,
+		const QByteArray &seed,
+		const QByteArray &context) {
+	const auto digest = QMessageAuthenticationCode::hash(
+		QByteArray("tele code display v1") + char(context.size())
+			+ context + original.toLatin1(),
+		seed,
+		QCryptographicHash::Sha512);
+	auto result = original;
+	auto index = 0;
+	for (auto &ch : result) {
+		if (ch >= '0' && ch <= '9') {
+			ch = QChar('0' + (uchar(digest[index++]) % 10));
+		}
+	}
+	if (result == original) {
+		for (auto &ch : result) {
+			if (ch >= '0' && ch <= '9') {
+				ch = QChar('0' + ((ch.unicode() - '0' + 1) % 10));
+				break;
+			}
+		}
+	}
+	return result;
+}
+
+}
+
+SealedCodeText MakeSealedCodeText(
+		const QString &text,
+		const QByteArray &seed,
+		const QByteArray &context) {
+	auto result = SealedCodeText{ .text = text };
+	if (seed.size() != 32 || context.isEmpty() || context.size() > 128) {
+		return {};
+	}
+	auto matches = CodePattern().globalMatch(text);
+	while (matches.hasNext()) {
+		const auto match = matches.next();
+		const auto original = match.captured(1);
+		if (!HasEnoughDigits(original)) {
+			continue;
+		}
+		const auto replacement = Decoy(original, seed, context);
+		result.text.replace(match.capturedStart(1), original.size(), replacement);
+		if (!std::ranges::any_of(result.mappings, [&](const auto &mapping) {
+				return mapping.original == original;
+			})) {
+			result.mappings.push_back({ original, replacement });
+		}
+	}
+	return result;
+}
+
+QString ApplySealedCodeMappings(
+		const QString &text,
+		const QVector<SealedCodeMapping> &mappings) {
+	auto result = text;
+	auto matches = CodePattern().globalMatch(text);
+	while (matches.hasNext()) {
+		const auto match = matches.next();
+		const auto value = match.captured(1);
+		const auto found = std::ranges::find_if(mappings, [&](const auto &mapping) {
+			return mapping.original == value;
+		});
+		if (found != mappings.end() && found->replacement.size() == value.size()) {
+			result.replace(match.capturedStart(1), value.size(), found->replacement);
+		}
+	}
+	return result;
+}
+
+}
