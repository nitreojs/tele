diff --git a/Telegram/SourceFiles/tele/tele_sealed_passcode_gate.h b/Telegram/SourceFiles/tele/tele_sealed_passcode_gate.h
new file mode 100644
index 0000000000000000000000000000000000000000..a87f962c1fa69f74e88ac899940cb50d18252a33
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_passcode_gate.h
@@ -0,0 +1,57 @@
+#pragma once
+
+namespace Tele {
+
+class SealedPasscodeGate final {
+public:
+
+	bool observe(bool available) {
+		_observed = true;
+		_available = _available && available;
+		return available;
+	}
+
+	[[nodiscard]] bool mayTrigger(bool correct, bool matched) const {
+		return !correct && matched && _observed && _available;
+	}
+
+private:
+
+	bool _observed = false;
+	bool _available = true;
+
+};
+
+namespace details {
+
+inline thread_local SealedPasscodeGate *CurrentSealedPasscodeGate = nullptr;
+
+}
+
+class SealedPasscodeGateScope final {
+public:
+
+	explicit SealedPasscodeGateScope(SealedPasscodeGate &gate)
+	: _previous(details::CurrentSealedPasscodeGate) {
+		details::CurrentSealedPasscodeGate = &gate;
+	}
+
+	SealedPasscodeGateScope(const SealedPasscodeGateScope &) = delete;
+	SealedPasscodeGateScope &operator=(const SealedPasscodeGateScope &) = delete;
+
+	~SealedPasscodeGateScope() {
+		details::CurrentSealedPasscodeGate = _previous;
+	}
+
+private:
+
+	SealedPasscodeGate *_previous;
+
+};
+
+[[nodiscard]] inline bool SealedNativePasscodeAvailable(bool available) {
+	const auto gate = details::CurrentSealedPasscodeGate;
+	return gate ? gate->observe(available) : available;
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_registry.cpp b/Telegram/SourceFiles/tele/tele_sealed_registry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..031b1a86eea45739a12ea50f0fa9b40d14267f11
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_registry.cpp
@@ -0,0 +1,335 @@
+#include "tele/tele_sealed_registry.h"
+
+#include "tele/tele_sealed_duress_store.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QLockFile>
+#include <QtCore/QSaveFile>
+
+#include <algorithm>
+#include <filesystem>
+#include <mutex>
+#include <system_error>
+
+namespace Tele {
+namespace {
+
+constexpr auto kContextLimit = 256;
+constexpr auto kFileLimit = 1024 * 1024;
+constexpr auto kDirectoryLimit = 255;
+constexpr auto kDigestSize = 32;
+constexpr auto kMagic = "TSEALKRG";
+constexpr auto kVersion = char(1);
+
+[[nodiscard]] std::mutex &ProcessMutex() {
+	static auto result = std::mutex();
+	return result;
+}
+
+[[nodiscard]] bool ValidContext(const QByteArray &context) {
+	return !context.isEmpty() && context.size() <= kContextLimit;
+}
+
+[[nodiscard]] QString StatePath(const QString &root, const QByteArray &context) {
+	return QDir(root).filePath(QStringLiteral("tele_sealed_registry_")
+		+ QString::fromLatin1(QCryptographicHash::hash(context, QCryptographicHash::Sha256).toHex())
+		+ QStringLiteral(".bin"));
+}
+
+[[nodiscard]] std::filesystem::path NativePath(const QString &path) {
+#ifdef Q_OS_WIN
+	return std::filesystem::path(path.toStdWString());
+#else
+	return std::filesystem::path(path.toStdString());
+#endif
+}
+
+void Append16(QByteArray &bytes, quint16 value) {
+	bytes.append(char(value >> 8));
+	bytes.append(char(value & 0xFF));
+}
+
+[[nodiscard]] QByteArray Serialize(const QStringList &directories, const QByteArray &context) {
+	auto bytes = QByteArray(kMagic) + kVersion;
+	bytes.append(QCryptographicHash::hash(context, QCryptographicHash::Sha256));
+	Append16(bytes, quint16(directories.size()));
+	for (const auto &directory : directories) {
+		const auto name = directory.toUtf8();
+		Append16(bytes, quint16(name.size()));
+		bytes.append(name);
+	}
+	bytes.append(QCryptographicHash::hash(bytes, QCryptographicHash::Sha256));
+	return bytes;
+}
+
+[[nodiscard]] SealedRegistryState Failed(SealedRegistryError error) {
+	return { error, true, {} };
+}
+
+[[nodiscard]] bool Write(const QString &root, const QByteArray &context, const QStringList &directories) {
+	const auto path = StatePath(root, context);
+	if (QFileInfo(path).isSymLink()) {
+		return false;
+	}
+	const auto bytes = Serialize(directories, context);
+	auto file = QSaveFile(path);
+	file.setDirectWriteFallback(false);
+	return bytes.size() <= kFileLimit && file.open(QIODevice::WriteOnly)
+		&& file.setPermissions(QFile::ReadOwner | QFile::WriteOwner)
+		&& file.write(bytes) == bytes.size() && file.commit();
+}
+
+[[nodiscard]] SealedRegistryError AddDirectory(
+		const QString &root,
+		const QByteArray &context,
+		const QString &directory,
+		SealedRegistryState &state) {
+	const auto found = std::find_if(state.directories.begin(), state.directories.end(), [&](const auto &value) {
+		return value.compare(directory, Qt::CaseInsensitive) == 0;
+	});
+	if (found != state.directories.end()) {
+		return *found == directory ? SealedRegistryError::None : SealedRegistryError::InvalidInput;
+	} else if (state.directories.size() >= kSealedDuressAccountLimit) {
+		return SealedRegistryError::InvalidInput;
+	}
+	state.directories.push_back(directory);
+	std::sort(state.directories.begin(), state.directories.end());
+	if (!Write(root, context, state.directories)) {
+		return SealedRegistryError::WriteFailed;
+	}
+	state.exists = true;
+	return SealedRegistryError::None;
+}
+
+}
+
+struct SealedRegistryCleanup::Lease {
+	Lease() : process(ProcessMutex(), std::try_to_lock) {
+	}
+
+	[[nodiscard]] bool lockFile(const QString &path) {
+		file = std::make_unique<QLockFile>(path + QStringLiteral(".lock"));
+		file->setStaleLockTime(0);
+		return file->tryLock(0);
+	}
+
+	std::unique_lock<std::mutex> process;
+	std::unique_ptr<QLockFile> file;
+};
+
+SealedRegistryCleanup::SealedRegistryCleanup(SealedRegistryError error)
+: _error(error) {
+}
+
+SealedRegistryCleanup::SealedRegistryCleanup(SealedRegistryError error, std::unique_ptr<Lease> lease)
+: _error(error)
+, _lease(std::move(lease)) {
+}
+
+SealedRegistryCleanup::SealedRegistryCleanup(SealedRegistryCleanup &&other) noexcept = default;
+SealedRegistryCleanup &SealedRegistryCleanup::operator=(SealedRegistryCleanup &&other) noexcept = default;
+SealedRegistryCleanup::~SealedRegistryCleanup() = default;
+
+SealedRegistryCleanup::operator bool() const {
+	return _error == SealedRegistryError::None;
+}
+
+SealedRegistryError SealedRegistryCleanup::error() const {
+	return _error;
+}
+
+QByteArray SealedRegistryProfileContext(const QString &dataName) {
+	return QByteArray("tele sealed registry profile v1")
+		+ QCryptographicHash::hash(dataName.toUtf8(), QCryptographicHash::Sha512);
+}
+
+SealedRegistryState LoadSealedRegistry(const QString &root, const QByteArray &context) {
+	if (!ValidContext(context) || !QFileInfo(root).isAbsolute()) {
+		return Failed(SealedRegistryError::InvalidInput);
+	}
+	const auto path = StatePath(root, context);
+	auto error = std::error_code();
+	const auto status = std::filesystem::symlink_status(NativePath(path), error);
+	if (error == std::errc::no_such_file_or_directory
+		|| error == std::errc::not_a_directory
+		|| (!error && status.type() == std::filesystem::file_type::not_found)) {
+		return {};
+	} else if (error) {
+		return Failed(SealedRegistryError::Unavailable);
+	} else if (status.type() != std::filesystem::file_type::regular || QFileInfo(path).isSymLink()) {
+		return Failed(SealedRegistryError::Corrupt);
+	}
+	if (!ResolveSealedStorageRoot(root)) {
+		return Failed(SealedRegistryError::Unavailable);
+	}
+	const auto info = QFileInfo(path);
+	if (info.size() < 75 || info.size() > kFileLimit) {
+		return Failed(SealedRegistryError::Corrupt);
+	}
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return Failed(SealedRegistryError::Unavailable);
+	}
+	const auto bytes = file.read(kFileLimit + 1);
+	if (file.error() != QFileDevice::NoError || !file.atEnd()) {
+		return Failed(SealedRegistryError::Unavailable);
+	} else if (bytes.size() < 75 || bytes.size() > kFileLimit) {
+		return Failed(SealedRegistryError::Corrupt);
+	}
+	const auto body = bytes.left(bytes.size() - kDigestSize);
+	if (bytes.right(kDigestSize) != QCryptographicHash::hash(body, QCryptographicHash::Sha256)
+		|| body.left(8) != kMagic || body[8] != kVersion
+		|| body.mid(9, kDigestSize) != QCryptographicHash::hash(context, QCryptographicHash::Sha256)) {
+		return Failed(SealedRegistryError::Corrupt);
+	}
+	auto position = qsizetype(41);
+	const auto word = [&]() -> std::optional<quint16> {
+		if (position + 2 > body.size()) {
+			return std::nullopt;
+		}
+		const auto high = quint8(body[position++]);
+		const auto low = quint8(body[position++]);
+		return quint16((quint16(high) << 8) | low);
+	};
+	const auto count = word();
+	if (!count || *count > kSealedDuressAccountLimit) {
+		return Failed(SealedRegistryError::Corrupt);
+	}
+	auto result = SealedRegistryState{ SealedRegistryError::None, true, {} };
+	for (auto i = 0; i != *count; ++i) {
+		const auto length = word();
+		if (!length || !*length || *length > kDirectoryLimit || position + *length > body.size()) {
+			return Failed(SealedRegistryError::Corrupt);
+		}
+		const auto encoded = body.mid(position, *length);
+		position += *length;
+		const auto name = QString::fromUtf8(encoded);
+		if (!IsSealedKeyDirectoryName(name) || name.toUtf8() != encoded
+			|| (!result.directories.isEmpty() && result.directories.back() >= name)
+			|| std::any_of(result.directories.begin(), result.directories.end(), [&](const auto &value) {
+				return value.compare(name, Qt::CaseInsensitive) == 0;
+			})) {
+			return Failed(SealedRegistryError::Corrupt);
+		}
+		result.directories.push_back(name);
+	}
+	return position == body.size() ? result : Failed(SealedRegistryError::Corrupt);
+}
+
+SealedRegistryError RegistryWrite(
+		const QString &root,
+		const QByteArray &context,
+		const QString &directory,
+		const std::function<bool()> &writer) {
+	const auto canonical = ResolveSealedStorageRoot(root);
+	if (!canonical || !ValidContext(context) || !IsSealedKeyDirectoryName(directory) || !writer) {
+		return SealedRegistryError::InvalidInput;
+	}
+	auto lease = SealedRegistryCleanup::Lease();
+	if (!lease.process.owns_lock() || !lease.lockFile(StatePath(*canonical, context))) {
+		return SealedRegistryError::Busy;
+	}
+	auto state = LoadSealedRegistry(*canonical, context);
+	if (state.error != SealedRegistryError::None) {
+		return state.error;
+	}
+	const auto registered = AddDirectory(*canonical, context, directory, state);
+	if (registered != SealedRegistryError::None) {
+		return registered;
+	}
+	const auto directoryPath = QDir(*canonical).filePath(directory);
+	const auto info = QFileInfo(directoryPath);
+	if ((info.exists() || info.isSymLink()) && !ResolveSealedStorageRoot(directoryPath)) {
+		return SealedRegistryError::Unavailable;
+	}
+	try {
+		return writer() ? SealedRegistryError::None : SealedRegistryError::WriterFailed;
+	} catch (...) {
+		return SealedRegistryError::WriterFailed;
+	}
+}
+
+SealedRegistryError RegistryRegister(const QString &root, const QByteArray &context, const QString &directory) {
+	return RegistryWrite(root, context, directory, [] { return true; });
+}
+
+SealedRegistryError EraseAccount(const QString &root, const QByteArray &context, const QString &directory) {
+	const auto canonical = ResolveSealedStorageRoot(root);
+	if (!canonical || !ValidContext(context) || !IsSealedKeyDirectoryName(directory)) {
+		return SealedRegistryError::InvalidInput;
+	}
+	auto lease = SealedRegistryCleanup::Lease();
+	if (!lease.process.owns_lock()) {
+		return SealedRegistryError::Busy;
+	}
+	auto state = LoadSealedRegistry(*canonical, context);
+	if (state.error != SealedRegistryError::None) {
+		return state.error;
+	} else if (!state.exists && !SealedKeyFilesPresentOrUnsafe(*canonical, directory)) {
+		return SealedRegistryError::None;
+	} else if (!lease.lockFile(StatePath(*canonical, context))) {
+		return SealedRegistryError::Busy;
+	}
+	state = LoadSealedRegistry(*canonical, context);
+	if (state.error != SealedRegistryError::None) {
+		return state.error;
+	}
+	const auto registered = AddDirectory(*canonical, context, directory, state);
+	if (registered != SealedRegistryError::None) {
+		return registered;
+	}
+	return EraseSealedKeyFiles(*canonical, directory)
+		? SealedRegistryError::None
+		: SealedRegistryError::EraseFailed;
+}
+
+SealedRegistryCleanup PrepareSealedRegistryCleanup(const QString &root, const QByteArray &context) {
+	if (!ValidContext(context) || !QFileInfo(root).isAbsolute()) {
+		return SealedRegistryCleanup(SealedRegistryError::InvalidInput);
+	}
+	auto lease = std::make_unique<SealedRegistryCleanup::Lease>();
+	if (!lease->process.owns_lock()) {
+		return SealedRegistryCleanup(SealedRegistryError::Busy);
+	}
+	auto state = LoadSealedRegistry(root, context);
+	if (state.error != SealedRegistryError::None) {
+		return SealedRegistryCleanup(state.error, std::move(lease));
+	} else if (!state.exists) {
+		return SealedRegistryCleanup(SealedRegistryError::None, std::move(lease));
+	}
+	const auto canonical = ResolveSealedStorageRoot(root);
+	if (!canonical) {
+		return SealedRegistryCleanup(SealedRegistryError::Unavailable, std::move(lease));
+	} else if (!lease->lockFile(StatePath(*canonical, context))) {
+		return SealedRegistryCleanup(SealedRegistryError::Busy, std::move(lease));
+	}
+	state = LoadSealedRegistry(*canonical, context);
+	if (state.error != SealedRegistryError::None) {
+		return SealedRegistryCleanup(state.error, std::move(lease));
+	}
+	auto success = true;
+	for (const auto &directory : state.directories) {
+		if (!EraseSealedKeyFiles(*canonical, directory)) {
+			success = false;
+		}
+	}
+	return SealedRegistryCleanup(success ? SealedRegistryError::None : SealedRegistryError::EraseFailed,
+		std::move(lease));
+}
+
+SealedRegistryError EraseAllRegistered(const QString &root, const QByteArray &context) {
+	return PrepareSealedRegistryCleanup(root, context).error();
+}
+
+bool RegistryHasKeys(const QString &root, const QByteArray &context) {
+	const auto state = LoadSealedRegistry(root, context);
+	return state.error != SealedRegistryError::None
+		|| std::any_of(state.directories.begin(), state.directories.end(), [&](const auto &directory) {
+			return SealedKeyFilesPresentOrUnsafe(root, directory);
+		});
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_registry.h b/Telegram/SourceFiles/tele/tele_sealed_registry.h
new file mode 100644
index 0000000000000000000000000000000000000000..6fb09cfcb9f66eae8712faa2e62455781f773995
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_registry.h
@@ -0,0 +1,78 @@
+#pragma once
+
+#include <QtCore/QByteArray>
+#include <QtCore/QString>
+#include <QtCore/QStringList>
+
+#include <functional>
+#include <memory>
+
+namespace Tele {
+
+enum class SealedRegistryError {
+	None,
+	InvalidInput,
+	Corrupt,
+	Unavailable,
+	Busy,
+	WriteFailed,
+	EraseFailed,
+	WriterFailed,
+};
+
+struct SealedRegistryState {
+	SealedRegistryError error = SealedRegistryError::None;
+	bool exists = false;
+	QStringList directories;
+};
+
+class SealedRegistryCleanup final {
+public:
+	struct Lease;
+
+	explicit SealedRegistryCleanup(SealedRegistryError error);
+	SealedRegistryCleanup(SealedRegistryCleanup &&other) noexcept;
+	SealedRegistryCleanup &operator=(SealedRegistryCleanup &&other) noexcept;
+	~SealedRegistryCleanup();
+
+	[[nodiscard]] explicit operator bool() const;
+	[[nodiscard]] SealedRegistryError error() const;
+
+private:
+	friend SealedRegistryCleanup PrepareSealedRegistryCleanup(
+		const QString &root,
+		const QByteArray &context);
+	SealedRegistryCleanup(SealedRegistryError error, std::unique_ptr<Lease> lease);
+
+	SealedRegistryError _error;
+	std::unique_ptr<Lease> _lease;
+};
+
+[[nodiscard]] QByteArray SealedRegistryProfileContext(const QString &dataName);
+[[nodiscard]] SealedRegistryState LoadSealedRegistry(
+	const QString &root,
+	const QByteArray &context);
+[[nodiscard]] SealedRegistryError RegistryRegister(
+	const QString &root,
+	const QByteArray &context,
+	const QString &directory);
+[[nodiscard]] SealedRegistryError RegistryWrite(
+	const QString &root,
+	const QByteArray &context,
+	const QString &directory,
+	const std::function<bool()> &writer);
+[[nodiscard]] SealedRegistryError EraseAccount(
+	const QString &root,
+	const QByteArray &context,
+	const QString &directory);
+[[nodiscard]] SealedRegistryError EraseAllRegistered(
+	const QString &root,
+	const QByteArray &context);
+[[nodiscard]] bool RegistryHasKeys(
+	const QString &root,
+	const QByteArray &context);
+[[nodiscard]] SealedRegistryCleanup PrepareSealedRegistryCleanup(
+	const QString &root,
+	const QByteArray &context);
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_registry_native.cpp b/Telegram/SourceFiles/tele/tele_sealed_registry_native.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..857fa4ec8407b20a52d1f39d930977b2afee767f
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_registry_native.cpp
@@ -0,0 +1,108 @@
+#include "tele/tele_sealed_registry_native.h"
+
+#include "main/main_session.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_sealed_duress_store.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFileInfo>
+
+#include <map>
+#include <set>
+
+namespace Tele {
+namespace {
+
+std::map<QByteArray, std::set<QString>> PendingDirectories;
+
+[[nodiscard]] QString Warning(bool logout) {
+	return Lower(logout
+		? u"Signing out removes this device’s encryption keys; keep an off-device encrypted key backup and its password."_q
+		: u"This action removes local encryption keys even if the passcode change fails; keep an off-device encrypted key backup and its password."_q);
+}
+
+}
+
+QString SealedRegistryRoot() {
+	return QDir::cleanPath(cWorkingDir() + u"tdata"_q);
+}
+
+QByteArray CurrentSealedRegistryContext() {
+	return SealedRegistryProfileContext(cDataFile());
+}
+
+QString SealedRegistryDirectory(not_null<Main::Session*> session) {
+	return QDir(SealedRegistryRoot()).relativeFilePath(
+		QFileInfo(session->local().supportModePath()).absolutePath());
+}
+
+SealedRegistryError RegisterSealedKeyStore(not_null<Main::Session*> session) {
+	return RegistryRegister(SealedRegistryRoot(), CurrentSealedRegistryContext(), SealedRegistryDirectory(session));
+}
+
+SealedRegistryError RegisteredSealedKeyWrite(
+		not_null<Main::Session*> session,
+		const std::function<bool()> &writer) {
+	return RegistryWrite(SealedRegistryRoot(), CurrentSealedRegistryContext(),
+		SealedRegistryDirectory(session), writer);
+}
+
+void SealedKeysLoggedOut(not_null<Main::Session*> session) {
+	const auto root = SealedRegistryRoot();
+	const auto context = CurrentSealedRegistryContext();
+	const auto directory = SealedRegistryDirectory(session);
+	const auto loaded = LoadSealedRegistry(root, context);
+	if (loaded.error == SealedRegistryError::None && !loaded.exists
+		&& !SealedKeyFilesPresentAt(QFileInfo(session->local().supportModePath()).absolutePath())) {
+		return;
+	}
+	const auto result = EraseAccount(root, context, directory);
+	if (result == SealedRegistryError::None) {
+		PendingDirectories[context].erase(directory);
+	} else {
+		PendingDirectories[context].insert(directory);
+	}
+}
+
+SealedRegistryCleanup PrepareSealedKeyUnprotect(const QString &dataName, bool unprotect) {
+	if (!unprotect) {
+		return SealedRegistryCleanup(SealedRegistryError::None);
+	}
+	const auto root = SealedRegistryRoot();
+	const auto context = SealedRegistryProfileContext(dataName);
+	for (const auto &directory : PendingDirectories[context]) {
+		const auto registered = RegistryRegister(root, context, directory);
+		if (registered != SealedRegistryError::None) {
+			return SealedRegistryCleanup(registered);
+		}
+	}
+	auto result = PrepareSealedRegistryCleanup(root, context);
+	if (result) {
+		PendingDirectories.erase(context);
+	}
+	return result;
+}
+
+QString WrapLogoutConfirmation(Main::Session *session, QString text) {
+	const auto root = SealedRegistryRoot();
+	const auto context = CurrentSealedRegistryContext();
+	const auto hasKeys = session
+		? SealedKeyFilesPresentAt(QFileInfo(session->local().supportModePath()).absolutePath())
+		: RegistryHasKeys(root, context);
+	return hasKeys ? text + u"\n\n"_q + Warning(true) : text;
+}
+
+QString WrapSealedPasscodeRemoval(QString text, bool removing) {
+	return removing && RegistryHasKeys(SealedRegistryRoot(), CurrentSealedRegistryContext())
+		? text + u"\n\n"_q + Warning(false)
+		: text;
+}
+
+rpl::producer<QString> WrapSealedPasscodeRemoval(rpl::producer<QString> text) {
+	return std::move(text) | rpl::map([](QString value) {
+		return WrapSealedPasscodeRemoval(std::move(value));
+	});
+}
+
+}
