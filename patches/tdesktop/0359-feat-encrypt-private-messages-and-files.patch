+#pragma once
+
+#include <QtCore/QByteArray>
+#include <QtCore/QString>
+
+#include <optional>
+
+namespace Tele {
+
+inline constexpr auto kSealedPlaintextLimit = 1024;
+inline constexpr auto kSealedFileLimit = 16 * 1024 * 1024;
+inline constexpr auto kSealedPrivateKeySize = 66;
+inline constexpr auto kSealedPublicKeySize = 133;
+
+struct SealedIdentity {
+	SealedIdentity() = default;
+	SealedIdentity(QByteArray privateKey, QByteArray publicKey);
+	SealedIdentity(const SealedIdentity &other);
+	SealedIdentity(SealedIdentity &&other) noexcept;
+	SealedIdentity &operator=(const SealedIdentity &other);
+	SealedIdentity &operator=(SealedIdentity &&other) noexcept;
+	~SealedIdentity();
+
+	QByteArray privateKey;
+	QByteArray publicKey;
+};
+
