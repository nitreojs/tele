+struct Candidate {
+	FullMsgId id;
+	PeerId sender;
+	QString text;
+};
+
+struct Packet {
+	std::vector<Candidate> items;
+	QByteArray ownPublic;
+	QByteArray peerPublic;
+	QByteArray ownContext;
+	QByteArray incomingContext;
+	PeerId self;
+	quint64 epoch = 0;
+	bool more = true;
+};
+
+struct WorkerKeys {
+	SealedContactKeys own;
+	std::optional<SealedContactKeys> incoming;
+};
+
+struct ScanResult {
+	MessageIdsList ids;
+};
+
+bool Matches(const QString &text, const QString &query) {
+	return SealedSearchTextMatches(text, query);
+}
+
+ScanResult Scan(const Packet &packet, const WorkerKeys &workerKeys, const QString &sourceQuery, const std::atomic_bool &canceled) {
+	const auto query = NormalizeSealedSearchText(sourceQuery);
+	auto result = ScanResult();
+	auto groups = std::map<QByteArray, std::vector<const Candidate*>>();
+	for (const auto &item : packet.items) {
+		if (canceled.load()) return {};
+		if (const auto header = ParseSealedRichPartHeader(item.text)) {
+			groups[header->group].push_back(&item);
+			continue;
+		}
+		if (item.text.startsWith(u"tele-sealed:"_q)) {
+			const auto envelope = ParseSealedEnvelope(item.text);
+			if (!envelope) continue;
+			const auto own = item.sender == packet.self;
+			const auto keys = own ? &workerKeys.own : workerKeys.incoming ? &*workerKeys.incoming : nullptr;
+			if (!keys) continue;
+			auto plain = SealedDecrypt(keys->identity.privateKey,
+				own ? keys->identity.publicKey : keys->peerKey, *envelope,
+				own ? packet.ownContext : packet.incomingContext);
+			if (!plain) continue;
+			const auto text = QString::fromUtf8(*plain);
+			const auto match = text.toUtf8() == *plain && Matches(text, query);
+			OPENSSL_cleanse(plain->data(), size_t(plain->size()));
+			if (match) result.ids.push_back(item.id);
+		} else if (Matches(item.text, query)) {
+			result.ids.push_back(item.id);
+		}
+	}
+	for (const auto &[group, candidates] : groups) {
+		if (canceled.load()) return {};
+		const auto header = ParseSealedRichPartHeader(candidates.front()->text);
+		if (!header || candidates.size() != size_t(header->count)) continue;
+		auto ordered = std::vector<const Candidate*>(header->count);
+		auto valid = true;
+		for (const auto candidate : candidates) {
+			const auto part = ParseSealedRichPartHeader(candidate->text);
+			if (!part || part->count != header->count || ordered[part->index]
+				|| candidate->sender != candidates.front()->sender) { valid = false; break; }
+			ordered[part->index] = candidate;
+		}
+		if (!valid) continue;
+		auto parts = std::vector<SealedRichPart>();
+		for (const auto candidate : ordered) {
+			if (canceled.load()) return {};
+			const auto own = candidate->sender == packet.self;
+			const auto keys = own ? &workerKeys.own : workerKeys.incoming ? &*workerKeys.incoming : nullptr;
+			if (!keys) { valid = false; break; }
+			auto part = DecryptSealedRichPart(keys->identity.privateKey,
+				own ? keys->identity.publicKey : keys->peerKey, candidate->text,
+				own ? packet.ownContext : packet.incomingContext);
+			if (!part) { valid = false; break; }
+			parts.push_back(std::move(*part));
+		}
+		if (valid) {
+			const auto rich = MergeSealedRichParts(parts);
+			auto native = TextWithEntities();
+			if (rich && SealedRichToNative(*rich, native) && Matches(native.text, query)) {
+				result.ids.push_back(ordered.front()->id);
+			}
+		}
+		for (auto &part : parts) OPENSSL_cleanse(part.bytes.data(), size_t(part.bytes.size()));
+	}
+	ranges::sort(result.ids, [](const FullMsgId &a, const FullMsgId &b) { return a.msg > b.msg; });
+	if (result.ids.size() > kHits) result.ids.resize(kHits);
+	return result;
+}
+
+class Engine final : public base::has_weak_ptr {
+public:
+	Engine(const void *key, not_null<History*> history, Fn<void(Api::FoundMessages)> value)
+	: owner(key), weakHistory(base::make_weak(history)), apply(std::move(value)), timeout([=] { finishLoading(); }) {
+		const auto weak = base::make_weak(this);
+		history->session().lifetime().add([=] {
+			if (!weak) return;
+			weak->cancel(); weak->sender.reset(); weak->weakHistory = {}; weak->clear();
+		});
+		SealedDecryptJobsChanges() | rpl::on_next([=] { if (waiting) schedule(); }, lifetime);
+		history->messages().sliceUpdated() | rpl::on_next([=] { schedule(); }, lifetime);
+		history->owner().itemRemoved() | rpl::on_next([=](not_null<const HistoryItem*> item) {
+			if (item->history().get() == weakHistory.get()) schedule();
+		}, lifetime);
+	}
+	~Engine() { cancel(); QueryGuard(owner, nullptr, {}); }
+
+	void finishLoading() {
+		if (sender && requestId) sender->request(base::take(requestId)).cancel();
+		pages = 0; timeout.cancel(); schedule();
+	}
+	void cancel() {
+		timeout.cancel();
+		if (canceled) canceled->store(true);
+		canceled.reset();
+		if (sender && requestId) sender->request(base::take(requestId)).cancel();
+		waiting = false;
+		running = false;
+		pages = 0;
+		++serial;
+	}
+	void clear() {
+		cancel(); query.clear(); request = {}; extra.clear(); ids.clear(); before = {}; all = false;
+		QueryGuard(owner, nullptr, {});
+		publish(false);
+	}
+	void search(const Api::MessagesSearch::Request &value) {
+		cancel(); request = value; query = value.query.trimmed();
+		QueryGuard(owner, weakHistory.get(), query);
+		ids.clear(); schedule();
+	}
+	bool more() {
+		const auto history = weakHistory.get();
+		if (!history || !OlderAllowed.erase(history)) return true;
+		if (requestId || pages || all || query.isEmpty() || !available()) return true;
+		pages = kPages;
+		timeout.callOnce(20 * crl::time(1000));
+		page();
+		return true;
+	}
+	bool available() const {
+		const auto history = weakHistory.get();
+		return history && !Core::Quitting() && !Core::App().passcodeLocked()
+			&& history->session().account().maybeSession() == &history->session()
+			&& SealedAutomaticKeys(history, SealedKeyPurpose::ReadOwn).has_value();
+	}
+	void schedule() {
+		if (scheduled) return;
+		scheduled = true;
+		const auto weak = base::make_weak(this);
+		crl::on_main([=] { if (weak) { weak->scheduled = false; weak->scan(); } });
+	}
+	void scan() {
+		if (running) { again = true; return; }
+		waiting = false;
+		if (query.isEmpty() || query.size() > 512 || !available()) { ids.clear(); publish(false); return; }
+		if (!request.tags.empty() || request.topMsgId
+			|| (request.filter != Api::SearchFilter::NoFilter && request.filter != Api::SearchFilter::Pinned)) {
+			ids.clear(); publish(false); return;
+		}
+		auto job = TrySealedDecryptJob(SealedDecryptPurpose::Search);
+		if (!job) { waiting = true; return; }
+		const auto history = weakHistory.get();
+		auto own = SealedAutomaticKeys(history, SealedKeyPurpose::ReadOwn);
+		auto incoming = SealedAutomaticKeys(history, SealedKeyPurpose::ReadIncoming);
+		if (!own) { ids.clear(); publish(false); return; }
+		auto packet = std::make_shared<Packet>();
+		packet->ownPublic = own->identity.publicKey; packet->peerPublic = incoming ? incoming->peerKey : QByteArray();
+		auto workerKeys = WorkerKeys{ std::move(*own), std::move(incoming) };
+		packet->epoch = SealedAutomaticEpoch(); packet->self = history->session().userPeerId();
+		packet->ownContext = SealedContext(&history->session(), history->session().userId().bare,
+			peerToUser(history->peer->id).bare);
+		packet->incomingContext = SealedContext(&history->session(), peerToUser(history->peer->id).bare,
+			history->session().userId().bare);
+		auto candidates = std::vector<MsgId>();
+		for (auto i = extra.rbegin(); i != extra.rend(); ++i) candidates.push_back(*i);
+		const auto slice = history->messages().snapshot({ ServerMaxMsgId - 1, kCandidates, 0 });
+		for (auto b = history->blocks.rbegin(); b != history->blocks.rend() && candidates.size() < kCandidates * 2; ++b) {
+			for (auto v = (*b)->messages.rbegin(); v != (*b)->messages.rend() && candidates.size() < kCandidates * 2; ++v) candidates.push_back((*v)->data()->id);
+		}
+		for (auto i = slice.messageIds.rbegin(); i != slice.messageIds.rend() && candidates.size() < kCandidates * 2; ++i) candidates.push_back(*i);
+		auto seen = std::set<MsgId>();
+		auto used = qsizetype();
+		auto capped = candidates.size() >= size_t(kCandidates * 2);
+		for (auto i = candidates.begin(); i != candidates.end(); ++i) {
+			if (!seen.insert(*i).second) continue;
+			const auto item = history->owner().message(history->peer->id, *i);
+			if (!Eligible(item) || (request.from && item->from() != request.from)
+				|| (request.filter == Api::SearchFilter::Pinned && !item->isPinned())) continue;
+			if (item->from()->id != packet->self && item->from()->id != history->peer->id) continue;
+			const auto &text = item->originalText().text;
+			if (text.isEmpty() || text.size() > kSourceBytes / qsizetype(sizeof(QChar))) continue;
+			const auto size = text.size() * qsizetype(sizeof(QChar));
+			if (!SealedSearchSourceAllowed(int(packet->items.size()), used, size)) { capped = true; break; }
+			used += size;
+			packet->items.push_back({ item->fullId(), item->from()->id, text });
+		}
+		if (!slice.messageIds.empty() && !before) before = slice.messageIds.front();
+		packet->more = capped || (!all && (!slice.skippedBefore || *slice.skippedBefore > 0));
+		running = true;
+		again = false;
+		canceled = std::make_shared<std::atomic_bool>(false);
+		const auto stop = canceled;
+		const auto version = serial;
+		const auto pattern = query;
+		const auto weak = base::make_weak(this);
+		crl::async([weak, packet, stop, version, pattern, workerKeys = std::move(workerKeys), job = std::move(job)] {
+			auto result = Scan(*packet, workerKeys, pattern, *stop);
+			crl::on_main([weak, packet, stop, version, result = std::move(result)]() mutable {
+				if (!weak || stop->load() || weak->serial != version) return;
+				weak->running = false;
+				if (!weak->available() || packet->epoch != SealedAutomaticEpoch()) { weak->clear(); return; }
+				const auto history = weak->weakHistory.get();
+				for (const auto &source : packet->items) {
+					const auto item = history->owner().message(source.id);
+					if (!Eligible(item) || item->from()->id != source.sender || item->originalText().text != source.text) {
+						weak->schedule(); return;
+					}
+				}
+				weak->ids = std::move(result.ids);
+				weak->publish(packet->more);
+				if (weak && weak->again) weak->schedule();
+			});
+		});
+	}
+	void publish(bool partial) {
+		auto found = Api::FoundMessages{ int(ids.size()) + (partial ? 1 : 0), ids,
+			u"tele-local-"_q + QString::number(++Revision), partial };
+		const auto callback = apply;
+		if (callback) callback(std::move(found));
+	}
+	void page() {
+		if (!available() || !pages) { pages = 0; return; }
+		const auto history = weakHistory.get();
+		if (!sender) sender = std::make_unique<MTP::Sender>(&history->session().mtp());
+		const auto version = serial;
+		const auto weak = base::make_weak(this);
+		requestId = sender->request(MTPmessages_GetHistory(history->peer->input(),
+			MTP_int(before ? before : ServerMaxMsgId - 1), MTP_int(0), MTP_int(0),
+			MTP_int(kPageSize), MTP_int(0), MTP_int(0), MTP_long(0)))
+		.done([=](const MTPmessages_Messages &result) {
+			if (!weak || weak->serial != version) return;
+			weak->requestId = 0;
+			if (!weak->available()) { weak->clear(); return; }
+			const auto history = weak->weakHistory.get();
+			auto count = 0;
+			auto min = weak->before;
+			result.match([&](const MTPDmessages_messagesNotModified &) {}, [&](const auto &data) {
+				history->owner().processUsers(data.vusers());
+				if (!weak || weak->serial != version || !weak->weakHistory) return;
+				history->owner().processChats(data.vchats());
+				for (const auto &message : data.vmessages().v) {
+					if (count >= kPageSize || !weak || weak->serial != version || !weak->weakHistory) break;
+					if (PeerFromMessage(message) != history->peer->id || !DateFromMessage(message)) continue;
+					const auto item = history->owner().addNewMessage(message, MessageFlags(), NewMessageType::Existing);
+					if (!weak || weak->serial != version || !weak->weakHistory) break;
+					if (!item) continue;
+					weak->extra.push_back(item->id); ++count;
+					if (!min || item->id < min) min = item->id;
+				}
+			});
+			if (!weak || weak->serial != version || !weak->weakHistory) return;
+			if (weak->extra.size() > kCandidates) weak->extra.erase(weak->extra.begin(), weak->extra.end() - kCandidates);
+			weak->all = !count || (weak->before && min >= weak->before);
+			weak->before = min;
+			if (!weak->all && --weak->pages > 0) weak->page();
+			else { weak->pages = 0; weak->timeout.cancel(); weak->schedule(); }
+		}).fail([=] {
+			if (!weak || weak->serial != version) return;
+			weak->requestId = 0; weak->pages = 0; weak->timeout.cancel(); weak->schedule();
+		}).send();
+	}
+
+	const void *owner = nullptr;
+	base::weak_ptr<History> weakHistory;
+	Fn<void(Api::FoundMessages)> apply;
+	Api::MessagesSearch::Request request;
+	QString query;
+	MessageIdsList ids;
+	std::vector<MsgId> extra;
+	MsgId before;
+	std::unique_ptr<MTP::Sender> sender;
+	mtpRequestId requestId = 0;
+	std::shared_ptr<std::atomic_bool> canceled;
+	quint64 serial = 0;
+	int pages = 0;
+	bool all = false;
+	bool running = false;
+	bool waiting = false;
+	bool scheduled = false;
+	bool again = false;
+	base::Timer timeout;
+	rpl::lifetime lifetime;
+};
+
+std::map<const void*, std::unique_ptr<Engine>> Engines;
