diff --git a/Telegram/SourceFiles/tele/tele_sealed_view_cache.h b/Telegram/SourceFiles/tele/tele_sealed_view_cache.h
new file mode 100644
index 0000000000000000000000000000000000000000..b493b94393f0e142b3d713be76705938ed442db8
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_view_cache.h
@@ -0,0 +1,122 @@
+#pragma once
+
+#include "tele/tele_sealed_crypto.h"
+
+#include <QtCore/QByteArray>
+#include <openssl/crypto.h>
+
+#include <list>
+#include <map>
+#include <vector>
+
+namespace Tele {
+
+namespace details {
+
+class SealedViewPlaintextCache final {
+public:
+	static constexpr auto EntryLimit = 64;
+	static constexpr auto ByteLimit = 128 * 1024;
+
+	SealedViewPlaintextCache() = default;
+	SealedViewPlaintextCache(const SealedViewPlaintextCache &) = delete;
+	SealedViewPlaintextCache &operator=(const SealedViewPlaintextCache &) = delete;
+
+	~SealedViewPlaintextCache() {
+		clear();
+	}
+
+	[[nodiscard]] const QByteArray *find(const QByteArray &key) {
+		const auto i = _index.find(key);
+		if (i == _index.end()) {
+			return nullptr;
+		}
+		_entries.splice(_entries.begin(), _entries, i->second);
+		return &i->second->bytes;
+	}
+
+	[[nodiscard]] std::vector<QByteArray> put(const QByteArray &key, const QByteArray &bytes) {
+		auto evicted = std::vector<QByteArray>();
+		if (key.isEmpty() || key.size() > 256 || bytes.size() > ByteLimit) {
+			return evicted;
+		}
+		if (_index.contains(key)) {
+			erase(key);
+		}
+		while (!_entries.empty() && (_entries.size() >= size_t(EntryLimit) || _bytes + bytes.size() > ByteLimit)) {
+			const auto old = _entries.back().key;
+			evicted.push_back(old);
+			erase(old);
+		}
+		_entries.push_front({ key, QByteArray(bytes.constData(), bytes.size()) });
+		_index.emplace(key, _entries.begin());
+		_bytes += bytes.size();
+		return evicted;
+	}
+
+	void erase(const QByteArray &key) {
+		const auto i = _index.find(key);
+		if (i == _index.end()) {
+			return;
+		}
+		_bytes -= i->second->bytes.size();
+		cleanse(i->second->bytes);
+		_entries.erase(i->second);
+		_index.erase(i);
+	}
+
+	void clear() {
+		for (auto &entry : _entries) {
+			cleanse(entry.bytes);
+		}
+		_entries.clear();
+		_index.clear();
+		_bytes = 0;
+	}
+
+	[[nodiscard]] qsizetype size() const {
+		return qsizetype(_entries.size());
+	}
+
+	[[nodiscard]] qsizetype bytes() const {
+		return _bytes;
+	}
+
+private:
+	struct Entry {
+		QByteArray key;
+		QByteArray bytes;
+	};
+
+	static void cleanse(QByteArray &bytes) {
+		if (!bytes.isEmpty()) {
+			OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+		}
+		bytes.clear();
+	}
+
+	std::list<Entry> _entries;
+	std::map<QByteArray, std::list<Entry>::iterator> _index;
+	qsizetype _bytes = 0;
+};
+
+struct SealedViewProof {
+	quint64 epoch = 0;
+	QByteArray cipherDigest;
+	QByteArray ownPublic;
+	QByteArray expectedPublic;
+	QByteArray context;
+
+	[[nodiscard]] bool matches(const SealedViewProof &other) const {
+		return epoch && epoch == other.epoch
+			&& cipherDigest.size() == 32 && cipherDigest == other.cipherDigest
+			&& ownPublic.size() == kSealedPublicKeySize && ownPublic == other.ownPublic
+			&& expectedPublic.size() == kSealedPublicKeySize && expectedPublic == other.expectedPublic
+			&& context.size() == 17 && context == other.context;
+	}
+};
+
+}
+
+
+}
