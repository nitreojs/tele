+namespace Tele {
+namespace {
+
+constexpr auto kHoursLimit = 720;
+constexpr auto kDefaultHours = 24;
+constexpr auto kFileLimit = 2048;
+constexpr auto kLatestUTC = qint64(253402300799LL);
+
+struct Policy {
+	bool enabled = false;
+	int hours = kDefaultHours;
+	QByteArray seenId;
+	qint64 seenAt = 0;
+	QByteArray activeId;
+	QByteArray seed;
+	qint64 activeAt = 0;
+	qint64 expiry = 0;
+};
+
+struct Record {
+	std::optional<TextWithEntities> original;
+	TextWithEntities masked;
+	QVector<SealedCodeMapping> mappings;
+};
+
+class SessionState;
+struct ModeState;
+ModeState *Mode = nullptr;
+
+[[nodiscard]] auto &Sessions() {
+	static auto result = std::map<Main::Session*, SessionState*>();
+	return result;
+}
+
+void RefreshAll();
+void ScheduleExpiry();
+
+struct ModeState {
+	explicit ModeState(not_null<Main::Domain*> value) : domain(value) {
+	}
+	~ModeState() {
+		if (Mode == this) {
+			Mode = nullptr;
+		}
+	}
+
+	not_null<Main::Domain*> domain;
+	Policy policy;
+	bool faulty = false;
+	crl::time until = 0;
+	base::Timer timer;
+};
+
+class SessionState final {
+public:
+	explicit SessionState(not_null<Main::Session*> value) : session(value) {
+		Sessions().emplace(session, this);
+		session->data().itemRemoved() | rpl::on_next([=](not_null<const HistoryItem*> item) {
+			records.erase(item->fullId());
+		}, lifetime);
+		session->data().sessionDataAboutToBeCleared() | rpl::on_next([=] {
+			records.clear();
+		}, lifetime);
+	}
+	~SessionState() {
+		Sessions().erase(session);
+	}
+
+	not_null<Main::Session*> session;
+	std::map<FullMsgId, Record> records;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] SessionState &SessionFor(not_null<Main::Session*> session) {
+	const auto found = Sessions().find(session);
+	return found != Sessions().end()
+		? *found->second
+		: *session->lifetime().make_state<SessionState>(session);
+}
+
+[[nodiscard]] bool Applies(HistoryItem *item) {
+	return item && !item->out() && !item->isService()
+		&& item->history()->peer->id == PeerData::kServiceNotificationsId;
+}
+
+[[nodiscard]] bool Active() {
+	return Mode && (Mode->faulty || (Mode->policy.seed.size() == 32
+		&& Mode->until > crl::now()));
+}
+
+[[nodiscard]] int Hours(const QString &value) {
+	auto valid = false;
+	const auto hours = value.trimmed().toInt(&valid);
+	return valid && hours >= 1 && hours <= kHoursLimit ? hours : kDefaultHours;
+}
+
+[[nodiscard]] QString PolicyPath() {
+	return QDir(SealedDuressRoot()).filePath(u"tele_sealed_codes_"_q
+		+ QString::fromLatin1(QCryptographicHash::hash(
+			SealedDuressContext(), QCryptographicHash::Sha256).toHex())
+		+ u".json"_q);
+}
+
+[[nodiscard]] bool Number(const QJsonValue &value, qint64 &out) {
+	if (!value.isString()) {
+		return false;
+	}
+	auto valid = false;
+	const auto text = value.toString();
+	out = text.toLongLong(&valid);
+	return valid && out >= 0 && out <= kLatestUTC && QString::number(out) == text;
+}
+
+[[nodiscard]] bool Hex(const QJsonValue &value, QByteArray &out, int size) {
+	if (!value.isString()) {
+		return false;
+	}
+	const auto text = value.toString();
+	out = QByteArray::fromHex(text.toLatin1());
+	return text.isEmpty() || (out.size() == size
+		&& QString::fromLatin1(out.toHex()) == text);
+}
+
+[[nodiscard]] std::optional<Policy> ReadPolicy(bool &faulty) {
+	faulty = false;
+	const auto info = QFileInfo(PolicyPath());
+	if (!info.exists() && !info.isSymLink()) {
+		return Policy();
+	}
+	faulty = true;
+	if (info.isSymLink() || !info.isFile() || info.size() <= 0 || info.size() > kFileLimit) {
+		return std::nullopt;
+	}
+	auto file = QFile(info.absoluteFilePath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return std::nullopt;
+	}
+	const auto bytes = file.read(kFileLimit + 1);
+	if (file.error() != QFileDevice::NoError || !file.atEnd() || bytes.size() > kFileLimit) {
+		return std::nullopt;
+	}
+	const auto document = QJsonDocument::fromJson(bytes);
+	if (!document.isObject()) {
+		return std::nullopt;
+	}
+	const auto object = document.object();
+	auto result = Policy();
+	if (object.size() != 10
+		|| object.value(u"format"_q).toString() != u"tele-sealed-code-mode-v1"_q
+		|| object.value(u"context"_q).toString() != QString::fromLatin1(
+			QCryptographicHash::hash(SealedDuressContext(), QCryptographicHash::Sha512).toHex())
+		|| !object.value(u"enabled"_q).isBool()
+		|| !object.value(u"hours"_q).isDouble()
+		|| object.value(u"hours"_q).toInt() < 1
+		|| object.value(u"hours"_q).toInt() > kHoursLimit
+		|| object.value(u"hours"_q).toDouble() != object.value(u"hours"_q).toInt()
+		|| !Hex(object.value(u"seenId"_q), result.seenId, 16)
+		|| !Hex(object.value(u"activeId"_q), result.activeId, 16)
+		|| !Hex(object.value(u"seed"_q), result.seed, 32)
+		|| !Number(object.value(u"seenAt"_q), result.seenAt)
+		|| !Number(object.value(u"activeAt"_q), result.activeAt)
+		|| !Number(object.value(u"expiry"_q), result.expiry)) {
+		return std::nullopt;
+	}
+	result.enabled = object.value(u"enabled"_q).toBool();
+	result.hours = object.value(u"hours"_q).toInt();
+	if (result.seenId.isEmpty() != (result.seenAt == 0)
+		|| result.activeId.isEmpty() != result.seed.isEmpty()
+		|| result.activeId.isEmpty() != (result.activeAt == 0 && result.expiry == 0)
+		|| (!result.activeId.isEmpty() && (result.activeAt <= 0 || result.expiry <= result.activeAt
+			|| result.expiry - result.activeAt > kHoursLimit * qint64(3600)
+			|| result.seenAt < result.activeAt))) {
+		return std::nullopt;
+	}
+	faulty = false;
+	return result;
+}
+
+[[nodiscard]] bool WritePolicy(const Policy &policy) {
+	if (QFileInfo(PolicyPath()).isSymLink()) {
+		return false;
+	}
+	auto object = QJsonObject();
+	object.insert(u"format"_q, u"tele-sealed-code-mode-v1"_q);
+	object.insert(u"context"_q, QString::fromLatin1(QCryptographicHash::hash(
+		SealedDuressContext(), QCryptographicHash::Sha512).toHex()));
+	object.insert(u"enabled"_q, policy.enabled);
+	object.insert(u"hours"_q, policy.hours);
+	object.insert(u"seenId"_q, QString::fromLatin1(policy.seenId.toHex()));
+	object.insert(u"seenAt"_q, QString::number(policy.seenAt));
+	object.insert(u"activeId"_q, QString::fromLatin1(policy.activeId.toHex()));
+	object.insert(u"seed"_q, QString::fromLatin1(policy.seed.toHex()));
+	object.insert(u"activeAt"_q, QString::number(policy.activeAt));
+	object.insert(u"expiry"_q, QString::number(policy.expiry));
+	const auto bytes = QJsonDocument(object).toJson(QJsonDocument::Compact);
+	auto file = QSaveFile(PolicyPath());
+	file.setDirectWriteFallback(false);
+	return bytes.size() <= kFileLimit && file.open(QIODevice::WriteOnly)
+		&& file.setPermissions(QFile::ReadOwner | QFile::WriteOwner)
+		&& file.write(bytes) == bytes.size() && file.commit();
+}
+
+void ClearServiceNotifications() {
+	for (const auto &[session, state] : Sessions()) {
+		if (const auto history = session->data().historyLoaded(PeerData::kServiceNotificationsId)) {
+			Core::App().notifications().clearFromHistory(history);
+		}
+	}
+}
+
+void UpdatePolicy() {
+	if (!Mode || Mode->faulty) {
+		return;
+	}
+	auto policy = Mode->policy;
+	policy.enabled = SealedDecoyCodes();
+	policy.hours = Hours(SealedDecoyHours());
+	if (policy.enabled != Mode->policy.enabled || policy.hours != Mode->policy.hours) {
+		if (WritePolicy(policy)) {
+			Mode->policy = std::move(policy);
+		} else if (policy.enabled || Mode->policy.enabled || Active()) {
+			Mode->faulty = true;
+			ClearServiceNotifications();
+			RefreshAll();
+		}
+	}
+}
+
+[[nodiscard]] QByteArray Context(not_null<HistoryItem*> item) {
+	auto result = QByteArray();
+	QDataStream stream(&result, QIODevice::WriteOnly);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << quint64(item->history()->session().uniqueId())
+		<< quint64(item->fullId().peer.value) << qint64(item->fullId().msg.bare);
+	return result;
+}
+
+[[nodiscard]] bool ContainsMapping(
+		const QString &text,
+		const QVector<SealedCodeMapping> &mappings) {
+	return std::ranges::any_of(mappings, [&](const auto &mapping) {
+		return text.contains(mapping.original);
+	});
+}
+
+[[nodiscard]] TextWithEntities Mapped(
+		TextWithEntities text,
+		const QVector<SealedCodeMapping> &mappings,
+		bool replaceText = true) {
+	const auto original = text.text;
+	if (replaceText) {
+		text.text = ApplySealedCodeMappings(original, mappings);
+	}
+	for (auto i = text.entities.begin(); i != text.entities.end();) {
+		const auto data = i->data();
+		const auto decoded = QUrl::fromPercentEncoding(data.toUtf8());
+		const auto link = i->type() == EntityType::CustomUrl || i->type() == EntityType::Url;
+		if (link && (ContainsMapping(data, mappings) || ContainsMapping(decoded, mappings)
+			|| (i->validForText(original.size()) && ContainsMapping(
+				original.mid(i->offset(), i->length()), mappings)))) {
+			i = text.entities.erase(i);
+			continue;
+		}
+		if (!data.isEmpty()) {
+			const auto replaced = ApplySealedCodeMappings(data, mappings);
+			if (replaced != data) {
+				*i = EntityInText(i->type(), i->offset(), i->length(), replaced);
+			}
+		}
+		++i;
+	}
+	return text;
+}
+
+void RefreshAll() {
+	for (const auto &[session, state] : Sessions()) {
+		auto ids = std::vector<FullMsgId>();
+		ids.reserve(state->records.size());
+		for (const auto &[id, record] : state->records) {
+			ids.push_back(id);
+		}
+		for (const auto id : ids) {
+			const auto found = state->records.find(id);
+			const auto item = session->data().message(id);
+			if (!item || found == state->records.end()) {
+				continue;
+			}
+			const auto original = found->second.original.value_or(item->originalText());
+			item->setText(original);
+			item->invalidateChatListEntry();
+			session->data().updateDependentMessages(item);
+		}
+	}
+}
+
+void ScheduleExpiry() {
+	if (!Mode) {
+		return;
+	}
+	Mode->timer.cancel();
+	if (Mode->until) {
+		Mode->timer.callOnce(std::clamp(
+			Mode->until - crl::now(), crl::time(1), crl::time(60000)));
+	}
+}
+
+void AddCodeAction(
+		not_null<Ui::GenericBox*> box,
+		QString text,
+		const style::icon *icon,
+		Fn<void()> callback) {
+	const auto button = box->addRow(Settings::CreateButtonWithIcon(
+		box,
+		rpl::single(std::move(text)),
+		st::settingsButton,
+		{ .icon = icon }), style::margins(), style::al_justify);
+	button->setFocusPolicy(Qt::TabFocus);
+	button->setAllowTextLines(0);
+	button->setClickedCallback(std::move(callback));
+}
+
+void DurationBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	box->setTitle(rpl::single(Lower(u"Decoy code duration"_q)));
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	if (!Mode || Mode->faulty) {
+		box->addRow(object_ptr<Ui::FlatLabel>(box,
+			Lower(u"Code display settings could not be read."_q), st::boxLabel));
+		box->addRow(object_ptr<Ui::FlatLabel>(box,
+			Lower(u"Resetting turns decoy codes off and may reveal original login codes."_q), st::boxLabel));
+		if (Mode) {
+			AddCodeAction(box, Lower(u"Reset code display settings"_q), &st::menuIconRestore, [=] {
+				const auto weakController = base::make_weak(controller);
+				const auto weakDomain = base::make_weak(Mode->domain);
+				const auto root = SealedDuressRoot();
+				const auto context = SealedDuressContext();
+				box->closeBox();
+				RequireSealedOrdinaryPasscode(controller, [=] {
+					if (!weakController || !weakDomain || !Mode || !Mode->faulty
+						|| Mode->domain != weakDomain.get() || Core::App().passcodeLocked()
+						|| root != SealedDuressRoot() || context != SealedDuressContext()) {
+						return;
+					}
+					auto reset = Policy();
+					reset.hours = Hours(SealedDecoyHours());
+					if (!WritePolicy(reset)) {
+						weakController->showToast(Lower(u"Code display settings could not be saved."_q));
+						return;
+					}
+					Mode->policy = std::move(reset);
+					Mode->faulty = false;
+					Mode->until = 0;
+					Mode->timer.cancel();
+					base::options::lookup<bool>(kOptionSealedDecoyCodes).set(false);
+					RefreshAll();
+					weakController->showToast(Lower(u"Code display settings reset."_q));
+				});
+			});
+		}
+		box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+		return;
+	}
+	box->addRow(object_ptr<Ui::FlatLabel>(box,
+		Lower(u"Choose 1 to 720 hours. Changes apply to future duress events."_q), st::boxLabel));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(box,
+		st::defaultInputField, rpl::single(Lower(u"Hours"_q)), QString::number(Mode->policy.hours)));
+	field->setMaxLength(3);
+	const auto session = &controller->session();
+	const auto active = std::make_shared<bool>(true);
+	box->boxClosing() | rpl::on_next([=] { *active = false; }, box->lifetime());
+	Core::App().passcodeLockChanges() | rpl::on_next([=](bool locked) {
+		if (locked) {
+			*active = false;
+			box->closeBox();
+		}
+	}, box->lifetime());
+	session->account().sessionChanges() | rpl::on_next([=](Main::Session *current) {
+		if (current != session) {
+			*active = false;
+			box->closeBox();
+		}
+	}, box->lifetime());
+	box->addButton(rpl::single(Lower(u"Save"_q)), [=] {
+		auto valid = false;
+		const auto hours = field->getLastText().trimmed().toInt(&valid);
+		if (!valid || hours < 1 || hours > kHoursLimit) {
+			field->showError();
+			return;
+		} else if (!*active || !Mode || Mode->faulty
+			|| Core::App().passcodeLocked() || &controller->session() != session) {
+			return;
+		}
+		auto policy = Mode->policy;
+		policy.enabled = SealedDecoyCodes();
+		policy.hours = hours;
+		if (!WritePolicy(policy)) {
+			controller->showToast(Lower(u"Code display settings could not be saved."_q));
+			return;
+		}
+		Mode->policy = std::move(policy);
+		SetSealedDecoyHours(QString::number(hours));
+		box->closeBox();
+	});
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] { box->closeBox(); });
+	box->setFocusCallback([=] { field->setFocusFast(); });
+}
+
+}
+
+void StartSealedCodeMode(not_null<Main::Domain*> domain, rpl::lifetime &lifetime) {
+	Mode = lifetime.make_state<ModeState>(domain);
+	if (const auto loaded = ReadPolicy(Mode->faulty)) {
+		Mode->policy = *loaded;
+	}
+	if (Mode->policy.expiry > QDateTime::currentSecsSinceEpoch()) {
+		Mode->until = crl::now() + std::min(
+			Mode->policy.expiry - QDateTime::currentSecsSinceEpoch(),
+			kHoursLimit * qint64(3600)) * 1000;
+	}
+	Mode->timer.setCallback([] {
+		if (Mode && Mode->until && Mode->until <= crl::now()) {
+			Mode->until = 0;
+			RefreshAll();
+		}
+		ScheduleExpiry();
+	});
+	ScheduleExpiry();
+	base::options::lookup<bool>(kOptionSealedDecoyCodes).changes(
+	) | rpl::on_next(UpdatePolicy, lifetime);
+	base::options::lookup<QString>(kOptionSealedDecoyHours).changes(
+	) | rpl::on_next(UpdatePolicy, lifetime);
+	domain->activeSessionChanges() | rpl::on_next([=](Main::Session *session) {
+		if (session) {
+			crl::on_main(domain, [] { UpdatePolicy(); });
+		}
+	}, lifetime);
+}
+
+void ActivateSealedCodeMode(const QByteArray &activationId, qint64 activatedAtUTC) {
+	if (!Mode || Mode->faulty || activationId.size() != 16
+		|| activatedAtUTC <= 0 || activatedAtUTC > kLatestUTC
+		|| Mode->policy.seenId == activationId || activatedAtUTC < Mode->policy.seenAt) {
+		return;
+	}
+	auto policy = Mode->policy;
+	policy.seenId = activationId;
+	policy.seenAt = activatedAtUTC;
+	if (policy.enabled) {
+		policy.activeId = activationId;
+		policy.activeAt = activatedAtUTC;
+		policy.expiry = std::max(policy.expiry, activatedAtUTC + policy.hours * qint64(3600));
+		policy.seed.resize(32);
+		if (policy.expiry > kLatestUTC || RAND_bytes(
+				reinterpret_cast<unsigned char*>(policy.seed.data()), 32) != 1) {
+			Mode->faulty = true;
+			RefreshAll();
+			return;
+		}
+	}
+	if (!WritePolicy(policy)) {
+		if (policy.enabled || Active()) {
+			Mode->faulty = true;
+			ClearServiceNotifications();
+			RefreshAll();
+		}
+		return;
+	}
+	Mode->policy = std::move(policy);
+	if (Mode->policy.enabled && Mode->policy.expiry > QDateTime::currentSecsSinceEpoch()) {
+		Mode->until = std::max(Mode->until, crl::now() + std::min(
+			Mode->policy.expiry - QDateTime::currentSecsSinceEpoch(),
+			kHoursLimit * qint64(3600)) * 1000);
+	}
+	if (Active()) {
+		ClearServiceNotifications();
+		RefreshAll();
+	}
+	ScheduleExpiry();
+}
+
+void ShowSealedDecoyDuration(not_null<Window::SessionController*> controller) {
+	if (!Core::App().passcodeLocked()) {
+		controller->show(Box(DurationBox, controller));
+	}
+}
+
+TextWithEntities FilterSealedCodeText(HistoryItem *item, TextWithEntities text) {
+	if (!Applies(item)) {
+		return text;
+	}
+	auto &record = SessionFor(&item->history()->session()).records[item->fullId()];
+	if (Active()) {
+		if (record.original && record.masked.text == text.text) {
+			return Mapped(std::move(text), record.mappings, false);
+		}
+		record.original = text;
+		if (Mode->faulty) {
+			record.masked = {};
+			record.mappings.clear();
+			return {};
+		}
+		const auto masked = MakeSealedCodeText(text.text, Mode->policy.seed, Context(item));
+		record.mappings = masked.mappings;
+		record.masked = Mapped(std::move(text), record.mappings);
+		return record.masked;
+	}
+	if (record.original && record.masked.text == text.text) {
+		text = std::move(*record.original);
+	}
+	record.original.reset();
+	record.masked = {};
+	record.mappings.clear();
+	return text;
+}
+
+TextWithEntities FilterSealedCodeTranslation(HistoryItem *item, TextWithEntities text) {
+	if (!Applies(item) || !Active()) {
+		return text;
+	} else if (Mode->faulty) {
+		return {};
+	}
+	auto &record = SessionFor(&item->history()->session()).records[item->fullId()];
+	if (!record.original) {
+		record.original = item->originalText();
+		const auto masked = MakeSealedCodeText(record.original->text, Mode->policy.seed, Context(item));
+		record.mappings = masked.mappings;
+	}
+	const auto translated = MakeSealedCodeText(text.text, Mode->policy.seed, Context(item));
+	for (const auto &mapping : translated.mappings) {
+		if (!std::ranges::any_of(record.mappings, [&](const auto &current) {
+				return current.original == mapping.original
+					|| current.replacement == mapping.original;
+			})) {
+			record.mappings.push_back(mapping);
+		}
+	}
+	return Mapped(std::move(text), record.mappings);
+}
+
+}
