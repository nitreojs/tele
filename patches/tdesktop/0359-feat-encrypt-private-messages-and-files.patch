+
+void StartSealedSearch(not_null<Main::Domain*> domain, rpl::lifetime &lifetime) {
+	Domain = domain;
+	RefreshPolicy();
+	domain->accountsChanges() | rpl::on_next(ClearSealedSearch, lifetime);
+	domain->activeSessionChanges() | rpl::on_next([](Main::Session*) { ClearSealedSearch(); }, lifetime);
+	SealedAutomaticChanges() | rpl::on_next([] { RefreshPolicy(); }, lifetime);
+	lifetime.add([] { ClearSealedSearch(); Domain = nullptr; });
+}
+
+void ClearSealedSearch() {
+	RefreshPolicy();
+	OlderAllowed.clear();
+	auto engines = std::vector<base::weak_ptr<Engine>>();
+	for (const auto &[key, engine] : Engines) engines.push_back(base::make_weak(engine.get()));
+	for (const auto &engine : engines) if (engine) engine->clear();
+	auto dialogs = std::vector<std::shared_ptr<DialogSearch>>();
+	for (const auto &[widget, search] : DialogsSearches) dialogs.push_back(search);
+	for (const auto &search : dialogs) {
+		if (search->selected) { search->state.query.clear(); if (search->field) ClearField(search->field); }
+	}
+	const auto bars = ComposeBars;
+	for (const auto &[key, entry] : bars) {
+		if (entry.first && entry.second && SealedAutomaticSelected(entry.second.get())) ClearField(entry.first);
+	}
+}
+
+bool HoldSealedSearchRequest(MTP::Instance *instance,
+		const MTP::details::SerializedRequest &request, mtpRequestId requestId) {
+	if (!request || request->size() <= MTP::details::SerializedRequest::kMessageBodyPosition) return false;
+	const auto from = request->constData() + MTP::details::SerializedRequest::kMessageBodyPosition;
+	if (!BlockRequest(instance, from, request->constData() + request->size())) return false;
+	crl::on_main(instance, [=] {
+		auto reply = mtpBuffer();
+		MTPmessages_Messages(MTP_messages_messages(MTP_vector<MTPMessage>(), MTP_vector<MTPForumTopic>(),
+			MTP_vector<MTPChat>(), MTP_vector<MTPUser>())).write(reply);
+		instance->processCallback(MTP::Response{ .reply = std::move(reply), .requestId = requestId });
+	});
+	return true;
+}
+
+bool SearchSealedMessages(const void *owner, not_null<History*> history,
+		const Api::MessagesSearch::Request &request, Fn<void(Api::FoundMessages)> apply,
+		int *historyRequest, mtpRequestId *requestId, SearchTypeCombo *combo) {
+	if (!SealedAutomaticSelected(history)) { ForgetSealedMessagesSearch(owner); return false; }
+	if (historyRequest) history->owner().histories().cancelRequest(base::take(*historyRequest));
+	if (requestId) history->session().api().request(base::take(*requestId)).cancel();
+	if (combo) combo->cancel();
+	RefreshPolicy();
+	const auto i = Engines.find(owner);
+	if (i != Engines.end() && i->second->weakHistory.get() != history.get()) Engines.erase(i);
+	if (!Engines.contains(owner)) {
+		if (Engines.size() >= kEngines) {
+			apply({ 0, {}, u"tele-local-"_q + QString::number(++Revision), false });
+			return true;
+		}
+		Engines.emplace(owner, std::make_unique<Engine>(owner, history, std::move(apply)));
+	}
+	Engines.at(owner)->search(request);
+	return true;
+}
+
+bool SearchSealedMessagesMore(const void *owner) {
+	const auto i = Engines.find(owner);
+	return i != Engines.end() ? i->second->more() : false;
+}
+
+void ForgetSealedMessagesSearch(const void *owner) { Engines.erase(owner); QueryGuard(owner, nullptr, {}); }
+
+void AllowSealedSearchOlder(not_null<History*> history) {
+	if (SealedAutomaticSelected(history)) OlderAllowed.insert(history);
+}
+
+void SetupSealedSearch(DialogsRegexDescriptor &&descriptor) {
+	auto search = std::make_shared<DialogSearch>();
+	search->widget = descriptor.widget; search->field = descriptor.field;
+	search->apply = descriptor.apply; search->relayout = descriptor.relayout;
+	search->bottom = base::make_unique_q<Ui::FlatButton>(descriptor.widget, Lower(u"Search older encrypted history"_q), st::dialogsLoadMoreButton);
+	search->bottom->setToolTip(Lower(u"Searches up to 2,000 loaded messages or 8 MiB and downloads up to 400 older messages per click."_q));
+	search->bottom->hide();
+	DialogsSearches.emplace(descriptor.widget, search);
+	search->bottom->setClickedCallback([=] {
+		if (search->history) { AllowSealedSearchOlder(search->history.get()); (void)SearchSealedMessagesMore(search.get()); }
+	});
+	descriptor.widget->lifetime().add([key = descriptor.widget.get(), search] {
+		ForgetSealedMessagesSearch(search.get()); DialogsSearches.erase(key);
+	});
+	SetupDialogsRegexSearch(std::move(descriptor));
+}
+
+void DialogsSealedSearchState(not_null<QWidget*> widget, const Dialogs::SearchState &state) {
+	const auto i = DialogsSearches.find(widget);
+	if (i == DialogsSearches.end()) return;
+	const auto search = i->second;
+	search->state = state;
+	const auto history = state.inChat.owningHistory();
+	search->history = history ? base::make_weak(history) : base::weak_ptr<History>();
+	search->selected = history && SealedAutomaticSelected(history);
+	const auto changed = search->bottom->isHidden() == search->selected;
+	search->bottom->setDisabled(!search->selected || state.query.trimmed().isEmpty()
+		|| !SealedAutomaticKeys(search->history.get(), SealedKeyPurpose::ReadOwn));
+	search->bottom->setVisible(search->selected);
+	if (changed && search->relayout) search->relayout();
+	if (!search->selected) ForgetSealedMessagesSearch(search.get());
+}
+
+bool DialogsSealedSearch(not_null<QWidget*> widget, const Dialogs::SearchState &state) {
+	DialogsSealedSearchState(widget, state);
+	const auto i = DialogsSearches.find(widget);
+	if (i == DialogsSearches.end() || !i->second->selected) return false;
+	const auto search = i->second;
+	auto request = Api::MessagesSearch::Request{ .query = state.query, .from = state.fromPeer, .tags = state.tags };
+	if (DialogsSearchTypeChosen(widget)) request.filter = Api::SearchFilter::Photo;
+	return SearchSealedMessages(search.get(), search->history.get(), request, [search](Api::FoundMessages found) {
+		if (!search->widget || !search->history || !search->selected) return;
+		auto items = std::vector<not_null<HistoryItem*>>();
+		for (const auto id : found.messages) if (const auto item = search->history->owner().message(id)) items.push_back(item);
+		search->apply(std::move(items), int(found.messages.size()));
+	});
+}
+
+bool DialogsSealedSearchMore(not_null<QWidget*> widget) {
+	const auto i = DialogsSearches.find(widget);
+	return i != DialogsSearches.end() && i->second->selected;
+}
+
+QWidget *SealedSearchBottom(not_null<QWidget*> widget, QWidget *fallback) {
+	const auto i = DialogsSearches.find(widget);
+	return i != DialogsSearches.end() && i->second->selected ? i->second->bottom.get() : fallback;
+}
+
+bool SealedSearchPrivate(PeerData *peer) {
+	return peer && peer->asUser() && SealedAutomaticSelected(peer->owner().history(peer));
+}
+
+QString SealedSearchRecentQuery(History *history, const QString &query) {
+	return history && SealedAutomaticSelected(history) ? QString() : query;
+}
+
+void SetupSealedComposeSearch(not_null<Ui::RpWidget*> bar, not_null<History*> history) {
+	ComposeBars[bar] = { bar.get(), base::make_weak(history) };
+	if (SealedAutomaticSelected(history)) bar->setToolTip(Lower(u"Searches up to 2,000 loaded messages or 8 MiB and downloads up to 400 older messages per click."_q));
+	bar->lifetime().add([key = bar.get()] { ComposeBars.erase(key); });
+}
+
+}
