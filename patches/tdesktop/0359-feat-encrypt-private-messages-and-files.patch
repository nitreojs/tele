@@ -0,0 +1,365 @@
+#include "tele/tele_sealed_files.h"
+
+#include <QtCore/QBuffer>
+#include <QtCore/QIODevice>
+#include <QtCore/QStringList>
+#include <QtCore/QtEndian>
+#include <QtGui/QImage>
+#include <QtGui/QImageReader>
+#include <QtGui/QImageWriter>
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <utility>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMagic = "TELEFILE";
+constexpr auto kMagicSize = qsizetype(8);
+constexpr auto kLegacyVersion = char(1);
+constexpr auto kPresentationVersion = char(2);
+constexpr auto kHeaderSize = kMagicSize + 1 + sizeof(quint16) + sizeof(quint32);
+constexpr auto kPresentationHeaderSize = kHeaderSize + 1;
+constexpr auto kNameLimit = qsizetype(255);
+constexpr auto kMaxPhotoPixels = qint64(16 * 1024 * 1024);
+constexpr auto kMaxPhotoSide = 16384;
+
+class BoundedOutput final : public QIODevice {
+public:
+	BoundedOutput();
+	[[nodiscard]] const QByteArray &bytes() const;
+	[[nodiscard]] bool isSequential() const override;
+
+protected:
+	qint64 readData(char *data, qint64 size) override;
+	qint64 writeData(const char *data, qint64 size) override;
+
+private:
+	QByteArray _bytes;
+
+};
+
+BoundedOutput::BoundedOutput() {
+	open(QIODevice::WriteOnly);
+}
+
+const QByteArray &BoundedOutput::bytes() const {
+	return _bytes;
+}
+
+bool BoundedOutput::isSequential() const {
+	return true;
+}
+
+qint64 BoundedOutput::readData(char *, qint64) {
+	return -1;
+}
+
+qint64 BoundedOutput::writeData(const char *data, qint64 size) {
+	if (size < 0 || size > kSealedFilePayloadLimit - _bytes.size()) {
+		return -1;
+	}
+	_bytes.append(data, qsizetype(size));
+	return size;
+}
+
+[[nodiscard]] bool ReservedName(const QString &name) {
+	const auto base = name.section('.', 0, 0).toUpper();
+	const auto fixed = std::array{
+		u"CON"_q,
+		u"PRN"_q,
+		u"AUX"_q,
+		u"NUL"_q,
+	};
+	if (std::find(begin(fixed), end(fixed), base) != end(fixed)) {
+		return true;
+	}
+	return base.size() == 4
+		&& (base.startsWith(u"COM"_q) || base.startsWith(u"LPT"_q))
+		&& base[3] >= '1'
+		&& base[3] <= '9';
+}
+
+[[nodiscard]] QString SafeName(QString name) {
+	name.replace('\\', '/');
+	name = name.section('/', -1).normalized(QString::NormalizationForm_C);
+	for (auto &ch : name) {
+		if (ch.unicode() < 0x20 || ch.unicode() == 0x7F
+			|| ch.category() == QChar::Other_Format
+			|| u"<>:\"|?*"_q.contains(ch)) {
+			ch = '_';
+		}
+	}
+	while (name.endsWith('.') || name.endsWith(' ')) {
+		name.chop(1);
+	}
+	if (QString::fromUtf8(name.toUtf8()) != name
+		|| name.isEmpty() || name == u"."_q || name == u".."_q
+		|| ReservedName(name) || name.toUtf8().size() > kNameLimit) {
+		return u"file.bin"_q;
+	}
+	return name;
+}
+
+[[nodiscard]] bool PhotoSizeAllowed(QSize size) {
+	return size.width() > 0
+		&& size.height() > 0
+		&& size.width() <= kMaxPhotoSide
+		&& size.height() <= kMaxPhotoSide
+		&& qint64(size.width()) * size.height() <= kMaxPhotoPixels;
+}
+
+[[nodiscard]] std::optional<QByteArray> PixelPng(const QByteArray &encoded) {
+	if (encoded.size() < 8) {
+		return std::nullopt;
+	}
+	auto result = encoded.left(8);
+	for (auto offset = qsizetype(8); offset < encoded.size();) {
+		if (encoded.size() - offset < 12) {
+			return std::nullopt;
+		}
+		const auto size = qFromBigEndian<quint32>(
+			reinterpret_cast<const uchar*>(encoded.constData() + offset));
+		if (quint64(size) + 12 > quint64(encoded.size() - offset)) {
+			return std::nullopt;
+		}
+		const auto type = encoded.mid(offset + 4, 4);
+		if (!(uchar(type[0]) & 0x20) || type == "tRNS") {
+			result += encoded.mid(offset, qsizetype(size) + 12);
+		}
+		offset += qsizetype(size) + 12;
+	}
+	return result;
+}
+
+[[nodiscard]] bool PixelPngAllowed(const QByteArray &bytes) {
+	if (!bytes.startsWith(QByteArray::fromHex("89504e470d0a1a0a"))) {
+		return false;
+	}
+	static constexpr auto crcTable = [] {
+		auto result = std::array<quint32, 256>();
+		for (auto i = 0; i != int(result.size()); ++i) {
+			auto crc = quint32(i);
+			for (auto bit = 0; bit != 8; ++bit) {
+				crc = (crc >> 1) ^ ((crc & 1) ? 0xEDB88320U : 0U);
+			}
+			result[i] = crc;
+		}
+		return result;
+	}();
+	auto size = QSize();
+	auto data = false;
+	auto ended = false;
+	for (auto offset = qsizetype(8); offset < bytes.size();) {
+		if (bytes.size() - offset < 12) {
+			return false;
+		}
+		const auto raw = reinterpret_cast<const uchar*>(bytes.constData() + offset);
+		const auto length = qFromBigEndian<quint32>(raw);
+		if (quint64(length) + 12 > quint64(bytes.size() - offset)) {
+			return false;
+		}
+		auto crc = quint32(0xFFFFFFFFU);
+		for (auto i = qsizetype(4); i < qsizetype(length) + 8; ++i) {
+			crc = crcTable[(crc ^ raw[i]) & 0xFF] ^ (crc >> 8);
+		}
+		if ((crc ^ 0xFFFFFFFFU) != qFromBigEndian<quint32>(raw + length + 8)) {
+			return false;
+		}
+		const auto type = bytes.mid(offset + 4, 4);
+		if (type == "IHDR") {
+			if (offset != 8 || length != 13
+				|| raw[16] != 8 || raw[17] != 6
+				|| raw[18] != 0 || raw[19] != 0 || raw[20] != 0) {
+				return false;
+			}
+			const auto width = qFromBigEndian<quint32>(raw + 8);
+			const auto height = qFromBigEndian<quint32>(raw + 12);
+			if (width > kMaxPhotoSide || height > kMaxPhotoSide) {
+				return false;
+			}
+			size = QSize(int(width), int(height));
+			if (!PhotoSizeAllowed(size)) {
+				return false;
+			}
+		} else if (type == "IDAT") {
+			if (!PhotoSizeAllowed(size)) {
+				return false;
+			}
+			data = true;
+		} else if (type == "IEND") {
+			if (!data || length || offset + 12 != bytes.size()) {
+				return false;
+			}
+			ended = true;
+		} else {
+			return false;
+		}
+		offset += qsizetype(length) + 12;
+	}
+	if (!ended) {
+		return false;
+	}
+	auto input = QBuffer();
+	input.setData(bytes);
+	if (!input.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	auto reader = QImageReader(&input, "png");
+	if (reader.size() != size || reader.imageCount() > 1) {
+		return false;
+	}
+	const auto decoded = reader.read();
+	return !decoded.isNull() && decoded.size() == size;
+}
+
+[[nodiscard]] std::optional<QByteArray> SanitizePhoto(
+		const QByteArray &bytes,
+		bool resizePhoto) {
+	auto input = QBuffer();
+	input.setData(bytes);
+	if (!input.open(QIODevice::ReadOnly)) {
+		return std::nullopt;
+	}
+	auto reader = QImageReader(&input);
+	reader.setDecideFormatFromContent(true);
+	reader.setAutoTransform(true);
+	const auto formats = std::array{
+		QByteArray("png"),
+		QByteArray("jpeg"),
+		QByteArray("jpg"),
+		QByteArray("bmp"),
+		QByteArray("webp"),
+		QByteArray("tiff"),
+		QByteArray("heif"),
+		QByteArray("heic"),
+		QByteArray("avif"),
+	};
+	const auto format = reader.format().toLower();
+	if (std::find(begin(formats), end(formats), format) == end(formats)
+		|| !PhotoSizeAllowed(reader.size()) || reader.imageCount() > 1) {
+		return std::nullopt;
+	}
+	auto decoded = reader.read().convertToFormat(QImage::Format_ARGB32);
+	if (decoded.isNull() || !PhotoSizeAllowed(decoded.size())) {
+		return std::nullopt;
+	}
+	if (resizePhoto && (decoded.width() > kSealedPhotoSideLimit
+		|| decoded.height() > kSealedPhotoSideLimit)) {
+		decoded = decoded.scaled(
+			kSealedPhotoSideLimit,
+			kSealedPhotoSideLimit,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation);
+		if (decoded.isNull()) {
+			return std::nullopt;
+		}
+	}
+	auto clean = QImage(decoded.size(), QImage::Format_ARGB32);
+	if (clean.isNull()) {
+		return std::nullopt;
+	}
+	clean.setDotsPerMeterX(0);
+	clean.setDotsPerMeterY(0);
+	const auto rowSize = size_t(decoded.width()) * sizeof(QRgb);
+	for (auto y = 0; y != decoded.height(); ++y) {
+		std::memcpy(clean.scanLine(y), decoded.constScanLine(y), rowSize);
+	}
+	auto output = BoundedOutput();
+	auto writer = QImageWriter(&output, "png");
+	return writer.write(clean) ? PixelPng(output.bytes()) : std::nullopt;
+}
+
+}
+
+std::optional<QByteArray> PrepareSealedFilePayload(
+		const QString &name,
+		const QByteArray &bytes,
+		bool sanitizePhoto,
+		SealedFilePresentation presentation) {
+	if (bytes.size() > kSealedFilePayloadLimit
+		|| (presentation != SealedFilePresentation::Document
+			&& presentation != SealedFilePresentation::Image)
+		|| (presentation == SealedFilePresentation::Image && !sanitizePhoto)) {
+		return std::nullopt;
+	}
+	auto content = sanitizePhoto
+		? SanitizePhoto(bytes, presentation == SealedFilePresentation::Image)
+		: std::make_optional(bytes);
+	if (!content || (presentation == SealedFilePresentation::Image
+		&& !PixelPngAllowed(*content))) {
+		return std::nullopt;
+	}
+	const auto safe = sanitizePhoto ? u"photo.png"_q : SafeName(name);
+	const auto encodedName = safe.toUtf8();
+	const auto headerSize = (presentation == SealedFilePresentation::Image)
+		? kPresentationHeaderSize : kHeaderSize;
+	if (headerSize + encodedName.size() + content->size()
+		> kSealedFilePayloadLimit) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(kMagic, kMagicSize);
+	result.append((presentation == SealedFilePresentation::Image)
+		? kPresentationVersion : kLegacyVersion);
+	if (presentation == SealedFilePresentation::Image) {
+		result.append(char(1));
+	}
+	const auto offset = result.size();
+	result.resize(headerSize);
+	qToBigEndian(quint16(encodedName.size()), result.data() + offset);
+	qToBigEndian(quint32(content->size()), result.data() + offset + sizeof(quint16));
+	result += encodedName;
+	result += *content;
+	return result;
+}
+
+std::optional<SealedFilePayload> OpenSealedFilePayload(
+		const QByteArray &payload) {
+	if (payload.size() < kHeaderSize || payload.size() > kSealedFilePayloadLimit
+		|| std::memcmp(payload.constData(), kMagic, kMagicSize) != 0) {
+		return std::nullopt;
+	}
+	auto presentation = SealedFilePresentation::Document;
+	auto headerSize = kHeaderSize;
+	if (payload[kMagicSize] == kPresentationVersion) {
+		if (payload.size() < kPresentationHeaderSize) {
+			return std::nullopt;
+		}
+		headerSize = kPresentationHeaderSize;
+		const auto hint = uchar(payload[kMagicSize + 1]);
+		if (hint > 1) {
+			return std::nullopt;
+		}
+		presentation = hint ? SealedFilePresentation::Image : SealedFilePresentation::Document;
+	} else if (payload[kMagicSize] != kLegacyVersion) {
+		return std::nullopt;
+	}
+	const auto raw = reinterpret_cast<const uchar*>(payload.constData());
+	const auto offset = headerSize - sizeof(quint16) - sizeof(quint32);
+	const auto nameSize = qFromBigEndian<quint16>(raw + offset);
+	const auto contentSize = qFromBigEndian<quint32>(raw + offset + sizeof(quint16));
+	if (!nameSize || nameSize > kNameLimit
+		|| quint64(headerSize) + nameSize + contentSize
+			!= quint64(payload.size())) {
+		return std::nullopt;
+	}
+	const auto encodedName = payload.mid(headerSize, nameSize);
+	const auto name = QString::fromUtf8(encodedName);
+	if (name.toUtf8() != encodedName || SafeName(name) != name) {
+		return std::nullopt;
+	}
+	auto content = payload.mid(headerSize + nameSize);
+	if (presentation == SealedFilePresentation::Image
+		&& (name != u"photo.png"_q || !PixelPngAllowed(content))) {
+		return std::nullopt;
+	}
+	return SealedFilePayload{
+		.name = name,
+		.bytes = std::move(content),
+		.presentation = presentation,
+	};
+}
+
+}
