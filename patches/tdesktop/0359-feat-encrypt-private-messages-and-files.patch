diff --git a/Telegram/SourceFiles/tele/tele_sealed_rich_send.cpp b/Telegram/SourceFiles/tele/tele_sealed_rich_send.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..77d0e11d0beb1606cf09bda686ce741a709a03ac
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_rich_send.cpp
@@ -0,0 +1,255 @@
+#include "tele/tele_sealed_rich_send.h"
+
+#include "apiwrap.h"
+#include "base/weak_ptr.h"
+#include "core/application.h"
+#include "crl/crl_on_main.h"
+#include "data/data_chat_participant_status.h"
+#include "data/data_premium_limits.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "main/main_account.h"
+#include "main/main_session.h"
+#include "tele/tele_sealed_auto.h"
+#include "tele/tele_sealed_rich_send_plan.h"
+#include "tele/tele_sealed_send.h"
+#include "tele/tele_sealed_send_plan.h"
+#include "tele/tele_sealed_text.h"
+
+#include <QtCore/QCryptographicHash>
+
+#include <map>
+
+namespace Tele {
+namespace {
+
+static_assert(kSealedRichPartLimit == 64);
+
+struct Batch {
+	explicit Batch(Api::SendAction value) : action(std::move(value)) {
+	}
+
+	base::weak_ptr<History> history;
+	Api::SendAction action;
+	SealedRichSendBinding binding;
+	std::vector<QByteArray> tokens;
+	SealedRichSendCursor cursor;
+	QByteArray firstDigest;
+	crl::time created = 0;
+	qsizetype bytes = 0;
+	bool registered = false;
+	Fn<void()> after;
+};
+
+std::map<QByteArray, std::shared_ptr<Batch>> Pending;
+
+QByteArray Digest(const QByteArray &bytes) {
+	return QCryptographicHash::hash(bytes, QCryptographicHash::Sha256);
+}
+
+Api::SendAction Sanitize(const Api::SendAction &source) {
+	auto result = source;
+	result.replyTo.quote = {};
+	result.replyTo.quoteOffset = 0;
+	result.replyTo.richQuote = nullptr;
+	result.replyTo.storyId = {};
+	result.replyTo.pollOption.clear();
+	result.replyTo.todoItemId = 0;
+	return result;
+}
+
+bool ContextCurrent(const Batch &batch) {
+	const auto history = batch.history.get();
+	const auto now = crl::now();
+	if (batch.created < 0 || now < batch.created || now - batch.created > kSealedSendProofLifetime) return false;
+	if (!history || batch.cursor.canceled || Core::Quitting()
+		|| batch.binding.epoch != SealedAutomaticEpoch()
+		|| history->session().account().maybeSession() != &history->session()
+		|| history->session().uniqueId() != batch.binding.account
+		|| history->peer->id.value != batch.binding.chat
+		|| !SealedAutomaticSelected(history)
+		|| !SealedSendOptionsAllowed(batch.action)
+		|| !Data::CanSendTexts(history->peer)) {
+		return false;
+	}
+	const auto keys = SealedAutomaticKeys(history, SealedKeyPurpose::Send);
+	return keys && keys->identity.publicKey == batch.binding.ownPublic
+		&& keys->peerKey == batch.binding.peerPublic
+		&& SealedContext(&history->session(), history->session().userId().bare,
+			peerToUser(history->peer->id).bare) == batch.binding.context;
+}
+
+void Remove(const std::shared_ptr<Batch> &batch) {
+	const auto i = Pending.find(batch->firstDigest);
+	if (i != Pending.end() && i->second == batch) Pending.erase(i);
+}
+
+void Prune() {
+	const auto now = crl::now();
+	for (auto i = Pending.begin(); i != Pending.end();) {
+		const auto &batch = *i->second;
+		if (!batch.history || batch.cursor.canceled || batch.created < 0 || now < batch.created
+			|| now - batch.created > kSealedSendProofLifetime
+			|| batch.binding.epoch != SealedAutomaticEpoch()) {
+			i->second->cursor.canceled = true;
+			i = Pending.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+bool Capacity(int parts, qsizetype bytes) {
+	auto count = 0;
+	auto used = qsizetype();
+	for (const auto &[key, batch] : Pending) {
+		count += int(batch->tokens.size());
+		used += batch->bytes;
+	}
+	return SealedRichSendCapacity(Pending.size(), count, used, parts, bytes);
+}
+
+Api::MessageToSend Part(const Batch &batch, int index) {
+	auto action = batch.action;
+	if (index) {
+		action.clearDraft = false;
+		action.replyTo = {};
+	}
+	auto result = Api::MessageToSend(action);
+	result.textWithTags = { QString::fromLatin1(batch.tokens[index]), {} };
+	result.webPage = { .removed = true };
+	return result;
+}
+
+bool TokensValid(const std::vector<QString> &tokens) {
+	if (tokens.empty() || tokens.size() > size_t(kSealedRichPartLimit)) return false;
+	if (tokens.size() == 1 && ParseSealedEnvelope(tokens.front())) return true;
+	auto group = QByteArray();
+	for (auto i = 0; i != int(tokens.size()); ++i) {
+		const auto header = ParseSealedRichPartHeader(tokens[i]);
+		if (!header || header->index != i || header->count != int(tokens.size())) return false;
+		if (i == 0) group = header->group;
+		if (header->group != group) return false;
+	}
+	return true;
+}
+
+SealedRichPreparedSend Failed(SealedRichPrepareError error) {
+	return { .error = error };
+}
+
+}
+
+SealedRichPreparedSend PrepareSealedRichSend(
+		const Api::SendAction &action,
+		const SealedRichText &text,
+		const SealedRichRegisterBatch &registerBatch) {
+	Prune();
+	if (!SealedSendOptionsAllowed(action)) return Failed(SealedRichPrepareError::Unsupported);
+	if (!registerBatch || !ValidateSealedRichText(text)) return Failed(SealedRichPrepareError::InvalidText);
+	const auto history = action.history;
+	auto keys = SealedAutomaticKeys(history, SealedKeyPurpose::Send);
+	if (!keys || !Data::CanSendTexts(history->peer)) return Failed(SealedRichPrepareError::Unavailable);
+	const auto epoch = SealedAutomaticEpoch();
+	const auto context = SealedContext(&history->session(), history->session().userId().bare,
+		peerToUser(history->peer->id).bare);
+	auto tokens = EncryptSealedRichParts(keys->identity.privateKey, keys->peerKey, text, context);
+	if (!tokens || !TokensValid(*tokens)) return Failed(SealedRichPrepareError::EncryptionFailed);
+	auto batch = std::make_shared<Batch>(Sanitize(action));
+	batch->history = base::make_weak(history);
+	batch->binding = {
+		.account = history->session().uniqueId(), .chat = history->peer->id.value,
+		.epoch = epoch, .ownPublic = keys->identity.publicKey,
+		.peerPublic = keys->peerKey, .context = context,
+	};
+	const auto nativeLimit = Data::PremiumLimits(&history->session()).messageLengthCurrent();
+	for (const auto &token : *tokens) {
+		auto bytes = token.toUtf8();
+		if (bytes.isEmpty() || bytes.size() > 4096 || token.size() > nativeLimit
+			|| bytes.size() != token.size()) {
+			return Failed(SealedRichPrepareError::EncryptionFailed);
+		}
+		batch->bytes += bytes.size();
+		batch->tokens.push_back(std::move(bytes));
+	}
+	if (!Capacity(int(batch->tokens.size()), batch->bytes)) return Failed(SealedRichPrepareError::QueueFull);
+	batch->cursor.count = int(batch->tokens.size());
+	batch->firstDigest = Digest(batch->tokens.front());
+	batch->created = crl::now();
+	if (!ContextCurrent(*batch) || Pending.contains(batch->firstDigest)) {
+		return Failed(SealedRichPrepareError::Unavailable);
+	}
+	Pending.emplace(batch->firstDigest, batch);
+	auto parts = std::vector<Api::MessageToSend>();
+	parts.reserve(batch->tokens.size());
+	for (auto i = 0; i != int(batch->tokens.size()); ++i) parts.push_back(Part(*batch, i));
+	if (!registerBatch(history, batch->binding, parts) || !ContextCurrent(*batch)) {
+		batch->cursor.canceled = true;
+		Remove(batch);
+		return Failed(SealedRichPrepareError::ProofFailed);
+	}
+	batch->registered = true;
+	return { .first = std::move(parts.front()), .parts = int(parts.size()) };
+}
+
+bool IsPreparedSealedRichPart(const Api::MessageToSend &message) {
+	Prune();
+	const auto token = message.textWithTags.text.toUtf8();
+	return ranges::any_of(Pending, [&](const auto &entry) {
+		const auto &batch = *entry.second;
+		if (!batch.registered || batch.history.get() != message.action.history.get()
+			|| !ContextCurrent(batch)) return false;
+		for (auto i = 0; i != int(batch.tokens.size()); ++i) {
+			if (batch.tokens[i] == token && Part(batch, i).action == message.action
+				&& message.textWithTags.tags.isEmpty() && message.webPage.url.isEmpty()) return true;
+		}
+		return false;
+	});
+}
+
+bool ReleaseSealedRichTail(not_null<History*> history, const QString &firstToken) {
+	Prune();
+	const auto i = Pending.find(Digest(firstToken.toUtf8()));
+	if (i == Pending.end() || !i->second->registered || i->second->history.get() != history.get()) return false;
+	const auto batch = i->second;
+	if (batch->tokens.front() != firstToken.toUtf8() || !ContextCurrent(*batch)) return false;
+	if (!AcceptSealedRichFirst(batch->cursor)) return false;
+	const auto weak = batch->history;
+	crl::on_main(&history->session(), [=] {
+		while (!batch->cursor.canceled && ContextCurrent(*batch)) {
+			const auto index = TakeSealedRichTail(batch->cursor);
+			if (!index) break;
+			const auto strong = weak.get();
+			if (!strong || !ContextCurrent(*batch)) { batch->cursor.canceled = true; break; }
+			strong->session().api().sendMessage(Part(*batch, *index));
+		}
+		const auto complete = ContextCurrent(*batch) && batch->cursor.next == batch->cursor.count;
+		auto after = complete ? std::move(batch->after) : Fn<void()>();
+		batch->cursor.canceled = true;
+		Remove(batch);
+		if (after) after();
+	});
+	return true;
+}
+
+bool AfterSealedRichSend(
+		not_null<History*> history,
+		const QString &firstToken,
+		Fn<void()> callback) {
+	Prune();
+	const auto i = Pending.find(Digest(firstToken.toUtf8()));
+	if (!callback || i == Pending.end() || !i->second->registered
+		|| i->second->history.get() != history.get() || i->second->after
+		|| i->second->cursor.accepted || i->second->tokens.front() != firstToken.toUtf8()
+		|| !ContextCurrent(*i->second)) return false;
+	i->second->after = std::move(callback);
+	return true;
+}
+
+void ClearSealedRichSendBatches() {
+	for (const auto &[key, batch] : Pending) batch->cursor.canceled = true;
+	Pending.clear();
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_rich_send.h b/Telegram/SourceFiles/tele/tele_sealed_rich_send.h
