@@ -0,0 +1,430 @@
+#include "tele/tele_sealed_duress_ui.h"
+
+#include "base/weak_qptr.h"
+#include "core/application.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "settings/settings_common.h"
+#include "settings.h"
+#include "storage/storage_domain.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "tele/tele_sealed_duress.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/checkbox.h"
+#include "ui/widgets/fields/password_input.h"
+#include "ui/widgets/labels.h"
+#include "window/window_session_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_settings.h"
+
+#include <openssl/crypto.h>
+
+#include <atomic>
+
+namespace Tele {
+namespace {
+
+constexpr auto kPassphraseLimit = 1024;
+
+struct SecretBytes {
+	explicit SecretBytes(const QString &text) : bytes(text.toUtf8()) {
+	}
+
+	SecretBytes(const SecretBytes&) = delete;
+	SecretBytes &operator=(const SecretBytes&) = delete;
+
+	~SecretBytes() {
+		if (!bytes.isEmpty()) {
+			OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+		}
+	}
+
+	QByteArray bytes;
+};
+
+struct DialogState {
+	std::atomic<bool> alive = true;
+	bool busy = false;
+	Fn<void(bool)> busyChanged;
+};
+
+void SetBusy(const std::shared_ptr<DialogState> &state, bool busy) {
+	state->busy = busy;
+	if (state->busyChanged) {
+		state->busyChanged(busy);
+	}
+}
+
+[[nodiscard]] bool Ready(
+		not_null<Window::SessionController*> controller,
+		not_null<Main::Session*> session) {
+	return !Core::Quitting()
+		&& !Core::App().passcodeLocked()
+		&& Core::App().domain().local().hasLocalPasscode()
+		&& &controller->session() == session
+		&& session->account().maybeSession() == session
+		&& Core::App().domain().active().maybeSession() == session;
+}
+
+void GuardDialog(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		Fn<void()> clear) {
+	const auto close = [=] {
+		clear();
+		box->closeBox();
+	};
+	box->boxClosing() | rpl::on_next(clear, box->lifetime());
+	Core::App().passcodeLockChanges() | rpl::on_next([=](bool locked) {
+		if (locked) {
+			close();
+		}
+	}, box->lifetime());
+	Core::App().domain().activeSessionChanges() | rpl::on_next([=](Main::Session *active) {
+		if (active != session) {
+			close();
+		}
+	}, box->lifetime());
+	session->account().sessionChanges() | rpl::on_next([=](Main::Session *active) {
+		if (active != session) {
+			close();
+		}
+	}, box->lifetime());
+	Core::App().domain().local().localPasscodeChanged(
+	) | rpl::on_next(close, box->lifetime());
+}
+
+[[nodiscard]] not_null<Ui::PasswordInput*> AddPassword(
+		not_null<Ui::GenericBox*> box,
+		const QString &placeholder) {
+	auto container = object_ptr<Ui::RpWidget>(box);
+	const auto raw = container.data();
+	const auto field = Ui::CreateChild<Ui::PasswordInput>(
+		raw, st::defaultInputField, rpl::single(placeholder));
+	field->setMaxLength(kPassphraseLimit);
+	raw->resize(raw->width(), field->height());
+	raw->widthValue() | rpl::on_next([=](int width) {
+		field->resize(width, field->height());
+		field->moveToLeft(0, 0);
+	}, raw->lifetime());
+	box->addRow(std::move(container), style::al_justify);
+	return field;
+}
+
+[[nodiscard]] not_null<Ui::SettingsButton*> AddAction(
+		not_null<Ui::GenericBox*> box,
+		const QString &text,
+		const style::icon &icon) {
+	return box->addRow(Settings::CreateButtonWithIcon(
+		box,
+		rpl::single(text),
+		st::settingsButton,
+		{ .icon = &icon, .type = Settings::IconType::Simple }
+	), style::margins(), style::al_justify);
+}
+
+[[nodiscard]] bool ValidDuressPassword(const QString &text) {
+	if (text.size() > kPassphraseLimit) {
+		return false;
+	}
+	auto count = 0;
+	for (auto i = 0; i != text.size(); ++i, ++count) {
+		if (text[i].isHighSurrogate()) {
+			if (++i == text.size() || !text[i].isLowSurrogate()) {
+				return false;
+			}
+		} else if (text[i].isLowSurrogate()) {
+			return false;
+		}
+	}
+	const auto password = SecretBytes(text);
+	return count >= 8 && password.bytes.size() <= kPassphraseLimit;
+}
+
+void VerifyOrdinaryPasscode(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		not_null<Ui::PasswordInput*> field,
+		not_null<Ui::FlatLabel*> status,
+		std::shared_ptr<DialogState> state,
+		Fn<void()> accepted) {
+	const auto session = &controller->session();
+	const auto weakController = base::make_weak(controller);
+	const auto weakSession = base::make_weak(session);
+	if (state->busy || !state->alive || !Ready(controller, session)) {
+		return;
+	} else if (!passcodeCanTry()) {
+		status->setText(Lower(u"Too many attempts. Try again later."_q));
+		field->showError();
+		return;
+	} else if (field->getLastText().isEmpty()) {
+		field->showError();
+		field->setFocusFast();
+		return;
+	}
+	SetBusy(state, true);
+	const auto password = SecretBytes(field->getLastText());
+	auto job = Core::App().domain().local().prepareOpen(password.bytes);
+	field->setText(QString());
+	status->setText(Lower(u"Checking app passcode…"_q));
+	Storage::DeriveOnWorker(std::move(job), crl::guard(box, [=](Storage::PasscodeDerivation &&derived) {
+		if (!state->alive || !weakController || !weakSession
+			|| !Ready(weakController.get(), weakSession.get())) {
+			return;
+		}
+		SetBusy(state, false);
+		if (!Core::App().domain().local().checkPasscode(std::move(derived))) {
+			cSetPasscodeBadTries(cPasscodeBadTries() + 1);
+			cSetPasscodeLastTry(crl::now());
+			status->setText(Lower(u"The app passcode is incorrect."_q));
+			field->showError();
+			field->setFocusFast();
+			return;
+		}
+		cSetPasscodeBadTries(0);
+		accepted();
+	}));
+}
+
+void OrdinaryPasscodeBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		Fn<void()> done) {
+	box->setTitle(rpl::single(Lower(u"Confirm app passcode"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto field = AddPassword(box, Lower(u"Current app passcode"_q));
+	const auto status = box->addRow(object_ptr<Ui::FlatLabel>(box, QString(), st::boxLabel), style::al_justify);
+	const auto state = std::make_shared<DialogState>();
+	state->busyChanged = [=](bool busy) { field->setEnabled(!busy); };
+	GuardDialog(box, &controller->session(), [=] {
+		state->alive = false;
+		field->setText(QString());
+	});
+	const auto submit = [=] {
+		VerifyOrdinaryPasscode(box, controller, field, status, state, [=] {
+			box->closeBox();
+			if (done) done();
+		});
+	};
+	QObject::connect(field, &Ui::MaskedInputField::submitted, box,
+		[=](Qt::KeyboardModifiers) { submit(); });
+	box->setFocusCallback([=] { field->setFocusFast(); });
+	box->addButton(rpl::single(Lower(u"Continue"_q)), submit);
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] { box->closeBox(); });
+}
+
+void SetupBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		bool disable) {
+	const auto session = &controller->session();
+	const auto root = SealedDuressRoot();
+	const auto context = SealedDuressContext();
+	const auto loaded = LoadSealedDuress(root, context);
+	if (!Ready(controller, session)
+		|| (loaded.error != SealedDuressError::None && loaded.error != SealedDuressError::Missing)) {
+		box->closeBox();
+		return;
+	}
+	const auto generation = loaded.state ? loaded.state->generation : QByteArray();
+	const auto weakController = base::make_weak(controller);
+	const auto weakSession = base::make_weak(session);
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(disable
+		? u"Turn off duress password"_q
+		: u"Set duress password"_q)));
+	if (!disable) {
+		box->addRow(object_ptr<Ui::FlatLabel>(box, Lower(
+			u"Entering this password on the lock screen removes encrypted-message keys for every account in this profile."_q), st::boxLabel), style::al_justify);
+		box->addRow(object_ptr<Ui::FlatLabel>(box, Lower(
+			u"Use a separate password with at least 8 characters."_q), st::boxLabel), style::al_justify);
+	}
+	const auto current = AddPassword(box, Lower(u"Current app passcode"_q));
+	const auto password = disable ? nullptr : AddPassword(box, Lower(u"Duress password"_q)).get();
+	const auto confirm = disable ? nullptr : AddPassword(box, Lower(u"Repeat duress password"_q)).get();
+	const auto acknowledge = disable ? nullptr : box->addRow(object_ptr<Ui::Checkbox>(
+		box, Lower(u"I understand that recovery needs an off-device encrypted key backup and its separate password"_q),
+		false, st::defaultBoxCheckbox), style::al_justify);
+	if (acknowledge) {
+		acknowledge->setAllowTextLines();
+	}
+	const auto status = box->addRow(object_ptr<Ui::FlatLabel>(box, QString(), st::boxLabel), style::al_justify);
+	const auto state = std::make_shared<DialogState>();
+	state->busyChanged = [=](bool busy) {
+		current->setEnabled(!busy);
+		if (password) password->setEnabled(!busy);
+		if (confirm) confirm->setEnabled(!busy);
+		if (acknowledge) acknowledge->setEnabled(!busy);
+	};
+	GuardDialog(box, session, [=] {
+		state->alive = false;
+		current->setText(QString());
+		if (password) password->setText(QString());
+		if (confirm) confirm->setText(QString());
+	});
+	SealedDuressChanges() | rpl::on_next([=] { box->closeBox(); }, box->lifetime());
+	const auto submit = [=] {
+		if (state->busy || !state->alive || !Ready(controller, session)) {
+			return;
+		} else if (!disable && !ValidDuressPassword(password->getLastText())) {
+			password->showError();
+			password->setFocusFast();
+			status->setText(Lower(u"Use a separate password with at least 8 characters."_q));
+			return;
+		} else if (!disable && password->getLastText() != confirm->getLastText()) {
+			confirm->showError();
+			confirm->setFocusFast();
+			status->setText(Lower(u"The duress passwords do not match."_q));
+			return;
+		} else if (!disable && password->getLastText() == current->getLastText()) {
+			password->showError();
+			password->setFocusFast();
+			status->setText(Lower(u"The duress password must differ from the app passcode."_q));
+			return;
+		} else if (!disable && !acknowledge->checked()) {
+			status->setText(Lower(u"Confirm that you understand the key-loss warning."_q));
+			return;
+		}
+		const auto secret = std::make_shared<SecretBytes>(disable ? QString() : password->getLastText());
+		VerifyOrdinaryPasscode(box, controller, current, status, state, [=] {
+			if (disable) {
+				const auto result = SetSealedDuressArmed(root, context, false, generation);
+				if (result.error != SealedDuressError::None) {
+					status->setText(Lower(u"Duress settings changed or could not be saved. Open this screen again."_q));
+					return;
+				}
+				SetSealedDuressEnabled(false);
+				NotifySealedDuressUpdate();
+				box->closeBox();
+				return;
+			}
+			SetBusy(state, true);
+			password->setText(QString());
+			confirm->setText(QString());
+			status->setText(Lower(u"Preparing duress protection…"_q));
+			auto publish = crl::guard(box, [=](std::optional<SealedDuressVerifier> verifier) {
+				if (!state->alive || !weakController || !weakSession
+					|| !Ready(weakController.get(), weakSession.get())) {
+					return;
+				}
+				SetBusy(state, false);
+				if (!verifier || root != SealedDuressRoot() || context != SealedDuressContext()) {
+					status->setText(Lower(u"Could not prepare duress protection. Try again."_q));
+					return;
+				}
+				auto directories = QStringList();
+				for (const auto &entry : Core::App().domain().accounts()) {
+					if (const auto active = entry.account->maybeSession()) {
+						directories.push_back(SealedDuressDirectory(active));
+					}
+				}
+				directories.removeDuplicates();
+				const auto result = EnrollSealedDuressWithVerifier(
+					root, context, *verifier, directories, generation);
+				if (result.error != SealedDuressError::None) {
+					status->setText(Lower(u"Duress settings changed or could not be saved. Open this screen again."_q));
+					return;
+				}
+				SetSealedDuressEnabled(true);
+				NotifySealedDuressUpdate();
+				box->closeBox();
+			});
+			crl::async([=, publish = std::move(publish)]() mutable {
+				if (!state->alive) return;
+				auto verifier = MakeSealedDuressVerifier(secret->bytes, context);
+				crl::on_main([publish = std::move(publish), verifier = std::move(verifier)]() mutable {
+					publish(std::move(verifier));
+				});
+			});
+		});
+	};
+	QObject::connect(current, &Ui::MaskedInputField::submitted, box,
+		[=](Qt::KeyboardModifiers) {
+			if (password) {
+				password->setFocusFast();
+			} else {
+				submit();
+			}
+		});
+	if (password) {
+		QObject::connect(password, &Ui::MaskedInputField::submitted, box,
+			[=](Qt::KeyboardModifiers) { confirm->setFocusFast(); });
+	}
+	if (confirm) {
+		QObject::connect(confirm, &Ui::MaskedInputField::submitted, box,
+			[=](Qt::KeyboardModifiers) { submit(); });
+	}
+	box->setFocusCallback([=] { current->setFocusFast(); });
+	box->addButton(rpl::single(Lower(disable ? u"Turn off"_q : u"Save"_q)), submit);
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] { box->closeBox(); });
+}
+
+void SettingsBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Duress password"_q)));
+	const auto status = box->addRow(object_ptr<Ui::FlatLabel>(box, QString(), st::boxLabel), style::al_justify);
+	box->addRow(object_ptr<Ui::FlatLabel>(box, Lower(
+		u"Removes this profile’s encrypted-message keys when entered on the app lock screen."_q), st::boxLabel), style::al_justify);
+	box->addRow(object_ptr<Ui::FlatLabel>(box, Lower(
+		u"Backups and saved files remain outside this protection; forensic deletion is not guaranteed."_q), st::boxLabel), style::al_justify);
+	const auto setup = AddAction(
+		box,
+		Lower(u"Set or change duress password"_q),
+		st::menuIconLock);
+	const auto disable = AddAction(
+		box,
+		Lower(u"Turn off duress password"_q),
+		st::menuIconCancel);
+	const auto state = std::make_shared<DialogState>();
+	GuardDialog(box, &controller->session(), [=] { state->alive = false; });
+	const auto refresh = [=] {
+		const auto result = LoadSealedDuress(SealedDuressRoot(), SealedDuressContext());
+		const auto valid = result.error == SealedDuressError::None || result.error == SealedDuressError::Missing;
+		const auto armed = valid && result.state && result.state->armed;
+		status->setText(Lower(!valid
+			? u"Duress settings could not be loaded."_q
+			: armed ? u"Duress password is on."_q : u"Duress password is off."_q));
+		setup->setEnabled(valid);
+		disable->setVisible(armed);
+	};
+	SealedDuressChanges() | rpl::on_next(refresh, box->lifetime());
+	refresh();
+	setup->setClickedCallback([=] {
+		if (state->alive && Ready(controller, &controller->session())) {
+			controller->show(Box(SetupBox, controller, false));
+		}
+	});
+	disable->setClickedCallback([=] {
+		if (state->alive && Ready(controller, &controller->session())) {
+			controller->show(Box(SetupBox, controller, true));
+		}
+	});
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+}
+
+}
+
+void ShowSealedDuressSettings(not_null<Window::SessionController*> controller) {
+	if (!Ready(controller, &controller->session())) {
+		controller->showToast(Lower(u"Unlock Tele and set a local passcode before changing duress protection."_q));
+		return;
+	}
+	controller->show(Box(SettingsBox, controller));
+}
+
+void RequireSealedOrdinaryPasscode(
+		not_null<Window::SessionController*> controller,
+		Fn<void()> done) {
+	if (Ready(controller, &controller->session())) {
+		controller->show(Box(OrdinaryPasscodeBox, controller, std::move(done)));
+	}
+}
+
+}
