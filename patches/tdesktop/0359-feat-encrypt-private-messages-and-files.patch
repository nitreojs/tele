+quint64 User(const MTPInputPeer &peer, quint64 self) {
+	return peer.match([=](const MTPDinputPeerUser &data) { return quint64(data.vuser_id().v); },
+		[=](const MTPDinputPeerSelf &) { return self; },
+		[=](const MTPDinputPeerUserFromMessage &data) { return quint64(data.vuser_id().v); },
+		[](const auto &) { return quint64(); });
+}
+
+bool BlockRequest(MTP::Instance *instance, const mtpPrime *from, const mtpPrime *end) {
+	if (from == end) return false;
+	const auto type = mtpTypeId(*from);
+	if (type != mtpc_messages_search && type != mtpc_messages_searchGlobal) return false;
+	QReadLocker lock(&PolicyLock);
+	if (!CurrentPolicy.configured && QueryGuards.empty()) return false;
+	++from;
+	auto flags = MTPint();
+	if (!flags.read(from, end)) return CurrentPolicy.configured;
+	const auto knownFlags = (type == mtpc_messages_search) ? uint32(0x0F) : uint32(0x1F);
+	if (uint32(flags.v) & ~knownFlags) return CurrentPolicy.configured || !QueryGuards.empty();
+	const auto account = CurrentPolicy.accounts.find(instance);
+	if (type == mtpc_messages_search) {
+		auto peer = MTPInputPeer();
+		auto query = MTPstring();
+		if (!peer.read(from, end) || !query.read(from, end)) return CurrentPolicy.configured;
+		if (query.v.isEmpty()) return false;
+		const auto privatePeer = peer.match([](const MTPDinputPeerUser &) { return true; },
+			[](const MTPDinputPeerSelf &) { return true; },
+			[](const MTPDinputPeerUserFromMessage &) { return true; }, [](const auto &) { return false; });
+		const auto known = account != CurrentPolicy.accounts.end();
+		const auto binding = known ? account->second : AccountPolicy();
+		return SealedSearchPeerBlocked(CurrentPolicy.plan, CurrentPolicy.configured, known, privatePeer, {
+			.test = binding.test, .account = binding.self, .peer = User(peer, binding.self),
+		});
+	}
+	if (uint32(flags.v) & uint32(MTPmessages_SearchGlobal::Flag::f_folder_id)) {
+		auto folder = MTPint();
+		if (!folder.read(from, end)) return CurrentPolicy.configured;
+	}
+	if (uint32(flags.v) & uint32(MTPmessages_SearchGlobal::Flag::f_community)) {
+		auto community = MTPInputChannel();
+		if (!community.read(from, end)) return CurrentPolicy.configured;
+	}
+	auto query = MTPstring();
+	if (!query.read(from, end)) return CurrentPolicy.configured;
+	const auto digest = Digest(qs(query).trimmed().toUtf8());
+	return ranges::any_of(QueryGuards, [&](const auto &entry) {
+		return entry.second.instance == instance && entry.second.query == digest;
+	});
+}
+
+void QueryGuard(const void *owner, History *history, const QString &query) {
+	QWriteLocker lock(&PolicyLock);
+	if (!history || query.isEmpty()) QueryGuards.erase(owner);
+	else QueryGuards[owner] = { &history->session().mtp(), Digest(query.toUtf8()) };
+}
+
+bool Eligible(HistoryItem *item) {
+	return item && item->isRegular() && IsServerMsgId(item->id) && !item->isSending()
+		&& !item->hasFailed() && !item->isService() && !item->isSponsored() && !item->media() && !item->groupId()
+		&& !item->Get<HistoryMessageForwarded>() && !item->Get<HistoryMessageEdited>()
+		&& item->history()->peer->asUser() && item->computeUnavailableReason().isEmpty();
+}
