+#pragma once
+
+#include <QtCore/QByteArray>
+#include <QtCore/QString>
+#include <QtCore/QStringList>
+
+#include <functional>
+#include <optional>
+#include <vector>
+
+namespace Tele {
+
+inline constexpr auto kSealedDuressAccountLimit = 1536;
+
+enum class SealedDuressError {
+	None,
+	Missing,
+	InvalidInput,
+	Corrupt,
+	Unavailable,
+	Busy,
+	Changed,
+	WriteFailed,
+	CleanupFailed,
+	NotBlocked,
+	WriterFailed,
+};
+
+struct SealedDuressVerifier {
+	QByteArray salt;
+	QByteArray digest;
+};
+
+struct SealedDuressAccount {
+	QString relativeDirectory;
+	bool blocked = false;
+	bool cleanupPending = false;
+};
+
+struct SealedDuressState {
+	bool armed = false;
+	bool quarantined = false;
+	QByteArray generation;
+	QByteArray activationId;
+	qint64 activatedAtUTC = 0;
+	SealedDuressVerifier verifier;
+	std::vector<SealedDuressAccount> accounts;
+};
+
+struct SealedDuressResult {
+	SealedDuressError error = SealedDuressError::None;
+	std::optional<SealedDuressState> state;
+};
+
+[[nodiscard]] bool IsSealedKeyDirectoryName(const QString &directory);
+[[nodiscard]] std::optional<QString> ResolveSealedStorageRoot(const QString &root);
+[[nodiscard]] bool SealedKeyFilesPresentAt(const QString &directory);
+[[nodiscard]] bool SealedKeyFilesPresentOrUnsafe(
+	const QString &root,
+	const QString &directory);
+[[nodiscard]] bool EraseSealedKeyFiles(
+	const QString &root,
+	const QString &directory);
+
+[[nodiscard]] std::optional<SealedDuressVerifier> MakeSealedDuressVerifier(
+	const QByteArray &passphrase,
+	const QByteArray &context);
+[[nodiscard]] bool CheckSealedDuressVerifier(
+	const QByteArray &passphrase,
+	const QByteArray &context,
+	const SealedDuressVerifier &verifier);
+[[nodiscard]] SealedDuressResult LoadSealedDuress(
+	const QString &root,
+	const QByteArray &context);
+[[nodiscard]] SealedDuressResult EnrollSealedDuress(
+	const QString &root,
+	const QByteArray &context,
+	const QByteArray &passphrase,
+	const QStringList &directories,
+	const QByteArray &expectedGeneration = {});
+[[nodiscard]] SealedDuressResult EnrollSealedDuressWithVerifier(
+	const QString &root,
+	const QByteArray &context,
+	const SealedDuressVerifier &verifier,
+	const QStringList &directories,
+	const QByteArray &expectedGeneration = {});
+[[nodiscard]] SealedDuressResult SetSealedDuressArmed(
+	const QString &root,
+	const QByteArray &context,
+	bool armed,
+	const QByteArray &expectedGeneration);
+[[nodiscard]] SealedDuressResult RegisterSealedDuressAccount(
+	const QString &root,
+	const QByteArray &context,
+	const QString &directory,
+	const QByteArray &expectedGeneration);
+[[nodiscard]] SealedDuressResult TriggerSealedDuress(
+	const QString &root,
+	const QByteArray &context,
+	const QByteArray &expectedGeneration);
+[[nodiscard]] SealedDuressResult RetrySealedDuressCleanup(
+	const QString &root,
+	const QByteArray &context,
+	const QByteArray &expectedGeneration);
+[[nodiscard]] SealedDuressResult RecoverSealedDuressAccount(
+	const QString &root,
+	const QByteArray &context,
+	const QString &directory,
+	const QByteArray &expectedGeneration,
+	const std::function<bool()> &authenticatedWriter);
+
+}
