+[[nodiscard]] bool Ready(not_null<Main::Session*> session) {
+	return EncryptedMessages()
+		&& !Core::App().passcodeLocked()
+		&& Core::App().domain().local().hasLocalPasscode()
+		&& session->account().maybeSession() == session;
+}
+
+[[nodiscard]] quint64 PeerNumber(not_null<UserData*> peer) {
+	return peerToUser(peer->id).bare;
+}
+
+void AddLabel(not_null<Ui::GenericBox*> box, const QString &text) {
+	box->addRow(object_ptr<Ui::FlatLabel>(box, text, st::boxLabel), style::al_justify);
+}
+
+[[nodiscard]] not_null<Ui::SettingsButton*> AddKeyAction(
+		not_null<Ui::GenericBox*> box,
+		const QString &text,
+		const style::icon &icon) {
+	const auto button = box->addRow(Settings::CreateButtonWithIcon(
+		box,
+		rpl::single(text),
+		st::settingsButton,
+		{ .icon = &icon, .type = Settings::IconType::Simple }
+	), style::margins(), style::al_justify);
+	button->setFocusPolicy(Qt::TabFocus);
+	button->setAllowTextLines(0);
+	return button;
+}
+
+[[nodiscard]] Fn<void()> SessionAction(
+		not_null<Window::SessionController*> controller,
+		Fn<void()> action) {
+	const auto session = base::make_weak(&controller->session());
+	return crl::guard(controller, [=, action = std::move(action)] {
+		if (session && &controller->session() == session.get() && EncryptedMessages()) {
+			action();
+		}
+	});
+}
+
+void PublicKeyBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	auto keys = LoadSealedKeys(session);
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Encryption keys"_q)));
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+	GuardSealedBox(box, session);
+	AddLabel(box, Lower(u"Signing out or turning off the app passcode removes these keys; keep an encrypted backup."_q));
+	if (keys.error == SealedStoreError::Missing) {
+		AddLabel(box, Lower(u"Restore a backup to open existing messages, "
+			"or create a new random key for this device."_q));
+		const auto create = AddKeyAction(box, Lower(u"Create device key"_q), st::menuIconLock);
+		create->addClickHandler([=] {
+			const auto created = CreateSealedKeys(session);
+			if (!created.identity) {
+				ShowSealedStoreError(controller, created.error);
+				return;
+			}
+			box->closeBox();
+			controller->show(Box(PublicKeyBox, controller));
+		});
+		const auto backup = AddKeyAction(box, Lower(u"Encrypted key backup"_q), st::menuIconExport);
+		backup->addClickHandler([=] {
+			ShowSealedBackup(controller);
+		});
+		return;
+	} else if (!keys.identity) {
+		ShowSealedStoreError(controller, keys.error);
+		box->closeBox();
+		return;
+	}
+	AddLabel(box, Lower(u"Share only this public key. Compare fingerprints through a "
+		"trusted channel."_q));
+	const auto token = FormatSealedPublicKey(keys.identity->publicKey);
+	const auto publicKey = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		token,
+		st::boxLabel), style::al_justify);
+	publicKey->setSelectable(true);
+	publicKey->setBreakEverywhere(true);
+	const auto fingerprint = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		SealedFingerprint(keys.identity->publicKey),
+		st::boxLabel), style::al_justify);
+	fingerprint->setSelectable(true);
+	fingerprint->setBreakEverywhere(true);
+	const auto copy = AddKeyAction(box, Lower(u"Copy public key"_q), st::menuIconCopy);
+	copy->addClickHandler([=] {
+		if (Ready(session)) {
+			QGuiApplication::clipboard()->setText(token);
+		}
+	});
+	const auto backup = AddKeyAction(box, Lower(u"Encrypted key backup"_q), st::menuIconExport);
+	backup->addClickHandler([=] {
+		ShowSealedBackup(controller);
+	});
+}
+
+void VerifyKeyBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer) {
+	const auto session = &controller->session();
+	const auto keys = LoadSealedKeys(session);
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Verify encryption key"_q)));
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] { box->closeBox(); });
+	GuardSealedBox(box, session);
+	if (!keys.identity) {
+		ShowSealedStoreError(controller, keys.error);
+		box->closeBox();
+		return;
+	}
+	const auto id = PeerNumber(peer);
+	const auto i = keys.peers.find(id);
+	const auto previous = (i == end(keys.peers)) ? QByteArray() : i->second;
+	AddLabel(box, Lower(u"Compare this fingerprint in person or through another trusted "
+		"channel before saving."_q));
+	if (!previous.isEmpty()) {
+		AddLabel(box, Lower(u"Replacing a key can make older messages unreadable until the "
+			"previous key is restored."_q));
+	}
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(Lower(u"Their public key"_q)),
+		FormatSealedPublicKey(previous)), style::al_justify);
+	field->setMaxLength(512);
+	const auto fingerprint = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		QString(),
+		st::boxLabel), style::al_justify);
+	fingerprint->setSelectable(true);
+	fingerprint->setBreakEverywhere(true);
+	const auto verified = box->addRow(object_ptr<Ui::Checkbox>(
+		box,
+		Lower(u"I compared the fingerprint outside this Telegram chat"_q),
+		false,
+		st::defaultBoxCheckbox), style::al_justify);
+	verified->setAllowTextLines(0);
+	const auto refresh = [=] {
+		verified->setChecked(false);
+		const auto parsed = ParseSealedPublicKey(field->getLastText().trimmed());
+		fingerprint->setText(parsed
+			? SealedFingerprint(*parsed)
+			: Lower(u"Enter a valid public key."_q));
+	};
+	field->changes() | rpl::on_next(refresh, box->lifetime());
+	refresh();
+	box->addButton(rpl::single(Lower(u"Save verified key"_q)), [=] {
+		field->setFocusFast();
+		const auto parsed = ParseSealedPublicKey(field->getLastText().trimmed());
+		if (!Ready(session) || !parsed || !verified->checked()) {
+			field->showError();
+			return;
+		}
+		const auto error = SaveVerifiedSealedPeer(session, id, *parsed, previous);
+		if (error != SealedStoreError::None) {
+			ShowSealedStoreError(controller, error);
+			return;
+		}
+		box->closeBox();
+	});
+	box->setFocusCallback([=] { field->setFocusFast(); });
+}
+
+void ComposeBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer) {
+	const auto session = &controller->session();
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Encrypted message"_q)));
+	AddLabel(box, Lower(u"Only encrypted text is sent. This editor has no cloud draft."_q));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::newGroupDescription,
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(Lower(u"Message"_q)),
+		QString()), style::al_justify);
+	field->setMaxLength(kSealedPlaintextLimit);
+	field->setSubmitSettings(Ui::InputField::SubmitSettings::None);
+	field->rawTextEdit()->setInputMethodHints(
+		Qt::ImhSensitiveData | Qt::ImhNoPredictiveText);
+	const auto counter = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		QString(),
+		st::boxDividerLabel), style::al_justify);
+	field->changes() | rpl::on_next([=] {
+		counter->setText(Lower(u"%1 / %2 bytes"_q)
+			.arg(field->getLastText().toUtf8().size())
+			.arg(kSealedPlaintextLimit));
+	}, box->lifetime());
+	const auto clear = [=] {
+		field->setTextWithTags({}, Ui::InputField::HistoryAction::Clear);
+	};
+	GuardSealedBox(box, session, clear);
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] {
+		clear();
+		box->closeBox();
+	});
+	box->addButton(rpl::single(Lower(u"Encrypt and send"_q)), [=] {
+		field->setFocusFast();
+		if (!Ready(session) || !SealedPeerAllowed(peer)) {
+			return;
+		} else if (!Data::CanSendTexts(peer)) {
+			controller->showToast(Lower(u"Messages cannot be sent to this chat."_q));
+			return;
+		} else if (peer->starsPerMessageChecked()) {
+			controller->showToast(Lower(u"Encrypted messages do not support paid chats yet."_q));
+			return;
+		}
+		auto plain = field->getLastText().toUtf8();
+		const auto clean = gsl::finally([&] {
+			OPENSSL_cleanse(plain.data(), size_t(plain.size()));
+		});
+		if (plain.isEmpty() || plain.size() > kSealedPlaintextLimit) {
+			field->showError();
+			return;
+		}
+		const auto keys = SealedKeys(controller, peer, SealedKeyPurpose::Send);
+		if (!keys) {
+			return;
+		}
+		const auto encrypted = SealedEncrypt(
+			keys->identity.privateKey,
+			keys->peerKey,
+			plain,
+			SealedContext(session, session->userId().bare, PeerNumber(peer)));
+		const auto text = encrypted ? FormatSealedEnvelope(*encrypted) : QString();
+		if (text.isEmpty() || text.size() > 4096) {
+			controller->showToast(Lower(u"Encryption failed. Nothing was sent."_q));
+			return;
+		}
+		auto action = Api::SendAction(session->data().history(peer));
+		action.clearDraft = false;
+		auto message = Api::MessageToSend(std::move(action));
+		message.textWithTags = { text, {} };
+		if (!AuthorizeSealedTextSend(message)) {
+			controller->showToast(Lower(u"Encryption is unavailable. Nothing was sent."_q));
+			return;
+		}
+		session->api().sendMessage(std::move(message));
+		clear();
+		box->closeBox();
+	});
+	box->setFocusCallback([=] { field->setFocusFast(); });
+}
+
+struct ManualPlainText {
+	std::optional<QByteArray> bytes;
+
+	~ManualPlainText() {
+		if (bytes && !bytes->isEmpty()) OPENSSL_cleanse(bytes->data(), size_t(bytes->size()));
+	}
+};
+
+struct ManualTextState {
+	bool active = true;
+	bool processing = false;
+};
+
+void DecryptMessageBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		FullMsgId id) {
+	const auto session = &controller->session();
+	const auto item = session->data().message(id);
+	const auto peer = item ? item->history()->peer->asUser() : nullptr;
+	if (!peer || !SealedPeerAllowed(peer) || item->Get<HistoryMessageForwarded>()) {
+		box->closeBox();
+		return;
+	}
+	const auto from = item->from()->id;
+	const auto outgoing = from == session->userPeerId();
+	if (!outgoing && from != peer->id) { box->closeBox(); return; }
+	auto keys = SealedKeys(controller, peer, outgoing
+		? SealedKeyPurpose::ReadOwn : SealedKeyPurpose::ReadIncoming);
+	const auto token = item->originalText().text;
+	const auto envelope = ParseSealedEnvelope(token);
+	if (!keys || !envelope) { box->closeBox(); return; }
+	const auto own = keys->identity.publicKey;
+	const auto expected = outgoing ? own : keys->peerKey;
+	const auto context = SealedContext(session,
+		outgoing ? session->userId().bare : PeerNumber(peer),
+		outgoing ? PeerNumber(peer) : session->userId().bare);
+	const auto epoch = SealedAutomaticEpoch();
+	const auto weak = base::make_weak(box);
+	const auto weakController = base::make_weak(controller);
+	const auto weakSession = base::make_weak(session);
+	const auto state = std::make_shared<ManualTextState>();
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Decrypted message"_q)));
+	const auto label = box->addRow(object_ptr<Ui::FlatLabel>(box,
+		Lower(u"Decrypting message..."_q), st::boxLabel), style::al_justify);
+	label->setSelectable(true);
+	const auto clear = [=] { state->active = false; label->setText(QString()); };
+	GuardSealedBox(box, session, clear);
+	box->boxClosing() | rpl::on_next(clear, box->lifetime());
+	SealedAutomaticChanges() | rpl::on_next([=] {
+		if (SealedAutomaticEpoch() != epoch) box->closeBox();
+	}, box->lifetime());
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+	box->showLoading(true);
+	const auto start = [=, keys = std::move(*keys)] {
+		if (!state->active || state->processing || !weakController || !weakSession
+			|| SealedAutomaticEpoch() != epoch || !Ready(weakSession.get())) return;
+		auto permit = TrySealedDecryptJob();
+		if (!permit) return;
+		state->processing = true;
+		crl::async([weak, weakController, weakSession, state, id, token, from, outgoing,
+			own, expected, context, epoch, label, envelope = *envelope, keys, permit = std::move(permit)] {
+			const auto result = std::make_shared<ManualPlainText>();
+			result->bytes = SealedDecrypt(keys.identity.privateKey, expected, envelope, context);
+			crl::on_main([weak, weakController, weakSession, state, id, token, from,
+				outgoing, own, expected, epoch, result, label] {
+				const auto box = weak.get();
+				const auto window = weakController.get();
+				const auto session = weakSession.get();
+				if (!box || !window || !session || !state->active || &window->session() != session
+					|| SealedAutomaticEpoch() != epoch || !Ready(session)) return;
+				const auto item = session->data().message(id);
+				const auto peer = item ? item->history()->peer->asUser() : nullptr;
+				if (!peer || item->from()->id != from || item->originalText().text != token
+					|| item->Get<HistoryMessageForwarded>() || !SealedPeerAllowed(peer)) return;
+				const auto current = LoadSealedKeys(session);
+				if (!current.identity || current.identity->publicKey != own) return;
+				if (!outgoing) {
+					const auto pin = current.peers.find(PeerNumber(peer));
+					if (pin == current.peers.end() || pin->second != expected) return;
+				}
+				box->showLoading(false);
+				if (!result->bytes) {
+					label->setText(Lower(u"This message could not be decrypted with the verified key."_q));
+					return;
+				}
+				const auto text = QString::fromUtf8(*result->bytes);
+				if (text.toUtf8() == *result->bytes) label->setText(text);
+				else label->setText(Lower(u"This message could not be decrypted with the verified key."_q));
+			});
+		});
+	};
+	SealedDecryptJobsChanges() | rpl::on_next(start, box->lifetime());
+	start();
+}
+
+void DecryptMessage(not_null<Window::SessionController*> controller, FullMsgId id) {
+	controller->show(Box(DecryptMessageBox, controller, id));
+}
+
+}
+
+bool SealedPeerAllowed(not_null<UserData*> peer) {
+	return EncryptedMessages()
+		&& !peer->isBot()
+		&& !peer->isServiceUser()
+		&& !peer->isInaccessible()
+		&& !Secret::IsSecretPeer(peer)
+		&& !SealedDuressBlocked(&peer->session())
+		&& Ready(&peer->session());
+}
+
+QByteArray SealedContext(
+		not_null<Main::Session*> session,
+		uint64 sender,
+		uint64 recipient) {
+	auto result = QByteArray();
+	QDataStream stream(&result, QIODevice::WriteOnly);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << quint8(session->isTestMode()) << quint64(sender) << quint64(recipient);
+	return result;
+}
+
+QByteArray SealedBackupContext(not_null<Main::Session*> session) {
+	return SealedContext(session, session->userId().bare, session->userId().bare);
+}
+
+std::optional<SealedContactKeys> SealedKeys(
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer,
+		SealedKeyPurpose purpose) {
+	const auto session = &controller->session();
+	if (&peer->session() != session) {
+		return std::nullopt;
+	} else if (!SealedPeerAllowed(peer)) {
+		ShowSealedStoreError(controller, SealedStoreError::PasscodeRequired);
+		return std::nullopt;
+	}
+	auto keys = LoadSealedKeys(session);
+	if (purpose == SealedKeyPurpose::Send && keys.error == SealedStoreError::Missing) {
+		controller->show(Box(PublicKeyBox, controller));
+		return std::nullopt;
+	}
+	if (!keys.identity) {
+		ShowSealedStoreError(controller, keys.error);
+		return std::nullopt;
+	}
+	if (purpose == SealedKeyPurpose::ReadOwn) {
+		return SealedContactKeys{ std::move(*keys.identity), QByteArray() };
+	}
+	const auto self = peer->isSelf();
+	const auto i = keys.peers.find(PeerNumber(peer));
+	if (!self && i == end(keys.peers)) {
+		controller->showToast(Lower(
+			u"Verify this person's public key before sending or decrypting."_q));
+		return std::nullopt;
+	}
+	const auto publicKey = self ? keys.identity->publicKey : i->second;
+	return SealedContactKeys{ std::move(*keys.identity), publicKey };
+}
+
+void GuardSealedBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		Fn<void()> clear) {
+	const auto close = [=] {
+		if (clear) {
+			clear();
+		}
+		box->closeBox();
+	};
+	SealedDuressChanges() | rpl::on_next([=] {
+		if (CheckSealedDuressStorage(session) != SealedStoreError::None) {
+			close();
+		}
+	}, box->lifetime());
+	base::options::lookup<bool>(kOptionEncryptedMessages).changes(
+	) | rpl::on_next([=] {
+		if (!EncryptedMessages()) {
+			close();
+		}
+	}, box->lifetime());
+	box->boxClosing() | rpl::on_next([=] {
+		if (clear) {
+			clear();
+		}
+	}, box->lifetime());
+	Core::App().domain().local().localPasscodeChanged(
+	) | rpl::on_next([=] {
+		if (!Core::App().domain().local().hasLocalPasscode()) {
+			close();
+		}
+	}, box->lifetime());
+	Core::App().passcodeLockChanges() | rpl::on_next([=](bool locked) {
+		if (locked) {
+			close();
+		}
+	}, box->lifetime());
+	Core::App().domain().activeSessionChanges() | rpl::on_next([=](Main::Session *active) {
+		if (active != session) {
+			close();
+		}
+	}, box->lifetime());
+	session->account().sessionChanges() | rpl::on_next([=](Main::Session *active) {
+		if (active != session) {
+			close();
+		}
+	}, box->lifetime());
+}
+
+void ShowSealedStoreError(
+		not_null<Window::SessionController*> controller,
+		SealedStoreError error) {
+	const auto text = [&] {
+		switch (error) {
+		case SealedStoreError::PasscodeRequired:
+			return Lower(u"Set a local passcode before using encrypted messages."_q);
+		case SealedStoreError::Locked:
+			return Lower(u"Unlock tele before using encrypted messages."_q);
+		case SealedStoreError::Missing:
+			return Lower(u"Restore your encrypted key backup to read these messages."_q);
+		case SealedStoreError::Changed:
+			return Lower(u"The saved key changed. Open the key dialog again."_q);
+		case SealedStoreError::DuressBlocked:
+			return Lower(u"Encrypted keys are unavailable on this device."_q);
+		case SealedStoreError::Corrupt:
+			return Lower(u"The encrypted key store is damaged. No keys were replaced."_q);
+		default:
+			return Lower(u"The encryption keys could not be saved or loaded."_q);
+		}
+	}();
+	controller->showToast(text);
+}
+
+void AddSealedChatActions(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	if (!user || &user->session() != &controller->session() || !EncryptedMessages()
+		|| user->isBot() || user->isServiceUser() || user->isInaccessible()
+		|| Secret::IsSecretPeer(user) || SealedDuressBlocked(&user->session())) {
+		return;
+	}
+	const auto weak = base::make_weak(controller);
+	const auto session = base::make_weak(&controller->session());
+	const auto fill = [=](not_null<Ui::PopupMenu*> menu) {
+		const auto strong = weak.get();
+		if (!strong || !session || &strong->session() != session.get()
+			|| !EncryptedMessages() || user->isBot() || user->isServiceUser()
+			|| user->isInaccessible() || Secret::IsSecretPeer(user)
+			|| SealedDuressBlocked(&user->session())) {
+			return;
+		}
+		const auto history = user->owner().history(user);
+		const auto automatic = SealedAutomaticSelected(history);
+		menu->addAction(Lower(automatic
+			? u"Turn off automatic encryption"_q
+			: u"Enable automatic encryption"_q), SessionAction(strong, [=] {
+			SetSealedAutomaticChat(strong, user, !automatic);
+		}), &st::menuIconLock);
+		menu->addAction(Lower(u"Encrypted message"_q), SessionAction(strong, [=] {
+			if (SealedKeys(strong, user, SealedKeyPurpose::Send)) {
+				strong->show(Box(ComposeBox, strong, user));
+			}
+		}), &st::menuIconSend);
+		menu->addAction(Lower(u"Encrypted file"_q), SessionAction(strong, [=] {
+			ShowSealedFileSend(strong, user);
+		}), &st::menuIconFile);
+		menu->addSeparator();
+		menu->addAction(Lower(u"Encryption keys"_q), SessionAction(strong, [=] {
+			strong->show(Box(PublicKeyBox, strong));
+		}), &st::menuIconLock);
+		if (!user->isSelf()) {
+			menu->addAction(Lower(u"Verify encryption key"_q), SessionAction(strong, [=] {
+				strong->show(Box(VerifyKeyBox, strong, user));
+			}), &st::menuIconSigned);
+		}
+	};
+	TagMenuSubmenu(addAction({
+		.text = Lower(u"Encryption"_q),
+		.handler = nullptr,
+		.icon = &st::menuIconLock,
+		.fillSubmenu = fill,
+	}), u"encryption"_q, fill);
+}
+
+void AddSealedMessageAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Window::SessionController*> controller,
+		HistoryItem *item) {
+	const auto peer = item ? item->history()->peer->asUser() : nullptr;
+	if (!peer || !SealedPeerAllowed(peer) || item->Get<HistoryMessageForwarded>()) {
+		return;
+	}
+	if (item->originalText().text.startsWith(u"tele-sealed:v1:"_q)) {
+		const auto id = item->fullId();
+		if (HasSealedDecryptedText(item)) {
+			menu->addAction(Lower(u"Copy decrypted text"_q), SessionAction(controller, [=] {
+				(void)CopySealedDecryptedText(controller, controller->session().data().message(id));
+			}), &st::menuIconCopy);
+		}
+		menu->addAction(Lower(u"Decrypt message"_q), SessionAction(controller, [=] {
+			DecryptMessage(controller, id);
+		}), &st::menuIconLock);
+	} else if (const auto media = item->media()) {
+		if (const auto document = media->document()) {
+			if (document->filename() == u"message.teleenc"_q) {
+				const auto id = item->fullId();
+				menu->addAction(Lower(u"Decrypt file"_q), SessionAction(controller, [=] {
+					if (const auto resolved = controller->session().data().message(id)) {
+						ShowSealedFileOpen(controller, resolved);
+					}
+				}), &st::menuIconFile);
+			}
+		}
+	}
+}
+
+}
