diff --git a/Telegram/SourceFiles/tele/tele_sealed_search_plan.h b/Telegram/SourceFiles/tele/tele_sealed_search_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..f2308ee6f4ccdea157f5804f36d99b6bfd5832cf
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_search_plan.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "tele/tele_sealed_auto_mode.h"
+
+namespace Tele {
+
+inline constexpr auto kSealedSearchCandidateLimit = 2000;
+inline constexpr auto kSealedSearchSourceLimit = qint64(8 * 1024 * 1024);
+
+[[nodiscard]] inline bool SealedSearchPeerBlocked(
+		const SealedAutomaticPlan &plan,
+		bool configured,
+		bool knownAccount,
+		bool privatePeer,
+		const SealedAutomaticChatId &id) {
+	return configured && privatePeer && (!knownAccount || !id.account || !id.peer
+		|| SealedAutomaticPlanSelected(plan, id));
+}
+
+[[nodiscard]] inline bool SealedSearchSourceAllowed(int count, qint64 used, qint64 size) {
+	return count >= 0 && count < kSealedSearchCandidateLimit
+		&& used >= 0 && used <= kSealedSearchSourceLimit
+		&& size > 0 && size <= kSealedSearchSourceLimit - used;
+}
+
+[[nodiscard]] inline QString NormalizeSealedSearchText(const QString &text) {
+	return text.normalized(QString::NormalizationForm_KC).toCaseFolded();
+}
+
+[[nodiscard]] inline bool SealedSearchTextMatches(
+		const QString &text,
+		const QString &normalizedQuery) {
+	return !normalizedQuery.isEmpty() && NormalizeSealedSearchText(text).contains(normalizedQuery);
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_send.cpp b/Telegram/SourceFiles/tele/tele_sealed_send.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dba9cce151613976a6b24edc89feb6929fee93e5
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_send.cpp
@@ -0,0 +1,709 @@
+#include "tele/tele_sealed_send.h"
+
+#include "apiwrap.h"
+#include "base/weak_ptr.h"
+#include "base/options.h"
+#include "core/application.h"
+#include "crl/crl_on_main.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "mtproto/mtproto_response.h"
+#include "storage/localimageloader.h"
+#include "storage/storage_account.h"
+#include "storage/storage_domain.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_drafts.h"
+#include "tele/tele_options.h"
+#include "tele/tele_sealed_auto.h"
+#include "tele/tele_sealed_parts.h"
+#include "tele/tele_sealed_rich_send.h"
+#include "tele/tele_sealed_text.h"
+#include "tele/tele_sealed_send_plan.h"
+#include "tele/tele_sealed_duress.h"
+#include "ui/chat/attach/attach_prepare.h"
+#include "ui/widgets/fields/input_field.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QPointer>
+#include <QtGui/QTextDocument>
+#include <QtWidgets/QTextEdit>
+
+#include <openssl/crypto.h>
+
+#include <deque>
+
+namespace Tele {
+namespace {
+
+constexpr auto kProofLimit = 1024;
+
+struct Proof {
+	base::weak_ptr<History> history;
+	SealedSendProof stamp;
+};
+
+struct Field {
+	QPointer<Ui::InputField> field;
+	Fn<History*()> history;
+	Fn<void()> changed;
+	bool protectedBefore = false;
+};
+
+struct State {
+	std::deque<Proof> proofs;
+	std::vector<Field> fields;
+	std::vector<base::weak_ptr<History>> privateHistories;
+	History *purging = nullptr;
+};
+
+State &Get() {
+	static auto result = State();
+	return result;
+}
+
+QByteArray Serialized(const auto &value) {
+	auto buffer = mtpBuffer();
+	value.write(buffer);
+	return QByteArray(reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(mtpPrime));
+}
+
+QByteArray Digest(const QByteArray &bytes) {
+	return QCryptographicHash::hash(bytes, QCryptographicHash::Sha256);
+}
+
+QByteArray ReplyBytes(not_null<History*> history, const FullReplyTo &reply) {
+	if (!reply) {
+		return {};
+	}
+	auto serialized = mtpBuffer();
+	Data::ReplyToForMTP(history, reply).write(serialized);
+	return QByteArray(reinterpret_cast<const char*>(serialized.constData()),
+		serialized.size() * sizeof(mtpPrime));
+}
+
+void Prune() {
+	auto &state = Get();
+	const auto now = crl::now();
+	const auto epoch = SealedAutomaticEpoch();
+	std::erase_if(state.proofs, [&](const Proof &proof) {
+		return !proof.history || !SealedSendProofLive(proof.stamp, epoch, now);
+	});
+	std::erase_if(state.fields, [](const Field &field) {
+		return !field.field;
+	});
+	std::erase_if(state.privateHistories, [](const auto &history) { return !history; });
+}
+
+void Toast(not_null<History*> history, QString text) {
+	if (const auto window = Core::App().windowFor(history->peer)) {
+		if (const auto controller = window->sessionController()) {
+			if (&controller->session() == &history->session()) {
+				controller->showToast(std::move(text));
+			}
+		}
+	}
+}
+
+bool Block(not_null<History*> history, QString text) {
+	Toast(history, std::move(text));
+	return true;
+}
+
+void Strip(Api::MessageToSend &message) {
+	message.textWithTags.tags.clear();
+	message.webPage = { .removed = true };
+	message.action.replyTo.quote = {};
+	message.action.replyTo.quoteOffset = 0;
+	message.action.replyTo.richQuote = nullptr;
+	message.action.replyTo.pollOption.clear();
+	message.action.replyTo.todoItemId = 0;
+	message.action.replyTo.storyId = {};
+}
+
+bool OptionsAllowed(const Api::SendAction &action) {
+	const auto &options = action.options;
+	return !options.scheduled && !options.scheduleRepeatPeriod
+		&& !options.shortcutId && !options.sendAs && !options.price
+		&& !options.effectId && !options.suggest && !options.welcomeTemplate
+		&& !options.ttlSeconds && !action.replaceMediaOf
+		&& !action.replyTo.topicRootId && !action.replyTo.monoforumPeerId
+		&& !action.history->peer->starsPerMessageChecked();
+}
+
+bool Current(const Proof &proof, not_null<History*> history) {
+	if (proof.history.get() != history.get()
+		|| proof.stamp.epoch != SealedAutomaticEpoch()
+		|| SealedAutomaticStateFor(history) != SealedAutomaticState::Ready) {
+		return false;
+	}
+	const auto keys = SealedAutomaticKeys(history, SealedKeyPurpose::Send);
+	return keys && SealedSendProofMatches(proof.stamp,
+		history->session().uniqueId(), history->peer->id.value, SealedAutomaticEpoch(),
+		crl::now(), keys->identity.publicKey, keys->peerKey);
+}
+
+bool HasTextProof(Api::MessageToSend &message) {
+	Prune();
+	const auto history = message.action.history;
+	const auto digest = Digest(message.textWithTags.text.toUtf8());
+	const auto reply = ReplyBytes(history, message.action.replyTo);
+	return ranges::any_of(Get().proofs, [&](const Proof &proof) {
+		return SealedSendTextMatches(proof.stamp, digest, reply) && Current(proof, history);
+	});
+}
+
+bool Remember(Api::MessageToSend &message, const SealedContactKeys &keys) {
+	Prune();
+	if (Get().proofs.size() >= size_t(kProofLimit)) return false;
+	Get().proofs.push_back({
+		.history = base::make_weak(message.action.history),
+		.stamp = {
+			.account = message.action.history->session().uniqueId(),
+			.chat = message.action.history->peer->id.value,
+			.digest = Digest(message.textWithTags.text.toUtf8()),
+			.reply = ReplyBytes(message.action.history, message.action.replyTo),
+			.own = keys.identity.publicKey,
+			.peer = keys.peerKey,
+			.epoch = SealedAutomaticEpoch(),
+			.when = crl::now(),
+		},
+	});
+	return true;
+}
+
+bool RegisterRichBatch(
+		not_null<History*> history,
+		const SealedRichSendBinding &binding,
+		const std::vector<Api::MessageToSend> &messages) {
+	Prune();
+	if (messages.empty() || messages.size() > size_t(kSealedRichPartLimit)
+		|| Get().proofs.size() + messages.size() > size_t(kProofLimit)
+		|| binding.epoch != SealedAutomaticEpoch()
+		|| binding.account != history->session().uniqueId()
+		|| binding.chat != history->peer->id.value) return false;
+	const auto keys = SealedAutomaticKeys(history, SealedKeyPurpose::Send);
+	if (!keys || keys->identity.publicKey != binding.ownPublic || keys->peerKey != binding.peerPublic
+		|| SealedContext(&history->session(), history->session().userId().bare,
+			peerToUser(history->peer->id).bare) != binding.context) return false;
+	auto prepared = std::vector<Proof>();
+	prepared.reserve(messages.size());
+	for (auto i = 0; i != int(messages.size()); ++i) {
+		const auto &message = messages[i];
+		if (message.action.history != history || !OptionsAllowed(message.action)
+			|| (i && message.action.clearDraft) || !message.textWithTags.tags.isEmpty()
+			|| message.textWithTags.text.isEmpty() || message.textWithTags.text.size() > 4096
+			|| !message.webPage.url.isEmpty() || message.webPage.id
+			|| !message.action.replyTo.quote.empty() || message.action.replyTo.richQuote
+			|| message.action.replyTo.storyId || !message.action.replyTo.pollOption.isEmpty()) return false;
+		prepared.push_back({
+			.history = base::make_weak(history),
+			.stamp = {
+				.account = binding.account, .chat = binding.chat,
+				.digest = Digest(message.textWithTags.text.toUtf8()),
+				.reply = ReplyBytes(history, message.action.replyTo),
+				.own = binding.ownPublic, .peer = binding.peerPublic,
+				.epoch = binding.epoch, .when = crl::now(),
+			},
+		});
+	}
+	if (binding.epoch != SealedAutomaticEpoch()) return false;
+	for (auto &proof : prepared) Get().proofs.push_back(std::move(proof));
+	return true;
+}
+
+void ClearField(Field &tracked) {
+	const auto was = std::exchange(Get().purging, tracked.history());
+	const auto reset = gsl::finally([&] { Get().purging = was; });
+	if (const auto field = tracked.field.data()) {
+		field->setTextWithTags({});
+		field->rawTextEdit()->document()->clearUndoRedoStacks();
+	}
+}
+
+void ClearPrivateDrafts(not_null<History*> history) {
+	const auto was = std::exchange(Get().purging, history.get());
+	const auto reset = gsl::finally([&] { Get().purging = was; });
+	if (const auto cloud = history->cloudDraft({}, {})) {
+		if (cloud->saveRequestId) {
+			history->session().api().request(cloud->saveRequestId).cancel();
+			cloud->saveRequestId = 0;
+		}
+	}
+	history->clearDrafts();
+	history->session().local().writeDrafts(history);
+	history->session().local().writeDraftCursors(history);
+}
+
+void Invalidate(bool clearAll, Main::Session *only = nullptr) {
+	if (clearAll) {
+		ClearSealedRichSendBatches();
+		Get().proofs.clear();
+	}
+	Prune();
+	for (auto &tracked : Get().fields) {
+		const auto history = tracked.history();
+		if (!history || (only && &history->session() != only)) {
+			continue;
+		}
+		const auto selected = SealedDraftsMemoryOnly(history);
+		if (tracked.protectedBefore && (clearAll || !selected)) {
+			ClearField(tracked);
+			ClearPrivateDrafts(history);
+		}
+		const auto changed = tracked.changed;
+		const auto notify = selected || tracked.protectedBefore;
+		tracked.protectedBefore = selected;
+		if (notify && changed) {
+			changed();
+		}
+	}
+	const auto privateHistories = Get().privateHistories;
+	for (const auto &weak : privateHistories) {
+		if (const auto history = weak.get(); history && (!only || only == &history->session())) {
+			if (clearAll || !SealedAutomaticSelected(history)) {
+				ClearPrivateDrafts(history);
+			}
+		}
+	}
+	std::erase_if(Get().privateHistories, [](const auto &weak) {
+		return !weak || !SealedAutomaticSelected(weak.get());
+	});
+	if (clearAll) {
+		for (const auto &[index, account] : Core::App().domain().accounts()) {
+			if (const auto session = account->maybeSession(); session && (!only || only == session)) {
+				session->data().enumerateUsers([=](not_null<UserData*> user) {
+					if (const auto history = session->data().historyLoaded(user->id)) {
+						if (SealedDraftsMemoryOnly(history)) {
+							ClearPrivateDrafts(history);
+						}
+					}
+				});
+			}
+		}
+	}
+}
+
+bool AllowedTextRequest(
+		not_null<History*> history,
+		const MTPmessages_SendMessage &request) {
+	using Flag = MTPmessages_sendMessage::Flag;
+	auto buffer = mtpBuffer();
+	request.write(buffer);
+	auto from = buffer.constData();
+	const auto end = from + buffer.size();
+	auto type = MTPint();
+	auto flags = MTPint();
+	auto peer = MTPInputPeer();
+	auto reply = MTPInputReplyTo();
+	auto message = MTPstring();
+	auto random = MTPlong();
+	const auto allowed = uint32(Flag::f_no_webpage) | uint32(Flag::f_silent)
+		| uint32(Flag::f_clear_draft) | uint32(Flag::f_reply_to);
+	if (!type.read(from, end) || !flags.read(from, end)
+		|| (uint32(flags.v) & ~allowed) || !peer.read(from, end)
+		|| Serialized(peer) != Serialized(history->peer->input())) {
+		return false;
+	}
+	auto replyBytes = QByteArray();
+	if (uint32(flags.v) & uint32(Flag::f_reply_to)) {
+		const auto start = from;
+		if (!reply.read(from, end)) {
+			return false;
+		}
+		replyBytes = QByteArray(reinterpret_cast<const char*>(start),
+			(from - start) * sizeof(mtpPrime));
+	}
+	if (!message.read(from, end) || !random.read(from, end) || from != end) {
+		return false;
+	}
+	const auto text = qs(message);
+	const auto digest = Digest(text.toUtf8());
+	const auto allowedText = ranges::any_of(Get().proofs, [&](const Proof &proof) {
+		return SealedSendTextMatches(proof.stamp, digest, replyBytes) && Current(proof, history);
+	});
+	if (allowedText) {
+		const auto released = ReleaseSealedRichTail(history, text);
+		(void)released;
+	}
+	return allowedText;
+}
+
+bool AllowedMediaRequest(
+		not_null<History*> history,
+		const MTPmessages_SendMedia &request) {
+	using Flag = MTPmessages_sendMedia::Flag;
+	auto buffer = mtpBuffer();
+	request.write(buffer);
+	auto from = buffer.constData();
+	const auto end = from + buffer.size();
+	auto type = MTPint();
+	auto flags = MTPint();
+	auto peer = MTPInputPeer();
+	auto reply = MTPInputReplyTo();
+	auto media = MTPInputMedia();
+	auto caption = MTPstring();
+	auto random = MTPlong();
+	const auto allowed = uint32(Flag::f_silent) | uint32(Flag::f_clear_draft);
+	if (!type.read(from, end) || !flags.read(from, end)
+		|| (uint32(flags.v) & ~allowed) || !peer.read(from, end)
+		|| Serialized(peer) != Serialized(history->peer->input())
+		|| !media.read(from, end) || !caption.read(from, end)
+		|| !random.read(from, end) || from != end || !qs(caption).isEmpty()) {
+		return false;
+	}
+	const auto fileId = media.match([](const MTPDinputMediaUploadedDocument &data) {
+		using MediaFlag = MTPDinputMediaUploadedDocument::Flag;
+		if (qs(data.vmime_type()) != u"application/octet-stream"_q
+			|| (uint32(data.vflags().v) & ~uint32(MediaFlag::f_force_file))
+			|| data.vattributes().v.size() != 1
+			|| !data.vattributes().v.front().match([](const MTPDdocumentAttributeFilename &attribute) {
+				return qs(attribute.vfile_name()) == u"message.teleenc"_q;
+			}, [](const auto &) { return false; })) {
+			return uint64(0);
+		}
+		return data.vfile().match([](const MTPDinputFile &file) {
+			return qs(file.vname()) == u"message.teleenc"_q ? uint64(file.vid().v) : uint64(0);
+		}, [](const MTPDinputFileBig &file) {
+			return qs(file.vname()) == u"message.teleenc"_q ? uint64(file.vid().v) : uint64(0);
+		}, [](const auto &) { return uint64(0); });
+	}, [](const auto &) { return uint64(0); });
+	return fileId && ranges::any_of(Get().proofs, [&](const Proof &proof) {
+		return SealedSendUploadedFileMatches(proof.stamp, fileId) && Current(proof, history);
+	});
+}
+
+}
+
+void StartSealedSend(not_null<Main::Domain*> domain, rpl::lifetime &lifetime) {
+	SealedAutomaticChanges() | rpl::on_next([] { Invalidate(false); }, lifetime);
+	base::options::lookup<bool>(kOptionEncryptedMessages).changes() | rpl::on_next([] {
+		if (!EncryptedMessages()) {
+			Invalidate(true);
+		}
+	}, lifetime);
+	Core::App().passcodeLockChanges() | rpl::on_next([](bool locked) {
+		if (locked) {
+			Invalidate(true);
+		}
+	}, lifetime);
+	SealedDuressChanges() | rpl::on_next([] { Invalidate(true); }, lifetime);
+	domain->activeSessionChanges() | rpl::on_next([](Main::Session*) {
+		Invalidate(true);
+	}, lifetime);
+	domain->local().localPasscodeChanged() | rpl::on_next([] {
+		Invalidate(true);
+	}, lifetime);
+}
+
+void SetupSealedCompose(
+		not_null<Ui::InputField*> field,
+		Fn<History*()> history,
+		Fn<void()> changed) {
+	Prune();
+	Get().fields.push_back({
+		.field = field.get(),
+		.history = std::move(history),
+		.changed = std::move(changed),
+	});
+	const auto weak = QPointer<Ui::InputField>(field.get());
+	field->changes() | rpl::on_next([=] {
+		for (auto &tracked : Get().fields) {
+			if (tracked.field == weak) {
+				tracked.protectedBefore = SealedDraftsMemoryOnly(tracked.history());
+				break;
+			}
+		}
+	}, field->lifetime());
+}
+
+bool SealedDraftsMemoryOnly(History *history) {
+	if (!history) {
+		return false;
+	} else if (Get().purging == history) {
+		return true;
+	} else if (!SealedAutomaticSelected(history)) {
+		return false;
+	}
+	if (!ranges::any_of(Get().privateHistories, [&](const auto &weak) {
+		return weak.get() == history;
+	})) {
+		Get().privateHistories.push_back(base::make_weak(history));
+	}
+	return true;
+}
+
+bool SealedFieldPrivate(not_null<Ui::InputField*> field) {
+	Prune();
+	return ranges::any_of(Get().fields, [&](const Field &tracked) {
+		return tracked.field == field.get() && SealedDraftsMemoryOnly(tracked.history());
+	});
+}
+
+bool SealedComposePrivate(not_null<PeerData*> peer) {
+	return SealedDraftsMemoryOnly(peer->session().data().historyLoaded(peer->id));
+}
+
+const Data::HistoryDrafts &SealedPersistedDrafts(not_null<History*> history) {
+	static const auto empty = Data::HistoryDrafts();
+	return SealedDraftsMemoryOnly(history) ? empty : history->draftsMap();
+}
+
+bool SealedSkipDraftRead(not_null<History*> history) {
+	if (!SealedDraftsMemoryOnly(history)) {
+		return false;
+	}
+	history->session().local().writeDrafts(history);
+	history->session().local().writeDraftCursors(history);
+	return true;
+}
+
+bool DiscardSealedDraftSave(not_null<Data::Thread*> thread, mtpRequestId requestId) {
+	const auto history = thread->owningHistory();
+	if (!SealedDraftsMemoryOnly(history)) {
+		return false;
+	}
+	if (requestId) {
+		history->session().api().request(requestId).cancel();
+	}
+	return true;
+}
+
+void SealedAutomaticModeChanged(
+		not_null<Main::Session*> session,
+		not_null<UserData*> peer) {
+	ClearSealedRichSendBatches();
+	Get().proofs.clear();
+	const auto history = session->data().history(peer);
+	if (!SealedDraftsMemoryOnly(history)) {
+		Invalidate(false);
+		return;
+	}
+	if (const auto cloud = history->cloudDraft({}, {})) {
+		if (cloud->saveRequestId) {
+			session->api().request(cloud->saveRequestId).cancel();
+			cloud->saveRequestId = 0;
+		}
+	}
+	history->clearCloudDraft({}, {});
+	Drafts(session).setDocked({ .thread = { .peer = peer->id } }, {});
+	session->local().writeDrafts(history);
+	session->local().writeDraftCursors(history);
+	const auto weak = base::make_weak(history);
+	session->api().request(MTPmessages_SaveDraft(
+		MTP_flags(0), MTPInputReplyTo(), peer->input(), MTP_string(QString()),
+		MTPVector<MTPMessageEntity>(), MTPInputMedia(), MTP_long(0),
+		MTPSuggestedPost(), MTPInputRichMessage()
+	)).fail([=] {
+		if (const auto strong = weak.get(); strong && SealedDraftsMemoryOnly(strong)) {
+			Toast(strong, Lower(u"The old cloud draft could not be cleared. Retry when connected."_q));
+		}
+	}).send();
+	Invalidate(false);
+}
+
+bool PrepareSealedCompose(
+		not_null<Window::SessionController*>,
+		Api::MessageToSend &message,
+		TextWithTags &animationText) {
+	if (PrepareSealedSend(message)) {
+		return true;
+	}
+	if (SealedDraftsMemoryOnly(message.action.history)) {
+		animationText = message.textWithTags;
+	}
+	return false;
+}
+
+bool PrepareSealedSend(Api::MessageToSend &message) {
+	const auto history = message.action.history;
+	if (!SealedDraftsMemoryOnly(history)) return false;
+	if (!OptionsAllowed(message.action)) return BlockSealedUnsupported(history);
+	auto candidate = message;
+	Strip(candidate);
+	if (HasTextProof(candidate)) {
+		message = std::move(candidate);
+		return false;
+	}
+	if (message.textWithTags.tags.isEmpty()
+		&& (ParseSealedEnvelope(message.textWithTags.text)
+			|| ParseSealedRichPartHeader(message.textWithTags.text))) {
+		return Block(history, Lower(u"Encryption is unavailable. Nothing was sent."_q));
+	}
+	auto utf8 = message.textWithTags.text.toUtf8();
+	const auto tooLarge = utf8.size() > kSealedRichPayloadLimit - 17
+		|| message.textWithTags.tags.size() > kSealedRichTagLimit;
+	OPENSSL_cleanse(utf8.data(), size_t(utf8.size()));
+	if (tooLarge) {
+		return Block(history, Lower(u"Encrypted messages support up to 64 parts. Shorten the text or formatting."_q));
+	}
+	auto rich = SealedRichText();
+	if (!SealedRichFromNative(message.textWithTags, rich)) {
+		return Block(history, Lower(u"This formatting cannot be encrypted safely."_q));
+	}
+	auto prepared = PrepareSealedRichSend(message.action, rich, RegisterRichBatch);
+	if (!prepared.first) {
+		if (prepared.error == SealedRichPrepareError::InvalidText
+			|| prepared.error == SealedRichPrepareError::TooLarge) {
+			return Block(history, Lower(u"Encrypted messages support up to 64 parts. Shorten the text or formatting."_q));
+		} else if (prepared.error == SealedRichPrepareError::QueueFull) {
+			return Block(history, Lower(u"Wait for the queued encrypted messages to finish."_q));
+		}
+		return Block(history, Lower(u"Encryption is unavailable. Nothing was sent."_q));
+	}
+	message = std::move(*prepared.first);
+	return false;
+}
+
+bool AuthorizeSealedTextSend(Api::MessageToSend &message) {
+	if (!SealedDraftsMemoryOnly(message.action.history)) return true;
+	const auto keys = SealedAutomaticKeys(message.action.history, SealedKeyPurpose::Send);
+	if (!keys || !OptionsAllowed(message.action)) return false;
+	const auto context = SealedContext(&message.action.history->session(),
+		message.action.history->session().userId().bare,
+		peerToUser(message.action.history->peer->id).bare);
+	auto valid = false;
+	if (const auto envelope = ParseSealedEnvelope(message.textWithTags.text)) {
+		auto plain = SealedDecrypt(keys->identity.privateKey, keys->identity.publicKey, *envelope, context);
+		if (plain) {
+			OPENSSL_cleanse(plain->data(), size_t(plain->size()));
+			valid = true;
+		}
+	} else if (auto part = DecryptSealedRichPart(keys->identity.privateKey,
+		keys->identity.publicKey, message.textWithTags.text, context)) {
+		OPENSSL_cleanse(part->bytes.data(), size_t(part->bytes.size()));
+		valid = true;
+	}
+	if (!valid) return false;
+	auto candidate = message;
+	Strip(candidate);
+	if (!Remember(candidate, *keys)) return false;
+	message = std::move(candidate);
+	return true;
+}
+
+bool SealedPreparedSendAllowed(
+		not_null<History*> history,
+		const Data::Histories::PreparedMessage &request) {
+	if (!SealedDraftsMemoryOnly(history)) {
+		return true;
+	}
+	Prune();
+	return v::match(request, [&](const MTPmessages_SendMessage &text) {
+		return AllowedTextRequest(history, text);
+	}, [&](const MTPmessages_SendMedia &media) {
+		return AllowedMediaRequest(history, media);
+	}, [](const auto &) { return false; });
+}
+
+bool BlockSealedUnsupported(not_null<History*> history) {
+	return SealedDraftsMemoryOnly(history)
+		&& Block(history, Lower(u"This send type is unavailable while automatic encryption is on."_q));
+}
+
+bool SealedSendOptionsAllowed(const Api::SendAction &action) {
+	return OptionsAllowed(action);
+}
+
+bool HasSealedFileContentAuthorization(
+		not_null<History*> history,
+		const QByteArray &content) {
+	Prune();
+	const auto digest = Digest(content);
+	return ranges::any_of(Get().proofs, [&](const Proof &proof) {
+		return SealedSendFileContentMatches(proof.stamp, digest) && Current(proof, history);
+	});
+}
+
+bool AuthorizeSealedFileContent(not_null<History*> history, const QByteArray &content) {
+	if (!SealedDraftsMemoryOnly(history)) {
+		return true;
+	}
+	const auto keys = SealedAutomaticKeys(history, SealedKeyPurpose::Send);
+	if (!keys || content.isEmpty()) {
+		return false;
+	}
+	Prune();
+	if (Get().proofs.size() >= size_t(kProofLimit)) return false;
+	Get().proofs.push_back({
+		.history = base::make_weak(history),
+		.stamp = {
+			.account = history->session().uniqueId(), .chat = history->peer->id.value,
+			.digest = Digest(content), .own = keys->identity.publicKey, .peer = keys->peerKey,
+			.epoch = SealedAutomaticEpoch(), .when = crl::now(), .file = true,
+		},
+	});
+	return true;
+}
+
+bool SealedFilesAllowed(
+		not_null<History*> history,
+		const Ui::PreparedList &list,
+		const Api::SendAction &action) {
+	if (!SealedDraftsMemoryOnly(history)) {
+		return true;
+	}
+	Prune();
+	if (!OptionsAllowed(action) || action.replyTo || list.files.size() != 1) {
+		BlockSealedUnsupported(history);
+		return false;
+	}
+	const auto &file = list.files.front();
+	const auto digest = Digest(file.content);
+	const auto allowed = file.path.isEmpty() && !file.content.isEmpty()
+		&& file.caption.text.isEmpty() && file.caption.tags.isEmpty()
+		&& file.displayName == u"message.teleenc"_q
+		&& ranges::any_of(Get().proofs, [&](const Proof &proof) {
+			return SealedSendFileContentMatches(proof.stamp, digest) && Current(proof, history);
+		});
+	if (!allowed) {
+		BlockSealedUnsupported(history);
+	}
+	return allowed;
+}
+
+bool SealedConfirmedFileAllowed(
+		not_null<Main::Session*> session,
+		const std::shared_ptr<FilePrepareResult> &file) {
+	const auto history = session->data().history(file->to.peer);
+	if (!SealedDraftsMemoryOnly(history)) {
+		return true;
+	}
+	Prune();
+	const auto digest = Digest(file->content);
+	const auto canonicalDocument = file->document.match([&](const MTPDdocument &document) {
+		return document.vid().v == file->id
+			&& document.vsize().v == file->content.size()
+			&& qs(document.vmime_type()) == u"application/octet-stream"_q
+			&& document.vattributes().v.size() == 1
+			&& document.vattributes().v.front().match([](const MTPDdocumentAttributeFilename &attribute) {
+				return qs(attribute.vfile_name()) == u"message.teleenc"_q;
+			}, [](const auto &) { return false; });
+	}, [](const auto &) { return false; });
+	if (file->type != SendMediaType::File || !canonicalDocument
+		|| !file->filepath.isEmpty() || file->filemime != u"application/octet-stream"_q
+		|| file->filesize != file->content.size()
+		|| !file->caption.text.isEmpty() || !file->caption.tags.isEmpty()
+		|| file->videoCover || !file->attachedStickers.empty()
+		|| file->thumbId || !file->thumbbytes.isEmpty() || file->to.replyTo
+		|| !file->album.expired()) {
+		BlockSealedUnsupported(history);
+		return false;
+	}
+	for (auto &proof : Get().proofs) {
+		if (SealedSendFileContentMatches(proof.stamp, digest) && Current(proof, history)
+			&& PrepareSealedFileUpload(proof.stamp, digest, file->id, file->filename)) {
+			return true;
+		}
+	}
+	BlockSealedUnsupported(history);
+	return false;
+}
+
+}
