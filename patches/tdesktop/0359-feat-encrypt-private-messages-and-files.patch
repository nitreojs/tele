+
+constexpr auto kCiphertextLimit = qsizetype(34 * 1024 * 1024);
+constexpr auto kDownloadTimeout = crl::time(90 * 1000);
+
+void Cleanse(QByteArray &bytes) {
+	if (!bytes.isEmpty()) {
+		OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+		bytes.clear();
+	}
+}
+
+struct Source {
+	QString path;
+	QString name;
+	QByteArray remote;
+
+	~Source() {
+		Cleanse(remote);
+	}
+};
+
+struct SendState {
+	Source source;
+	bool active = true;
+	bool busy = false;
+
+	~SendState() {
+		Cleanse(source.remote);
+	}
+};
+
+struct PlainFile {
+	std::optional<SealedFilePayload> file;
+
+	~PlainFile() {
+		if (file) {
+			Cleanse(file->bytes);
+		}
+	}
+};
+
+struct OpenState {
+	std::shared_ptr<PlainFile> plain;
+	std::shared_ptr<Data::DocumentMedia> media;
+	std::shared_ptr<QTemporaryDir> temporary;
+	QString path;
+	QByteArray pending;
+	bool active = true;
+	bool processing = false;
+	bool ownDownload = false;
+};
+
+[[nodiscard]] std::optional<QByteArray> ReadFile(
+		const QString &path,
+		qsizetype limit) {
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly) || file.size() < 0 || file.size() > limit) {
+		return std::nullopt;
+	}
+	auto bytes = file.read(limit + 1);
+	if (file.error() == QFileDevice::NoError
+		&& file.atEnd()
+		&& bytes.size() <= limit) {
+		return bytes;
+	}
+	Cleanse(bytes);
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<QByteArray> PrepareUpload(
+		Source source,
+		bool sanitize,
+		const SealedContactKeys &keys,
+		const QByteArray &context) {
+	auto bytes = source.path.isEmpty()
+		? std::make_optional(std::move(source.remote))
+		: ReadFile(source.path, kSealedFilePayloadLimit);
+	if (!bytes) {
+		return std::nullopt;
+	}
+	const auto cleanse = gsl::finally([&] { Cleanse(*bytes); });
+	const auto photo = sanitize
+		&& QMimeDatabase().mimeTypeForData(*bytes).name().startsWith(u"image/"_q);
+	auto payload = PrepareSealedFilePayload(source.name, *bytes, photo);
+	if (!payload) {
+		return std::nullopt;
+	}
+	const auto clear = gsl::finally([&] { Cleanse(*payload); });
+	return SealedEncryptFile(
+		keys.identity.privateKey,
+		keys.peerKey,
+		*payload,
+		context);
+}
+
+[[nodiscard]] bool CanSendFile(
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer) {
+	if (peer->starsPerMessageChecked() > 0) {
+		controller->showToast(Lower(u"Encrypted files are unavailable in chats that charge for messages."_q));
+		return false;
+	} else if (!Data::CanSendTexts(peer)
+		|| !Data::CanSend(peer, ChatRestriction::SendFiles)) {
+		controller->showToast(Lower(u"You cannot send encrypted files to this chat."_q));
+		return false;
+	}
+	return true;
+}
+
+void Upload(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer,
+		const QByteArray &identityPublic,
+		const QByteArray &peerPublic,
+		QByteArray ciphertext) {
+	if (!CanSendFile(controller, peer)) {
+		return;
+	}
+	const auto current = SealedKeys(controller, peer, SealedKeyPurpose::Send);
+	if (!current || current->identity.publicKey != identityPublic
+		|| current->peerKey != peerPublic) {
+		controller->showToast(Lower(u"The encryption keys changed. Choose the file again."_q));
+		return;
+	}
+	auto list = Ui::PreparedList();
+	if (!AuthorizeSealedFileContent(controller->session().data().history(peer), ciphertext)) {
+		controller->showToast(Lower(u"Wait for the queued encrypted messages to finish."_q));
+		return;
+	}
+	auto file = Ui::PreparedFile(QString());
+	file.content = std::move(ciphertext);
+	file.size = file.content.size();
+	file.displayName = u"message.teleenc"_q;
+	file.type = Ui::PreparedFile::Type::File;
+	list.files.push_back(std::move(file));
+	auto action = Api::SendAction(controller->session().data().history(peer));
+	action.clearDraft = false;
+	controller->session().api().sendFiles(
+		std::move(list),
+		SendMediaType::File,
+		nullptr,
+		action);
+	box->closeBox();
+}
+
+void AddFileAction(
+		not_null<Ui::GenericBox*> box,
+		QString text,
+		const style::icon *icon,
+		Fn<void()> callback) {
+	const auto button = box->addRow(Settings::CreateButtonWithIcon(
+		box,
+		rpl::single(std::move(text)),
+		st::settingsButton,
+		{ .icon = icon }), style::margins(), style::al_justify);
+	button->setFocusPolicy(Qt::TabFocus);
+	button->setAllowTextLines(0);
+	button->setClickedCallback(std::move(callback));
+}
+
+void SendBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer) {
+	const auto session = &controller->session();
+	const auto state = std::make_shared<SendState>();
+	const auto weak = base::make_weak(box);
+	const auto controllerWeak = base::make_weak(controller);
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Encrypted file"_q)));
+	const auto label = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Choose a file to encrypt."_q),
+		st::boxLabel));
+	label->setBreakEverywhere(true);
+	const auto sanitize = box->addRow(object_ptr<Ui::Checkbox>(
+		box,
+		Lower(u"Remove metadata from photos"_q),
+		true));
+	sanitize->setAllowTextLines(0);
+	sanitize->setFocusPolicy(Qt::TabFocus);
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Photos become PNG files; encrypted payloads are limited to 16 MiB."_q),
+		st::boxLabel));
+	const auto clear = [=] {
+		state->active = false;
+		Cleanse(state->source.remote);
+		state->source.path.clear();
+		state->source.name.clear();
+	};
+	GuardSealedBox(box, session, clear);
+	box->boxClosing() | rpl::on_next(clear, box->lifetime());
+	AddFileAction(box, Lower(u"Choose file..."_q), &st::menuIconFile, [=] {
+		if (!state->active || state->busy) {
+			return;
+		}
+		FileDialog::GetOpenPath(
+			box.get(),
+			Lower(u"Choose a file to encrypt"_q),
+			FileDialog::AllOrImagesFilter(),
+			crl::guard(box, [=](FileDialog::OpenResult &&result) {
+				if (!state->active || state->busy
+					|| (result.paths.isEmpty() && result.remoteContent.isEmpty())) {
+					return;
+				}
+				Cleanse(state->source.remote);
+				state->source.path = result.paths.isEmpty()
+					? QString()
+					: result.paths.front();
+				state->source.name = state->source.path.isEmpty()
+					? u"file.bin"_q
+					: QFileInfo(state->source.path).fileName();
+				state->source.remote = std::move(result.remoteContent);
+				label->setText(state->source.name);
+			}));
+	});
+	AddFileAction(box, Lower(u"Encrypt and send"_q), &st::menuIconSend, [=] {
+		if (!state->active || state->busy) {
+			return;
+		} else if (state->source.path.isEmpty() && state->source.remote.isEmpty()) {
+			controller->showToast(Lower(u"Choose a file first."_q));
+			return;
+		}
+		if (!CanSendFile(controller, peer)) {
+			return;
+		}
+		auto keys = SealedKeys(controller, peer, SealedKeyPurpose::Send);
+		if (!keys) {
+			return;
+		}
+		const auto context = SealedContext(
+			session,
+			session->userId().bare,
+			peerToUser(peer->id).bare);
+		const auto source = state->source;
+		const auto identityPublic = keys->identity.publicKey;
+		const auto peerPublic = keys->peerKey;
+		const auto strip = sanitize->checked();
+		state->busy = true;
+		box->showLoading(true);
+		crl::async([=, keys = std::move(*keys)] {
+			auto ciphertext = PrepareUpload(source, strip, keys, context);
+			crl::on_main(weak, [=, ciphertext = std::move(ciphertext)]() mutable {
+				const auto strong = weak.get();
+				const auto window = controllerWeak.get();
+				if (!strong || !window || !state->active) {
+					return;
+				}
+				state->busy = false;
+				strong->showLoading(false);
+				if (!ciphertext) {
+					window->showToast(Lower(u"The file could not be read, sanitized or encrypted within the size limit."_q));
+					return;
+				}
+				Upload(
+					strong,
+					window,
+					peer,
+					identityPublic,
+					peerPublic,
+					std::move(*ciphertext));
+			});
+		});
+	});
+	box->addButton(rpl::single(Lower(u"Cancel"_q)), [=] { box->closeBox(); });
+}
+
+[[nodiscard]] std::optional<QByteArray> AvailableCiphertext(
+		not_null<DocumentData*> document,
+		const std::shared_ptr<OpenState> &state) {
+	const auto bytes = state->media->bytes();
+	if (!bytes.isEmpty()) {
+		return bytes.size() <= kCiphertextLimit
+			? std::make_optional(bytes)
+			: std::nullopt;
+	}
+	if (!state->path.isEmpty()) {
+		if (auto bytes = ReadFile(state->path, kCiphertextLimit)) {
+			return bytes;
+		}
+	}
+	const auto &location = document->location(true);
+	if (!location.isEmpty() && location.accessEnable()) {
+		const auto guard = gsl::finally([&] { location.accessDisable(); });
+		return ReadFile(location.name(), kCiphertextLimit);
+	}
+	return std::nullopt;
+}
+
+void ShowPlainFile(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		const std::shared_ptr<OpenState> &state,
+		not_null<Ui::FlatLabel*> label) {
+	const auto &file = *state->plain->file;
+	label->setText(Lower(Plural(
+		u"Decrypted file: %1 (%2 byte)."_q,
+		u"Decrypted file: %1 (%2 bytes)."_q,
+		file.bytes.size()))
+		.arg(file.name)
+		.arg(file.bytes.size()));
+	box->clearButtons();
+	AddFileAction(box, Lower(u"Save decrypted file..."_q), &st::menuIconDownload, [=] {
+		if (!state->active || !state->plain || !state->plain->file) {
+			return;
+		}
+		FileDialog::GetWritePath(
+			box.get(),
+			Lower(u"Save decrypted file"_q),
+			FileDialog::AllFilesFilter(),
+			state->plain->file->name,
+			crl::guard(box, [=](QString &&path) {
+				if (path.isEmpty() || !state->active || !state->plain) {
+					return;
+				}
+				auto output = QSaveFile(path);
+				const auto &bytes = state->plain->file->bytes;
+				if (!output.open(QIODevice::WriteOnly)
+					|| output.write(bytes) != bytes.size()
+					|| !output.commit()) {
+					controller->showToast(Lower(u"The decrypted file could not be saved."_q));
+					return;
+				}
+				Platform::File::PostprocessDownloaded(path);
+				controller->showToast(Lower(u"Decrypted file saved."_q));
+			}));
+	});
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+}
+
+void OpenBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		FullMsgId itemId) {
+	const auto session = &controller->session();
+	const auto item = session->data().message(itemId);
+	const auto peer = item ? item->history()->peer->asUser() : nullptr;
+	const auto document = item && item->media() ? item->media()->document() : nullptr;
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Encrypted file"_q)));
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] { box->closeBox(); });
+	if (!peer || !document || !SealedPeerAllowed(peer)
+		|| document->size <= 0 || document->size > kCiphertextLimit
+		|| document->hasWebLocation() || !document->hasRemoteLocation()) {
+		controller->showToast(Lower(u"This encrypted file is unavailable or too large."_q));
+		box->closeBox();
+		return;
+	}
+	const auto from = item->from()->id;
+	const auto outgoing = from == session->userPeerId();
+	if (!outgoing && from != peer->id) {
+		box->closeBox();
+		return;
+	}
+	auto keys = SealedKeys(controller, peer, outgoing
+		? SealedKeyPurpose::ReadOwn
+		: SealedKeyPurpose::ReadIncoming);
+	if (!keys) {
+		box->closeBox();
+		return;
+	}
+	const auto context = SealedContext(
+		session,
+		outgoing ? session->userId().bare : peerToUser(peer->id).bare,
+		outgoing ? peerToUser(peer->id).bare : session->userId().bare);
+	const auto expected = outgoing ? keys->identity.publicKey : keys->peerKey;
+	const auto epoch = SealedAutomaticEpoch();
+	const auto state = std::make_shared<OpenState>();
+	state->media = document->createMediaView();
+	const auto weak = base::make_weak(box);
+	const auto controllerWeak = base::make_weak(controller);
+	const auto sessionWeak = base::make_weak(session);
+	const auto label = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Loading the encrypted file..."_q),
+		st::boxLabel));
+	label->setBreakEverywhere(true);
+	const auto clear = [=] {
+		if (!state->active) {
+			return;
+		}
+		state->active = false;
+		state->plain.reset();
+		state->pending.clear();
+		if (sessionWeak && state->ownDownload
+			&& document->loadingFilePath() == state->path) {
+			document->cancel();
+		}
+		state->temporary.reset();
+		label->setText(QString());
+	};
+	GuardSealedBox(box, session, clear);
+	box->boxClosing() | rpl::on_next(clear, box->lifetime());
+	SealedAutomaticChanges() | rpl::on_next([=] {
+		if (SealedAutomaticEpoch() != epoch) box->closeBox();
+	}, box->lifetime());
+	const auto decrypt = [=](QByteArray ciphertext) {
+		if (!state->active || state->processing) {
+			return;
+		}
+		if (SealedAutomaticEpoch() != epoch) return;
+		auto permit = TrySealedDecryptJob();
+		if (!permit) {
+			state->pending = std::move(ciphertext);
+			box->showLoading(true);
+			return;
+		}
+		state->pending.clear();
+		state->processing = true;
+		box->showLoading(true);
+		crl::async([=, keys = *keys, ciphertext = std::move(ciphertext), permit = std::move(permit)] {
+			auto plain = SealedDecryptFile(
+				keys.identity.privateKey,
+				expected,
+				ciphertext,
+				context);
+			auto result = std::make_shared<PlainFile>();
+			if (plain) {
+				const auto cleanse = gsl::finally([&] { Cleanse(*plain); });
+				result->file = OpenSealedFilePayload(*plain);
+			}
+			crl::on_main(weak, [=] {
+				const auto strong = weak.get();
+				const auto window = controllerWeak.get();
+				if (!strong || !window || !state->active || SealedAutomaticEpoch() != epoch) {
+					return;
+				}
+				strong->showLoading(false);
+				if (!result->file) {
+					label->setText(Lower(u"The file could not be authenticated or decrypted with these keys."_q));
+					return;
+				}
+				state->plain = result;
+				ShowPlainFile(strong, window, state, label);
+			});
+		});
+	};
+	SealedDecryptJobsChanges() | rpl::on_next([=] {
+		if (state->active && !state->processing && !state->pending.isEmpty()) {
+			decrypt(std::exchange(state->pending, QByteArray()));
+		}
+	}, box->lifetime());
+	if (auto bytes = AvailableCiphertext(document, state)) {
+		decrypt(std::move(*bytes));
+		return;
+	}
+	const auto downloaded = [=] {
+		if (!state->active || state->processing || !state->pending.isEmpty() || document->loading()) {
+			return;
+		}
+		if (auto bytes = AvailableCiphertext(document, state)) {
+			decrypt(std::move(*bytes));
+		} else {
+			label->setText(Lower(u"The encrypted file could not be downloaded."_q));
+		}
+	};
+	session->downloaderTaskFinished(
+	) | rpl::on_next(downloaded, box->lifetime());
+	if (!document->loading()) {
+		state->temporary = std::make_shared<QTemporaryDir>();
+		if (!state->temporary->isValid()) {
+			label->setText(Lower(u"A temporary encrypted download could not be created."_q));
+			return;
+		}
+		state->path = state->temporary->filePath(u"message.teleenc"_q);
+		state->ownDownload = true;
+		document->save(Data::FileOriginMessage(itemId), state->path);
+		downloaded();
+	}
+	const auto timeout = box->lifetime().make_state<base::Timer>([=] {
+		if (state->active && !state->processing && state->pending.isEmpty()) {
+			state->processing = true;
+			if (state->ownDownload && document->loadingFilePath() == state->path) {
+				document->cancel();
+			}
+			label->setText(Lower(u"The encrypted download timed out. Open the file again to retry."_q));
+		}
+	});
+	timeout->callOnce(kDownloadTimeout);
+}
+
+}
+
+void ShowSealedFileSend(
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> peer) {
+	if (SealedPeerAllowed(peer)
+		&& CanSendFile(controller, peer)
+		&& SealedKeys(controller, peer, SealedKeyPurpose::Send)) {
+		controller->show(Box(SendBox, controller, peer));
+	}
+}
+
+void ShowSealedFileOpen(
+		not_null<Window::SessionController*> controller,
+		not_null<HistoryItem*> item) {
+	controller->show(Box(OpenBox, controller, item->fullId()));
+}
+
