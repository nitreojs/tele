diff --git a/Telegram/SourceFiles/tele/tele_sealed_view.cpp b/Telegram/SourceFiles/tele/tele_sealed_view.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1845b17252f220915bd7d8c3b0544db988248f68
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_view.cpp
@@ -0,0 +1,541 @@
+#include "tele/tele_sealed_view.h"
+
+#include "tele/tele_sealed_view_cache.h"
+#include "tele/tele_sealed_media.h"
+#include "tele/tele_sealed_media_cache.h"
+#include "tele/tele_sealed_parts.h"
+#include "tele/tele_sealed_jobs.h"
+
+#include "base/weak_ptr.h"
+#include "core/application.h"
+#include "crl/crl_on_main.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "history/view/history_view_element.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_sealed_auto.h"
+#include "tele/tele_sealed_crypto.h"
+#include "ui/chat/chat_style.h"
+#include "ui/painter.h"
+#include "ui/text/text_entity.h"
+#include "window/window_session_controller.h"
+#include "styles/style_chat.h"
+#include "styles/style_chat_style.h"
+
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDataStream>
+
+#include <algorithm>
+#include <set>
+
+namespace Tele {
+namespace {
+
+constexpr auto kViewLimit = 256;
+constexpr auto kTokenLimit = 4096;
+
+struct ViewRecord {
+	base::weak_ptr<HistoryView::Element> view;
+	FullMsgId id;
+	quint64 touched = 0;
+	bool applied = false;
+	bool populated = false;
+	bool protectedText = false;
+	QByteArray displayKey;
+};
+
+struct CacheRecord {
+	FullMsgId id;
+	details::SealedViewProof proof;
+};
+
+struct Candidate {
+	details::SealedViewProof proof;
+	SealedContactKeys keys;
+};
+
+struct PlainResult {
+	QByteArray bytes;
+	bool valid = false;
+
+	~PlainResult() {
+		if (!bytes.isEmpty()) {
+			OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+		}
+	}
+};
+
+class SessionViews;
+std::map<Main::Session*, SessionViews*> Sessions;
+bool Clearing = false;
+quint64 NextInstance = 0;
+
+void PumpAll();
+
+[[nodiscard]] bool EnvelopeItem(HistoryItem *item) {
+	if (!item || item->isService() || item->media()
+		|| item->Get<HistoryMessageForwarded>()
+		|| !item->history()->peer->asUser()
+		|| !item->computeUnavailableReason().isEmpty()) {
+		return false;
+	}
+	const auto &text = item->originalText().text;
+	return text.size() <= kTokenLimit && text.startsWith(u"tele-sealed:v1:"_q);
+}
+
+[[nodiscard]] bool ViewContext(const HistoryView::Element *view) {
+	using Context = HistoryView::Context;
+	return view->context() == Context::History
+		|| view->context() == Context::Replies
+		|| view->context() == Context::Pinned
+		|| view->context() == Context::SavedSublist;
+}
+
+[[nodiscard]] std::optional<Candidate> Current(HistoryItem *item) {
+	if (Clearing || Core::Quitting() || !item
+		|| !SealedAutomaticSelected(item->history()) || !EnvelopeItem(item)) {
+		return std::nullopt;
+	}
+	const auto session = &item->history()->session();
+	const auto peer = item->history()->peer->asUser();
+	const auto from = item->from()->id;
+	const auto own = from == session->userPeerId();
+	if (!own && from != peer->id) {
+		return std::nullopt;
+	}
+	const auto epoch = SealedAutomaticEpoch();
+	auto keys = SealedAutomaticKeys(item->history(), own
+		? SealedKeyPurpose::ReadOwn
+		: SealedKeyPurpose::ReadIncoming);
+	if (!keys || !epoch || epoch != SealedAutomaticEpoch()) {
+		return std::nullopt;
+	}
+	auto proof = details::SealedViewProof{
+		.epoch = epoch,
+		.cipherDigest = QCryptographicHash::hash(item->originalText().text.toUtf8(), QCryptographicHash::Sha256),
+		.ownPublic = keys->identity.publicKey,
+		.expectedPublic = own ? keys->identity.publicKey : keys->peerKey,
+		.context = SealedContext(session,
+			own ? session->userId().bare : peerToUser(peer->id).bare,
+			own ? peerToUser(peer->id).bare : session->userId().bare),
+	};
+	return Candidate{ std::move(proof), std::move(*keys) };
+}
+
+[[nodiscard]] QByteArray CacheKey(FullMsgId id, const details::SealedViewProof &proof) {
+	auto bytes = QByteArray();
+	QDataStream stream(&bytes, QIODevice::WriteOnly);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << quint64(id.peer.value) << qint64(id.msg.bare) << proof.epoch;
+	bytes += proof.cipherDigest;
+	bytes += proof.ownPublic;
+	bytes += proof.expectedPublic;
+	bytes += proof.context;
+	return QCryptographicHash::hash(bytes, QCryptographicHash::Sha256);
+}
+
+class SessionViews final {
+public:
+	explicit SessionViews(not_null<Main::Session*> value)
+	: session(value)
+	, instance(++NextInstance) {
+		Sessions.emplace(session, this);
+		session->data().itemVisibilitiesUpdates() | rpl::on_next([=] { schedule(); }, lifetime);
+		session->data().itemRemoved() | rpl::on_next([=](not_null<const HistoryItem*> item) {
+			forget(item->fullId());
+		}, lifetime);
+		session->data().viewRemoved() | rpl::on_next([=](not_null<const HistoryView::Element*> view) {
+			views.erase(view);
+			schedule();
+		}, lifetime);
+		session->data().sessionDataAboutToBeCleared() | rpl::on_next([=] { clear(); }, lifetime);
+		session->data().itemIdChanged() | rpl::on_next([=] { clear(); schedule(); }, lifetime);
+		SealedAutomaticChanges() | rpl::on_next([=] { schedule(); }, lifetime);
+		SealedDecryptJobsChanges() | rpl::on_next([=] { schedule(); }, lifetime);
+		const auto weak = base::make_weak(session.get());
+		const auto token = instance;
+		crl::on_main(session, [=] {
+			const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+			if (i == Sessions.end() || i->second->instance != token) {
+				return;
+			}
+			Core::App().passcodeLockChanges() | rpl::on_next([=](bool locked) {
+				if (locked) clear();
+			}, lifetime);
+			Core::App().domain().activeSessionChanges() | rpl::on_next([=](Main::Session *active) {
+				if (active != session) clear();
+			}, lifetime);
+			session->account().sessionChanges() | rpl::on_next([=](Main::Session *active) {
+				if (active != session) clear();
+			}, lifetime);
+		});
+	}
+
+	~SessionViews() {
+		Sessions.erase(session);
+	}
+
+	void reset(FullMsgId id) {
+		auto pending = std::vector<base::weak_ptr<HistoryView::Element>>();
+		for (auto &[pointer, record] : views) {
+			if (record.id == id && record.view) {
+				record.applied = false;
+				pending.push_back(record.view);
+			}
+		}
+		for (const auto &view : pending) {
+			if (view) {
+				view->itemTextUpdated();
+				if (view) session->data().requestViewResize(view.get());
+			}
+		}
+	}
+
+	void clear() {
+		const auto previous = Clearing;
+		Clearing = true;
+		const auto restore = gsl::finally([=] { Clearing = previous; });
+		++serial;
+		cache.clear();
+		entries.clear();
+		attempted.clear();
+		inflight.clear();
+		auto pending = std::vector<base::weak_ptr<HistoryView::Element>>();
+		for (auto &[pointer, record] : views) {
+			if (record.populated && record.view) {
+				record.applied = false;
+				pending.push_back(record.view);
+			}
+		}
+		for (const auto &view : pending) {
+			if (view) {
+				view->itemTextUpdated();
+				if (view) session->data().requestViewResize(view.get());
+			}
+		}
+	}
+
+	void forget(FullMsgId id) {
+		for (auto i = entries.begin(); i != entries.end();) {
+			if (i->second.id == id) {
+				cache.erase(i->first);
+				attempted.erase(i->first);
+				i = entries.erase(i);
+			} else {
+				++i;
+			}
+		}
+		reset(id);
+		std::erase_if(attempted, [&](const auto &entry) { return entry.second == id; });
+		std::erase_if(views, [&](const auto &entry) { return entry.second.id == id; });
+	}
+
+	void touch(HistoryView::Element *view) {
+		auto &record = views[view];
+		record.view = base::make_weak(view);
+		record.id = view->data()->fullId();
+		record.touched = ++clock;
+		while (views.size() > size_t(kViewLimit)) {
+			const auto old = std::min_element(views.begin(), views.end(), [](const auto &a, const auto &b) {
+				return a.second.touched < b.second.touched;
+			});
+			const auto expired = old->second;
+			views.erase(old);
+			if (expired.populated && expired.view) {
+				expired.view->itemTextUpdated();
+				if (expired.view) session->data().requestViewResize(expired.view.get());
+			}
+		}
+		schedule();
+	}
+
+	[[nodiscard]] bool visible(FullMsgId id) {
+		return std::any_of(views.begin(), views.end(), [&](const auto &entry) {
+			const auto view = entry.second.view.get();
+			return view && entry.second.id == id && ViewContext(view)
+				&& session->data().queryItemVisibility(view->data(), view);
+		});
+	}
+
+	void schedule() {
+		if (queued || Clearing) return;
+		queued = true;
+		const auto weak = base::make_weak(session.get());
+		const auto token = instance;
+		crl::on_main(session, [=] {
+			const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+			if (i != Sessions.end() && i->second->instance == token) {
+				i->second->queued = false;
+				PumpAll();
+			}
+		});
+	}
+
+	void pump() {
+		if (Clearing || Core::Quitting()) return;
+		std::erase_if(views, [](const auto &entry) { return !entry.second.view; });
+		auto obsolete = std::vector<std::pair<QByteArray, FullMsgId>>();
+		for (const auto &[key, entry] : entries) {
+			const auto item = session->data().message(entry.id);
+			const auto current = item ? Current(item) : std::nullopt;
+			if (!current || !entry.proof.matches(current->proof) || !visible(entry.id)) {
+				obsolete.emplace_back(key, entry.id);
+			}
+		}
+		for (const auto &[key, id] : obsolete) {
+			cache.erase(key);
+			attempted.erase(key);
+			entries.erase(key);
+			reset(id);
+		}
+		for (auto i = attempted.begin(); i != attempted.end();) {
+			i = !visible(i->second) ? attempted.erase(i) : std::next(i);
+		}
+
+		if (!SealedDecryptJobAvailable()) return;
+		auto checked = std::set<FullMsgId>();
+		for (const auto &[pointer, record] : views) {
+			const auto view = record.view.get();
+			if (!view || !ViewContext(view)
+				|| !session->data().queryItemVisibility(view->data(), view)) continue;
+			if (!checked.insert(record.id).second) continue;
+			auto candidate = Current(view->data());
+			if (!candidate) continue;
+			const auto key = CacheKey(record.id, candidate->proof);
+			if (cache.find(key) || inflight.contains(key) || attempted.contains(key)) continue;
+			const auto envelope = ParseSealedEnvelope(view->data()->originalText().text);
+			auto permit = envelope ? TrySealedDecryptJob() : nullptr;
+			if (envelope && !permit) return;
+			std::erase_if(attempted, [&](const auto &entry) { return entry.second == record.id; });
+			attempted.emplace(key, record.id);
+			while (attempted.size() > size_t(kViewLimit)) attempted.erase(attempted.begin());
+			if (!envelope) continue;
+			const auto id = record.id;
+			const auto proof = candidate->proof;
+			const auto generation = serial;
+			const auto token = instance;
+			const auto weak = base::make_weak(session.get());
+			inflight.insert(key);
+			crl::async([weak, token, generation, id, key, proof, envelope = *envelope, keys = std::move(candidate->keys), permit = std::move(permit)] {
+				(void)permit;
+				auto result = std::make_shared<PlainResult>();
+				if (auto bytes = SealedDecrypt(keys.identity.privateKey, proof.expectedPublic, envelope, proof.context)) {
+					result->bytes = std::move(*bytes);
+					const auto text = QString::fromUtf8(result->bytes);
+					result->valid = text.toUtf8() == result->bytes;
+				}
+				crl::on_main([=] {
+					const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+					if (!Core::Quitting() && i != Sessions.end() && i->second->instance == token) {
+						const auto state = i->second;
+						state->inflight.erase(key);
+						const auto item = weak->data().message(id);
+						const auto current = item ? Current(item) : std::nullopt;
+						if (result->valid && generation == state->serial && current
+							&& proof.matches(current->proof) && state->visible(id)) {
+							const auto evicted = state->cache.put(key, result->bytes);
+							for (const auto &old : evicted) {
+								const auto entry = state->entries.find(old);
+								if (entry != state->entries.end()) {
+									const auto removed = entry->second.id;
+									state->entries.erase(entry);
+									state->reset(removed);
+								}
+							}
+							state->entries[key] = { id, proof };
+							state->reset(id);
+						}
+					}
+					if (!Core::Quitting()) PumpAll();
+				});
+			});
+			if (!SealedDecryptJobAvailable()) return;
+		}
+	}
+
+	not_null<Main::Session*> session;
+	quint64 instance = 0;
+	quint64 serial = 0;
+	quint64 clock = 0;
+	bool queued = false;
+	details::SealedViewPlaintextCache cache;
+	std::map<const HistoryView::Element*, ViewRecord> views;
+	std::map<QByteArray, CacheRecord> entries;
+	std::map<QByteArray, FullMsgId> attempted;
+	std::set<QByteArray> inflight;
+	rpl::lifetime lifetime;
+};
+
+void PumpAll() {
+	for (const auto &[session, state] : Sessions) {
+		state->pump();
+	}
+}
+
+[[nodiscard]] SessionViews &State(not_null<Main::Session*> session) {
+	const auto i = Sessions.find(session);
+	return i != Sessions.end() ? *i->second : *session->lifetime().make_state<SessionViews>(session);
+}
+
+[[nodiscard]] const QByteArray *Plain(const HistoryView::Element *view) {
+	if (Clearing || !view || !ViewContext(view)) return nullptr;
+	const auto i = Sessions.find(&view->history()->session());
+	if (i == Sessions.end() || !i->second->cache.size()) return nullptr;
+	const auto candidate = Current(view->data());
+	if (!candidate || !i->second->session->data().queryItemVisibility(view->data(), view)) return nullptr;
+	const auto key = CacheKey(view->data()->fullId(), candidate->proof);
+	const auto entry = i->second->entries.find(key);
+	return entry != i->second->entries.end() && entry->second.proof.matches(candidate->proof)
+		? i->second->cache.find(key)
+		: nullptr;
+}
+
+}
+
+void ClearSealedViews() {
+	if (Clearing) return;
+	Clearing = true;
+	ClearSealedPartsViews();
+	ClearSealedMediaCache();
+	for (const auto &[session, state] : Sessions) state->clear();
+	Clearing = false;
+}
+
+void TouchSealedView(const HistoryView::Element *view) {
+	if (!Clearing) TouchSealedPartsView(view);
+	if (Clearing || Core::Quitting() || !view || !ViewContext(view)
+		|| !SealedAutomaticSelected(view->history()) || !EnvelopeItem(view->data())) return;
+	State(&view->history()->session()).touch(const_cast<HistoryView::Element*>(view));
+}
+
+void ForgetSealedView(const HistoryView::Element *view) {
+	if (!view) return;
+	ForgetSealedMediaView(view);
+	ForgetSealedPartsView(view);
+	const auto i = Sessions.find(&view->history()->session());
+	if (i == Sessions.end()) return;
+	const auto record = i->second->views.find(view);
+	if (record == i->second->views.end()) return;
+	i->second->views.erase(record);
+	i->second->schedule();
+}
+
+void ResetSealedViewText(const HistoryView::Element *view) {
+	if (!view) return;
+	ResetSealedPartsViewText(view);
+	const auto i = Sessions.find(&view->history()->session());
+	if (i == Sessions.end()) return;
+	const auto record = i->second->views.find(view);
+	if (record == i->second->views.end()) return;
+	record->second.applied = false;
+	record->second.populated = false;
+	record->second.displayKey.clear();
+}
+
+bool UpdateSealedViewText(
+		HistoryView::Element *view,
+		const std::function<void(const TextWithEntities&)> &apply) {
+	if (UpdateSealedPartsViewText(view, apply)) return true;
+	if (!view || !ViewContext(view) || !SealedAutomaticSelected(view->history())
+		|| !EnvelopeItem(view->data())) {
+		if (view) {
+			const auto state = Sessions.find(&view->history()->session());
+			if (state != Sessions.end()) {
+				const auto record = state->second->views.find(view);
+				if (record != state->second->views.end()) record->second.protectedText = false;
+			}
+		}
+		return false;
+	}
+	if (Core::Quitting()) return false;
+	auto &state = State(&view->history()->session());
+	if (!Clearing) state.touch(view);
+	const auto found = state.views.find(view);
+	if (found == state.views.end()) return false;
+	auto &record = found->second;
+	const auto plain = Plain(view);
+	const auto version = QByteArray(plain ? "plain:" : "pending:")
+		+ QByteArray::number(SealedAutomaticEpoch())
+		+ QCryptographicHash::hash(view->data()->originalText().text.toUtf8(), QCryptographicHash::Sha256);
+	const auto changed = !record.populated || record.displayKey != version;
+	record.applied = plain != nullptr;
+	record.protectedText = true;
+	record.populated = true;
+	record.displayKey = version;
+	if (changed) {
+		apply(plain
+			? TextWithEntities{ QString::fromUtf8(*plain), {} }
+			: TextWithEntities{ Lower(u"Encrypted message"_q), {} });
+	}
+	return true;
+}
+
+bool SealedViewProtectsSelection(const HistoryView::Element *view) {
+	if (!view) return false;
+	if (SealedPartsProtectSelection(view)) return true;
+	if (ViewContext(view) && SealedAutomaticSelected(view->history()) && EnvelopeItem(view->data())) return true;
+	const auto i = Sessions.find(&view->history()->session());
+	if (i == Sessions.end()) return false;
+	const auto record = i->second->views.find(view);
+	return record != i->second->views.end() && record->second.protectedText;
+}
+
+bool SealedViewAuthenticated(const HistoryView::Element *view) {
+	return Plain(view) != nullptr || SealedPartsAuthenticated(view) || SealedMediaViewAuthenticated(view);
+}
+
+int SealedViewLockWidth(const HistoryView::Element *view) {
+	return SealedViewAuthenticated(view) ? st::historyTranscribeInLock.width() + st::msgDateSpace : 0;
+}
+
+void PaintSealedViewLock(
+		const HistoryView::Element *view,
+		Painter &p,
+		const Ui::ChatPaintContext &context,
+		int dateX,
+		int dateY,
+		int dateHeight,
+		int outerWidth) {
+	if (!SealedViewAuthenticated(view)) return;
+	const auto &icon = context.messageStyle()->historyTranscribeLock;
+	icon.paint(p, dateX - icon.width() - st::msgDateSpace,
+		dateY + (dateHeight - icon.height()) / 2, outerWidth);
+}
+
+bool HasSealedDecryptedText(HistoryItem *item) {
+	if (!item) return false;
+	if (HasSealedPartsDecryptedText(item)) return true;
+	const auto i = Sessions.find(&item->history()->session());
+	if (i == Sessions.end() || !i->second->cache.size() || !i->second->visible(item->fullId())) return false;
+	const auto candidate = Current(item);
+	if (!candidate) return false;
+	const auto key = CacheKey(item->fullId(), candidate->proof);
+	const auto entry = i->second->entries.find(key);
+	return entry != i->second->entries.end() && entry->second.proof.matches(candidate->proof)
+		&& i->second->cache.find(key);
+}
+
+bool CopySealedDecryptedText(Window::SessionController *controller, HistoryItem *item) {
+	if (!controller || !item || &controller->session() != &item->history()->session()) return false;
+	if (CopySealedPartsDecryptedText(controller, item)) return true;
+	const auto i = Sessions.find(&controller->session());
+	if (i == Sessions.end() || !i->second->cache.size() || !i->second->visible(item->fullId())) return false;
+	const auto candidate = Current(item);
+	if (!candidate) return false;
+	const auto key = CacheKey(item->fullId(), candidate->proof);
+	const auto entry = i->second->entries.find(key);
+	if (entry == i->second->entries.end() || !entry->second.proof.matches(candidate->proof)) return false;
+	const auto bytes = i->second->cache.find(key);
+	if (!bytes) return false;
+	TextUtilities::SetClipboardText(TextForMimeData::Simple(QString::fromUtf8(*bytes)));
+	return true;
+}
+
+}
