+std::map<QWidget*, std::shared_ptr<DialogSearch>> DialogsSearches;
+std::map<QWidget*, std::pair<QPointer<Ui::RpWidget>, base::weak_ptr<History>>> ComposeBars;
+
+void ClearField(QWidget *parent) {
+	const auto guard = QPointer<QWidget>(parent);
+	if (const auto field = dynamic_cast<Ui::InputField*>(parent)) {
+		const auto tracked = QPointer<Ui::InputField>(field);
+		field->setTextWithTags({}, Ui::InputField::HistoryAction::Clear);
+		if (tracked) tracked->rawTextEdit()->document()->clearUndoRedoStacks();
+	}
+	if (!guard) return;
+	auto children = std::vector<QPointer<QWidget>>();
+	for (const auto child : guard->children()) if (const auto widget = dynamic_cast<QWidget*>(child)) children.push_back(widget);
+	for (const auto &child : children) if (child) ClearField(child);
+}
