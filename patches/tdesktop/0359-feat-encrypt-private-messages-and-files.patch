+constexpr auto kCipherLimit = qsizetype(34 * 1024 * 1024);
+constexpr auto kImageBytes = qsizetype(64 * 1024 * 1024);
+constexpr auto kImageCount = 3;
+constexpr auto kViewCount = 128;
+constexpr auto kPipelineCount = 1;
+constexpr auto kDownloadTimeout = crl::time(90 * 1000);
+
+void Cleanse(QByteArray &bytes) {
+	if (!bytes.isEmpty()) OPENSSL_cleanse(bytes.data(), size_t(bytes.size()));
+	bytes.clear();
+}
+
+void Cleanse(QImage &image) {
+	if (!image.isNull()) OPENSSL_cleanse(image.bits(), size_t(image.sizeInBytes()));
+	image = QImage();
+}
+
+QByteArray Digest(const QByteArray &bytes) {
+	return QCryptographicHash::hash(bytes, QCryptographicHash::Sha256);
+}
+
+bool ContextAllowed(const HistoryView::Element *view) {
+	using Context = HistoryView::Context;
+	return view && (view->context() == Context::History
+		|| view->context() == Context::Replies || view->context() == Context::Pinned
+		|| view->context() == Context::SavedSublist);
+}
+
+struct Candidate {
+	DocumentData *document = nullptr;
+	QByteArray binding;
+	QByteArray expected;
+	QByteArray context;
+	SealedContactKeys keys;
+	quint64 epoch = 0;
+	qint64 declaredSize = 0;
+};
+
+class SessionMedia;
+std::map<Main::Session*, SessionMedia*> Sessions;
+bool Clearing = false;
+int Pipelines = 0;
+quint64 NextInstance = 0;
+quint64 ImageClock = 0;
+
+void PumpAll();
+void MakeRoom(qsizetype bytes);
+
+std::optional<Candidate> Current(HistoryItem *item) {
+	if (Clearing || Core::Quitting() || !item
+		|| !SealedAutomaticSelected(item->history()) || item->isService()
+		|| item->Get<HistoryMessageForwarded>() || item->groupId() || !item->originalText().empty()
+		|| !item->computeUnavailableReason().isEmpty()) return std::nullopt;
+	const auto peer = item->history()->peer->asUser();
+	const auto document = item->media() ? item->media()->document() : nullptr;
+	if (!peer || !document || document->filename() != u"message.teleenc"_q
+		|| document->mimeString() != u"application/octet-stream"_q
+		|| document->size <= 0 || document->size > kCipherLimit
+		|| document->hasWebLocation() || !document->hasRemoteLocation()) return std::nullopt;
+	const auto session = &item->history()->session();
+	const auto from = item->from()->id;
+	const auto own = from == session->userPeerId();
+	if (!own && from != peer->id) return std::nullopt;
+	const auto epoch = SealedAutomaticEpoch();
+	auto keys = SealedAutomaticKeys(item->history(), own
+		? SealedKeyPurpose::ReadOwn : SealedKeyPurpose::ReadIncoming);
+	if (!keys || !epoch || epoch != SealedAutomaticEpoch()) return std::nullopt;
+	const auto expected = own ? keys->identity.publicKey : keys->peerKey;
+	const auto context = SealedContext(session,
+		own ? session->userId().bare : peerToUser(peer->id).bare,
+		own ? peerToUser(peer->id).bare : session->userId().bare);
+	auto bytes = QByteArray();
+	QDataStream stream(&bytes, QIODevice::WriteOnly);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << quint64(session->uniqueId()) << quint64(item->fullId().peer.value)
+		<< qint64(item->id.bare) << quint64(document->id) << qint64(document->size)
+		<< epoch << keys->identity.publicKey << expected << context;
+	auto remote = mtpBuffer();
+	document->mtpInput().write(remote);
+	bytes.append(reinterpret_cast<const char*>(remote.constData()), remote.size() * sizeof(mtpPrime));
+	return Candidate{ document, Digest(bytes), expected, context, std::move(*keys), epoch, document->size };
+}
+
+struct Source {
+	QByteArray bytes;
+	QString path;
+	std::optional<Core::FileLocation> location;
+};
+
+std::optional<QByteArray> Read(Source source, qint64 declaredSize) {
+	if (!source.bytes.isEmpty()) {
+		return source.bytes.size() == declaredSize && source.bytes.size() <= kCipherLimit
+			? std::make_optional(std::move(source.bytes)) : std::nullopt;
+	}
+	if (source.location && !source.location->accessEnable()) return std::nullopt;
+	const auto disable = gsl::finally([&] {
+		if (source.location) source.location->accessDisable();
+	});
+	const auto before = QFileInfo(source.path);
+	if (!before.isFile() || before.size() != declaredSize || before.size() > kCipherLimit) return std::nullopt;
+	auto file = QFile(source.path);
+	if (!file.open(QIODevice::ReadOnly)) return std::nullopt;
+	auto bytes = file.read(kCipherLimit + 1);
+	const auto after = QFileInfo(source.path);
+	return file.error() == QFileDevice::NoError && file.atEnd()
+		&& bytes.size() == declaredSize && bytes.size() <= kCipherLimit
+		&& after.size() == before.size() && after.lastModified() == before.lastModified()
+		? std::make_optional(std::move(bytes)) : std::nullopt;
+}
+
+struct Job {
+	FullMsgId id;
+	DocumentId document = 0;
+	QByteArray binding;
+	std::shared_ptr<Data::DocumentMedia> media;
+	std::shared_ptr<QTemporaryDir> temporary;
+	QString path;
+	std::atomic_bool canceled = false;
+	crl::time started = 0;
+	bool ownDownload = false;
+	bool worker = false;
+	bool counted = true;
+};
+
+struct Result {
+	std::shared_ptr<SealedDecodedMedia> photo;
+	QByteArray nativeCipher;
+	QString sourcePath;
+	std::optional<Core::FileLocation> sourceLocation;
+	QDateTime sourceModified;
+	qint64 sourceSize = 0;
+	QByteArray cipherDigest;
+	bool authenticated = false;
+};
+
+Result Decode(const std::shared_ptr<Job> &job, Source source, Candidate candidate) {
+	auto result = Result();
+	if (job->canceled.load()) return result;
+	result.nativeCipher = source.bytes;
+	result.sourcePath = source.path;
+	result.sourceLocation = source.location;
+	auto cipher = Read(std::move(source), candidate.declaredSize);
+	if (!cipher || job->canceled.load()) return result;
+	result.cipherDigest = Digest(*cipher);
+	if (!result.sourcePath.isEmpty()) {
+		const auto enabled = !result.sourceLocation || result.sourceLocation->accessEnable();
+		const auto disable = gsl::finally([&] {
+			if (enabled && result.sourceLocation) result.sourceLocation->accessDisable();
+		});
+		if (!enabled) return result;
+		const auto info = QFileInfo(result.sourcePath);
+		result.sourceModified = info.lastModified();
+		result.sourceSize = info.size();
+	}
+	auto plain = SealedDecryptFile(candidate.keys.identity.privateKey, candidate.expected,
+		*cipher, candidate.context);
+	if (!plain) return result;
+	const auto clearPlain = gsl::finally([&] { Cleanse(*plain); });
+	if (job->canceled.load()) return result;
+	auto payload = OpenSealedFilePayload(*plain);
+	if (!payload) return result;
+	const auto clearPayload = gsl::finally([&] { Cleanse(payload->bytes); });
+	result.authenticated = true;
+	if (payload->presentation != SealedFilePresentation::Image || job->canceled.load()) return result;
+	if (payload->bytes.size() < 33 || uchar(payload->bytes[24]) > 8) return result;
+	auto buffer = QBuffer(&payload->bytes);
+	if (!buffer.open(QIODevice::ReadOnly)) return result;
+	auto reader = QImageReader(&buffer, "png");
+	reader.setAutoTransform(false);
+	if (reader.format().toLower() != "png" || !SealedMediaImageSizeAllowed(reader.size())
+		|| reader.imageCount() > 1 || job->canceled.load()) return result;
+	auto image = reader.read();
+	const auto clearImage = gsl::finally([&] { Cleanse(image); });
+	if (image.isNull() || !SealedMediaImageSizeAllowed(image.size()) || job->canceled.load()) return result;
+	if (image.format() != QImage::Format_ARGB32) {
+		auto converted = image.convertToFormat(QImage::Format_ARGB32);
+		Cleanse(image);
+		image = std::move(converted);
+	}
+	if (image.isNull() || image.sizeInBytes() > kImageBytes || job->canceled.load()) return result;
+	result.photo = std::make_shared<SealedDecodedMedia>();
+	result.photo->image = std::move(image);
+	result.photo->epoch = candidate.epoch;
+	result.photo->token = Digest(candidate.binding + result.cipherDigest);
+	return result;
+}
+
+struct ViewRecord {
+	base::weak_ptr<HistoryView::Element> view;
+	FullMsgId id;
+	quint64 touched = 0;
+};
+
+struct ImageRecord {
+	FullMsgId id;
+	QByteArray nativeCipher;
+	QString sourcePath;
+	std::optional<Core::FileLocation> sourceLocation;
+	QDateTime sourceModified;
+	qint64 sourceSize = 0;
+	QByteArray binding;
+	QByteArray cipherDigest;
+	std::shared_ptr<SealedDecodedMedia> photo;
+	std::shared_ptr<QTemporaryDir> temporary;
+	quint64 touched = 0;
+};
+
+bool SourceCurrent(const auto &record, not_null<DocumentData*> document) {
+	if (!record.nativeCipher.isEmpty()) {
+		if (const auto media = document->activeMediaView()) {
+			const auto bytes = media->bytes();
+			return bytes.isEmpty() || bytes.constData() == record.nativeCipher.constData()
+				|| bytes == record.nativeCipher;
+		}
+		return true;
+	} else if (!record.sourcePath.isEmpty()) {
+		if (record.sourceLocation && !record.sourceLocation->accessEnable()) return false;
+		const auto disable = gsl::finally([&] {
+			if (record.sourceLocation) record.sourceLocation->accessDisable();
+		});
+		const auto info = QFileInfo(record.sourcePath);
+		return info.isFile() && info.size() == record.sourceSize
+			&& info.lastModified() == record.sourceModified;
+	}
+	return false;
+}
+
+class SessionMedia final {
+public:
+	explicit SessionMedia(not_null<Main::Session*> value)
+	: session(value)
+	, instance(++NextInstance)
+	, timer([=] { schedule(); }) {
+		Sessions.emplace(session, this);
+		session->data().itemVisibilitiesUpdates() | rpl::on_next([=] { schedule(); }, lifetime);
+		session->downloaderTaskFinished() | rpl::on_next([=] { schedule(); }, lifetime);
+		session->data().viewRemoved() | rpl::on_next([=](not_null<const HistoryView::Element*> view) {
+			views.erase(view);
+			schedule();
+		}, lifetime);
+		session->data().itemRemoved() | rpl::on_next([=](not_null<const HistoryItem*>) { schedule(); }, lifetime);
+		session->data().itemIdChanged() | rpl::on_next([=] { clear(); schedule(); }, lifetime);
+		session->data().sessionDataAboutToBeCleared() | rpl::on_next([=] { clear(); usable = false; }, lifetime);
+		SealedAutomaticChanges() | rpl::on_next([=] { schedule(); }, lifetime);
+		SealedDecryptJobsChanges() | rpl::on_next([=] { schedule(); }, lifetime);
+		const auto weak = base::make_weak(session.get());
+		const auto token = instance;
+		crl::on_main(session, [=] {
+			const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+			if (i == Sessions.end() || i->second->instance != token) return;
+			Core::App().passcodeLockChanges() | rpl::on_next([=](bool locked) { if (locked) clear(); }, lifetime);
+			Core::App().domain().activeSessionChanges() | rpl::on_next([=](Main::Session *active) {
+				if (active != session) clear();
+			}, lifetime);
+			session->account().sessionChanges() | rpl::on_next([=](Main::Session *active) {
+				if (active != session) clear();
+			}, lifetime);
+		});
+	}
+
+	~SessionMedia() {
+		if (active) {
+			active->canceled.store(true);
+			if (!active->worker && active->counted) { --Pipelines; active->counted = false; }
+		}
+		Sessions.erase(session);
+	}
+
+	void refresh(FullMsgId id) {
+		if (!usable) return;
+		auto targets = std::vector<base::weak_ptr<HistoryView::Element>>();
+		for (const auto &[pointer, record] : views) {
+			if (record.id == id && record.view) targets.push_back(record.view);
+		}
+		for (const auto &view : targets) {
+			if (view) {
+				view->itemTextUpdated();
+				if (view) session->data().requestViewResize(view.get());
+			}
+		}
+	}
+
+	bool visible(FullMsgId id) const {
+		return ranges::any_of(views, [&](const auto &entry) {
+			const auto view = entry.second.view.get();
+			return view && entry.second.id == id && ContextAllowed(view)
+				&& session->data().queryItemVisibility(view->data(), view);
+		});
+	}
+
+	void stop() {
+		timer.cancel();
+		if (!active) return;
+		const auto job = std::exchange(active, nullptr);
+		job->canceled.store(true);
+		if (usable && job->ownDownload) {
+			const auto document = session->data().document(job->document);
+			if (document->loadingFilePath() == job->path) {
+				document->cancel();
+				document->resetCancelled();
+			}
+		}
+		if (!job->worker && job->counted) { --Pipelines; job->counted = false; }
+	}
+
+	void clear() {
+		stop();
+		ClearSealedMediaViews();
+		for (auto &[key, entry] : images) Cleanse(entry.photo->image);
+		images.clear();
+		attempted.clear();
+	}
+
+	void touch(const HistoryView::Element *view) {
+		auto &record = views[view];
+		record.view = base::make_weak(const_cast<HistoryView::Element*>(view));
+		record.id = view->data()->fullId();
+		record.touched = ++clock;
+		while (views.size() > kViewCount) {
+			const auto old = std::min_element(views.begin(), views.end(), [](const auto &a, const auto &b) {
+				return a.second.touched < b.second.touched;
+			});
+			views.erase(old);
+		}
+		schedule();
+	}
+
+	void schedule() {
+		if (queued || Clearing || !usable) return;
+		queued = true;
+		const auto weak = base::make_weak(session.get());
+		const auto token = instance;
+		crl::on_main(session, [=] {
+			const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+			if (i != Sessions.end() && i->second->instance == token) {
+				i->second->queued = false;
+				PumpAll();
+			}
+		});
+	}
+
+	std::optional<Source> available(const std::shared_ptr<Job> &job, not_null<DocumentData*> document) {
+		const auto bytes = job->media->bytes();
+		if (!bytes.isEmpty()) return Source{ .bytes = bytes };
+		if (document->loading()) return std::nullopt;
+		if (!job->path.isEmpty() && QFileInfo(job->path).isFile()) return Source{ .path = job->path };
+		const auto location = document->location(true);
+		if (!location.isEmpty() && QFileInfo(location.name()).isFile()) {
+			return Source{ .path = location.name(), .location = location };
+		}
+		return std::nullopt;
+	}
+
+	void process(const std::shared_ptr<Job> &job, Source source, Candidate candidate) {
+		auto permit = TrySealedDecryptJob();
+		if (!permit) return;
+		job->worker = true;
+		timer.cancel();
+		const auto weak = base::make_weak(session.get());
+		const auto token = instance;
+		crl::async([job, weak, token, source = std::move(source), candidate = std::move(candidate), permit = std::move(permit)]() mutable {
+			auto result = std::make_shared<Result>(Decode(job, std::move(source), std::move(candidate)));
+			crl::on_main([=] {
+				if (job->counted) { --Pipelines; job->counted = false; }
+				const auto i = weak ? Sessions.find(weak.get()) : Sessions.end();
+				if (!Core::Quitting() && i != Sessions.end() && i->second->instance == token) {
+					const auto state = i->second;
+					const auto item = weak->data().message(job->id);
+					const auto current = Current(item);
+					const auto valid = !job->canceled.load() && current
+						&& current->binding == job->binding && state->visible(job->id)
+						&& current->document->id == job->document
+						&& (!result->photo || SourceCurrent(*result, current->document));
+					if (state->active == job) state->active.reset();
+					if (valid) {
+						std::erase_if(state->attempted, [&](const auto &entry) { return !state->visible(entry.first); });
+						state->attempted[job->id] = job->binding;
+						if (result->photo) state->insert(job, *result);
+					}
+				}
+				if (!Core::Quitting()) PumpAll();
+			});
+		});
+	}
+
+	void insert(const std::shared_ptr<Job> &job, const Result &result) {
+		const auto bytes = result.photo->image.sizeInBytes();
+		if (bytes <= 0 || bytes > kImageBytes) return;
+		MakeRoom(bytes);
+		images[job->binding] = { job->id, result.nativeCipher, result.sourcePath, result.sourceLocation,
+			result.sourceModified, result.sourceSize, job->binding, result.cipherDigest,
+			result.photo, job->temporary, ++ImageClock };
+		refresh(job->id);
+	}
+
+	void pump() {
+		if (Clearing || !usable || Core::Quitting()) return;
+		std::erase_if(views, [](const auto &entry) { return !entry.second.view; });
+		for (auto &[pointer, record] : views) {
+			if (record.view) record.id = record.view->data()->fullId();
+		}
+		auto stale = std::vector<QByteArray>();
+		for (const auto &[key, entry] : images) {
+			const auto current = Current(session->data().message(entry.id));
+			if (!current || current->binding != entry.binding || !visible(entry.id)
+				|| !SourceCurrent(entry, current->document)) stale.push_back(key);
+		}
+		if (!stale.empty()) ClearSealedMediaViews();
+		for (const auto &key : stale) {
+			const auto found = images.find(key);
+			if (found != images.end()) { Cleanse(found->second.photo->image); images.erase(found); }
+		}
+		std::erase_if(attempted, [&](const auto &entry) { return !visible(entry.first); });
+		if (active) {
+			const auto job = active;
+			auto current = Current(session->data().message(job->id));
+			if (!current || current->binding != job->binding || !visible(job->id)) { stop(); schedule(); return; }
+			if (job->worker) return;
+			if (auto source = available(job, current->document)) {
+				process(job, std::move(*source), std::move(*current));
+			} else if (crl::now() - job->started >= kDownloadTimeout) {
+				attempted[job->id] = job->binding;
+				stop();
+				schedule();
+			}
+			return;
+		}
+		if (Pipelines >= kPipelineCount) return;
+		const auto records = views;
+		for (const auto &[pointer, record] : records) {
+			const auto view = record.view.get();
+			if (!view || !ContextAllowed(view) || !session->data().queryItemVisibility(view->data(), view)) continue;
+			auto current = Current(view->data());
+			if (!current || images.contains(current->binding)) continue;
+			const auto tried = attempted.find(record.id);
+			if (tried != attempted.end() && tried->second == current->binding) continue;
+			auto job = std::make_shared<Job>();
+			job->id = record.id;
+			job->document = current->document->id;
+			job->binding = current->binding;
+			job->media = current->document->createMediaView();
+			job->started = crl::now();
+			auto source = available(job, current->document);
+			if (!source && !current->document->loading()) {
+				if (current->document->cancelled() || !Data::AutoDownload::Should(
+						session->settings().autoDownload(), view->history()->peer, current->document)) continue;
+				job->temporary = std::make_shared<QTemporaryDir>();
+				if (!job->temporary->isValid()) continue;
+				job->path = job->temporary->filePath(u"message.teleenc"_q);
+				job->ownDownload = true;
+			}
+			active = job;
+			++Pipelines;
+			if (source) {
+				process(job, std::move(*source), std::move(*current));
+			} else {
+				timer.callOnce(kDownloadTimeout);
+				if (job->ownDownload) current->document->save(
+					Data::FileOriginMessage(job->id), job->path, LoadFromCloudOrLocal, true);
+			}
+			return;
+		}
+	}
+
+	not_null<Main::Session*> session;
+	quint64 instance = 0;
+	quint64 clock = 0;
+	bool queued = false;
+	bool usable = true;
+	base::Timer timer;
+	std::map<const HistoryView::Element*, ViewRecord> views;
+	std::map<QByteArray, ImageRecord> images;
+	std::map<FullMsgId, QByteArray> attempted;
+	std::shared_ptr<Job> active;
+	rpl::lifetime lifetime;
+};
+
+void MakeRoom(qsizetype bytes) {
+	auto used = qsizetype();
+	auto count = size_t();
+	for (const auto &[session, state] : Sessions) {
+		for (const auto &[key, entry] : state->images) {
+			used += entry.photo->image.sizeInBytes();
+			++count;
+		}
+	}
+	if (count < size_t(kImageCount) && used + bytes <= kImageBytes) return;
+	ClearSealedMediaViews();
+	while (count >= size_t(kImageCount) || used + bytes > kImageBytes) {
+		auto owner = (SessionMedia*)nullptr;
+		auto key = QByteArray();
+		auto oldest = std::numeric_limits<quint64>::max();
+		for (const auto &[session, state] : Sessions) {
+			for (const auto &[candidate, entry] : state->images) {
+				if (entry.touched < oldest) {
+					owner = state;
+					key = candidate;
+					oldest = entry.touched;
+				}
+			}
+		}
+		if (!owner) return;
+		const auto entry = owner->images.find(key);
+		used -= entry->second.photo->image.sizeInBytes();
+		Cleanse(entry->second.photo->image);
+		owner->images.erase(entry);
+		--count;
+	}
+}
+
+void PumpAll() {
+	for (const auto &[session, state] : Sessions) state->pump();
+}
+
+SessionMedia &State(not_null<Main::Session*> session) {
+	const auto i = Sessions.find(session);
+	return i != Sessions.end() ? *i->second : *session->lifetime().make_state<SessionMedia>(session);
+}
+
+}
+
+SealedDecodedMedia::~SealedDecodedMedia() {
+	Cleanse(image);
+}
+
+void TouchSealedMediaView(const HistoryView::Element *view) {
+	if (Clearing || !ContextAllowed(view) || Core::Quitting() || !Current(view->data())) return;
+	State(&view->history()->session()).touch(view);
+}
+
+void ForgetSealedMediaView(const HistoryView::Element *view) {
+	if (!view) return;
+	const auto i = Sessions.find(&view->history()->session());
+	if (i != Sessions.end()) { i->second->views.erase(view); i->second->schedule(); }
+}
+
+std::shared_ptr<const SealedDecodedMedia> SealedMediaImageFor(const HistoryView::Element *view) {
+	if (Clearing || !ContextAllowed(view) || Core::Quitting()) return nullptr;
+	const auto i = Sessions.find(&view->history()->session());
+	if (i == Sessions.end() || !i->second->usable
+		|| !i->second->session->data().queryItemVisibility(view->data(), view)) return nullptr;
+	const auto current = Current(view->data());
+	if (!current) return nullptr;
+	const auto found = i->second->images.find(current->binding);
+	if (found == i->second->images.end() || found->second.id != view->data()->fullId()
+		|| found->second.photo->image.isNull()) return nullptr;
+	if (!SourceCurrent(found->second, current->document)) return nullptr;
+	if (!found->second.nativeCipher.isEmpty()) {
+		if (const auto media = current->document->activeMediaView()) {
+			const auto bytes = media->bytes();
+			if (!bytes.isEmpty() && bytes.constData() != found->second.nativeCipher.constData()) {
+				if (bytes != found->second.nativeCipher) return nullptr;
+				found->second.nativeCipher = bytes;
+			}
+		}
+	}
+	found->second.touched = ++ImageClock;
+	return found->second.photo;
+}
+
+bool SealedMediaImageCurrent(const HistoryView::Element *view, const QByteArray &token) {
+	const auto image = SealedMediaImageFor(view);
+	return image && !token.isEmpty() && image->token == token;
+}
+
+void ClearSealedMediaCache() {
+	if (Clearing) return;
+	Clearing = true;
+	ClearSealedMediaViews();
+	for (const auto &[session, state] : Sessions) state->clear();
+	Clearing = false;
+}
+
+}
