diff --git a/Telegram/SourceFiles/tele/tele_sealed_jobs.cpp b/Telegram/SourceFiles/tele/tele_sealed_jobs.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..444143f518f35513c20404c69a1236b047570164
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_jobs.cpp
@@ -0,0 +1,67 @@
+#include "tele/tele_sealed_jobs.h"
+
+#include "crl/crl_on_main.h"
+#include "tele/tele_sealed_jobs_plan.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QThread>
+#include <rpl/event_stream.h>
+
+namespace Tele {
+namespace {
+
+struct State {
+	SealedDecryptBudget budget;
+	rpl::event_stream<> changes;
+	bool queued = false;
+};
+
+State &Get() {
+	static auto result = State();
+	return result;
+}
+
+void MainThread() {
+	Expects(QCoreApplication::instance()
+		&& QThread::currentThread() == QCoreApplication::instance()->thread());
+}
+
+void Released(SealedDecryptPool pool) {
+	MainThread();
+	auto &state = Get();
+	const auto released = state.budget.release(pool);
+	Expects(released);
+	if (state.queued) return;
+	state.queued = true;
+	crl::on_main([] {
+		auto &state = Get();
+		state.queued = false;
+		state.changes.fire({});
+	});
+}
+
+}
+
+SealedDecryptJob::~SealedDecryptJob() {
+	const auto pool = _pool;
+	crl::on_main([pool] { Released(pool); });
+}
+
+bool SealedDecryptJobAvailable(SealedDecryptPurpose purpose) {
+	MainThread();
+	return Get().budget.available(purpose);
+}
+
+std::shared_ptr<SealedDecryptJob> TrySealedDecryptJob(SealedDecryptPurpose purpose) {
+	MainThread();
+	const auto pool = Get().budget.acquire(purpose);
+	if (!pool) return nullptr;
+	return std::shared_ptr<SealedDecryptJob>(new SealedDecryptJob(*pool));
+}
+
+rpl::producer<> SealedDecryptJobsChanges() {
+	MainThread();
+	return Get().changes.events();
+}
+
+}
