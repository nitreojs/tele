diff --git a/Telegram/SourceFiles/tele/tele_sealed_jobs_plan.h b/Telegram/SourceFiles/tele/tele_sealed_jobs_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..dfd0f9e69c6e369bc197abd39e22abc6fcf9ccdd
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_jobs_plan.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <optional>
+
+namespace Tele {
+
+inline constexpr auto kSealedDecryptReservedJobLimit = 3;
+inline constexpr auto kSealedDecryptSharedJobLimit = 3;
+inline constexpr auto kSealedDecryptJobLimit = kSealedDecryptReservedJobLimit + kSealedDecryptSharedJobLimit;
+
+enum class SealedDecryptPurpose {
+	Normal,
+	Search,
+};
+
+enum class SealedDecryptPool {
+	Reserved,
+	Shared,
+};
+
+class SealedDecryptBudget final {
+public:
+	SealedDecryptBudget() = default;
+	SealedDecryptBudget(const SealedDecryptBudget&) = delete;
+	SealedDecryptBudget &operator=(const SealedDecryptBudget&) = delete;
+
+	[[nodiscard]] bool available(SealedDecryptPurpose purpose = SealedDecryptPurpose::Normal) const {
+		return (purpose == SealedDecryptPurpose::Normal && _reserved < kSealedDecryptReservedJobLimit)
+			|| ((purpose == SealedDecryptPurpose::Normal || purpose == SealedDecryptPurpose::Search)
+				&& _shared < kSealedDecryptSharedJobLimit);
+	}
+
+	[[nodiscard]] std::optional<SealedDecryptPool> acquire(
+			SealedDecryptPurpose purpose = SealedDecryptPurpose::Normal) {
+		if (purpose == SealedDecryptPurpose::Normal && _reserved < kSealedDecryptReservedJobLimit) {
+			++_reserved;
+			return SealedDecryptPool::Reserved;
+		} else if ((purpose == SealedDecryptPurpose::Normal || purpose == SealedDecryptPurpose::Search)
+			&& _shared < kSealedDecryptSharedJobLimit) {
+			++_shared;
+			return SealedDecryptPool::Shared;
+		}
+		return std::nullopt;
+	}
+
+	[[nodiscard]] bool release(SealedDecryptPool pool) {
+		if (pool == SealedDecryptPool::Reserved && _reserved) {
+			--_reserved;
+			return true;
+		} else if (pool == SealedDecryptPool::Shared && _shared) {
+			--_shared;
+			return true;
+		}
+		return false;
+	}
+
+	[[nodiscard]] int active() const {
+		return _reserved + _shared;
+	}
+
+	[[nodiscard]] int active(SealedDecryptPool pool) const {
+		return pool == SealedDecryptPool::Reserved ? _reserved
+			: pool == SealedDecryptPool::Shared ? _shared : 0;
+	}
+
+private:
+	int _reserved = 0;
+	int _shared = 0;
+};
+
+}
