index 0000000000000000000000000000000000000000..d535b34fee12f4831ff398ba6fd9aa8470315025
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_rich_send.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include "api/api_common.h"
+
+#include <optional>
+#include <vector>
+
+namespace Tele {
+
+struct SealedRichText;
+
+enum class SealedRichPrepareError {
+	None,
+	Unavailable,
+	Unsupported,
+	InvalidText,
+	TooLarge,
+	QueueFull,
+	EncryptionFailed,
+	ProofFailed,
+};
+
+struct SealedRichSendBinding {
+	uint64 account = 0;
+	uint64 chat = 0;
+	uint64 epoch = 0;
+	QByteArray ownPublic;
+	QByteArray peerPublic;
+	QByteArray context;
+};
+
+using SealedRichRegisterBatch = Fn<bool(
+	not_null<History*>,
+	const SealedRichSendBinding&,
+	const std::vector<Api::MessageToSend>&)>;
+
+struct SealedRichPreparedSend {
+	SealedRichPrepareError error = SealedRichPrepareError::None;
+	std::optional<Api::MessageToSend> first;
+	int parts = 0;
+};
+
+[[nodiscard]] SealedRichPreparedSend PrepareSealedRichSend(
+	const Api::SendAction &action,
+	const SealedRichText &text,
+	const SealedRichRegisterBatch &registerBatch);
+[[nodiscard]] bool IsPreparedSealedRichPart(const Api::MessageToSend &message);
+[[nodiscard]] bool ReleaseSealedRichTail(
+	not_null<History*> history,
+	const QString &firstToken);
+[[nodiscard]] bool AfterSealedRichSend(
+	not_null<History*> history,
+	const QString &firstToken,
+	Fn<void()> callback);
+void ClearSealedRichSendBatches();
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_rich_send_plan.h b/Telegram/SourceFiles/tele/tele_sealed_rich_send_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..67c19f04bf642fc943b43b3c332475237fd2900c
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sealed_rich_send_plan.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace Tele {
+
+inline constexpr auto kSealedRichSendGroupLimit = 16;
+inline constexpr auto kSealedRichSendPartLimit = 1024;
+inline constexpr auto kSealedRichSendByteLimit = std::int64_t(4 * 1024 * 1024);
+
+[[nodiscard]] inline bool SealedRichSendCapacity(
+		std::size_t groups,
+		int parts,
+		std::int64_t bytes,
+		int addedParts,
+		std::int64_t addedBytes) {
+	return groups < std::size_t(kSealedRichSendGroupLimit)
+		&& parts >= 0 && parts <= kSealedRichSendPartLimit
+		&& addedParts >= 1 && addedParts <= 64
+		&& parts <= kSealedRichSendPartLimit - addedParts
+		&& bytes >= 0 && bytes <= kSealedRichSendByteLimit
+		&& addedBytes >= 0 && addedBytes <= kSealedRichSendByteLimit
+		&& bytes <= kSealedRichSendByteLimit - addedBytes;
+}
+
+struct SealedRichSendCursor {
+	int count = 0;
+	int next = 1;
+	bool accepted = false;
+	bool canceled = false;
+};
+
+[[nodiscard]] inline bool AcceptSealedRichFirst(SealedRichSendCursor &cursor) {
+	if (cursor.canceled || cursor.accepted || cursor.count < 1 || cursor.count > 64
+		|| cursor.next != 1) {
+		return false;
+	}
+	cursor.accepted = true;
+	return true;
+}
+
+[[nodiscard]] inline std::optional<int> TakeSealedRichTail(SealedRichSendCursor &cursor) {
+	if (cursor.canceled || !cursor.accepted || cursor.count < 1 || cursor.count > 64
+		|| cursor.next < 1 || cursor.next >= cursor.count) {
+		return std::nullopt;
+	}
+	return cursor.next++;
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_sealed_search.cpp b/Telegram/SourceFiles/tele/tele_sealed_search.cpp
