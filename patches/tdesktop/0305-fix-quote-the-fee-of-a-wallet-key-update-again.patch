From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Tue, 13 Oct 2026 00:36:30 +0300
Subject: [PATCH] fix: quote the fee of a wallet key update again

---
 Telegram/SourceFiles/gram/gram_boc.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/gram/gram_boc.cpp b/Telegram/SourceFiles/gram/gram_boc.cpp
index 2e89adb3a2210dde5891cb56877c84207495f021..27aec4915323a48a9bd9a6cd9f06f10b71b42832 100644
--- a/Telegram/SourceFiles/gram/gram_boc.cpp
+++ b/Telegram/SourceFiles/gram/gram_boc.cpp
@@ -23,6 +23,7 @@ constexpr auto kSignatureBytes = 64;
 // key's ownership proof in the single reference.
 constexpr auto kRequestBytes = kSignatureBytes + 4 + 4 + 4 + 4 + 32;
 constexpr auto kRequestRefs = 1;
+constexpr auto kRequestRefsWithOldKey = 2;
 constexpr auto kExternalOpcode = quint32(0xFBBA99C8);
 constexpr auto kInternalOpcode = quint32(0xFBBA99C7);
 constexpr auto kMaxCells = 64;
@@ -154,7 +155,8 @@ std::optional<quint64> BitReader::read(int count) {
 	for (auto i = 0, count = int(cells.size()); i != count; ++i) {
 		const auto &cell = cells[i];
 		if (!cell.wholeBytes
-			|| cell.refs != kRequestRefs
+			|| (cell.refs != kRequestRefs
+				&& cell.refs != kRequestRefsWithOldKey)
 			|| cell.dataSize != kRequestBytes) {
 			continue;
 		}
