@@ -0,0 +1,50 @@
+#include "tele/tele_secret_media.h"
+
+#include "apiwrap.h"
+#include "base/unixtime.h"
+#include "data/data_media_types.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+bool Burning = false;
+
+} // namespace
+
+bool KeepsSecretMedia(not_null<const HistoryItem*> item) {
+	if (Burning || item->out() || !KeepSecretMedia()) {
+		return false;
+	}
+	const auto media = item->media();
+	return media && media->ttlSeconds();
+}
+
+void AddMarkViewedAction(not_null<Ui::PopupMenu*> menu, HistoryItem *item) {
+	if (!item
+		|| !item->isRegular()
+		|| !item->isIncomingUnreadMedia()
+		|| !KeepsSecretMedia(item)) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	const auto itemId = item->fullId();
+	menu->addAction(u"Mark as viewed"_q, [=] {
+		const auto item = session->data().message(itemId);
+		if (!item) {
+			return;
+		}
+		Burning = true;
+		session->api().markContentsRead(item);
+		Burning = false;
+		item->applyMediaContentsRead(base::unixtime::now());
+	}, &st::menuIconMarkRead);
+}
+
+} // namespace Tele
