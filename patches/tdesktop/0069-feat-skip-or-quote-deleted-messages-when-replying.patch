diff --git a/Telegram/SourceFiles/tele/tele_deleted_reply.cpp b/Telegram/SourceFiles/tele/tele_deleted_reply.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8ca7ddbd4075dea631d0f0a6e22a103cb5c254b8
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_deleted_reply.cpp
@@ -0,0 +1,294 @@
+#include "tele/tele_deleted_reply.h"
+
+#include "api/api_common.h"
+#include "data/data_document.h"
+#include "data/data_peer.h"
+#include "data/data_premium_limits.h"
+#include "data/data_session.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_item_preview.h"
+#include "main/main_session.h"
+#include "tele/tele_deleted.h"
+#include "tele/tele_options.h"
+#include "ui/chat/attach/attach_prepare.h"
+#include "ui/text/text_entity.h"
+
+namespace Tele {
+namespace {
+
+enum class Kind {
+	None,
+	Message,
+	Caption,
+};
+
+using QuotedKey = std::pair<FullMsgId, PeerId>;
+
+[[nodiscard]] base::flat_set<QuotedKey> &Quoted() {
+	static auto result = base::flat_set<QuotedKey>();
+	return result;
+}
+
+void MarkQuoted(QuotedKey key) {
+	auto &quoted = Quoted();
+	if (quoted.empty()) {
+		crl::on_main([] {
+			Quoted().clear();
+		});
+	}
+	quoted.emplace(key);
+}
+
+[[nodiscard]] bool QuoteMode() {
+	return (DeletedReply() == u"quote"_q);
+}
+
+[[nodiscard]] HistoryItem *DeletedTarget(
+		not_null<History*> history,
+		const FullReplyTo &replyTo) {
+	if (!replyTo.messageId) {
+		return nullptr;
+	}
+	const auto item = history->owner().message(replyTo.messageId);
+	return (item && IsKeptDeleted(item)) ? item : nullptr;
+}
+
+void Strip(
+		not_null<History*> history,
+		FullReplyTo &replyTo,
+		not_null<HistoryItem*> item) {
+	const auto same = (item->history() == history);
+	auto topicRootId = replyTo.topicRootId;
+	if (!topicRootId && same && history->isForum()) {
+		topicRootId = item->topicRootId();
+	}
+	auto monoforumPeerId = replyTo.monoforumPeerId;
+	if (!monoforumPeerId && same && history->peer->amMonoforumAdmin()) {
+		monoforumPeerId = item->sublistPeerId();
+	}
+	const auto root = (topicRootId && !(same && topicRootId == item->id))
+		? FullMsgId(history->peer->id, topicRootId)
+		: FullMsgId();
+	replyTo = FullReplyTo{
+		.messageId = root,
+		.topicRootId = topicRootId,
+		.monoforumPeerId = monoforumPeerId,
+	};
+}
+
+[[nodiscard]] TextWithEntities QuotedText(
+		not_null<HistoryItem*> item,
+		const TextWithEntities &quote,
+		bool customEmoji) {
+	auto result = quote.empty() ? item->originalText() : quote;
+	if (result.text.isEmpty()) {
+		result = TextWithEntities{ item->toPreview({
+			.hideSender = true,
+			.generateImages = false,
+			.ignoreGroup = true,
+		}).text.text };
+	}
+	result.entities.erase(ranges::remove_if(result.entities, [&](
+			const EntityInText &entity) {
+		const auto type = entity.type();
+		return (type == EntityType::Blockquote)
+			|| (!customEmoji && type == EntityType::CustomEmoji);
+	}), result.entities.end());
+	TextUtilities::Trim(result);
+	return result;
+}
+
+void Truncate(TextWithEntities &text, int limit) {
+	if (text.text.size() <= limit) {
+		return;
+	} else if (limit < 2) {
+		text = TextWithEntities();
+		return;
+	}
+	auto length = limit - 1;
+	if (text.text.at(length - 1).isHighSurrogate()) {
+		--length;
+	}
+	text.text = text.text.left(length) + QChar(0x2026);
+	auto &entities = text.entities;
+	for (auto i = entities.begin(); i != entities.end();) {
+		const auto from = i->offset();
+		const auto till = from + i->length();
+		const auto atomic = (i->type() == EntityType::CustomEmoji)
+			|| (i->type() == EntityType::MentionName)
+			|| (i->type() == EntityType::CustomUrl);
+		if (from >= length || (till > length && atomic)) {
+			i = entities.erase(i);
+			continue;
+		} else if (till > length) {
+			i->shrinkFromRight(till - length);
+		}
+		++i;
+	}
+}
+
+[[nodiscard]] std::optional<TextWithTags> Compose(
+		not_null<History*> history,
+		not_null<HistoryItem*> item,
+		const TextWithEntities &quote,
+		const TextWithTags &own,
+		Kind kind) {
+	const auto session = &history->session();
+	const auto limits = Data::PremiumLimits(session);
+	const auto limit = (kind == Kind::Message)
+		? limits.messageLengthCurrent()
+		: limits.captionLengthCurrent();
+	const auto name = item->author()->name();
+	const auto customEmoji = session->premium()
+		|| Data::AllowEmojiWithoutPremium(history->peer);
+	auto quoted = QuotedText(item, quote, customEmoji);
+	const auto separator = own.text.isEmpty() ? 0 : 1;
+	const auto ownLength = int(own.text.size()) + separator;
+	const auto nameLength = name.isEmpty() ? 0 : int(name.size()) + 1;
+	auto available = limit - nameLength - ownLength;
+	if (available < 0 && kind == Kind::Message) {
+		available = limit - nameLength - separator;
+	}
+	if (available < 0 || (name.isEmpty() && available < 2)) {
+		return std::nullopt;
+	}
+	Truncate(quoted, available);
+	if (name.isEmpty() && quoted.empty()) {
+		return std::nullopt;
+	}
+
+	auto prefix = TextWithEntities();
+	prefix.entities.push_back(EntityInText(EntityType::Blockquote, 0, 0));
+	if (!name.isEmpty()) {
+		prefix.text = name;
+		prefix.entities.push_back(
+			EntityInText(EntityType::Bold, 0, int(name.size())));
+	}
+	if (!quoted.empty()) {
+		if (!prefix.text.isEmpty()) {
+			prefix.text.append(QChar('\n'));
+		}
+		const auto shift = int(prefix.text.size());
+		for (auto entity : quoted.entities) {
+			entity.shiftRight(shift);
+			prefix.entities.push_back(std::move(entity));
+		}
+		prefix.text.append(quoted.text);
+	}
+	prefix.entities.front() = EntityInText(
+		EntityType::Blockquote,
+		0,
+		int(prefix.text.size()));
+	std::stable_sort(
+		prefix.entities.begin(),
+		prefix.entities.end(),
+		[](const EntityInText &a, const EntityInText &b) {
+			return a.offset() < b.offset();
+		});
+
+	auto result = TextWithTags{
+		prefix.text,
+		TextUtilities::ConvertEntitiesToTextTags(prefix.entities),
+	};
+	if (!own.text.isEmpty()) {
+		result.text.append(QChar('\n'));
+		const auto shift = int(result.text.size());
+		for (auto tag : own.tags) {
+			tag.offset += shift;
+			result.tags.push_back(std::move(tag));
+		}
+		result.text.append(own.text);
+	}
+	return result;
+}
+
+void Apply(Api::SendAction &action, TextWithTags *text, Kind kind) {
+	const auto history = action.history;
+	const auto item = DeletedTarget(history, action.replyTo);
+	if (!item) {
+		return;
+	}
+	const auto quote = action.replyTo.quote;
+	Strip(history, action.replyTo, item);
+	if (!text || kind == Kind::None || !QuoteMode()) {
+		return;
+	}
+	const auto key = QuotedKey(item->fullId(), history->peer->id);
+	if (Quoted().contains(key)) {
+		return;
+	}
+	if (auto result = Compose(history, item, quote, *text, kind)) {
+		*text = std::move(*result);
+		MarkQuoted(key);
+	}
+}
+
+} // namespace
+
+bool SkipReplyTo(not_null<const HistoryItem*> item) {
+	return IsKeptDeleted(item) && !QuoteMode();
+}
+
+void StripDeletedReply(not_null<History*> history, FullReplyTo &replyTo) {
+	if (const auto item = DeletedTarget(history, replyTo)) {
+		Strip(history, replyTo, item);
+	}
+}
+
+void StripDeletedReply(
+		not_null<History*> history,
+		HistoryItemCommonFields &fields) {
+	if (!(fields.flags & MessageFlag::FakeHistoryItem)) {
+		StripDeletedReply(history, fields.replyTo);
+	}
+}
+
+void QuoteDeletedReply(Api::MessageToSend &message) {
+	Apply(message.action, &message.textWithTags, Kind::Message);
+}
+
+void QuoteDeletedCaption(Api::MessageToSend &message) {
+	Apply(message.action, &message.textWithTags, Kind::Caption);
+}
+
+void QuoteDeletedCaption(
+		Api::MessageToSend &message,
+		not_null<DocumentData*> document) {
+	const auto captioned = !document->sticker()
+		&& !document->isVideoMessage();
+	Apply(
+		message.action,
+		&message.textWithTags,
+		captioned ? Kind::Caption : Kind::None);
+}
+
+void QuoteDeletedCaption(
+		Api::MessageToSend &message,
+		not_null<PhotoData*>) {
+	QuoteDeletedCaption(message);
+}
+
+void QuoteDeletedFiles(Ui::PreparedList &list, Api::SendAction &action) {
+	if (list.files.empty()) {
+		Apply(action, nullptr, Kind::None);
+		return;
+	}
+	const auto i = ranges::find_if(list.files, [](
+			const Ui::PreparedFile &file) {
+		return !file.caption.text.isEmpty();
+	});
+	auto &file = (i != end(list.files)) ? *i : list.files.front();
+	Apply(action, &file.caption, Kind::Caption);
+}
+
+Api::SendAction QuoteDeletedVoice(
+		Api::SendAction action,
+		TextWithTags &caption,
+		bool video) {
+	Apply(action, &caption, video ? Kind::None : Kind::Caption);
+	return action;
+}
+
+} // namespace Tele
