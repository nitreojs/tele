From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 10 Oct 2026 17:05:40 +0300
Subject: [PATCH] fix: space out the buttons in the notification centre

---
 Telegram/SourceFiles/tele/tele_notices_section.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/tele/tele_notices_section.cpp b/Telegram/SourceFiles/tele/tele_notices_section.cpp
index 4abc00148959f961e4a42062376e640183036951..f5f401b72552a79cfa40b874bc3a8bea5d13670e 100644
--- a/Telegram/SourceFiles/tele/tele_notices_section.cpp
+++ b/Telegram/SourceFiles/tele/tele_notices_section.cpp
@@ -42,6 +42,7 @@ constexpr auto kBadgeSize = 18;
 constexpr auto kBadgeStroke = 2;
 constexpr auto kBadgeShift = 1;
 constexpr auto kTextLines = 6;
+constexpr auto kButtonSkip = 6;
 
 enum class Filter : uchar {
 	All,
@@ -433,11 +434,12 @@ int Entry::resizeGetHeight(int newWidth) {
 	}
 	if (!_buttons.empty()) {
 		top += padding / 2;
+		const auto skip = style::ConvertScale(kButtonSkip);
 		auto x = left() - st::defaultLightButton.padding.left();
 		auto height = 0;
 		for (const auto button : _buttons) {
 			button->moveToLeft(x, top, newWidth);
-			x += button->width();
+			x += button->width() + skip;
 			height = std::max(height, button->height());
 		}
 		top += height;
