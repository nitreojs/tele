diff --git a/Telegram/SourceFiles/tele/tele_image_ocr.cpp b/Telegram/SourceFiles/tele/tele_image_ocr.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..174a152544252f165c957346044a85b16efc120a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_image_ocr.cpp
@@ -0,0 +1,47 @@
+#include "tele/tele_image_ocr.h"
+
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+bool ImageOcrSupported() {
+	return true;
+}
+
+bool ImageOcrAvailable() {
+	return ImageTextSelection()
+		? details::ImageOcrBackendAvailable(ImageOcrLanguage())
+		: Platform::TextRecognition::IsAvailable();
+}
+
+QString ImageOcrLanguageForRecognition() {
+	return ImageTextSelection() ? ImageOcrLanguage() : QString();
+}
+
+bool ImageOcrResultCurrent(const QString &language) {
+	return language == ImageOcrLanguageForRecognition();
+}
+
+Platform::TextRecognition::Result RecognizeImageText(
+		const QImage &image,
+		const QString &language) {
+	return language.isEmpty()
+		? Platform::TextRecognition::RecognizeText(image)
+		: details::RecognizeImageTextBackend(image, language);
+}
+
+namespace details {
+
+bool ImageOcrCacheNeedsReset() {
+	static auto previous = QString();
+	const auto current = ImageOcrLanguageForRecognition();
+	if (previous == current) {
+		return false;
+	}
+	previous = current;
+	return true;
+}
+
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_image_ocr.h b/Telegram/SourceFiles/tele/tele_image_ocr.h
new file mode 100644
index 0000000000000000000000000000000000000000..16340e74ba5c9aa442b4ccc349718b1afc8ea29e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_image_ocr.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "platform/platform_text_recognition.h"
+
+namespace Tele {
+
+[[nodiscard]] bool ImageOcrSupported();
+[[nodiscard]] bool ImageOcrAvailable();
+[[nodiscard]] QString ImageOcrLanguageForRecognition();
+[[nodiscard]] bool ImageOcrResultCurrent(const QString &language);
+[[nodiscard]] Platform::TextRecognition::Result RecognizeImageText(
+	const QImage &image,
+	const QString &language);
+
+template <typename Retry>
+[[nodiscard]] bool RetryChangedImageOcr(
+		const QString &language,
+		Retry &&retry) {
+	if (ImageOcrResultCurrent(language)) {
+		return false;
+	}
+	retry();
+	return true;
+}
+
+namespace details {
+
+[[nodiscard]] bool ImageOcrCacheNeedsReset();
+[[nodiscard]] bool ImageOcrBackendAvailable(const QString &language);
+[[nodiscard]] bool ConfigureImageOcrRequest(void *request);
+[[nodiscard]] Platform::TextRecognition::Result RecognizeImageTextBackend(
+	const QImage &image,
+	const QString &language);
+
+}
+
+template <typename Cache>
+[[nodiscard]] Cache *ImageOcrCacheForSettings(Cache *cache) {
+	if (cache && details::ImageOcrCacheNeedsReset()) {
+		cache->clear();
+	}
+	return cache;
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_image_ocr_linux.cpp b/Telegram/SourceFiles/tele/tele_image_ocr_linux.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..af346e5febe226ef2fca6bec0ba82c2c5b2b222e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_image_ocr_linux.cpp
@@ -0,0 +1,283 @@
+#include "tele/tele_image_ocr.h"
+
+#include "ui/style/style_core.h"
+#include <QLibrary>
+#include <QPainter>
+#include <array>
+#include <mutex>
+
+namespace Tele::details {
+namespace {
+
+constexpr auto kMaxImageDimension = 4096;
+constexpr auto kRecognitionDeadline = 10000;
+constexpr auto kMaxWords = 10000;
+constexpr auto kSparseText = 11;
+constexpr auto kWord = 3;
+constexpr auto kSymbol = 4;
+
+struct TessBaseAPI;
+struct TessResultIterator;
+struct TessPageIterator;
+struct ETEXT_DESC;
+
+struct TesseractApi {
+	TessBaseAPI *(*create)() = nullptr;
+	void (*destroy)(TessBaseAPI*) = nullptr;
+	int (*init)(TessBaseAPI*, const char*, const char*) = nullptr;
+	void (*setPageSegMode)(TessBaseAPI*, int) = nullptr;
+	void (*setImage)(TessBaseAPI*, const unsigned char*, int, int, int, int) = nullptr;
+	void (*setResolution)(TessBaseAPI*, int) = nullptr;
+	void (*clear)(TessBaseAPI*) = nullptr;
+	int (*recognize)(TessBaseAPI*, ETEXT_DESC*) = nullptr;
+	TessResultIterator *(*iterator)(TessBaseAPI*) = nullptr;
+	void (*destroyIterator)(TessResultIterator*) = nullptr;
+	TessResultIterator *(*copyIterator)(const TessResultIterator*) = nullptr;
+	const TessPageIterator *(*pageIterator)(const TessResultIterator*) = nullptr;
+	char *(*text)(const TessResultIterator*, int) = nullptr;
+	int (*next)(TessResultIterator*, int) = nullptr;
+	int (*isFinalElement)(const TessPageIterator*, int, int) = nullptr;
+	int (*boundingBox)(const TessPageIterator*, int, int*, int*, int*, int*) = nullptr;
+	void (*destroyText)(const char*) = nullptr;
+	ETEXT_DESC *(*createMonitor)() = nullptr;
+	void (*destroyMonitor)(ETEXT_DESC*) = nullptr;
+	void (*setDeadline)(ETEXT_DESC*, int) = nullptr;
+
+	TesseractApi() {
+		library.setLoadHints(QLibrary::PreventUnloadHint);
+		for (const auto version : { 5, 4 }) {
+			library.setFileNameAndVersion(u"tesseract"_q, version);
+			if (library.load() && resolve()) {
+				available = true;
+				break;
+			}
+			library.unload();
+		}
+	}
+
+	[[nodiscard]] bool ready() const {
+		return available;
+	}
+
+private:
+	template <typename Function>
+	[[nodiscard]] bool resolve(Function &target, const char *name) {
+		target = reinterpret_cast<Function>(library.resolve(name));
+		return target != nullptr;
+	}
+
+	[[nodiscard]] bool resolve() {
+		return resolve(create, "TessBaseAPICreate")
+			&& resolve(destroy, "TessBaseAPIDelete")
+			&& resolve(init, "TessBaseAPIInit3")
+			&& resolve(setPageSegMode, "TessBaseAPISetPageSegMode")
+			&& resolve(setImage, "TessBaseAPISetImage")
+			&& resolve(setResolution, "TessBaseAPISetSourceResolution")
+			&& resolve(clear, "TessBaseAPIClear")
+			&& resolve(recognize, "TessBaseAPIRecognize")
+			&& resolve(iterator, "TessBaseAPIGetIterator")
+			&& resolve(destroyIterator, "TessResultIteratorDelete")
+			&& resolve(copyIterator, "TessResultIteratorCopy")
+			&& resolve(pageIterator, "TessResultIteratorGetPageIteratorConst")
+			&& resolve(text, "TessResultIteratorGetUTF8Text")
+			&& resolve(next, "TessResultIteratorNext")
+			&& resolve(isFinalElement, "TessPageIteratorIsAtFinalElement")
+			&& resolve(boundingBox, "TessPageIteratorBoundingBox")
+			&& resolve(destroyText, "TessDeleteText")
+			&& resolve(createMonitor, "TessMonitorCreate")
+			&& resolve(destroyMonitor, "TessMonitorDelete")
+			&& resolve(setDeadline, "TessMonitorSetDeadlineMSecs");
+	}
+
+	QLibrary library;
+	bool available = false;
+};
+
+using EnginePointer = std::unique_ptr<TessBaseAPI, decltype(TesseractApi::destroy)>;
+using IteratorPointer = std::unique_ptr<TessResultIterator, decltype(TesseractApi::destroyIterator)>;
+using MonitorPointer = std::unique_ptr<ETEXT_DESC, decltype(TesseractApi::destroyMonitor)>;
+
+[[nodiscard]] const TesseractApi &Api() {
+	static const auto result = TesseractApi();
+	return result;
+}
+
+[[nodiscard]] TessBaseAPI *ImageOcrEngine(
+		const TesseractApi &api,
+		const QString &language) {
+	static auto engines = std::array<EnginePointer, 3>{
+		EnginePointer(nullptr, api.destroy),
+		EnginePointer(nullptr, api.destroy),
+		EnginePointer(nullptr, api.destroy),
+	};
+	const auto index = (language == u"en"_q) ? 1 : (language == u"ru"_q) ? 2 : 0;
+	auto &engine = engines[index];
+	if (!engine) {
+		auto result = EnginePointer(api.create(), api.destroy);
+		const auto languages = (index == 1) ? "eng" : (index == 2) ? "rus" : "eng+rus";
+		if (!result || api.init(result.get(), nullptr, languages)) {
+			return nullptr;
+		}
+		api.setPageSegMode(result.get(), kSparseText);
+		engine = std::move(result);
+	}
+	return engine.get();
+}
+
+[[nodiscard]] QString RecognizedText(
+		const TesseractApi &api,
+		const TessResultIterator *iterator,
+		int level) {
+	const auto text = std::unique_ptr<const char, decltype(api.destroyText)>(
+		api.text(iterator, level),
+		api.destroyText);
+	return text ? QString::fromUtf8(text.get()) : QString();
+}
+
+[[nodiscard]] QRect RecognizedBox(
+		const TesseractApi &api,
+		const TessPageIterator *iterator,
+		int level,
+		double scaleX,
+		double scaleY) {
+	auto left = 0;
+	auto top = 0;
+	auto right = 0;
+	auto bottom = 0;
+	if (!api.boundingBox(iterator, level, &left, &top, &right, &bottom)
+		|| right <= left
+		|| bottom <= top) {
+		return {};
+	}
+	return QRect(
+		int(style::ConvertScale(left * scaleX)),
+		int(style::ConvertScale(top * scaleY)),
+		std::max(1, int(style::ConvertScale((right - left) * scaleX))),
+		std::max(1, int(style::ConvertScale((bottom - top) * scaleY))));
+}
+
+[[nodiscard]] std::vector<QRect> RecognizedGlyphs(
+		const TesseractApi &api,
+		const TessResultIterator *word,
+		const QString &text,
+		double scaleX,
+		double scaleY) {
+	auto symbols = IteratorPointer(api.copyIterator(word), api.destroyIterator);
+	if (!symbols) {
+		return {};
+	}
+	const auto page = api.pageIterator(symbols.get());
+	auto result = std::vector<QRect>();
+	result.reserve(text.size());
+	auto recognized = QString();
+	do {
+		const auto symbol = RecognizedText(api, symbols.get(), kSymbol);
+		const auto box = RecognizedBox(api, page, kSymbol, scaleX, scaleY);
+		if (symbol.isEmpty() || box.isEmpty()) {
+			return {};
+		}
+		recognized += symbol;
+		if (recognized.size() > text.size()) {
+			return {};
+		}
+		result.insert(result.end(), symbol.size(), box);
+		if (api.isFinalElement(page, kWord, kSymbol)) {
+			break;
+		}
+	} while (api.next(symbols.get(), kSymbol));
+	return (recognized == text) ? result : std::vector<QRect>();
+}
+
+}
+
+bool ImageOcrBackendAvailable(const QString &) {
+	return Api().ready();
+}
+
+Platform::TextRecognition::Result RecognizeImageTextBackend(
+		const QImage &image,
+		const QString &language) {
+	if (image.isNull()) {
+		return {};
+	}
+	const auto &api = Api();
+	if (!api.ready()) {
+		return {};
+	}
+	static auto mutex = std::mutex();
+	const auto lock = std::lock_guard(mutex);
+	const auto engine = ImageOcrEngine(api, language);
+	if (!engine) {
+		return {};
+	}
+	const auto clear = gsl::finally([&] {
+		api.clear(engine);
+	});
+	auto input = (std::max(image.width(), image.height()) > kMaxImageDimension)
+		? image.scaled(
+			kMaxImageDimension,
+			kMaxImageDimension,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation)
+		: image;
+	if (input.isNull()) {
+		return {};
+	}
+	input.setDevicePixelRatio(1.);
+	if (input.hasAlphaChannel()) {
+		auto flattened = QImage(input.size(), QImage::Format_RGB32);
+		if (flattened.isNull()) {
+			return {};
+		}
+		flattened.fill(Qt::white);
+		{
+			auto painter = QPainter(&flattened);
+			painter.drawImage(QPoint(), input);
+		}
+		input = std::move(flattened);
+	}
+	input = input.convertToFormat(QImage::Format_Grayscale8);
+	if (input.isNull()) {
+		return {};
+	}
+	api.setImage(
+		engine,
+		input.constBits(),
+		input.width(),
+		input.height(),
+		1,
+		int(input.bytesPerLine()));
+	api.setResolution(engine, 300);
+	auto monitor = MonitorPointer(api.createMonitor(), api.destroyMonitor);
+	if (!monitor) {
+		return {};
+	}
+	api.setDeadline(monitor.get(), kRecognitionDeadline);
+	if (api.recognize(engine, monitor.get())) {
+		return {};
+	}
+	auto result = Platform::TextRecognition::Result{ .success = true };
+	auto words = IteratorPointer(api.iterator(engine), api.destroyIterator);
+	if (!words) {
+		return result;
+	}
+	const auto page = api.pageIterator(words.get());
+	const auto scaleX = double(image.width()) / input.width();
+	const auto scaleY = double(image.height()) / input.height();
+	do {
+		auto text = RecognizedText(api, words.get(), kWord);
+		const auto box = RecognizedBox(api, page, kWord, scaleX, scaleY);
+		if (text.isEmpty() || box.isEmpty()) {
+			continue;
+		}
+		auto glyphs = RecognizedGlyphs(api, words.get(), text, scaleX, scaleY);
+		result.items.push_back({
+			std::move(text),
+			box,
+			std::move(glyphs),
+		});
+	} while (result.items.size() < kMaxWords && api.next(words.get(), kWord));
+	return result;
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_image_ocr_mac.mm b/Telegram/SourceFiles/tele/tele_image_ocr_mac.mm
new file mode 100644
index 0000000000000000000000000000000000000000..53d0965cb2a4309ada3d930e981cb7bb531095d1
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_image_ocr_mac.mm
@@ -0,0 +1,94 @@
+#include "tele/tele_image_ocr.h"
+
+#import <Foundation/Foundation.h>
+#import <Vision/Vision.h>
+
+namespace Tele::details {
+namespace {
+
+[[nodiscard]] QString &CurrentLanguage() {
+	thread_local auto language = QString();
+	return language;
+}
+
+[[nodiscard]] bool ConfigureRequest(
+		VNRecognizeTextRequest *request,
+		const QString &language) API_AVAILABLE(macos(10.15)) {
+	if (language != u"auto"_q
+		&& language != u"en"_q
+		&& language != u"ru"_q) {
+		return false;
+	}
+	request.recognitionLevel = VNRequestTextRecognitionLevelAccurate;
+	if (@available(macOS 13.0, *)) {
+		request.revision = VNRecognizeTextRequestRevision3;
+		request.automaticallyDetectsLanguage = (language == u"auto"_q);
+	} else if (@available(macOS 11.0, *)) {
+		request.revision = VNRecognizeTextRequestRevision2;
+	} else {
+		request.revision = VNRecognizeTextRequestRevision1;
+	}
+	NSError *error = nil;
+	NSArray<NSString*> *supported = nil;
+	if (@available(macOS 12.0, *)) {
+		supported = [request supportedRecognitionLanguagesAndReturnError:&error];
+	} else {
+		supported = [VNRecognizeTextRequest
+			supportedRecognitionLanguagesForTextRecognitionLevel:
+				request.recognitionLevel
+			revision:request.revision
+			error:&error];
+	}
+	if (!supported || error) {
+		return false;
+	}
+	NSMutableArray<NSString*> *languages = [NSMutableArray array];
+	if (language != u"ru"_q && [supported containsObject:@"en-US"]) {
+		[languages addObject:@"en-US"];
+	}
+	if (language != u"en"_q && [supported containsObject:@"ru-RU"]) {
+		[languages addObject:@"ru-RU"];
+	}
+	if (!languages.count) {
+		return false;
+	}
+	request.recognitionLanguages = languages;
+	return true;
+}
+
+}
+
+bool ImageOcrBackendAvailable(const QString &language) {
+	if (@available(macOS 10.15, *)) {
+		@autoreleasepool {
+			VNRecognizeTextRequest *request
+				= [[[VNRecognizeTextRequest alloc] init] autorelease];
+			return ConfigureRequest(request, language);
+		}
+	}
+	return false;
+}
+
+Platform::TextRecognition::Result RecognizeImageTextBackend(
+		const QImage &image,
+		const QString &language) {
+	const auto previous = std::exchange(CurrentLanguage(), language);
+	const auto restore = gsl::finally([&] {
+		CurrentLanguage() = previous;
+	});
+	return Platform::TextRecognition::RecognizeText(image);
+}
+
+bool ConfigureImageOcrRequest(void *request) {
+	if (CurrentLanguage().isEmpty()) {
+		return true;
+	}
+	if (@available(macOS 10.15, *)) {
+		return ConfigureRequest(
+			static_cast<VNRecognizeTextRequest*>(request),
+			CurrentLanguage());
+	}
+	return false;
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_image_ocr_win.cpp b/Telegram/SourceFiles/tele/tele_image_ocr_win.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4c893d5aa901b6e0fc97ebaaa43ff560ff312842
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_image_ocr_win.cpp
@@ -0,0 +1,163 @@
+#include "tele/tele_image_ocr.h"
+
+#include "base/platform/win/base_windows_winrt.h"
+#include "ui/style/style_core.h"
+
+#include <QPainter>
+#include <cstring>
+#include <winrt/Windows.Foundation.Collections.h>
+#include <winrt/Windows.Globalization.h>
+#include <winrt/Windows.Graphics.Imaging.h>
+#include <winrt/Windows.Media.Ocr.h>
+#include <winrt/Windows.Storage.Streams.h>
+
+namespace Tele::details {
+namespace {
+
+using namespace winrt::Windows::Graphics::Imaging;
+using namespace winrt::Windows::Media::Ocr;
+using namespace winrt::Windows::Storage::Streams;
+
+constexpr auto kMaxImageDimension = 4096;
+constexpr auto kMaxWords = 10000;
+
+class Apartment final {
+public:
+	Apartment() {
+		try {
+			winrt::init_apartment(winrt::apartment_type::multi_threaded);
+			_initialized = true;
+		} catch (const winrt::hresult_error &error) {
+			if (error.code() != RPC_E_CHANGED_MODE) {
+				throw;
+			}
+		}
+	}
+
+	~Apartment() {
+		if (_initialized) {
+			winrt::uninit_apartment();
+		}
+	}
+
+private:
+	bool _initialized = false;
+};
+
+[[nodiscard]] OcrEngine CreateEngine(const QString &language) {
+	if (language == u"auto"_q) {
+		return OcrEngine::TryCreateFromUserProfileLanguages();
+	} else if (language != u"en"_q && language != u"ru"_q) {
+		return nullptr;
+	}
+	for (const auto &candidate : OcrEngine::AvailableRecognizerLanguages()) {
+		const auto tag = candidate.LanguageTag();
+		const auto text = QString::fromWCharArray(tag.data(), int(tag.size()));
+		if (text == language
+			|| text.startsWith(language + u"-"_q, Qt::CaseInsensitive)) {
+			return OcrEngine::TryCreateFromLanguage(candidate);
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] Platform::TextRecognition::Result Recognize(
+		const QImage &image,
+		const QString &language) {
+	const auto apartment = Apartment();
+	const auto engine = CreateEngine(language);
+	if (!engine) {
+		return {};
+	}
+	const auto maxDimension = std::min(
+		kMaxImageDimension,
+		int(OcrEngine::MaxImageDimension()));
+	if (maxDimension <= 0) {
+		return {};
+	}
+	auto source = (std::max(image.width(), image.height()) > maxDimension)
+		? image.scaled(
+			maxDimension,
+			maxDimension,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation)
+		: image;
+	if (source.isNull()) {
+		return {};
+	}
+	source.setDevicePixelRatio(1.);
+	auto input = QImage(source.size(), QImage::Format_RGB32);
+	if (input.isNull()) {
+		return {};
+	}
+	input.fill(Qt::white);
+	{
+		auto painter = QPainter(&input);
+		painter.drawImage(QPoint(), source);
+	}
+	const auto size = uint32_t(input.sizeInBytes());
+	auto buffer = Buffer(size);
+	buffer.Length(size);
+	std::memcpy(buffer.data(), input.constBits(), size);
+	const auto bitmap = SoftwareBitmap::CreateCopyFromBuffer(
+		buffer,
+		BitmapPixelFormat::Bgra8,
+		input.width(),
+		input.height(),
+		BitmapAlphaMode::Ignore);
+	const auto recognized = engine.RecognizeAsync(bitmap).get();
+	const auto scaleX = double(image.width()) / input.width();
+	const auto scaleY = double(image.height()) / input.height();
+	const auto bounds = QRectF(QPointF(), QSizeF(input.size()));
+	auto result = Platform::TextRecognition::Result{ .success = true };
+	for (const auto &line : recognized.Lines()) {
+		for (const auto &word : line.Words()) {
+			const auto value = word.Text();
+			auto text = QString::fromWCharArray(value.data(), int(value.size()));
+			const auto box = word.BoundingRect();
+			const auto clipped = QRectF(
+				box.X,
+				box.Y,
+				box.Width,
+				box.Height).intersected(bounds);
+			if (text.isEmpty() || clipped.isEmpty()) {
+				continue;
+			}
+			result.items.push_back({
+				std::move(text),
+				QRect(
+					int(style::ConvertScale(clipped.x() * scaleX)),
+					int(style::ConvertScale(clipped.y() * scaleY)),
+					std::max(1, int(style::ConvertScale(clipped.width() * scaleX))),
+					std::max(1, int(style::ConvertScale(clipped.height() * scaleY)))),
+				{},
+			});
+			if (result.items.size() >= kMaxWords) {
+				return result;
+			}
+		}
+	}
+	return result;
+}
+
+}
+
+bool ImageOcrBackendAvailable(const QString &language) {
+	return base::WinRT::Try([&] {
+		const auto apartment = Apartment();
+		return bool(CreateEngine(language));
+	}).value_or(false);
+}
+
+Platform::TextRecognition::Result RecognizeImageTextBackend(
+		const QImage &image,
+		const QString &language) {
+	if (image.isNull()) {
+		return {};
+	}
+	return base::WinRT::Try([&] {
+		return Recognize(image, language);
+	}).value_or(Platform::TextRecognition::Result());
+}
+
+}
