+
+void RarityLabel::setRarity(QString text, std::vector<RarityPill> pills) {
+	_text = std::move(text);
+	_pills = std::move(pills);
+	update();
+}
+
+int RarityLabel::resizeGetHeight(int newWidth) {
+	return std::max(st::normalFont->height, RarityPillHeight());
+}
+
+void RarityLabel::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto &font = st::normalFont;
+	const auto skip = font->spacew;
+	auto pills = 0;
+	for (const auto &pill : _pills) {
+		pills += skip + RarityPillWidth(pill.text);
+	}
+	const auto available = std::max(width() - pills, 0);
+	const auto text = font->elided(_text, available);
+	p.setFont(font->f);
+	p.setPen(st::windowSubTextFg);
+	p.drawText(
+		0,
+		(height() - font->height) / 2 + font->ascent,
+		text);
+	auto left = font->width(text);
+	const auto top = (height() - RarityPillHeight()) / 2;
+	for (const auto &pill : _pills) {
+		left += skip;
+		PaintRarityPill(p, QPoint(left, top), pill.text, pill.color);
+		left += RarityPillWidth(pill.text);
+	}
+}
