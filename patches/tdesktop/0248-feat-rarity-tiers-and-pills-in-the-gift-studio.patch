+[[nodiscard]] Data::UniqueGiftRarity ParseTier(const QString &text) {
+	using Rarity = Data::UniqueGiftRarity;
+	const auto lower = text.trimmed().toLower();
+	return (lower == u"uncommon"_q)
+		? Rarity::Uncommon
+		: (lower == u"rare"_q)
+		? Rarity::Rare
+		: (lower == u"epic"_q)
+		? Rarity::Epic
+		: (lower == u"legendary"_q)
+		? Rarity::Legendary
+		: Rarity::Default;
+}
