+QColor RarityColor(int rarity) {
+	using Rarity = Data::UniqueGiftRarity;
+	return (rarity < int(Rarity::Default) && rarity >= int(Rarity::Legendary))
+		? Data::UniqueGiftRarityBadgeColors(Rarity(rarity)).fg
+		: QColor();
+}
+
+int RarityPillWidth(const QString &text) {
+	const auto &padding = st::msgTagBadgePadding;
+	return std::max(
+		padding.left() + st::normalFont->width(text) + padding.right(),
+		RarityPillHeight());
+}
+
+int RarityPillHeight() {
+	const auto &padding = st::msgTagBadgePadding;
+	return padding.top() + st::normalFont->height + padding.bottom();
+}
+
+void PaintRarityPill(
+		QPainter &p,
+		QPoint position,
+		const QString &text,
+		QColor color) {
+	if (!color.isValid()) {
+		color = st::windowSubTextFg->c;
+	}
+	const auto &font = st::normalFont;
+	const auto &padding = st::msgTagBadgePadding;
+	const auto width = RarityPillWidth(text);
+	const auto height = RarityPillHeight();
+	auto bg = color;
+	bg.setAlphaF(0.15);
+	p.setPen(Qt::NoPen);
+	p.setBrush(bg);
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.drawRoundedRect(
+			QRect(position, QSize(width, height)),
+			height / 2.,
+			height / 2.);
+	}
+	p.setFont(font->f);
+	p.setPen(color);
+	p.drawText(
+		position.x() + (width - font->width(text)) / 2,
+		position.y() + padding.top() + font->ascent,
+		text);
+}
