 .../boxes/peers/edit_bot_info_box_content.cpp          |  3 ++-
 .../boxes/peers/edit_bot_info_box_content.h            |  1 +
 4 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/Telegram/SourceFiles/boxes/peers/bot_info_language_button.cpp b/Telegram/SourceFiles/boxes/peers/bot_info_language_button.cpp
