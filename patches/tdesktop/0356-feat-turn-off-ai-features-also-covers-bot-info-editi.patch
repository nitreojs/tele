 			(*emoji)->attach(field);
 		},
 		.addAiButton = hideAi ? AddAi() : addAiButton,
+		.noTranslate = Tele::NoAi(),
 		.chooseImportFile = [=](Fn<void(QByteArray, QString)> done) {
 			FileDialog::GetOpenPath(
 				box.get(),
diff --git a/Telegram/SourceFiles/boxes/peers/edit_bot_info_box_content.cpp b/Telegram/SourceFiles/boxes/peers/edit_bot_info_box_content.cpp
index 94977b99ed9e0334a88c4df373eb185b2e932f4d..2e5f4c5629e78ca4ad32a7f3258e519f0e66816e 100644
