 			state->loadingAction->setEnabled(false);
 		}
 		menu->addSeparator();
-		menu->addAction(
-			tr::lng_bot_languages_translate(tr::now),
-			translate,
-			&st::menuIconTranslate);
+		if (translate) {
+			menu->addAction(
+				tr::lng_bot_languages_translate(tr::now),
+				translate,
+				&st::menuIconTranslate);
