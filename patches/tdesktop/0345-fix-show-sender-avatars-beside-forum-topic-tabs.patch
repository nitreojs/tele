From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Wed, 18 Nov 2026 02:40:04 +0300
Subject: [PATCH] fix: show sender avatars beside forum topic tabs

---
 Telegram/SourceFiles/history/history_widget.cpp  |  8 ++++++--
 .../history/view/history_view_chat_section.cpp   | 16 ++++++++++------
 2 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index da0a9756e4d94ac59003f5c372b3d308438000a9..dce0f2b6e850b3175d5234ab03bdf867dc7aec7c 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -10924,12 +10924,16 @@ void HistoryWidget::validateSubsectionTabs() {
 		_subsectionTabs = nullptr;
 		updateControlsGeometry();
 	}, _subsectionTabsLifetime);
+	const auto hideUserpics = [=] {
+		return (_subsectionTabs->leftSkip() > 0)
+			&& !(_history->peer->isMegagroup() && _history->peer->forum());
+	};
 	_subsectionTabs->layoutRequests() | rpl::on_next([=] {
-		_list->toggleRemoveFromUserpics(_subsectionTabs->leftSkip() > 0);
+		_list->toggleRemoveFromUserpics(hideUserpics());
 		updateControlsGeometry();
 		orderWidgets();
 	}, _subsectionTabsLifetime);
-	_list->toggleRemoveFromUserpics(_subsectionTabs->leftSkip() > 0);
+	_list->toggleRemoveFromUserpics(hideUserpics());
 	updateControlsGeometry();
 	orderWidgets();
 }
diff --git a/Telegram/SourceFiles/history/view/history_view_chat_section.cpp b/Telegram/SourceFiles/history/view/history_view_chat_section.cpp
index 40638483452882982849b9d9bd61907f8a8d8ccd..49bebb664747aeb2862585c518ccc541313b2e4f 100644
--- a/Telegram/SourceFiles/history/view/history_view_chat_section.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_chat_section.cpp
@@ -3045,17 +3045,21 @@ void ChatWidget::validateSubsectionTabs() {
 		_subsectionTabs = nullptr;
 		updateControlsGeometry();
 	}, _subsectionTabsLifetime);
+	const auto sidebarMode = [=]() -> std::optional<ElementChatMode> {
+		if (!_subsectionTabs->leftSkip()) {
+			return std::nullopt;
+		}
+		return (_peer->isMegagroup() && _peer->forum())
+			? ElementChatMode::Default
+			: ElementChatMode::Narrow;
+	};
 	_subsectionTabs->layoutRequests() | rpl::on_next([=] {
-		_inner->overrideChatMode((_subsectionTabs->leftSkip() > 0)
-			? ElementChatMode::Narrow
-			: std::optional<ElementChatMode>());
+		_inner->overrideChatMode(sidebarMode());
 		updateControlsGeometry();
 		updateSubsectionTabsGeometry();
 		orderWidgets();
 	}, _subsectionTabsLifetime);
-	_inner->overrideChatMode((_subsectionTabs->leftSkip() > 0)
-		? ElementChatMode::Narrow
-		: std::optional<ElementChatMode>());
+	_inner->overrideChatMode(sidebarMode());
 	updateControlsGeometry();
 	updateSubsectionTabsGeometry();
 	orderWidgets();
