+[[nodiscard]] TextWithEntities LeadingRichQuote(const Iv::RichPage &page) {
+	if (page.blocks.empty()) {
+		return {};
+	}
+	const auto &block = page.blocks.front();
+	using Kind = Iv::RichPage::BlockKind;
+	const auto plainRichText = [](const Iv::RichPage::RichText &text) {
+		return text.anchorId.isEmpty() && text.anchorIds.empty();
+	};
+	if (block.kind != Kind::Quote
+		|| !block.anchorId.isEmpty()
+		|| !plainRichText(block.text)
+		|| !plainRichText(block.caption)
+		|| !block.caption.text.empty()
+		|| block.pullquote) {
+		return {};
+	} else if (block.blocks.empty()) {
+		return block.text.text;
+	} else if (!block.text.text.empty()) {
+		return {};
+	}
+	auto result = TextWithEntities();
+	for (const auto &child : block.blocks) {
+		if (child.kind != Kind::Paragraph
+			|| !child.anchorId.isEmpty()
+			|| !plainRichText(child.text)
+			|| child.text.text.empty()) {
+			return {};
+		}
+		if (!result.empty()) {
+			result.append(QChar('\n'));
+		}
+		result.append(child.text.text);
+	}
+	return result;
+}
+
+[[nodiscard]] TextWithEntities LeadingTextQuote(
+		const TextWithEntities &body,
+		int &prefix) {
+	const auto first = ranges::find_if(body.entities, [](const auto &entity) {
+		return entity.offset() == 0 && entity.type() == EntityType::Blockquote;
+	});
+	if (first == body.entities.cend()) {
+		return {};
+	}
+	const auto length = first->length();
+	if (length <= 0 || length > body.text.size()) {
+		return {};
+	}
+	prefix = length;
+	while (prefix < body.text.size() && body.text.at(prefix) == QChar('\n')) {
+		++prefix;
+	}
+	auto result = TextWithEntities{ body.text.left(length) };
+	for (const auto &entity : body.entities) {
+		if (&entity == &*first || entity.offset() >= prefix) {
+			continue;
+		} else if (entity.type() == EntityType::Blockquote
+			|| entity.offset() + entity.length() > length) {
+			return {};
+		}
+		result.entities.push_back(entity);
+	}
+	return result;
+}
+
 } // namespace
 
+PromotedReplyQuote PromoteReplyQuote(
+		not_null<const HistoryItem*> item,
+		not_null<const HistoryMessageReply*> reply) {
+	if (!PromoteReplyQuotes()) {
+		return {};
+	}
+	const auto &fields = reply->fields();
+	const auto source = reply->resolvedMessage.get();
+	if (!source
+		|| source == item.get()
+		|| fields.manualQuote
+		|| !fields.quote.empty()
+		|| fields.richQuote
+		|| fields.todoItemId
+		|| !fields.pollOption.isEmpty()
+		|| item->groupId()
+		|| !item->computeUnavailableReason().isEmpty()
+		|| &item->translatedText() != &item->originalText()
+		|| &source->translatedText() != &source->originalText()) {
+		return {};
+	}
+	const auto page = source->richPage();
+	const auto model = page ? page->quoteModel.get() : nullptr;
+	if (!page || !source->computeUnavailableReason().isEmpty()) {
+		return {};
+	}
+	if (!model || model->partial() || source->translatedRichPage() != page) {
+		return {};
+	}
+	const auto body = item->richPage();
+	if (item->translatedRichPage() != body) {
+		return {};
+	}
+	auto prefix = 0;
+	auto quoted = body
+		? LeadingRichQuote(*body)
+		: LeadingTextQuote(item->originalText(), prefix);
+	const auto session = &item->history()->session();
+	const auto limit = session->appConfig().quoteLengthMax();
+	if (quoted.text.trimmed().isEmpty() || quoted.text.size() > limit) {
+		return {};
+	}
+	const auto &projection = model->projection();
+	const auto offset = projection.indexOf(quoted.text);
+	if (offset < 0 || projection.indexOf(quoted.text, offset + 1) >= 0) {
+		return {};
+	}
+	const auto built = Iv::BuildRichQuote(session, *page, {
+		.from = int(offset),
+		.till = int(offset + quoted.text.size()),
+	}, limit);
+	if (!built || built->offset != offset || built->overflown) {
+		return {};
+	}
+	auto quote = Iv::ParseRichQuote(session, built->fragments, built->offset);
+	Iv::Markdown::SortEntities(&quoted);
+	return (quote->text == quoted)
+		? PromotedReplyQuote{ std::move(quote), prefix, bool(body) }
+		: PromotedReplyQuote();
+}
