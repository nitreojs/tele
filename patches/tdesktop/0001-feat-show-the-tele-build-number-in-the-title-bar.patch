From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 26 Sep 2026 18:32:45 +0300
Subject: [PATCH] feat: show the tele build number in the title bar

---
 Telegram/CMakeLists.txt                     | 11 +++++++++++
 Telegram/SourceFiles/tele/tele_build.cpp    | 15 +++++++++++++++
 Telegram/SourceFiles/tele/tele_build.h      |  8 ++++++++
 Telegram/SourceFiles/window/main_window.cpp | 15 ++++++---------
 4 files changed, 40 insertions(+), 9 deletions(-)
 create mode 100644 Telegram/SourceFiles/tele/tele_build.cpp
 create mode 100644 Telegram/SourceFiles/tele/tele_build.h

diff --git a/Telegram/CMakeLists.txt b/Telegram/CMakeLists.txt
index 7ffda8f085b8917889f5c1b06edbef160d975c5b..f74561b2e01e394abb59ece2abf1f3c1e5f1e6c7 100644
--- a/Telegram/CMakeLists.txt
+++ b/Telegram/CMakeLists.txt
@@ -2366,6 +2366,17 @@ else()
     )
 endif()
 
+set(TELE_BUILD 0 CACHE STRING "tele release number, 0 for local builds")
+nice_target_sources(Telegram ${src_loc}
+PRIVATE
+    tele/tele_build.cpp
+    tele/tele_build.h
+)
+set_source_files_properties(${src_loc}/tele/tele_build.cpp
+PROPERTIES
+    COMPILE_DEFINITIONS TELE_BUILD=${TELE_BUILD}
+)
+
 if (NOT build_winstore)
     remove_target_sources(Telegram ${src_loc}
         platform/win/windows_start_task.cpp
diff --git a/Telegram/SourceFiles/tele/tele_build.cpp b/Telegram/SourceFiles/tele/tele_build.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cbe75951c5997381cca8d39d3a1ee133cc8fbabe
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_build.cpp
@@ -0,0 +1,15 @@
+#include "tele/tele_build.h"
+
+namespace Tele {
+
+int BuildNumber() {
+	return TELE_BUILD;
+}
+
+QString TitleLabel() {
+	return (BuildNumber() > 0)
+		? u"TELE #%1"_q.arg(BuildNumber())
+		: u"TELE DEV"_q;
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_build.h b/Telegram/SourceFiles/tele/tele_build.h
new file mode 100644
index 0000000000000000000000000000000000000000..2e2bceb142dfe499e63f170dc41128d275b365ea
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_build.h
@@ -0,0 +1,8 @@
+#pragma once
+
+namespace Tele {
+
+[[nodiscard]] int BuildNumber();
+[[nodiscard]] QString TitleLabel();
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/window/main_window.cpp b/Telegram/SourceFiles/window/main_window.cpp
index ae2b4949734e6c8826310c96b65f51b630ab600d..3e9c31e82428ccc21e46b6309eaee4df35f6168b 100644
--- a/Telegram/SourceFiles/window/main_window.cpp
+++ b/Telegram/SourceFiles/window/main_window.cpp
@@ -47,6 +47,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "apiwrap.h"
 #include "mainwidget.h" // session->content()->windowShown().
 #include "tray.h"
+#include "tele/tele_build.h"
 #include "styles/style_window.h"
 #include "styles/style_dialogs.h" // ChildSkip().x() for new child windows.
 
@@ -570,9 +571,7 @@ void MainWindow::init() {
 		}, lifetime());
 	}
 	refreshTitleWidget();
-	if constexpr (Core::BuildIsCanary) {
-		setupCanaryTitleLabel();
-	}
+	setupCanaryTitleLabel();
 
 	updateTitle();
 	updateWindowIcon();
@@ -703,7 +702,7 @@ void MainWindow::setupCanaryTitleLabel() {
 	const auto label = Ui::CreateTitleSubWidget(
 		title,
 		st::titleSubWidgetStyle,
-		rpl::single(Core::CanaryTitleLabel()),
+		rpl::single(Tele::TitleLabel()),
 		layout->value(
 		) | rpl::map([](const Ui::Platform::TitleLayout &layout) {
 			return layout.onLeft() ? style::al_right : style::al_left;
@@ -718,11 +717,9 @@ void MainWindow::setupCanaryTitleLabel() {
 }
 
 QString MainWindow::nativeTitleSuffix() const {
-	if constexpr (Core::BuildIsCanary) {
-		const auto title = titleWidget();
-		if (!title || title->isHidden()) {
-			return u" \u2022 "_q + Core::CanaryTitleLabel();
-		}
+	const auto title = titleWidget();
+	if (!title || title->isHidden()) {
+		return u" \u2022 "_q + Tele::TitleLabel();
 	}
 	return QString();
 }
