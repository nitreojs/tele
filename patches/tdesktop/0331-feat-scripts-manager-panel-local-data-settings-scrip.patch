+[[nodiscard]] std::optional<QCryptographicHash::Algorithm> HashAlgorithm(
+		JSContext *ctx,
+		JSValueConst value) {
+	auto size = std::size_t();
+	const auto text = JS_ToCStringLen(ctx, &size, value);
+	if (!text) {
+		return std::nullopt;
+	}
+	const auto name = std::string_view(text, size);
+	const auto result = (name == "sha1")
+		? std::make_optional(QCryptographicHash::Sha1)
+		: (name == "sha256")
+		? std::make_optional(QCryptographicHash::Sha256)
+		: (name == "sha384")
+		? std::make_optional(QCryptographicHash::Sha384)
+		: (name == "sha512")
+		? std::make_optional(QCryptographicHash::Sha512)
+		: std::nullopt;
+	JS_FreeCString(ctx, text);
+	return result;
+}
+
+[[nodiscard]] QByteArray BytesOf(JSContext *ctx, JSValueConst value) {
+	auto size = std::size_t();
+	const auto data = JS_GetUint8Array(ctx, &size, value);
+	return data
+		? QByteArray(reinterpret_cast<const char*>(data), int(size))
+		: QByteArray();
