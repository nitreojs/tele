+
+void ScriptRow::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	p.fillRect(e->rect(), isOver() ? st::windowBgOver : st::windowBg);
+	paintRipple(p, 0, 0);
+	const auto padding = st::boxRowPadding.left();
+	const auto size = style::ConvertScale(40);
+	const auto iconRect = QRect(padding, (height() - size) / 2, size, size);
+	_icon.paint(p, _state, iconRect);
+	const auto toggle = toggleRect();
+	_toggle.paint(p, toggle.x(), toggle.y(), width());
+	const auto left = iconRect.x() + size + padding;
+	const auto available = std::max(toggle.x() - left - padding, 0);
+	const auto lines = st::semiboldFont->height + st::normalFont->height;
+	const auto top = (height() - lines) / 2;
+	p.setFont(st::semiboldFont);
+	p.setPen(st::windowFg);
+	p.drawTextLeft(
+		left,
+		top,
+		width(),
+		st::semiboldFont->elided(_state.name, available));
+	p.setFont(st::normalFont);
+	p.setPen(StatusColor(_state));
+	p.drawTextLeft(
+		left,
+		top + st::semiboldFont->height,
+		width(),
+		st::normalFont->elided(StatusText(_state), available));
+}
