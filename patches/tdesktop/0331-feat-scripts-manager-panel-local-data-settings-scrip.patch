+QString ScriptInstallTarget(const QString &fileName) {
+	const auto name = QFileInfo(fileName).fileName();
+	const auto lower = name.toLower();
+	if (name.isEmpty()
+		|| name.startsWith('.')
+		|| !(lower.endsWith(u".ts"_q) || lower.endsWith(u".js"_q))) {
+		return QString();
+	}
+	return QDir(ScriptsFolder()).absoluteFilePath(name);
+}
