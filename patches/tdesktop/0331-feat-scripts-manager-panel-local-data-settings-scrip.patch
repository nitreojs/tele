+		? HashAlgorithm(ctx, argv[0])
+		: std::nullopt;
+	if (!algorithm) {
+		return JS_ThrowTypeError(
+			ctx,
+			"the hash is SHA-1, SHA-256, SHA-384 or SHA-512");
+	}
+	const auto result = QCryptographicHash::hash(
+		BytesOf(ctx, argv[1]),
+		*algorithm);
+	return JS_NewUint8ArrayCopy(
+		ctx,
+		reinterpret_cast<const uint8_t*>(result.constData()),
+		result.size());
+}
+
