+
+void Host::clearStorage(const QString &id) {
+	_storage.storage(id)->clear();
+	_storage.storage(id + u"\n#local"_q)->clear();
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i != end(_entries) && i->instance) {
+		start(*i, true);
+	}
+	_changes.fire({});
+}
