+void FillScript(
+		std::shared_ptr<Manager> manager,
+		not_null<Ui::VerticalLayout*> content,
+		const QString &id) {
+	const auto session = manager->session;
+	const auto body = content->add(object_ptr<Ui::VerticalLayout>(content));
+	const auto last = content->lifetime().make_state<
+		std::optional<ScriptState>>();
+	const auto rebuild = [=] {
+		const auto state = FindScript(session, id);
+		if (!state) {
+			ShowList(manager);
+			return;
+		} else if (*last == state) {
+			return;
+		}
+		*last = state;
+		manager->panel->setTitle(rpl::single(state->name));
+		body->clear();
+		AddHeader(body, *state);
+		AddStatus(manager, body, *state);
+		AddActions(manager, body, *state);
+		if (auto view = ScriptSettingsView(session, id)) {
+			Ui::AddSkip(body);
+			Ui::AddDivider(body);
+			Ui::AddSkip(body);
+			Ui::AddSubsectionTitle(body, rpl::single(Lower(u"Settings"_q)));
+			const auto settings = body->add(
+				object_ptr<Ui::VerticalLayout>(body));
+			FillScriptPage(settings, manager->show, std::move(*view), [] {});
+		}
+		AddPermissions(manager, body, *state);
+		AddStorage(manager, body, *state);
+		body->resizeToWidth(content->width());
+	};
+	rebuild();
+	AddLogPreview(manager, content, id);
+	ScriptsChanged(session) | rpl::on_next([=] {
+		crl::on_main(content, rebuild);
+	}, content->lifetime());
+}
+
+void ShowScript(std::shared_ptr<Manager> manager, const QString &id) {
+	if (!FindScript(manager->session, id)) {
+		ShowList(manager);
+		return;
+	}
+	manager->page = Page::Script;
+	manager->opened = id;
+	manager->pageMenu = nullptr;
+	const auto panel = manager->panel;
+	panel->setBackAllowed(true);
+	panel->showInner(MakePage(panel, nullptr, [=](
+			not_null<Ui::VerticalLayout*> content,
+			not_null<Ui::ScrollArea*>) {
+		FillScript(manager, content, id);
+	}));
+}
+
+void ShowLog(std::shared_ptr<Manager> manager, const QString &id) {
+	const auto state = FindScript(manager->session, id);
+	if (!state) {
+		ShowList(manager);
+		return;
+	}
+	const auto session = manager->session;
+	manager->page = Page::Log;
+	manager->opened = id;
+	const auto panel = manager->panel;
+	panel->setTitle(rpl::single(Lower(u"%1: log"_q).arg(state->name)));
+	panel->setBackAllowed(true);
+	struct State {
+		LogView *view = nullptr;
+		Ui::ScrollArea *scroll = nullptr;
+		LevelFilter filter = LevelFilter::All;
+		QString query;
+	};
+	const auto shared = std::make_shared<State>();
+	const auto apply = [=] {
+		if (shared->view) {
+			shared->view->setFilter(shared->filter, shared->query);
+			shared->scroll->scrollToY(shared->scroll->scrollTopMax());
+		}
+	};
+	manager->pageMenu = [=](const Ui::Menu::MenuCallback &add) {
+		add(Lower(u"Copy everything shown"_q), [=] {
+			if (shared->view) {
+				QGuiApplication::clipboard()->setText(
+					shared->view->shownText());
+				Toast(manager, Lower(u"Copied."_q));
+			}
+		}, &st::menuIconCopy);
+		add(Lower(u"Clear the log"_q), [=] {
+			ClearScriptLog(session, id);
+			if (shared->view) {
+				shared->view->setLines({});
+			}
+		}, &st::menuIconClear);
+	};
+	panel->showInner(MakePage(panel, [=](not_null<Ui::VerticalLayout*> top) {
+		const auto search = top->add(object_ptr<Ui::MultiSelect>(
+			top,
+			st::defaultMultiSelect,
+			rpl::single(Lower(u"Search the log"_q))));
+		search->setQueryChangedCallback([=](const QString &query) {
+			shared->query = query;
+			apply();
+		});
+		auto tabs = std::vector<Ui::SubTabs::Tab>();
+		for (const auto &[filter, name] : {
+				std::pair{ LevelFilter::All, u"All"_q },
+				std::pair{ LevelFilter::Info, u"Info"_q },
+				std::pair{ LevelFilter::Warnings, u"Warnings"_q },
+				std::pair{ LevelFilter::Errors, u"Errors"_q } }) {
+			tabs.push_back({
+				.id = LevelFilterId(filter),
+				.text = { Lower(name) },
+			});
+		}
+		const auto subtabs = top->add(
+			object_ptr<Ui::SubTabs>(
+				top,
+				st::defaultSubTabs,
+				Ui::SubTabs::Options{
+					.selected = LevelFilterId(LevelFilter::All),
+					.centered = true,
+				},
+				std::move(tabs)),
+			QMargins(
+				0,
+				st::boxRowPadding.left() / 2,
+				0,
+				st::boxRowPadding.left() / 2));
+		subtabs->activated(
+		) | rpl::on_next([=](const QString &tab) {
+			subtabs->setActiveTab(tab);
+			shared->filter = LevelFilterFromId(tab);
+			apply();
+		}, subtabs->lifetime());
+		crl::on_main(search, [=] {
+			search->setInnerFocus();
+		});
+	}, [=](
+			not_null<Ui::VerticalLayout*> content,
+			not_null<Ui::ScrollArea*> scroll) {
+		const auto view = content->add(object_ptr<LogView>(
+			content,
+			manager->show,
+			0));
+		shared->view = view;
+		shared->scroll = scroll;
+		view->setLines(ScriptLog(session, id));
+		ScriptLogChanges(
+			session
+		) | rpl::filter([=](const ScriptLogged &logged) {
+			return logged.id == id;
+		}) | rpl::on_next([=](const ScriptLogged &logged) {
+			const auto bottom = (scroll->scrollTop()
+				>= scroll->scrollTopMax() - st::lineWidth * 4);
+			view->append(logged.line);
+			if (bottom) {
+				scroll->scrollToY(scroll->scrollTopMax());
+			}
+		}, view->lifetime());
+		crl::on_main(view, [=] {
+			scroll->scrollToY(scroll->scrollTopMax());
+		});
+	}));
+}
+
+} // namespace
+
+void ShowScriptsManager(not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	auto &panels = Panels();
+	if (const auto i = panels.find(session); i != end(panels)) {
+		const auto panel = i->second.panel.get();
+		const auto state = panel->windowState();
+		if (state & Qt::WindowMinimized) {
+			panel->setWindowState(state & ~Qt::WindowMinimized);
+		}
+		panel->showAndActivate();
+		return;
+	}
+	auto owned = std::make_unique<Ui::SeparatePanel>();
+	const auto panel = owned.get();
+	panel->setWindowFlag(Qt::WindowStaysOnTopHint, false);
+	panel->setInnerSize(
+		QSize(style::ConvertScale(360), style::ConvertScale(420)),
+		true);
+	const auto wanted = LastSize().isEmpty()
+		? (panel->size() + QSize(
+			style::ConvertScale(80),
+			style::ConvertScale(220)))
+		: LastSize();
+	const auto grow = wanted - panel->size();
+	panel->setGeometry(panel->geometry().marginsAdded(QMargins(
+		grow.width() / 2,
+		grow.height() / 2,
+		grow.width() - grow.width() / 2,
+		grow.height() - grow.height() / 2)));
+	const auto manager = std::make_shared<Manager>(Manager{
+		.session = session,
+		.panel = panel,
+		.show = Main::MakeSessionShow(panel->uiShow(), session),
+	});
+	panels.emplace(session, Opened{
+		.panel = std::move(owned),
+		.manager = manager,
+	});
+	session->lifetime().add([=] {
+		Panels().remove(session);
+	});
+	panel->closeRequests(
+	) | rpl::on_next([=] {
+		panel->hideGetDuration();
+	}, panel->lifetime());
+	panel->closeEvents(
+	) | rpl::on_next([=] {
+		LastSize() = panel->size();
+		crl::on_main([=] {
+			Panels().remove(session);
+		});
+	}, panel->lifetime());
+	panel->backRequests(
+	) | rpl::on_next([=] {
+		if (manager->page == Page::Log) {
+			ShowScript(manager, manager->opened);
+		} else {
+			ShowList(manager);
+		}
+	}, panel->lifetime());
+	panel->setMenuAllowed([=](const Ui::Menu::MenuCallback &add) {
+		FillMenu(manager, add);
+	});
+	ShowList(manager);
+	panel->showAndActivate();
+}
