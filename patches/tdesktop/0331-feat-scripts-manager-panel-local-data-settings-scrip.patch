+void AddStorage(
+		std::shared_ptr<Manager> manager,
+		not_null<Ui::VerticalLayout*> body,
+		const ScriptState &state) {
+	const auto session = manager->session;
+	const auto id = state.id;
+	const auto usage = ScriptStorageInfo(session, id);
+	Ui::AddSkip(body);
+	Ui::AddDivider(body);
+	Ui::AddSkip(body);
+	Ui::AddSubsectionTitle(body, rpl::single(Lower(u"Storage"_q)));
+	body->add(
+		object_ptr<Ui::FlatLabel>(
+			body,
+			Lower(u"tg.storage: %1 keys, %2\nSaved ghost messages: %3, %4"_q)
+				.arg(usage.keys)
+				.arg(SizeText(usage.bytes))
+				.arg(usage.locals)
+				.arg(SizeText(usage.localBytes)),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+	if (!usage.keys && !usage.locals) {
+		return;
+	}
+	Settings::AddButtonWithIcon(
+		body,
+		rpl::single(Lower(u"Clear storage"_q) + QChar(0x2026)),
+		st::settingsAttentionButton
+	)->setClickedCallback([=] {
+		manager->show->show(Ui::MakeConfirmBox({
+			.text = Lower(u"Clear everything this script saved on this "
+				"account, including its saved ghost messages?"_q),
+			.confirmed = [=](Fn<void()> close) {
+				ClearScriptStorage(session, id);
+				close();
+			},
+			.confirmText = Lower(u"Clear"_q),
+			.confirmStyle = &st::attentionBoxButton,
+		}));
+	});
+}
