+bool Host::interceptForward(
+		Data::ResolvedForwardDraft &draft,
+		const Api::SendAction &action,
+		FnMut<void()> &done) {
+	const auto peer = action.history->peer;
+	if (draft.items.empty() || !holds(peer, u"forward"_q)) {
+		return false;
+	}
+	auto ids = std::vector<FullMsgId>();
+	for (const auto &item : draft.items) {
+		ids.push_back(item->fullId());
+	}
+	const auto options = draft.options;
+	const auto callback = std::make_shared<FnMut<void()>>(std::move(done));
+	const auto session = _session;
+	draft.items.clear();
+	hold(peer->id, std::make_shared<HeldSend>(HeldSend{
+		.data = SendData{
+			.kind = u"forward"_q,
+			.peer = peer,
+			.scheduled = action.options.scheduled,
+			.silent = action.options.silent,
+			.forwards = ids,
+		},
+		.replay = [=](const SendData &data) {
+			auto items = HistoryItemsList();
+			for (const auto &id : ids) {
+				if (const auto item = session->data().message(id)) {
+					items.push_back(item);
+				}
+			}
+			if (items.empty()) {
+				return;
+			}
+			auto copy = action;
+			ApplySend(copy, data, 0);
+			session->api().forwardMessages(
+				Data::ResolvedForwardDraft{
+					.items = std::move(items),
+					.options = options,
+				},
+				copy,
+				std::move(*callback));
+		},
+	}));
 	return true;
 }
 
