+			.kind = kind,
+			.text = message.textWithTags,
+			.peer = peer,
+			.replyTo = replyTo,
+			.scheduled = message.action.options.scheduled,
+			.silent = message.action.options.silent,
+			.document = document,
+			.photo = photo,
+		},
+		.initialReplyTo = replyTo,
+		.replay = [=](const SendData &data) {
+			auto copy = Api::MessageToSend(*original);
+			copy.textWithTags = data.text;
+			ApplySend(copy.action, data, replyTo);
+			if (document) {
+				Api::SendExistingDocument(
