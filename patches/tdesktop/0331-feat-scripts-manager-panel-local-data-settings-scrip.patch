+	case LevelFilter::Info: return u"info"_q;
+	case LevelFilter::Warnings: return u"warnings"_q;
+	case LevelFilter::Errors: return u"errors"_q;
+	}
+	Unexpected("Filter in Tele::Scripting::LevelFilterId.");
+}
+
+[[nodiscard]] LevelFilter LevelFilterFromId(const QString &id) {
+	for (const auto filter : {
+			LevelFilter::All,
+			LevelFilter::Info,
+			LevelFilter::Warnings,
+			LevelFilter::Errors }) {
+		if (LevelFilterId(filter) == id) {
+			return filter;
+		}
