+
+[[nodiscard]] QString ReadLiteral(const QString &text, int &i) {
+	const auto quote = text[i];
+	const auto size = int(text.size());
+	auto result = QString();
+	for (++i; i < size && text[i] != quote; ++i) {
+		if (text[i] != '\\' || i + 1 >= size) {
+			if (quote == '`' && text[i] == '$' && i + 1 < size
+				&& text[i + 1] == '{') {
+				return QString();
+			}
+			result += text[i];
+			continue;
+		}
+		const auto escaped = text[++i];
+		if (escaped == 'n') {
+			result += '\n';
+		} else if (escaped == 't') {
+			result += '\t';
+		} else if (escaped == 'u') {
+			const auto braced = (i + 1 < size) && (text[i + 1] == '{');
+			const auto from = i + (braced ? 2 : 1);
+			const auto till = braced ? int(text.indexOf('}', from)) : (from + 4);
+			auto ok = false;
+			const auto code = (till > from && till <= size)
+				? text.mid(from, till - from).toUInt(&ok, 16)
+				: 0U;
+			if (ok) {
+				const auto point = char32_t(code);
+				result += QString::fromUcs4(&point, 1);
+				i = braced ? till : (till - 1);
+			}
+		} else if (escaped != 'r') {
+			result += escaped;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] PeekedScript PeekScript(const QString &path) {
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	const auto text = QString::fromUtf8(file.read(kMaxPeekSize));
+	const auto start = text.indexOf(u"defineScript("_q);
+	const auto open = (start < 0) ? -1 : int(text.indexOf('{', start));
+	if (open < 0) {
+		return {};
+	}
+	auto result = PeekedScript();
+	const auto assign = [&](const QString &key, const QString &value) {
+		if (key == u"name"_q) {
+			result.name = value;
+		} else if (key == u"version"_q) {
+			result.meta.version = value;
+		} else if (key == u"description"_q) {
+			result.meta.description = value;
+		} else if (key == u"author"_q) {
+			result.meta.author = value;
+		} else if (key == u"icon"_q) {
+			result.meta.icon = value;
+		} else if (key == u"homepage"_q) {
+			result.meta.homepage = value;
+		}
+	};
+	const auto size = int(text.size());
+	const auto nextSolid = [&](int from) {
+		while (from < size && text[from].isSpace()) {
+			++from;
+		}
+		return from;
+	};
+	auto depth = 0;
+	auto key = QString();
+	auto expectValue = false;
+	auto inGrants = false;
+	auto previous = QChar('(');
+	for (auto i = open; i < size; ++i) {
+		const auto c = text[i];
+		if (c.isSpace()) {
+			continue;
+		} else if (c == '/' && i + 1 < size && text[i + 1] == '/') {
+			i = int(text.indexOf('\n', i));
+			if (i < 0) {
+				break;
+			}
+			continue;
+		} else if (c == '/' && i + 1 < size && text[i + 1] == '*') {
+			i = int(text.indexOf(u"*/"_q, i + 2));
+			if (i < 0) {
+				break;
+			}
+			++i;
+			continue;
+		} else if (c == '/' && QString(u"(,=:[!&|?{};"_q).contains(previous)) {
+			auto inClass = false;
+			for (++i; i < size; ++i) {
+				if (text[i] == '\\') {
+					++i;
+				} else if (text[i] == '[') {
+					inClass = true;
+				} else if (text[i] == ']') {
+					inClass = false;
+				} else if (text[i] == '/' && !inClass) {
+					break;
+				}
+			}
+			previous = 'x';
+			continue;
+		} else if (c == '\'' || c == '"' || c == '`') {
+			const auto value = ReadLiteral(text, i);
+			previous = 'x';
+			if (depth == 1 && !expectValue) {
+				const auto colon = nextSolid(i + 1);
+				if (colon < size && text[colon] == ':') {
+					key = value;
+					expectValue = true;
+					previous = ':';
+					i = colon;
+				}
+			} else if (depth == 1 && expectValue) {
+				assign(key, value);
+				expectValue = false;
+			} else if (depth == 2 && inGrants && !value.isEmpty()) {
+				result.grants.push_back(value);
+			}
+			continue;
+		} else if (depth == 1 && (c.isLetter() || c == '_' || c == '$')) {
+			auto end = i;
+			while (end < size
+				&& (text[end].isLetterOrNumber()
+					|| text[end] == '_'
+					|| text[end] == '$')) {
+				++end;
+			}
+			const auto word = text.mid(i, end - i);
+			const auto colon = nextSolid(end);
+			if (!expectValue && colon < size && text[colon] == ':') {
+				key = word;
+				expectValue = true;
+				previous = ':';
+				i = colon;
+			} else {
+				expectValue = false;
+				previous = 'x';
+				i = end - 1;
+			}
+			continue;
+		} else if (c == '{' || c == '[' || c == '(') {
+			if (depth == 1 && c == '[' && expectValue && key == u"grants"_q) {
+				inGrants = true;
+			}
+			++depth;
+			expectValue = false;
+		} else if (c == '}' || c == ']' || c == ')') {
+			if (--depth <= 0) {
+				break;
+			} else if (depth == 1) {
+				inGrants = false;
+			}
+		} else if (c == ',' && depth == 1) {
+			expectValue = false;
+		}
+		previous = c;
+	}
+	return result;
+}
