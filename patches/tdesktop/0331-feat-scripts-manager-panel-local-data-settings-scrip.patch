+JSValue Instance::NativeData(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	static constexpr auto names = std::array{
+		"tg.local.dialogs",
+		"tg.local.unread",
+		"tg.local.folders",
+		"tg.local.draft",
+	};
+	const auto local = (magic < int(names.size()));
+	const auto instance = !local
+		? From(ctx)
+		: Permitted(
+			ctx,
+			Capability::AccountRead,
+			(magic == 3) ? "draft" : "dialogs",
+			names[magic]);
+	if (!instance) {
+		return local
+			? JS_EXCEPTION
+			: JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = instance->_session;
+	const auto owner = &session->data();
+	const auto setInt = [&](JSValueConst object, const char *name, int value) {
+		JS_SetPropertyStr(ctx, object, name, JS_NewInt32(ctx, value));
+	};
+	if ((magic == 9 || magic == 10)
+		&& !instance->_permissions.allows(Capability::Scripts, {})) {
+		return ThrowNotGranted(
+			ctx,
+			(magic == 9) ? u"tg.scripts.emit"_q : u"tg.scripts.on"_q,
+			GrantText(Capability::Scripts, {}));
+	}
+	switch (magic) {
+	case 0: {
+		const auto options = (argc > 0) ? argv[0] : JS_UNDEFINED;
+		auto folder = JS_IsObject(options)
+			? JS_GetPropertyStr(ctx, options, "folder")
+			: JS_UNDEFINED;
+		auto limitValue = JS_IsObject(options)
+			? JS_GetPropertyStr(ctx, options, "limit")
+			: JS_UNDEFINED;
+		auto limit = int64_t(-1);
+		if (!JS_IsUndefined(limitValue)
+			&& (JS_ToInt64(ctx, &limit, limitValue) < 0 || limit < 0)) {
+			limit = -2;
+		}
+		JS_FreeValue(ctx, limitValue);
+		auto filterId = FilterId();
+		auto archive = false;
+		auto valid = (limit != -2);
+		if (JS_IsString(folder)) {
+			const auto name = FromStd(ToStd(ctx, folder));
+			archive = (name == u"archive"_q);
+			valid = valid && (archive || name == u"main"_q);
+		} else if (JS_IsNumber(folder)) {
+			auto id = int32_t();
+			JS_ToInt32(ctx, &id, folder);
+			filterId = FilterId(id);
+			valid = valid && ranges::contains(
+				owner->chatsFilters().list(),
+				filterId,
+				&Data::ChatFilter::id);
+		} else if (!JS_IsUndefined(folder)) {
+			valid = false;
+		}
+		JS_FreeValue(ctx, folder);
+		if (!valid) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.local.dialogs: folder is 'main', 'archive' or a folder "
+				"id from tg.local.folders(), limit is a number");
+		}
+		const auto list = filterId
+			? owner->chatsFilters().chatsList(filterId)
+			: owner->chatsList(archive
+				? owner->folderLoaded(Data::Folder::kId)
+				: nullptr);
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &row : *list->indexed()) {
+			if (limit >= 0 && index >= uint64_t(limit)) {
+				break;
+			}
+			const auto history = row->history();
+			if (!history) {
+				continue;
+			}
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"chat",
+				instance->peerInfo(history->peer));
+			setInt(item, "unread", history->unreadCount());
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"unreadMark",
+				JS_NewBool(ctx, history->unreadMark()));
+			setInt(item, "mentions", history->unreadMentions().count(0));
+			setInt(item, "reactions", history->unreadReactions().count(0));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"muted",
+				JS_NewBool(ctx, history->muted()));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"pinned",
+				JS_NewBool(ctx, history->isPinnedDialog(filterId)));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"archived",
+				JS_NewBool(ctx, history->folder() != nullptr));
+			setInt(item, "date", int(history->chatListTimeId()));
+			if (const auto last = history->chatListMessage()) {
+				JS_SetPropertyStr(
+					ctx,
+					item,
+					"lastMessageId",
+					JS_NewInt64(ctx, last->id.bare));
+			}
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 1: {
+		const auto state = owner->chatsList()->unreadState();
+		auto result = JS_NewObject(ctx);
+		setInt(result, "messages", state.messages);
+		setInt(result, "messagesMuted", state.messagesMuted);
+		setInt(result, "chats", state.chats);
+		setInt(result, "chatsMuted", state.chatsMuted);
+		setInt(result, "marks", state.marks);
+		setInt(result, "mentions", state.mentions);
+		setInt(result, "reactions", state.reactions);
+		setInt(result, "badge", owner->unreadBadge());
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"badgeMuted",
+			JS_NewBool(ctx, owner->unreadBadgeMuted()));
+		return result;
+	}
+	case 2: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &filter : owner->chatsFilters().list()) {
+			if (!filter.id()) {
+				continue;
+			}
+			auto item = JS_NewObject(ctx);
+			setInt(item, "id", int(filter.id()));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"title",
+				NewString(ctx, filter.title().text.text));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"emoji",
+				NewString(ctx, filter.iconEmoji()));
+			auto chats = JS_NewArray(ctx);
+			auto count = uint32_t();
+			const auto list = owner->chatsFilters().chatsList(filter.id());
+			for (const auto &row : *list->indexed()) {
+				if (const auto history = row->history()) {
+					JS_SetPropertyUint32(
+						ctx,
+						chats,
+						count++,
+						JS_NewBigInt64(ctx, MarkedId(history->peer->id)));
+				}
+			}
+			JS_SetPropertyStr(ctx, item, "chats", chats);
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 3: {
+		const auto id = (argc > 0)
+			? PeerFromValue(ctx, argv[0], session->user()->id)
+			: std::nullopt;
+		if (!id) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.local.draft needs a peer, an input peer or a marked id");
+		}
+		const auto history = owner->historyLoaded(*id);
+		const auto draft = history
+			? history->localDraft(MsgId(), PeerId())
+			: nullptr;
+		return (draft && !draft->textWithTags.text.isEmpty())
+			? TextValue(ctx, session, draft->textWithTags)
+			: JS_UNDEFINED;
+	}
+	case 4:
+	case 5: {
+		const auto toObject = [&](const SettingInfo &info) {
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, item, "id", NewString(ctx, info.id));
+			JS_SetPropertyStr(ctx, item, "name", NewString(ctx, info.name));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"description",
+				NewString(ctx, info.description));
+			JS_SetPropertyStr(ctx, item, "kind", NewString(ctx, info.kind));
+			if (!info.choices.isEmpty()) {
+				auto choices = JS_NewArray(ctx);
+				for (auto i = 0; i != info.choices.size(); ++i) {
+					JS_SetPropertyUint32(
+						ctx,
+						choices,
+						uint32_t(i),
+						NewString(ctx, info.choices[i]));
+				}
+				JS_SetPropertyStr(ctx, item, "choices", choices);
+			}
+			JS_SetPropertyStr(ctx, item, "value", SettingValue(ctx, info));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"restartRequired",
+				JS_NewBool(ctx, info.restartRequired));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"group",
+				NewString(ctx, GroupName(info.group)));
+			return item;
+		};
+		if (magic == 4) {
+			auto result = JS_NewArray(ctx);
+			auto index = uint32_t();
+			for (const auto &info : SettingsList()) {
+				JS_SetPropertyUint32(ctx, result, index++, toObject(info));
+			}
+			return result;
+		}
+		const auto found = (argc > 0 && JS_IsString(argv[0]))
+			? FindSetting(FromStd(ToStd(ctx, argv[0])))
+			: std::nullopt;
+		return found ? toObject(*found) : JS_UNDEFINED;
+	}
+	case 6: {
+		if (!instance->_permissions.allows(Capability::Options, {})) {
+			return ThrowNotGranted(
+				ctx,
+				u"tg.options.set"_q,
+				GrantText(Capability::Options, {}));
+		} else if (argc < 2 || !JS_IsString(argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.options.set(id, value)");
+		}
+		const auto id = FromStd(ToStd(ctx, argv[0]));
+		const auto value = JS_IsBool(argv[1])
+			? QJsonValue(JS_ToBool(ctx, argv[1]) != 0)
+			: JS_IsString(argv[1])
+			? QJsonValue(FromStd(ToStd(ctx, argv[1])))
+			: QJsonValue(QJsonValue::Undefined);
+		if (value.isUndefined()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.options.set: the value is a boolean or a string");
+		}
+		auto restart = false;
+		const auto error = ChangeSetting(id, value, restart);
+		if (!error.isEmpty()) {
+			const auto text = (u"tg.options.set: "_q + error).toStdString();
+			return JS_ThrowTypeError(ctx, "%s", text.c_str());
+		}
+		auto result = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, result, "restart", JS_NewBool(ctx, restart));
+		return result;
+	}
+	case 8: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &script : Scripts(session)) {
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, item, "id", NewString(ctx, script.id));
+			JS_SetPropertyStr(ctx, item, "name", NewString(ctx, script.name));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"version",
+				NewString(ctx, script.version));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"running",
+				JS_NewBool(ctx, script.running));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"self",
+				JS_NewBool(ctx, script.id == instance->_file.id));
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 9: {
+		if (argc < 1 || !JS_IsString(argv[0])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.scripts.emit(event, data?, { to? })");
+		}
+		const auto event = FromStd(ToStd(ctx, argv[0]));
+		JSValueConst args[] = { (argc > 1) ? argv[1] : JS_NULL };
+		auto text = CallGlobal(ctx, "__teleStore", args);
+		if (JS_IsException(text)) {
+			return text;
+		}
+		auto size = std::size_t();
+		const auto chars = JS_ToCStringLen(ctx, &size, text);
+		auto bytes = chars ? QByteArray(chars, int(size)) : QByteArray();
+		if (chars) {
+			JS_FreeCString(ctx, chars);
+		}
+		JS_FreeValue(ctx, text);
+		const auto target = (argc > 2 && JS_IsString(argv[2]))
+			? FromStd(ToStd(ctx, argv[2]))
+			: QString();
+		return JS_NewInt32(
+			ctx,
+			EmitScriptEvent(
+				session,
+				instance->_file.id,
+				instance->_name,
+				event,
+				bytes,
+				target));
+	}
+	case 10: {
+		if (argc < 2 || !JS_IsString(argv[0]) || !JS_IsFunction(ctx, argv[1])) {
+			return JS_ThrowTypeError(ctx, "tg.scripts.on(event, function)");
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = Kind::ScriptEvent,
+			.fn = JS_DupValue(ctx, argv[1]),
+			.key = FromStd(ToStd(ctx, argv[0])),
+		});
+		return instance->disposer(id);
+	}
+	case 11:
+		return instance->connectionValue(ctx);
+	case 14:
+		return JS_NewBool(ctx, owner->chatsListLoaded());
+	case 12:
+	case 13: {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(
+				ctx,
+				(magic == 12)
+					? "tg.onConnectionChange(function)"
+					: "tg.onWake(function)");
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = (magic == 12) ? Kind::Connection : Kind::Wake,
+			.fn = JS_DupValue(ctx, argv[0]),
+		});
+		if (magic == 12) {
+			instance->watchConnection();
+		} else {
+			instance->watchWake();
+		}
+		return instance->disposer(id);
+	}
+	case 7: {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.options.onChange(function)");
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = Kind::OptionChange,
+			.fn = JS_DupValue(ctx, argv[0]),
+		});
+		instance->watchOptions();
+		return instance->disposer(id);
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::connectionValue(JSContext *ctx) const {
+	const auto state = _session->account().mtp().dcstate();
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"state",
+		NewString(ctx, (state == MTP::ConnectedState)
+			? u"connected"_q
+			: (state < 0)
+			? u"waiting"_q
+			: u"connecting"_q));
+	if (state < 0) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"retryIn",
+			JS_NewInt32(ctx, ((-state) / 1000) + 1));
+	}
+	return result;
+}
+
+void Instance::watchConnection() {
+	if (_watchingConnection) {
+		return;
+	}
+	_watchingConnection = true;
+	const auto name = [=] {
+		const auto state = _session->account().mtp().dcstate();
+		return (state == MTP::ConnectedState)
+			? u"connected"_q
+			: (state < 0)
+			? u"waiting"_q
+			: u"connecting"_q;
+	};
+	_lastConnection = name();
+	Core::App().settings().proxy().connectionTypeChanges(
+	) | rpl::on_next([=] {
+		crl::on_main(this, [=] {
+			const auto now = name();
+			if (!_engine || now == _lastConnection) {
+				return;
+			}
+			_lastConnection = now;
+			callRegistered(
+				Kind::Connection,
+				connectionValue(_engine->ctx()),
+				u"onConnectionChange"_q);
+		});
+	}, _connectionLifetime);
+}
+
+void Instance::watchWake() {
+	if (_wakeTimer) {
+		return;
+	}
+	_lastBeat = QDateTime::currentMSecsSinceEpoch();
+	_wakeTimer = std::make_unique<base::Timer>([=] { checkWake(); });
+	_wakeTimer->callEach(kWakeBeat);
+	Core::App().systemSleepEvents(
+	) | rpl::on_next([=] {
+		crl::on_main(this, [=] {
+			checkWake();
+		});
+	}, _connectionLifetime);
+}
+
+void Instance::checkWake() {
+	const auto now = QDateTime::currentMSecsSinceEpoch();
+	const auto slept = now - _lastBeat - kWakeBeat;
+	_lastBeat = now;
+	if (slept < kWakeGap || !_engine) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto payload = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, payload, "sleptFor", JS_NewInt64(ctx, slept));
+	callRegistered(Kind::Wake, payload, u"onWake"_q);
+}
+
+bool Instance::listens(const QString &event) const {
+	return ranges::any_of(_registrations, [&](const auto &pair) {
+		return (pair.second.kind == Kind::ScriptEvent)
+			&& (pair.second.key == event);
+	});
+}
+
+void Instance::receive(
+		const QString &event,
+		const QByteArray &payload,
+		const QString &fromId,
+		const QString &fromName) {
+	crl::on_main(this, [=] {
+		if (!_engine) {
+			return;
+		}
+		const auto ctx = _engine->ctx();
+		auto fns = std::vector<JSValue>();
+		for (const auto &[key, registration] : _registrations) {
+			if (registration.kind == Kind::ScriptEvent
+				&& registration.key == event) {
+				fns.push_back(JS_DupValue(ctx, registration.fn));
+			}
+		}
+		if (fns.empty()) {
+			return;
+		}
+		auto text = JS_NewStringLen(ctx, payload.constData(), payload.size());
+		JSValueConst loadArgs[] = { text };
+		auto data = CallGlobal(ctx, "__teleLoad", loadArgs);
+		JS_FreeValue(ctx, text);
+		if (JS_IsException(data)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			data = JS_NULL;
+		}
+		auto from = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, from, "id", NewString(ctx, fromId));
+		JS_SetPropertyStr(ctx, from, "name", NewString(ctx, fromName));
+		for (const auto fn : fns) {
+			if (!_engine) {
+				break;
+			}
+			JSValueConst args[] = { data, from };
+			JS_FreeValue(ctx, invoke(fn, args, kListenerBudget, u"scripts.on"_q));
+		}
+		if (_engine) {
+			release(fns);
+			JS_FreeValue(ctx, data);
+			JS_FreeValue(ctx, from);
+			_engine->drain();
+		}
+	});
+}
+
+void Instance::watchOptions() {
+	if (_watchingOptions) {
