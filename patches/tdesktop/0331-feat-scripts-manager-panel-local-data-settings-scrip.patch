+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+	void contextMenuEvent(QContextMenuEvent *e) override;
+
+	[[nodiscard]] bool shown(const ScriptLogLine &line) const;
+	[[nodiscard]] int textLeft() const;
+	[[nodiscard]] int rowHeight(const ScriptLogLine &line, int width) const;
+	[[nodiscard]] int rowAt(int y) const;
+	[[nodiscard]] int emptyHeight() const;
+	void relayout();
+	void setSelected(int selected);
+	void copy(const QString &text);
