+			onConnectionChange(callback) {
+				return given.onConnectionChange(callback);
+			},
+			onWake(callback) {
+				return given.onWake(callback);
+			},
+			schedule(when, callback) {
+				const DAILY = /^([01]?\d|2[0-3]):([0-5]\d)$/;
+				const every = when?.every;
+				const daily = when?.daily;
+				const at = (when?.at instanceof Date) ? when.at.getTime() : when?.at;
+				const kinds = [every, daily, at].filter((value) => value !== undefined).length;
+				if (typeof callback !== 'function'
+					|| kinds !== 1
+					|| (every !== undefined && !(Number.isFinite(every) && every >= 1000))
+					|| (daily !== undefined && !DAILY.test(String(daily)))
+					|| (at !== undefined && !Number.isFinite(at))) {
+					throw new TypeError("tg.schedule({ every: ms >= 1000 } | { daily: 'HH:MM' } | { at: Date | ms }, function)");
+				}
+				const nextDaily = (from) => {
+					const [, hours, minutes] = DAILY.exec(daily);
+					const next = new Date(from);
+					next.setHours(Number(hours), Number(minutes), 0, 0);
+					if (next.getTime() <= from) {
+						next.setDate(next.getDate() + 1);
+					}
+					return next.getTime();
+				};
+				let due = (at !== undefined) ? at : (every !== undefined) ? (Date.now() + every) : nextDaily(Date.now());
+				let timer = 0;
+				let stopped = false;
+				const arm = () => {
+					if (stopped) {
+						return;
+					}
+					const left = due - Date.now();
+					if (left > 0) {
+						timer = setTimeout(arm, Math.min(left, 60_000));
+						return;
+					}
+					const firedAt = Date.now();
+					due = (every !== undefined) ? (firedAt + every) : (daily !== undefined) ? nextDaily(firedAt) : Infinity;
+					if (due !== Infinity) {
+						timer = setTimeout(arm, Math.min(due - firedAt, 60_000));
+					} else {
+						stopped = true;
+					}
+					callback(new Date(firedAt));
+				};
+				arm();
+				const dispose = () => {
+					stopped = true;
+					clearTimeout(timer);
+				};
+				return Object.assign(dispose, { [Symbol.dispose]: dispose });
+			},
+
+			scripts: (() => {
+				const RESERVED = '\u0000';
+				const exposed = new Map();
+				const pending = new Map();
+				let serving = false;
+				let awaiting = false;
+				let nextCall = 0;
+				const checkEvent = (event) => {
+					if (typeof event !== 'string' || event.startsWith(RESERVED)) {
+						throw new TypeError('a script event is a string that doesn\'t start with \\u0000');
+					}
+					return event;
+				};
+				const serve = () => {
+					if (serving) {
+						return;
+					}
+					serving = true;
+					given.scriptsOn(RESERVED + 'call', async (request, from) => {
+						const reply = (answer) => given.scriptsEmit(RESERVED + 'reply', { id: request.id, ...answer }, from.id);
+						const handler = exposed.get(request.name);
+						if (!handler) {
+							reply({ ok: false, code: 'not-found', error: `${request.name} isn't exposed` });
+							return;
+						}
+						try {
+							reply({ ok: true, value: (await handler({ args: request.args, from })) ?? null });
+						} catch (error) {
+							reply({ ok: false, code: 'internal', error: String(error?.message ?? error) });
+						}
+					});
+				};
+				const listen = () => {
+					if (awaiting) {
+						return;
+					}
+					awaiting = true;
+					given.scriptsOn(RESERVED + 'reply', (answer) => {
+						const call = pending.get(answer.id);
+						if (!call) {
+							return;
+						}
+						pending.delete(answer.id);
+						clearTimeout(call.timer);
+						if (answer.ok) {
+							call.resolve(answer.value);
+						} else {
+							call.reject(new TeleError(answer.code, answer.error));
+						}
+					});
+				};
+				return Object.freeze({
+					list() {
+						return given.scriptsList();
+					},
+					emit(event, data, options) {
+						return given.scriptsEmit(checkEvent(event), (data === undefined) ? null : data, options?.to ?? null);
+					},
+					on(event, callback) {
+						return given.scriptsOn(checkEvent(event), callback);
+					},
+					expose(name, handler) {
+						if (typeof name !== 'string' || typeof handler !== 'function') {
+							throw new TypeError('tg.scripts.expose(name, handler)');
+						}
+						serve();
+						exposed.set(name, handler);
+						const dispose = () => {
+							if (exposed.get(name) === handler) {
+								exposed.delete(name);
+							}
+						};
+						return Object.assign(dispose, { [Symbol.dispose]: dispose });
+					},
+					call(target, name, ...args) {
+						if (typeof target !== 'string' || typeof name !== 'string') {
+							throw new TypeError('tg.scripts.call(scriptId, name, ...args)');
+						}
+						listen();
+						const id = ++nextCall;
+						const { promise, resolve, reject } = Promise.withResolvers();
+						const delivered = given.scriptsEmit(RESERVED + 'call', { id, name, args }, target);
+						if (!delivered) {
+							reject(new TeleError('not-found', `${target} isn't running or exposes nothing`));
+							return promise;
+						}
+						const timer = setTimeout(() => {
+							pending.delete(id);
+							reject(new TeleError('timed-out', `${target} didn't answer ${name} in 30 s`));
+						}, 30_000);
+						pending.set(id, { resolve, reject, timer });
+						return promise;
+					},
+				});
+			})(),
+
+			options: Object.freeze({
+				list() {
+					return given.optionsList();
+				},
+				get(id) {
+					return given.optionsGet(id);
+				},
+				set(id, value) {
+					return given.optionsSet(id, value);
+				},
+				onChange(id, callback) {
+					if (typeof id === 'function') {
+						return given.optionsOnChange(id);
+					}
+					if (typeof callback !== 'function') {
+						throw new TypeError('tg.options.onChange(id?, function)');
+					}
+					return given.optionsOnChange((change) => {
+						if (change.id === id) {
+							callback(change);
+						}
+					});
+				},
+			}),
+
 			registerShortcut(keys, callback) {
 				return given.registerShortcut(keys, callback);
 			},
