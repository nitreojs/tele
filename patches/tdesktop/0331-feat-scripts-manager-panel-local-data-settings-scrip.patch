+
+[[nodiscard]] base::unique_qptr<Ui::RpWidget> MakePage(
+		not_null<QWidget*> parent,
+		Fn<void(not_null<Ui::VerticalLayout*>)> fillTop,
+		Fn<void(
+			not_null<Ui::VerticalLayout*>,
+			not_null<Ui::ScrollArea*>)> fill) {
+	auto result = base::make_unique_q<Ui::RpWidget>(parent);
+	const auto raw = result.get();
+	const auto top = Ui::CreateChild<Ui::VerticalLayout>(raw);
+	const auto scroll = Ui::CreateChild<Ui::ScrollArea>(raw, st::boxScroll);
+	const auto content = scroll->setOwnedWidget(
+		object_ptr<Ui::VerticalLayout>(scroll));
+	top->paintRequest(
+	) | rpl::on_next([=](QRect clip) {
+		auto p = QPainter(top);
+		p.fillRect(clip, st::windowBg);
+		if (top->height() > 0) {
+			p.fillRect(
+				0,
+				top->height() - st::lineWidth,
+				top->width(),
+				st::lineWidth,
+				st::shadowFg);
+		}
+	}, top->lifetime());
+	rpl::combine(
+		raw->sizeValue(),
+		top->heightValue()
+	) | rpl::on_next([=](QSize size, int height) {
+		top->resizeToWidth(size.width());
+		top->moveToLeft(0, 0);
+		scroll->setGeometry(
+			0,
+			height,
+			size.width(),
+			std::max(size.height() - height, 0));
+		content->resizeToWidth(size.width());
+	}, raw->lifetime());
+	if (fillTop) {
+		fillTop(top);
+	}
+	fill(content, scroll);
+	return result;
+}
