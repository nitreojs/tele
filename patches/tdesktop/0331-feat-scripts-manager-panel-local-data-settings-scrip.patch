+
+[[nodiscard]] QString FilterId(Filter filter) {
+	switch (filter) {
+	case Filter::All: return u"all"_q;
+	case Filter::On: return u"on"_q;
+	case Filter::Off: return u"off"_q;
+	case Filter::Problems: return u"problems"_q;
+	}
+	Unexpected("Filter in Tele::Scripting::FilterId.");
+}
+
+[[nodiscard]] Filter FilterFromId(const QString &id) {
+	for (const auto filter : {
+			Filter::All,
+			Filter::On,
+			Filter::Off,
+			Filter::Problems }) {
+		if (FilterId(filter) == id) {
+			return filter;
+		}
+	}
+	return Filter::All;
+}
+
+[[nodiscard]] bool Matches(Filter filter, const ScriptState &state) {
+	switch (filter) {
+	case Filter::All: return true;
+	case Filter::On: return state.enabled;
+	case Filter::Off: return !state.enabled;
+	case Filter::Problems: return state.approval || !state.error.isEmpty();
+	}
+	return true;
+}
+
+[[nodiscard]] bool MatchesQuery(
+		const QString &query,
+		const ScriptState &state) {
+	for (const auto &word : query.split(' ', Qt::SkipEmptyParts)) {
+		const auto found = state.name.contains(word, Qt::CaseInsensitive)
+			|| state.id.contains(word, Qt::CaseInsensitive)
+			|| state.description.contains(word, Qt::CaseInsensitive)
+			|| state.author.contains(word, Qt::CaseInsensitive);
+		if (!found) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QString StatusText(const ScriptState &state) {
+	if (state.approval) {
+		return Lower(u"Waiting for your approval"_q);
+	} else if (!state.error.isEmpty()) {
+		return state.error;
+	} else if (!state.description.isEmpty()) {
+		return state.description;
+	} else if (state.running) {
+		return Lower(u"Running"_q);
+	}
+	return state.enabled ? Lower(u"Starting"_q) : Lower(u"Off"_q);
+}
+
+[[nodiscard]] const style::color &StatusColor(const ScriptState &state) {
+	return state.approval
+		? st::windowActiveTextFg
+		: !state.error.isEmpty()
+		? st::boxTextFgError
+		: st::windowSubTextFg;
+}
+
+[[nodiscard]] QString ShownPath(const QString &path) {
+	auto native = QDir::toNativeSeparators(QDir::cleanPath(path));
+	if (native.size() <= kShownPathLength) {
+		return native;
+	}
+	const auto tail = kShownPathLength * 2 / 3;
+	const auto head = kShownPathLength - tail - 1;
+	return native.left(head) + QChar(0x2026) + native.right(tail);
+}
+
+[[nodiscard]] QString SizeText(qint64 bytes) {
+	return (bytes < 1024)
+		? Lower(u"%1 B"_q).arg(bytes)
+		: (bytes < 1024 * 1024)
+		? Lower(u"%1 KB"_q).arg(bytes / 1024., 0, 'f', 1)
+		: Lower(u"%1 MB"_q).arg(bytes / (1024. * 1024.), 0, 'f', 1);
+}
+
+[[nodiscard]] const style::color &IconBg(const QString &id) {
+	const auto colors = std::array{
+		&st::settingsIconBg1,
+		&st::settingsIconBg2,
+		&st::settingsIconBg3,
+		&st::settingsIconBg4,
+		&st::settingsIconBg5,
+		&st::settingsIconBg6,
+		&st::settingsIconBg8,
+	};
+	return *colors[qHash(id) % colors.size()];
+}
