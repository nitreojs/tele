+void Install(
+		std::shared_ptr<Manager> manager,
+		const QString &name,
+		const QByteArray &bytes) {
+	const auto target = ScriptInstallTarget(name);
+	if (target.isEmpty()) {
+		Toast(manager, Lower(u"A script is a .ts or .js file."_q));
+		return;
+	}
+	const auto shown = QFileInfo(target).fileName();
+	const auto write = [=] {
+		const auto error = InstallScript(name, bytes);
+		Toast(manager, error.isEmpty()
+			? Lower(u"Installed %1. It stays off until you turn it on."_q)
+				.arg(shown)
+			: error);
+	};
+	if (!QFile::exists(target)) {
+		write();
+		return;
+	}
+	manager->show->show(Ui::MakeConfirmBox({
+		.text = Lower(u"%1 is already in the scripts folder. "
+			"Replace it?"_q).arg(shown),
+		.confirmed = [=](Fn<void()> close) {
+			write();
+			close();
+		},
+		.confirmText = Lower(u"Replace"_q),
+	}));
+}
+
+void InstallFromFile(std::shared_ptr<Manager> manager) {
+	FileDialog::GetOpenPath(
+		manager->panel.get(),
+		Lower(u"Install a script"_q),
+		u"Scripts (*.ts *.js)"_q,
+		[=](FileDialog::OpenResult &&result) {
+			if (result.paths.isEmpty()) {
+				return;
+			}
+			const auto path = result.paths.front();
+			auto file = QFile(path);
+			if (!file.open(QIODevice::ReadOnly)) {
+				Toast(manager, Lower(u"Can't read %1."_q).arg(
+					QDir::toNativeSeparators(path)));
+				return;
+			}
+			Install(manager, QFileInfo(path).fileName(), file.readAll());
+		});
+}
+
+void Download(std::shared_ptr<Manager> manager, const QUrl &url) {
+	if (!manager->network) {
+		manager->network = std::make_unique<QNetworkAccessManager>();
+	}
+	auto request = QNetworkRequest(url);
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(30 * 1000);
+	const auto reply = manager->network->get(request);
+	Toast(manager, Lower(u"Downloading %1\u2026"_q).arg(url.fileName()));
+	QObject::connect(reply, &QNetworkReply::downloadProgress, reply, [=](
+			qint64 received,
+			qint64 total) {
+		if (received > kMaxDownload) {
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		reply->deleteLater();
+		if (reply->error() != QNetworkReply::NoError) {
+			Toast(manager, Lower(u"Can't download it: %1"_q).arg(
+				reply->errorString()));
+			return;
+		}
+		const auto name = reply->url().fileName();
+		Install(manager, name.isEmpty() ? url.fileName() : name, reply->readAll());
+	});
+}
+
+void InstallFromLink(std::shared_ptr<Manager> manager) {
+	manager->show->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(Lower(u"Install from a link"_q)));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"A direct link to a .ts or .js file. It goes into "
+				"the scripts folder and stays off until you turn it on."_q),
+			st::boxDividerLabel));
+		Ui::AddSkip(box->verticalLayout());
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(u"https://example.com/script.ts"_q)));
+		box->setFocusCallback([=] {
+			field->setFocusFast();
+		});
+		const auto submit = [=] {
+			const auto url = QUrl(field->getLastText().trimmed());
+			const auto scheme = url.scheme().toLower();
+			if (!url.isValid()
+				|| (scheme != u"http"_q && scheme != u"https"_q)) {
+				field->showError();
+				return;
+			}
+			box->closeBox();
+			Download(manager, url);
+		};
+		field->submits() | rpl::on_next(submit, field->lifetime());
+		box->addButton(rpl::single(Lower(u"Install"_q)), submit);
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
