+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto algorithm = (argc > 2)
+		? HashAlgorithm(ctx, argv[0])
+		: std::nullopt;
+	if (!algorithm) {
+		return JS_ThrowTypeError(
+			ctx,
+			"the hash is SHA-1, SHA-256, SHA-384 or SHA-512");
+	}
+	const auto result = QMessageAuthenticationCode::hash(
+		BytesOf(ctx, argv[2]),
+		BytesOf(ctx, argv[1]),
+		*algorithm);
+	return JS_NewUint8ArrayCopy(
+		ctx,
+		reinterpret_cast<const uint8_t*>(result.constData()),
