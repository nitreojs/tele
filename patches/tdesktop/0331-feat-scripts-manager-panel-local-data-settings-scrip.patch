+void FillScriptPage(
+		not_null<Ui::VerticalLayout*> container,
+		std::shared_ptr<Ui::Show> show,
+		ScriptPageView view,
+		Fn<void()> close) {
+	const auto state = std::make_shared<ScriptPageView>(std::move(view));
+	const auto inner = container->add(
+		object_ptr<Ui::VerticalLayout>(container));
+	const auto rows = inner->lifetime().make_state<
+		std::vector<std::unique_ptr<rpl::variable<PageRow>>>>();
+	const auto structure = inner->lifetime().make_state<
+		std::vector<QString>>();
+	const auto rebuild = std::make_shared<Fn<void()>>();
+	*rebuild = [=] {
+		const auto rendered = state->render();
+		if (!rendered) {
+			close();
+			return;
+		}
+		auto keys = std::vector<QString>();
+		for (const auto &row : *rendered) {
+			keys.push_back(StructureKey(row));
+		}
+		if (keys == *structure) {
+			for (auto i = 0; i != int(rendered->size()); ++i) {
+				*(*rows)[i] = (*rendered)[i];
+			}
+			return;
+		}
+		*structure = std::move(keys);
+		inner->clear();
+		rows->clear();
+		for (auto i = 0; i != int(rendered->size()); ++i) {
+			rows->push_back(
+				std::make_unique<rpl::variable<PageRow>>((*rendered)[i]));
+			AddPageRow(
+				inner,
+				show,
+				state->script,
+				rows->back().get(),
+				[=](QVariant value) { state->event(i, value); },
+				[=](double value) { return state->label(i, value); });
+		}
+		inner->resizeToWidth(container->width());
+	};
+	(*rebuild)();
+	std::move(state->invalidated) | rpl::on_next([=] {
+		crl::on_main(inner, [=] {
+			(*rebuild)();
+		});
+	}, inner->lifetime());
+	std::move(state->closed) | rpl::on_next(close, inner->lifetime());
