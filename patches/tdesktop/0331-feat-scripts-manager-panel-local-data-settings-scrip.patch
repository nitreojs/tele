+void Host::revoke(const QString &id, const QString &grant) {
+	const auto i = _grants.find(id);
+	if (i == end(_grants) || !i->second.removeAll(grant)) {
+		return;
+	}
+	write();
+	const auto j = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (j != end(_entries)) {
+		start(*j, true);
+	}
+	_changes.fire({});
+}
