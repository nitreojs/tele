+
+void FillList(
+		std::shared_ptr<Manager> manager,
+		not_null<Ui::VerticalLayout*> top,
+		not_null<Ui::VerticalLayout*> content) {
+	const auto session = manager->session;
+	const auto search = top->add(object_ptr<Ui::MultiSelect>(
+		top,
+		st::defaultMultiSelect,
+		rpl::single(Lower(u"Search scripts"_q)),
+		manager->query));
+	auto tabs = std::vector<Ui::SubTabs::Tab>();
+	for (const auto &[filter, name] : {
+			std::pair{ Filter::All, u"All"_q },
+			std::pair{ Filter::On, u"On"_q },
+			std::pair{ Filter::Off, u"Off"_q },
+			std::pair{ Filter::Problems, u"Need attention"_q } }) {
+		tabs.push_back({
+			.id = FilterId(filter),
+			.text = { Lower(name) },
+		});
+	}
+	const auto subtabs = top->add(
+		object_ptr<Ui::SubTabs>(
+			top,
+			st::defaultSubTabs,
+			Ui::SubTabs::Options{
+				.selected = FilterId(manager->filter),
+				.centered = true,
+			},
+			std::move(tabs)),
+		QMargins(
+			0,
+			st::boxRowPadding.left() / 2,
+			0,
+			st::boxRowPadding.left() / 2));
+	const auto list = content->add(object_ptr<Ui::VerticalLayout>(content));
+	Ui::AddSkip(content);
+	Ui::AddDividerText(
+		content,
+		rpl::single(Lower(u"Scripts live in %1 and run separately for each "
+			"account. A new one stays off until you turn it on here; "
+			"saving a script restarts it. Files and folders starting "
+			"with _ are skipped, keep shared helpers there."_q).arg(
+				ShownPath(ScriptsFolder()))));
+
+	const auto ids = content->lifetime().make_state<std::vector<QString>>();
+	const auto rows = content->lifetime().make_state<
+		std::vector<not_null<ScriptRow*>>>();
+	const auto refresh = [=] {
+		const auto all = Scripts(session);
+		auto scripts = std::vector<ScriptState>();
+		for (const auto &script : all) {
+			if (Matches(manager->filter, script)
+				&& MatchesQuery(manager->query, script)) {
+				scripts.push_back(script);
+			}
+		}
+		auto now = std::vector<QString>();
+		for (const auto &script : scripts) {
+			now.push_back(script.id);
+		}
+		if (now == *ids && !now.empty()) {
+			for (auto i = 0; i != int(scripts.size()); ++i) {
+				(*rows)[i]->setState(scripts[i]);
+			}
+			return;
+		}
+		*ids = std::move(now);
+		rows->clear();
+		list->clear();
+		if (scripts.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					(all.empty()
+						? Lower(u"No scripts yet. Put a .ts or .js file, or "
+							"a folder with an index.ts, into the scripts "
+							"folder, or install one from the \u22ee menu."_q)
+						: Lower(u"Nothing here."_q)),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+		}
+		for (const auto &script : scripts) {
+			const auto id = script.id;
+			rows->push_back(list->add(object_ptr<ScriptRow>(
+				list,
+				script,
+				[=](bool enabled) { EnableScript(manager, id, enabled); },
+				[=] { ShowScript(manager, id); })));
+		}
+		list->resizeToWidth(content->width());
+	};
+	subtabs->activated(
+	) | rpl::on_next([=](const QString &id) {
+		subtabs->setActiveTab(id);
+		manager->filter = FilterFromId(id);
+		refresh();
+	}, subtabs->lifetime());
+	search->setQueryChangedCallback([=](const QString &query) {
+		manager->query = query;
+		refresh();
+	});
+	search->setSubmittedCallback([=](Qt::KeyboardModifiers) {
+		if (ids->size() == 1) {
+			ShowScript(manager, ids->front());
+		}
+	});
+	crl::on_main(search, [=] {
+		search->setInnerFocus();
+	});
+	refresh();
+	ScriptsChanged(session) | rpl::on_next(refresh, content->lifetime());
+}
