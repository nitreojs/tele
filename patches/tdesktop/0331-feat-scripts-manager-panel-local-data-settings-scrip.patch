+QString Host::remove(const QString &id) {
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i == end(_entries)) {
+		return Lower(u"This script is already gone."_q);
+	}
+	const auto path = i->file.folder ? i->file.root : i->file.entry;
+	i->instance = nullptr;
+	if (!QFile::moveToTrash(path)) {
+		const auto removed = i->file.folder
+			? QDir(path).removeRecursively()
+			: QFile::remove(path);
+		if (!removed) {
+			return Lower(u"Can't remove %1."_q).arg(
+				QDir::toNativeSeparators(path));
+		}
+	}
+	_grants.remove(id);
+	write();
+	refresh();
+	return QString();
+}
