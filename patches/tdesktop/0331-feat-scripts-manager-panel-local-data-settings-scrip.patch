+void AddHeader(
+		not_null<Ui::VerticalLayout*> body,
+		const ScriptState &state) {
+	const auto padding = st::boxRowPadding.left();
+	const auto size = style::ConvertScale(64);
+	const auto header = body->add(object_ptr<Ui::RpWidget>(body));
+	header->resize(0, size + padding * 2);
+	const auto icon = header->lifetime().make_state<ScriptIcon>();
+	auto details = QStringList();
+	if (!state.version.isEmpty()) {
+		details.push_back(Lower(u"version %1"_q).arg(state.version));
+	}
+	if (!state.author.isEmpty()) {
+		details.push_back(Lower(u"by %1"_q).arg(state.author));
+	}
+	details.push_back(QFileInfo(state.folder ? state.root : state.path)
+		.fileName());
+	const auto line = details.join(u" \u00B7 "_q);
+	header->paintRequest(
+	) | rpl::on_next([=] {
+		auto p = Painter(header);
+		icon->paint(p, state, QRect(padding, padding, size, size));
+		const auto left = padding * 2 + size;
+		const auto available = std::max(header->width() - left - padding, 0);
+		auto font = st::semiboldFont->f;
+		font.setPixelSize(style::ConvertScale(18));
+		const auto metrics = QFontMetrics(font);
+		const auto top = padding
+			+ (size - metrics.height() - st::normalFont->height) / 2;
+		p.setFont(font);
+		p.setPen(st::windowFg);
+		p.drawText(
+			left,
+			top + metrics.ascent(),
+			metrics.elidedText(state.name, Qt::ElideRight, available));
+		p.setFont(st::normalFont);
+		p.setPen(st::windowSubTextFg);
+		p.drawTextLeft(
+			left,
+			top + metrics.height(),
+			header->width(),
+			st::normalFont->elided(line, available));
+	}, header->lifetime());
+	if (!state.description.isEmpty()) {
+		body->add(
+			object_ptr<Ui::FlatLabel>(body, state.description, st::boxLabel),
+			st::boxRowPadding);
+	}
+	if (!state.homepage.isEmpty()) {
+		const auto link = body->add(
+			object_ptr<Ui::FlatLabel>(
+				body,
+				rpl::single(Ui::Text::Link(state.homepage, state.homepage)),
+				st::boxDividerLabel),
+			st::boxRowPadding);
+		link->setLinksTrusted();
+	}
+}
+
+void AddStatus(
+		std::shared_ptr<Manager> manager,
+		not_null<Ui::VerticalLayout*> body,
+		const ScriptState &state) {
+	const auto id = state.id;
+	if (state.approval) {
+		Ui::AddSkip(body);
+		body->add(
+			object_ptr<Ui::FlatLabel>(
+				body,
+				Lower(u"It's waiting for your approval: it asks for "
+					"permissions you haven't given yet."_q),
+				st::boxDividerLabel),
+			st::boxRowPadding);
+		Settings::AddButtonWithIcon(
+			body,
+			rpl::single(Lower(u"Review permissions"_q)),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			ShowScriptApproval(manager->show, manager->session, id);
+		});
+	} else if (!state.error.isEmpty()) {
+		Ui::AddSkip(body);
+		const auto label = body->add(
+			object_ptr<Ui::FlatLabel>(body, state.error, st::boxDividerLabel),
+			st::boxRowPadding);
+		label->setTextColorOverride(st::boxTextFgError->c);
+		label->setSelectable(true);
+	}
+	Ui::AddSkip(body);
+	const auto toggle = Settings::AddButtonWithIcon(
+		body,
+		rpl::single(Lower(u"Turned on"_q)),
+		st::settingsButtonNoIcon);
+	toggle->toggleOn(rpl::single(state.enabled));
+	toggle->toggledChanges(
+	) | rpl::filter([=](bool enabled) {
+		return enabled != state.enabled;
+	}) | rpl::on_next([=](bool enabled) {
+		EnableScript(manager, id, enabled);
+	}, toggle->lifetime());
+}
+
+void AddActions(
+		std::shared_ptr<Manager> manager,
+		not_null<Ui::VerticalLayout*> body,
+		const ScriptState &state) {
+	const auto session = manager->session;
+	const auto id = state.id;
+	const auto path = state.path;
+	if (state.enabled) {
+		Settings::AddButtonWithIcon(
+			body,
+			rpl::single(Lower(u"Reload"_q)),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			ReloadScript(session, id);
+		});
+	}
+	Settings::AddButtonWithIcon(
+		body,
+		rpl::single(Lower(u"Open the file"_q)),
+		st::settingsButtonNoIcon
+	)->setClickedCallback([=] {
+		QDesktopServices::openUrl(QUrl::fromLocalFile(path));
+	});
+	Settings::AddButtonWithIcon(
+		body,
+		rpl::single(Lower(u"Show in folder"_q)),
+		st::settingsButtonNoIcon
+	)->setClickedCallback([=] {
+		File::ShowInFolder(path);
+	});
+	const auto name = state.name;
+	Settings::AddButtonWithIcon(
+		body,
+		rpl::single(Lower(u"Remove"_q) + QChar(0x2026)),
+		st::settingsAttentionButton
+	)->setClickedCallback([=] {
+		manager->show->show(Ui::MakeConfirmBox({
+			.text = Lower(u"Remove %1? Its file goes to the recycle bin, "
+				"its storage stays until you clear it."_q).arg(name),
+			.confirmed = [=](Fn<void()> close) {
+				close();
+				const auto error = RemoveScript(session, id);
+				if (!error.isEmpty()) {
+					Toast(manager, error);
+				} else {
+					ShowList(manager);
+				}
+			},
+			.confirmText = Lower(u"Remove"_q),
+			.confirmStyle = &st::attentionBoxButton,
+		}));
+	});
+}
+
+void AddPermissions(
+		std::shared_ptr<Manager> manager,
+		not_null<Ui::VerticalLayout*> body,
+		const ScriptState &state) {
+	const auto session = manager->session;
+	const auto id = state.id;
+	Ui::AddSkip(body);
+	Ui::AddDivider(body);
+	Ui::AddSkip(body);
+	Ui::AddSubsectionTitle(body, rpl::single(Lower(u"Permissions"_q)));
+	const auto granted = state.enabled ? state.granted : QStringList();
+	const auto asked = state.approval
+		? state.requested
+		: state.declared;
+	if (granted.isEmpty() && asked.isEmpty()) {
+		body->add(
+			object_ptr<Ui::FlatLabel>(
+				body,
+				Lower(u"It asks for nothing."_q),
+				st::boxDividerLabel),
+			st::boxRowPadding);
+		return;
+	}
+	for (const auto &grant : granted) {
+		auto text = TextWithEntities{ u"\u2022 "_q + DescribeGrant(grant) };
+		text.append(u"  "_q).append(
+			Ui::Text::Link(Lower(u"revoke"_q), u"internal:revoke"_q));
+		const auto label = body->add(
+			object_ptr<Ui::FlatLabel>(body, rpl::single(text), st::boxLabel),
+			st::boxRowPadding);
+		label->setClickHandlerFilter([=](const auto &...) {
+			manager->show->show(Ui::MakeConfirmBox({
+				.text = Lower(u"Revoke \u00AB%1\u00BB? The script restarts "
+					"and asks for it again if it needs it."_q).arg(grant),
+				.confirmed = [=](Fn<void()> close) {
+					RevokeScriptGrant(session, id, grant);
+					close();
+				},
+				.confirmText = Lower(u"Revoke"_q),
+				.confirmStyle = &st::attentionBoxButton,
+			}));
+			return false;
+		});
+	}
+	auto missing = QStringList();
+	for (const auto &grant : asked) {
+		if (!granted.contains(grant)) {
+			missing.push_back(u"\u2022 "_q + DescribeGrant(grant));
+		}
+	}
+	if (!missing.isEmpty()) {
+		Ui::AddSkip(body);
+		body->add(
+			object_ptr<Ui::FlatLabel>(
+				body,
+				Lower(u"Asks for, not given:"_q) + u"\n"_q
+					+ missing.join('\n'),
+				st::boxDividerLabel),
+			st::boxRowPadding);
+	}
+}
