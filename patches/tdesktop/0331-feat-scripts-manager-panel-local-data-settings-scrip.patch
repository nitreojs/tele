+	Fn<void()> opened)
+: RippleButton(parent, st::defaultRippleAnimation)
+, _state(std::move(state))
+, _toggle(st::settingsButtonNoIcon.toggle, _state.enabled, [=] { update(); }) {
+	setClickedCallback([=] {
+		const auto area = toggleRect().marginsAdded(QMargins(
+			st::boxRowPadding.right(),
