+LogView::LogView(
+	QWidget *parent,
+	std::shared_ptr<Ui::Show> show,
+	int limit)
+: RpWidget(parent)
+, _show(std::move(show))
+, _limit(limit)
+, _font(st::normalFont->monospace()) {
+	setMouseTracking(true);
+}
+
+void LogView::setLines(const std::vector<ScriptLogLine> &lines) {
+	_lines = { begin(lines), end(lines) };
+	relayout();
+}
+
+void LogView::append(const ScriptLogLine &line) {
+	_lines.push_back(line);
+	if (int(_lines.size()) > kMaxLogLines) {
+		_lines.erase(begin(_lines), begin(_lines) + kTrimLogLines);
+		relayout();
+		return;
+	} else if (!shown(line)) {
+		return;
+	} else if (_limit > 0 || !width()) {
+		relayout();
+		return;
+	}
+	const auto top = _rows.empty()
+		? 0
+		: (_rows.back().top + _rows.back().height);
+	const auto height = rowHeight(line, width());
+	_rows.push_back({
+		.index = int(_lines.size()) - 1,
+		.top = top,
+		.height = height,
+	});
+	resize(width(), top + height);
+	update(0, top, width(), height);
+}
+
+void LogView::setFilter(LevelFilter filter, const QString &query) {
+	_filter = filter;
+	_query = query.trimmed();
+	relayout();
+}
+
+QString LogView::shownText() const {
+	auto result = QStringList();
+	for (const auto &row : _rows) {
+		result.push_back(CopyText(_lines[row.index]));
+	}
+	return result.join('\n');
+}
+
+bool LogView::shown(const ScriptLogLine &line) const {
+	const auto level = (_filter == LevelFilter::All)
+		|| ((_filter == LevelFilter::Errors) && IsError(line))
+		|| ((_filter == LevelFilter::Warnings) && IsWarning(line))
+		|| ((_filter == LevelFilter::Info)
+			&& !IsError(line)
+			&& !IsWarning(line));
+	return level
+		&& (_query.isEmpty()
+			|| line.text.contains(_query, Qt::CaseInsensitive));
+}
+
+int LogView::textLeft() const {
+	return st::boxRowPadding.left()
+		+ _font->width(u"00:00:00"_q)
+		+ _font->spacew * 2;
+}
+
+int LogView::rowHeight(const ScriptLogLine &line, int width) const {
+	const auto available = std::max(
+		width - textLeft() - st::boxRowPadding.right(),
+		_font->spacew);
+	const auto text = QFontMetrics(_font->f).boundingRect(
+		QRect(0, 0, available, 1 << 20),
+		Qt::TextWrapAnywhere,
+		line.text).height();
+	return std::max(text, _font->height) + style::ConvertScale(6);
+}
+
+int LogView::emptyHeight() const {
+	return _font->height * 3;
+}
+
+void LogView::relayout() {
+	_rows.clear();
+	const auto from = (_limit > 0)
+		? [&] {
+			auto count = 0;
+			auto i = int(_lines.size());
+			while (i > 0 && count < _limit) {
+				if (shown(_lines[--i])) {
+					++count;
+				}
+			}
+			return i;
+		}()
+		: 0;
+	auto top = 0;
+	const auto w = width();
+	for (auto i = from; i != int(_lines.size()); ++i) {
+		if (shown(_lines[i])) {
+			const auto height = w ? rowHeight(_lines[i], w) : 0;
+			_rows.push_back({ .index = i, .top = top, .height = height });
+			top += height;
+		}
+	}
+	_selected = -1;
+	if (w) {
+		resize(w, _rows.empty() ? emptyHeight() : top);
+	}
+	update();
+}
+
+int LogView::resizeGetHeight(int newWidth) {
+	auto top = 0;
+	for (auto &row : _rows) {
+		row.top = top;
+		row.height = rowHeight(_lines[row.index], newWidth);
+		top += row.height;
+	}
+	return _rows.empty() ? emptyHeight() : top;
+}
+
+int LogView::rowAt(int y) const {
+	const auto i = ranges::upper_bound(_rows, y, ranges::less(), &Row::top);
+	if (i == begin(_rows)) {
+		return -1;
+	}
+	const auto index = int(i - begin(_rows)) - 1;
+	const auto &row = _rows[index];
+	return (y < row.top + row.height) ? index : -1;
+}
+
+void LogView::setSelected(int selected) {
+	if (_selected == selected) {
+		return;
+	}
+	const auto repaint = [&](int index) {
+		if (index >= 0 && index < int(_rows.size())) {
+			update(0, _rows[index].top, width(), _rows[index].height);
+		}
+	};
+	repaint(_selected);
+	_selected = selected;
+	repaint(_selected);
+}
+
+void LogView::mouseMoveEvent(QMouseEvent *e) {
+	setSelected(rowAt(e->pos().y()));
+}
+
+void LogView::leaveEventHook(QEvent *e) {
+	setSelected(-1);
+}
+
+void LogView::copy(const QString &text) {
+	QGuiApplication::clipboard()->setText(text);
+	_show->showToast(Lower(u"Copied."_q));
+}
+
+void LogView::contextMenuEvent(QContextMenuEvent *e) {
+	const auto index = rowAt(e->pos().y());
+	_menu = base::make_unique_q<Ui::PopupMenu>(this, st::popupMenuWithIcons);
+	if (index >= 0) {
+		const auto text = CopyText(_lines[_rows[index].index]);
+		_menu->addAction(Lower(u"Copy the line"_q), [=] {
+			copy(text);
+		}, &st::menuIconCopy);
+	}
+	if (!_rows.empty()) {
+		_menu->addAction(Lower(u"Copy everything shown"_q), [=] {
+			copy(shownText());
+		}, &st::menuIconCopy);
+	}
+	if (_menu->empty()) {
+		_menu = nullptr;
+		return;
+	}
+	_menu->popup(e->globalPos());
+}
+
+void LogView::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto clip = e->rect();
+	p.setFont(_font);
+	if (_rows.empty()) {
+		p.setPen(st::windowSubTextFg);
+		p.drawText(
+			rect(),
+			Qt::AlignCenter,
+			(_lines.empty()
+				? Lower(u"Nothing logged yet."_q)
+				: Lower(u"Nothing found."_q)));
+		return;
+	}
+	const auto left = st::boxRowPadding.left();
+	const auto textX = textLeft();
+	const auto textWidth = std::max(
+		width() - textX - st::boxRowPadding.right(),
+		_font->spacew);
+	const auto bar = style::ConvertScale(3);
+	const auto pad = style::ConvertScale(3);
+	const auto first = ranges::upper_bound(
+		_rows,
+		clip.y(),
+		ranges::less(),
+		[](const Row &row) { return row.top + row.height; });
+	for (auto i = first; i != end(_rows) && i->top < clip.y() + clip.height(); ++i) {
+		const auto &line = _lines[i->index];
+		const auto error = IsError(line);
+		const auto warning = IsWarning(line);
+		const auto rect = QRect(0, i->top, width(), i->height);
+		if (error || warning) {
+			auto color = (error ? st::boxTextFgError : st::settingsIconBg3)->c;
+			p.fillRect(QRect(0, i->top, bar, i->height), color);
+			color.setAlphaF(0.12);
+			p.fillRect(rect, color);
+		}
+		if (int(i - begin(_rows)) == _selected) {
+			p.fillRect(rect, st::windowBgOver);
+		}
+		p.setPen(st::windowSubTextFg);
+		p.drawText(
+			left,
+			i->top + pad + _font->ascent,
+			LineTime(line));
+		p.setPen(error ? st::boxTextFgError : st::windowFg);
+		p.drawText(
+			QRect(textX, i->top + pad, textWidth, i->height - pad),
+			Qt::TextWrapAnywhere,
+			line.text);
+	}
+}
