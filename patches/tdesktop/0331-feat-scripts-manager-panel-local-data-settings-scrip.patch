+[[nodiscard]] JSValue TextValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		const TextWithTags &value) {
+	const auto entities = Api::EntitiesToMTP(
+		session,
+		TextUtilities::ConvertTextTagsToEntities(value.tags),
+		Api::ConvertOption::SkipLocal);
+	auto buffer = mtpBuffer();
+	entities.write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "Vector<MessageEntity>");
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "text", NewString(ctx, value.text));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"entities",
+		decoded.error.empty() ? decoded.value : JS_NewArray(ctx));
+	return result;
+}
+
+[[nodiscard]] QString GroupName(SettingsGroup group) {
+	switch (group) {
+	case SettingsGroup::Settings: return u"settings"_q;
+	case SettingsGroup::People: return u"people"_q;
+	case SettingsGroup::Device: return u"device"_q;
+	}
+	return u"settings"_q;
+}
+
+[[nodiscard]] JSValue SettingValue(JSContext *ctx, const SettingInfo &info) {
+	return (info.kind == u"toggle"_q)
+		? JS_NewBool(ctx, info.flag)
+		: NewString(ctx, info.text);
+}
