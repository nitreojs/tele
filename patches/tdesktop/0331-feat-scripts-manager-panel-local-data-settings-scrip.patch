+class ScriptIcon final {
+public:
+	void paint(QPainter &p, const ScriptState &state, QRect rect);
+
+private:
+	QString _source;
+	QImage _image;
+
+};
+
+void ScriptIcon::paint(QPainter &p, const ScriptState &state, QRect rect) {
+	auto hq = PainterHighQualityEnabler(p);
+	const auto file = !state.icon.isEmpty()
+		&& QFileInfo(state.icon).isAbsolute();
+	if (file && _source != state.icon) {
+		_source = state.icon;
+		_image = QImage(state.icon);
+	} else if (!file) {
+		_source = QString();
+		_image = QImage();
+	}
+	if (!_image.isNull()) {
+		auto path = QPainterPath();
+		path.addEllipse(rect);
+		p.save();
+		p.setClipPath(path);
+		p.drawImage(rect, _image);
+		p.restore();
+		return;
+	}
+	p.setPen(Qt::NoPen);
+	p.setBrush(IconBg(state.id));
+	p.drawEllipse(rect);
+	const auto text = (!state.icon.isEmpty() && !file)
+		? state.icon
+		: state.name.left(1).toUpper();
+	auto length = 0;
+	const auto emoji = Ui::Emoji::Find(text, &length);
+	if (emoji && length == text.size()) {
+		const auto &pixmap = Ui::Emoji::SinglePixmap(
+			emoji,
+			rect.height() / 2);
+		const auto size = pixmap.size() / pixmap.devicePixelRatio();
+		p.drawPixmap(
+			rect.x() + (rect.width() - size.width()) / 2,
+			rect.y() + (rect.height() - size.height()) / 2,
+			pixmap);
+		return;
+	}
+	auto font = st::semiboldFont->f;
+	font.setPixelSize(std::max(rect.height() * 2 / 5, 1));
+	p.setFont(font);
+	p.setPen(st::activeButtonFg);
+	p.drawText(rect, Qt::AlignCenter, text);
+}
