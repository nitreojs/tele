+int Host::emit(
+		const QString &from,
+		const QString &fromName,
+		const QString &event,
+		const QByteArray &payload,
+		const QString &target) {
+	auto count = 0;
+	for (const auto &entry : _entries) {
+		const auto instance = entry.instance.get();
+		if (!instance
+			|| entry.file.id == from
+			|| (!target.isEmpty() && entry.file.id != target)
+			|| !instance->listens(event)) {
+			continue;
+		}
+		++count;
+		instance->receive(event, payload, from, fromName);
+	}
+	return count;
+}
