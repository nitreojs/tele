diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_engine.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_engine.cpp
index 63e3d227b076db949d3a0bc91d7a66e5c18e8260..5dbb7f8394656608008f625bcdf78ffc4f0c3760 100644
--- a/Telegram/SourceFiles/tele/scripting/tele_script_engine.cpp
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_engine.cpp
@@ -60,6 +60,224 @@ constexpr auto kPrelude = R"js((() => {
 	Object.defineProperty(globalThis, '__teleFormat', {
 		value: (...args) => args.map((arg) => format(arg, 0)).join(' '),
 	});
+	class TeleError extends Error {
+		constructor(code, message, grant) {
+			super(message);
+			this.name = 'TeleError';
+			this.code = code;
+			if (grant !== undefined) {
+				this.grant = grant;
+			}
+		}
+	}
+	class RpcError extends Error {
+		constructor(code, type) {
+			super(type);
+			this.name = 'RpcError';
+			this.code = code;
+			this.type = type;
+			const flood = /^(?:FLOOD_WAIT|FLOOD_PREMIUM_WAIT|SLOWMODE_WAIT)_(\d+)$/
+				.exec(type);
+			if (flood) {
+				this.seconds = Number(flood[1]);
+			}
+		}
+	}
+	const hidden = (name, value) => Object.defineProperty(globalThis, name, {
+		value,
+	});
+	hidden('__teleTeleError', TeleError);
+	hidden('__teleRpcError', RpcError);
+	globalThis.TeleError = TeleError;
+	globalThis.RpcError = RpcError;
+	hidden('__teleDisposer', (release) => {
+		let done = false;
+		const dispose = () => {
+			if (!done) {
+				done = true;
+				release();
+			}
+		};
+		dispose[Symbol.dispose] = dispose;
+		return dispose;
+	});
+
+	const placeholder = (update) => {
+		if (typeof update.qts === 'number') {
+			return undefined;
+		} else if (typeof update.pts !== 'number'
+			|| typeof update.ptsCount !== 'number') {
+			return null;
+		}
+		const channelId = update.channelId
+			?? update.message?.peerId?.channelId;
+		return (channelId !== undefined)
+			? {
+				_: 'updateDeleteChannelMessages',
+				channelId,
+				messages: [],
+				pts: update.pts,
+				ptsCount: update.ptsCount,
+			}
+			: {
+				_: 'updateDeleteMessages',
+				messages: [],
+				pts: update.pts,
+				ptsCount: update.ptsCount,
+			};
+	};
+	hidden('__teleMiddleware', async (fn, request, method, forward) => {
+		let called = false;
+		const context = { request, method };
+		const next = (replacement) => {
+			if (called) {
+				throw new TypeError('next() can only be called once');
+			}
+			const pending = forward(
+				(replacement === undefined) ? context.request : replacement);
+			called = true;
+			pending.catch(() => {});
+			return pending;
+		};
+		let result;
+		try {
+			result = await fn(context, next);
+		} catch (error) {
+			return (error instanceof RpcError)
+				? { kind: 'error', value: error }
+				: { kind: 'throw', value: error };
+		}
+		if (result === undefined) {
+			return { kind: called ? 'next' : 'nothing' };
+		} else if (result === null) {
+			return { kind: 'null' };
+		} else if (result instanceof RpcError) {
+			return { kind: 'error', value: result };
+		}
+		return { kind: 'value', value: result };
+	});
+
+	const service = 777000n;
+	const fromService = (message) => (message?.fromId?.userId === service)
+		|| (message?.peerId?.userId === service);
+	hidden('__teleRunUpdates', async (container, handlers, fault, options) => {
+		let changed = false;
+		const hide = (update) => !options.unfiltered
+			&& ((update._ === 'updateServiceNotification')
+				|| (update._ === 'updateDraftMessage' && !options.drafts)
+				|| fromService(update.message)
+				|| (update._ === 'updateShortMessage'
+					&& update.userId === service));
+		const verdict = async (update) => {
+			if (hide(update)) {
+				return 'deliver';
+			}
+			const list = [
+				...(handlers[update._] ?? []),
+				...(handlers['*'] ?? []),
+			];
+			if (!list.length) {
+				return 'deliver';
+			}
+			changed = true;
+			for (const handler of list) {
+				let result;
+				try {
+					result = await handler({ update });
+				} catch (error) {
+					fault('interceptUpdate ' + update._, error);
+					continue;
+				}
+				if (result === 'drop') {
+					return 'drop';
+				} else if (result !== 'deliver') {
+					fault('interceptUpdate ' + update._, new TypeError(
+						"an update interceptor must return 'deliver' or 'drop'"));
+				}
+			}
+			return 'deliver';
+		};
+		const filter = async (list) => {
+			const result = [];
+			for (const update of list) {
+				if (await verdict(update) !== 'drop') {
+					result.push(update);
+					continue;
+				}
+				const replacement = placeholder(update);
+				if (replacement === undefined) {
+					fault('interceptUpdate ' + update._, new TypeError(
+						"updates with qts can't be dropped, delivered as is"));
+					result.push(update);
+				} else if (replacement !== null) {
+					result.push(replacement);
+				}
+			}
+			return result;
+		};
+		const messages = async (list, type) => {
+			const result = [];
+			for (const message of list) {
+				const update = { _: type, message, pts: 0, ptsCount: 0 };
+				if (await verdict(update) !== 'drop') {
+					result.push(update.message);
+				}
+			}
+			return result;
+		};
+		switch (container._) {
+		case 'updates':
+		case 'updatesCombined':
+			container.updates = await filter(container.updates);
+			break;
+		case 'updateShort': {
+			const list = await filter([container.update]);
+			if (!list.length) {
+				return {
+					changed: true,
+					value: {
+						_: 'updates',
+						updates: [],
+						users: [],
+						chats: [],
+						date: container.date,
+						seq: 0,
+					},
+				};
+			}
+			container.update = list[0];
+		} break;
+		case 'updateShortMessage':
+		case 'updateShortChatMessage':
+		case 'updateShortSentMessage':
+			if (await verdict(container) === 'drop') {
+				return {
+					changed: true,
+					value: {
+						_: 'updateShort',
+						update: placeholder(container),
+						date: container.date,
+					},
+				};
+			}
+			break;
+		case 'updates.difference':
+		case 'updates.differenceSlice':
+			container.newMessages = await messages(
+				container.newMessages,
+				'updateNewMessage');
+			container.otherUpdates = await filter(container.otherUpdates);
+			break;
+		case 'updates.channelDifference':
+			container.newMessages = await messages(
+				container.newMessages,
+				'updateNewChannelMessage');
+			container.otherUpdates = await filter(container.otherUpdates);
+			break;
+		}
+		return { changed, value: container };
+	});
+
 	Object.defineProperty(globalThis, '__teleInspect', {
 		value: (value) => format(value, 1),
 	});
@@ -497,13 +715,7 @@ void PromiseRejected(
 		JSValueConst reason,
 		bool handled,
 		void *opaque) {
-	if (handled) {
-		return;
-	}
-	const auto engine = static_cast<Engine*>(opaque);
-	engine->log(
-		LogLevel::Fault,
-		u"unhandled promise rejection: "_q + engine->describe(reason));
+	static_cast<Engine*>(opaque)->rejected(promise, reason, handled);
 }
 
 } // namespace
@@ -595,6 +807,10 @@ Engine::~Engine() {
 		timer.timer = nullptr;
 		JS_FreeValue(_ctx, timer.function);
 	}
+	for (auto &[promise, reason] : base::take(_rejected)) {
+		JS_FreeValue(_ctx, promise);
+		JS_FreeValue(_ctx, reason);
+	}
 	JS_FreeContext(_ctx);
 	JS_FreeRuntime(_rt);
 }
@@ -797,7 +1013,7 @@ JSValue Engine::call(
 	return result;
 }
 
-void Engine::drain() {
+void Engine::drain(bool flush) {
 	enter(kDrainBudget);
 	for (auto i = 0; i != kMaxJobs; ++i) {
 		if (_deadline && crl::now() > _deadline) {
@@ -813,6 +1029,36 @@ void Engine::drain() {
 		}
 	}
 	leave();
+	if (flush) {
+		flushRejections();
+	}
+}
+
+void Engine::rejected(JSValueConst promise, JSValueConst reason, bool handled) {
+	if (!handled) {
+		_rejected.emplace_back(
+			JS_DupValue(_ctx, promise),
+			JS_DupValue(_ctx, reason));
+		return;
+	}
+	const auto i = ranges::find_if(_rejected, [&](const auto &pair) {
+		return JS_VALUE_GET_PTR(pair.first) == JS_VALUE_GET_PTR(promise);
+	});
+	if (i != end(_rejected)) {
+		JS_FreeValue(_ctx, i->first);
+		JS_FreeValue(_ctx, i->second);
+		_rejected.erase(i);
+	}
+}
+
+void Engine::flushRejections() {
+	for (auto &[promise, reason] : base::take(_rejected)) {
+		log(
+			LogLevel::Fault,
+			u"unhandled promise rejection: "_q + describe(reason));
+		JS_FreeValue(_ctx, promise);
+		JS_FreeValue(_ctx, reason);
+	}
 }
 
