+JSValue ThrowTeleError(
+		JSContext *ctx,
+		const char *code,
+		const QString &message,
+		const QString &grant = QString()) {
+	auto global = JS_GetGlobalObject(ctx);
+	auto constructor = JS_GetPropertyStr(ctx, global, "__teleTeleError");
+	JS_FreeValue(ctx, global);
+	const auto text = message.toUtf8();
+	const auto token = grant.toUtf8();
+	JSValue args[] = {
+		JS_NewString(ctx, code),
+		JS_NewStringLen(ctx, text.constData(), text.size()),
+		grant.isEmpty()
+			? JS_UNDEFINED
+			: JS_NewStringLen(ctx, token.constData(), token.size()),
+	};
+	auto error = JS_CallConstructor(ctx, constructor, 3, args);
+	for (const auto arg : args) {
+		JS_FreeValue(ctx, arg);
+	}
+	JS_FreeValue(ctx, constructor);
+	return JS_IsException(error) ? error : JS_Throw(ctx, error);
+}
