+[[nodiscard]] QStringList MigrateGrants(const QStringList &old) {
+	auto result = QStringList();
+	for (const auto &entry : old) {
+		const auto colon = entry.indexOf(':');
+		const auto name = (colon < 0) ? entry : entry.left(colon);
+		const auto scope = (colon < 0) ? QString() : entry.mid(colon + 1);
+		const auto scoped = [&](const QString &grant) {
+			return scope.isEmpty() ? grant : (grant + '(' + scope + ')');
+		};
+		if (name == u"call"_q) {
+			result.push_back(scoped(u"call"_q));
+		} else if (name == u"updates"_q) {
+			result.push_back(scoped(u"onUpdate"_q));
+		} else if (name == u"requests"_q || name == u"results"_q) {
+			result.push_back(scoped(u"interceptRpc"_q));
+		} else if (name == u"peers"_q) {
+			result.push_back(u"account.read(self, peers)"_q);
+		} else if (name == u"ui"_q) {
+			result.append({ u"openUrl"_q, u"notify"_q });
+		} else if (name == u"clipboard"_q) {
+			result.append({ u"clipboard.read"_q, u"clipboard.write"_q });
+		} else if (name == u"network"_q) {
+			result.push_back(scope.isEmpty()
+				? u"fetch"_q
+				: (u"fetch("_q
+					+ (scope.startsWith(u"*."_q) ? scope.mid(2) : scope)
+					+ ')'));
+		}
+	}
+	return result;
+}
