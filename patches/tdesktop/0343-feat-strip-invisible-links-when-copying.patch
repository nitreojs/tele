diff --git a/Telegram/SourceFiles/tele/tele_copy_links.cpp b/Telegram/SourceFiles/tele/tele_copy_links.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7d3ac2cc85ad50da316568a407d2541f7c9134cf
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_copy_links.cpp
@@ -0,0 +1,94 @@
+#include "tele/tele_copy_links.h"
+
+#include "iv/iv_rich_page.h"
+#include "tele/tele_invisible.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+void CleanText(TextWithEntities &text) {
+	const auto skip = [&](const EntityInText &entity) {
+		return (entity.type() == EntityType::CustomUrl)
+			&& SkipLinkOnCopy(text, entity.offset(), entity.length());
+	};
+	const auto &entities = std::as_const(text.entities);
+	if (ranges::find_if(entities, skip) == entities.end()) {
+		return;
+	}
+	const auto original = text;
+	text.entities.erase(ranges::remove_if(
+		text.entities,
+		[&](const EntityInText &entity) {
+			return (entity.type() == EntityType::CustomUrl)
+				&& SkipLinkOnCopy(
+					original,
+					entity.offset(),
+					entity.length());
+		}), text.entities.end());
+}
+
+void CleanBlocks(std::vector<Iv::RichPage::Block> &blocks) {
+	for (auto &block : blocks) {
+		CleanText(block.text.text);
+		CleanText(block.caption.text);
+		CleanBlocks(block.blocks);
+		for (auto &item : block.listItems) {
+			CleanText(item.text.text);
+			CleanBlocks(item.blocks);
+		}
+		for (auto &row : block.tableRows) {
+			for (auto &cell : row.cells) {
+				CleanText(cell.text.text);
+			}
+		}
+		for (auto &button : block.buttons) {
+			CleanText(button.text.text);
+		}
+	}
+}
+
+} // namespace
+
+bool SkipLinkOnCopy(
+		const TextWithEntities &text,
+		int offset,
+		int length) {
+	if (!RemoveInvisibleCopyLinks()
+		|| offset < 0
+		|| length <= 0
+		|| offset > text.text.size()
+		|| length > text.text.size() - offset) {
+		return false;
+	}
+	const auto till = offset + length;
+	for (auto i = offset; i != till; ++i) {
+		auto ch = char32_t(text.text[i].unicode());
+		if (QChar::isHighSurrogate(ch)
+			&& i + 1 < till
+			&& text.text[i + 1].isLowSurrogate()) {
+			ch = QChar::surrogateToUcs4(text.text[i], text.text[i + 1]);
+			++i;
+		}
+		if (!IsInvisibleChar(ch)) {
+			return false;
+		}
+	}
+	for (const auto &entity : text.entities) {
+		if (EntityReplacesText(entity)
+			&& entity.validForText(text.text.size())
+			&& entity.offset() < till
+			&& entity.offset() + entity.length() > offset) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void CleanCopiedLinks(Iv::RichPageBlocksSlice &slice) {
+	if (RemoveInvisibleCopyLinks()) {
+		CleanBlocks(slice.blocks);
+	}
+}
+
+} // namespace Tele
