+class PanelColumn final : public Ui::RpWidget {
+public:
+	PanelColumn(QWidget *parent, object_ptr<Ui::RpWidget> child)
+	: RpWidget(parent)
+	, _child(std::move(child)) {
+		_child->setParent(this);
+		_child->show();
+		_child->heightValue(
+		) | rpl::on_next([=](int height) {
+			resize(width(), height);
+		}, lifetime());
+	}
+
+protected:
+	int resizeGetHeight(int newWidth) override {
+		const auto inner = std::min(newWidth, st::walletPanelSize.width());
+		_child->resizeToWidth(inner);
+		_child->moveToLeft((newWidth - inner) / 2, 0, newWidth);
+		return _child->height();
+	}
+	void visibleTopBottomUpdated(
+			int visibleTop,
+			int visibleBottom) override {
+		setChildVisibleTopBottom(_child, visibleTop, visibleBottom);
+	}
+
+private:
+	object_ptr<Ui::RpWidget> _child;
+
+};
+
+template <typename Widget>
+not_null<Widget*> AddPanelColumn(
+		not_null<Ui::VerticalLayout*> container,
+		object_ptr<Widget> widget) {
+	const auto result = widget.data();
+	container->add(object_ptr<PanelColumn>(container, std::move(widget)));
+	return result;
+}
