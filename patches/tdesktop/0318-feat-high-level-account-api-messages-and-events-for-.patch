diff --git a/Telegram/Resources/tele/scripting/runtime.js b/Telegram/Resources/tele/scripting/runtime.js
new file mode 100644
index 0000000000000000000000000000000000000000..8744400de6aba3dc9003750a25d31c9cacd024cb
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/runtime.js
@@ -0,0 +1,890 @@
+(() => {
+	const hidden = (name, value) => Object.defineProperty(globalThis, name, { value });
+	const CHANNEL_SHIFT = 1000000000000n;
+	const PLACEHOLDER = 0xE000;
+	const NEW_MESSAGE = { updateNewMessage: true, updateNewChannelMessage: true, updateNewScheduledMessage: true };
+	const EDIT_MESSAGE = { updateEditMessage: true, updateEditChannelMessage: true };
+	const MEDIA_TYPES = {
+		messageMediaPhoto: 'photo',
+		messageMediaPoll: 'poll',
+		messageMediaContact: 'contact',
+		messageMediaGeo: 'location',
+		messageMediaGeoLive: 'location',
+		messageMediaVenue: 'venue',
+		messageMediaStory: 'story',
+		messageMediaGiveaway: 'giveaway',
+		messageMediaGiveawayResults: 'giveaway',
+		messageMediaInvoice: 'invoice',
+		messageMediaDice: 'dice',
+		messageMediaWebPage: 'webpage',
+		messageMediaGame: 'game',
+		messageMediaPaidMedia: 'paidMedia',
+	};
+	const TYPING = {
+		typing: { _: 'sendMessageTypingAction' },
+		cancel: { _: 'sendMessageCancelAction' },
+		recordVideo: { _: 'sendMessageRecordVideoAction' },
+		uploadVideo: { _: 'sendMessageUploadVideoAction', progress: 0 },
+		recordVoice: { _: 'sendMessageRecordAudioAction' },
+		uploadVoice: { _: 'sendMessageUploadAudioAction', progress: 0 },
+		recordRound: { _: 'sendMessageRecordRoundAction' },
+		uploadRound: { _: 'sendMessageUploadRoundAction', progress: 0 },
+		uploadPhoto: { _: 'sendMessageUploadPhotoAction', progress: 0 },
+		uploadDocument: { _: 'sendMessageUploadDocumentAction', progress: 0 },
+		chooseSticker: { _: 'sendMessageChooseStickerAction' },
+		chooseContact: { _: 'sendMessageChooseContactAction' },
+		playGame: { _: 'sendMessageGamePlayAction' },
+	};
+
+	let natives = null;
+	let current = null;
+
+	const markedId = (peer, selfId) => {
+		switch (peer?._) {
+		case 'peerUser':
+		case 'inputPeerUser':
+		case 'inputUser':
+		case 'inputPeerUserFromMessage':
+			return peer.userId;
+		case 'peerChat':
+		case 'inputPeerChat':
+			return -peer.chatId;
+		case 'peerChannel':
+		case 'inputPeerChannel':
+		case 'inputChannel':
+		case 'inputPeerChannelFromMessage':
+			return -CHANNEL_SHIFT - peer.channelId;
+		case 'inputPeerSelf':
+		case 'inputUserSelf':
+			return selfId ?? null;
+		}
+		return null;
+	};
+
+	const infoOf = (object, selfId) => {
+		const username = object?.username
+			?? object?.usernames?.find((item) => item.active)?.username;
+		const named = username ? { username } : {};
+		switch (object?._) {
+		case 'user':
+			return {
+				id: object.id,
+				kind: object.bot ? 'bot' : 'user',
+				name: [object.firstName, object.lastName].filter(Boolean).join(' '),
+				...named,
+				input: (object.id === selfId)
+					? { _: 'inputPeerSelf' }
+					: { _: 'inputPeerUser', userId: object.id, accessHash: object.accessHash ?? 0n },
+			};
+		case 'chat':
+		case 'chatForbidden':
+			return {
+				id: -object.id,
+				kind: 'chat',
+				name: object.title,
+				input: { _: 'inputPeerChat', chatId: object.id },
+			};
+		case 'channel':
+		case 'channelForbidden':
+			return {
+				id: -CHANNEL_SHIFT - object.id,
+				kind: (object.megagroup || object.gigagroup) ? 'supergroup' : 'channel',
+				name: object.title,
+				...named,
+				input: { _: 'inputPeerChannel', channelId: object.id, accessHash: object.accessHash ?? 0n },
+			};
+		}
+		return undefined;
+	};
+
+	const textOf = (input) => {
+		if (typeof input === 'string') {
+			return { text: input, entities: [] };
+		} else if (input !== null && typeof input === 'object' && typeof input.text === 'string') {
+			return { text: input.text, entities: input.entities ?? [] };
+		}
+		throw new TypeError('expected a string or { text, entities }');
+	};
+
+	const seconds = (date) => ((date instanceof Date) ? Math.floor(date.getTime() / 1000) : date);
+
+	class Message {
+		#tg;
+		#peers;
+
+		constructor(raw, tg = current, peers = undefined) {
+			if (raw === null || typeof raw !== 'object' || !['message', 'messageService', 'messageEmpty'].includes(raw._)) {
+				throw new TypeError('new Message() needs a TL message object');
+			}
+			Object.defineProperty(this, 'raw', { value: raw, enumerable: true });
+			this.#tg = tg ?? null;
+			this.#peers = peers;
+		}
+
+		get id() { return this.raw.id; }
+		get isService() { return this.raw._ === 'messageService'; }
+		get date() { return this.raw.date ?? 0; }
+		get editDate() { return this.raw.editDate ?? null; }
+		get out() { return this.raw.out === true; }
+		get silent() { return this.raw.silent === true; }
+		get mentioned() { return this.raw.mentioned === true; }
+		get post() { return this.raw.post === true; }
+		get isPinned() { return this.raw.pinned === true; }
+		get text() { return (this.raw._ === 'message') ? this.raw.message : ''; }
+		get entities() { return (this.raw._ === 'message') ? (this.raw.entities ?? []) : []; }
+		get textWithEntities() { return { text: this.text, entities: this.entities }; }
+		get media() { return this.raw.media ?? null; }
+		get groupedId() { return this.raw.groupedId ?? null; }
+		get forwardedFrom() { return this.raw.fwdFrom ?? null; }
+		get viaBotId() { return this.raw.viaBotId ?? null; }
+		get views() { return this.raw.views ?? null; }
+		get forwards() { return this.raw.forwards ?? null; }
+		get reactions() { return this.raw.reactions ?? null; }
+		get action() { return this.raw.action ?? null; }
+
+		get mediaType() {
+			const media = this.raw.media;
+			if (!media || media._ === 'messageMediaEmpty' || media._ === 'messageMediaUnsupported') {
+				return null;
+			} else if (media._ !== 'messageMediaDocument') {
+				return MEDIA_TYPES[media._] ?? 'other';
+			}
+			let type = 'document';
+			for (const attribute of media.document?.attributes ?? []) {
+				switch (attribute._) {
+				case 'documentAttributeSticker':
+					return 'sticker';
+				case 'documentAttributeAnimated':
+					type = 'gif';
+					break;
+				case 'documentAttributeVideo':
+					if (type !== 'gif') {
+						type = attribute.roundMessage ? 'roundVideo' : 'video';
+					}
+					break;
+				case 'documentAttributeAudio':
+					type = attribute.voice ? 'voice' : 'music';
+					break;
+				}
+			}
+			return type;
+		}
+
+		get document() {
+			const media = this.raw.media;
+			return (media?._ === 'messageMediaDocument' && media.document?._ === 'document') ? media.document : null;
+		}
+
+		get photo() {
+			const media = this.raw.media;
+			return (media?._ === 'messageMediaPhoto' && media.photo?._ === 'photo') ? media.photo : null;
+		}
+
+		get duration() {
+			for (const attribute of this.document?.attributes ?? []) {
+				if (attribute._ === 'documentAttributeVideo' || attribute._ === 'documentAttributeAudio') {
+					return attribute.duration;
+				}
+			}
+			return null;
+		}
+
+		get replyToMessageId() {
+			const reply = this.raw.replyTo;
+			return (reply?._ === 'messageReplyHeader') ? (reply.replyToMsgId ?? null) : null;
+		}
+
+		get topicId() {
+			const reply = this.raw.replyTo;
+			return (reply?._ === 'messageReplyHeader' && reply.forumTopic)
+				? (reply.replyToTopId ?? reply.replyToMsgId ?? null)
+				: null;
+		}
+
+		get chatId() {
+			return markedId(this.raw.peerId, this.#tg?.selfId);
+		}
+
+		get senderId() {
+			if (this.raw.fromId) {
+				return markedId(this.raw.fromId, this.#tg?.selfId);
+			} else if (this.raw.peerId?._ === 'peerUser' && this.out) {
+				return this.#tg?.selfId ?? null;
+			}
+			return this.chatId;
+		}
+
+		get chat() { return this.#lookup(this.chatId); }
+		get sender() { return this.#lookup(this.senderId); }
+
+		#lookup(id) {
+			if (id === null || id === undefined) {
+				return null;
+			}
+			const cached = natives?.peer(id);
+			if (cached) {
+				return cached;
+			}
+			for (const object of [...(this.#peers?.users ?? []), ...(this.#peers?.chats ?? [])]) {
+				const info = infoOf(object, this.#tg?.selfId);
+				if (info?.id === id) {
+					return info;
+				}
+			}
+			return null;
+		}
+
+		#account(action) {
+			if (!this.#tg) {
+				throw new TeleError('unsupported', `message.${action}() needs a message that came from tg`);
+			}
+			return this.#tg;
+		}
+
+		#where() {
+			return this.chat?.input ?? this.chatId;
+		}
+
+		reply(text, options = {}) {
+			return this.#account('reply').sendMessage(this.#where(), text, { ...options, replyTo: this.id });
+		}
+
+		edit(text, options) {
+			return this.#account('edit').editMessage(this.#where(), this.id, text, options);
+		}
+
+		delete(options) {
+			return this.#account('delete').deleteMessages(this.#where(), [this.id], options);
+		}
+
+		react(reaction, options) {
+			const list = (reaction === null || reaction === undefined) ? [] : [reaction];
+			return this.#account('react').setReaction(this.#where(), this.id, list, options);
+		}
+
+		async forward(to, options) {
+			const [message] = await this.#account('forward').forwardMessages(this.#where(), [this.id], to, options);
+			return message ?? null;
+		}
+
+		read() {
+			return this.#account('read').readHistory(this.#where(), { maxId: this.id });
+		}
+
+		toJSON() {
+			return this.raw;
+		}
+	}
+	hidden('__teleMessage', Message);
+
+	const formatter = (kind, tag) => (first, ...values) => {
+		if (typeof first === 'string') {
+			return __teleParse(kind, first);
+		} else if (!Array.isArray(first) || !Array.isArray(first.raw)) {
+			throw new TypeError(`${tag} takes a string or works as a template tag`);
+		} else if (values.length > 6400) {
+			throw new RangeError(`${tag} takes at most 6400 values`);
+		}
+		let source = '';
+		first.forEach((part, index) => {
+			source += part;
+			if (index < values.length) {
+				source += String.fromCharCode(PLACEHOLDER + index);
+			}
+		});
+		const parsed = __teleParse(kind, source);
+		const positions = new Array(parsed.text.length + 1);
+		const entities = [];
+		let text = '';
+		for (let i = 0; i !== parsed.text.length; ++i) {
+			positions[i] = text.length;
+			const index = parsed.text.charCodeAt(i) - PLACEHOLDER;
+			if (index < 0 || index >= values.length) {
+				text += parsed.text[i];
+				continue;
+			}
+			const value = values[index];
+			const inserted = (value !== null && typeof value === 'object' && typeof value.text === 'string')
+				? value
+				: { text: (value === null || value === undefined) ? '' : String(value) };
+			for (const entity of inserted.entities ?? []) {
+				entities.push({ ...entity, offset: entity.offset + text.length });
+			}
+			text += inserted.text;
+		}
+		positions[parsed.text.length] = text.length;
+		for (const entity of parsed.entities) {
+			const start = positions[entity.offset];
+			const end = positions[entity.offset + entity.length];
+			if (end > start) {
+				entities.push({ ...entity, offset: start, length: end - start });
+			}
+		}
+		entities.sort((a, b) => (a.offset - b.offset) || (b.length - a.length));
+		return { text, entities };
+	};
+	hidden('__teleMd', formatter('markdown', 'md'));
+	hidden('__teleHtml', formatter('html', 'html'));
+
+	hidden('__teleExtendTg', (tg, given) => {
+		natives = given;
+		current = tg;
+		const selfId = tg.selfId;
+
+		const resolvePeer = async (peer) => {
+			if (peer instanceof Message) {
+				return resolvePeer(peer.chat?.input ?? peer.chatId);
+			} else if (peer === 'me' || peer === 'self') {
+				return { _: 'inputPeerSelf' };
+			} else if (typeof peer === 'string') {
+				const trimmed = peer.trim();
+				if (/^-?\d+$/.test(trimmed)) {
+					return resolvePeer(BigInt(trimmed));
+				}
+				const name = trimmed.replace(/^(?:https?:\/\/)?t\.me\//, '').replace(/^@/, '');
+				const info = await tg.peers.resolve(name);
+				if (!info) {
+					throw new TeleError('not-found', `nobody has the username @${name}`);
+				}
+				return info.input;
+			} else if (typeof peer === 'number' || typeof peer === 'bigint') {
+				const id = BigInt(peer);
+				if (id === selfId) {
+					return { _: 'inputPeerSelf' };
+				}
+				const info = tg.peers.get(id);
+				if (!info) {
+					throw new TeleError('not-found', `${id} isn't in tele's cache, pass an input peer or a username`);
+				}
+				return info.input;
+			} else if (peer !== null && typeof peer === 'object') {
+				if (peer.input?._) {
+					return peer.input;
+				}
+				switch (peer._) {
+				case 'inputPeerSelf':
+				case 'inputPeerUser':
+				case 'inputPeerChat':
+				case 'inputPeerChannel':
+				case 'inputPeerUserFromMessage':
+				case 'inputPeerChannelFromMessage':
+					return peer;
+				case 'inputUserSelf':
+					return { _: 'inputPeerSelf' };
+				case 'inputUser':
+					return { _: 'inputPeerUser', userId: peer.userId, accessHash: peer.accessHash };
+				case 'inputChannel':
+					return { _: 'inputPeerChannel', channelId: peer.channelId, accessHash: peer.accessHash };
+				case 'peerUser':
+				case 'peerChat':
+				case 'peerChannel':
+					return resolvePeer(markedId(peer, selfId));
+				}
+				const info = infoOf(peer, selfId);
+				if (info) {
+					return info.input;
+				}
+			}
+			throw new TypeError("expected a peer: a marked id, a username, 'me', a TL peer, input peer, user or chat, a PeerInfo or a Message");
+		};
+
+		const resolveUser = async (peer) => {
+			const input = await resolvePeer(peer);
+			switch (input._) {
+			case 'inputPeerSelf':
+				return { _: 'inputUserSelf' };
+			case 'inputPeerUser':
+				return { _: 'inputUser', userId: input.userId, accessHash: input.accessHash };
+			case 'inputPeerUserFromMessage':
+				return { _: 'inputUserFromMessage', peer: input.peer, msgId: input.msgId, userId: input.userId };
+			}
+			throw new TypeError('expected a user');
+		};
+
+		const channelOf = (input) => {
+			switch (input._) {
+			case 'inputPeerChannel':
+				return { _: 'inputChannel', channelId: input.channelId, accessHash: input.accessHash };
+			case 'inputPeerChannelFromMessage':
+				return { _: 'inputChannelFromMessage', peer: input.peer, msgId: input.msgId, channelId: input.channelId };
+			}
+			return null;
+		};
+
+		const resolveChannel = async (peer) => {
+			const channel = channelOf(await resolvePeer(peer));
+			if (!channel) {
+				throw new TypeError('expected a channel or a supergroup');
+			}
+			return channel;
+		};
+
+		const peerOfInput = (input) => {
+			switch (input._) {
+			case 'inputPeerSelf':
+				return { _: 'peerUser', userId: selfId };
+			case 'inputPeerUser':
+			case 'inputPeerUserFromMessage':
+				return { _: 'peerUser', userId: input.userId };
+			case 'inputPeerChat':
+				return { _: 'peerChat', chatId: input.chatId };
+			}
+			return { _: 'peerChannel', channelId: input.channelId };
+		};
+
+		const containerOf = (result) => ({
+			updates: (result._ === 'updates' || result._ === 'updatesCombined')
+				? result.updates
+				: (result._ === 'updateShort') ? [result.update] : [],
+			peers: { users: result.users ?? [], chats: result.chats ?? [] },
+		});
+
+		const sent = (result, randomIds, input, request) => {
+			if (result._ === 'updateShortSentMessage') {
+				return [new Message({
+					_: 'message',
+					out: true,
+					id: result.id,
+					date: result.date,
+					peerId: peerOfInput(input),
+					fromId: { _: 'peerUser', userId: selfId },
+					message: request.message ?? '',
+					entities: result.entities ?? request.entities ?? [],
+					...(result.media ? { media: result.media } : {}),
+				}, tg)];
+			}
+			const { updates, peers } = containerOf(result);
+			const ids = new Map();
+			const messages = new Map();
+			for (const update of updates) {
+				if (update._ === 'updateMessageID') {
+					ids.set(update.randomId, update.id);
+				} else if (NEW_MESSAGE[update._] === true && update.message._ !== 'messageEmpty') {
+					messages.set(update.message.id, update.message);
+				}
+			}
+			return randomIds.map((randomId) => {
+				const raw = messages.get(ids.get(randomId));
+				return raw ? new Message(raw, tg, peers) : null;
+			});
+		};
+
+		const replyOf = (options) => {
+			const target = options.replyTo ?? options.topicId;
+			if (target === undefined) {
+				return {};
+			}
+			return {
+				replyTo: {
+					_: 'inputReplyToMessage',
+					replyToMsgId: target,
+					...((options.topicId !== undefined) ? { topMsgId: options.topicId } : {}),
+				},
+			};
+		};
+
+		const commonOf = async (options) => ({
+			...(options.silent ? { silent: true } : {}),
+			...(options.clearDraft ? { clearDraft: true } : {}),
+			...(options.invertMedia ? { invertMedia: true } : {}),
+			...((options.scheduleDate !== undefined) ? { scheduleDate: seconds(options.scheduleDate) } : {}),
+			...((options.sendAs !== undefined) ? { sendAs: await resolvePeer(options.sendAs) } : {}),
+			...replyOf(options),
+		});
+
+		const first = (list, what) => {
+			const message = list.find(Boolean);
+			if (!message) {
+				throw new TeleError('internal', `the answer to ${what} had no message in it`);
+			}
+			return message;
+		};
+
+		const wrapMessages = (result) => {
+			if (result._ === 'messages.messagesNotModified') {
+				return [];
+			}
+			const peers = { users: result.users, chats: result.chats };
+			return result.messages
+				.filter((raw) => raw._ !== 'messageEmpty')
+				.map((raw) => new Message(raw, tg, peers));
+		};
+
+		const historyPage = (input, options) => tg.call({
+			_: 'messages.getHistory',
+			peer: input,
+			offsetId: options.offsetId ?? 0,
+			offsetDate: seconds(options.offsetDate ?? 0),
+			addOffset: options.addOffset ?? 0,
+			limit: options.limit ?? 100,
+			maxId: options.maxId ?? 0,
+			minId: options.minId ?? 0,
+			hash: 0n,
+		}).then(wrapMessages);
+
+		async function* iterHistory(peer, options = {}) {
+			const input = await resolvePeer(peer);
+			const limit = options.limit ?? Infinity;
+			const batch = Math.min(options.batchSize ?? 100, 100);
+			let offsetId = options.offsetId ?? 0;
+			let yielded = 0;
+			while (yielded < limit) {
+				const page = await historyPage(input, {
+					...options,
+					offsetId,
+					addOffset: 0,
+					limit: Math.min(batch, limit - yielded),
+				});
+				if (!page.length) {
+					return;
+				}
+				for (const message of page) {
+					yield message;
+					if (++yielded >= limit) {
+						return;
+					}
+				}
+				offsetId = page[page.length - 1].id;
+			}
+		}
+
+		async function* iterDialogs(options = {}) {
+			const limit = options.limit ?? Infinity;
+			const batch = Math.min(options.batchSize ?? 100, 100);
+			const seen = new Set();
+			let offsetDate = 0;
+			let offsetId = 0;
+			let offsetPeer = { _: 'inputPeerEmpty' };
+			let yielded = 0;
+			while (yielded < limit) {
+				const result = await tg.call({
+					_: 'messages.getDialogs',
+					offsetDate,
+					offsetId,
+					offsetPeer,
+					limit: batch,
+					hash: 0n,
+					...((options.folderId !== undefined) ? { folderId: options.folderId } : {}),
+					...(options.excludePinned ? { excludePinned: true } : {}),
+				});
+				if (result._ === 'messages.dialogsNotModified') {
+					return;
+				}
+				const peers = { users: result.users, chats: result.chats };
+				const infos = new Map();
+				for (const object of [...result.users, ...result.chats]) {
+					const info = infoOf(object, selfId);
+					if (info) {
+						infos.set(info.id, info);
+					}
+				}
+				const messages = new Map();
+				for (const raw of result.messages) {
+					if (raw._ !== 'messageEmpty') {
+						messages.set(`${markedId(raw.peerId, selfId)}:${raw.id}`, raw);
+					}
+				}
+				let last = null;
+				for (const dialog of result.dialogs) {
+					if (dialog._ !== 'dialog') {
+						continue;
+					}
+					const id = markedId(dialog.peer, selfId);
+					const raw = messages.get(`${id}:${dialog.topMessage}`);
+					if (raw) {
+						last = { raw, info: infos.get(id) };
+					}
+					if (seen.has(id)) {
+						continue;
+					}
+					seen.add(id);
+					yield {
+						raw: dialog,
+						id,
+						peer: infos.get(id) ?? null,
+						lastMessage: raw ? new Message(raw, tg, peers) : null,
+						unreadCount: dialog.unreadCount,
+						pinned: dialog.pinned === true,
+					};
+					if (++yielded >= limit) {
+						return;
+					}
+				}
+				if (result._ === 'messages.dialogs' || !result.dialogs.length || !last?.info) {
+					return;
+				}
+				offsetDate = last.raw.date;
+				offsetId = last.raw.id;
+				offsetPeer = last.info.input;
+			}
+		}
+
+		const collect = async (iterator) => {
+			const result = [];
+			for await (const item of iterator) {
+				result.push(item);
+			}
+			return result;
+		};
+
+		const shortMessage = (update) => {
+			const common = {
+				_: 'message',
+				id: update.id,
+				out: update.out,
+				mentioned: update.mentioned,
+				mediaUnread: update.mediaUnread,
+				silent: update.silent,
+				date: update.date,
+				message: update.message,
+				...(update.entities ? { entities: update.entities } : {}),
+				...(update.fwdFrom ? { fwdFrom: update.fwdFrom } : {}),
+				...((update.viaBotId !== undefined) ? { viaBotId: update.viaBotId } : {}),
+				...(update.replyTo ? { replyTo: update.replyTo } : {}),
+				...((update.ttlPeriod !== undefined) ? { ttlPeriod: update.ttlPeriod } : {}),
+			};
+			switch (update._) {
+			case 'updateShortMessage':
+				return {
+					...common,
+					peerId: { _: 'peerUser', userId: update.userId },
+					fromId: { _: 'peerUser', userId: update.out ? selfId : update.userId },
+				};
+			case 'updateShortChatMessage':
+				return {
+					...common,
+					peerId: { _: 'peerChat', chatId: update.chatId },
+					fromId: { _: 'peerUser', userId: update.fromId },
+				};
+			}
+			return update.message;
+		};
+
+		const members = {
+			Message,
+			resolvePeer,
+			resolveUser,
+			resolveChannel,
+
+			async getMe() {
+				const [user] = await tg.call({ _: 'users.getUsers', id: [{ _: 'inputUserSelf' }] });
+				return user;
+			},
+
+			async getUser(peer) {
+				const [user] = await tg.call({ _: 'users.getUsers', id: [await resolveUser(peer)] });
+				return (user?._ === 'user') ? user : null;
+			},
+
+			async getChat(peer) {
+				const input = await resolvePeer(peer);
+				const channel = channelOf(input);
+				const result = channel
+					? await tg.call({ _: 'channels.getChannels', id: [channel] })
+					: (input._ === 'inputPeerChat')
+					? await tg.call({ _: 'messages.getChats', id: [input.chatId] })
+					: null;
+				if (!result) {
+					throw new TypeError('expected a group or a channel');
+				}
+				return result.chats[0] ?? null;
+			},
+
+			async getFullUser(peer) {
+				return tg.call({ _: 'users.getFullUser', id: await resolveUser(peer) });
+			},
+
+			async getFullChat(peer) {
+				const input = await resolvePeer(peer);
+				const channel = channelOf(input);
+				if (channel) {
+					return tg.call({ _: 'channels.getFullChannel', channel });
+				} else if (input._ === 'inputPeerChat') {
+					return tg.call({ _: 'messages.getFullChat', chatId: input.chatId });
+				}
+				throw new TypeError('expected a group or a channel');
+			},
+
+			async getMessages(peer, ids) {
+				const input = await resolvePeer(peer);
+				const single = !Array.isArray(ids);
+				const list = single ? [ids] : ids;
+				const id = list.map((value) => ({ _: 'inputMessageID', id: value }));
+				const channel = channelOf(input);
+				const result = channel
+					? await tg.call({ _: 'channels.getMessages', channel, id })
+					: await tg.call({ _: 'messages.getMessages', id });
+				const byId = new Map(wrapMessages(result).map((message) => [message.id, message]));
+				const found = list.map((value) => byId.get(value) ?? null);
+				return single ? found[0] : found;
+			},
+
+			async getHistory(peer, options = {}) {
+				return historyPage(await resolvePeer(peer), options);
+			},
+
+			iterHistory,
+			iterDialogs,
+
+			getDialogs(options = {}) {
+				return collect(iterDialogs({ limit: 100, ...options }));
+			},
+
+			async sendMessage(peer, text, options = {}) {
+				const input = await resolvePeer(peer);
+				const content = textOf(text);
+				const randomId = tg.randomId();
+				const request = {
+					_: 'messages.sendMessage',
+					peer: input,
+					message: content.text,
+					randomId,
+					...(content.entities.length ? { entities: content.entities } : {}),
+					...(options.noWebpage ? { noWebpage: true } : {}),
+					...(await commonOf(options)),
+				};
+				return first(sent(await tg.call(request), [randomId], input, request), 'messages.sendMessage');
+			},
+
+			async sendMedia(peer, media, options = {}) {
+				const input = await resolvePeer(peer);
+				const caption = textOf(options.caption ?? '');
+				const randomId = tg.randomId();
+				const request = {
+					_: 'messages.sendMedia',
+					peer: input,
+					media,
+					message: caption.text,
+					randomId,
+					...(caption.entities.length ? { entities: caption.entities } : {}),
+					...(await commonOf(options)),
+				};
+				return first(sent(await tg.call(request), [randomId], input, request), 'messages.sendMedia');
+			},
+
+			async editMessage(peer, id, text, options = {}) {
+				const input = await resolvePeer(peer);
+				const content = (text === undefined || text === null) ? null : textOf(text);
+				const result = await tg.call({
+					_: 'messages.editMessage',
+					peer: input,
+					id,
+					...(content ? { message: content.text, entities: content.entities } : {}),
+					...(options.noWebpage ? { noWebpage: true } : {}),
+					...(options.invertMedia ? { invertMedia: true } : {}),
+					...(options.media ? { media: options.media } : {}),
+				});
+				const { updates, peers } = containerOf(result);
+				const update = updates.find((item) => EDIT_MESSAGE[item._] === true && item.message.id === id);
+				if (!update) {
+					throw new TeleError('internal', 'the answer to messages.editMessage had no message in it');
+				}
+				return new Message(update.message, tg, peers);
+			},
+
+			async deleteMessages(peer, ids, options = {}) {
+				const input = await resolvePeer(peer);
+				const list = [ids].flat();
+				const channel = channelOf(input);
+				if (channel) {
+					const affected = await tg.call({ _: 'channels.deleteMessages', channel, id: list });
+					natives.deleted(input.channelId, list, affected.pts, affected.ptsCount);
+				} else {
+					const affected = await tg.call({ _: 'messages.deleteMessages', revoke: options.revoke ?? true, id: list });
+					natives.deleted(0n, list, affected.pts, affected.ptsCount);
+				}
+			},
+
+			async forwardMessages(fromPeer, ids, toPeer, options = {}) {
+				const from = await resolvePeer(fromPeer);
+				const to = await resolvePeer(toPeer);
+				const list = [ids].flat();
+				const randomIds = list.map(() => tg.randomId());
+				const request = {
+					_: 'messages.forwardMessages',
+					fromPeer: from,
+					id: list,
+					randomId: randomIds,
+					toPeer: to,
+					...(options.silent ? { silent: true } : {}),
+					...(options.dropAuthor ? { dropAuthor: true } : {}),
+					...(options.dropCaption ? { dropMediaCaptions: true } : {}),
+					...((options.scheduleDate !== undefined) ? { scheduleDate: seconds(options.scheduleDate) } : {}),
+					...((options.topicId !== undefined) ? { topMsgId: options.topicId } : {}),
+					...((options.sendAs !== undefined) ? { sendAs: await resolvePeer(options.sendAs) } : {}),
+				};
+				return sent(await tg.call(request), randomIds, to, request).filter(Boolean);
+			},
+
+			async setReaction(peer, id, reactions, options = {}) {
+				const reaction = [reactions ?? []].flat().map((item) => ((typeof item === 'string')
+					? { _: 'reactionEmoji', emoticon: item }
+					: { _: 'reactionCustomEmoji', documentId: BigInt(item.customEmojiId) }));
+				await tg.call({
+					_: 'messages.sendReaction',
+					peer: await resolvePeer(peer),
+					msgId: id,
+					reaction,
+					...(options.big ? { big: true } : {}),
+					...(options.addToRecent ? { addToRecent: true } : {}),
+				});
+			},
+
+			async readHistory(peer, options = {}) {
+				natives.read(await resolvePeer(peer), options.maxId ?? 0);
+			},
+
+			async sendTyping(peer, action = 'typing', options = {}) {
+				const typing = TYPING[action];
+				if (!typing) {
+					throw new TypeError(`unknown typing action '${action}', expected one of ${Object.keys(TYPING).join(', ')}`);
+				}
+				await tg.call({
+					_: 'messages.setTyping',
+					peer: await resolvePeer(peer),
+					action: typing,
+					...((options.topicId !== undefined) ? { topMsgId: options.topicId } : {}),
+				});
+			},
+
+			async setDraft(peer, text, options = {}) {
+				const content = textOf(text ?? '');
+				await tg.call({
+					_: 'messages.saveDraft',
+					peer: await resolvePeer(peer),
+					message: content.text,
+					...(content.entities.length ? { entities: content.entities } : {}),
+					...(options.noWebpage ? { noWebpage: true } : {}),
+					...replyOf(options),
+				});
+			},
+
+			onNewMessage(callback) {
+				return given.listenNew((update, peers) => {
+					const raw = shortMessage(update);
+					if (raw && raw._ !== 'messageEmpty') {
+						return callback(new Message(raw, tg, peers));
+					}
+				});
+			},
+
+			onMessageEdited(callback) {
+				return given.listenEdit((update, peers) => {
+					if (update.message._ !== 'messageEmpty') {
+						return callback(new Message(update.message, tg, peers));
+					}
+				});
+			},
+
+			onMessageDeleted(callback) {
+				return given.listenDelete((update) => callback({
+					chatId: (update._ === 'updateDeleteChannelMessages') ? (-CHANNEL_SHIFT - update.channelId) : null,
+					ids: update.messages,
+				}));
+			},
+		};
+		for (const [name, value] of Object.entries(members)) {
+			Object.defineProperty(tg, name, { value, enumerable: true });
+		}
+	});
+})();
