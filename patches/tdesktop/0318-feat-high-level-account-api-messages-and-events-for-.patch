+JSValue Instance::makeNatives() {
+	const auto ctx = _engine->ctx();
+	auto natives = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"peer",
+		JS_NewCFunction(ctx, NativePeer, "peer", 1));
+	const auto event = [&](const char *name, int kind) {
+		JS_SetPropertyStr(
+			ctx,
+			natives,
+			name,
+			JS_NewCFunctionMagic(
+				ctx,
+				NativeEvent,
+				name,
+				1,
+				JS_CFUNC_generic_magic,
+				kind));
+	};
+	event("listenNew", 0);
+	event("listenEdit", 1);
+	event("listenDelete", 2);
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"deleted",
+		JS_NewCFunction(ctx, NativeDeleted, "deleted", 4));
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"read",
+		JS_NewCFunction(ctx, NativeRead, "read", 2));
+	return natives;
+}
+
+JSValue Instance::NativePeer(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance || argc < 1) {
+		return JS_UNDEFINED;
+	}
+	const auto &permissions = instance->_permissions;
+	if (!permissions.allows(Capability::AccountRead, "peers")
+		&& !permissions.any(Capability::OnUpdate)) {
+		return JS_UNDEFINED;
+	}
+	const auto session = instance->_session;
+	const auto id = PeerFromValue(ctx, argv[0], session->userPeerId());
+	const auto peer = id ? session->data().peerLoaded(*id) : nullptr;
+	return peer ? instance->peerInfo(peer) : JS_UNDEFINED;
+}
+
+JSValue Instance::NativeEvent(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	static const auto events = std::array<
+		std::pair<const char*, std::vector<std::string>>,
+		3>{ {
+		{ "new_message", {
+			"updateNewMessage",
+			"updateNewChannelMessage",
+			"updateShortMessage",
+			"updateShortChatMessage",
+		} },
+		{ "edit_message", {
+			"updateEditMessage",
+			"updateEditChannelMessage",
+		} },
+		{ "delete_message", {
+			"updateDeleteMessages",
+			"updateDeleteChannelMessages",
+		} },
+	} };
+	static const auto names = std::array<const char*, 3>{
+		"tg.onNewMessage",
+		"tg.onMessageEdited",
+		"tg.onMessageDeleted",
+	};
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (magic < 0 || magic > 2) {
+		return JS_UNDEFINED;
+	} else if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(ctx, "%s(function)", names[magic]);
+	}
+	const auto &[event, keys] = events[magic];
+	if (!instance->_permissions.allows(Capability::OnUpdate, event)) {
+		return ThrowNotGranted(
+			ctx,
+			QString::fromLatin1(names[magic]),
+			GrantText(Capability::OnUpdate, event));
+	}
+	const auto id = NextRegistrationId();
+	instance->_registrations.emplace(id, Registration{
+		.kind = Kind::Listener,
+		.keys = keys,
+		.fn = JS_DupValue(ctx, argv[0]),
+	});
+	return instance->disposer(id);
+}
+
+JSValue Instance::NativeDeleted(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance
+		|| argc < 4
+		|| !instance->_permissions.allows(Capability::AccountWrite, "delete")) {
+		return JS_UNDEFINED;
+	}
+	auto channel = std::int64_t();
+	JS_ToBigInt64(ctx, &channel, argv[0]);
+	auto length = std::int64_t();
+	if (JS_GetLength(ctx, argv[1], &length) < 0) {
+		return JS_EXCEPTION;
+	}
+	auto ids = QVector<MTPint>();
+	for (auto i = std::int64_t(); i != length; ++i) {
+		auto item = JS_GetPropertyUint32(ctx, argv[1], std::uint32_t(i));
+		auto id = 0;
+		JS_ToInt32(ctx, &id, item);
+		JS_FreeValue(ctx, item);
+		ids.push_back(MTP_int(id));
+	}
+	auto pts = 0;
+	auto count = 0;
+	JS_ToInt32(ctx, &pts, argv[2]);
+	JS_ToInt32(ctx, &count, argv[3]);
+	const auto update = channel
+		? MTP_updateDeleteChannelMessages(
+			MTP_long(channel),
+			MTP_vector<MTPint>(std::move(ids)),
+			MTP_int(pts),
+			MTP_int(count))
+		: MTP_updateDeleteMessages(
+			MTP_vector<MTPint>(std::move(ids)),
+			MTP_int(pts),
+			MTP_int(count));
+	instance->_session->api().applyUpdates(MTP_updateShort(
+		update,
+		MTP_int(base::unixtime::now())));
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::NativeRead(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (!instance->_permissions.allows(Capability::AccountWrite, "read")) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.readHistory"_q,
+			GrantText(Capability::AccountWrite, "read"));
+	}
+	const auto session = instance->_session;
