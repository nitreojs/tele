@@ -0,0 +1,44 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+#pragma once
+
+#include "ui/effects/animations.h"
+
+class QWheelEvent;
+
+namespace Ui {
+
+void SetSmoothWheelScroll(bool enabled);
+[[nodiscard]] bool SmoothWheelScroll();
+
+// Eases mouse wheel notches like the profile does, touchpads stay as is.
+class SmoothWheel final {
+public:
+	SmoothWheel();
+
+	[[nodiscard]] bool handle(
+		not_null<QWheelEvent*> e,
+		int pixels,
+		int topMax,
+		Fn<int()> current,
+		Fn<void(int)> apply);
+	void stop();
+
+private:
+	void step(crl::time now);
+
+	Animations::Basic _animation;
+	Fn<int()> _current;
+	Fn<void(int)> _apply;
+	int _from = 0;
+	int _target = 0;
+	int _lastApplied = -1;
+	crl::time _started = 0;
+
+};
+
+} // namespace Ui
