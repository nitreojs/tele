From: nitreojs <hello@starkow.dev>
Date: Sat, 10 Oct 2026 16:15:11 +0300
Subject: [PATCH] fix: the maximize button follows the real window state

---
 ui/platform/ui_platform_window_title.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/ui/platform/ui_platform_window_title.cpp b/ui/platform/ui_platform_window_title.cpp
index a54b60cbd907856ac2fef7e400c6488d52be37a0..50e8deb7c9740219362e793e038d54cb26c01db1 100644
--- a/ui/platform/ui_platform_window_title.cpp
+++ b/ui/platform/ui_platform_window_title.cpp
@@ -158,6 +158,7 @@ TitleControls::TitleControls(
 			_activeState = active;
 			updateButtonsState();
 		}
+		handleWindowStateChanged(window()->windowState());
 	}, _close->lifetime());
 }
 
@@ -206,6 +207,9 @@ void TitleControls::init(Fn<void(bool maximized)> maximize) {
 	});
 	_minimize->setPointerCursor(false);
 	_maximizeRestore->setClickedCallback([=] {
+		// A geometry change can drop the maximized or full screen state
+		// without a state change event, so ask the window itself.
+		handleWindowStateChanged(window()->windowState());
 		const auto weak = base::make_weak(_maximizeRestore.data());
 		if (maximize) {
 			maximize(!_maximizedState);
