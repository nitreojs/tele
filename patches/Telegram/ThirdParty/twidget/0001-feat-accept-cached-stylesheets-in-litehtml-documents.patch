+    document::ptr document::createFromStringParsed(const estring& str, document_container* container,
+                                                   const std::shared_ptr<const css>& master,
+                                                   const std::shared_ptr<const css>& author)
+    {
+        return create_from_string(str, container, {}, {}, master.get(), author.get());
+    }
+
+    std::shared_ptr<const css> document::parse_stylesheet(const std::string& text, document_container* container,
+                                                         document_mode mode)
+    {
+        auto doc = createFromString(estring(""), container, {}, {});
+        doc->m_mode = mode;
+        auto result = std::make_shared<css>();
+        result->parse_css_stylesheet(text, "", doc);
+        result->sort_selectors();
+        return result;
+    }
