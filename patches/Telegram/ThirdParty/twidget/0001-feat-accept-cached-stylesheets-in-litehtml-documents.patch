diff --git a/litehtml/src/stylesheet.cpp b/litehtml/src/stylesheet.cpp
index ae9128330f2eb6689e39d9db252b793a77dcc11d..ed9d67a44084bc5d60f3077bdc0a72c57eeef6d4 100644
--- a/litehtml/src/stylesheet.cpp
+++ b/litehtml/src/stylesheet.cpp
@@ -3,10 +3,31 @@
 #include "css_parser.h"
 #include "document.h"
 #include "document_container.h"
+#include <map>
 
 namespace litehtml
 {
 
+    css css::for_document(document* doc) const
+    {
+        css result = *this;
+        std::map<const media_query_list_list*, media_query_list_list::ptr> media;
+        for(auto& selector : result.m_selectors)
+        {
+            if(!selector->m_media_query)
+                continue;
+            auto& copy = media[selector->m_media_query.get()];
+            if(!copy)
+            {
+                copy = std::make_shared<media_query_list_list>(*selector->m_media_query);
+                doc->add_media_list(copy);
+            }
+            selector = std::make_shared<css_selector>(*selector);
+            selector->m_media_query = copy;
+        }
+        return result;
+    }
+
     // ( <declaration> )  https://drafts.csswg.org/css-conditional-3/#typedef-supports-decl
     static bool eval_supports_declaration(const css_token_vector& tokens, document_container* container)
     {
