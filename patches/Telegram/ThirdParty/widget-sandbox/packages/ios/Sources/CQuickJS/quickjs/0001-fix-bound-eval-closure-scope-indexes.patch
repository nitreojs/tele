From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Fri, 13 Nov 2026 03:54:19 +0300
Subject: [PATCH] fix: bound eval closure scope indexes

---
 quickjs.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index 1c5b660b794a70ac16dae11f01b3b921e36ab171..786c46d8aaa724f452f9bc35036cc9b1a26a4207 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -35734,6 +35734,10 @@ static __exception int add_closure_variables(JSContext *ctx, JSFunctionDef *s,
         return -1;
     /* Add lexical variables in scope at the point of evaluation */
     for (i = scope_idx; i >= 0;) {
+        if (i >= b->var_count) {
+            JS_ThrowInternalError(ctx, "invalid scope index in eval closure");
+            return -1;
+        }
         vd = &b->vardefs[b->arg_count + i];
         if (vd->scope_level > 0) {
             JSClosureVar *cv = &s->closure_var[s->closure_var_count++];
