From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Fri, 13 Nov 2026 03:54:19 +0300
Subject: [PATCH] fix: bound eval closure scope indexes

---
 quickjs.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index 9721dc52265fd9b1dcc9cf9d772395df35854c03..4e34439f17cba3bbdf0ef45cb816e98156becd3a 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -35747,6 +35747,10 @@ static __exception int add_closure_variables(JSContext *ctx, JSFunctionDef *s,
         return -1;
     /* Add lexical variables in scope at the point of evaluation */
     for (i = scope_idx; i >= 0;) {
+        if (i >= b->var_count) {
+            JS_ThrowInternalError(ctx, "invalid scope index in eval closure");
+            return -1;
+        }
         vd = &b->vardefs[b->arg_count + i];
         if (vd->scope_level > 0) {
             JSClosureVar *cv = &s->closure_var[s->closure_var_count++];
