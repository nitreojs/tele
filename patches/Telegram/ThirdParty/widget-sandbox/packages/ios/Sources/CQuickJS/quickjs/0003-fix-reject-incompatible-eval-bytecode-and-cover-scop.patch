diff --git a/tests/destructuring-parameter-limit.js b/tests/destructuring-parameter-limit.js
new file mode 100644
index 0000000000000000000000000000000000000000..877448703abcfebf861499963fae7d0e59aecc45
--- /dev/null
+++ b/tests/destructuring-parameter-limit.js
@@ -0,0 +1,23 @@
+function check(value, message) {
+    if (!value)
+        throw new Error(message);
+}
+
+const parameters = Array.from({ length: 65534 }, (_, i) => `p${i}`);
+for (const pattern of ["[]", "{}", "[] = []", "{} = {}"]) {
+    const valid = `(function(${parameters.slice(0, -1).join(",")},${pattern}) {})`;
+    const compiled = eval(valid);
+    check(typeof compiled === "function", `accepted boundary: ${pattern}`);
+    check(compiled.length === (pattern.includes("=") ? 65533 : 65534),
+          `parameter count: ${pattern}`);
+
+    const invalid = `(function(${parameters.join(",")},${pattern}) {})`;
+    let rejected = false;
+    try {
+        eval(invalid);
+    } catch (error) {
+        rejected = error instanceof SyntaxError
+            && error.message.includes("too many parameters");
+    }
+    check(rejected, `rejected overflow: ${pattern}`);
+}
