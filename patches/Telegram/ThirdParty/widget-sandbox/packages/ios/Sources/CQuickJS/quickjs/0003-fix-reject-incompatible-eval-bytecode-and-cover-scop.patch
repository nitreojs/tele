From: nitreojs <hello@starkow.dev>
Date: Thu, 12 Nov 2026 20:54:19 +0300
Subject: [PATCH] fix: reject incompatible eval bytecode and cover scope
 boundaries

---
 api-test.c                                 | 103 +++++++++++++++++++++
 builtin-array-fromasync.h                  | Bin 5652 -> 5535 bytes
 builtin-iterator-zip-keyed.h               | Bin 15074 -> 14945 bytes
 builtin-iterator-zip.h                     | Bin 15442 -> 15246 bytes
 gen/function_source.c                      | Bin 3014 -> 3014 bytes
 gen/hello.c                                | Bin 1541 -> 1541 bytes
 gen/hello_module.c                         | Bin 4089 -> 4138 bytes
 gen/repl.c                                 | Bin 147583 -> 147583 bytes
 gen/standalone.c                           | Bin 15324 -> 15311 bytes
 gen/test_fib.c                             | Bin 2840 -> 2840 bytes
 quickjs.c                                  |   8 +-
 tests/destructuring-parameter-limit.js     |  23 +++++
 tests/mapped-arguments-var-ref-overflow.js |  63 ++++---------
 tests/test_bjson.js                        |  10 +-
 tests/test_closure.js                      |  66 +++++++++++++
 15 files changed, 221 insertions(+), 52 deletions(-)
 create mode 100644 tests/destructuring-parameter-limit.js

diff --git a/api-test.c b/api-test.c
index 19f7f1672f2a59d70313f6593a53477e6a72eee5..3e85809a70ba36836be6537487ac1458c7d18cbf 100644
--- a/api-test.c
+++ b/api-test.c
@@ -2675,6 +2675,107 @@ static void parser_label_out_of_memory(void)
     assert(oom_seen);
 }
 
+static void eval_scope_bytecode(void)
+{
+    const char *src =
+        "'use strict';"
+        "(function({} = eval('({})')) {"
+        "  return (function([] = eval(...['[]'])) { return 42; })();"
+        "})();";
+    JSRuntime *rt = new_runtime();
+    JSContext *ctx = JS_NewContext(rt);
+    JSValue compiled, loaded, result, error;
+    uint8_t *buf;
+    size_t len;
+    int32_t value;
+    const char *message;
+
+    compiled = JS_Eval(ctx, src, strlen(src), "<eval-scope>",
+                       JS_EVAL_TYPE_GLOBAL | JS_EVAL_FLAG_COMPILE_ONLY);
+    assert(!JS_IsException(compiled));
+    buf = JS_WriteObject(ctx, &len, compiled, JS_WRITE_OBJ_BYTECODE);
+    assert(buf != NULL && len > 5);
+    assert(buf[0] == 30);
+    loaded = JS_ReadObject(ctx, buf, len, JS_READ_OBJ_BYTECODE);
+    assert(!JS_IsException(loaded));
+    result = JS_EvalFunction(ctx, loaded);
+    assert(!JS_IsException(result));
+    assert(JS_ToInt32(ctx, &value, result) == 0 && value == 42);
+    JS_FreeValue(ctx, result);
+    result = JS_EvalFunction(ctx, compiled);
+    assert(!JS_IsException(result));
+    assert(JS_ToInt32(ctx, &value, result) == 0 && value == 42);
+    JS_FreeValue(ctx, result);
+
+    for (int version = 28; version <= 29; version++) {
+        buf[0] = version;
+        loaded = JS_ReadObject(ctx, buf, len, JS_READ_OBJ_BYTECODE);
+        assert(JS_IsException(loaded));
+        error = JS_GetException(ctx);
+        message = JS_ToCString(ctx, error);
+        assert(message != NULL && strstr(message, "invalid version") != NULL);
+        JS_FreeCString(ctx, message);
+        JS_FreeValue(ctx, error);
+        JS_FreeValue(ctx, loaded);
+    }
+    js_free(ctx, buf);
+    JS_FreeContext(ctx);
+    JS_FreeRuntime(rt);
+}
+
+static void eval_scope_local_limit(void)
+{
+    const size_t capacity = 1024 * 1024;
+    char *src = malloc(capacity);
+    JSRuntime *rt = new_runtime();
+    JSContext *ctx = JS_NewContext(rt);
+    JSValue result, error;
+    size_t len;
+    int n;
+    int32_t value;
+    const char *message;
+
+    assert(src != NULL);
+    JS_SetMaxStackSize(rt, 4 * 1024 * 1024);
+    for (int mode = 0; mode < 4; mode++) {
+        int count = mode < 2 ? 65534 + mode : 65531;
+        len = snprintf(src, capacity, "(function() {'use strict'; let ");
+        for (int i = 0; i < count; i++) {
+            n = snprintf(src + len, capacity - len, "%sv%d", i ? "," : "", i);
+            assert(n > 0 && (size_t)n < capacity - len);
+            len += n;
+        }
+        if (mode < 2) {
+            n = snprintf(src + len, capacity - len, "; return 42; })");
+        } else {
+            n = snprintf(src + len, capacity - len,
+                         mode == 2
+                         ? "=42; return eval('v65530'); })()"
+                         : "=42; return eval(...['v65530']); })()");
+        }
+        assert(n > 0 && (size_t)n < capacity - len);
+        len += n;
+        result = JS_Eval(ctx, src, len, "<eval-limit>", JS_EVAL_TYPE_GLOBAL
+                         | (mode < 2 ? JS_EVAL_FLAG_COMPILE_ONLY : 0));
+        if (mode == 1) {
+            assert(JS_IsException(result));
+            error = JS_GetException(ctx);
+            message = JS_ToCString(ctx, error);
+            assert(message != NULL && strstr(message, "too many variables") != NULL);
+            JS_FreeCString(ctx, message);
+            JS_FreeValue(ctx, error);
+        } else {
+            assert(!JS_IsException(result));
+            if (mode >= 2)
+                assert(JS_ToInt32(ctx, &value, result) == 0 && value == 42);
+        }
+        JS_FreeValue(ctx, result);
+    }
+    free(src);
+    JS_FreeContext(ctx);
+    JS_FreeRuntime(rt);
+}
+
 int main(void)
 {
     cfunctions();
@@ -2721,6 +2822,8 @@ int main(void)
     parser_scope_out_of_memory();
     parser_label_out_of_memory();
     await_using_outside_async();
+    eval_scope_bytecode();
+    eval_scope_local_limit();
     private_symbols();
     new_context_low_memory();
     json_stringify_oom();
