+function test_eval_parameter_scope()
+{
+    "use strict";
+
+    function empty_object({} = eval("({})")) { return 11; }
+    function empty_array([] = eval("[]")) { return 12; }
+    function spread_object({} = eval(...["({})"])) { return 13; }
+    function spread_array([] = eval(...["[]"])) { return 14; }
+    assert(empty_object(), 11);
+    assert(empty_array(), 12);
+    assert(spread_object(), 13);
+    assert(spread_array(), 14);
+    assert((({} = eval("({})")) => 15)(), 15);
+    assert((({} = eval(...["({})"])) => 16)(), 16);
+
+    class C {
+        direct({} = eval("({})")) { return 17; }
+        spread({} = eval(...["({})"])) { return 18; }
+    }
+    assert(new C().direct(), 17);
+    assert(new C().spread(), 18);
+
+    let seen = 0;
+    function hidden_body({} = eval("(seen = typeof bodyOnly, {})")) {
+        var bodyOnly = 99;
+        return bodyOnly;
+    }
+    assert(hidden_body(), 99);
+    assert(seen, "undefined");
+    function hidden_spread({} = eval(...["(seen = typeof bodyOnly, {})"])) {
+        var bodyOnly = 99;
+    }
+    hidden_spread();
+    assert(seen, "undefined");
+
+    function earlier(a = 20, b = eval("a + 1"),
+                     c = eval(...["b + 1"])) {
+        return [a, b, c];
+    }
+    assert(earlier().join(","), "20,21,22");
+    function later(a = eval("b"), b = 1) {}
+    function later_spread(a = eval(...["b"]), b = 1) {}
+    for (const f of [later, later_spread]) {
+        let caught = false;
+        try {
+            f();
+        } catch (e) {
+            caught = e instanceof ReferenceError;
+        }
+        assert(caught);
+    }
+
+    function capture(a = 23, f = eval("() => a")) {
+        var a = 99;
+        return f;
+    }
+    assert(capture()(), 23);
+    function receiver({} = eval("(seen = this.value, {})")) {}
+    receiver.call({value: 24});
+    assert(seen, 24);
+    function target({} = eval("(seen = new.target, {})")) {}
+    new target();
+    assert(seen, target);
+}
+
 test_closure1();
 test_closure2();
 test_closure3();
